{"parentUuid":"60935623-d43f-495a-b5cf-5c0223f5cd99","isSidechain":true,"promptId":"50d61844-03e1-47e6-9599-4d79a818d07e","agentId":"a07e08770c1a3b00c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CagbPBjSLonycHkjuAgjKW","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"HAT v3.2 · ELEKTRİK ORTAK ARAÇLARI (30 Eyl gece · Claude) — kablo / kablo kanalı / P-kelepçe / rakor / DIN cihazı + montaj dökümüne karşı çakışma.\n3\tKemal: \"kablolar havada olmasın, kıskaçlarla duvarlara · hangi yöntem doğruysa öyle yap · çok kompleksleştirme\".\n4\tYÖNTEM (makine / pano imalatı standardı): hat boyu kablolar KAPAKLI KABLO KANALINDA (duvara vidalı) · kanaldan cihaza kısa uç kablo, uçları\n5\tP-kelepçeyle duvara / şaseye (≤ 250 mm aralık) · sac geçişleri RAKORLU (IP68 poliamid kablo rakoru) · hareketli eksen ENERJİ ZİNCİRİNDE ·\n6\tpano içi DIN rayı + delikli pano kanalı. Parçalar DÜNYA koordinatında.\n7\tÇakışma: h3/_dunya/dunya.brep (hat3_montaj_v2 dökümü) — kutu ön elemesi + gerçek katı kesişimi.\"\"\"\n8\timport io, json, math, os, sys\n9\tH3 = os.path.dirname(os.path.abspath(__file__)); U = os.path.dirname(H3)\n10\tfor _p in (U, H3):\n11\t    if _p not in sys.path: sys.path.insert(0, _p)\n12\timport cadquery as cq\n13\t\n14\tV = cq.Vector\n15\tDD = os.path.join(H3, \"_dunya\")\n16\t\n17\t\n18\tdef kut(x0, x1, y0, y1, z0, z1):\n19\t    return cq.Solid.makeBox(abs(x1 - x0), abs(y1 - y0), abs(z1 - z0), V(min(x0, x1), min(y0, y1), min(z0, z1)))\n20\t\n21\t\n22\tdef sil(p0, p1, r):\n23\t    a, b = V(*p0), V(*p1); d = b - a\n24\t    return cq.Solid.makeCylinder(r, d.Length, a, d.normalized())\n25\t\n26\t\n27\tdef boru(pts, r):\n28\t    \"\"\"kablo: düz parçalar, iç köşelerde komşu parçalar birbirinin içine r kadar uzar (köşe dolu, katı birleştirme sağlam ·\n29\t    eski 'köşede küre' teğet yüzey yüzünden birleştirmeyi bozuyordu) · uçlar düz (kanal / pano / cihaz yüzüne dayanır)\"\"\"\n30\t    q = [pts[0]]\n31\t    for p in pts[1:]:\n32\t        if math.dist(p, q[-1]) > 1e-6: q.append(p)\n33\t    n = len(q); ss = []\n34\t    for i, (a, b) in enumerate(zip(q[:-1], q[1:])):\n35\t        ss.append(sil_uzun(a, b, r, i > 0, i < n - 2))\n36\t    if len(ss) == 1: return ss[0]\n37\t    alt = sum(math.pi * r * r * math.dist(a, b) for a, b in zip(q[:-1], q[1:]))\n38\t    adaylar = []\n39\t    try:\n40\t        s = ss[0]\n41\t        for x in ss[1:]: s = s.fuse(x)\n42\t        adaylar.append(s.clean())\n43\t    except Exception:\n44\t        pass\n45\t    try:\n46\t        adaylar.append(ss[0].fuse(*ss[1:], tol=0.01).clean())\n47\t    except Exception:\n48\t        pass\n49\t    for s in adaylar:\n50\t        try:\n51\t            if len(s.Solids()) == 1 and s.Volume() >= 0.7 * alt: return s.Solids()[0]\n52\t        except Exception:\n53\t            continue\n54\t    return cq.Compound.makeCompound(ss)\n55\t\n56\t\n57\tdef sil_uzun(a, b, r, bas_uzat, son_uzat):\n58\t    L = math.dist(a, b); d = [(b[k] - a[k]) / L for k in range(3)]\n59\t    a2 = tuple(a[k] - d[k] * r for k in range(3)) if bas_uzat else a\n60\t    b2 = tuple(b[k] + d[k] * r for k in range(3)) if son_uzat else b\n61\t    return sil(a2, b2, r)\n62\t\n63\t\n64\tdef uzunluk(pts):\n65\t    return sum(math.dist(a, b) for a, b in zip(pts[:-1], pts[1:]))\n66\t\n67\t\n68\t# ---------------------------------------------------------------- KABLO KANALI (kapaklı, U kesit) ----------------------------------------------------------------\n69\tdef kanal(eksen, a, b, c0, c1, d0, d1, acik=\"+\", t=1.5):\n70\t    \"\"\"eksen 'x' | 'y' | 'z' boyunca a → b · kesit iki diğer eksende (c0..c1, d0..d1) · acik: kapağın baktığı yön ('+' / '-') dik eksende (d) ·\n71\t    döner (gövde, kapak): gövde U (taban + 2 yan), kapak ayrı parça (d ekseninin açık yüzünde, t kalın)\"\"\"\n72\t    a, b = min(a, b), max(a, b)\n73\t    def K(p0, p1, q0, q1, r0, r1):\n74\t        if eksen == \"x\": return kut(p0, p1, q0, q1, r0, r1)\n75\t        if eksen == \"y\": return kut(q0, q1, p0, p1, r0, r1)\n76\t        return kut(q0, q1, r0, r1, p0, p1)\n77\t    dis = K(a, b, c0, c1, d0, d1)\n78\t    if acik == \"+\":\n79\t        ic = K(a - 1, b + 1, c0 + t, c1 - t, d0 + t, d1 + 1)\n80\t        kap = K(a, b, c0, c1, d1, d1 + t)\n81\t    else:\n82\t        ic = K(a - 1, b + 1, c0 + t, c1 - t, d0 - 1, d1 - t)\n83\t        kap = K(a, b, c0, c1, d0 - t, d0)\n84\t    return dis.cut(ic), kap\n85\t\n86\t\n87\t# ---------------------------------------------------------------- P-KELEPÇE (kabloyu yüzeye tutar) ----------------------------------------------------------------\n88\tdef kelepce(p, eksen, r, yuzey, yon, t=1.0, gen=12.0, tab=8.0):\n89\t    \"\"\"p: kablo ekseni noktası · eksen: kablonun ekseni ('x'|'y'|'z') · r: kablo yarıçapı · yuzey: yüzeyin koordinatı (yon ekseninde) ·\n90\t    yon: yüzeyin normali ekseni ve işareti ('+x', '-z' …: kablodan yüzeye doğru). Halka (r … r + t) + yüzeye inen dil + yüzey tablası.\"\"\"\n91\t    ax = \"xyz\".index(eksen); nx = \"xyz\".index(yon[1]); sg = 1.0 if yon[0] == \"+\" else -1.0\n92\t    e = [0, 0, 0]; e[ax] = 1\n93\t    c = V(*p); h = gen / 2.0\n94\t    a = V(*[p[i] - e[i] * h for i in range(3)])\n95\t    halka = cq.Solid.makeCylinder(r + t, gen, a, V(*e)).cut(cq.Solid.makeCylinder(r, gen + 2, a - V(*e) * 1, V(*e)))\n96\t    # dil: halkanın yüzey tarafından yüzeye (r + t kalınlığında şerit)\n97\t    lo = [p[i] - (r + t) for i in range(3)]; hi = [p[i] + (r + t) for i in range(3)]\n98\t    lo[ax], hi[ax] = p[ax] - h, p[ax] + h\n99\t    if sg > 0: lo[nx], hi[nx] = p[nx], yuzey\n100\t    else: lo[nx], hi[nx] = yuzey, p[nx]\n101\t    ok = [i for i in range(3) if i not in (ax, nx)][0]\n102\t    lo[ok], hi[ok] = p[ok] - t / 2.0 - 0.5, p[ok] + t / 2.0 + 0.5\n103\t    dil = kut(lo[0], hi[0], lo[1], hi[1], lo[2], hi[2]).cut(cq.Solid.makeCylinder(r, gen + 2, a - V(*e) * 1, V(*e)))\n104\t    # yüzey tablası (vida deliği tablası 12 × 16 × t)\n105\t    lo2 = [p[i] - tab for i in range(3)]; hi2 = [p[i] + tab for i in range(3)]          # tab 8: 16 mm tabla · dar yerde 5 (M4 vida)\n106\t    lo2[ax], hi2[ax] = p[ax] - h, p[ax] + h\n107\t    if sg > 0: lo2[nx], hi2[nx] = yuzey - t, yuzey\n108\t    else: lo2[nx], hi2[nx] = yuzey, yuzey + t\n109\t    tab = kut(lo2[0], hi2[0], lo2[1], hi2[1], lo2[2], hi2[2])\n110\t    return halka.fuse(dil).fuse(tab).clean()\n111\t\n112\t\n113\tdef kelepceler(pts, r, yuzeyler, aralik=250.0, uc_pay=60.0):\n114\t    \"\"\"polyline boyunca her ≥ aralik mm'de bir kelepçe: yuzeyler [(segment indeksi, yuzey koordinatı, yon)] · döner [(nokta, şekil)]\"\"\"\n115\t    out = []\n116\t    for i, yuz in yuzeyler:\n117\t        a, b = pts[i], pts[i + 1]; L = math.dist(a, b)\n118\t        if L < 2 * uc_pay: n = 1\n119\t        else: n = max(1, int(math.ceil((L - 2 * uc_pay) / aralik)) + 1)\n120\t        eksen = \"xyz\"[[abs(b[k] - a[k]) > 1e-6 for k in range(3)].index(True)]\n121\t        for j in range(n):\n122\t            f = 0.5 if n == 1 else (uc_pay + j * (L - 2 * uc_pay) / (n - 1)) / L\n123\t            p = tuple(a[k] + f * (b[k] - a[k]) for k in range(3))\n124\t            out.append((p, kelepce(p, eksen, r, yuz[0], yuz[1])))\n125\t    return out\n126\t\n127\t\n128\t# ---------------------------------------------------------------- RAKOR (sac geçişi) ----------------------------------------------------------------\n129\tdef rakor(p, eksen, r_kablo, t_sac, yon=\"+\", disli=None):\n130\t    \"\"\"p: sacın DIŞ yüzündeki merkez · eksen: sac normali · yon: '+' → gövde sacın + tarafında (somun − tarafında) · IP68 PA rakor:\n131\t    gövde altıgen (dış) + dişli boyun sacın içinden + somun (iç) · döner (rakor, sac deliği kesicisi)\"\"\"\n132\t    ax = \"xyz\".index(eksen); e = [0, 0, 0]; e[ax] = 1; e = V(*e); sg = 1.0 if yon == \"+\" else -1.0\n133\t    rg = disli or max(6.0, r_kablo + 3.0)                       # dişli boyun yarıçapı (M12 · M16 · M20 · M25)\n134\t    c = V(*p)\n135\t    govde = cq.Solid.makeCylinder(rg + 3.5, 12.0, c, e * sg)\n136\t    boyun = cq.Solid.makeCylinder(rg, t_sac + 8.0, c - e * sg * (t_sac + 8.0), e * sg)\n137\t    somun = cq.Solid.makeCylinder(rg + 3.0, 5.0, c - e * sg * (t_sac + 5.0), e * sg)\n138\t    L_ = max(60.0, 2.0 * (t_sac + 20.0))\n139\t    r = govde.fuse(boyun).fuse(somun).cut(cq.Solid.makeCylinder(r_kablo, L_, c - e * sg * (L_ / 2.0), e * sg)).clean()\n140\t    delik = cq.Solid.makeCylinder(rg + 0.25, t_sac + 20.0, c - e * sg * (t_sac + 10.0), e * sg)\n141\t    return r, delik\n142\t\n143\t\n144\t# ---------------------------------------------------------------- DÖKÜM (çakışma) ----------------------------------------------------------------\n145\t_D = []\n146\t\n147\t\n148\tdef dokum():\n149\t    if not _D:\n150\t        from OCP.TopoDS import TopoDS_Iterator\n151\t        idx = json.load(io.open(os.path.join(DD, \"dunya.json\"), encoding=\"utf-8\"))\n152\t        sh = cq.Shape.importBrep(os.path.join(DD, \"dunya.brep\"))\n153\t        it = TopoDS_Iterator(sh.wrapped); ch = []\n154\t        while it.More():\n155\t            ch.append(cq.Shape.cast(it.Value())); it.Next()\n156\t        assert len(ch) == len(idx)\n157\t        for i, s in zip(idx, ch):\n158\t            b = s.BoundingBox()\n159\t            _D.append((\"%s|%s\" % (i[0], i[1]), s, (b.xmin, b.xmax, b.ymin, b.ymax, b.zmin, b.zmax)))\n160\t    return _D\n161\t\n162\t\n163\tdef _ust(a, b, t=0.05):\n164\t    return a[0] < b[1] - t and b[0] < a[1] - t and a[2] < b[3] - t and b[2] < a[3] - t and a[4] < b[5] - t and b[4] < a[5] - t\n165\t\n166\t\n167\tdef cakisma(sh, haric=(), esik=0.5):\n168\t    \"\"\"sh ↔ montaj dökümü · haric: ad önekleri ('BIRIM|parca' ya da 'BIRIM|') · döner [(ad, hacim)]\"\"\"\n169\t    b = sh.BoundingBox(); bb = (b.xmin, b.xmax, b.ymin, b.ymax, b.zmin, b.zmax); out = []\n170\t    for ad, s, sb in dokum():\n171\t        if not _ust(bb, sb): continue\n172\t        if haric and ad.startswith(tuple(haric)): continue\n173\t        try: v = sh.intersect(s).Volume()\n174\t        except Exception: v = -1.0\n175\t        if v > esik or v < 0: out.append((ad, round(v, 1)))\n176\t    return out\n177\t\n178\t\n179\tdef yakin(bb, pay=30.0, onek=None):\n180\t    \"\"\"kutu çevresindeki döküm parçaları (bilgi / yol arama)\"\"\"\n181\t    q = (bb[0] - pay, bb[1] + pay, bb[2] - pay, bb[3] + pay, bb[4] - pay, bb[5] + pay)\n182\t    return [(ad, sb) for ad, s, sb in dokum() if _ust(q, sb, 0.0) and (onek is None or ad.startswith(onek))]\n183\t"}]},"uuid":"ab8e3266-3ce4-4881-a177-131c1b9948f5","timestamp":"2026-10-01T12:50:37.168Z","sourceToolAssistantUUID":"60935623-d43f-495a-b5cf-5c0223f5cd99","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
