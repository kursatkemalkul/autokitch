\nmcp__plugin_small-business_google-drive__create_file\nmcp__plugin_small-business_google-drive__download_file_content\nmcp__plugin_small-business_google-drive__get_file_metadata\nmcp__plugin_small-business_google-drive__get_file_permissions\nmcp__plugin_small-business_google-drive__list_recent_files\nmcp__plugin_small-business_google-drive__read_file_content\nmcp__plugin_small-business_google-drive__search_files\nmcp__plugin_small-business_shopify__add-to-collection\nmcp__plugin_small-business_shopify__bulk-update-product-status\nmcp__plugin_small-business_shopify__create-collection\nmcp__plugin_small-business_shopify__create-digital-product\nmcp__plugin_small-business_shopify__create-digital-product-from-link\nmcp__plugin_small-business_shopify__create-discount\nmcp__plugin_small-business_shopify__create-product\nmcp__plugin_small-business_shopify__find-mock-shop-catalogs\nmcp__plugin_small-business_shopify__find-sample-product\nmcp__plugin_small-business_shopify__generate-business-names\nmcp__plugin_small-business_shopify__generate-domain-names\nmcp__plugin_small-business_shopify__get-collection\nmcp__plugin_small-business_shopify__get-digital-product\nmcp__plugin_small-business_shopify__get-inventory-levels\nmcp__plugin_small-business_shopify__get-new-store-previews\nmcp__plugin_small-business_shopify__get-order\nmcp__plugin_small-business_shopify__get-product\nmcp__plugin_small-business_shopify__get-shop-info\nmcp__plugin_small-business_shopify__graphql_mutation\nmcp__plugin_small-business_shopify__graphql_query\nmcp__plugin_small-business_shopify__graphql_schema\nmcp__plugin_small-business_shopify__import-mock-shop-catalog\nmcp__plugin_small-business_shopify__list-customers\nmcp__plugin_small-business_shopify__list-orders\nmcp__plugin_small-business_shopify__open-digital-products-install\nmcp__plugin_small-business_shopify__publish-digital-product\nmcp__plugin_small-business_shopify__run-analytics-query\nmcp__plugin_small-business_shopify__search-collective-pr