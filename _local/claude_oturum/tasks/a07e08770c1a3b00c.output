{"parentUuid":"421a9d8b-14cc-41a3-b632-c234c13199df","isSidechain":true,"promptId":"50d61844-03e1-47e6-9599-4d79a818d07e","agentId":"a07e08770c1a3b00c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LtzskKQeXanDpf9AdEAFqQ","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"HAT VERSİYON 2 · R · ROBOT RAYI EKLERİ ADAPTÖRÜ v1 (30 Eyl 2026 · Claude · YEREL) — ray_ek_cad_v1'in v2 kopyası (yalnız sol uca bağlı değerler değişti).\n3\tv2: robot yer rayı x 707,5–5100 (h3_hesap_v1.ROBOT_RAY_X · v1 200–5100) — hattın sol grubu 507,5 sağa kaydı, sağ uç (QR, zemin kanalı, 5100) SABİT.\n4\tDEĞİŞENLER (v1 → v2):\n5\t  · RAY_X / OLUK x: 200 → 707,5 (sağ uç 5100 aynı) → oluk tabanı + iki yan 4392,5 boy · sol uç duvarı 707,5–709,5 · robot merkezi aralığı 300 → 807,5 … 5000\n6\t  · XF (zincir sabit ucu) = RAY ORTASI (SPEC kuralı, v1'de de (200 + 5100) / 2): 2650 → 2903,75 → zincir boyu igus kuralıyla 2875 → 2625,\n7\t    montaj pozunda büküm merkezi 1448 → 1700 · sabit uç braketi 2903,75 · oluk kapakları (sabit kablo bölümü) XF + 2 … 5100 (3 × 730,1; v1 3 × 814,7)\n8\t  · v1'de XF = RX_MONTAJ olduğu için robot tarafındaki kablo noktaları (kaide yanı iniş M1–M3) ve 2 kablo kelepçesi \"XF + …\" yazılmıştı; bunlar ROBOTA\n9\t    bağlı → v2'de RX_MONTAJ + … (yerleri v1 ile BİREBİR aynı: 2695–2725 · 2710)\n10\t  · X_BAG = XF + 70 (sabit uçtan oluğa iniş) 2720 → 2973,75 · uzatma konnektörü (4 m standart kablo biter) hesapla sağa kayar · uzatma kablosu kısalır,\n11\t    artanı QR altındaki kangala geçer (sarım sayısı hesapla)\n12\tAYNI KALANLAR: RZ 360 · RX_MONTAJ 2650 (montaj robot konumu) · oluk sağ uç duvarı 5098–5100 · zemin kanalı + kapakları · QR sabitleri · hareketli uç braketi ·\n13\t  kablo kelepçeleri · zincir kesiti (VARSAYIM igus E2 iç 28 × 50, R 150) · kablo Ø20 · 4 m + 11 m.\n14\tSÖZLEŞME (v1 ile aynı): kur() · PARCALAR · dunya(p) · BIRIMLER · BIRIM_MODUL · ON_BIRIMLER · MALZEME · RZ · RX_MONTAJ · RAY_X · XF · L_ZINCIR · x_min_etkin() · kablo_hesabi()\n15\tKOORDİNAT: DÜNYA (X sağa · Y yukarı 0 = zemin · Z koridora doğru, modül ön yüzü +79). mm.\n16\tVARSAYIM (v1 ile aynı): kablo Ø20 · zincir iç 28 × 50, dış 40 × 64, R 150 · araba yarı boyu 100 · robot tabanı içinde 300 mm kablo.\n17\tÇalıştır (öz denetim): python ob_calistir.py h2/h3_ray_ek_v1.py [hizli]\n18\t\"\"\"\n19\timport math, os, sys, time\n20\t\n21\tH2 = os.path.dirname(os.path.abspath(__file__)); U = os.path.dirname(H2)\n22\tfor _p in (U, H2):\n23\t    if _p not in sys.path: sys.path.insert(0, _p)\n24\timport cadquery as cq\n25\timport h3_hesap_v1 as H\n26\timport qr_cad_v1 as QR                    # yalnız sabitler (konnektör, geçiş, kangal bölgesi) · QR burada KURULMAZ\n27\t\n28\t# ---------------------------------------------------------------- ÖLÇÜLER (dünya) ----------------------------------------------------------------\n29\tRAY_X = tuple(H.ROBOT_RAY_X)              # v2: 707,5–5100 (v1 200–5100) · FR5 yer rayı\n30\tRZ = 360.0                                # ray ekseni (DEĞİŞMEZ) · ROBOT_RAY z 240–480\n31\tRAY_Z = (RZ - 120.0, RZ + 120.0)\n32\tOLUK = dict(x=RAY_X, y=(0.0, 60.0), z=(485.0, 575.0))    # v2: oluk rayla aynı boyda (sol uç 707,5) · y / z v1 ile aynı\n33\tOT = 2.0                                  # oluk sacı AISI 304 2 mm\n34\tKAPAK_T = 3.0                             # basılır kapak 3 mm gözyaşı desenli AISI 304\n35\tKABLO_D = 20.0                            # VARSAYIM (konnektör Ø26)\n36\tZ_H = dict(hG=40.0, bA=64.0, hi=28.0, bi=50.0, R=150.0, pay=25.0, adim=25.0)   # enerji zinciri VARSAYIM (igus E2 sınıfı)\n37\tZC = (OLUK[\"z\"][0] + OLUK[\"z\"][1]) / 2.0  # 530 · zincir + kablo ekseni\n38\tY_ALT = OT + Z_H[\"hG\"] / 2.0              # 22 · alt kol ekseni (oluk tabanına oturur)\n39\tY_UST = Y_ALT + 2.0 * Z_H[\"R\"]            # 322 · üst kol ekseni\n40\tXF = (RAY_X[0] + RAY_X[1]) / 2.0          # v2: 2903,75 · sabit uç = RAY ORTASI (SPEC · v1 2650 = (200 + 5100) / 2)\n41\tRX_MONTAJ = 2650.0                        # montajda robot yeri (hareketli uç) · v1 ile AYNI (montaj RX)\n42\tARABA_YARI = 100.0                        # VARSAYIM · robot merkezi 807,5…5000 (QR önünde 5000'de durur)\n43\tROBOT_X = (RAY_X[0] + ARABA_YARI, RAY_X[1] - ARABA_YARI)\n44\tKAIDE_Z = 450.0                           # montaj ROBOT_1 kaide kutusu z 270–450 (ray ekseni ± 90)\n45\tROBOT_IC = 300.0                          # VARSAYIM · robot kaidesi içinden FR5 taban konnektörüne\n46\tKABLO_TOPLAM, KABLO_STD, KABLO_UZ = 15000.0, 4000.0, 11000.0       # inluxrobotics.eu FR5: standart 4 m · uzatma 11 m\n47\tKONN_L, KONN_R = 110.0, 17.0              # birleşik konnektör çifti Ø34 × 110 VARSAYIM (Ø26 konnektör + kilit somunu)\n48\tKANAL = dict(x=(4760.0, 4840.0), y=(-60.0, 0.0), z=(490.0, 1000.0), kapak_z=(575.0, 670.0))   # SPEC: x 4760–4840, z 575–670 basılır kapak (v1 ile aynı)\n49\tKT = 2.0                                  # kanal sacı\n50\tKABLO_X_KANAL = 4780.0                    # kanalın robot kablosu bölmesi (ayırıcı x 4800; sağ bölme güç/veri)\n51\tFLG = 1500.0                              # üst kolun kendini taşıyabildiği boy VARSAYIM (katalogla teyit)\n52\tX_ROB_AC = H.X_ROB_AC                     # 1207,5 · robot topu açıcıya bırakırken (zincirle erişilmeli)\n53\t\n54\t# QR sabitleri (dünya) — v2'de QR yerinde\n55\tKONN_QR = (QR.X0 + QR.KONNEKTOR[0], QR.Y0 + QR.KONNEKTOR[1], QR.Z0 + QR.KONNEKTOR[2])      # (5070, 120, 900)\n56\tGECIS = (QR.X0 + QR.GECIS_ROBOT[0], QR.Z0 + QR.GECIS_ROBOT[1])                              # (4780, 975)\n57\tKG = dict(xc=QR.X0 + QR.KANGAL[\"xc\"], zc=QR.Z0 + QR.KANGAL[\"zc\"], ri=QR.KANGAL[\"r_ic\"], rd=QR.KANGAL[\"r_dis\"], y0=QR.Y0 + QR.KANGAL[\"y0\"])\n58\tKG_RM = (KG[\"ri\"] + KG[\"rd\"]) / 2.0      # 125 · kangal ortalama yarıçapı (statik büküm ≥ 5 × d = 100 VARSAYIM)\n59\t\n60\t\n61\tdef _s(v):\n62\t    t = (\"%.2f\" % v).replace(\".\", \",\").rstrip(\"0\").rstrip(\",\")\n63\t    return t\n64\t\n65\t\n66\tPARCALAR = []\n67\tMODUL = \"-\"                               # SPEC: zincir oluğu + enerji zinciri + zemin kanalı + robot kablosu modül \"-\" (R)\n68\tBIRIMLER = [\n69\t    (\"ROBOT_ZINCIR_OLUGU\", \"Zincir oluğu · ray boyunca x %s–%s · z 485–575 · y 0–60 · AISI 304 2 mm · x %s–%s basılır kapaklı (sabit kablo), %s–%s açık (zincir buradan kalkar) · HAT v2\"\n70\t     % (_s(OLUK[\"x\"][0]), _s(OLUK[\"x\"][1]), _s(XF), _s(OLUK[\"x\"][1]), _s(OLUK[\"x\"][0]), _s(XF))),\n71\t    (\"ROBOT_ENERJI_ZINCIRI\", \"Enerji zinciri (igus E2 sınıfı, VARSAYIM iç 28 × 50, R 150) · sabit uç x %s (ray ortası) · hareketli uç robot kaidesinde · montaj konumunda (robot x %s) U katlı · HAT v2\"\n72\t     % (_s(XF), _s(RX_MONTAJ))),\n73\t    (\"ROBOT_KABLOSU\", \"Robot kablosu (Fairino FR5 kol ↔ kontrol kutusu, tek kablo) · standart 4 m + uzatma 11 m = 15 m · QR altında kangal\"),\n74\t    (\"ZEMIN_KANALI\", \"Zemin kanalı · şapa gömülü y −60…0 · x 4760–4840 · z 490–1000 · koridorda (z 575–670) basılır kapak · QR altında kapak + Ø40 rakor\"),\n75\t]\n76\tBIRIM_MODUL = {k: MODUL for k, _a in BIRIMLER}\n77\tON_BIRIMLER = tuple(k for k, _a in BIRIMLER)     # hepsi hattın önünde (z > 0) · ROBOT_ öneki montajın ÖN YÜZ istisnasında VAR, ZEMIN_KANALI EKLENMELİ\n78\tMALZEME = {\"paslanmaz\": dict(renk=(0.80, 0.82, 0.84, 1.0), met=0.9, ruf=0.30), \"zincir\": dict(renk=(0.12, 0.12, 0.13, 1.0), met=0.0, ruf=0.55),\n79\t           \"kablo\": dict(renk=(0.95, 0.55, 0.10, 1.0), met=0.0, ruf=0.6), \"konnektor\": dict(renk=(0.55, 0.56, 0.58, 1.0), met=0.8, ruf=0.35),\n80\t           \"celik\": dict(renk=(0.60, 0.62, 0.66, 1.0), met=1.0, ruf=0.35), \"plastik\": dict(renk=(0.12, 0.12, 0.13, 1.0), met=0.0, ruf=0.6)}\n81\t\n82\t\n83\tdef kut(x0, x1, y0, y1, z0, z1):\n84\t    return cq.Workplane(\"XY\").box(abs(x1 - x0), abs(y1 - y0), abs(z1 - z0), centered=False).translate((min(x0, x1), min(y0, y1), min(z0, z1)))\n85\tdef sily(x, z, r, y0, y1): return cq.Workplane(\"XZ\").center(x, z).circle(r).extrude(-(y1 - y0)).translate((0, y0, 0))\n86\tdef silz(x, y, r, z0, z1): return cq.Workplane(\"XY\").center(x, y).circle(r).extrude(z1 - z0).translate((0, 0, z0))\n87\tdef silx(y, z, r, x0, x1): return cq.Workplane(\"YZ\", origin=(min(x0, x1), y, z)).circle(r).extrude(abs(x1 - x0))\n88\t\n89\t\n90\tdef boru(pts, r):\n91\t    \"\"\"nokta dizisi boyunca boru (silindir + dirsek küreleri) · uçlarda küre YOK\"\"\"\n92\t    ss = []\n93\t    for a, b in zip(pts[:-1], pts[1:]):\n94\t        v = cq.Vector(*b) - cq.Vector(*a)\n95\t        if v.Length > 1e-6: ss.append(cq.Solid.makeCylinder(r, v.Length, cq.Vector(*a), v.normalized()))\n96\t    for p in pts[1:-1]: ss.append(cq.Solid.makeSphere(r, cq.Vector(*p), angleDegrees1=-90, angleDegrees2=90))\n97\t    return cq.Workplane(obj=cq.Compound.makeCompound(ss))\n98\t\n99\t\n100\tdef uzunluk(pts):\n101\t    return sum(math.dist(a, b) for a, b in zip(pts[:-1], pts[1:]))\n102\t\n103\t\n104\tdef ekle(ad, wp, mal, birim, bom=None, grup=\"SABIT\", kaynak=\"\"):\n105\t    assert all(p[\"ad\"] != ad for p in PARCALAR), ad\n106\t    PARCALAR.append(dict(ad=ad, wp=wp, mal=mal, birim=birim, grup=grup, kaynak=kaynak, bom=bom))\n107\t\n108\t\n109\tdef dunya(p):\n110\t    v = p[\"wp\"].vals()\n111\t    return v[0] if len(v) == 1 else cq.Compound.makeCompound([o for o in v if isinstance(o, cq.Shape)])\n112\t\n113\t\n114\t# ---------------------------------------------------------------- ENERJİ ZİNCİRİ HESABI (v1 ile aynı formüller) ----------------------------------------------------------------\n115\tdef zincir_boyu():\n116\t    \"\"\"igus uzun yol kuralı: sabit uç ortada → L = (en uzak strok yarısı) + πR + 2 × güvenlik payı · adıma yuvarlanır\"\"\"\n117\t    R = Z_H[\"R\"]\n118\t    L0 = max(ROBOT_X[1] - XF, XF - ROBOT_X[0]) + math.pi * R + 2.0 * Z_H[\"pay\"]\n119\t    return math.ceil(L0 / Z_H[\"adim\"]) * Z_H[\"adim\"]\n120\t\n121\t\n122\tL_ZINCIR = zincir_boyu()                  # v2 2625 (v1 2875)\n123\t\n124\t\n125\tdef donus_x(xm):\n126\t    \"\"\"dönüş (büküm) merkezinin x'i · büküm SOL (−x) tarafta: alt kol xc…XF, üst kol xc…xm\"\"\"\n127\t    return (XF + xm - L_ZINCIR + math.pi * Z_H[\"R\"]) / 2.0\n128\t\n129\t\n130\tdef x_min_etkin():\n131\t    \"\"\"büküm dış kenarı oluk sol uç duvarına (iç yüz 709,5) 5 mm kalana dek → robotun zincirle gidebildiği en sol x\"\"\"\n132\t    sinir = OLUK[\"x\"][0] + OT + 5.0 + Z_H[\"R\"] + Z_H[\"hG\"] / 2.0\n133\t    return 2.0 * sinir - XF + L_ZINCIR - math.pi * Z_H[\"R\"]\n134\t\n135\t\n136\tdef zincir_yolu(xm=RX_MONTAJ, n=24):\n137\t    \"\"\"zincir tarafsız ekseni (dünya): sabit uç XF → alt kol → büküm → üst kol → hareketli uç xm\"\"\"\n138\t    xc = donus_x(xm); R = Z_H[\"R\"]; yc = (Y_ALT + Y_UST) / 2.0\n139\t    pts = [(XF, Y_ALT, ZC), (xc, Y_ALT, ZC)]\n140\t    for i in range(1, n):\n141\t        a = -math.pi / 2.0 - math.pi * i / n                  # alttan (−90°) sola (−180°) üste (−270°)\n142\t        pts.append((xc + R * math.cos(a), yc + R * math.sin(a), ZC))\n143\t    pts += [(xc, Y_UST, ZC), (xm, Y_UST, ZC)]\n144\t    return pts\n145\t\n146\t\n147\t# ---------------------------------------------------------------- KABLO YOLU ----------------------------------------------------------------\n148\tY_KANAL = KANAL[\"y\"][0] + KT + KABLO_D / 2.0       # −48 · kablo kanal tabanında\n149\tY_OLUK = OT + KABLO_D / 2.0                        # 12 · kablo oluk tabanında\n150\tY_KONN = OT + KONN_R                               # 19 · konnektör oluk tabanına oturur\n151\tX_BAG = XF + 70.0                                  # v2 2973,75 (v1 2720) · sabit uçtan oluğa iniş\n152\tX_ROB_KABLO = RX_MONTAJ + 60.0                     # 2710 · robot kaidesi yanında kablonun indiği x (v1'de \"XF + 60\" yazılıydı; XF = RX_MONTAJ idi)\n153\t\n154\t\n155\tdef rota_parcalari(N=None):\n156\t    \"\"\"(robot tarafı standart parça, uzatma parça A [konnektör → kangal altı], uzatma parça B [kangal üstü → kontrol kutusu], xj, N)\n157\t    xj (konnektör ortası) standart kablo 4 m olacak şekilde, N (kangal sarım sayısı) uzatma 11 m olacak şekilde çözülür.\"\"\"\n158\t    zy = zincir_yolu()\n159\t    # robot ucu → sabit uç (ters sırada) · v2: robot tarafı noktaları ROBOTA bağlı (RX_MONTAJ + 60)\n160\t    M3, M2, M1 = (X_ROB_KABLO, 800.0, 470.0), (X_ROB_KABLO, Y_UST, 470.0), (X_ROB_KABLO, Y_UST, ZC)\n161\t    robot = [M3, M2, M1] + list(reversed(zy)) + [(XF + 50.0, Y_ALT, ZC), (X_BAG, Y_OLUK, ZC)]\n162\t    L_rob = ROBOT_IC + uzunluk(robot)\n163\t    rampa = math.hypot(25.0, Y_KONN - Y_OLUK)\n164\t    # standart = L_rob + (xj − 95 − X_BAG) + rampa + 15 (düz giriş: dirsek küresi konnektöre girmesin) + KONN_L/2 = 4000\n165\t    xj = X_BAG + 95.0 + (KABLO_STD - KONN_L / 2.0 - 15.0 - rampa - L_rob)\n166\t    std = robot + [(xj - 95.0, Y_OLUK, ZC), (xj - 70.0, Y_KONN, ZC), (xj - KONN_L / 2.0, Y_KONN, ZC)]\n167\t    K8, K7, K6, K5 = (KABLO_X_KANAL, Y_OLUK, ZC), (KABLO_X_KANAL, Y_KANAL, ZC), (KABLO_X_KANAL, Y_KANAL, GECIS[1]), (KABLO_X_KANAL, QR.TABAN[1] + KABLO_D / 2.0, GECIS[1])\n168\t    K4 = (KONN_QR[0] + 20.0, QR.TABAN[1] + KABLO_D / 2.0, GECIS[1])\n169\t    Eb = (KG[\"xc\"] - KG_RM, KG[\"y0\"] + KABLO_D / 2.0, KG[\"zc\"])\n170\t    A = [(xj + KONN_L / 2.0, Y_KONN, ZC), (xj + 70.0, Y_KONN, ZC), (xj + 95.0, Y_OLUK, ZC), K8, K7, K6, K5, K4, Eb]\n171\t    K1 = (KONN_QR[0] + 20.0, KONN_QR[1], KONN_QR[2])\n172\t    if N is None:\n173\t        N = 10.0\n174\t    for _i in range(8):                                   # kangal üst ucu N'ye bağlı → yakınsat\n175\t        Et = (KG[\"xc\"] - KG_RM, KG[\"y0\"] + N * KABLO_D - KABLO_D / 2.0, KG[\"zc\"])\n176\t        B = [Et, K1, KONN_QR]\n177\t        kangal = KABLO_UZ - KONN_L / 2.0 - uzunluk(A) - uzunluk(B)\n178\t        N = kangal / (2.0 * math.pi * KG_RM)\n179\t    return std, A, B, xj, N\n180\t\n181\t\n182\tdef kablo_hesabi():\n183\t    std, A, B, xj, N = rota_parcalari()\n184\t    L_std = ROBOT_IC + uzunluk(std) + KONN_L / 2.0\n185\t    kangal = N * 2.0 * math.pi * KG_RM\n186\t    L_uz = KONN_L / 2.0 + uzunluk(A) + kangal + uzunluk(B)\n187\t    zy = zincir_yolu()\n188\t    bol = [(\"robot tabanı içi (VARSAYIM)\", ROBOT_IC), (\"kaide yanı + araba braketi\", uzunluk(std[:3]) + math.dist(std[2], zy[-1])),\n189\t           (\"enerji zinciri (L)\", uzunluk(zy)), (\"oluk: sabit uç → konnektör\", uzunluk(std[3 + len(zy) - 1:]) + KONN_L / 2.0),\n190\t           (\"oluk: konnektör → kanal\", KONN_L / 2.0 + uzunluk(A[:4])), (\"zemin kanalı (yükseliş + boy + iniş)\", uzunluk(A[3:7])),\n191\t           (\"QR içi: rakor → kangal altı\", uzunluk(A[6:])), (\"KANGAL %.2f sarım × Ø%.0f\" % (N, 2 * KG_RM), kangal), (\"QR içi: kangal üstü → kontrol kutusu\", uzunluk(B))]\n192\t    gerekli = sum(v for a_, v in bol if not a_.startswith(\"KANGAL\"))\n193\t    return dict(std=std, A=A, B=B, xj=xj, N=N, L_std=L_std, L_uz=L_uz, kangal=kangal, bol=bol, gerekli=gerekli)\n194\t\n195\t\n196\t# ---------------------------------------------------------------- 1 · ZİNCİR OLUĞU ----------------------------------------------------------------\n197\tdef oluk():\n198\t    b = \"ROBOT_ZINCIR_OLUGU\"\n199\t    x0, x1 = OLUK[\"x\"]; z0, z1 = OLUK[\"z\"]; yk = OLUK[\"y\"][1] - KAPAK_T\n200\t    tb = kut(x0, x1, 0.0, OT, z0, z1).cut(kut(KABLO_X_KANAL - 15.0, KABLO_X_KANAL + 15.0, -1.0, OT + 1.0, ZC - 18.0, ZC + 18.0))\n201\t    ekle(\"oluk_tabani\", tb, \"paslanmaz\", b, bom=(\"Zincir oluğu U profil AISI 304 2 mm (taban + 2 yan)\", 1, \"%s × 90 × 57 · 2 parça (%s) · kanal ağzı 30 × 36\" % (_s(x1 - x0), _s((x1 - x0) / 2.0)), \"üretim (abkant)\", \"ÜRETİM\"))\n202\t    ekle(\"oluk_yan_robot\", kut(x0, x1, OT, yk, z0, z0 + OT), \"paslanmaz\", b)\n203\t    ekle(\"oluk_yan_koridor\", kut(x0, x1, OT, yk, z1 - OT, z1), \"paslanmaz\", b)\n204\t    ekle(\"oluk_uc_duvari_sol\", kut(x0, x0 + OT, OT, yk, z0 + OT, z1 - OT), \"paslanmaz\", b, bom=(\"Oluk uç kapağı 2 mm\", 2, \"86 × 55\", \"üretim\", \"ÜRETİM\"))\n205\t    ekle(\"oluk_uc_duvari_sag\", kut(x1 - OT, x1, OT, yk, z0 + OT, z1 - OT), \"paslanmaz\", b)\n206\t    # basılır kapaklar: yalnız sabit kablo bölümü (XF + 2 … 5100) · zincir bölümü açık (zincir buradan kalkar)\n207\t    a0 = XF + 2.0; n = 3; Lk = (x1 - a0 - 2.0 * (n - 1)) / n\n208\t    for i in range(n):\n209\t        xa = a0 + i * (Lk + 2.0)\n210\t        ekle(\"oluk_kapagi_%d\" % i, kut(xa, xa + Lk, yk, OLUK[\"y\"][1], z0, z1), \"paslanmaz\", b,\n211\t             bom=(\"Oluk kapağı 3 mm gözyaşı desenli AISI 304 (üstüne basılır)\", n, \"%.0f × 90\" % Lk, \"üretim · 2 × M5 havşa\", \"ÜRETİM\") if i == 0 else None)\n212\t    return Lk\n213\t\n214\t\n215\t# ---------------------------------------------------------------- 2 · ENERJİ ZİNCİRİ ----------------------------------------------------------------\n216\tdef zincir():\n217\t    b = \"ROBOT_ENERJI_ZINCIRI\"\n218\t    hG, bA, hi, bi, R = Z_H[\"hG\"], Z_H[\"bA\"], Z_H[\"hi\"], Z_H[\"bi\"], Z_H[\"R\"]\n219\t    xc = donus_x(RX_MONTAJ); yc = (Y_ALT + Y_UST) / 2.0\n220\t    za, zb, ia, ib = ZC - bA / 2.0, ZC + bA / 2.0, ZC - bi / 2.0, ZC + bi / 2.0\n221\t    alt = kut(xc, XF, Y_ALT - hG / 2.0, Y_ALT + hG / 2.0, za, zb).cut(kut(xc - 1.0, XF + 1.0, Y_ALT - hi / 2.0, Y_ALT + hi / 2.0, ia, ib))\n222\t    ust = kut(xc, RX_MONTAJ, Y_UST - hG / 2.0, Y_UST + hG / 2.0, za, zb).cut(kut(xc - 1.0, RX_MONTAJ + 1.0, Y_UST - hi / 2.0, Y_UST + hi / 2.0, ia, ib))\n223\t    halka = silz(xc, yc, R + hG / 2.0, za, zb).cut(silz(xc, yc, R - hG / 2.0, za - 1, zb + 1)).cut(kut(xc, xc + R + hG, yc - R - hG, yc + R + hG, za - 1, zb + 1))\n224\t    halka = halka.cut(silz(xc, yc, R + hi / 2.0, ia, ib).cut(silz(xc, yc, R - hi / 2.0, ia - 1, ib + 1)))\n225\t    ekle(\"enerji_zinciri\", alt.union(halka).union(ust), \"zincir\", b,\n226\t         bom=(\"Enerji zinciri igus E2 sınıfı · iç 28 × 50 · dış 40 × 64 · R 150\", 1, \"boy %.0f (strok yarısı %.0f + πR %.0f + 2 × %.0f pay)\" % (L_ZINCIR, max(ROBOT_X[1] - XF, XF - ROBOT_X[0]), math.pi * R, Z_H[\"pay\"]),\n227\t              \"VARSAYIM ölçü · igus.com.tr seçim (uzun yol, üst kol desteği gerekir)\", \"SATIN ALMA\"))\n228\t    # sabit uç braketi (oluk tabanına) · hareketli uç braketi (robot kaidesine)\n229\t    sb = kut(XF, XF + 40.0, OT, OT + 44.0, ZC - 40.0, ZC + 40.0).cut(silx(Y_ALT, ZC, 12.0, XF - 1.0, XF + 41.0))\n230\t    ekle(\"zincir_sabit_uc_braketi\", sb, \"celik\", b, bom=(\"Zincir bağlantı braketi (sabit uç, oluk tabanına 2 × M6)\", 1, \"40 × 44 × 80\", \"igus KMA sınıfı VARSAYIM\", \"SATIN ALMA\"))\n231\t    hb = kut(RX_MONTAJ, RX_MONTAJ + 40.0, Y_UST - 22.0, Y_UST + 22.0, ZC - 38.0, ZC + 38.0).cut(silx(Y_UST, ZC, 12.0, RX_MONTAJ - 1.0, RX_MONTAJ + 41.0))\n232\t    hb = hb.union(kut(RX_MONTAJ, RX_MONTAJ + 40.0, Y_UST + 22.0, Y_UST + 28.0, KAIDE_Z + 0.5, ZC + 38.0))\n233\t    hb = hb.union(kut(RX_MONTAJ, RX_MONTAJ + 40.0, Y_UST - 22.0, Y_UST + 128.0, KAIDE_Z + 0.5, KAIDE_Z + 6.5))\n234\t    ekle(\"zincir_hareketli_uc_braketi\", hb, \"celik\", b, bom=(\"Zincir hareketli uç braketi + kaide kolu 6 mm\", 1, \"robot kaidesine 4 × M8\", \"üretim (lazer + büküm)\", \"ÜRETİM\"))\n235\t    return xc\n236\t\n237\t\n238\t# ---------------------------------------------------------------- 3 · ZEMİN KANALI (v1 ile aynı) ----------------------------------------------------------------\n239\tdef kanal():\n240\t    b = \"ZEMIN_KANALI\"\n241\t    x0, x1 = KANAL[\"x\"]; y0, y1 = KANAL[\"y\"]; z0, z1 = KANAL[\"z\"]; yk = y1 - KAPAK_T\n242\t    ekle(\"kanal_tabani\", kut(x0, x1, y0, y0 + KT, z0, z1), \"paslanmaz\", b, bom=(\"Zemin kanalı AISI 304 2 mm (taban + yanlar + uçlar + ayırıcı)\", 1, \"80 × 60 × 510 · şapaya gömülü\", \"üretim\", \"ÜRETİM\"))\n243\t    ekle(\"kanal_yan_sol\", kut(x0, x0 + KT, y0 + KT, yk, z0, z1), \"paslanmaz\", b)\n244\t    ekle(\"kanal_yan_sag\", kut(x1 - KT, x1, y0 + KT, yk, z0, z1), \"paslanmaz\", b)\n245\t    ekle(\"kanal_uc_hat\", kut(x0 + KT, x1 - KT, y0 + KT, yk, z0, z0 + KT), \"paslanmaz\", b)\n246\t    ekle(\"kanal_uc_qr\", kut(x0 + KT, x1 - KT, y0 + KT, yk, z1 - KT, z1), \"paslanmaz\", b)\n247\t    ekle(\"kanal_ayirici\", kut(4799.0, 4801.0, y0 + KT, yk, z0 + KT, z1 - KT), \"paslanmaz\", b,\n248\t         bom=(\"Kanal ayırıcı 2 mm (robot kablosu | ana pano güç/veri — EMC ayrımı)\", 1, \"\", \"üretim · güç/veri kabloları modellenmedi\", \"ÜRETİM\"))\n249\t    ekle(\"kanal_kapagi_koridor\", kut(x0, x1, yk, y1, KANAL[\"kapak_z\"][0], KANAL[\"kapak_z\"][1]), \"paslanmaz\", b,\n250\t         bom=(\"Kanal kapağı 3 mm gözyaşı desenli (koridor, üstüne basılır)\", 1, \"80 × 95\", \"üretim\", \"ÜRETİM\"))\n251\t    kq = kut(x0, x1, yk, y1, KANAL[\"kapak_z\"][1], z1).cut(sily(GECIS[0], GECIS[1], 20.0, yk - 1.0, y1 + 1.0)).cut(sily(QR.X0 + QR.GECIS_GUC[0], GECIS[1], 15.0, yk - 1.0, y1 + 1.0))\n252\t    ekle(\"kanal_kapagi_QR_alti\", kq, \"paslanmaz\", b, bom=(\"Kanal kapağı 3 mm (QR altı) · Ø40 + Ø30 rakor delikli\", 1, \"80 × 330\", \"üretim\", \"ÜRETİM\"))\n253\t\n254\t\n255\t# ---------------------------------------------------------------- 4 · ROBOT KABLOSU ----------------------------------------------------------------\n256\tdef kablo():\n257\t    b = \"ROBOT_KABLOSU\"\n258\t    h = kablo_hesabi()\n259\t    r = KABLO_D / 2.0\n260\t    ekle(\"robot_kablosu_standart_4m\", boru(h[\"std\"], r), \"kablo\", b,\n261\t         bom=(\"Fairino robot kablosu (standart, robotla gelir)\", 1, \"4 m · güç + haberleşme tek kablo · Ø26 dairesel konnektör\", \"inluxrobotics.eu FR5 · çap VARSAYIM Ø20\", \"SATIN ALMA\"))\n262\t    ekle(\"robot_kablosu_uzatma_A\", boru(h[\"A\"], r), \"kablo\", b,\n263\t         bom=(\"Fairino uzatma kablosu 11 m\", 1, \"standart kabloyla toplam 15 m\", \"inluxrobotics.eu (Fairino Extension Cable 11 m)\", \"SATIN ALMA\"))\n264\t    ekle(\"robot_kablosu_uzatma_B\", boru(h[\"B\"], r), \"kablo\", b)\n265\t    xj = h[\"xj\"]\n266\t    ekle(\"uzatma_konnektoru\", silx(Y_KONN, ZC, KONN_R, xj - KONN_L / 2.0, xj + KONN_L / 2.0), \"konnektor\", b,\n267\t         bom=(\"Kablo birleşimi (Ø26 dairesel konnektör çifti) · oluk içinde\", 1, \"zarf Ø34 × 110\", \"VARSAYIM zarf\", \"ALT\"))\n268\t    yk = KG[\"y0\"] + h[\"N\"] * KABLO_D\n269\t    ekle(\"robot_kablosu_kangal\", sily(KG[\"xc\"], KG[\"zc\"], KG[\"rd\"], KG[\"y0\"], yk).cut(sily(KG[\"xc\"], KG[\"zc\"], KG[\"ri\"], KG[\"y0\"] - 1.0, yk + 1.0)), \"kablo\", b,\n270\t         bom=(\"Kablo kangalı (uzatmanın artanı) · QR alt bölmesi · 4 cırt bant\", 1, \"%.2f sarım × Ø%.0f · %.2f m · yük. %.0f\" % (h[\"N\"], 2 * KG_RM, h[\"kangal\"] / 1000.0, h[\"N\"] * KABLO_D), \"hesap (bu dosya)\", \"ALT\"))\n271\t    for i, yy in enumerate((520.0, 720.0)):                  # v2: robot kaidesine bağlı → RX_MONTAJ (v1 \"XF + …\", XF = RX_MONTAJ idi · yer aynı)\n272\t        ekle(\"kablo_kelepcesi_%d\" % i, kut(RX_MONTAJ + 45.0, RX_MONTAJ + 75.0, yy, yy + 20.0, KAIDE_Z + 0.5, 485.0).cut(sily(X_ROB_KABLO, 470.0, r + 0.5, yy - 1.0, yy + 21.0)), \"plastik\", b,\n273\t             bom=(\"Kablo kelepçesi (robot kaidesine)\", 2, \"Ø21\", \"katalog\", \"SATIN ALMA\") if i == 0 else None)\n274\t    return h\n275\t\n276\t\n277\tdef kur():\n278\t    \"\"\"İDEMPOTENT: her çağrıda baştan kurar · PARCALAR nesnesi aynı kalır\"\"\"\n279\t    PARCALAR[:] = []\n280\t    oluk(); zincir(); kanal(); kablo()\n281\t    return PARCALAR\n282\t\n283\t\n284\t# ---------------------------------------------------------------- DENETİM ----------------------------------------------------------------\n285\tISTISNA = [(\"robot_kablosu_kangal\", \"robot_kablosu_uzatma\")]     # kangal = uzatmanın kendisi (uçlar kangal halkasına girer) · v1 ile aynı\n286\t\n287\t\n288\tdef _ist(a, b):\n289\t    return any((p in a and q in b) or (p in b and q in a) for p, q in ISTISNA)\n290\t\n291\t\n292\tdef _bbk(A, B, pay=0.01):\n293\t    return A.xmin < B.xmax - pay and B.xmin < A.xmax - pay and A.ymin < B.ymax - pay and B.ymin < A.ymax - pay and A.zmin < B.zmax - pay and B.zmin < A.zmax - pay\n294\t\n295\t\n296\tdef kendi_arasinda(ps, esik=1.0):\n297\t    S = [(p[\"ad\"], dunya(p)) for p in ps]; S = [(a, s, s.BoundingBox()) for a, s in S]\n298\t    out = []\n299\t    for i, (a, sa, A) in enumerate(S):\n300\t        for c, sc, B in S[i + 1:]:\n301\t            if not _bbk(A, B) or _ist(a, c):\n302\t                continue\n303\t            v = sa.intersect(sc).Volume()\n304\t            if v > esik: out.append((round(v, 3), a, c))\n305\t    return out\n306\t\n307\t\n308\tDEN = []\n309\t\n310\t\n311\tdef kontrol(ad, sart, deger=\"\"):\n312\t    DEN.append((ad, bool(sart), deger)); print(\"  %-150s %s %s\" % (ad, \"GEÇTİ\" if sart else \"** KALDI **\", deger))\n313\t\n314\t\n315\tif __name__ == \"__main__\":\n316\t    t0 = time.time(); arg = sys.argv[1:]\n317\t    kimlik = id(PARCALAR)\n318\t    kur(); ps = kur()\n319\t    gec = [p[\"ad\"] for p in ps if not dunya(p).isValid()]\n320\t    print(\"RAY EKLERİ v2 (h3_ray_ek_v1) · %d parça · katı denetimi: %s · %.0f sn\" % (len(ps), \"hepsi geçerli\" if not gec else gec, time.time() - t0))\n321\t    for kod, _a in BIRIMLER:\n322\t        q = [dunya(p).BoundingBox() for p in ps if p[\"birim\"] == kod]\n323\t        print(\"   %-22s %2d parça · x %.1f–%.1f · y %.1f–%.1f · z %.1f–%.1f\" % (kod, len(q), min(v.xmin for v in q), max(v.xmax for v in q), min(v.ymin for v in q), max(v.ymax for v in q), min(v.zmin for v in q), max(v.zmax for v in q)))\n324\t    print(\"DENETİM (h3_ray_ek_v1)\")\n325\t    kontrol(\"katılar geçerli · kur() iki kez → %d parça (v1 ile aynı sayı 26), PARCALAR nesnesi aynı (idempotent)\" % len(ps), not gec and ps is PARCALAR and id(PARCALAR) == kimlik and len(ps) == 26, \", \".join(gec))\n326\t    ob = [dunya(p).BoundingBox() for p in ps if p[\"birim\"] == \"ROBOT_ZINCIR_OLUGU\"]\n327\t    kontrol(\"zincir oluğu x %.1f–%.1f · y %.0f–%.0f · z %.0f–%.0f (v2 ray x %.1f–%.0f · y 0–60 · z 485–575)\" % (min(v.xmin for v in ob), max(v.xmax for v in ob), min(v.ymin for v in ob), max(v.ymax for v in ob), min(v.zmin for v in ob), max(v.zmax for v in ob), RAY_X[0], RAY_X[1]),\n328\t            abs(min(v.xmin for v in ob) - RAY_X[0]) < 0.01 and abs(max(v.xmax for v in ob) - RAY_X[1]) < 0.01 and abs(min(v.ymin for v in ob)) < 0.01 and abs(max(v.ymax for v in ob) - 60) < 0.01\n329\t            and abs(min(v.zmin for v in ob) - 485) < 0.01 and abs(max(v.zmax for v in ob) - 575) < 0.01)\n330\t    xmin_hep = min(dunya(p).BoundingBox().xmin for p in ps)\n331\t    kontrol(\"SOL UÇ: bütün ray eki parçaları x ≥ %.1f (ray başı) · en sol parça x %.2f (oluk sol uç duvarı %.1f–%.1f, uç durdurucu rayın içinde) · rayın solunda parça YOK\"\n332\t            % (RAY_X[0], xmin_hep, OLUK[\"x\"][0], OLUK[\"x\"][0] + OT), xmin_hep >= RAY_X[0] - 1e-6)\n333\t    kontrol(\"oluk ↔ robot rayı (ROBOT_RAY z %.0f–%.0f) arası %.0f mm\" % (RAY_Z[0], RAY_Z[1], OLUK[\"z\"][0] - RAY_Z[1]), OLUK[\"z\"][0] - RAY_Z[1] >= 5.0)\n334\t    kb = [dunya(p).BoundingBox() for p in ps if p[\"birim\"] == \"ZEMIN_KANALI\"]\n335\t    kontrol(\"zemin kanalı x %.0f–%.0f · y %.0f–%.0f · z %.0f–%.0f · koridor kapağı z %.0f–%.0f (v1 ile aynı: x 4760–4840 · z 575–670 · y −60…0)\"\n336\t            % (min(v.xmin for v in kb), max(v.xmax for v in kb), min(v.ymin for v in kb), max(v.ymax for v in kb), min(v.zmin for v in kb), max(v.zmax for v in kb), KANAL[\"kapak_z\"][0], KANAL[\"kapak_z\"][1]),\n337\t            abs(min(v.xmin for v in kb) - 4760) < 0.01 and abs(max(v.xmax for v in kb) - 4840) < 0.01 and abs(min(v.ymin for v in kb) + 60) < 0.01 and max(v.ymax for v in kb) <= 0.01)\n338\t    # enerji zinciri\n339\t    R, hG = Z_H[\"R\"], Z_H[\"hG\"]\n340\t    xc = donus_x(RX_MONTAJ)\n341\t    print(\"ENERJİ ZİNCİRİ: L %.0f · R %.0f · sabit uç %.2f (ray ortası) · robot %.1f–%.0f (VARSAYIM araba ±%.0f) · montaj (robot %.0f): alt kol %.1f–%.2f · üst kol %.1f–%.0f · büküm dış x %.1f\"\n342\t          % (L_ZINCIR, R, XF, ROBOT_X[0], ROBOT_X[1], ARABA_YARI, RX_MONTAJ, xc, XF, xc, RX_MONTAJ, xc - R - hG / 2.0))\n343\t    for xm in (ROBOT_X[0], x_min_etkin(), X_ROB_AC, RX_MONTAJ, ROBOT_X[1]):\n344\t        c_ = donus_x(xm)\n345\t        print(\"   robot x %7.1f → büküm merkezi x %7.1f · alt kol %6.1f · üst kol %6.1f · büküm dış kenarı x %7.1f\" % (xm, c_, XF - c_, xm - c_, c_ - R - hG / 2.0))\n346\t    zy = zincir_yolu()\n347\t    kontrol(\"zincir ekseni boyu = L (%.1f = %.0f)\" % (uzunluk(zy), L_ZINCIR), abs(uzunluk(zy) - L_ZINCIR) < 2.0)\n348\t    kontrol(\"zincir sabit ucu XF %.2f = ray ortası (%.1f + %.0f) / 2 (SPEC kuralı, v1 2650 = (200 + 5100) / 2)\" % (XF, RAY_X[0], RAY_X[1]), abs(XF - (RAY_X[0] + RAY_X[1]) / 2.0) < 1e-9)\n349\t    kontrol(\"robot x %.0f (QR önü): alt kol %.1f ≥ güvenlik payı %.0f\" % (ROBOT_X[1], XF - donus_x(ROBOT_X[1]), Z_H[\"pay\"]), XF - donus_x(ROBOT_X[1]) >= Z_H[\"pay\"] - 0.01)\n350\t    xme = x_min_etkin()\n351\t    kontrol(\"robot açıcıya bırakma konumu x %.1f (h2_hesap X_ROB_AC) ≥ zincirle gidilebilen en sol x %.2f (büküm oluk sol ucuna 5 mm) → açıcıya ERİŞİR\" % (X_ROB_AC, xme), X_ROB_AC >= xme)\n352\t    zb_ = [dunya(p).BoundingBox() for p in ps if p[\"ad\"] == \"enerji_zinciri\"][0]\n353\t    kontrol(\"montaj pozunda zincir x %.2f–%.2f oluğun içinde (sol uç duvarı iç yüzü %.1f + 5 ≤ büküm dış kenarı)\" % (zb_.xmin, zb_.xmax, OLUK[\"x\"][0] + OT),\n354\t            zb_.xmin >= OLUK[\"x\"][0] + OT + 5.0 - 1e-6 and zb_.xmax <= OLUK[\"x\"][1] - OT)\n355\t    print(\"  UYARI (v1'de de vardı): zincirle robotun gidebildiği en sol x = %.2f · ray + araba %.1f'ye izin verir · ARADA %.1f mm KULLANILAMAZ (v1: 300 → 507,8 = 207,8 mm) — oluk sola uzamalı ya da sabit uç sola kaymalı\"\n356\t          % (xme, ROBOT_X[0], xme - ROBOT_X[0]))\n357\t    print(\"  UYARI (v1 ile aynı): U döngü yüksekliği 2R + hG = %.0f mm > oluk yüksekliği %.0f → zincirin üst kolu y %.0f–%.0f'da, oluğun DIŞINDA\"\n358\t          % (2 * R + hG, OLUK[\"y\"][1], Y_UST - hG / 2.0, Y_UST + hG / 2.0))\n359\t    print(\"  UYARI: üst kol desteksiz boyu en çok %.0f (robot %.0f'de; v1 2377) > kendini taşıma boyu %.0f (VARSAYIM) → kayma rafı gerekir (açık çekmecelere dikkat)\"\n360\t          % (ROBOT_X[1] - donus_x(ROBOT_X[1]), ROBOT_X[1], FLG))\n361\t    # kablo\n362\t    h = kablo_hesabi()\n363\t    print(\"ROBOT KABLOSU (modellenen yol boyunca, eksen):\")\n364\t    for a_, v in h[\"bol\"]:\n365\t        print(\"   %-44s %7.0f mm\" % (a_, v))\n366\t    print(\"   %-44s %7.0f mm\" % (\"GEREKLİ (kangal hariç)\", h[\"gerekli\"]))\n367\t    print(\"   standart parça %.1f (hedef %.0f) · uzatma %.1f (hedef %.0f) · toplam %.1f · konnektör oluk içinde x %.2f\" % (h[\"L_std\"], KABLO_STD, h[\"L_uz\"], KABLO_UZ, h[\"L_std\"] + h[\"L_uz\"], h[\"xj\"]))\n368\t    kontrol(\"standart kablo = %.1f (4 m) · uzatma = %.1f (11 m) · konnektör x %.1f–%.1f oluğun kapaklı bölümünde (XF + 2 = %.1f … kanal ağzı %.0f)\"\n369\t            % (h[\"L_std\"], h[\"L_uz\"], h[\"xj\"] - KONN_L / 2.0, h[\"xj\"] + KONN_L / 2.0, XF + 2.0, KABLO_X_KANAL - 15.0),\n370\t            abs(h[\"L_std\"] - KABLO_STD) < 1.0 and abs(h[\"L_uz\"] - KABLO_UZ) < 1.0 and XF + 2.0 <= h[\"xj\"] - KONN_L / 2.0 and h[\"xj\"] + 95.0 <= KABLO_X_KANAL - 15.0)\n371\t    kontrol(\"Fairino standart 4 m YETMEZ: gereken %.2f m > 4 m\" % (h[\"gerekli\"] / 1000.0), h[\"gerekli\"] > KABLO_STD)\n372\t    kontrol(\"4 m + 11 m uzatma = 15 m yeter: gereken %.2f m · artan %.2f m kangalda\" % (h[\"gerekli\"] / 1000.0, h[\"kangal\"] / 1000.0),\n373\t            h[\"gerekli\"] <= KABLO_TOPLAM and abs(h[\"L_std\"] + h[\"L_uz\"] - KABLO_TOPLAM) < 1.0)\n374\t    yk = KG[\"y0\"] + h[\"N\"] * KABLO_D\n375\t    kontrol(\"kangal %.2f sarım · Ø%.0f · yükseklik %.0f → y %.0f–%.1f QR bölgesinde (y ≤ %.0f · fan altı %.0f)\" % (h[\"N\"], 2 * KG_RM, h[\"N\"] * KABLO_D, KG[\"y0\"], yk,\n376\t            QR.KANGAL_BOLGE[\"y\"][1], QR.FAN[\"alt\"][2]), yk <= QR.KANGAL_BOLGE[\"y\"][1] and yk < QR.FAN[\"alt\"][2])\n377\t    kontrol(\"kangal x %.1f–%.1f · z %.0f–%.0f QR kangal bölgesinde (x 5080–5405)\" % (KG[\"xc\"] - KG[\"rd\"], KG[\"xc\"] + KG[\"rd\"], KG[\"zc\"] - KG[\"rd\"], KG[\"zc\"] + KG[\"rd\"]),\n378\t            KG[\"xc\"] - KG[\"rd\"] >= QR.X0 + QR.KANGAL_BOLGE[\"x\"][0] and KG[\"xc\"] + KG[\"rd\"] <= QR.X0 + QR.KANGAL_BOLGE[\"x\"][1])\n379\t    kontrol(\"büküm yarıçapları: zincir R %.0f = %.1f × d (dinamik ≥ 7,5 × d VARSAYIM) · kangal %.0f = %.1f × d (statik ≥ 5 × d)\" % (R, R / KABLO_D, KG_RM, KG_RM / KABLO_D),\n380\t            R >= 7.5 * KABLO_D and KG_RM >= 5.0 * KABLO_D)\n381\t    kontrol(\"kablo zincir iç kesitine sığar (Ø%.0f ≤ iç %.0f × %.0f, %%10 pay)\" % (KABLO_D, Z_H[\"hi\"], Z_H[\"bi\"]), KABLO_D * 1.1 <= Z_H[\"hi\"] and KABLO_D * 1.1 <= Z_H[\"bi\"])\n382\t    kontrol(\"hareketli uç braketi kaide yüzünün (z %.0f) önünde · robot kutusuna girmez\" % KAIDE_Z,\n383\t            min(dunya(p).BoundingBox().zmin for p in ps if p[\"ad\"] == \"zincir_hareketli_uc_braketi\") >= KAIDE_Z)\n384\t    t1 = time.time()\n385\t    cak = kendi_arasinda(ps, esik=0.1)\n386\t    print(\"KENDİ ARASINDA (> 0,1 mm³): %s · %.0f sn\" % (\"TEMİZ\" if not cak else cak[:20], time.time() - t1))\n387\t    kontrol(\"kendi arasında çakışma = 0 (%d parça · > 0,1 mm³ · istisna v1 ile aynı: kangal = uzatmanın kendisi)\" % len(ps), not cak, str(cak[:6]))\n388\t    # v1 karşılaştırması: hangi parça değişti (belge) · robot tarafı + sağ uç AYNI olmalı\n389\t    import ray_ek_cad_v1 as R1\n390\t    R1.kur()\n391\t    b1 = {p[\"ad\"]: R1.dunya(p).BoundingBox() for p in R1.PARCALAR}\n392\t    b2 = {p[\"ad\"]: dunya(p).BoundingBox() for p in ps}\n393\t    kontrol(\"parça adları / birimleri / malzemeleri v1 ile aynı (%d parça)\" % len(ps),\n394\t            [p[\"ad\"] for p in ps] == [p[\"ad\"] for p in R1.PARCALAR] and all(p[\"birim\"] == q[\"birim\"] and p[\"mal\"] == q[\"mal\"] for p, q in zip(ps, R1.PARCALAR)))\n395\t    degisen, ayni = [], []\n396\t    for p, q in zip(ps, R1.PARCALAR):\n397\t        A, B = b2[p[\"ad\"]], b1[q[\"ad\"]]\n398\t        d = max(abs(A.xmin - B.xmin), abs(A.xmax - B.xmax), abs(A.ymin - B.ymin), abs(A.ymax - B.ymax), abs(A.zmin - B.zmin), abs(A.zmax - B.zmax), abs(dunya(p).Volume() - R1.dunya(q).Volume()))\n399\t        (degisen if d > 1e-6 else ayni).append(p[\"ad\"])\n400\t        if d > 1e-6:\n401\t            print(\"   DEĞİŞTİ %-30s x %8.2f–%8.2f → %8.2f–%8.2f · y %6.1f–%6.1f → %6.1f–%6.1f · hacim %10.0f → %10.0f\"\n402\t                  % (p[\"ad\"], B.xmin, B.xmax, A.xmin, A.xmax, B.ymin, B.ymax, A.ymin, A.ymax, R1.dunya(q).Volume(), dunya(p).Volume()))\n403\t    sabit_bek = (\"oluk_uc_duvari_sag\", \"zincir_hareketli_uc_braketi\", \"kablo_kelepcesi_0\", \"kablo_kelepcesi_1\", \"kanal_tabani\", \"kanal_yan_sol\", \"kanal_yan_sag\",\n404\t                 \"kanal_uc_hat\", \"kanal_uc_qr\", \"kanal_ayirici\", \"kanal_kapagi_koridor\", \"kanal_kapagi_QR_alti\")\n405\t    kontrol(\"AYNI KALAN (robot tarafı + sağ uç + zemin kanalı): %d parça v1 ile birebir (%s)\" % (len(ayni), \", \".join(ayni)), all(a in ayni for a in sabit_bek), str([a for a in sabit_bek if a not in ayni]))\n406\t    kontrol(\"DEĞİŞEN %d parça yalnız sol uca / sabit uca bağlı olanlar (oluk 3 boy + sol uç duvarı + 3 kapak · zincir + sabit uç braketi · standart kablo · konnektör · uzatma A · \"\n407\t            \"kangal + kangal üstünden çıkan uzatma B: kangal %.2f sarım yükseldi)\" % (len(degisen), h[\"N\"]),\n408\t            set(degisen) == {\"oluk_tabani\", \"oluk_yan_robot\", \"oluk_yan_koridor\", \"oluk_uc_duvari_sol\", \"oluk_kapagi_0\", \"oluk_kapagi_1\", \"oluk_kapagi_2\", \"enerji_zinciri\",\n409\t                             \"zincir_sabit_uc_braketi\", \"robot_kablosu_standart_4m\", \"robot_kablosu_uzatma_A\", \"robot_kablosu_uzatma_B\", \"uzatma_konnektoru\", \"robot_kablosu_kangal\"}, str(degisen))\n410\t    print(\"   v1 → v2 sayılar: RAY_X %s → %s · XF %.2f → %.2f · L_ZINCIR %.0f → %.0f · ROBOT_X %s → %s · X_BAG %.2f → %.2f · konnektör xj %.2f → %.2f · kangal %.3f → %.3f sarım · en sol erişim %.2f → %.2f\"\n411\t          % (R1.RAY_X, RAY_X, R1.XF, XF, R1.L_ZINCIR, L_ZINCIR, R1.ROBOT_X, ROBOT_X, R1.X_BAG, X_BAG, R1.kablo_hesabi()[\"xj\"], h[\"xj\"], R1.kablo_hesabi()[\"N\"], h[\"N\"], R1.x_min_etkin(), xme))\n412\t    if \"hizli\" not in arg:\n413\t        QR.kur()\n414\t        qs = [dict(ad=q[\"ad\"], wp=q[\"wp\"], _sh=QR.dunya(q)) for q in QR.PARCALAR]\n415\t        cc = QR.capraz([p for p in ps], qs, esik=0.1)\n416\t        kontrol(\"ray ekleri ↔ QR dolabı (qr_cad_v1, %d parça) çakışma = 0 (> 0,1 mm³)\" % len(qs), not cc, str(cc[:6]))\n417\t    kal = [d_ for d_ in DEN if not d_[1]]\n418\t    print(\"DENETIM: %d madde · %d KALDI · toplam %.0f sn\" % (len(DEN), len(kal), time.time() - t0))\n419\t    assert not kal\n420\t    sys.stdout.flush(); os._exit(0)\n421\t"}]},"uuid":"75e9ba05-8c44-434a-aaf7-6a5ecebac9a3","timestamp":"2026-10-01T12:50:31.517Z","sourceToolAssistantUUID":"421a9d8b-14cc-41a3-b632-c234c13199df","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
