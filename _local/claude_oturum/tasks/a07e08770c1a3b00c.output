{"parentUuid":"432d9bea-c2c1-4032-8b85-6f4b03ed749e","isSidechain":true,"promptId":"50d61844-03e1-47e6-9599-4d79a818d07e","agentId":"a07e08770c1a3b00c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J5URg9gzChVkT1j51Z9YiL","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"HAT v3.2 · ELEKTRİK · QR BÖLÜMÜ v1 — ana pano (40 yükseltilmiş, alttan rakorlu) · pano altı kablo tavası · orta dikey kanal · kilit kartı kanalı ·\n3\talt bölme kanalı + yeni güç taban rakoru (robot kablosunun arkasında) · göz cihaz uç kabloları (orta kanala) · göz cihaz braketleri (havada düzeltmesi).\n4\tBütün kablolar KANALDA; kanal dışındaki uçlar ≤ ~250 mm, cihaz / rakor arası. h3_elektrik_v1.kur() bunu çağırır (ekle / DELIKLER / DUSUR oradan).\"\"\"\n5\timport math\n6\timport cadquery as cq\n7\timport h3_elk_ortak as EO\n8\tfrom h3_elk_ortak import kut, sil, boru, kanal, rakor\n9\t\n10\tV = cq.Vector\n11\tAP = dict(x=(4595.0, 4995.0), y=(1696.0, 2046.0), z=(675.0, 925.0), t=1.2)   # v3.2 · 38 yükseltildi (altında 43 mm kablo boşluğu)\n12\tPL_Z = (895.0, 898.0)\n13\tRAY_Z = (887.5, 895.0)\n14\tRAY_A_Y, RAY_B_Y = 1993.0, 1828.0\n15\tQK = dict(x=(4983.0, 5007.0), z=(930.0, 1080.0))       # orta dikey kanal (göz sütunları arası 4980–5010)\n16\tTAVA = dict(x=(4790.0, 5003.0), y=(1655.0, 1690.0), z=(760.0, 1080.0))   # pano altı kablo tavası (üst rafta)\n17\tUKN = dict(x=(5003.0, 5390.0), y=(1656.0, 1686.0), z=(995.0, 1035.0))    # kilit kartı kanalı\n18\tALT = dict(x=(4983.0, 5007.0), z=(1000.0, 1080.0))     # alt bölme dikey kanal (kontrol kutusunun arkasında, z > 943)\n19\tTABAN_KN = dict(x=(4805.0, 5007.0), y=(21.0, 51.0), z=(1012.0, 1048.0))  # alt bölme taban kanalı → yeni güç rakoru\n20\tGUC_RAKOR = (4820.0, 1030.0)                           # yeni taban rakoru (robot kablosu z 965–985'in arkasında) · zemin kanalı güç bölmesi 60 uzar\n21\tKABLOLAR = [(\"bina_besleme_5G6\", 9.5, \"kablo\"), (\"guc_TOPPING_3G2_5\", 5.5, \"kablo\"), (\"guc_DOLAP_3G2_5\", 5.5, \"kablo\"), (\"guc_K_3G2_5\", 5.5, \"kablo\"),\n22\t            (\"guc_E_3G2_5\", 5.5, \"kablo\"), (\"veri_TOPPING_Cat6A\", 3.75, \"kablo_veri\"), (\"veri_DOLAP_Cat6A\", 3.75, \"kablo_veri\"), (\"veri_K_Cat6A\", 3.75, \"kablo_veri\"),\n23\t            (\"veri_E_Cat6A\", 3.75, \"kablo_veri\"), (\"guc_ROBOT_3G2_5\", 5.5, \"kablo\"), (\"veri_ROBOT_Cat6A\", 3.75, \"kablo_veri\"), (\"guc_QR_24V\", 4.0, \"kablo\"),\n24\t            (\"veri_QR_Cat6A\", 3.75, \"kablo_veri\"), (\"veri_MODEM_Cat6A\", 3.75, \"kablo_veri\"), (\"ups_giris_3G1_5\", 4.5, \"kablo\"), (\"ups_cikis_3G1_5\", 4.5, \"kablo\")]\n25\t\n26\t\n27\tdef kur(ekle, DELIKLER, DUSUR, QR):\n28\t    \"\"\"QR: qr_cad_v1 modülü (kur() yapılmış, parçalar dünya) · ekle(ad, sh, mal, birim, bom)\"\"\"\n29\t    P = {p[\"ad\"]: QR.dunya(p) if hasattr(QR, \"dunya\") else p[\"wp\"].val() for p in QR.PARCALAR}\n30\t    B1, B2, B3 = \"ELK_ANA_PANO\", \"ELK_QR_KABLO\", \"ELK_QR_MONTAJ\"\n31\t    x0, x1 = AP[\"x\"]; y0, y1 = AP[\"y\"]; z0, z1 = AP[\"z\"]; t = AP[\"t\"]\n32\t    # ---------------- 1 · ANA PANO (yükseltilmiş) ----------------\n33\t    DUSUR += [(\"QR\", \"ana_pano_400x350x250\"), (\"QR\", \"ana_pano_ayak_rayi_0\"), (\"QR\", \"ana_pano_ayak_rayi_1\")]\n34\t    for i, (ax0, ax1) in enumerate(((4610.0, 4640.0), (4700.0, 4730.0))):\n35\t        ekle(\"pano_ayagi_%d\" % i, kut(ax0, ax1, 1653.0, y0, 700.0, 900.0).cut(kut(ax0 + 2, ax1 - 2, 1652.0, y0 + 1.0, 702.0, 898.0)), \"celik\", B1,\n36\t             bom=(\"Pano ayağı 304 kutu profil 30 × 43 × 2 (pano 38 yükseldi: altında kablo tavası)\", 2, \"üst rafa + panoya M6\", \"v3.2\") if i == 0 else None)\n37\t    RK = []\n38\t    for r_, (rx, rz) in enumerate([(4800.0 + 26.0 * i, zz) for zz in (805.0, 845.0, 885.0) for i in range(6)][:len(KABLOLAR)]):\n39\t        RK.append((rx, rz))\n40\t    govde = kut(x0, x1, y0, y1, z0 + 2.0, z1).cut(kut(x0 + t, x1 - t, y0 + t, y1 - t, z0 + 1.0, z1 - t))\n41\t    for i, ((rx, rz), (ad, r, m)) in enumerate(zip(RK, KABLOLAR)):\n42\t        rk, d_ = rakor((rx, y0, rz), \"y\", r, t, yon=\"-\", disli=8.0 if r < 6.0 else 11.0)\n43\t        govde = govde.cut(d_)\n44\t        ekle(\"pano_rakoru_%02d\" % i, rk, \"rakor\", B1, bom=(\"Kablo rakoru PA IP68 M16 / M20 / M25 + somun (Lapp SKINTOP ST-M)\", len(RK), \"\", \"alt plaka\") if i == 0 else None)\n45\t    ekle(\"pano_ana_govde_400x350x250\", govde, \"pano\", B1,\n46\t         bom=(\"Duvar tipi pano 400 × 350 × 250 RAL 7035 IP66\", 1, \"Rittal AX sınıfı · ölçü proje sabiti (qr_cad_v1)\", \"QR üst bölmesi robot tarafı · v3.2: 38 yükseltildi · alt plakada %d rakor\" % len(RK)))\n47\t    ekle(\"onyuz_ana_pano_kapagi\", kut(x0, x1, y0, y1, z0, z0 + 2.0), \"on_seffaf\", B1, bom=(\"Pano kapağı (kilitli)\", 1, \"gövdeyle\", \"\"))\n48\t    ekle(\"pano_montaj_plakasi\", kut(x0 + 10.0, x1 - 10.0, y0 + 10.0, y1 - 10.0, PL_Z[0], PL_Z[1]), \"din\", B1, bom=(\"Montaj plakası galvaniz 2 mm\", 1, \"\", \"\"))\n49\t    for i_, (px, py) in enumerate(((x0 + 20, y0 + 20), (x1 - 20, y0 + 20), (x0 + 20, y1 - 20), (x1 - 20, y1 - 20))):\n50\t        ekle(\"pano_plaka_burcu_%d\" % i_, sil((px, py, PL_Z[1]), (px, py, z1 - t), 6.0), \"celik\", B1)\n51\t    for nm, yc in ((\"A\", RAY_A_Y), (\"B\", RAY_B_Y)):\n52\t        ekle(\"din_rayi_%s\" % nm, kut(x0 + 12.0, x1 - 12.0, yc - 17.5, yc + 17.5, RAY_Z[0], RAY_Z[1]), \"din\", B1, bom=(\"DIN rayı TS35 × 7,5\", 2, \"\", \"\") if nm == \"A\" else None)\n53\t\n54\t    def din(ad, xa, w, h, d, yc, mal=\"cihaz\", bom=None):\n55\t        ekle(ad, kut(xa, xa + w, yc - h / 2.0, yc + h / 2.0, RAY_Z[0] - d, RAY_Z[0]), mal, B1, bom)\n56\t    xa = x0 + 17.0\n57\t    din(\"ana_salter_iSW_4P_40A\", xa, 72.0, 90.0, 70.0, RAY_A_Y, bom=(\"Ana şalter Schneider Acti9 iSW 4P 40 A\", 1, \"katalog [ölçü VARSAYIM]\", \"bina beslemesi 400 V 3F\"))\n58\t    din(\"kacak_akim_iID_4P_40A_30mA\", xa + 72.0, 72.0, 90.0, 75.0, RAY_A_Y, bom=(\"Kaçak akım Schneider Acti9 iID 4P 40 A 30 mA tip A\", 1, \"katalog\", \"\"))\n59\t    SG = [\"TOPPING\", \"DOLAP\", \"K\", \"E\", \"ROBOT\", \"QR\"]\n60\t    for i, s in enumerate(SG):\n61\t        din(\"sigorta_iC60N_1PN_C16_%s\" % s, xa + 144.0 + 36.0 * i, 36.0, 90.0, 75.0, RAY_A_Y,\n62\t            bom=(\"Sigorta Schneider Acti9 iC60N 1P+N C16\", len(SG), \"katalog\", \"istasyon başına 1 · fazlara dengeli dağıtım\") if i == 0 else None)\n63\t    din(\"guc_24V_NDR-120-24\", xa, 40.0, 125.2, 113.5, RAY_B_Y, bom=(\"Mean Well NDR-120-24\", 1, \"föy 40 × 125,2 × 113,5\", \"ana bilgisayar + switch + modem (UPS çıkışından)\"))\n64\t    din(\"hmi_ana_bilgisayar_RevPi_Connect_4\", xa + 46.0, 45.0, 96.0, 110.5, RAY_B_Y, \"cihaz_koyu\",\n65\t        bom=(\"ANA BİLGİSAYAR Kunbus Revolution Pi Connect 4 (Raspberry Pi CM4 tabanlı endüstriyel, EKRANSIZ, DIN, 24 V, 2 × Ethernet, RTC, WDT)\", 1, \"katalog [ölçü VARSAYIM]\",\n66\t             \"sipariş sırası + istasyon koordinasyonu + web paneli (iPad / telefon: modemin Wi-Fi'ı ya da uzaktan VPN) · PLC'lerle Ethernet (S7 / Modbus TCP)\"))\n67\t    din(\"ag_anahtari_FL_SWITCH_1008N\", xa + 97.0, 35.0, 99.0, 105.0, RAY_B_Y, \"cihaz_koyu\",\n68\t        bom=(\"Endüstriyel switch Phoenix Contact FL SWITCH 1008N (8 × RJ45)\", 1, \"katalog [ölçü VARSAYIM]\", \"ana bilgisayar · 4 istasyon PLC · robot · QR kartı · modem\"))\n69\t    for i in range(16):\n70\t        din(\"klemens_PT2_5_%02d\" % i, xa + 140.0 + 5.2 * i, 5.2, 60.0, 45.0, RAY_B_Y, bom=(\"Klemens Phoenix PT 2,5 (+ PE)\", 16, \"\", \"\") if i == 0 else None)\n71\t    for nm, (a, b, c0, c1) in ((\"yatay_orta\", (x0 + 12.0, x1 - 52.0, 1900.0, 1940.0)), (\"yatay_alt\", (x0 + 12.0, x1 - 12.0, 1706.0, 1746.0))):\n72\t        g, k = kanal(\"x\", a, b, c0, c1, PL_Z[0] - 40.0, PL_Z[0], acik=\"-\")\n73\t        ekle(\"pano_kablo_kanali_%s\" % nm, g, \"kanal\", B1, bom=(\"Pano kablo kanalı PVC 40 × 40 + kapak\", 3, \"\", \"\") if nm == \"yatay_orta\" else None)\n74\t        ekle(\"pano_kablo_kanali_%s_kapak\" % nm, k, \"kanal\", B1)\n75\t    g, k = kanal(\"y\", 1746.0, 1940.0, x1 - 52.0, x1 - 12.0, PL_Z[0] - 40.0, PL_Z[0], acik=\"-\")\n76\t    ekle(\"pano_kablo_kanali_dikey\", g, \"kanal\", B1); ekle(\"pano_kablo_kanali_dikey_kapak\", k, \"kanal\", B1)\n77\t    # ---------------- 2 · PANO ALTI TAVA · ORTA DİKEY KANAL · KART KANALI · ALT BÖLME ----------------\n78\t    tx0, tx1 = TAVA[\"x\"]; ty0, ty1 = TAVA[\"y\"]; tz0, tz1 = TAVA[\"z\"]\n79\t    g, k = kanal(\"x\", tx0, tx1, tz0, tz1, ty0, ty1, acik=\"+\")        # kesit z × y · kapak üstte (y +)\n80\t    # kanal() x ekseninde (c = y, d = z) bekler → burada tava yatay: c = z değil; elle kur\n81\t    g = kut(tx0, tx1, ty0, ty1, tz0, tz1).cut(kut(tx0 + 1.5, tx1 - 1.5, ty0 + 1.5, ty1 + 1.0, tz0 + 1.5, tz1 - 1.5))\n82\t    kap = kut(tx0, tx1, ty1, ty1 + 1.5, tz0, tz1)\n83\t    for (rx, rz) in RK:                                                # kapakta kablo girişleri (rakorların altında)\n84\t        kap = kap.cut(sil((rx, ty1 - 1.0, rz), (rx, ty1 + 3.0, rz), 9.5))\n85\t    kap = kap.cut(kut(QK[\"x\"][0], min(tx1, QK[\"x\"][1]), ty1 - 1.0, ty1 + 3.0, QK[\"z\"][0], min(tz1, QK[\"z\"][1])))\n86\t    ekle(\"qr_pano_alti_kablo_tavasi\", g, \"kanal\", B2, bom=(\"Pano altı kablo tavası 304 1,5 (213 × 35 × 320) + delikli kapak\", 1, \"lazer + abkant\", \"üst rafa 4 × perçin · kablolar rakorlara dik girer\"))\n87\t    ekle(\"qr_pano_alti_kablo_tavasi_kapak\", kap, \"kanal\", B2)\n88\t    DELIKLER.append((\"QR\", \"ust_raf_3\", kut(QK[\"x\"][0], QK[\"x\"][1], 1649.0, 1654.0, QK[\"z\"][0], QK[\"z\"][1]), \"orta kanal → tava\"))\n89\t    DELIKLER.append((\"QR\", \"alt_raf_3\", kut(QK[\"x\"][0], QK[\"x\"][1], 446.0, 451.0, ALT[\"z\"][0], QK[\"z\"][1]), \"orta kanal → alt bölme\"))\n90\t    g, k = kanal(\"y\", 450.0, 1650.0, QK[\"x\"][0], QK[\"x\"][1], QK[\"z\"][0], QK[\"z\"][1], acik=\"+\")\n91\t    ekle(\"qr_orta_dikey_kanal\", g, \"kanal\", B2, bom=(\"Yassı kablo kanalı PVC 24 × 150 + kapak (göz sütunları arasında)\", 1, \"\", \"göz kasası yan saclarına perçin\"))\n92\t    ekle(\"qr_orta_dikey_kanal_kapak\", k, \"kanal\", B2)\n93\t    g, k = kanal(\"y\", 21.0, 447.0, ALT[\"x\"][0], ALT[\"x\"][1], ALT[\"z\"][0], ALT[\"z\"][1], acik=\"+\")\n94\t    ekle(\"qr_alt_dikey_kanal\", g, \"kanal\", B2); ekle(\"qr_alt_dikey_kanal_kapak\", k, \"kanal\", B2)\n95\t    g, k = kanal(\"x\", TABAN_KN[\"x\"][0], TABAN_KN[\"x\"][1] - 24.0, TABAN_KN[\"z\"][0], TABAN_KN[\"z\"][1], TABAN_KN[\"y\"][0], TABAN_KN[\"y\"][1], acik=\"+\")\n96\t    g = kut(TABAN_KN[\"x\"][0], ALT[\"x\"][0], 21.0, 51.0, TABAN_KN[\"z\"][0], TABAN_KN[\"z\"][1]).cut(kut(TABAN_KN[\"x\"][0] + 1.5, ALT[\"x\"][0] + 1.0, 22.5, 52.0, TABAN_KN[\"z\"][0] + 1.5, TABAN_KN[\"z\"][1] - 1.5))\n97\t    g = g.cut(sil((GUC_RAKOR[0], 20.0, GUC_RAKOR[1]), (GUC_RAKOR[0], 26.0, GUC_RAKOR[1]), 19.5))\n98\t    ekle(\"qr_alt_taban_kanali\", g, \"kanal\", B2, bom=(\"Taban kablo kanalı 304 1,5 (36 × 30) + kapak\", 1, \"\", \"QR taban plakasına perçin · yeni güç rakoruna iner\"))\n99\t    ekle(\"qr_alt_taban_kanali_kapak\", kut(TABAN_KN[\"x\"][0], ALT[\"x\"][0], 51.0, 52.5, TABAN_KN[\"z\"][0], TABAN_KN[\"z\"][1]), \"kanal\", B2)\n100\t    rk, d_ = rakor((GUC_RAKOR[0], 17.0, GUC_RAKOR[1]), \"y\", 12.0, 3.0, yon=\"-\", disli=16.0)          # taban plakası 17–20 · gövde altta\n101\t    ekle(\"qr_guc_taban_rakoru_M40\", rk, \"rakor\", B2, bom=(\"Taban rakoru M40 çok delikli conta (10 kablo) · QR taban plakası\", 1, \"Lapp SKINTOP MS-M-XL\", \"v3.2 · robot kablosunun (z 965–985) arkasında; eski GECIS_GUC (4820, 975) tapalı\"))\n102\t    DELIKLER.append((\"QR\", \"taban_plakasi_3\", d_, \"güç taban rakoru M40\"))\n103\t    ukx0, ukx1 = UKN[\"x\"]\n104\t    g = kut(ukx0, ukx1, UKN[\"y\"][0], UKN[\"y\"][1], UKN[\"z\"][0], UKN[\"z\"][1]).cut(kut(ukx0 - 1.0, ukx1 - 1.5, UKN[\"y\"][0] + 1.5, UKN[\"y\"][1] + 1.0, UKN[\"z\"][0] + 1.5, UKN[\"z\"][1] - 1.5))\n105\t    ekle(\"qr_kart_kanali\", g, \"kanal\", B2, bom=(\"Kart kanalı PVC 40 × 30 + kapak (tava → kilit kartı)\", 1, \"\", \"üst rafa yapışkan tabanlı klips\"))\n106\t    ekle(\"qr_kart_kanali_kapak\", kut(ukx0, ukx1, UKN[\"y\"][1], UKN[\"y\"][1] + 1.5, UKN[\"z\"][0], UKN[\"z\"][1]), \"kanal\", B2)\n107\t    # ---------------- 3 · KANAL DIŞI UÇLAR (kısa · rakora / cihaza dik) ----------------\n108\t    for i, ((rx, rz), (ad, r, m)) in enumerate(zip(RK, KABLOLAR)):\n109\t        ekle(\"qrk_%s_rakor_ucu\" % ad, sil((rx, ty1 + 1.5, rz), (rx, y0 + 6.0, rz), r), m, B2)       # tava kapağı → pano rakoru (dik, ≤ 10)\n110\t    # kilit kartı uçları (kart kanalından PCB alt kenarındaki klemenslere) · modem\n111\t    for i, xk in enumerate((5160.0, 5200.0, 5240.0, 5280.0)):\n112\t        ekle(\"qrk_kart_ucu_%d\" % i, boru([(xk, UKN[\"y\"][1], 1015.0), (xk, 1676.0, 1015.0), (xk, 1676.0, 1060.0)], 3.0), \"kablo\", B2)\n113\t    ekle(\"qrk_modem_ucu\", boru([(5320.0, UKN[\"y\"][1], 1015.0), (5320.0, 1900.0, 1015.0), (5320.0, 1900.0, 1060.0)], 3.75), \"kablo_veri\", B2)\n114\t    ekle(\"qrk_modem_ucu_kelepce\", EO.kelepce((5320.0, 1800.0, 1015.0), \"y\", 3.75, 1060.0, \"+z\"), \"celik\", B2)\n115\t    # UPS: tavadan UPS'in sol alt yüzüne\n116\t    for i, zz in enumerate((820.0, 850.0)):\n117\t        ekle(\"qrk_ups_ucu_%d\" % i, boru([(4995.0, ty1 + 1.5, zz), (4995.0, 1700.0, zz), (5005.0, 1700.0, zz)], 4.5), \"kablo\", B2)\n118\t    # robot kontrol kutusu: alt dikey kanaldan kutunun arka yüzüne\n119\t    for i, (ad, yy) in enumerate(((\"guc_ROBOT\", 300.0), (\"veri_ROBOT\", 260.0))):\n120\t        ekle(\"qrk_%s_kutu_ucu\" % ad, boru([(4995.0, yy, ALT[\"z\"][0]), (4995.0, yy, 943.0)], 5.5 if ad.startswith(\"guc\") else 3.75), \"kablo\" if ad.startswith(\"guc\") else \"kablo_veri\", B2)\n121\t    # ---------------- 4 · GÖZ CİHAZLARI: uç kabloları + braketler ----------------\n122\t    import re\n123\t    gozler = sorted(set(re.match(r\"goz_(\\d\\d)_\", a).group(1) for a in P if re.match(r\"goz_\\d\\d_kapak_motoru$\", a)))\n124\t    kx = (QK[\"x\"][0] + QK[\"x\"][1]) / 2.0\n125\t    for g_ in gozler:\n126\t        sat, sut = int(g_[0]), int(g_[1])\n127\t        mb = P[\"goz_%s_kapak_motoru\" % g_].BoundingBox(); sb = P[\"goz_%s_kapak_sensoru\" % g_].BoundingBox()\n128\t        db = P[\"goz_%s_elektrikli_mandal\" % g_].BoundingBox(); ib = P[\"goz_%s_isitici_ped\" % g_].BoundingBox()\n129\t        kb = P[\"goz_%s_kasasi\" % g_].BoundingBox()\n130\t        kx = (QK[\"x\"][0] + QK[\"x\"][1]) / 2.0                          # 4995 · dikme aralığı 4990–5000 (robot 712–732 · müşteri 1128–1148)\n131\t        kz0, kz1 = QK[\"z\"][0] + 1.0, QK[\"z\"][1] - 1.0\n132\t        my = (mb.ymin + mb.ymax) / 2.0; sy = (sb.ymin + sb.ymax) / 2.0\n133\t        if sut == 0:\n134\t            # motor (sol üst köşe) → sıra aralığı (y kasa üstü + 2,5) → orta → kanal · x yolunda yüz sacına P-kelepçe\n135\t            yg = kb.ymax + (3.2 if sat == 5 else 2.5); mx = (mb.xmin + mb.xmax) / 2.0\n136\t            pts = [(mx, mb.ymax, 691.0), (mx, yg, 691.0), (kx, yg, 691.0), (kx, yg, kz0)]\n137\t            ekle(\"goz_%s_motor_kablosu\" % g_, boru(pts, 2.0), \"kablo\", B2)\n138\t            for j, xk in enumerate((mx + 80.0, (mx + kx) / 2.0, kx - 60.0)):\n139\t                ekle(\"goz_%s_motor_kablosu_kelepce_%d\" % (g_, j), EO.kelepce((xk, yg, 691.0), \"x\", 2.0, *((1650.0, \"+y\") if sat == 5 else (672.0, \"-z\"))), \"celik\", B2)\n140\t            # sensör (sağ alt) → +x 3 → kanal (kendi yüksekliğinde dikme aralığından)\n141\t            ekle(\"goz_%s_sensor_kablosu\" % g_, boru([(sb.xmax, sy, 681.0), (kx, sy, 681.0), (kx, sy, kz0)], 1.75), \"kablo\", B2)\n142\t        else:\n143\t            # motor (sol üst köşe, 5012) → −x → kanal\n144\t            ekle(\"goz_%s_motor_kablosu\" % g_, boru([(mb.xmin, my, 691.0), (kx, my, 691.0), (kx, my, kz0)], 2.0), \"kablo\", B2)\n145\t            # sensör (sağ alt, 5388–5402) → yukarı (x 5397) → sıra aralığı (kasa üstü + 8) → −x → kanal · yüz sacına P-kelepçe\n146\t            yg = kb.ymax + (6.0 if sat == 5 else 8.0); sx = 5397.0\n147\t            pts = [(sx, sb.ymax, 681.0), (sx, yg, 681.0), (kx, yg, 681.0), (kx, yg, kz0)]\n148\t            ekle(\"goz_%s_sensor_kablosu\" % g_, boru(pts, 1.75), \"kablo\", B2)\n149\t            for j, (p_, ax) in enumerate((((sx, (sb.ymax + yg) / 2.0, 681.0), \"y\"), ((sx - 100.0, yg, 681.0), \"x\"), (((sx + kx) / 2.0, yg, 681.0), \"x\"), ((kx + 60.0, yg, 681.0), \"x\"))):\n150\t                ekle(\"goz_%s_sensor_kablosu_kelepce_%d\" % (g_, j), EO.kelepce(p_, ax, 1.75, *((1650.0, \"+y\") if (sat == 5 and ax == \"x\") else (672.0, \"-z\"))), \"celik\", B2)\n151\t        # mandal (müşteri tarafı, orta) → arkasından müşteri dikme aralığından kanala\n152\t        dy = (db.ymin + db.ymax) / 2.0\n153\t        ekle(\"goz_%s_mandal_kablosu\" % g_, boru([(kx, dy, db.zmin), (kx, dy, kz1)], 1.75), \"kablo\", B2)\n154\t        # ısıtıcı ped: kasa yan sacındaki lastik bilezikten (ped köşesi) orta boşluktaki kanala\n155\t        xw = kb.xmax if sut == 0 else kb.xmin\n156\t        xk2 = QK[\"x\"][0] + 0.5 if sut == 0 else QK[\"x\"][1] - 0.5\n157\t        ekle(\"goz_%s_isitici_kablosu\" % g_, boru([(xw + (0.5 if sut == 0 else -0.5), kb.ymin + 2.5, 1000.0), (xk2, kb.ymin + 2.5, 1000.0)], 1.25), \"kablo\", B2)\n158\t        # ---- braketler (havada düzeltmesi): motor · sensör · mandal · mil yatağı · kapak kulakları · menteşe ara plakaları\n159\t        yz = P[\"robot_yuzu_goz_saci\"]\n160\t        bx0, bx1 = (kb.xmin, mb.xmax) if sut == 0 else (kb.xmin, mb.xmax)\n161\t        ekle(\"goz_%s_motor_braketi\" % g_, kut(bx0, bx1, mb.ymin, kb.ymax, mb.zmax, kb.zmin).fuse(kut(bx0, bx0 + 1.5, mb.ymin, kb.ymax, mb.zmin, mb.zmax)), \"celik\", B3,\n162\t             bom=(\"Kapak motoru braketi 304 2 mm (kasaya 2 × M4)\", 12, \"lazer + abkant\", \"v3.2 havada düzeltmesi\") if g_ == gozler[0] else None)\n163\t        ekle(\"goz_%s_sensor_braketi\" % g_, kut(sb.xmin, sb.xmax, sb.ymin, sb.ymax, yz.BoundingBox().zmax, sb.zmin), \"celik\", B3,\n164\t             bom=(\"Sensör braketi 304 (yüz sacına perçin)\", 12, \"\", \"\") if g_ == gozler[0] else None)\n165\t        dik = P[\"goz_dikmesi_11\"] if sut == 0 else P[\"goz_dikmesi_21\"]\n166\t        ekle(\"goz_%s_mandal_braketi\" % g_, kut(db.xmin, db.xmax, db.ymin, db.ymax, dik.BoundingBox().zmax, db.zmin), \"celik\", B3,\n167\t             bom=(\"Mandal braketi 304 2 mm (dikmeye 2 × M4)\", 12, \"\", \"\") if g_ == gozler[0] else None)\n168\t        yb = P[\"goz_%s_mil_yatagi\" % g_].BoundingBox()\n169\t        ekle(\"goz_%s_mil_yatagi_braketi\" % g_, kut(yb.xmin, yb.xmax, yb.ymin, yb.ymax, yz.BoundingBox().zmax, yb.zmin), \"celik\", B3,\n170\t             bom=(\"Mil yatağı braketi 304 (yüz sacına)\", 12, \"\", \"\") if g_ == gozler[0] else None)\n171\t        mil = P[\"goz_%s_kapak_mili\" % g_].BoundingBox(); kp = P[\"goz_%s_robot_kapagi\" % g_].BoundingBox()\n172\t        myc, mzc = (mil.ymin + mil.ymax) / 2.0, (mil.zmin + mil.zmax) / 2.0; mr = (mil.ymax - mil.ymin) / 2.0\n173\t        for j, xk in enumerate((kp.xmin + 8.0, kp.xmax - 28.0)):\n174\t            ekle(\"goz_%s_kapak_kulagi_%d\" % (g_, j), sil((xk, myc, mzc), (xk + 20.0, myc, mzc), myc - kp.ymax).cut(sil((xk - 1, myc, mzc), (xk + 21.0, myc, mzc), mr)), \"celik\", B3,\n175\t                 bom=(\"Kapak kulağı (menteşe burcu) 304 · kapağa kaynaklı, mile geçer\", 24, \"\", \"\") if (g_ == gozler[0] and j == 0) else None)\n176\t        for j in (0, 1):\n177\t            h = P[\"goz_%s_mentese_%d\" % (g_, j)].BoundingBox()\n178\t            ekle(\"goz_%s_mentese_%d_ara_plakasi\" % (g_, j), kut(h.xmin, h.xmax, h.ymin, h.ymax, kb.zmax, h.zmin), \"celik\", B3,\n179\t                 bom=(\"Menteşe ara plakası 304 10 mm (kasaya 2 × M4)\", 24, \"\", \"\") if (g_ == gozler[0] and j == 0) else None)\n180\t    return dict(RK=RK, gozler=gozler)\n181\t"}]},"uuid":"cc560129-aa82-4ed4-b9ef-4ee85dda8fc7","timestamp":"2026-10-01T12:50:32.313Z","sourceToolAssistantUUID":"432d9bea-c2c1-4032-8b85-6f4b03ed749e","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
