{"parentUuid":"4256b1d8-3ba4-47bd-a971-8c98a85ac50b","isSidechain":true,"promptId":"50d61844-03e1-47e6-9599-4d79a818d07e","agentId":"a07e08770c1a3b00c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012tcyofrhYcvvMpHwrJaDWA","type":"tool_result","content":"290\t\n291\t# ---------------------------------------------------------------- 4 · ROBOT KABLOSU ----------------------------------------------------------------\n292\tdef kablo():\n293\t    b = \"ROBOT_KABLOSU\"\n294\t    h = kablo_hesabi()\n295\t    r = KABLO_D / 2.0\n296\t    ekle(\"robot_kablosu_standart_4m\", boru(h[\"std\"], r), \"kablo\", b,\n297\t         bom=(\"Fairino robot kablosu (standart, robotla gelir)\", 1, \"4 m · güç + haberleşme tek kablo · Ø26 dairesel konnektör\", \"inluxrobotics.eu FR5 · çap VARSAYIM Ø20\", \"SATIN ALMA\"))\n298\t    ekle(\"robot_kablosu_uzatma_A\", boru(h[\"A\"], r), \"kablo\", b,\n299\t         bom=(\"Fairino uzatma kablosu 11 m\", 1, \"standart kabloyla toplam 15 m\", \"inluxrobotics.eu (Fairino Extension Cable 11 m)\", \"SATIN ALMA\"))\n300\t    ekle(\"robot_kablosu_uzatma_B\", boru(h[\"B\"], r), \"kablo\", b)\n301\t    xj = h[\"xj\"]\n302\t    ekle(\"uzatma_konnektoru\", silx(Y_KONN, ZC, KONN_R, xj - KONN_L / 2.0, xj + KONN_L / 2.0), \"konnektor\", b,\n303\t         bom=(\"Kablo birleşimi (Ø26 dairesel konnektör çifti) · oluk içinde\", 1, \"zarf Ø34 × 110\", \"VARSAYIM zarf\", \"ALT\"))\n304\t    yk = KG[\"y0\"] + h[\"N\"] * KABLO_D\n305\t    ekle(\"robot_kablosu_kangal\", sily(KG[\"xc\"], KG[\"zc\"], KG[\"rd\"], KG[\"y0\"], yk).cut(sily(KG[\"xc\"], KG[\"zc\"], KG[\"ri\"], KG[\"y0\"] - 1.0, yk + 1.0)), \"kablo\", b,\n306\t         bom=(\"Kablo kangalı (uzatmanın artanı) · QR alt bölmesi · 4 cırt bant\", 1, \"%.2f sarım × Ø%.0f · %.2f m · yük. %.0f\" % (h[\"N\"], 2 * KG_RM, h[\"kangal\"] / 1000.0, h[\"N\"] * KABLO_D), \"hesap (bu dosya)\", \"ALT\"))\n307\t    for i, yy in enumerate((520.0, 720.0)):                  # v2: robot kaidesine bağlı → RX_MONTAJ (v1 \"XF + …\", XF = RX_MONTAJ idi · yer aynı)\n308\t        ekle(\"kablo_kelepcesi_%d\" % i, kut(RX_MONTAJ + 45.0, RX_MONTAJ + 75.0, yy, yy + 20.0, KAIDE_Z + 0.5, 485.0).cut(sily(X_ROB_KABLO, 470.0, r + 0.5, yy - 1.0, yy + 21.0)), \"plastik\", b,\n309\t             bom=(\"Kablo kelepçesi (robot kaidesine)\", 2, \"Ø21\", \"katalog\", \"SATIN ALMA\") if i == 0 else None)\n310\t    return h\n311\t\n312\t\n313\tdef kur():\n314\t    \"\"\"İDEMPOTENT: her çağrıda baştan kurar · PARCALAR nesnesi aynı kalır\"\"\"\n315\t    PARCALAR[:] = []\n316\t    oluk(); zincir(); kopru(); kablo()                 # v2 · kanal() (zemin kanalı) yerine kopru()\n317\t    return PARCALAR\n318\t\n319\t\n320\t# ---------------------------------------------------------------- DENETİM ----------------------------------------------------------------\n321\tISTISNA = [(\"robot_kablosu_kangal\", \"robot_kablosu_uzatma\")]     # kangal = uzatmanın kendisi (uçlar kangal halkasına girer) · v1 ile aynı\n322\t\n323\t\n324\tdef _ist(a, b):\n325\t    return any((p in a and q in b) or (p in b and q in a) for p, q in ISTISNA)\n326\t\n327\t\n328\tdef _bbk(A, B, pay=0.01):\n329\t    return A.xmin < B.xmax - pay and B.xmin < A.xmax - pay and A.ymin < B.ymax - pay and B.ymin < A.ymax - pay and A.zmin < B.zmax - pay and B.zmin < A.zmax - pay\n330\t\n331\t\n332\tdef kendi_arasinda(ps, esik=1.0):\n333\t    S = [(p[\"ad\"], dunya(p)) for p in ps]; S = [(a, s, s.BoundingBox()) for a, s in S]\n334\t    out = []\n335\t    for i, (a, sa, A) in enumerate(S):\n336\t        for c, sc, B in S[i + 1:]:\n337\t            if not _bbk(A, B) or _ist(a, c):\n338\t                continue\n339\t            v = sa.intersect(sc).Volume()\n340\t            if v > esik: out.append((round(v, 3), a, c))\n341\t    return out\n342\t\n343\t\n344\tDEN = []\n345\t\n346\t\n347\tdef kontrol(ad, sart, deger=\"\"):\n348\t    DEN.append((ad, bool(sart), deger)); print(\"  %-150s %s %s\" % (ad, \"GEÇTİ\" if sart else \"** KALDI **\", deger))\n349\t\n350\t\n351\tif __name__ == \"__main__\":\n352\t    t0 = time.time(); arg = sys.argv[1:]\n353\t    kimlik = id(PARCALAR)\n354\t    kur(); ps = kur()\n355\t    gec = [p[\"ad\"] for p in ps if not dunya(p).isValid()]\n356\t    print(\"RAY EKLERİ v2 (h3_ray_ek_v1) · %d parça · katı denetimi: %s · %.0f sn\" % (len(ps), \"hepsi geçerli\" if not gec else gec, time.time() - t0))\n357\t    for kod, _a in BIRIMLER:\n358\t        q = [dunya(p).BoundingBox() for p in ps if p[\"birim\"] == kod]\n359\t        print(\"   %-22s %2d parça · x %.1f–%.1f · y %.1f–%.1f · z %.1f–%.1f\" % (kod, len(q), min(v.xmin for v in q), max(v.xmax for v in q), min(v.ymin for v in q), max(v.ymax for v in q), min(v.zmin for v in q), max(v.zmax for v in q)))\n360\t    print(\"DENETİM (h3_ray_ek_v1)\")\n361\t    kontrol(\"katılar geçerli · kur() iki kez → %d parça (v1 ile aynı sayı 26), PARCALAR nesnesi aynı (idempotent)\" % len(ps), not gec and ps is PARCALAR and id(PARCALAR) == kimlik and len(ps) == 26, \", \".join(gec))\n362\t    ob = [dunya(p).BoundingBox() for p in ps if p[\"birim\"] == \"ROBOT_ZINCIR_OLUGU\"]\n363\t    kontrol(\"zincir oluğu x %.1f–%.1f · y %.0f–%.0f · z %.0f–%.0f (v2 ray x %.1f–%.0f · y 0–60 · z 485–575)\" % (min(v.xmin for v in ob), max(v.xmax for v in ob), min(v.ymin for v in ob), max(v.ymax for v in ob), min(v.zmin for v in ob), max(v.zmax for v in ob), RAY_X[0], RAY_X[1]),\n364\t            abs(min(v.xmin for v in ob) - RAY_X[0]) < 0.01 and abs(max(v.xmax for v in ob) - RAY_X[1]) < 0.01 and abs(min(v.ymin for v in ob)) < 0.01 and abs(max(v.ymax for v in ob) - 60) < 0.01\n365\t            and abs(min(v.zmin for v in ob) - 485) < 0.01 and abs(max(v.zmax for v in ob) - 575) < 0.01)\n366\t    xmin_hep = min(dunya(p).BoundingBox().xmin for p in ps)\n367\t    kontrol(\"SOL UÇ: bütün ray eki parçaları x ≥ %.1f (ray başı) · en sol parça x %.2f (oluk sol uç duvarı %.1f–%.1f, uç durdurucu rayın içinde) · rayın solunda parça YOK\"\n368\t            % (RAY_X[0], xmin_hep, OLUK[\"x\"][0], OLUK[\"x\"][0] + OT), xmin_hep >= RAY_X[0] - 1e-6)\n369\t    kontrol(\"oluk ↔ robot rayı (ROBOT_RAY z %.0f–%.0f) arası %.0f mm\" % (RAY_Z[0], RAY_Z[1], OLUK[\"z\"][0] - RAY_Z[1]), OLUK[\"z\"][0] - RAY_Z[1] >= 5.0)\n370\t    kb = [dunya(p).BoundingBox() for p in ps if p[\"birim\"] == \"ZEMIN_KANALI\"]\n371\t    kontrol(\"zemin kanalı x %.0f–%.0f · y %.0f–%.0f · z %.0f–%.0f · koridor kapağı z %.0f–%.0f (v1 ile aynı: x 4760–4840 · z 575–670 · y −60…0)\"\n372\t            % (min(v.xmin for v in kb), max(v.xmax for v in kb), min(v.ymin for v in kb), max(v.ymax for v in kb), min(v.zmin for v in kb), max(v.zmax for v in kb), KANAL[\"kapak_z\"][0], KANAL[\"kapak_z\"][1]),\n373\t            abs(min(v.xmin for v in kb) - 4760) < 0.01 and abs(max(v.xmax for v in kb) - 4840) < 0.01 and abs(min(v.ymin for v in kb) + 60) < 0.01 and max(v.ymax for v in kb) <= 0.01)\n374\t    # enerji zinciri\n375\t    R, hG = Z_H[\"R\"], Z_H[\"hG\"]\n376\t    xc = donus_x(RX_MONTAJ)\n377\t    print(\"ENERJİ ZİNCİRİ: L %.0f · R %.0f · sabit uç %.2f (ray ortası) · robot %.1f–%.0f (VARSAYIM araba ±%.0f) · montaj (robot %.0f): alt kol %.1f–%.2f · üst kol %.1f–%.0f · büküm dış x %.1f\"\n378\t          % (L_ZINCIR, R, XF, ROBOT_X[0], ROBOT_X[1], ARABA_YARI, RX_MONTAJ, xc, XF, xc, RX_MONTAJ, xc - R - hG / 2.0))\n379\t    for xm in (ROBOT_X[0], x_min_etkin(), X_ROB_AC, RX_MONTAJ, ROBOT_X[1]):\n380\t        c_ = donus_x(xm)\n381\t        print(\"   robot x %7.1f → büküm merkezi x %7.1f · alt kol %6.1f · üst kol %6.1f · büküm dış kenarı x %7.1f\" % (xm, c_, XF - c_, xm - c_, c_ - R - hG / 2.0))\n382\t    zy = zincir_yolu()\n383\t    kontrol(\"zincir ekseni boyu = L (%.1f = %.0f)\" % (uzunluk(zy), L_ZINCIR), abs(uzunluk(zy) - L_ZINCIR) < 2.0)\n384\t    kontrol(\"zincir sabit ucu XF %.2f = ray ortası (%.1f + %.0f) / 2 (SPEC kuralı, v1 2650 = (200 + 5100) / 2)\" % (XF, RAY_X[0], RAY_X[1]), abs(XF - (RAY_X[0] + RAY_X[1]) / 2.0) < 1e-9)\n385\t    kontrol(\"robot x %.0f (QR önü): alt kol %.1f ≥ güvenlik payı %.0f\" % (ROBOT_X[1], XF - donus_x(ROBOT_X[1]), Z_H[\"pay\"]), XF - donus_x(ROBOT_X[1]) >= Z_H[\"pay\"] - 0.01)\n386\t    xme = x_min_etkin()\n387\t    kontrol(\"robot açıcıya bırakma konumu x %.1f (h2_hesap X_ROB_AC) ≥ zincirle gidilebilen en sol x %.2f (büküm oluk sol ucuna 5 mm) → açıcıya ERİŞİR\" % (X_ROB_AC, xme), X_ROB_AC >= xme)\n388\t    zb_ = [dunya(p).BoundingBox() for p in ps if p[\"ad\"] == \"enerji_zinciri\"][0]\n389\t    kontrol(\"montaj pozunda zincir x %.2f–%.2f oluğun içinde (sol uç duvarı iç yüzü %.1f + 5 ≤ büküm dış kenarı)\" % (zb_.xmin, zb_.xmax, OLUK[\"x\"][0] + OT),\n390\t            zb_.xmin >= OLUK[\"x\"][0] + OT + 5.0 - 1e-6 and zb_.xmax <= OLUK[\"x\"][1] - OT)\n391\t    print(\"  UYARI (v1'de de vardı): zincirle robotun gidebildiği en sol x = %.2f · ray + araba %.1f'ye izin verir · ARADA %.1f mm KULLANILAMAZ (v1: 300 → 507,8 = 207,8 mm) — oluk sola uzamalı ya da sabit uç sola kaymalı\"\n392\t          % (xme, ROBOT_X[0], xme - ROBOT_X[0]))\n393\t    print(\"  UYARI (v1 ile aynı): U döngü yüksekliği 2R + hG = %.0f mm > oluk yüksekliği %.0f → zincirin üst kolu y %.0f–%.0f'da, oluğun DIŞINDA\"\n394\t          % (2 * R + hG, OLUK[\"y\"][1], Y_UST - hG / 2.0, Y_UST + hG / 2.0))\n395\t    print(\"  UYARI: üst kol desteksiz boyu en çok %.0f (robot %.0f'de; v1 2377) > kendini taşıma boyu %.0f (VARSAYIM) → kayma rafı gerekir (açık çekmecelere dikkat)\"\n396\t          % (ROBOT_X[1] - donus_x(ROBOT_X[1]), ROBOT_X[1], FLG))\n397\t    # kablo\n398\t    h = kablo_hesabi()\n399\t    print(\"ROBOT KABLOSU (modellenen yol boyunca, eksen):\")\n400\t    for a_, v in h[\"bol\"]:\n401\t        print(\"   %-44s %7.0f mm\" % (a_, v))\n402\t    print(\"   %-44s %7.0f mm\" % (\"GEREKLİ (kangal hariç)\", h[\"gerekli\"]))\n403\t    print(\"   standart parça %.1f (hedef %.0f) · uzatma %.1f (hedef %.0f) · toplam %.1f · konnektör oluk içinde x %.2f\" % (h[\"L_std\"], KABLO_STD, h[\"L_uz\"], KABLO_UZ, h[\"L_std\"] + h[\"L_uz\"], h[\"xj\"]))\n404\t    kontrol(\"standart kablo = %.1f (4 m) · uzatma = %.1f (11 m) · konnektör x %.1f–%.1f oluğun kapaklı bölümünde (XF + 2 = %.1f … kanal ağzı %.0f)\"\n405\t            % (h[\"L_std\"], h[\"L_uz\"], h[\"xj\"] - KONN_L / 2.0, h[\"xj\"] + KONN_L / 2.0, XF + 2.0, KABLO_X_KANAL - 15.0),\n406\t            abs(h[\"L_std\"] - KABLO_STD) < 1.0 and abs(h[\"L_uz\"] - KABLO_UZ) < 1.0 and XF + 2.0 <= h[\"xj\"] - KONN_L / 2.0 and h[\"xj\"] + 95.0 <= KABLO_X_KANAL - 15.0)\n407\t    kontrol(\"Fairino standart 4 m YETMEZ: gereken %.2f m > 4 m\" % (h[\"gerekli\"] / 1000.0), h[\"gerekli\"] > KABLO_STD)\n408\t    kontrol(\"4 m + 11 m uzatma = 15 m yeter: gereken %.2f m · artan %.2f m kangalda\" % (h[\"gerekli\"] / 1000.0, h[\"kangal\"] / 1000.0),\n409\t            h[\"gerekli\"] <= KABLO_TOPLAM and abs(h[\"L_std\"] + h[\"L_uz\"] - KABLO_TOPLAM) < 1.0)\n410\t    yk = KG[\"y0\"] + h[\"N\"] * KABLO_D\n411\t    kontrol(\"kangal %.2f sarım · Ø%.0f · yükseklik %.0f → y %.0f–%.1f QR bölgesinde (y ≤ %.0f · fan altı %.0f)\" % (h[\"N\"], 2 * KG_RM, h[\"N\"] * KABLO_D, KG[\"y0\"], yk,\n412\t            QR.KANGAL_BOLGE[\"y\"][1], QR.FAN[\"alt\"][2]), yk <= QR.KANGAL_BOLGE[\"y\"][1] and yk < QR.FAN[\"alt\"][2])\n413\t    kontrol(\"kangal x %.1f–%.1f · z %.0f–%.0f QR kangal bölgesinde (x 5080–5405)\" % (KG[\"xc\"] - KG[\"rd\"], KG[\"xc\"] + KG[\"rd\"], KG[\"zc\"] - KG[\"rd\"], KG[\"zc\"] + KG[\"rd\"]),\n414\t            KG[\"xc\"] - KG[\"rd\"] >= QR.X0 + QR.KANGAL_BOLGE[\"x\"][0] and KG[\"xc\"] + KG[\"rd\"] <= QR.X0 + QR.KANGAL_BOLGE[\"x\"][1])\n415\t    kontrol(\"büküm yarıçapları: zincir R %.0f = %.1f × d (dinamik ≥ 7,5 × d VARSAYIM) · kangal %.0f = %.1f × d (statik ≥ 5 × d)\" % (R, R / KABLO_D, KG_RM, KG_RM / KABLO_D),\n416\t            R >= 7.5 * KABLO_D and KG_RM >= 5.0 * KABLO_D)\n417\t    kontrol(\"kablo zincir iç kesitine sığar (Ø%.0f ≤ iç %.0f × %.0f, %%10 pay)\" % (KABLO_D, Z_H[\"hi\"], Z_H[\"bi\"]), KABLO_D * 1.1 <= Z_H[\"hi\"] and KABLO_D * 1.1 <= Z_H[\"bi\"])\n418\t    kontrol(\"hareketli uç braketi kaide yüzünün (z %.0f) önünde · robot kutusuna girmez\" % KAIDE_Z,\n419\t            min(dunya(p).BoundingBox().zmin for p in ps if p[\"ad\"] == \"zincir_hareketli_uc_braketi\") >= KAIDE_Z)\n420\t    t1 = time.time()\n421\t    cak = kendi_arasinda(ps, esik=0.1)\n422\t    print(\"KENDİ ARASINDA (> 0,1 mm³): %s · %.0f sn\" % (\"TEMİZ\" if not cak else cak[:20], time.time() - t1))\n423\t    kontrol(\"kendi arasında çakışma = 0 (%d parça · > 0,1 mm³ · istisna v1 ile aynı: kangal = uzatmanın kendisi)\" % len(ps), not cak, str(cak[:6]))\n424\t    # v1 karşılaştırması: hangi parça değişti (belge) · robot tarafı + sağ uç AYNI olmalı\n425\t    import ray_ek_cad_v1 as R1\n426\t    R1.kur()\n427\t    b1 = {p[\"ad\"]: R1.dunya(p).BoundingBox() for p in R1.PARCALAR}\n428\t    b2 = {p[\"ad\"]: dunya(p).BoundingBox() for p in ps}\n429\t    kontrol(\"parça adları / birimleri / malzemeleri v1 ile aynı (%d parça)\" % len(ps),\n430\t            [p[\"ad\"] for p in ps] == [p[\"ad\"] for p in R1.PARCALAR] and all(p[\"birim\"] == q[\"birim\"] and p[\"mal\"] == q[\"mal\"] for p, q in zip(ps, R1.PARCALAR)))\n431\t    degisen, ayni = [], []\n432\t    for p, q in zip(ps, R1.PARCALAR):\n433\t        A, B = b2[p[\"ad\"]], b1[q[\"ad\"]]\n434\t        d = max(abs(A.xmin - B.xmin), abs(A.xmax - B.xmax), abs(A.ymin - B.ymin), abs(A.ymax - B.ymax), abs(A.zmin - B.zmin), abs(A.zmax - B.zmax), abs(dunya(p).Volume() - R1.dunya(q).Volume()))\n435\t        (degisen if d > 1e-6 else ayni).append(p[\"ad\"])\n436\t        if d > 1e-6:\n437\t            print(\"   DEĞİŞTİ %-30s x %8.2f–%8.2f → %8.2f–%8.2f · y %6.1f–%6.1f → %6.1f–%6.1f · hacim %10.0f → %10.0f\"\n438\t                  % (p[\"ad\"], B.xmin, B.xmax, A.xmin, A.xmax, B.ymin, B.ymax, A.ymin, A.ymax, R1.dunya(q).Volume(), dunya(p).Volume()))\n439\t    sabit_bek = (\"oluk_uc_duvari_sag\", \"zincir_hareketli_uc_braketi\", \"kablo_kelepcesi_0\", \"kablo_kelepcesi_1\", \"kanal_tabani\", \"kanal_yan_sol\", \"kanal_yan_sag\",\n440\t                 \"kanal_uc_hat\", \"kanal_uc_qr\", \"kanal_ayirici\", \"kanal_kapagi_koridor\", \"kanal_kapagi_QR_alti\")\n441\t    kontrol(\"AYNI KALAN (robot tarafı + sağ uç + zemin kanalı): %d parça v1 ile birebir (%s)\" % (len(ayni), \", \".join(ayni)), all(a in ayni for a in sabit_bek), str([a for a in sabit_bek if a not in ayni]))\n442\t    kontrol(\"DEĞİŞEN %d parça yalnız sol uca / sabit uca bağlı olanlar (oluk 3 boy + sol uç duvarı + 3 kapak · zincir + sabit uç braketi · standart kablo · konnektör · uzatma A · \"\n443\t            \"kangal + kangal üstünden çıkan uzatma B: kangal %.2f sarım yükseldi)\" % (len(degisen), h[\"N\"]),\n444\t            set(degisen) == {\"oluk_tabani\", \"oluk_yan_robot\", \"oluk_yan_koridor\", \"oluk_uc_duvari_sol\", \"oluk_kapagi_0\", \"oluk_kapagi_1\", \"oluk_kapagi_2\", \"enerji_zinciri\",\n445\t                             \"zincir_sabit_uc_braketi\", \"robot_kablosu_standart_4m\", \"robot_kablosu_uzatma_A\", \"robot_kablosu_uzatma_B\", \"uzatma_konnektoru\", \"robot_kablosu_kangal\"}, str(degisen))\n446\t    print(\"   v1 → v2 sayılar: RAY_X %s → %s · XF %.2f → %.2f · L_ZINCIR %.0f → %.0f · ROBOT_X %s → %s · X_BAG %.2f → %.2f · konnektör xj %.2f → %.2f · kangal %.3f → %.3f sarım · en sol erişim %.2f → %.2f\"\n447\t          % (R1.RAY_X, RAY_X, R1.XF, XF, R1.L_ZINCIR, L_ZINCIR, R1.ROBOT_X, ROBOT_X, R1.X_BAG, X_BAG, R1.kablo_hesabi()[\"xj\"], h[\"xj\"], R1.kablo_hesabi()[\"N\"], h[\"N\"], R1.x_min_etkin(), xme))\n448\t    if \"hizli\" not in arg:\n449\t        QR.kur()\n450\t        qs = [dict(ad=q[\"ad\"], wp=q[\"wp\"], _sh=QR.dunya(q)) for q in QR.PARCALAR]\n451\t        cc = QR.capraz([p for p in ps], qs, esik=0.1)\n452\t        kontrol(\"ray ekleri ↔ QR dolabı (qr_cad_v1, %d parça) çakışma = 0 (> 0,1 mm³)\" % len(qs), not cc, str(cc[:6]))\n453\t    kal = [d_ for d_ in DEN if not d_[1]]\n454\t    print(\"DENETIM: %d madde · %d KALDI · toplam %.0f sn\" % (len(DEN), len(kal), time.time() - t0))\n455\t    assert not kal\n456\t    sys.stdout.flush(); os._exit(0)\n457\t"}]},"uuid":"aad83a30-429e-4533-95da-dbb275f090dc","timestamp":"2026-10-01T13:17:47.060Z","sourceToolAssistantUUID":"4256b1d8-3ba4-47bd-a971-8c98a85ac50b","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
