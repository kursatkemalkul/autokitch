{"parentUuid":"022a54dc-479c-42a9-a09d-feab0b5d2e88","isSidechain":true,"agentId":"afad5ca3c893fe926","message":{"model":"claude-opus-5-5","id":"msg_011Cfg6edqwCdryeEoRQcERY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01RQ83q2Q4uq8UbvyFWjkHPj","name":"Read","input":{"file_path":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8\\arastirma\\_uretec\\h3\\h3_govde_ortak_v1.py","offset":590,"limit":465},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17743,"cache_read_input_tokens":193195,"output_tokens":178,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":17743},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":178,"cache_read_input_tokens":193195,"cache_creation_input_tokens":17743,"cache_creation":{"ephemeral_5m_input_tokens":17743,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01RQ83q2Q4uq8UbvyFWjkHPj":{"file_path":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8\\arastirma\\_uretec\\h3\\h3_govde_ortak_v1.py","offset":590,"limit":465}},"apiBlockIndex":0,"requestId":"req_011Cfg6edXLWw4ip3zZgeRY4","attributionAgent":"general-purpose","type":"assistant","uuid":"60aff0c6-a150-4b3a-8569-620170c0befe","timestamp":"2026-10-03T22:32:43.817Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
{"parentUuid":"60aff0c6-a150-4b3a-8569-620170c0befe","isSidechain":true,"promptId":"97ee8816-e7ae-44b2-b607-1b7fe760c01e","agentId":"afad5ca3c893fe926","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RQ83q2Q4uq8UbvyFWjkHPj","type":"tool_result","content":"590\t        gi = ki.R + ki.t\n591\t        if uo0 - e - kasa_ayak < ui0 + gi + 2.0 or uo1 + e + kasa_ayak > ui1 - gi - 2.0 or vo0 - e - kasa_ayak < vi0 + gi + 2.0 or vo1 + e + kasa_ayak > vi1 - gi - 2.0:\n592\t            raise ValueError(\"aciklik %s: kasa çıtası iç tavanın düz alanına sığmıyor\" % ad)\n593\t        ua, ub = uo0 + ks_t + 0.5, uo1 - ks_t - 0.5\n594\t        yanlar = [(\"sol\", [(uo0 - e - kasa_ayak, vo0), (uo0 - e, vo0), (uo0 - e, vo1), (uo0 - e - kasa_ayak, vo1)], 1),\n595\t                  (\"sag\", [(uo1 + e, vo0), (uo1 + e + kasa_ayak, vo0), (uo1 + e + kasa_ayak, vo1), (uo1 + e, vo1)], 3),\n596\t                  (\"alt\", [(ua, vo0 - e - kasa_ayak), (ub, vo0 - e - kasa_ayak), (ub, vo0 - e), (ua, vo0 - e)], 2),\n597\t                  (\"ust\", [(ua, vo1 + e), (ub, vo1 + e), (ub, vo1 + e + kasa_ayak), (ua, vo1 + e + kasa_ayak)], 0)]\n598\t        wk = K.w_ic + ki.t\n599\t        for yan, poly, kenar in yanlar:\n600\t            s = g.sac(\"%s_%s_kasa_%s\" % (K.ad, ad, yan), kasa_rol, mal=K.mal, doner=K)\n601\t            P = s.taban(poly, O=tuple(K.kf(0.0, 0.0, wk)), ex=tuple(K.ex), ey=tuple(K.ey), ad=\"ayak\")\n602\t            P.flans(kenar, hk, yon=+1, ad=\"kasa\")\n603\t            us = [p[0] for p in poly]; vs = [p[1] for p in poly]\n604\t            if yan in (\"sol\", \"sag\"):\n605\t                um = (min(us) + max(us)) / 2.0; nk = [tuple(K.kf(um, y, wk)) for y in _dizi(vo0, vo1, punta_aralik, 20.0)]\n606\t            else:\n607\t                vm = (min(vs) + max(vs)) / 2.0; nk = [tuple(K.kf(x, vm, wk)) for x in _dizi(ua, ub, punta_aralik, 20.0)]\n608\t            s.punta(ki, nk, not_=\"kasa çıtası düz ayağı → iç tava (kapak boşluğu tarafı)\")\n609\t            kayit[\"kasa\"].append(s.ad)\n610\t        g.not_(\"%s %s: kasa çıtası dik ayağı ↔ dış tava iç yüzü %.1f boşluk → gıda sınıfı silikon (punta YOK, satine yüz)\" % (K.ad, ad, kasa_bosluk))\n611\t    K.acikliklar.append(kayit)\n612\t    return kayit\n613\t\n614\t\n615\tdef _hinge_L(K, kenar, s):\n616\t    return lambda a, b, w: K.kf(*K.uv(kenar, s, a, b), w)\n617\t\n618\t\n619\tdef _kutu_l(L, a0, a1, b0, b1, w0, w1):\n620\t    p, q = L(a0, b0, w0), L(a1, b1, w1)\n621\t    return kutu(p[0], q[0], p[1], q[1], p[2], q[2])\n622\t\n623\t\n624\tdef _dikme_yeri(K, dikme, kenar, L, a_ref):\n625\t    \"\"\"dikme merkezinin menteşe yerelinde a'sı ve kapak w'si · dikme ekseni = menteşe ekseni olmalı\"\"\"\n626\t    av, bv = K.eksenler(kenar)\n627\t    ei = \"xyz\".index(dikme.eksen)\n628\t    if abs(abs(bv[ei]) - 1.0) > 1e-9: raise ValueError(\"dikme %s ekseni (%s) kapak kenarına paralel değil\" % (dikme.ad, dikme.eksen))\n629\t    H = L(a_ref, 0.0, K.w_ic)\n630\t    C = dikme.merkez(H[ei])\n631\t    a_c = float(np.dot(C - L(0.0, 0.0, 0.0), av))\n632\t    w_c = float(np.dot(C - K.O, K.n))\n633\t    return C, a_c, w_c\n634\t\n635\t\n636\tdef gizli_mentese(g, K, dikme, kenar, konumlar, olcu=None):\n637\t    \"\"\"DİKME İÇİ GİZLİ 180° KALDIR-ÇIKAR MENTEŞE (Southco R6 / EMKA 1046 sınıfı · ölçüler TEMSİLİ).\n638\t    GÖVDE yarısı dikmenin içinde (ön duvarda pencere, dikmenin içe bakan yan duvarından 2 × M5 ISO 7380) · KANAT yarısı: plaka iç tavanın arkasında,\n639\t    cep kutusu kapak boşluğunda (iç tavada cep kesiği), kol dikme ön yüzünden plakaya · plaka iç tavadaki 2 × PEM SP-M5'e ISO 7380 M5 ile.\n640\t    konumlar: kenar boyunca kapak yereli konumları (sol/sağ: v · alt/üst: u). Sanal pivot = kapağın 'kenar'ındaki dış köşesi.\"\"\"\n641\t    m = dict(MENTESE, **(olcu or {}))\n642\t    av, bv = K.eksenler(kenar); nv = K.n\n643\t    yuz_on, yuz_ic = _yuz_adi(nv), _yuz_adi(av)\n644\t    if K.mentese_kenari not in (None, kenar): raise ValueError(\"%s: menteşe kenarı zaten %s\" % (K.ad, K.mentese_kenari))\n645\t    K.mentese_kenari = kenar\n646\t    I, ki = K.I, K.ki\n647\t    dis = m[\"dis\"]; ga0, ga1 = m[\"govde_a\"]; gb = m[\"govde_b\"]; vb_ = m[\"vida_b\"]; vd = m[\"vida_derinlik\"]\n648\t    pa0, pa1 = m[\"plaka_a\"]; pb = m[\"plaka_b\"]; pt = m[\"plaka_t\"]; pda, pdb = m[\"plaka_delik_a\"], m[\"plaka_delik_b\"]\n649\t    ca0, ca1 = m[\"cep_a\"]; cb = m[\"cep_b\"]; ch = m[\"cep_h\"]; ka0, ka1 = m[\"kol_a\"]; kb = m[\"kol_b\"]; ic0, ic1, icb = m[\"ic_cep\"]\n650\t    if K.w_ic + ch > K.w_dis - K.kd.t - 1e-6: raise ValueError(\"%s: menteşe cebi (%g) kapak boşluğuna sığmıyor\" % (K.ad, ch))\n651\t    adlar = []\n652\t    i0 = len(K.menteseler)\n653\t    for j, s in enumerate(konumlar):\n654\t        i = i0 + j; ad = \"%s_mentese_%d\" % (K.ad, i)\n655\t        L = _hinge_L(K, kenar, s)\n656\t        C, a_c, w_c = _dikme_yeri(K, dikme, kenar, L, (ga0 + ga1) / 2.0)\n657\t        h = dikme.b / 2.0; w_on = w_c + h; a_ic = a_c + h\n658\t        if not (a_c - h + dikme.t <= ga0 and ga1 <= a_c + h - dikme.t): raise ValueError(\"%s: menteşe gövdesi (a %g–%g) dikme %s boşluğuna sığmıyor (a %.1f–%.1f)\"\n659\t                                                                                           % (ad, ga0, ga1, dikme.ad, a_c - h + dikme.t, a_c + h - dikme.t))\n660\t        if w_on - m[\"govde_derinlik\"] < w_c - h + dikme.t - 1e-6: raise ValueError(\"%s: menteşe gövdesi dikmenin arka duvarına çarpar\" % ad)\n661\t        if w_on > K.w_ic - pt + 1e-6: raise ValueError(\"%s: dikme ön yüzü (w %.1f) kapak iç düzlemine çok yakın\" % (ad, w_on))\n662\t        # dikme: ön duvarda pencere · iç yan duvarda 2 × vida deliği\n663\t        dikme.duvar_pencere_nokta(yuz_on, L((ga0 + ga1) / 2.0, 0.0, w_on), 2 * (gb + m[\"pencere_pay\"][1]), (ga1 - ga0) + 2 * m[\"pencere_pay\"][0],\n664\t                                  tip=\"mentese_penceresi\", not_=\"gizli menteşe gövdesi\")\n665\t        for db in (-vb_, vb_):\n666\t            dikme.duvar_delik_nokta(yuz_ic, L(a_ic, db, w_on - vd), S.STD.delik_iso273(dis), tip=\"mentese_vidasi\", not_=\"menteşe gövdesi 2 × %s\" % dis)\n667\t        # gövde yarısı (dikme içinde) + dişli delikler\n668\t        L_vida = m[\"vida_boy\"] or S._boy_sec((a_ic - ga1) + m[\"dis_yiv\"] - 1.0, S.VIDA_BOY)\n669\t        h0, h1 = min(ga1 - m[\"dis_yiv\"], a_ic - L_vida - 1.0), ga1 + 1.0\n670\t        gov = _kutu_l(L, ga0, ga1, -gb, gb, w_on - m[\"govde_derinlik\"], w_on)\n671\t        for db in (-vb_, vb_):\n672\t            gov = gov.cut(silindir(L(h0, db, w_on - vd), av, S.D_NOM[dis] / 2.0, h1 - h0))\n673\t        g.eleman(g.ozel(ad + \"_sabit\", gov, m[\"sinif\"], \"Gizli 180° kaldır-çıkar menteşe · GÖVDE yarısı (dikme içine gömülü) %s\" % m[\"malzeme\"].rsplit(\" \", 1)[0],\n674\t                        \"%g × %g × %g · 2 × %s (dikme iç yan duvarından)\" % (ga1 - ga0, 2 * gb, m[\"govde_derinlik\"], dis), malzeme=m[\"malzeme\"], mal=\"celik\",\n675\t                        meta=dict(kaldir_cikar=True, aci=180, kenar=kenar, pivot=[round(float(c), 3) for c in K.kf(*K.uv(kenar, s, 0.0, 0.0), K.w_dis)])),\n676\t                 sabit=K)\n677\t        for db, ek in ((-vb_, \"a\"), (vb_, \"b\")):\n678\t            g.eleman(S.vida(\"ISO7380\", dis, L_vida, tuple(L(a_ic, db, w_on - vd)), tuple(-av), ad=ad + \"_sabit_vida_\" + ek, birim=g.birim), sabit=K)\n679\t        # kanat yarısı: plaka (iç tava arkasında) + cep kutusu (kapak boşluğunda) + kol · plaka vidalarının başı dikme ön yüzüne bakar →\n680\t        # vida ekseni dikmenin iç yan yüzünü baş yarıçapı + 1 geçmeli (geniş dikmede plaka bu kadar uzar; K 30 × 30'da uzama yok)\n681\t        pw0 = K.w_ic - pt\n682\t        pda, pa1 = m[\"plaka_delik_a\"], m[\"plaka_a\"][1]\n683\t        pda_min = a_ic + S.ISO7380[dis][0] / 2.0 + 1.0\n684\t        uzama = max(0.0, pda_min - pda)\n685\t        if uzama > 0: pda, pa1 = pda + uzama, pa1 + uzama\n686\t        pl = _kutu_l(L, pa0, pa1, -pb, pb, pw0, K.w_ic)\n687\t        for db in (-pdb, pdb):\n688\t            pl = pl.cut(silindir(L(pda, db, pw0 - 0.5), nv, m[\"plaka_delik_cap\"] / 2.0, pt + 1.5))\n689\t        parcalar = [pl, _kutu_l(L, ca0, ca1, -cb, cb, K.w_ic, K.w_ic + ch)]\n690\t        if pw0 - w_on > 1e-6: parcalar.append(_kutu_l(L, ka0, ka1, -kb, kb, w_on, pw0))\n691\t        g.eleman(g.ozel(ad + \"_kanat\", bir(*parcalar), m[\"sinif\"], \"Gizli 180° kaldır-çıkar menteşe · KANAT yarısı + kol (kapakla döner)\",\n692\t                        \"plaka %g × %g × %g + cep %g × %g × %g\" % (pa1 - pa0, 2 * pb, pt, ca1 - ca0, 2 * cb, ch), malzeme=m[\"malzeme\"], mal=\"celik\",\n693\t                        meta=dict(kapakla_doner=True, plaka_uzama=round(uzama, 2))), doner=K)\n694\t        uc_, vc_ = K.uv(kenar, s, (ic0 + ic1) / 2.0, 0.0)\n695\t        bo, en = ((ic1 - ic0), 2 * icb) if abs(abs(np.dot(av, K.ex)) - 1.0) < 1e-9 else (2 * icb, (ic1 - ic0))\n696\t        I.dikdortgen(uc_, vc_, bo, en, tip=\"mentese_cebi\", parca=\"menteşe kanat cebi (kol geçişi)\")\n697\t        for db, ek in ((-pdb, \"a\"), (pdb, \"b\")):\n698\t            ps, c, ms = S.pem_somun(\"SP\", dis, tuple(L(pda, db, K.w_ic + ki.t)), tuple(nv), ki.t, ad=ad + \"_pem_\" + ek, birim=g.birim)\n699\t            ps[\"meta\"][\"kapakla_doner\"] = True\n700\t            uu, vv = K.uv(kenar, s, pda, db)\n701\t            I.delik(uu, vv, c[\"delik\"], tip=\"pem_somun\", parca=ps[\"meta\"][\"parca\"], pem_tip=\"SP\", kenar_min=c[\"kenar\"], min_sac=ms)\n702\t            g.eleman(ps, doner=K)\n703\t            vdd = S.vida(\"ISO7380\", dis, m[\"kanat_vida_boy\"], tuple(L(pda, db, pw0)), tuple(nv), ad=ad + \"_kanat_vida_\" + ek, birim=g.birim)\n704\t            vdd[\"meta\"][\"kapakla_doner\"] = True\n705\t            g.eleman(vdd, doner=K)\n706\t        if uzama > 0: g.not_(\"%s: kanat plakası %.2f uzatıldı (dikme %s b %g · vida başı dikme ön yüzünden kaçar) — katalog/adaptör teyidi\" % (ad, uzama, dikme.ad, dikme.b))\n707\t        K.menteseler.append(dict(ad=ad, kenar=kenar, konum=s, dikme=dikme.ad, vida_boy=L_vida, plaka_uzama=round(uzama, 2)))\n708\t        adlar.append(ad)\n709\t    return adlar\n710\t\n711\t\n712\tdef bas_ac(g, K, dikme, kenar, konumlar, a=22.0, olcu=None):\n713\t    \"\"\"DİKME İÇİ BAS-AÇ (push-to-open, Southco 97 / EMKA 1080 sınıfı · geçme gövde): dikme ön duvarında Ø12,2 · gövde dikmenin içinde, baş ön yüzde,\n714\t    uç kapak iç düzlemine kadar · kapakta iç tavanın boşluk tarafına punta karşılık plakası (1,5). a: kapağın 'kenar'ından içeri.\"\"\"\n715\t    m = dict(BASAC, **(olcu or {}))\n716\t    av, bv = K.eksenler(kenar); nv = K.n\n717\t    yuz_on = _yuz_adi(nv)\n718\t    ki = K.ki\n719\t    hu, hv = m[\"karsilik\"]\n720\t    adlar = []\n721\t    i0 = len(K.basaclar)\n722\t    for j, s in enumerate(konumlar):\n723\t        i = i0 + j; ad = \"%s_basac_%d\" % (K.ad, i)\n724\t        L = _hinge_L(K, kenar, s)\n725\t        C, a_c, w_c = _dikme_yeri(K, dikme, kenar, L, a)\n726\t        h = dikme.b / 2.0; w_on = w_c + h\n727\t        rg = m[\"govde_cap\"] / 2.0\n728\t        if not (a_c - h + dikme.t <= a - rg and a + rg <= a_c + h - dikme.t): raise ValueError(\"%s: bas-aç gövdesi dikme %s boşluğuna sığmıyor\" % (ad, dikme.ad))\n729\t        uc_len = K.w_ic - w_on - m[\"bas_h\"]\n730\t        if uc_len <= 1e-6: raise ValueError(\"%s: dikme ön yüzü kapak iç düzlemine çok yakın (bas-aç ucu yok)\" % ad)\n731\t        dikme.duvar_delik_nokta(yuz_on, L(a, 0.0, w_on), m[\"delik_cap\"], tip=\"basac_deligi\", not_=\"bas-aç gövdesi (geçme)\")\n732\t        sh = silindir(L(a, 0.0, w_on - m[\"govde_boy\"]), nv, rg, m[\"govde_boy\"]).fuse(silindir(L(a, 0.0, w_on), nv, m[\"bas_cap\"] / 2.0, m[\"bas_h\"])) \\\n733\t            .fuse(silindir(L(a, 0.0, w_on + m[\"bas_h\"]), nv, m[\"uc_cap\"] / 2.0, uc_len))\n734\t        g.eleman(g.ozel(ad, sh, m[\"sinif\"], \"Bas-aç mandalı (push-to-open, geçme gövde Ø%g · O-ring) — dikme ön yüzünde Ø%g\" % (m[\"govde_cap\"], m[\"delik_cap\"]),\n735\t                        \"Ø%g × %g · baş Ø%g × %g · strok %g\" % (m[\"govde_cap\"], m[\"govde_boy\"], m[\"bas_cap\"], m[\"bas_h\"], m[\"strok\"]), malzeme=m[\"malzeme\"],\n736\t                        mal=\"siyah\"), sabit=K)\n737\t        dp = g.sac(\"%s_karsilik_%d\" % (K.ad, i), m[\"karsilik_rol\"], mal=K.mal, doner=K)\n738\t        uc_, vc_ = K.uv(kenar, s, a, 0.0)\n739\t        su, sv = (hu, hv) if abs(abs(np.dot(av, K.ex)) - 1.0) < 1e-9 else (hv, hu)\n740\t        dp.taban([(uc_ - su, vc_ - sv), (uc_ + su, vc_ - sv), (uc_ + su, vc_ + sv), (uc_ - su, vc_ + sv)], O=tuple(K.kf(0.0, 0.0, K.w_ic + ki.t)),\n741\t                 ex=tuple(K.ex), ey=tuple(K.ey), ad=\"plaka\")\n742\t        dp.punta(ki, [tuple(L(a + pa, pb, K.w_ic + ki.t)) for pa, pb in m[\"punta\"]], not_=\"karşılık takviyesi → iç tava (kapak kapanmadan önce)\")\n743\t        K.basaclar.append(dict(ad=ad, kenar=kenar, konum=s, a=a, dikme=dikme.ad))\n744\t        adlar.append(ad)\n745\t    return adlar\n746\t\n747\t\n748\t# =====================================================================================================================================\n749\t# 5 · İSTASYON ↔ İSTASYON M8 NOKTASI (perçin somun + ara pul + karşı Ø9 kaydı + arayüz cıvatası)\n750\t# =====================================================================================================================================\n751\tdef m8_noktasi(g, etiket, profil, a, yuz, panel, karsi, karsi_kod=\"?\", karsi_t=1.5, vida_boy=25, kayma=0.0, yer=\"\", cerceve=None):\n752\t    \"\"\"profil (dikme / kuşak) 'yuz' duvarında (komşuya bakan dış duvar) eksen konumu a'da M8 PERÇİN SOMUN (delik Ø11, kavrama = profil t) ·\n753\t    perçin başı ile yan sac iç yüzü arasına AISI 304 ARA PUL (kalınlık otomatik) · yan sacta (panel) Ø9 · komşu sac iç yüzünden ISO 4762 M8 + DIN 125\n754\t    → ARAYÜZ (montaja girmez) · komşu sacta Ø9 → KARSI_DELIK kaydı (dünya merkezi). Adlar: govde_m8_<etiket> · govde_m8_ara_pul_<etiket> ·\n755\t    arayuz_m8_<etiket>(_pul).\"\"\"\n756\t    cer = cerceve or g.cerceve\n757\t    d = _yuz_vektor(yuz)\n758\t    dik = [k for k in \"xyz\" if k not in (profil.eksen, yuz[1])][0]\n759\t    P = profil.merkez(a) + EKSEN[dik] * kayma\n760\t    Pf = P + d * profil.b / 2.0                                                       # profil dış duvarı (perçin başı oturur)\n761\t    ps, c = S.percin_somun(M8[\"dis\"], profil.t, tuple(Pf), tuple(-d), ad=\"govde_m8_\" + etiket, birim=g.birim)\n762\t    profil.duvar_delik(yuz, a, kayma, c[\"delik\"], tip=\"m8_percin_somun\", not_=\"%s↔%s M8\" % (g.istasyon, karsi_kod))\n763\t    g.eleman(ps)\n764\t    uv = panel.yerel(Pf)\n765\t    F = [panel.dunya(uv[0], uv[1], z) for z in (0.0, panel.sac.t)]\n766\t    ic_y = max(F, key=lambda q: float(np.dot(q, -d))); dis_y = max(F, key=lambda q: float(np.dot(q, d)))\n767\t    ara = float(np.dot(Pf - ic_y, -d)) - c[\"hk\"]\n768\t    if ara < -1e-6: raise ValueError(\"m8 %s: perçin somun başı yan sacın içine giriyor (%.2f)\" % (etiket, ara))\n769\t    if ara > 0.2:\n770\t        sh = halka(Pf + d * c[\"hk\"], d, M8[\"ara_dis\"] / 2.0, M8[\"ara_ic\"] / 2.0, ara)\n771\t        g.eleman(g.ozel(\"govde_m8_ara_pul_\" + etiket, sh, \"özel (304 · lazer)\", \"Ara pul AISI 304 Ø%g / Ø%g × %g (yan sac ↔ perçin somun başı)\"\n772\t                        % (M8[\"ara_dis\"], M8[\"ara_ic\"], round(ara, 2)), \"Ø%g × %g\" % (M8[\"ara_dis\"], round(ara, 2)), uretim=True, mal=\"sac\"))\n773\t    gecis = S.STD.delik_iso273(M8[\"dis\"])\n774\t    panel.delik(uv[0], uv[1], gecis, tip=\"vida_deligi\", parca=\"%s↔%s M8 (ISO 273 orta)\" % (g.istasyon, karsi_kod))\n775\t    Pk = dis_y + d * karsi_t                                                          # komşu sacın iç yüzü\n776\t    hp = S.DIN125[M8[\"dis\"]][2]\n777\t    pu = S.pul(M8[\"pul_std\"], M8[\"dis\"], tuple(Pk + d * hp), tuple(-d), ad=\"arayuz_m8_%s_pul\" % etiket, birim=g.birim)\n778\t    vd = S.vida(M8[\"vida_std\"], M8[\"dis\"], vida_boy, tuple(Pk + d * hp), tuple(-d), ad=\"arayuz_m8_%s\" % etiket, birim=g.birim)\n779\t    g.arayuz(pu, karsi, \"komşu yan sacta Ø%g delik (aynı eksen)\" % gecis, \"\")\n780\t    g.arayuz(vd, karsi, \"ISO 4762 M8 × %g A2-70 + DIN 125 · komşu istasyonun içinden takılır\" % vida_boy, \"\")\n781\t    kd = dict(etiket=etiket, karsi=karsi, karsi_kod=karsi_kod, cap=gecis, sac_t=karsi_t, eksen=[float(x) for x in -d],\n782\t              merkez_dunya=[round(float(x), 2) for x in cer.nokta(Pk)], merkez_yerel=[round(float(x), 2) for x in Pk])\n783\t    g.KARSI_DELIK.append(kd)\n784\t    r = dict(etiket=etiket, taraf=karsi_kod, yer=yer or profil.ad, profil=profil.ad, a=a, ara_pul=round(ara, 3),\n785\t             dunya=[round(float(x), 1) for x in cer.nokta(Pk)], karsi_delik=kd)\n786\t    g.M8.append(r)\n787\t    return r\n788\t\n789\t\n790\t# =====================================================================================================================================\n791\t# 6 · MONTAJ SÖZLEŞMESİ (parça listesi · uygula · dünya kopyası · kapak bileşiği · ad denetimi)\n792\t# =====================================================================================================================================\n793\tdef govde_parcalari(g, anahtar=\"wp\", hedef=None):\n794\t    \"\"\"montaja girecek gövde parçaları (arayüz elemanları HARİÇ) · g.cerceve yerelinde (hedef=Cerceve verilirse o çerçevenin yereline ötelenir) ·\n795\t    anahtar 'wp' (Workplane, KS.PARCALAR biçimi) ya da 'sh' (TU.P biçimi)\"\"\"\n796\t    L = []\n797\t    for s in g.SAC:\n798\t        ps = s.parcalar()\n799\t        if s.ad in g.DONER_SAC:\n800\t            beklenen = set(_sac_parca_adlari(s))\n801\t            for p in ps:\n802\t                assert p[\"ad\"] in beklenen, (\"kapak sacı parça adı beklenmiyor\", p[\"ad\"])\n803\t                g.DONER[p[\"ad\"]] = g.DONER_SAC[s.ad]\n804\t        L += ps\n805\t    L += [p.parca() for p in g.PROF.values()] + g.ELEMAN + g.KAYNAK\n806\t    gec = g.cerceve.gecis(hedef) if hedef is not None else None\n807\t    out = []\n808\t    for p in L:\n809\t        sh = _sekil(p)\n810\t        if gec is not None and not gec.bos(): sh = gec.dunya(sh)\n811\t        q = dict(ad=p[\"ad\"], mal=g.mal(p), grup=\"SABIT\", bom=tuple(p[\"bom\"]) if p.get(\"bom\") else None, kaynak=g.surum, birim=g.birim, tur=p.get(\"tur\", \"sac\"))\n812\t        q[anahtar] = cq.Workplane(\"XY\").add(sh) if anahtar == \"wp\" else sh\n813\t        if p.get(\"sac\"): q[\"sac\"] = p[\"sac\"]\n814\t        if p.get(\"meta\"): q[\"meta\"] = p[\"meta\"]\n815\t        out.append(q)\n816\t    adlar = [q[\"ad\"] for q in out]\n817\t    assert len(adlar) == len(set(adlar)), \"çift ad: %s\" % sorted(a for a in set(adlar) if adlar.count(a) > 1)\n818\t    return out\n819\t\n820\t\n821\tdef uygula(L, yeni, eski_adlar, isaret, onekler=None, rapor=None, etiket=\"\"):\n822\t    \"\"\"modülün parça listesine (KS.PARCALAR / TU.P …) yeni gövdeyi uygular: eski gövde adlarını çıkarır, yenileri ekler · idempotent\n823\t    (listede 'isaret' adlı parça varsa dokunmaz) · eski ad eksikse / mekanizmayla ad çakışırsa / önek dışı ad varsa assert\"\"\"\n824\t    if any(p[\"ad\"] == isaret for p in L):\n825\t        return L\n826\t    assert any(q[\"ad\"] == isaret for q in yeni), (\"%s: işaret adı yeni gövdede yok\" % etiket, isaret)\n827\t    var = set(p[\"ad\"] for p in L); eski = set(eski_adlar)\n828\t    eksik = [a for a in eski_adlar if a not in var]\n829\t    assert not eksik, (\"%s: eski gövde parçası listede yok\" % etiket, eksik)\n830\t    L[:] = [p for p in L if p[\"ad\"] not in eski]\n831\t    cak = set(p[\"ad\"] for p in L) & set(q[\"ad\"] for q in yeni)\n832\t    assert not cak, (\"%s: mekanizmayla ad çakışması\" % etiket, sorted(cak))\n833\t    if onekler:\n834\t        bilinmeyen = [q[\"ad\"] for q in yeni if not q[\"ad\"].startswith(tuple(onekler))]\n835\t        assert not bilinmeyen, (\"%s: gövde önekine uymayan ad\" % etiket, bilinmeyen[:5])\n836\t    L.extend(yeni)\n837\t    if rapor is not None: rapor.append(\"%s üretim sacı gövdesi: −%d eski · +%d yeni (%s)\" % (etiket, len(eski), len(yeni), SURUM))\n838\t    return L\n839\t\n840\t\n841\tdef dunya_listesi(L, cerceve):\n842\t    \"\"\"parça listesinin dünya kopyaları (wp ve/veya sh ötelenir) — süpürme / çakışma taraması için\"\"\"\n843\t    out = []\n844\t    for p in L:\n845\t        q = dict(p)\n846\t        if p.get(\"wp\") is not None:\n847\t            s = p[\"wp\"].val() if hasattr(p[\"wp\"], \"val\") else p[\"wp\"]\n848\t            q[\"wp\"] = cq.Workplane(\"XY\").add(cerceve.dunya(s))\n849\t        if p.get(\"sh\") is not None: q[\"sh\"] = cerceve.dunya(p[\"sh\"])\n850\t        out.append(q)\n851\t    return out\n852\t\n853\t\n854\tdef kapak_dunya(L, cerceve, doner):\n855\t    \"\"\"kapakla dönen bütün parçaların dünya bileşiği · doner: callable(ad) ya da ad kümesi (g.kapakla_doner · Kapak.doner)\"\"\"\n856\t    f = doner if callable(doner) else (lambda a: a in doner)\n857\t    return cq.Compound.makeCompound([cerceve.dunya(_sekil(p)) for p in L if f(p[\"ad\"])])\n858\t\n859\t\n860\tdef dunya_ciftleri(L, cerceve, onek=\"\", meta=False):\n861\t    \"\"\"[(ad, dünya şekli, meta)] — denetle(mekanizma=…, komsu=…) girdisi\"\"\"\n862\t    return [(onek + p[\"ad\"], cerceve.dunya(_sekil(p)), (p.get(\"meta\") or {}) if meta else {}) for p in L]\n863\t\n864\t\n865\tdef elk_hedefleri(modul_kodu, elk_json=None):\n866\t    \"\"\"elektrik katmanının bu modülde ADIYLA aradığı parçalar (h3/_elk/elk.json: 'delik' [modül, ad, not] · 'dusur' [modül, ad])\"\"\"\n867\t    yol = elk_json or os.path.join(H3, \"_elk\", \"elk.json\")\n868\t    if not os.path.exists(yol): return dict(delik=[], dusur=[], yol=yol, var=False)\n869\t    J = json.load(open(yol, encoding=\"utf-8\"))\n870\t    return dict(delik=sorted(set(x[1] for x in J.get(\"delik\", []) if x[0] == modul_kodu)),\n871\t                dusur=sorted(set(x[1] for x in J.get(\"dusur\", []) if x[0] == modul_kodu)), yol=yol, var=True)\n872\t\n873\t\n874\tdef ad_denetimi(modul_kodu, yeni_adlar, eski_adlar=(), esleme=None, elk_json=None):\n875\t    \"\"\"reçete 7 · elektrik delik hedefleri yeni listede AYNI adla olmalı (HATA) · düşürülecekler (UYARI) · kalkan eski adlar ESLEME'de (UYARI)\"\"\"\n876\t    E = elk_hedefleri(modul_kodu, elk_json); yeni = set(yeni_adlar); esleme = esleme or {}\n877\t    out = []\n878\t    if not E[\"var\"]: out.append(dict(kural=\"elk_kaynak\", durum=\"UYARI\", detay=\"elk.json yok: %s\" % E[\"yol\"]))\n879\t    for a in E[\"delik\"]:\n880\t        if a in yeni: out.append(dict(kural=\"elk_delik_hedefi\", durum=\"GEÇTİ\", detay=\"%s|%s korunuyor\" % (modul_kodu, a)))\n881\t        else: out.append(dict(kural=\"elk_delik_hedefi\", durum=\"HATA\", detay=\"%s|%s YOK — montaj _ELK_DELIK ADLA keser, _eksik32 assert'i düşer (ad korunmalı%s)\"\n882\t                                                                             % (modul_kodu, a, \"; eşleme yetmez → %s\" % esleme[a] if a in esleme else \"\")))\n883\t    for a in E[\"dusur\"]:\n884\t        if a not in yeni: out.append(dict(kural=\"elk_dusur\", durum=\"UYARI\", detay=\"%s|%s düşürülecek ama listede yok\" % (modul_kodu, a)))\n885\t    for a in eski_adlar:\n886\t        if a in yeni: continue\n887\t        if a not in esleme: out.append(dict(kural=\"ad_esleme\", durum=\"UYARI\", detay=\"eski ad kalktı, ESLEME (eski → yeni) yok: %s\" % a))\n888\t        else:\n889\t            hedef = esleme[a] if isinstance(esleme[a], (list, tuple)) else [esleme[a]]\n890\t            ilk = [str(h).split()[0] for h in hedef]\n891\t            durum = \"GEÇTİ\" if any(h in yeni for h in ilk) else \"UYARI\"\n892\t            out.append(dict(kural=\"ad_esleme\", durum=durum, detay=\"%s → %s\" % (a, hedef)))\n893\t    return out\n894\t\n895\t\n896\t# =====================================================================================================================================\n897\t# 7 · DENETİM ŞABLONU (doğrula + DFM + çakışma + arayüz karşı delik + kapak açılma süpürmesi)\n898\t# =====================================================================================================================================\n899\tdef bbk(a, b, pay=0.0):\n900\t    return a.xmin < b.xmax + pay and b.xmin < a.xmax + pay and a.ymin < b.ymax + pay and b.ymin < a.ymax + pay and a.zmin < b.zmax + pay and b.zmin < a.zmax + pay\n901\t\n902\t\n903\tdef hacim(a, b):\n904\t    try:\n905\t        return a.intersect(b).Volume()\n906\t    except Exception:\n907\t        return -1.0\n908\t\n909\t\n910\tdef cakisma(A, B, esik=0.5, ayni=False, izin=None):\n911\t    \"\"\"A, B: [(ad, şekil, meta)] · dönüş [(a, b, hacim mm³)] (> esik ya da hesap hatası)\"\"\"\n912\t    bA = [s.BoundingBox() for _a, s, _e in A]; bB = bA if ayni else [s.BoundingBox() for _a, s, _e in B]\n913\t    out = []\n914\t    for i, (a, sa, ea) in enumerate(A):\n915\t        for j in (range(i + 1, len(A)) if ayni else range(len(B))):\n916\t            b, sb, eb = B[j]\n917\t            if not bbk(bA[i], bB[j], -1e-4): continue\n918\t            if izin and izin(a, ea, b, eb): continue\n919\t            v = hacim(sa, sb)\n920\t            if v > esik or v < 0: out.append((a, b, round(v, 3)))\n921\t    return out\n922\t\n923\t\n924\tdef ic_ice_izni(a, ea, b, eb):\n925\t    \"\"\"PEM gömme saplama başı sacın içinde (meta ic_ice)\"\"\"\n926\t    return (b in (ea.get(\"ic_ice\") or [])) or (a in (eb.get(\"ic_ice\") or []))\n927\t\n928\t\n929\tdef denetle_sac(g, acinim_klasoru=None, abkant=True, log=print, ayrinti=lambda s: True):\n930\t    \"\"\"her sac: dogrula() + dfm(abkant) (+ açınım JSON) → (rapor, özet)\"\"\"\n931\t    R, ht, ut = {}, 0, 0\n932\t    if acinim_klasoru: os.makedirs(acinim_klasoru, exist_ok=True)\n933\t    for s in g.SAC:\n934\t        r = s.dogrula(); d = s.dfm(abkant=abkant); a = s.acinim()\n935\t        if acinim_klasoru:\n936\t            with open(os.path.join(acinim_klasoru, s.ad + \".json\"), \"w\", encoding=\"utf-8\") as f: json.dump(a, f, ensure_ascii=False, indent=1)\n937\t        h = [m for m in d if m[\"durum\"] == \"HATA\"]; u = [m for m in d if m[\"durum\"] == \"UYARI\"]\n938\t        ht += len(h); ut += len(u)\n939\t        ab = [m for m in d if m[\"kural\"] == \"abkant\"]\n940\t        gecti = bool(r.get(\"acinim_gecti\")) and bool(r[\"kalinlik\"][\"gecti\"]) and r.get(\"kesit_gecti\") is not False\n941\t        R[s.ad] = dict(t=s.t, R=s.R, K=s.K, rol=s.rol, bukum=len(s.bukumler), levha=a[\"levha\"], delik=len(a[\"ic_konturlar\"]), abkant_sira=(ab[0].get(\"sira\") if ab else None),\n942\t                       dogrula=dict(acinim_gecti=r.get(\"acinim_gecti\"), hacim_farki_yuzde=r.get(\"hacim_farki_yuzde\"), simetrik_fark_yuzde=r.get(\"simetrik_fark_yuzde\"),\n943\t                                    kalinlik_gecti=r[\"kalinlik\"][\"gecti\"], kesit_gecti=r.get(\"kesit_gecti\"), gecerli=r.get(\"gecerli\"), hata=r.get(\"yeniden_bukum_hatasi\")),\n944\t                       gecti=gecti, dfm_hata=h, dfm_uyari=u, punta=s.puntalar)\n945\t        if h or u or not gecti or ayrinti(s):\n946\t            log(\"%-34s t%.1f · %d büküm · açınım %.0f×%.0f %.2f kg · ΔV %s sim %s · kalınlık %s · kesit %s · DFM %d HATA %d UYARI\"\n947\t                % (s.ad, s.t, len(s.bukumler), a[\"levha\"][\"boy\"], a[\"levha\"][\"en\"], a[\"levha\"][\"kutle_kg\"], r.get(\"hacim_farki_yuzde\"), r.get(\"simetrik_fark_yuzde\"),\n948\t                   r[\"kalinlik\"][\"gecti\"], r.get(\"kesit_gecti\"), len(h), len(u)))\n949\t        for m in h + u: log(\"        %s %-18s %s\" % (m[\"durum\"], m[\"kural\"], m[\"detay\"][:200]))\n950\t    kalan = [a for a, x in R.items() if not x[\"gecti\"]]\n951\t    oz = dict(adet=len(g.SAC), dfm_hata=ht, dfm_uyari=ut, dogrulama_kalan=kalan)\n952\t    log(\"SAC: %d · DFM %d HATA · %d UYARI · doğrulama kalan %s\" % (len(g.SAC), ht, ut, kalan))\n953\t    return R, oz\n954\t\n955\t\n956\tdef denetle_profil(g, log=print):\n957\t    sat, ph = [], 0\n958\t    for p in g.PROF.values():\n959\t        k = p.kesim_satiri(); ph += len(k[\"dfm_hata\"]); sat.append(k)\n960\t        for m in k[\"dfm_hata\"]: log(\"   PROFİL HATA %s\" % m[\"detay\"])\n961\t    oz = dict(adet=len(sat), dfm_hata=ph, toplam_boy_m=round(sum(x[\"L\"] for x in sat) / 1000.0, 3), kg=round(sum(x[\"kg\"] for x in sat), 2))\n962\t    log(\"PROFİL: %d boru · %.2f m · %.1f kg · DFM %d HATA\" % (oz[\"adet\"], oz[\"toplam_boy_m\"], oz[\"kg\"], ph))\n963\t    return sat, oz\n964\t\n965\t\n966\tdef profil_kesim_listesi(g, yol=None):\n967\t    sat, oz = denetle_profil(g, log=lambda m: None)\n968\t    d = dict(not_=\"304 kare boru · kesim boyu = L · delik/pencere konumu 'a' borunun a0 ucundan · 'kayma' yüz ortasından\", ozet=oz, profiller=sat)\n969\t    if yol:\n970\t        with open(yol, \"w\", encoding=\"utf-8\") as f: json.dump(d, f, ensure_ascii=False, indent=1)\n971\t    return d\n972\t\n973\t\n974\tdef arayuz_karsi_delik(g, cerceve, adaylar, esik=0.05):\n975\t    \"\"\"arayüz elemanlarının (cıvata / pul / saplama) kestiği parçalar → karşı tarafta delik / diş gerekir · adaylar: [(ad, dünya şekli, meta)]\"\"\"\n976\t    aw = [(p[\"ad\"], cerceve.dunya(_sekil(p)), {}) for p in g.ARAYUZ]\n977\t    c = cakisma(aw, adaylar, esik=esik)\n978\t    gerek = collections.defaultdict(list)\n979\t    for a, b, v in c: gerek[b].append(a)\n980\t    kayit = [dict(ad=p[\"ad\"], karsi=p[\"arayuz\"][\"karsi\"], gerek=p[\"arayuz\"][\"gerek\"], not_=p[\"arayuz\"][\"not_\"], bom=list(p.get(\"bom\") or ())) for p in g.ARAYUZ]\n981\t    return kayit, {b: sorted(v) for b, v in sorted(gerek.items())}\n982\t\n983\t\n984\tdef kapak_supurme(g, K, gw, mw=(), nw=(), cerceve=None, acilar=tuple(range(10, 101, 10)), esik=1.0, don_desen=DON_DESEN):\n985\t    \"\"\"kapak açılma süpürmesi: K'nın dönen parçaları (K.doner + kapak sacları) sanal pivot etrafında dışa 10–100° döndürülür · engel = gövdenin\n986\t    dönmeyen parçaları (K.sabit ve menteşe/kilit donanımı hariç) + mekanizma + komşular (donanım hariç) · gw/mw/nw: [(ad, dünya şekli, meta)]\"\"\"\n987\t    cer = cerceve or g.cerceve\n988\t    if K.mentese_kenari is None: return dict(kapak=K.ad, atlandi=\"menteşe yok\", bulgu=[])\n989\t    DON = re.compile(don_desen)\n990\t    don = set(K.doner) | set(a for a, k in g.DONER.items() if k == K.ad)\n991\t    kap = [s for a, s, _e in gw if a in don]\n992\t    kapw = cq.Compound.makeCompound(kap)\n993\t    eng = [(a, s) for a, s, _e in gw if a not in don and a not in K.sabit and not DON.search(a)] + [(a, s) for a, s, _e in mw] + \\\n994\t          [(a, s) for a, s, _e in nw if not DON.search(a)]\n995\t    pv = cer.nokta(K.pivot()); ek = K.eksen()\n996\t    bul = []\n997\t    ebb = [(a, e, e.BoundingBox()) for a, e in eng]\n998\t    for ang in acilar:\n999\t        k = kapw.rotate(V(*pv), V(*(pv + ek)), -ang); kb = k.BoundingBox()\n1000\t        for a, e, eb in ebb:\n1001\t            if not bbk(kb, eb): continue\n1002\t            v = hacim(k, e)\n1003\t            if v > esik: bul.append((ang, a, round(v, 1)))\n1004\t    return dict(kapak=K.ad, kapak_parcasi=len(kap), engel=len(eng), aci=\"%d–%d°\" % (min(acilar), max(acilar)), pivot_dunya=[round(float(x), 3) for x in pv],\n1005\t                eksen=[float(x) for x in ek], bulgu=bul)\n1006\t\n1007\t\n1008\tdef denetle(g, cerceve=None, mekanizma=(), komsu=(), bilinen=None, acinim_klasoru=None, abkant=True, supurme=True, acilar=tuple(range(10, 101, 10)),\n1009\t            esik=0.5, sup_esik=1.0, don_desen=DON_DESEN, log=print, ayrinti=lambda s: False):\n1010\t    \"\"\"İSTASYON GÖVDESİ DENETİMİ (montajdan önce) · mekanizma / komsu: [(ad, dünya şekli, meta)] (dunya_ciftleri) · bilinen: {(gövde_ad, karşı_ad): gerekçe}\n1011\t    (karşı ad 'B|x' ise '|x' sonu da eşleşir) → R · R['temiz']\"\"\"\n1012\t    cer = cerceve or g.cerceve\n1013\t    T0 = time.time()\n1014\t    R = dict(surum=SURUM, govde=g.surum, birim=g.birim, istasyon=g.istasyon, cerceve=cer.ozet(), standart=S.STD.ozet())\n1015\t    GOV = govde_parcalari(g)\n1016\t    R[\"sac\"], R[\"sac_ozet\"] = denetle_sac(g, acinim_klasoru, abkant, log, ayrinti)\n1017\t    R[\"profil\"], R[\"profil_ozet\"] = denetle_profil(g, log)\n1018\t    gw = [(p[\"ad\"], cer.dunya(_sekil(p)), p.get(\"meta\", {})) for p in GOV]\n1019\t    mw, nw = list(mekanizma), list(komsu)\n1020\t    c_ic = cakisma(gw, gw, esik=esik, ayni=True, izin=ic_ice_izni)\n1021\t    c_mek = cakisma(gw, mw, esik=esik) if mw else []\n1022\t    c_kom = cakisma(gw, nw, esik=esik) if nw else []\n1023\t    bilinen = bilinen or {}\n1024\t\n1025\t    def ayir(L):\n1026\t        iz, kal = [], []\n1027\t        for a, b, v in L:\n1028\t            k = next((n for (x, y), n in bilinen.items() if a == x and (b == y or b.endswith(\"|\" + y) or b == y.split(\"|\")[-1])), None)\n1029\t            (iz if k else kal).append((a, b, v, k) if k else (a, b, v))\n1030\t        return iz, kal\n1031\t    iz_i, kal_i = ayir(c_ic); iz_m, kal_m = ayir(c_mek); iz_n, kal_n = ayir(c_kom)\n1032\t    R[\"cakisma\"] = dict(govde_govde=kal_i, govde_mekanizma=kal_m, govde_komsu=kal_n, izinli_bilinen=iz_i + iz_m + iz_n, izinsiz_toplam=len(kal_i) + len(kal_m) + len(kal_n))\n1033\t    log(\"ÇAKIŞMA: gövde %d · mekanizma %d · komşu %d → gövde↔gövde %d · ↔mekanizma %d · ↔komşu %d · bilinen %d\"\n1034\t        % (len(gw), len(mw), len(nw), len(kal_i), len(kal_m), len(kal_n), len(R[\"cakisma\"][\"izinli_bilinen\"])))\n1035\t    for x in (kal_i + kal_m + kal_n)[:12]: log(\"   ÇAKIŞMA %s\" % (x,))\n1036\t    R[\"arayuz\"], R[\"arayuz_karsi_delik\"] = arayuz_karsi_delik(g, cer, mw + nw + gw)\n1037\t    R[\"karsi_delik\"] = g.KARSI_DELIK\n1038\t    log(\"ARAYÜZ: %d eleman · kestiği parça %d → %s\" % (len(g.ARAYUZ), len(R[\"arayuz_karsi_delik\"]), sorted(R[\"arayuz_karsi_delik\"])[:10]))\n1039\t    R[\"supurme\"] = []\n1040\t    if supurme:\n1041\t        for K in g.KAPAK:\n1042\t            s = kapak_supurme(g, K, gw, mw, nw, cer, acilar, sup_esik, don_desen)\n1043\t            R[\"supurme\"].append(s)\n1044\t            log(\"KAPAK SÜPÜRMESİ %s: %s parça · %s engel · %s\" % (K.ad, s.get(\"kapak_parcasi\"), s.get(\"engel\"), \"TEMİZ\" if not s[\"bulgu\"] else s[\"bulgu\"][:8]))\n1045\t    sup_n = sum(len(s[\"bulgu\"]) for s in R[\"supurme\"])\n1046\t    R[\"ozet\"] = dict(govde_parca=len(GOV), sac=len(g.SAC), profil=len(g.PROF), eleman=len(g.ELEMAN), kaynak=len(g.KAYNAK), arayuz=len(g.ARAYUZ),\n1047\t                     dfm_hata=R[\"sac_ozet\"][\"dfm_hata\"], dfm_uyari=R[\"sac_ozet\"][\"dfm_uyari\"], profil_dfm_hata=R[\"profil_ozet\"][\"dfm_hata\"],\n1048\t                     dogrulama_kalan=len(R[\"sac_ozet\"][\"dogrulama_kalan\"]), cakisma_izinsiz=R[\"cakisma\"][\"izinsiz_toplam\"], supurme=sup_n, sure_sn=round(time.time() - T0, 1))\n1049\t    R[\"temiz\"] = R[\"ozet\"][\"dfm_hata\"] == 0 and R[\"ozet\"][\"profil_dfm_hata\"] == 0 and R[\"ozet\"][\"dogrulama_kalan\"] == 0 and R[\"ozet\"][\"cakisma_izinsiz\"] == 0 and sup_n == 0\n1050\t    R[\"notlar\"] = g.NOT\n1051\t    log(\"DENETİM %s · %s\" % (\"TEMİZ\" if R[\"temiz\"] else \"TEMİZ DEĞİL\", json.dumps(R[\"ozet\"], ensure_ascii=False)))\n1052\t    return R\n1053\t"}]},"uuid":"07d5fcb6-a86d-41e1-bb8e-eb0c7d505f1a","timestamp":"2026-10-03T22:32:44.065Z","sourceToolAssistantUUID":"60aff0c6-a150-4b3a-8569-620170c0befe","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
