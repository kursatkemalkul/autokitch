{"parentUuid":"4830b5b1-71c5-4886-940f-b70f2a01f490","isSidechain":true,"promptId":"97ee8816-e7ae-44b2-b607-1b7fe760c01e","agentId":"afad5ca3c893fe926","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014H5PFKYh9Vx1tGzdfXzf6q","type":"tool_result","content":"475\tclass Kesik:\n476\t    \"\"\"panel yerel (u, v) koordinatında kesik; açınım anlamında: hedef None ise dokunduğu her bölgeyi keser\"\"\"\n477\t    def __init__(self, sahip, yuz, tip, meta=None, dfm=True, hedef=None):\n478\t        self.sahip, self.yuz, self.tip, self.meta, self.dfm, self.hedef = sahip, yuz, tip, dict(meta or {}), dfm, hedef\n479\t\n480\t\n481\tclass Bukum:\n482\t    def __init__(self, **k):\n483\t        self.__dict__.update(k)\n484\t\n485\t    def ozet(self):\n486\t        return dict(no=self.no, ad=self.cocuk.ad, ebeveyn=self.ebeveyn.ad, kenar=self.kenar, aci=round(self.aci, 4),\n487\t                    yon=\"yukari\" if self.yon > 0 else \"asagi\", R=round(self.R, 4), K=round(self.K, 4), BA=round(self.BA, 4),\n488\t                    boy=round(self.b - self.a, 3), duz_flans=round(self.Lf, 3), olcu=self.olcu, olcu_deger=self.boy, tip=self.tip)\n489\t\n490\t\n491\tclass Panel:\n492\t    def __init__(self, sac, no, ad, poly, M, D, ebeveyn=None, bukum=None):\n493\t        self.sac, self.no, self.ad = sac, no, ad\n494\t        self.poly = [(float(p[0]), float(p[1])) for p in poly]\n495\t        self.M, self.D = M, D\n496\t        self.ebeveyn, self.bukum = ebeveyn, bukum\n497\t        self.cocuklar, self.dil_kenar = {}, {}\n498\t        self.kesikler, self.ekler, self.formlar = [], [], []\n499\t\n500\t    def __repr__(self):\n501\t        return \"<Panel %s/%s>\" % (self.sac.ad, self.ad)\n502\t\n503\t    # ---------------- geometri\n504\t    def kenar(self, i):\n505\t        n = len(self.poly); p0 = np.array(self.poly[i % n]); p1 = np.array(self.poly[(i + 1) % n])\n506\t        L = float(np.linalg.norm(p1 - p0)); e2 = (p1 - p0) / L; out2 = np.array([e2[1], -e2[0]])\n507\t        return dict(p0=p0, p1=p1, L=L, e2=e2, out2=out2)\n508\t\n509\t    def dunya(self, u, v, z=0.0):\n510\t        return _p(self.M, (u, v, z))\n511\t\n512\t    def yerel(self, p):\n513\t        return _p(np.linalg.inv(self.M), p)\n514\t\n515\t    def normal(self):\n516\t        return self.M[:3, 2].copy()\n517\t\n518\t    def icerir(self, u, v):\n519\t        x, y, ic = u, v, False; P = self.poly\n520\t        for i in range(len(P)):\n521\t            (x0, y0), (x1, y1) = P[i], P[(i + 1) % len(P)]\n522\t            if (y0 > y) != (y1 > y) and x < (x1 - x0) * (y - y0) / (y1 - y0) + x0: ic = not ic\n523\t        return ic\n524\t\n525\t    # ---------------- bükümler\n526\t    def flans(self, kenar, boy, aci=90.0, yon=+1, R=None, olcu=\"dis\", bas=0.0, son=0.0, uzat_bas=0.0, uzat_son=0.0, rahat=\"otomatik\", ad=None, K=None, tip=\"flans\"):\n527\t        return self.sac._bukum_ekle(self, kenar, boy, aci, yon, R, olcu, bas, son, uzat_bas, uzat_son, rahat, ad, K, tip)\n528\t\n529\t    def kivir(self, kenar, boy=None, tip=\"kapali\", yon=+1, bas=0.0, son=0.0, uzat_bas=0.0, uzat_son=0.0, rahat=\"otomatik\", ad=None):\n530\t        \"\"\"kenar kıvırma (hem) · 180° · iç yarıçap standarttan (iç çap = t) · boy = dönüşün düz boyu\"\"\"\n531\t        R, dmin = STD.hem(self.sac.t, tip)\n532\t        return self.flans(kenar, boy if boy is not None else dmin, 180.0, yon, R=R, olcu=\"duz\", bas=bas, son=son, uzat_bas=uzat_bas,\n533\t                          uzat_son=uzat_son, rahat=rahat, ad=ad or \"%s.kivirma%d\" % (self.ad, kenar), tip=\"kivirma_\" + tip)\n534\t\n535\t    def ofset(self, kenar, yukseklik, boy, aci=90.0, yon=+1, bas=0.0, son=0.0, ad=None):\n536\t        \"\"\"joggle: aci ile çık, yukseklik (alt yüzden alt yüze dik kaçıklık) kadar yüksel, ters aci ile dön, boy kadar devam et\"\"\"\n537\t        t, R, K = self.sac.t, self.sac.R, self.sac.K\n538\t        th = math.radians(aci)\n539\t        # 1. bükümün çocuğunun s = 0'daki alt yüz noktası ve 2. bükümün alt yüz kaçıklığı (sıfır ağ boyuyla) — ebeveyn yerelinde\n540\t        kn = self.kenar(kenar); p0 = np.r_[kn[\"p0\"], 0.0]; e3 = np.r_[kn[\"e2\"], 0.0]; o3 = np.r_[kn[\"out2\"], 0.0]; nz = np.array([0, 0, 1.0])\n541\t        A0, k = (p0 + nz * (t + R), -e3) if yon > 0 else (p0 - nz * R, e3)\n542\t        Rk = _rot(k, th); org = A0 + Rk @ (p0 - A0); ex = Rk @ o3; nn = Rk @ nz\n543\t        A1, k1 = (org - nn * R, e3) if yon > 0 else (org + nn * (t + R), -e3)      # 2. büküm ters yön (−yon)\n544\t        Rk1 = _rot(k1, th); org2 = A1 + Rk1 @ (org - A1)\n545\t        c0 = float(np.dot(org2 - p0, nz)) * (1 if yon > 0 else -1)\n546\t        web = (yukseklik - c0) / math.sin(th)\n547\t        if web < -1e-9: raise ValueError(\"ofset: yükseklik %.2f < en küçük %.2f (iki büküm bitişik)\" % (yukseklik, c0))\n548\t        web = max(web, 0.0)\n549\t        g = self.flans(kenar, web if web > 1e-6 else 1e-3, aci, yon, olcu=\"duz\", bas=bas, son=son, ad=(ad or \"%s.ofset%d\" % (self.ad, kenar)) + \"_ag\", tip=\"ofset\")\n550\t        return g.flans(1, boy, aci, -yon, olcu=\"duz\", ad=(ad or \"%s.ofset%d\" % (self.ad, kenar)), tip=\"ofset\")\n551\t\n552\t    # ---------------- kesikler (panel yerel u, v)\n553\t    def _kesik(self, yuz, tip, meta=None, dfm=True, hedef=None):\n554\t        k = Kesik(self, yuz, tip, meta, dfm, hedef); self.kesikler.append(k); self.sac._gecersiz(); return k\n555\t\n556\t    def delik(self, u, v, cap, tip=\"delik\", **meta):\n557\t        return self._kesik(yuz_daire(u, v, cap / 2.0), tip, dict(meta, sekil=\"daire\", merkez=[u, v], cap=cap))\n558\t\n559\t    def oblong(self, u, v, boy, en, aci=0.0, tip=\"yarik\", **meta):\n560\t        return self._kesik(yuz_oblong(u, v, boy, en, aci), tip, dict(meta, sekil=\"oblong\", merkez=[u, v], boy=boy, en=en, aci=aci))\n561\t\n562\t    def dikdortgen(self, u, v, boy, en, aci=0.0, r=0.0, tip=\"kesik\", dfm=True, **meta):\n563\t        \"\"\"dfm=False: kenara açılan bilinçli çentik (delik–büküm kuralı dışı)\"\"\"\n564\t        return self._kesik(yuz_dikd_r(u, v, boy, en, aci, r), tip, dict(meta, sekil=\"dikdortgen\", merkez=[u, v], boy=boy, en=en, aci=aci, r=r), dfm=dfm)\n565\t\n566\t    def kesik(self, pts, tip=\"kesik\", dfm=True, **meta):\n567\t        return self._kesik(yuz_poligon(pts), tip, dict(meta, sekil=\"poligon\"), dfm=dfm)\n568\t\n569\t    def lazer_yarik_dizisi(self, u0, v0, n_sira, n_sutun, aci=0.0, boy=None, en=None, kopru=None, sira=None):\n570\t        \"\"\"standart havalandırma yarığı: boy × en (uçlar tam R) · aynı sırada köprü, sıralar arası 'sira' (kenardan kenara) · (u0, v0) dizinin merkezi\"\"\"\n571\t        L = STD.lazer_yarik()\n572\t        boy, en, kopru, sira = boy or L[\"boy\"], en or L[\"genislik\"], kopru or L[\"kopru\"], sira or L[\"sira\"]\n573\t        a = math.radians(aci); ux, uy = math.cos(a), math.sin(a); nx, ny = -uy, ux\n574\t        out = []\n575\t        for i in range(n_sira):\n576\t            for j in range(n_sutun):\n577\t                s = (j - (n_sutun - 1) / 2.0) * (boy + kopru); q = (i - (n_sira - 1) / 2.0) * (en + sira)\n578\t                out.append(self.oblong(u0 + ux * s + nx * q, v0 + uy * s + ny * q, boy, en, aci, tip=\"havalandirma_yarigi\"))\n579\t        return out\n580\t\n581\t    def dil(self, kenar, w0, en, boy):\n582\t        \"\"\"geçme dili: kenarın w0 … w0 + en aralığından dışarı boy kadar (açınımda panel konturuna eklenir)\"\"\"\n583\t        if kenar in self.cocuklar: raise ValueError(\"dil: kenar %d bükümlü\" % kenar)\n584\t        kn = self.kenar(kenar); p = lambda w, s: tuple(kn[\"p0\"] + kn[\"e2\"] * w + kn[\"out2\"] * s)\n585\t        yz = yuz_poligon([p(w0, 0.0), p(w0 + en, 0.0), p(w0 + en, boy), p(w0, boy)])\n586\t        d = dict(tip=\"dil\", yuz=yz, kenar=kenar, w0=w0, en=en, boy=boy)\n587\t        self.ekler.append(d); self.dil_kenar.setdefault(kenar, []).append(d); self.sac._gecersiz()\n588\t        return d\n589\t\n590\t    # ---------------- şekiller (form) — 3B'de modellenir, açınımda takım işareti\n591\t    def panjur(self, u, v, boy, en, h=None, aci=0.0, yon=+1, agiz=-1):\n592\t        \"\"\"taret panjuru: boy (yarık boyu) × en (yükselen bölge), h ≤ 3t · agiz: açık tarafın en yönündeki işareti\"\"\"\n593\t        h = STD.panjur_hmax(self.sac.t) if h is None else h\n594\t        d = dict(tip=\"panjur\", u=u, v=v, boy=boy, en=en, h=h, aci=aci, yon=yon, agiz=agiz)\n595\t        self.formlar.append(d); self.sac._gecersiz(); return d\n596\t\n597\t    def kabartma(self, u, v, boy, en, h, r=0.0, egim=20.0, yon=+1):\n598\t        \"\"\"dikdörtgen kabartma (takviye / kabartı): taban boy × en, yükseklik h, yan eğim (dikeyden) egim°\"\"\"\n599\t        d = dict(tip=\"kabartma\", u=u, v=v, boy=boy, en=en, h=h, r=r, egim=egim, yon=yon)\n600\t        self.formlar.append(d); self.sac._gecersiz(); return d\n601\t\n602\t    # ---------------- iç\n603\t    def _ham_yuz(self):\n604\t        f = yuz_poligon(self.poly)\n605\t        if self.ekler: f = _birlestir([f] + [e[\"yuz\"] for e in self.ekler])\n606\t        return f\n607\t\n608\t\n609\tclass Sac:\n610\t    def __init__(self, ad, rol=\"dis\", t=None, R=None, K=None, malzeme=None, mal=\"paslanmaz\", birim=\"SAC\", grup=\"SABIT\", kaynak=None, bolge=\"gida_disi\", adet=1):\n611\t        self.ad, self.rol = ad, rol\n612\t        self.t = float(t) if t is not None else STD.t(rol)\n613\t        self.R = float(R) if R is not None else STD.R(self.t)\n614\t        self.K = float(K) if K is not None else STD.K(self.t)\n615\t        self.malzeme = malzeme or (STD._g(STD.kar, \"malzeme\") or \"AISI 304 (1.4301)\")\n616\t        self.mal, self.birim, self.grup, self.kaynak, self.bolge, self.adet = mal, birim, grup, kaynak or SURUM, bolge, adet\n617\t        self.paneller, self.bukumler, self.kaynaklar, self.puntalar, self.notlar = [], [], [], [], []\n618\t        self._c = {}\n619\t\n620\t    def __repr__(self):\n621\t        return \"<Sac %s t=%g R=%g K=%g · %d panel · %d büküm>\" % (self.ad, self.t, self.R, self.K, len(self.paneller), len(self.bukumler))\n622\t\n623\t    def _gecersiz(self):\n624\t        self._c.clear()\n625\t\n626\t    def panel(self, ad):\n627\t        for p in self.paneller:\n628\t            if p.ad == ad: return p\n629\t        raise KeyError(ad)\n630\t\n631\t    # ---------------- kuruluş\n632\t    def taban(self, poly, O=(0.0, 0.0, 0.0), ex=(1.0, 0.0, 0.0), ey=(0.0, 1.0, 0.0), ad=\"taban\"):\n633\t        if self.paneller: raise ValueError(\"taban yalnız bir kez\")\n634\t        if _alan2(poly) <= 0: raise ValueError(\"taban poligonu CCW olmalı (kenar numaraları buna göre)\")\n635\t        ex = _n(ex); ey = np.asarray(ey, float); ey = _n(ey - np.dot(ey, ex) * ex); n = np.cross(ex, ey)\n636\t        P = Panel(self, 0, ad, poly, _M(np.column_stack([ex, ey, n]), O), np.eye(3))\n637\t        self.paneller.append(P); self._gecersiz()\n638\t        return P\n639\t\n640\t    def _bukum_ekle(self, P, i, boy, aci, yon, R, olcu, bas, son, uz_a, uz_b, rahat, ad, K, tip):\n641\t        n = len(P.poly); i %= n\n642\t        if i in P.cocuklar or i in P.dil_kenar: raise ValueError(\"%s kenar %d dolu\" % (P.ad, i))\n643\t        if P.bukum is not None and i == 3: raise ValueError(\"%s: kenar 3 bükümlü kenar\" % P.ad)\n644\t        if not (0.0 < aci <= 180.0): raise ValueError(\"açı 0–180\")\n645\t        if R is None: R = self.R\n646\t        # dış/iç ölçülü bir flanşın UCUNA yeni büküm gelirse ebeveyn flanşın dış ölçüsü korunur: düz boyu yeni bükümün geri çekmesi kadar kısalır\n647\t        if P.bukum is not None and i == 1 and P.bukum.olcu in (\"dis\", \"ic\"):\n648\t            thn = math.radians(aci)\n649\t            geri = (R + self.t) if aci >= 179.999 else math.tan(thn / 2.0) * ((R + self.t) if P.bukum.olcu == \"dis\" else R)\n650\t            Bp = P.bukum\n651\t            if Bp.Lf - geri <= 1e-6: raise ValueError(\"%s: dış ölçü %.2f iki bükümü taşımıyor\" % (P.ad, Bp.boy))\n652\t            Bp.Lf -= geri; Bp.uc_geri = geri\n653\t            P.poly = [(min(p[0], Bp.Lf), p[1]) for p in P.poly]\n654\t        kn = P.kenar(i); L = kn[\"L\"]; a, b = float(bas), L - float(son)\n655\t        if not (-1e-9 <= a < b <= L + 1e-9): raise ValueError(\"flanş aralığı geçersiz %.2f–%.2f / %.2f\" % (a, b, L))\n656\t        t = self.t; R = float(R); K = self.K if K is None else float(K)\n657\t        th = math.radians(aci); BA = th * (R + K * t)\n658\t        if olcu == \"duz\": Lf = float(boy)\n659\t        elif olcu == \"dis\": Lf = float(boy) - math.tan(th / 2.0) * (R + t)\n660\t        elif olcu == \"ic\": Lf = float(boy) - math.tan(th / 2.0) * R\n661\t        else: raise ValueError(\"olcu: dis / ic / duz\")\n662\t        if aci >= 179.999 and olcu != \"duz\": raise ValueError(\"180° için olcu='duz'\")\n663\t        if Lf <= 1e-6: raise ValueError(\"%s: flanş boyu %.2f büküme yetmiyor (düz kısım %.3f)\" % (ad or P.ad, boy, Lf))\n664\t        p0 = np.r_[kn[\"p0\"], 0.0]; e3 = np.r_[kn[\"e2\"], 0.0]; o3 = np.r_[kn[\"out2\"], 0.0]; nz = np.array([0.0, 0.0, 1.0])\n665\t        if yon > 0: A0, k, rho = p0 + nz * (t + R), -e3, -nz\n666\t        else: A0, k, rho = p0 - nz * R, e3, nz\n667\t        Rk = _rot(k, th); org = A0 + Rk @ (p0 - A0)\n668\t        Lb = _M(np.column_stack([Rk @ o3, e3, Rk @ nz]), org)                                    # çocuk yereli → ebeveyn yereli (bükük)\n669\t        Ld = _M(np.column_stack([o3, e3, nz]), p0 + o3 * BA)                                     # çocuk yereli → ebeveyn yereli (düz)\n670\t        Hs = np.array([[o3[0], e3[0], p0[0]], [o3[1], e3[1], p0[1]], [0.0, 0.0, 1.0]])          # şerit (s, w) → ebeveyn 2B\n671\t        Hc = np.array([[o3[0], e3[0], p0[0] + BA * o3[0]], [o3[1], e3[1], p0[1] + BA * o3[1]], [0.0, 0.0, 1.0]])\n672\t        B = Bukum(no=len(self.bukumler), ebeveyn=P, kenar=i, a=a, b=b, aci=float(aci), th=th, yon=1 if yon > 0 else -1, R=R, K=K, BA=BA, Lf=Lf,\n673\t                  boy=float(boy), olcu=olcu, tip=tip, A0=A0, k=k, rho=rho, e3=e3, o3=o3, p0=p0, Lb=Lb, Ld=Ld, Hs=Hs, uz_a=float(uz_a), uz_b=float(uz_b))\n674\t        poly = [(0.0, a - uz_a), (Lf, a - uz_a), (Lf, b + uz_b), (0.0, b + uz_b)]\n675\t        C = Panel(self, len(self.paneller), ad or \"%s.k%d\" % (P.ad, i), poly, P.M @ Lb, P.D @ Hc, ebeveyn=P, bukum=B)\n676\t        B.cocuk = C\n677\t        P.cocuklar[i] = B; self.paneller.append(C); self.bukumler.append(B)\n678\t        if rahat == \"otomatik\": rahat = \"dikdortgen\"\n679\t        B.rahat = []\n680\t        if rahat in (\"dikdortgen\", \"yuvarlak\"):\n681\t            for uc, w in ((\"bas\", a), (\"son\", b)):\n682\t                if (uc == \"bas\" and a > 1e-6) or (uc == \"son\" and b < L - 1e-6):\n683\t                    self._rahatlatma(B, uc, w, rahat)\n684\t        self._gecersiz()\n685\t        return C\n686\t\n687\t    def _rahatlatma(self, B, uc, w, tip):\n688\t        P = B.ebeveyn; wr, d = STD.relief(self.t)\n689\t        kn = P.kenar(B.kenar); p = lambda ww, s: tuple(kn[\"p0\"] + kn[\"e2\"] * ww + kn[\"out2\"] * s)\n690\t        w0, w1 = (w - wr, w) if uc == \"bas\" else (w, w + wr)\n691\t        if tip == \"yuvarlak\":\n692\t            yz = _birlestir([yuz_poligon([p(w0, -d + wr / 2.0), p(w1, -d + wr / 2.0), p(w1, 0.5), p(w0, 0.5)]),\n693\t                             yuz_daire(*p((w0 + w1) / 2.0, -d + wr / 2.0), wr / 2.0)])\n694\t        else:\n695\t            yz = yuz_poligon([p(w0, -d), p(w1, -d), p(w1, 0.5), p(w0, 0.5)])\n696\t        P._kesik(yz, \"rahatlatma\", dict(bukum=B.no, uc=uc, genislik=wr, derinlik=d, sekil=tip), dfm=False, hedef={(\"P\", P.no)})\n697\t        B.rahat.append(dict(uc=uc, tip=tip, genislik=wr, derinlik=d))\n698\t\n699\t    def kose(self, f1, f2, tip=\"acik\", ustte=None, rahat=\"kare\", kaynak=None, bosluk=None, rahat_boyut=None):\n700\t        \"\"\"aynı panelin komşu iki kenarındaki 90° aynı yönlü flanşların köşesi.\n701\t        tip 'bindirme': ustte (f1/f2) diğerinin ucunu örter: e_üst = R + t − g, e_alt = R − g (g: kaynaklı köşe aralığı) · 'acik': uzatma yok.\n702\t        rahat 'kare': köşede c × c kesik (bükümler köşede c kısalır) · 'yuvarlak': köşe deliği Ø (standart 2t) · None.\n703\t        kaynak: köşe dikişi (bindirmede varsayılan True).\"\"\"\n704\t        B1, B2 = f1.bukum, f2.bukum; P = B1.ebeveyn\n705\t        if B2.ebeveyn is not P: raise ValueError(\"kose: iki flanş aynı panelde olmalı\")\n706\t        n = len(P.poly)\n707\t        if (B1.kenar + 1) % n == B2.kenar: Ba, Bb = B1, B2\n708\t        elif (B2.kenar + 1) % n == B1.kenar: Ba, Bb = B2, B1\n709\t        else: raise ValueError(\"kose: kenarlar komşu değil\")\n710\t        ka, kb = P.kenar(Ba.kenar), P.kenar(Bb.kenar)\n711\t        if abs(np.dot(ka[\"e2\"], kb[\"e2\"])) > 1e-6 or (ka[\"e2\"][0] * kb[\"e2\"][1] - ka[\"e2\"][1] * kb[\"e2\"][0]) <= 0:\n712\t            raise ValueError(\"kose: yalnız 90° dışbükey köşe\")\n713\t        if Ba.b < ka[\"L\"] - 1e-6 or Bb.a > 1e-6: raise ValueError(\"kose: flanşlar köşeye kadar uzanmalı (bas / son = 0)\")\n714\t        if abs(Ba.aci - 90) > 1e-6 or abs(Bb.aci - 90) > 1e-6 or Ba.yon != Bb.yon or abs(Ba.R - Bb.R) > 1e-9:\n715\t            raise ValueError(\"kose: iki flanş 90°, aynı yön, aynı R olmalı\")\n716\t        t, R = self.t, Ba.R\n717\t        if kaynak is None: kaynak = tip == \"bindirme\"\n718\t        g = bosluk if bosluk is not None else STD.kose_bosluk(kaynakli=bool(kaynak))\n719\t        if tip == \"bindirme\":\n720\t            for C in (Ba.cocuk, Bb.cocuk):\n721\t                if C.cocuklar: raise ValueError(\"kose: köşe kapamayı %s alt flanşlarından ÖNCE çağırın\" % C.ad)\n722\t            ust = (ustte or f1).bukum\n723\t            e_ust, e_alt = R + t - g, R - g\n724\t            for Bx, uc in ((Ba, \"son\"), (Bb, \"bas\")):\n725\t                e = e_ust if Bx is ust else e_alt\n726\t                if uc == \"son\": Bx.uz_b = e\n727\t                else: Bx.uz_a = e\n728\t                C = Bx.cocuk; Lf = Bx.Lf\n729\t                C.poly = [(0.0, Bx.a - Bx.uz_a), (Lf, Bx.a - Bx.uz_a), (Lf, Bx.b + Bx.uz_b), (0.0, Bx.b + Bx.uz_b)]\n730\t        elif tip != \"acik\":\n731\t            raise ValueError(\"kose tip: acik / bindirme\")\n732\t        Vtx = kb[\"p0\"]; d1, d2 = -ka[\"e2\"], kb[\"e2\"]\n733\t        q = lambda al, be: tuple(Vtx + d1 * al + d2 * be)\n734\t        hedef = {(\"P\", P.no), (\"B\", Ba.no), (\"B\", Bb.no)}\n735\t        if rahat == \"kare\":\n736\t            c = rahat_boyut if rahat_boyut is not None else max(t, STD.relief(t)[0])\n737\t            yz = yuz_poligon([q(-Bb.BA, -Ba.BA), q(c, -Ba.BA), q(c, c), q(-Bb.BA, c)])\n738\t            P._kesik(yz, \"kose_rahatlatma\", dict(sekil=\"kare\", boyut=c, bukumler=[Ba.no, Bb.no]), dfm=False, hedef=hedef)\n739\t        elif rahat == \"yuvarlak\":\n740\t            c = rahat_boyut if rahat_boyut is not None else STD.kose_deligi(t)\n741\t            P._kesik(yuz_daire(Vtx[0], Vtx[1], c / 2.0), \"kose_rahatlatma\", dict(sekil=\"yuvarlak\", cap=c, bukumler=[Ba.no, Bb.no]), dfm=False, hedef=hedef)\n742\t        elif rahat is not None:\n743\t            raise ValueError(\"rahat: kare / yuvarlak / None\")\n744\t        kayit = dict(tip=tip, bukumler=[Ba.no, Bb.no], bosluk=g if tip == \"bindirme\" else None, rahat=rahat, kaynak=bool(kaynak),\n745\t                     ustte=(ustte or f1).ad if tip == \"bindirme\" else None)\n746\t        Ba.kose_son = kayit; Bb.kose_bas = kayit\n747\t        if kaynak: self.kaynaklar.append(dict(tip=\"kose\", Ba=Ba, Bb=Bb, kayit=kayit))\n748\t        self._gecersiz()\n749\t        return kayit\n750\t\n751\t    def punta(self, diger, noktalar, cap=5.0, not_=\"\"):\n752\t        \"\"\"punta (direnç nokta kaynağı) etiketi — katı yok, meta\"\"\"\n753\t        k = dict(tip=\"punta\", parcalar=[self.ad, diger.ad if hasattr(diger, \"ad\") else str(diger)], cap=cap,\n754\t                 noktalar=[[round(float(c), 2) for c in p] for p in noktalar], adet=len(noktalar), not_=not_)\n755\t        self.puntalar.append(k)\n756\t        return k\n757\t\n758\t    # ---------------- bölgeler (A ve B ortak): son 2B yüzler\n759\t    def _bolgeler(self):\n760\t        if \"bolge\" in self._c: return self._c[\"bolge\"]\n761\t        kes = [k for P in self.paneller for k in P.kesikler]\n762\t        pan, ser = {}, {}\n763\t        for P in self.paneller:\n764\t            F = P._ham_yuz(); bb = F.BoundingBox(); Di = np.linalg.inv(P.D)\n765\t            for k in kes:\n766\t                if k.hedef is not None and (\"P\", P.no) not in k.hedef: continue\n767\t                cf = k.yuz if k.sahip is P else _yuz_tasi(k.yuz, Di @ k.sahip.D)\n768\t                if _bb_kesisir(cf.BoundingBox(), bb): F = F.cut(cf)\n769\t            pan[P.no] = F\n770\t        for B in self.bukumler:\n771\t            S = yuz_dikd(0.0, B.BA, B.a, B.b); bb = S.BoundingBox(); Si = np.linalg.inv(B.ebeveyn.D @ B.Hs)\n772\t            for k in kes:\n773\t                if k.hedef is not None and (\"B\", B.no) not in k.hedef: continue\n774\t                cf = _yuz_tasi(k.yuz, Si @ k.sahip.D)\n775\t                if _bb_kesisir(cf.BoundingBox(), bb): S = S.cut(cf)\n776\t            ser[B.no] = S\n777\t        self._c[\"bolge\"] = (pan, ser)\n778\t        return pan, ser\n779\t\n780\t    def _yerel_katilar(self):\n781\t        \"\"\"panel prizmaları (panel yerelinde) + büküm dilimleri (ebeveyn yerelinde)\"\"\"\n782\t        if \"yk\" in self._c: return self._c[\"yk\"]\n783\t        pan, ser = self._bolgeler(); t = self.t\n784\t        pk = {no: (_prizma(F, t) if _alan(F) > 1e-9 else None) for no, F in pan.items()}\n785\t        sk = {}\n786\t        for B in self.bukumler:\n787\t            sk[B.no] = [_sektor(B.A0, B.k, B.rho, B.e3, w0, w1, B.R, B.R + t, B.th * s0 / B.BA, B.th * (s1 - s0) / B.BA)\n788\t                        for s0, s1, w0, w1 in _dikd_ayir(ser[B.no], B.BA) if s1 - s0 > 1e-9]\n789\t        self._c[\"yk\"] = (pk, sk)\n790\t        return pk, sk\n791\t\n792\t    def _bolge_katilari(self):\n793\t        \"\"\"dünyada her bölgenin ayrı katısı: [(etiket, katı)]\"\"\"\n794\t        pk, sk = self._yerel_katilar(); out = []\n795\t        for P in self.paneller:\n796\t            if pk[P.no] is not None: out.append(((\"P\", P.no), _tasi(pk[P.no], P.M)))\n797\t        for B in self.bukumler:\n798\t            for s in sk[B.no]: out.append(((\"B\", B.no), _tasi(s, B.ebeveyn.M)))\n799\t        return out\n800\t\n801\t    def kati_temel(self):\n802\t        \"\"\"3B katı (şekil/form özellikleri hariç) — açınım doğrulaması bununla yapılır\"\"\"\n803\t        if \"temel\" not in self._c:\n804\t            self._c[\"temel\"] = _birlestir([s for _e, s in self._bolge_katilari()])\n805\t        return self._c[\"temel\"]\n806\t\n807\t    def kati(self):\n808\t        \"\"\"3B katı (panjur / kabartma dahil)\"\"\"\n809\t        if \"kati\" in self._c: return self._c[\"kati\"]\n810\t        sh = self.kati_temel()\n811\t        for P in self.paneller:\n812\t            for fm in P.formlar:\n813\t                ekle, cikar = _form_araclari(fm, self.t)\n814\t                if cikar is not None: sh = sh.cut(_tasi(cikar, P.M))\n815\t                if ekle is not None: sh = sh.fuse(_tasi(ekle, P.M))\n816\t                if fm[\"tip\"] == \"kabartma\" and fm.get(\"_ic\") is not None: pass\n817\t        sh = sh.clean()\n818\t        self._c[\"kati\"] = sh\n819\t        return sh\n820\t\n821\t    # ---------------- açınım (B)\n822\t    def _duz_yuz(self):\n823\t        if \"duz\" in self._c: return self._c[\"duz\"]\n824\t        pan, ser = self._bolgeler()\n825\t        yz = [_yuz_tasi(F, P.D) for P in self.paneller for F in [pan[P.no]] if _alan(F) > 1e-9]\n826\t        yz += [_yuz_tasi(ser[B.no], B.ebeveyn.D @ B.Hs) for B in self.bukumler if _alan(ser[B.no]) > 1e-9]\n827\t        F = _birlestir(yz)\n828\t        self._c[\"duz\"] = F\n829\t        return F\n830\t\n831\t    def acinim(self):\n832\t        \"\"\"AÇINIM (flat pattern) — JSON'a hazır sözlük. Koordinat: kök panelin yereli (Z = t üst yüz). DXF'e birebir aktarılabilir.\"\"\"\n833\t        if \"acinim\" in self._c: return self._c[\"acinim\"]\n834\t        F = self._duz_yuz(); yuzler = F.Faces()\n835\t        dis, ic = [], []\n836\t        for f in yuzler:\n837\t            dis.append(_tel_varliklari(f.outerWire(), f))\n838\t            for w in f.innerWires(): ic.append(_tel_varliklari(w, f))\n839\t        bk = []\n840\t        pan, ser = self._bolgeler()\n841\t        for B in self.bukumler:\n842\t            S = B.ebeveyn.D @ B.Hs\n843\t            T0 = [_Hp(S, (0.0, B.a)), _Hp(S, (0.0, B.b))]; T1 = [_Hp(S, (B.BA, B.a)), _Hp(S, (B.BA, B.b))]\n844\t            Cz = [_Hp(S, (B.BA / 2.0, B.a)), _Hp(S, (B.BA / 2.0, B.b))]\n845\t            ws = [g.BoundingBox() for g in ser[B.no].Faces()]\n846\t            gercek = [min(w.ymin for w in ws), max(w.ymax for w in ws)] if ws else [B.a, B.b]\n847\t            bk.append(dict(no=B.no + 1, ad=B.cocuk.ad, aci=round(B.aci, 4), yon=\"yukari\" if B.yon > 0 else \"asagi\", R=round(B.R, 4), K=round(B.K, 4),\n848\t                           BA=round(B.BA, 5), tip=B.tip, t=self.t, V_kalip=STD.V(self.t),\n849\t                           cizgi=[[round(c, 5) for c in p] for p in Cz], baslangic=[[round(c, 5) for c in p] for p in T0],\n850\t                           bitis=[[round(c, 5) for c in p] for p in T1], nominal_boy=round(B.b - B.a, 4),\n851\t                           gercek_aralik=[round(gercek[0], 4), round(gercek[1], 4)], gercek_boy=round(gercek[1] - gercek[0], 4)))\n852\t        pts = [p for kontur in dis for e in kontur for p in _varlik_noktalari(e)]\n853\t        L, W, aci = _min_dikdortgen(pts)\n854\t        alan = _alan(F)\n855\t        sabit = _ic_nokta(_yuz_tasi(pan[0], self.paneller[0].D)) if _alan(pan[0]) > 1e-9 else None\n856\t        kes = []\n857\t        for P in self.paneller:\n858\t            for k in P.kesikler:\n859\t                c = k.meta.get(\"merkez\")\n860\t                kes.append(dict(panel=P.ad, tip=k.tip, sekil=k.meta.get(\"sekil\"), merkez_duz=[round(x, 4) for x in _Hp(P.D, c)] if c else None,\n861\t                                **{kk: vv for kk, vv in k.meta.items() if kk in (\"cap\", \"boy\", \"en\", \"aci\", \"parca\", \"std\", \"uc\", \"genislik\", \"derinlik\", \"boyut\")}))\n862\t        fm = []\n863\t        for P in self.paneller:\n864\t            for f in P.formlar:\n865\t                c = _Hp(P.D, (f[\"u\"], f[\"v\"])); a = math.degrees(math.atan2(P.D[1, 0], P.D[0, 0])) + f.get(\"aci\", 0.0)\n866\t                fm.append(dict(panel=P.ad, tip=f[\"tip\"], merkez=[round(c[0], 4), round(c[1], 4)], aci=round(a, 4), boy=f[\"boy\"], en=f[\"en\"], h=f[\"h\"],\n867\t                               yon=\"yukari\" if f[\"yon\"] > 0 else \"asagi\", not_=\"taret/form takımı · lazer kesmez\" if f[\"tip\"] == \"panjur\" else \"kabartma kalıbı\"))\n868\t        a = dict(parca=self.ad, surum=SURUM, malzeme=self.malzeme, t=self.t, R=self.R, K=self.K, adet=self.adet,\n869\t                 birim=\"mm\", ust_yuz=\"Z = t yüzü = kök panelin +n yüzü (bütün panellerin yerel z = t yüzü)\",\n870\t                 dis_kontur=dis[0] if len(dis) == 1 else dis, ek_dis_konturlar=dis[1:] if len(dis) > 1 else [],\n871\t                 ic_konturlar=ic, bukumler=bk, formlar=fm, kesikler=kes, parca_sayisi=len(yuzler),\n872\t                 levha=dict(boy=round(float(max(L, W)), 3), en=round(float(min(L, W)), 3), aci=round(float(aci), 4), alan_mm2=round(alan, 2),\n873\t                            kutle_kg=round(alan * self.t * YOGUNLUK, 4)),\n874\t                 sabit_yuz=[round(sabit[0], 5), round(sabit[1], 5)] if sabit else None,\n875\t                 donusum_3b=[[round(float(x), 9) for x in r] for r in self.paneller[0].M])\n876\t        self._c[\"acinim\"] = a\n877\t        return a\n878\t\n879\t    # ---------------- doğrulama\n880\t    def dogrula(self, kesit=True):\n881\t        \"\"\"açınımdan yeniden bükülen katı ↔ 3B · kalınlık · kesit yarıçapları\"\"\"\n882\t        if \"dogrula\" in self._c: return self._c[\"dogrula\"]\n883\t        A = self.kati_temel(); vA = A.Volume(); acn = self.acinim()\n884\t        r = dict(parca=self.ad, V_3b=round(vA, 3), kati_sayisi=len(A.Solids()), gecerli=A.isValid())\n885\t        try:\n886\t            C, rap = acinimdan_kati(json.loads(json.dumps(acn)))\n887\t            vC = C.Volume(); r.update(V_acinimdan=round(vC, 3), hacim_farki_yuzde=round(100.0 * abs(vA - vC) / vA, 5), yeniden_bukum=rap)\n888\t            try:\n889\t                d = A.cut(C).Volume() + C.cut(A).Volume()\n890\t                r[\"simetrik_fark_yuzde\"] = round(100.0 * d / vA, 5)\n891\t            except Exception as e:\n892\t                r[\"simetrik_fark_yuzde\"] = None; r[\"simetrik_hata\"] = str(e)[:120]\n893\t            r[\"acinim_gecti\"] = r[\"hacim_farki_yuzde\"] < 0.5 and (r.get(\"simetrik_fark_yuzde\") is None or r[\"simetrik_fark_yuzde\"] < 0.5)\n894\t        except Exception as e:\n895\t            r.update(acinim_gecti=False, yeniden_bukum_hatasi=repr(e)[:300])\n896\t        Vd = acn[\"levha\"][\"alan_mm2\"] * self.t\n897\t        r[\"V_duz_alanxt\"] = round(Vd, 3); r[\"duz_3b_fark_yuzde\"] = round(100.0 * (Vd - vA) / vA, 5)\n898\t        bek = sum(B.th * self.t * self.t * (B.K - 0.5) * (B.b - B.a) for B in self.bukumler)     # nötr eksen (R + Kt) ↔ orta yüzey (R + t/2)\n899\t        r[\"duz_3b_beklenen_fark_yuzde\"] = round(100.0 * bek / vA, 5)\n900\t        r[\"kalinlik\"] = kalinlik_denetle(A, self.t)\n901\t        if kesit:\n902\t            ks = []\n903\t            for B in self.bukumler:\n904\t                pan, ser = self._bolgeler()\n905\t                fs = ser[B.no].Faces()\n906\t                if not fs: continue\n907\t                bb = max(fs, key=lambda f: f.Area()).BoundingBox(); wm = (bb.ymin + bb.ymax) / 2.0\n908\t                Pw = _p(B.ebeveyn.M, B.A0 + B.e3 * wm); kw = B.ebeveyn.M[:3, :3] @ B.e3\n909\t                yr = kesit_yaricaplari(A, Pw, kw, eksen=Pw, tol=1e-3)\n910\t                bek = sorted({round(B.R, 3), round(B.R + self.t, 3)}) if B.R > 1e-3 else [round(self.t, 3)]\n911\t                ks.append(dict(bukum=B.no + 1, bulunan=sorted(set(round(x, 3) for x in yr)), beklenen=bek,\n912\t                               gecti=all(any(abs(x - y) < 1e-3 for x in yr) for y in bek)))\n913\t            r[\"kesit\"] = ks; r[\"kesit_gecti\"] = all(k[\"gecti\"] for k in ks)\n914\t        self._c[\"dogrula\"] = r\n915\t        return r\n916\t\n917\t    # ---------------- DFM\n918\t    def dfm(self, abkant=True):\n919\t        if (\"dfm\", abkant) in self._c: return self._c[(\"dfm\", abkant)]\n920\t        out = dfm_denetle(self, abkant=abkant)\n921\t        self._c[(\"dfm\", abkant)] = out\n922\t        return out\n923\t\n924\t    # ---------------- montaj uyumu\n925\t    def meta(self, dfm_ozet=True):\n926\t        a = self.acinim()\n927\t        m = dict(tur=\"sac\", surum=SURUM, malzeme=self.malzeme, rol=self.rol, t=self.t, R=self.R, K=self.K, adet=self.adet,\n928\t                 bukum_sayisi=len(self.bukumler), bukumler=[B.ozet() for B in self.bukumler],\n929\t                 acinim=dict(boy=a[\"levha\"][\"boy\"], en=a[\"levha\"][\"en\"], alan_mm2=a[\"levha\"][\"alan_mm2\"], kutle_kg=a[\"levha\"][\"kutle_kg\"],\n930\t                             delik=len(a[\"ic_konturlar\"]), dosya=\"%s_acinim.json\" % self.ad),\n931\t                 kose=[dict(B.kose_son, bukum=B.no + 1) for B in self.bukumler if hasattr(B, \"kose_son\")],\n932\t                 punta=sum(p[\"adet\"] for p in self.puntalar), kaynak=len(self.kaynaklar))\n933\t        if dfm_ozet and (\"dfm\", True) in self._c:\n934\t            d = self._c[(\"dfm\", True)]\n935\t            m[\"dfm\"] = dict(hata=sum(1 for x in d if x[\"durum\"] == \"HATA\"), uyari=sum(1 for x in d if x[\"durum\"] == \"UYARI\"))\n936\t        return m\n937\t\n938\t    def parca(self):\n939\t        sh = self.kati(); bb = sh.BoundingBox(); a = self.acinim()\n940\t        return dict(ad=self.ad, wp=cq.Workplane(\"XY\").add(sh), sh=sh, mal=self.mal, birim=self.birim, grup=self.grup, kaynak=self.kaynak, tur=\"sac\",\n941\t                    bom=(\"Sac %s · AISI 304 t %g · %d büküm (R %g, K %g) · açınım %.0f × %.0f\" % (self.ad, self.t, len(self.bukumler), self.R, self.K,\n942\t                                                                                             a[\"levha\"][\"boy\"], a[\"levha\"][\"en\"]),\n943\t                         self.adet, \"%.1f × %.1f × %.1f\" % (bb.xlen, bb.ylen, bb.zlen),\n944\t                         \"lazer + abkant%s · %.2f kg\" % (\" + TIG\" if self.kaynaklar else \"\", a[\"levha\"][\"kutle_kg\"]), \"ÜRETİM\"),\n945\t                    sac=self.meta())\n946\t\n947\t    def parcalar(self):\n948\t        \"\"\"sac + kaynak dikişleri (ayrı katılar, sac ile yüz teması)\"\"\"\n949\t        return [self.parca()] + kaynak_parcalari(self)\n950\t\n951\t\n952\t# =====================================================================================================================================\n953\t# 4 · FORM (panjur / kabartma) araçları — panel yerelinde\n954\t# =====================================================================================================================================\n955\tdef _form_araclari(fm, t):\n956\t    \"\"\"(eklenecek, çıkarılacak) katı — panel yerelinde\"\"\"\n957\t    a = math.radians(fm.get(\"aci\", 0.0)); ux, uy = math.cos(a), math.sin(a); nx, ny = -uy, ux\n958\t    u0, v0, yon = fm[\"u\"], fm[\"v\"], fm[\"yon\"]\n959\t    if fm[\"tip\"] == \"panjur\":\n960\t        L, W, h, ag = fm[\"boy\"], fm[\"en\"], fm[\"h\"], fm.get(\"agiz\", -1)\n961\t        # yerel (s: boy yönü, q: en yönü, z): kapalı taraf q = −ag·W/2, açık taraf q = +ag·W/2\n962\t        def P(s, q, z):\n963\t            qq = q * ag\n964\t            return (u0 + ux * s + nx * qq, v0 + uy * s + ny * qq, z if yon > 0 else t - z)"}]},"uuid":"0a114864-6b70-47b0-ba25-348750690ec9","timestamp":"2026-10-03T22:32:30.417Z","sourceToolAssistantUUID":"4830b5b1-71c5-4886-940f-b70f2a01f490","userType":"external","entrypoint":