{"parentUuid":"8b97c327-6175-4cf5-aaf9-2e69ec20154a","isSidechain":true,"promptId":"97ee8816-e7ae-44b2-b607-1b7fe760c01e","agentId":"afad5ca3c893fe926","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TPy3j34r9bBGvHiCPwcxGi","type":"tool_result","content":"80\t    \"\"\"'6t' · 't' · 't/4' · 3.5 → sayı (t yerine konur)\"\"\"\n81\t    if x is None: return None\n82\t    if isinstance(x, (int, float)): return float(x)\n83\t    s = str(x).strip().replace(\",\", \".\").replace(\" \", \"\")\n84\t    if not re.fullmatch(r\"[0-9t\\.\\*/\\+\\-\\(\\)]+\", s): return None\n85\t    s = re.sub(r\"(\\d)t\", r\"\\1*t\", s)\n86\t    try:\n87\t        return float(eval(s, {\"__builtins__\": {}}, {\"t\": t}))\n88\t    except Exception:\n89\t        return None\n90\t\n91\t\n92\tclass Standart:\n93\t    \"\"\"sac_kararlar_v1.json > sac_standart_v1.json > varsayılan. Her okunan değer kaynağıyla .kullanilan'a yazılır.\"\"\"\n94\t    ROL = {\"dis\": ((\"kabuk_dis_t\",), (\"kalinlik\", \"ana_sac\"), 1.2), \"ic\": ((\"ic_panel_t\",), (\"kalinlik\", \"ana_sac\"), 1.0),\n95\t           \"yuk\": ((\"raf_tabla_t\",), (\"kalinlik\", \"yuk_saci\"), 1.5), \"kapak_dis\": ((\"kapak_dis_t\",), (\"kapak\", \"dis_tava_t\"), 1.2),\n96\t           \"kapak_ic\": ((\"kapak_ic_tava_t\",), (\"kapak\", \"ic_tava_t\"), 1.0), \"braket\": ((\"braket_t\",), (\"kalinlik\", \"braket\"), 3.0)}\n97\t    ROL_ES = {\"taban\": \"yuk\", \"raf\": \"yuk\", \"tabla\": \"yuk\", \"kabuk\": \"dis\", \"tava_ic\": \"kapak_ic\"}\n98\t\n99\t    def __init__(self, klasor=None):\n100\t        self.klasor = klasor or _STD_KLASOR\n101\t        self.std, self.kar, self.dosyalar, self.kullanilan = {}, {}, [], {}\n102\t        for ad, hedef in ((\"sac_standart_v1.json\", \"std\"), (\"sac_kararlar_v1.json\", \"kar\")):\n103\t            yol = os.path.join(self.klasor, ad)\n104\t            if os.path.exists(yol):\n105\t                with open(yol, encoding=\"utf-8\") as f:\n106\t                    setattr(self, hedef, json.load(f))\n107\t                self.dosyalar.append(yol)\n108\t\n109\t    def _yaz(self, ad, deger, kaynak):\n110\t        self.kullanilan[ad] = (deger, kaynak)\n111\t        return deger\n112\t\n113\t    @staticmethod\n114\t    def _g(d, *yol):\n115\t        for k in yol:\n116\t            if not isinstance(d, dict) or k not in d: return None\n117\t            d = d[k]\n118\t        return d\n119\t\n120\t    def _satir(self, t):\n121\t        tab = self.std.get(\"bukum\") or {}\n122\t        if not tab: return None, None\n123\t        k, v = min(tab.items(), key=lambda kv: abs(float(kv[0]) - t))\n124\t        return (v, \"standart.bukum[%s]\" % k) if abs(float(k) - t) < 0.011 else (None, None)\n125\t\n126\t    def t(self, rol):\n127\t        rol = self.ROL_ES.get(rol, rol)\n128\t        kk, sk, vv = self.ROL[rol]\n129\t        v = self._g(self.kar, *kk)\n130\t        if v is not None: return self._yaz(\"t_\" + rol, float(v), \"kararlar.\" + \".\".join(kk))\n131\t        v = self._g(self.std, *sk)\n132\t        if v is not None: return self._yaz(\"t_\" + rol, float(v), \"standart.\" + \".\".join(sk))\n133\t        return self._yaz(\"t_\" + rol, vv, \"varsayilan\")\n134\t\n135\t    def R(self, t):\n136\t        c = self._g(self.kar, \"ic_radyus_carpan\")\n137\t        if c is not None: return self._yaz(\"R(%g)\" % t, round(float(c) * t, 4), \"kararlar.ic_radyus_carpan\")\n138\t        s, k = self._satir(t)\n139\t        if s and s.get(\"R_ic_model\") is not None: return self._yaz(\"R(%g)\" % t, float(s[\"R_ic_model\"]), k)\n140\t        return self._yaz(\"R(%g)\" % t, 1.0 * t, \"varsayilan R = t\")\n141\t\n142\t    def K(self, t):\n143\t        s, k = self._satir(t)\n144\t        if s and s.get(\"K\") is not None: return self._yaz(\"K(%g)\" % t, float(s[\"K\"]), k + \" (BD tablosu)\")\n145\t        v = self._g(self.kar, \"K\")\n146\t        if v is not None: return self._yaz(\"K(%g)\" % t, float(v), \"kararlar.K\")\n147\t        return self._yaz(\"K(%g)\" % t, 0.40, \"varsayilan\")\n148\t\n149\t    def V(self, t):\n150\t        s, k = self._satir(t)\n151\t        if s and s.get(\"V_kalip\"): return float(s[\"V_kalip\"])\n152\t        return float(max(4, 2 * round(4 * t)))\n153\t\n154\t    def min_flans(self, t):\n155\t        \"\"\"(mutlak, tasarim) dış ölçü\"\"\"\n156\t        s, k = self._satir(t)\n157\t        if s and s.get(\"min_flans_mutlak\") is not None:\n158\t            return self._yaz(\"min_flans(%g)\" % t, (float(s[\"min_flans_mutlak\"]), float(s[\"min_flans_tasarim\"])), k)\n159\t        return self._yaz(\"min_flans(%g)\" % t, (4.0 * t, 6.0 * t), \"varsayilan 4t / 6t\")\n160\t\n161\t    def relief(self, t):\n162\t        \"\"\"(genişlik, derinlik) — derinlik büküm teğet çizgisinden ebeveyne doğru\"\"\"\n163\t        s, k = self._satir(t)\n164\t        if s and s.get(\"relief_genislik\") is not None:\n165\t            return self._yaz(\"relief(%g)\" % t, (float(s[\"relief_genislik\"]), float(s[\"relief_derinlik\"])), k)\n166\t        return self._yaz(\"relief(%g)\" % t, (t, self.R(t) + t), \"varsayilan t × (R + t)\")\n167\t\n168\t    def mesafe(self, ad, t):\n169\t        \"\"\"delik_flans · yarik_flans · panjur_flans (flanş İÇ yüzünden) · delik_kenar · delik_kopru · min_delik\"\"\"\n170\t        R = self.R(t)\n171\t        anahtar = {\"delik_flans\": \"delik_flans_ic_yuz\", \"yarik_flans\": \"uzun_yarik_flans_ic_yuz\", \"panjur_flans\": \"panjur_flans_ic_yuz\",\n172\t                   \"delik_kenar\": \"delik_sac_kenari\", \"delik_kopru\": \"delik_kopru\", \"min_delik\": \"min_delik_cap\"}[ad]\n173\t        s, k = self._satir(t)\n174\t        if s and s.get(anahtar) is not None: return self._yaz(\"%s(%g)\" % (ad, t), float(s[anahtar]), k)\n175\t        vv = {\"delik_flans\": 2 * t + R, \"yarik_flans\": 4 * t + R, \"panjur_flans\": 3 * t + 2 * R, \"delik_kenar\": 2 * t, \"delik_kopru\": 2 * t,\n176\t              \"min_delik\": t}[ad]\n177\t        return self._yaz(\"%s(%g)\" % (ad, t), vv, \"varsayilan\")\n178\t\n179\t    def kose_bosluk(self, kaynakli=True):\n180\t        if kaynakli:\n181\t            a = self._g(self.std, \"kose\", \"flans_ucu_araligi_kaynakli\")\n182\t            if a: return self._yaz(\"kose_bosluk_kaynakli\", round(sum(a) / len(a), 3), \"standart.kose.flans_ucu_araligi_kaynakli (orta)\")\n183\t            return self._yaz(\"kose_bosluk_kaynakli\", 0.2, \"varsayilan\")\n184\t        a = self._g(self.std, \"kose\", \"kaynaksiz_flans_bosluk_min\")\n185\t        return self._yaz(\"kose_bosluk_kaynaksiz\", float(a) if a is not None else 0.4, \"standart.kose\" if a is not None else \"varsayilan\")\n186\t\n187\t    def kose_deligi(self, t):\n188\t        a = self._g(self.std, \"kose\", \"gizli\")\n189\t        m = re.search(r\"O\\s*=\\s*([0-9.]*)t\", a or \"\")\n190\t        c = float(m.group(1) or 1.0) if m else 2.0\n191\t        return self._yaz(\"kose_deligi(%g)\" % t, c * t, \"standart.kose.gizli\" if m else \"varsayilan 2t\")\n192\t\n193\t    def hem(self, t, tip=\"kapali\"):\n194\t        \"\"\"(R_ic, min_donus)\"\"\"\n195\t        d = self._g(self.std, \"kenar\", tip + \"_hem\")\n196\t        if d:\n197\t            ic = _ifade(d.get(\"ic_cap\"), t); dn = _ifade(d.get(\"donus\"), t)\n198\t            return self._yaz(\"hem_%s(%g)\" % (tip, t), (ic / 2.0, dn), \"standart.kenar.%s_hem\" % tip)\n199\t        return self._yaz(\"hem_%s(%g)\" % (tip, t), (0.5 * t, (6.0 if tip == \"kapali\" else 4.0) * t), \"varsayilan\")\n200\t\n201\t    def derz(self):\n202\t        v = self._g(self.std, \"kapak\", \"derz\")\n203\t        return self._yaz(\"derz\", float(v) if v is not None else 2.0, \"standart.kapak.derz\" if v is not None else \"varsayilan\")\n204\t\n205\t    def montaj_boslugu(self):\n206\t        v = self._g(self.std, \"kapak\", \"ic_dis_bosluk\")\n207\t        return self._yaz(\"montaj_boslugu\", float(v) if v is not None else 0.5, \"standart.kapak.ic_dis_bosluk\" if v is not None else \"varsayilan\")\n208\t\n209\t    def max_acinim(self):\n210\t        v = self._g(self.std, \"malzeme\", \"max_acinim\")\n211\t        return self._yaz(\"max_acinim\", tuple(sorted(float(x) for x in v)) if v else (1500.0, 3000.0), \"standart.malzeme\" if v else \"varsayilan\")\n212\t\n213\t    def abkant_boy(self):\n214\t        v = self._g(self.std, \"malzeme\", \"abkant_max_boy\")\n215\t        return float(v) if v else 3100.0\n216\t\n217\t    def pem_yasak(self):\n218\t        v = self._g(self.std, \"baglanti\", \"sac_gizli_secenek_A_PEM\", \"yasak\")\n219\t        return v if v else [\"PEM CLS (HRB 70 sınırı, 304 sacta tutmaz)\"]\n220\t\n221\t    def pem_delik(self, tur, dis):\n222\t        \"\"\"standarttan PEM delik çapı (SP somun / FHP saplama) ya da None\"\"\"\n223\t        A = self._g(self.std, \"baglanti\", \"sac_gizli_secenek_A_PEM\") or {}\n224\t        D = self._g(self.std, \"baglanti\", \"pem_diger\") or {}\n225\t        if tur == \"SP\":\n226\t            if (A.get(\"somun\") or {}).get(\"dis\") == dis: return A[\"somun\"].get(\"delik\"), A[\"somun\"].get(\"kenar_eksen_min\")\n227\t            r = D.get(\"SP-%s-1\" % dis) or {}\n228\t            return r.get(\"delik\"), r.get(\"kenar_eksen_min\")\n229\t        if tur in (\"FHP\", \"FH4\", \"FHS\", \"FH\"):\n230\t            if (A.get(\"saplama\") or {}).get(\"dis\") == dis: return A[\"saplama\"].get(\"delik\"), A[\"saplama\"].get(\"kenar_eksen_min\")\n231\t            r = D.get(\"FHP-%s\" % dis) or {}\n232\t            return r.get(\"delik\"), r.get(\"kenar_eksen_min\")\n233\t        return None, None\n234\t\n235\t    def percin_somun(self, dis):\n236\t        v = self._g(self.std, \"baglanti\", \"percin_somun\", dis)\n237\t        return v or {}\n238\t\n239\t    def delik_iso273(self, dis, seri=\"orta\"):\n240\t        v = self._g(self.std, \"baglanti\", \"delik_iso273_\" + seri, dis)\n241\t        if v is not None: return float(v)\n242\t        return {\"M3\": 3.4, \"M4\": 4.5, \"M5\": 5.5, \"M6\": 6.6, \"M8\": 9.0, \"M10\": 11.0, \"M12\": 13.5}[dis]\n243\t\n244\t    def gida_R_min(self):\n245\t        v = self._g(self.std, \"kose\", \"urun_bolgesi_ic_R_min\")\n246\t        return float(v) if v is not None else 3.0\n247\t\n248\t    def lazer_yarik(self):\n249\t        v = self._g(self.std, \"havalandirma\", \"lazer_yarik\") or {}\n250\t        return dict(genislik=float(v.get(\"genislik\", 5)), boy=float(v.get(\"boy\", 60)), uc_R=float(v.get(\"uc_R\", 2.5)),\n251\t                    kopru=float(v.get(\"kopru_min\", 5)), sira=float(v.get(\"sira_araligi_min\", 10)), kenar=float(v.get(\"kenar_min\", 10)))\n252\t\n253\t    def panjur_hmax(self, t):\n254\t        v = self._g(self.std, \"havalandirma\", \"panjur_taret\", \"H_max\")\n255\t        return _ifade(v, t) if v is not None else 3 * t\n256\t\n257\t    def kapak(self):\n258\t        k = self._g(self.std, \"kapak\") or {}\n259\t        return dict(dis_donus=float(k.get(\"dis_tava_donus\", 20)), ic_donus=float(k.get(\"ic_tava_donus\", 15)),\n260\t                    ic_dis_bosluk=float(k.get(\"ic_dis_bosluk\", 0.5)), kulp_cep=k.get(\"kulp\", {}).get(\"cep_derinlik\", [25, 30]) if isinstance(k.get(\"kulp\"), dict) else [25, 30],\n261\t                    derz=self.derz())\n262\t\n263\t    def ozet(self):\n264\t        return dict(dosyalar=self.dosyalar, kullanilan={k: dict(deger=v[0], kaynak=v[1]) for k, v in sorted(self.kullanilan.items())})\n265\t\n266\t\n267\tSTD = Standart()\n268\t\n269\t\n270\tdef standart_yukle(klasor=None):\n271\t    \"\"\"sac_standart_v1.json + sac_kararlar_v1.json yeniden okunur (yeni Sac nesneleri yeni değerleri kullanır)\"\"\"\n272\t    global STD\n273\t    STD = Standart(klasor)\n274\t    return STD\n275\t\n276\t\n277\t# =====================================================================================================================================\n278\t# 2 · GEOMETRİ ARAÇLARI\n279\t# ====================================================================================================================================="}]},"uuid":"40e523f0-4979-485b-b64b-79278c5baa4a","timestamp":"2026-10-03T22:32:29.083Z","sourceToolAssistantUUID":"8b97c327-6175-4cf5-aaf9-2e69ec20154a","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
