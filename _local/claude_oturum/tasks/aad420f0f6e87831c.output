ile tek çizgi)\"\"\"\n231-    y = KARAR[\"B_SAG_CIZGI\"]; dy = (y + 1.0) - 448.0               # 456 − 448 = +8\n232-    sp = bul(SC_L, \"tk_kapak_sogutma_dis_sac\"); bs = sekil(sp).BoundingBox(); bb_kontrol(sp, (4012.0, 4400.0, 126.0, 446.0), 1.5)\n233-    s = sekil(sp).cut(kutu(bs.xmin - 1, bs.xmax + 1, bs.ymax - T - 0.2, bs.ymax + 1, bs.zmin - 1, Z_ON - T))      # eski üst dönüş\n234-    s = _bir(s, kutu(bs.xmin, bs.xmax, bs.ymax - 1.0, y - 1.0, Z_ON - T, Z_ON), kutu(bs.xmin, bs.xmax, y - 1.0 - T, y - 1.0, bs.zmin, Z_ON - T))\n235-    koy(sp, s); rapor.append(\"tk_kapak_sogutma_dis_sac 126–%.0f\" % (y - 1.0))\n236-    dp = bul(SC_L, \"tk_kapak_depo_dis_sac_1.5\"); bd = sekil(dp).BoundingBox()\n237-    s = sekil(dp).cut(kutu(bd.xmin - 1, bd.xmax + 1, bd.ymin - 1, y + 1.0 + T, bd.zmin - 1, bd.zmax + 1))","is_error":false}]},"uuid":"873dcd79-0654-44e9-ab95-0d6ea3a1c886","timestamp":"2026-10-01T23:42:13.903Z","sourceToolAssistantUUID":"6dd053f7-0b7e-4b49-a9db-9e29f743c817","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
