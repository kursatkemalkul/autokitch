\"][0], AGIZ[\"y\"][1], -200.0, Z_ON + 50.0)\n518:    kontrol(\"ROBOT AĞZI x %.0f–%.0f · y %.0f–%.0f (%.0f × %.0f) temiz: kabin parçası girmez (z −200…+129 tüneli)\" % (AGIZ[\"x\"][0], AGIZ[\"x\"][1], AGIZ[\"y\"][0], AGIZ[\"y\"][1],\n519:            AGIZ[\"x\"][1] - AGIZ[\"x\"][0], AGIZ[\"y\"][1] - AGIZ[\"y\"][0]), not t_c, str(t_c[:4]))\n521:    for ad_, k_ in ((\"sol\", kutu(AGIZ[\"x\"][0] - T, AGIZ[\"x\"][0], AGIZ[\"y\"][0], AGIZ[\"y\"][1], Z_PAN[0], Z_YUZ)), (\"sag\", kutu(AGIZ[\"x\"][1], AGIZ[\"x\"][1] + T, AGIZ[\"y\"][0], AGIZ[\"y\"][1], Z_PAN[0], Z_YUZ)),\n522:                    (\"alt\", kutu(AGIZ[\"x\"][0], AGIZ[\"x\"][1], AGIZ[\"y\"][0] - T, AGIZ[\"y\"][0], Z_PAN[0], Z_YUZ)), (\"ust\", kutu(AGIZ[\"x\"][0], AGIZ[\"x\"][1], AGIZ[\"y\"][1], AGIZ[\"y\"][1] + T, Z_PAN[0], Z_YUZ))):\n533:    ortu = PERDE[\"x\"][0] <= AGIZ[\"x\"][0] and PERDE[\"x\"][1] >= AGIZ[\"x\"][1] and PERDE[\"alt_y\"][1] <= AGIZ[\"y\"][0] and PERDE[\"ust_y\"][0] >= AGIZ[\"y\"][1]\n535:            % (PERDE[\"x\"][0], PERDE[\"x\"][1], PERDE[\"alt_y\"][1], PERDE[\"ust_y\"][0], PERDE[\"z\"][0], PERDE[\"z\"][1], AGIZ[\"x\"][0], AGIZ[\"x\"][1], AGIZ[\"y\"][0], AGIZ[\"y\"][1]),\n587:    print(\"   KÜTLE (304, plastik hariç): \" + \" · \".join(\"%s %.1f kg\" % kv for kv in kg_b.items()) + \" · alt panel %.1f kg\" % (dunya(P_[\"onyuz_alt_panel\"]).Volume() * RO))","is_error":false}]},"uuid":"6294afc7-bd19-42a4-ad0b-d9133d02385d","timestamp":"2026-10-01T21:16:40.921Z","sourceToolAssistantUUID":"57a1781f-a078-4107-a96f-5fe4f1ae11b1","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
