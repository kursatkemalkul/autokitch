{"parentUuid":"d4d2d88e-18ac-4a0c-af35-2608dda6229a","isSidechain":true,"agentId":"aef5b2090ee5a380c","message":{"model":"claude-opus-5-5","id":"msg_011Cfd9rWvt4Afiqx2P9Grqp","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":388,"cache_read_input_tokens":243099,"cache_creation":{"ephemeral_5m_input_tokens":388,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":0,"requestId":"req_011Cfd9rWEhzitAxZpyNypRW","attributionAgent":"general-purpose","type":"assistant","uuid":"3281162a-2462-4e3d-a455-956ce2c3a915","timestamp":"2026-10-02T09:12:58.566Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
{"parentUuid":"3281162a-2462-4e3d-a455-956ce2c3a915","isSidechain":true,"agentId":"aef5b2090ee5a380c","message":{"model":"claude-opus-5-5","id":"msg_011Cfd9rWvt4Afiqx2P9Grqp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012FAmjnZcsELYdJKgU9eGwp","name":"Write","input":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\k_montaj_v1\\hazirla.py","content":"# -*- coding: utf-8 -*-\n\"\"\"k_montaj_v1 · K gövdesi (yalnız KABUK) montaj animasyonu verisi\ngirdi : sac_pilot_K/K_sac_v1.glb (dünya, metre) + acinim/*.json + K_sac_v1_rapor.json\nçıktı : <worktree>/otonom/hat3d/v3/k_montaj/k_montaj.glb (yalnız kabuk düğümleri, düğüm çevirisi = parça merkezi)\n        <worktree>/otonom/hat3d/v3/k_montaj/k_montaj.json (adımlar · parça hareketleri · kameralar · açınım 2B)\nHareket modeli (sayfa ile birebir): parça dünya konumu = son konum + Σ d·(1 − e(u)) + kapak dönüşü · u = (t − t0)/(t1 − t0) kırpılmış · e = smoothstep\"\"\"\nimport json, os, re, math, struct\nimport numpy as np\nimport glbio\nHERE = os.path.dirname(os.path.abspath(__file__))\nSP = os.path.dirname(HERE)\nSRC = os.path.join(SP, 'sac_pilot_K')\nWT = r'C:/Users/Kemal/Desktop/Kemal/WEBSİTE/AUTOKITCH_COORDINATION/worktrees/claude-k-montaj-v1'\nOUT = os.path.join(WT, 'otonom', 'hat3d', 'v3', 'k_montaj')\nos.makedirs(OUT, exist_ok=True)\nJ, P = glbio.oku(os.path.join(SRC, 'K_sac_v1.glb'))\nRAP = json.load(open(os.path.join(SRC, 'K_sac_v1_rapor.json'), encoding='utf-8'))\n\n# ------------------------------------------------------------------ kabuk seçimi\nKOPRU = ('MEK__kopru_kirisi_yan_20', 'MEK__kopru_kirisi_yan_380')     # K_KESICI'den gelir ama iskelete kaynaklı (atölye sırası 4)\nAR_DAHIL = re.compile(r'^ARAYUZ__arayuz_(kb_|m8_|pano_burcu|kosebent)')\nAR_DIS = re.compile(r'^ARAYUZ__arayuz_(bant_ayagi|itici_taban)')\nkabuk, dis = [], {}\nfor ad in P:\n    if ad.startswith('MEK__'):\n        if ad in KOPRU: kabuk.append(ad)\n        else: dis[ad] = 'mekanizma (kabuk dışı)'\n    elif ad.startswith('ARAYUZ__'):\n        if AR_DAHIL.match(ad): kabuk.append(ad)\n        elif AR_DIS.match(ad): dis[ad] = 'mekanizma ayağı cıvatası (mekanizma sahibi · kabuk dışı)'\n        else: raise SystemExit('sınıflanmamış arayüz ' + ad)\n    else: kabuk.append(ad)\n\n\ndef kapakla_doner(ad):\n    return ad.startswith('onyuz_kapak_K') and not re.search(r'mentese_\\d+_sabit|basac_\\d+$', ad)\n\n\nHAR = {a: [] for a in kabuk}      # [t0, t1, dx, dy, dz]\nROT = {a: [] for a in kabuk}      # [t0, t1, aci°]  (kapak · dünya y ekseni · kapak_pivot)\nGOR = {}\nKAY = set()\nADIM, KAM, OLAY = [], [], []\n\n\ndef cent(ad):\n    V = P[ad]['V']; return (V.min(0) + V.max(0)) / 2\n\n\ndef _h(a, t0, t1, d):\n    HAR[a].append([round(t0, 3), round(t1, 3)] + [round(float(x), 5) for x in d])\n\n\ndef gel(adlar, d, t0, sure, ara=0.0):\n    t = t0\n    for a in adlar:\n        _h(a, t, t + sure, d); GOR.setdefault(a, round(t, 3)); t += ara\n    return (t - ara + sure) if adlar else t0\n\n\ndef ofset(adlar, d, t0, t1):\n    for a in adlar: _h(a, t0, t1, d)\n\n\ndef kaynak(adlar, t0, sure=0.5, ara=0.12):\n    t = t0\n    for a in adlar:\n        KAY.add(a); GOR[a] = round(t, 3); _h(a, t, t + sure, (0, 0, 0)); t += ara\n    return (t - ara + sure) if adlar else t0\n\n\ndef ad_re(rx): return sorted([a for a in kabuk if re.search(rx, a)])\ndef olay(t, m): OLAY.append([round(t, 2), m])\ndef kam(t, pos, hedef): KAM.append([round(t, 2), [round(v, 4) for v in pos], [round(v, 4) for v in hedef]])\n\n\nGENEL = ([3.05, 2.35, 1.55], [4.2, 1.25, -0.38])\nt = 0.0\n# ---- 1–3: kart + 2B açınım (aşama 1)\nfor no, ad, sure, metin, liste in [\n    (1, 'Lazer kesim', 8.0,\n     \"Saclar açınım dosyalarından lazerde kesilir: N₂ kesme gazı (oksitsiz, kaynağa hazır kenar), folyolu yüz yukarı. Kare borular boru lazerde boy + delik/pencere ile kesilir. Bütün kenarlar çapaklanır.\",\n     \"41 sac: yan 2 · üst · arka · taban 3 mm · istasyon tabanı 3 mm · kapak dış/iç tava · 3 karşılık · 26 kulak · 4 tapa — 14 kare boru 30×30×2\"),\n    (2, 'PEM saplama / somun basma', 8.0,\n     \"PEM elemanlar DÜZ sacta, bükümden ÖNCE preste basılır — büküm sonrası flanş presin alt kalıbına engel olur. FHP-M5 saplamaların başı dış yüzle aynı (dışta iz yok).\",\n     \"FHP-M5-15 ×26 (yan + üst sac · kulak bağlantısı) · FHP-M5-12 ×12 (arka sac) + 4 pano burcu + 6 köşebent · SP-M5 ×6 (iç tava) · SP-M6 ×4 + SP-M5 ×8 (istasyon tabanı)\"),\n    (3, 'Abkant büküm', 8.0,\n     \"Abkantta açınımdaki büküm çizgilerinden, numaralı sırayla bükülür (iç R = 1,5 t). Folyo üstte kalır. Kapak tavaları 4 büküm, yan saclar 2, üst sac 2, arka sac 1, her kulak 1 büküm.\",\n     \"yan saclar 2 · üst sac 2 · arka sac 1 · kapak dış tava 4 · iç tava 4 · 26 kulak × 1\")]:\n    ADIM.append(dict(no=no, ad=ad, t0=t, t1=t + sure, metin=metin, liste=liste, kart='acinim'))\n    kam(t, GENEL[0], GENEL[1]); t += sure\n\n# ---- 4: iskelet\nt4 = t\nkam(t, [3.15, 2.1, 1.25], [4.2, 1.15, -0.38])\nolay(t, 'Taban sacı 3 mm fikstüre')\nt = gel(['taban_sac_3'], (0, 0.35, 0), t, 1.2) + 0.2\nolay(t, '4 köşe dikmesi taban sacına (kare / diyagonal kontrol)')\nt = gel(ad_re(r'^kose_dikmesi_\\d+_-?\\d+$'), (0, 0.6, 0), t, 1.2, 0.25) + 0.2\nolay(t, 'Alt kuşaklar (ön/arka + yan) · kısa atlamalı TIG dikiş')\nt = gel(['onyuz_kayit_140_42', 'onyuz_kayit_140_-800', 'taban_sac_tasiyici_20', 'taban_sac_tasiyici_380'], (0, 0.45, 0), t, 1.0, 0.25)\nt = kaynak(ad_re(r'^onyuz_kayit_kaynak_alt|^taban_sac_tasiyici_kaynak|^taban_sac_dikis_kaynagi'), t, 0.4, 0.07) + 0.2\nolay(t, 'K→B kovanları sol alt yan kuşağa (üst duvardan) + çevre kaynağı')\nkam(t, [3.55, 1.25, 0.15], [4.02, 0.82, -0.52])\nt = gel(ad_re(r'^taban_sac_tasiyici_20_kovan_\\d+$'), (0, 0.25, 0), t, 0.9, 0.2)\nt = kaynak(ad_re(r'kovan_kaynagi'), t, 0.4, 0.1)\nolay(t, 'K→B M8 pulu kovanın üstüne — yan boşluktan (üstteki Ø13,5 geçişten Ø16 pul geçmez)')\nt = gel(ad_re(r'^ARAYUZ__arayuz_kb_\\d+_pul$'), (-0.25, 0, 0), t, 1.0, 0.2) + 0.2\nkam(t, [3.15, 2.1, 1.25], [4.2, 1.15, -0.38])\nolay(t, 'Orta kuşaklar (ön/arka + yan · istasyon tabanını 4 kenardan taşır)')\nt = gel(['onyuz_kayit_877_42', 'onyuz_kayit_877_-800', 'istasyon_tabani_tasiyici_20', 'istasyon_tabani_tasiyici_380'], (0, 0.45, 0), t, 1.0, 0.25)\nt = kaynak(ad_re(r'^onyuz_kayit_kaynak_orta|^istasyon_tabani_tasiyici_kaynak'), t, 0.4, 0.08) + 0.2\nolay(t, \"İstasyon tabanı 3 mm (PEM'leri basılı) orta kuşaklara — köprü kirişi ve üst kuşaktan ÖNCE\")\nt = gel(['istasyon_tabani_3'] + ad_re(r'^istasyon_tabani_pem_'), (0, 0.6, 0), t, 1.4) + 0.2\nolay(t, 'Köprü yan kirişleri (K_KESICI) dikmelere')\nt = gel(list(KOPRU), (0, 0.5, 0), t, 1.0, 0.25)\nt = kaynak(ad_re(r'^kose_dikmesi_kopru_kaynagi'), t, 0.4, 0.08) + 0.2\nolay(t, 'Üst kuşaklar + dikme tapaları (2 mm · çevre alın kaynağı taşlanır)')\nt = gel(['onyuz_kayit_1840_42', 'onyuz_kayit_1840_-800'], (0, 0.4, 0), t, 1.0, 0.25)\nt = kaynak(ad_re(r'^onyuz_kayit_kaynak_ust'), t, 0.4, 0.08)\nt = gel(ad_re(r'^kose_dikmesi_\\d+_-?\\d+_tapa$'), (0, 0.2, 0), t, 0.7, 0.12) + 0.2\nolay(t, '26 panel kulağı: kaynak ayağı iskelete, saplama ayağı panel iç yüzü hizasında · kulak başına 2 dikiş')\nkam(t, [3.25, 1.75, 0.95], [4.15, 1.3, -0.3])\nt = gel(ad_re(r'^govde_kulak_sol_(on|arka|orta)_\\d+$'), (-0.3, 0, 0), t, 0.8, 0.12)\nt = gel(ad_re(r'^govde_kulak_sag_(on|arka|orta)_\\d+$'), (0.3, 0, 0), t, 0.8, 0.12)\nt = gel(ad_re(r'^govde_kulak_ust_(on|arka)_\\d+$'), (0, 0.25, 0), t, 0.8, 0.12)\nt = kaynak(ad_re(r'^govde_kulak_.*_kaynak_[ab]$'), t, 0.35, 0.04) + 0.6\nADIM.append(dict(no=4, ad='İskelet · kaynaklı alt montaj (fikstür)', t0=t4, t1=t,\n                 metin=\"Fikstürde kare/diyagonal kontrollü kurulur; kısa atlamalı TIG dikiş (141 · ER308LSi) çarpılmayı önler. İstasyon tabanı orta kuşaklar kaynaklanınca hemen konur: köprü kirişi ve üst kuşaktan sonra 397 mm genişliğindeki levha iskelete ne üstten ne yandan girer.\",\n                 liste=\"taban sacı 3 mm · 4 dikme · 6 kuşak (alt/orta/üst · ön+arka) · 4 yan kuşak · 2 köprü yan kirişi (K_KESICI) · 4 tapa · 2 kovan + 2 pul · istasyon tabanı · 26 kulak\"))\n\n# ---- 5\nt5 = t\nkam(t, [3.4, 2.2, 0.75], [4.2, 0.95, -0.38])\nolay(t, 'İstasyon tabanı: 10 yarık (delik) kaynağı orta kuşaklara + dikme çevresi köşe kaynağı (sızdırmaz)')\nt = kaynak(ad_re(r'^istasyon_tabani_delik_kaynagi|^istasyon_tabani_dikme_kaynagi'), t, 0.45, 0.12) + 0.3\nolay(t, 'Yüz taşlanır + satine · dekapaj + pasivasyon (ASTM A380 / A967)')\nTASLA = [round(t, 2), round(t + 2.2, 2)]\nt += 2.4\nolay(t, 'M8 perçin somunlar dikme / orta kuşak dış duvarına (F tarafı 4 · E tarafı 3)')\nkam(t, [3.35, 1.45, 0.55], [4.2, 1.2, -0.4])\nt = gel(ad_re(r'^govde_m8_F_'), (-0.15, 0, 0), t, 0.7, 0.15)\nt = gel(ad_re(r'^govde_m8_E_'), (0.15, 0, 0), t, 0.7, 0.15) + 0.6\nADIM.append(dict(no=5, ad='İstasyon tabanı kaynağı · taşlama · M8 noktaları', t0=t5, t1=t,\n                 metin=\"İstasyon tabanı orta kuşaklara yarık kaynağıyla bağlanır, dikme çevresi köşe kaynağıyla kapanır (yağ damlası alta inmez); yüz taşlanır. Görünür yüzler satine, iskelet dekapaj + pasivasyon. M8 perçin somunlar komşu istasyon bağlantısı içindir. Mekanizma (bant, itici, köprü, pano) bu noktada açık iskelete takılır — burada gösterilmez.\",\n                 liste=\"10 delik kaynağı · 8 dikme kaynağı · 7 M8 perçin somun (F 4 · E 3)\"))\n\n# ---- 6\nt6 = t\nkam(t, [3.0, 1.7, 0.9], [4.2, 1.3, -0.38])\nolay(t, 'Ara pullar (2 mm) perçin somun başlarına — yan sactan ÖNCE (sac ile somun başı arasında kalır)')\nt = gel(ad_re(r'^govde_m8_ara_pul_F_'), (-0.12, 0, 0), t, 0.6, 0.12)\nt = gel(ad_re(r'^govde_m8_ara_pul_E_'), (0.12, 0, 0), t, 0.6, 0.12) + 0.2\n\n\ndef bag_yon(o):\n    s = cent(o + '_saplama'); n = cent(o + '_somun') - s; return n / np.linalg.norm(n)\n\n\ndef somunlar(oneks, t, L=0.05):\n    for o in oneks:\n        d = bag_yon(o) * L\n        gel([o + '_pul'], d, t, 0.45); gel([o + '_somun'], d * 1.4, t + 0.25, 0.5); t += 0.09\n    return t + 0.6\n\n\ndef onekler(rx):\n    return sorted(set(re.sub(r'_saplama$', '', a) for a in ad_re(rx)))\n\n\nfor taraf, sx in (('sol', -1), ('sag', 1)):\n    sac = 'sol_sac_urun_girisi' if taraf == 'sol' else 'sag_sac_E_penceresi'\n    olay(t, '%s yan sac: preslenmiş FHP-M5 saplamalar kulak deliklerine oturur' % ('Sol' if taraf == 'sol' else 'Sağ'))\n    kam(t, [4.2 + sx * 1.55, 1.55, 0.75], [4.2, 1.3, -0.38])\n    t = gel([sac] + ad_re(r'^govde_kulak_%s_.*_bag_saplama$' % taraf) + ad_re(r'^ARAYUZ__arayuz_kosebent_%s_' % taraf), (sx * 0.65, 0, 0), t, 1.6) + 0.2\n    olay(t, 'Geniş pul + fiberli somun İÇERİDEN (ön açıklıktan)')\n    kam(t, [4.2 - sx * 0.05, 1.25, 0.65], [4.2 + sx * 0.19, 1.2, -0.3])\n    t = somunlar(onekler(r'^govde_kulak_%s_.*_bag_saplama$' % taraf), t)\nolay(t, 'Üst sac 4 kulağa (üstte görünür vida yok) · somunlar alttan')\nkam(t, [3.3, 2.75, 0.75], [4.2, 1.7, -0.38])\nt = gel(['ust_sac'] + ad_re(r'^govde_kulak_ust_.*_bag_saplama$'), (0, 0.6, 0), t, 1.5) + 0.2\nt = somunlar(onekler(r'^govde_kulak_ust_.*_bag_saplama$'), t)\nolay(t, 'Arka sac arkadan: 12 FHP saplama yan sacların / üst sacın arka dönüş deliklerinden geçer')\nkam(t, [5.25, 1.85, -1.75], [4.2, 1.3, -0.5])\nt = gel(['arka_sac'] + ad_re(r'^govde_bag_arka_.*_saplama$') + ad_re(r'^ARAYUZ__arayuz_pano_burcu_'), (0, 0, -0.7), t, 1.7) + 0.2\nolay(t, 'Pul + fiberli somun İÇERİDEN · dikme ile arka sac arasındaki 13,5 mm yarıktan SW8 · arka yüzde baş yok (z −830)')\nkam(t, [4.2, 1.45, 0.55], [4.15, 1.3, -0.75])\nt = somunlar(onekler(r'^govde_bag_arka_.*_saplama$'), t, 0.045) + 0.4\nADIM.append(dict(no=6, ad='Paneller · yan → üst → arka', t0=t6, t1=t,\n                 metin=\"Yan saclar kulaklara preslenmiş FHP-M5 saplamalarla oturur; pul + fiberli somun içeriden takılır (dış yüzde iz yok — komşu istasyonla yüz yüze). Üst sac 4 kulağa. Arka sac en son, arkadan gelir: saplamaları yan/üst sacların arka dönüşlerinden geçer, somunlar içeriden 13,5 mm yarıktan SW8 ile.\",\n                 liste=\"7 ara pul · sol + sağ yan sac (22 kulak) · üst sac (4 kulak) · arka sac (12 saplama + 4 pano burcu saplaması) · 38 geniş pul + 38 fiberli somun M5\"))\n\n# ---- 7 kapak\nt7 = t\nkam(t, [3.75, 1.45, 0.75], [4.03, 1.36, 0.02])\nolay(t, '3 gizli menteşe gövdesi sol ön dikmenin penceresine (önden)')\nt = gel(ad_re(r'^onyuz_kapak_K_mentese_\\d_sabit$'), (0, 0, 0.15), t, 0.8, 0.2)\nolay(t, 'Her gövdeye 2 × M5 bombe başlı vida — dikmenin iç yan duvarından (içeriden)')\nt = gel(ad_re(r'^onyuz_kapak_K_mentese_\\d_sabit_vida_[ab]$'), (0.06, 0, 0), t, 0.5, 0.1)\nolay(t, '3 bas-aç mandalı sağ ön dikmeye geçme (önden)')\nkam(t, [4.75, 1.45, 0.75], [4.37, 1.4, 0.02])\nt = gel(ad_re(r'^onyuz_kapak_K_basac_\\d$'), (0, 0, 0.12), t, 0.6, 0.15) + 0.3\nKAPAK = sorted(a for a in kabuk if kapakla_doner(a))\nST = (0.0, 0.015, 0.95)            # kapak alt montaj yeri (önde) · 15 mm kaldırma payı dahil\nolay(t, 'Kapak alt montajı (tezgâhta): iç tava (SP-M5 basılı) + 3 karşılık plakası punta')\nkam(t, [3.55, 1.85, 2.45], [4.2, 1.45, 1.0])\nic = ['onyuz_kapak_K_ic_tava'] + ad_re(r'^onyuz_kapak_K_mentese_\\d_pem_[ab]$')\ngel(ic, (0, 0.3, 0), t, 1.0); t += 1.2\ngel(ad_re(r'^onyuz_kapak_K_karsilik_\\d$'), (0, 0, 0.07), t, 0.6, 0.1); t += 1.0\nolay(t, 'Menteşe kanat yarıları arkadan (cep iç tava kesiğinden girer) + 2 × M5×6')\ngel(ad_re(r'^onyuz_kapak_K_mentese_\\d_kanat$'), (0, 0, -0.1), t, 0.8, 0.1); t += 1.1\ngel(ad_re(r'^onyuz_kapak_K_mentese_\\d_kanat_vida_[ab]$'), (0, 0, -0.05), t, 0.5, 0.06); t += 0.9\nolay(t, 'Dış tava 1,5 mm: köşeler bindirme + TIG, sonra iç tavanın üstüne oturur (derz 3 mm) · punta')\ndk = ad_re(r'^onyuz_kapak_K_kose_kaynagi_\\d$')\nGOR['onyuz_kapak_K'] = round(t, 3)\ntk = kaynak(dk, t + 0.6, 0.4, 0.15) + 0.2\nofset(['onyuz_kapak_K'] + dk, (0, 0, 0.35), tk, tk + 1.0)\nt = tk + 1.3\nTA, TB = t, t + 2.0\nTC = TB + 0.9\nolay(t, 'Kapak önden gelir, 15 mm yukarıda menteşelere hizalanır, indirilir (kaldır-tak)')\nkam(t, [3.35, 1.75, 1.9], [4.2, 1.4, 0.2])\nofset(KAPAK, (0, 0, ST[2]), TA, TB)\nofset(KAPAK, (0, ST[1], 0), TB, TC)\nt = TC + 0.4\nolay(t, 'Kapak bas-aç ile açılır: menteşe ekseni x 4003 · z 79, 0 → 100° → kapanır')\nkam(t, [3.15, 1.95, 1.75], [4.2, 1.45, 0.0])\nTO0, TO1, TO2, TO3 = t, t + 2.2, t + 3.4, t + 5.4\nfor a in KAPAK: ROT[a] += [[round(TO0, 3), round(TO1, 3), -100.0], [round(TO2, 3), round(TO3, 3), 100.0]]\nt = TO3 + 0.6\nADIM.append(dict(no=7, ad='Kapak · menteşe · bas-aç', t0=t7, t1=t,\n                 metin=\"Menteşe gövdeleri sol ön dikmenin içine gömülür (2 × M5, içeriden). Kapak tezgâhta kurulur: iç tava + karşılıklar + menteşe kanatları, üstüne dış tava (köşeler TIG) — punta. Kapak önden kaldır-tak ile asılır; kulp yok, 3 bas-aç ile açılır.\",\n                 liste=\"3 gizli menteşe (gövde + kanat) · 6 × M5×12 · 6 × M5×6 · 6 SP-M5 · 3 bas-aç · dış tava 1,5 · iç tava 1,0 · 3 karşılık · 4 köşe kaynağı\"))\n\n# ---- 8 saha\nt8 = t\nkam(t, [2.55, 2.45, 2.2], [4.2, 1.0, -0.38])\nolay(t, 'Sahada: K, B dolabının teknik sütunu üstüne (y 788) indirilir · B, F, E silik (temsili)')\nGHOST_T = round(t, 2)\nSONRA = re.compile(r'^ARAYUZ__arayuz_(kb_\\d+$|m8_)|^istasyon_tabani_tapa_')\nhepsi = [a for a in kabuk if not SONRA.match(a)]\nofset(hepsi, (0, 0.9, 0), t + 0.8, t + 3.6)\nt += 3.9\nolay(t, 'K→B: 2 × M8×50 — istasyon tabanındaki Ø16 servis deliklerinden uzatmalı lokma ile (B kuşağına)')\nkam(t, [3.65, 1.55, 0.25], [4.02, 0.95, -0.52])\nt = gel(ad_re(r'^ARAYUZ__arayuz_kb_\\d+$'), (0, 0.22, 0), t, 1.0, 0.25) + 0.2\nolay(t, 'Silikon servis tapaları Ø16')\nt = gel(ad_re(r'^istasyon_tabani_tapa_'), (0, 0.1, 0), t, 0.6, 0.2) + 0.3\nolay(t, 'F içinden 4 × M8×25 + pul · E içinden 3 × M8×25 + pul (komşu saclarda Ø9)')\nkam(t, [4.2, 2.5, 1.6], [4.2, 1.25, -0.38])\ngel(ad_re(r'^ARAYUZ__arayuz_m8_F_.*_pul$'), (-0.08, 0, 0), t, 0.5, 0.12)\nt = gel(ad_re(r'^ARAYUZ__arayuz_m8_F_[\\d_\\-]+$'), (-0.1, 0, 0), t + 0.3, 0.6, 0.12)\ngel(ad_re(r'^ARAYUZ__arayuz_m8_E_.*_pul$'), (0.08, 0, 0), t, 0.5, 0.12)\nt = gel(ad_re(r'^ARAYUZ__arayuz_m8_E_[\\d_\\-]+$'), (0.1, 0, 0), t + 0.3, 0.6, 0.12) + 0.6\nolay(t, 'Folyo sökülür · K kabuğu tamam')\nkam(t, GENEL[0], GENEL[1])\nt += 2.5\nADIM.append(dict(no=8, ad='Saha · B, F, E komşularına bağlantı', t0=t8, t1=t,\n                 metin=\"K, B dolabının teknik sütununun üstüne oturur; istasyon tabanındaki Ø16 servis deliklerinden 2 × M8 ile B kuşağına bağlanır, delikler silikon tapayla kapanır. Komşu F ve E istasyonları kendi içlerinden M8 cıvatayla K'nın perçin somunlarına bağlanır (komşu saclarda Ø9).\",\n                 liste=\"2 × M8×50 (K→B) · 2 silikon tapa · 4 × M8×25 + pul (F) · 3 × M8×25 + pul (E)\"))\nTOPLAM = round(t, 2)\neksik = [a for a in kabuk if a not in GOR]\nassert not eksik, eksik\n\n# ------------------------------------------------------------------ GLB\nMAL = {'sac': 0, 'profil': 1, 'kaynak': 2, 'baglanti': 3, 'kapak': 4, 'mekanizma': 1, 'arayuz': 3}\nMATS = [dict(name='sac', pbrMetallicRoughness=dict(baseColorFactor=[0.80, 0.82, 0.85, 1], metallicFactor=0.55, roughnessFactor=0.38)),\n        dict(name='profil', pbrMetallicRoughness=dict(baseColorFactor=[0.68, 0.71, 0.75, 1], metallicFactor=0.6, roughnessFactor=0.35)),\n        dict(name='kaynak', pbrMetallicRoughness=dict(baseColorFactor=[0.78, 0.55, 0.25, 1], metallicFactor=0.4, roughnessFactor=0.5)),\n        dict(name='baglanti', pbrMetallicRoughness=dict(baseColorFactor=[0.42, 0.45, 0.50, 1], metallicFactor=0.7, roughnessFactor=0.35)),\n        dict(name='kapak', pbrMetallicRoughness=dict(baseColorFactor=[0.86, 0.88, 0.91, 1], metallicFactor=0.5, roughnessFactor=0.32))]\ndug, PARCA = [], {}\nfor a in kabuk:\n    V = P[a]['V']; c = np.round((V.min(0) + V.max(0)) / 2, 4)\n    mat = 'arayuz' if a.startswith('ARAYUZ__') else P[a]['mat']\n    dug.append(dict(ad=a, V=V - c, F=P[a]['F'], mat=MAL[mat], translation=c))\n    PARCA[a] = dict(c=c.tolist(), m=mat, bb=[np.round(V.min(0), 7).tolist(), np.round(V.max(0), 7).tolist()], g=GOR[a], h=HAR[a])\n    if ROT[a]: PARCA[a]['r'] = ROT[a]\n    if a in KAY: PARCA[a]['k'] = 1\n    if a in KAPAK: PARCA[a]['kapak'] = 1\nyol = os.path.join(OUT, 'k_montaj.glb')\nglbio.yaz(yol, dug, MATS)\nf = open(yol, 'rb').read(); L = struct.unpack('<I', f[12:16])[0]; JJ = json.loads(f[20:20 + L]); rest = f[20 + L:]\nfor nd, d in zip(JJ['nodes'], dug): nd['translation'] = [float(x) for x in d['translation']]\njs = json.dumps(JJ, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\nwhile len(js) % 4: js += b' '\nf = struct.pack('<III', 0x46546C67, 2, 12 + 8 + len(js) + len(rest)) + struct.pack('<II', len(js), 0x4E4F534A) + js + rest\nopen(yol, 'wb').write(f); boy = len(f)\n\n\n# ------------------------------------------------------------------ açınım 2B\ndef cizgi(s, n=10):\n    if s['t'] == 'L': return [s['p'][0], s['p'][1]]\n    if s['t'] == 'A':\n        (x0, y0), (xm, ym), (x1, y1) = s['p']; cx, cy = s['c']; r = s['r']\n        a0 = math.atan2(y0 - cy, x0 - cx); am = math.atan2(ym - cy, xm - cx); a1 = math.atan2(y1 - cy, x1 - cx)\n        def yak(a, b):\n            while a - b > math.pi: a -= 2 * math.pi\n            while b - a > math.pi: a += 2 * math.pi\n            return a\n        am = yak(am, a0); a1 = yak(a1, am)\n        return [[cx + r * math.cos(a0 + (a1 - a0) * i / n), cy + r * math.sin(a0 + (a1 - a0) * i / n)] for i in range(n + 1)]\n    cx, cy = s['c']; r = s['r']\n    return [[cx + r * math.cos(2 * math.pi * i / 24), cy + r * math.sin(2 * math.pi * i / 24)] for i in range(25)]\n\n\ndef kontur(segs):\n    out = []\n    for s in segs:\n        q = cizgi(s)\n        if out and abs(out[-1][0] - q[0][0]) < 1e-6 and abs(out[-1][1] - q[0][1]) < 1e-6: q = q[1:]\n        out += q\n    return [[round(x, 2), round(y, 2)] for x, y in out]\n\n\nACI = []\nSECIM = [('sol_sac_urun_girisi', 1), ('sag_sac_E_penceresi', 1), ('ust_sac', 1), ('arka_sac', 1), ('onyuz_kapak_K', 1), ('onyuz_kapak_K_ic_tava', 1),\n         ('taban_sac_3', 1), ('istasyon_tabani_3', 1), ('govde_kulak_sol_on_841', 26), ('onyuz_kapak_K_karsilik_0', 3), ('kose_dikmesi_20_42_tapa', 4)]\nfor ad, adet in SECIM:\n    d = json.load(open(os.path.join(SRC, 'acinim', ad + '.json'), encoding='utf-8'))\n    bk = [dict(no=b['no'], ad=b['ad'], aci=b['aci'], yon=b['yon'], R=b['R'], c=[[round(v, 2) for v in p] for p in b['cizgi']],\n               s=[[round(v, 2) for v in p] for p in b['baslangic']], e=[[round(v, 2) for v in p] for p in b['bitis']]) for b in d['bukumler']]\n    pem = [dict(c=[round(v, 2) for v in k['merkez_duz']], tip=k.get('pem_tip') or k['tip']) for k in d.get('kesikler', []) if 'pem' in (k.get('tip') or '')]\n    ACI.append(dict(ad=ad, adet=adet, t=d['t'], R=d['R'], levha=d['levha'], dis=kontur(d['dis_kontur']), ek=[kontur(k) for k in d.get('ek_dis_konturlar', [])],\n                    ic=[kontur(k) for k in d['ic_konturlar']], bukum=bk, pem=pem))\n\nsay = {}\nfor a in kabuk:\n    g = 'kaynak' if a in KAY else ('arayuz' if a.startswith('ARAYUZ__') else P[a]['mat'])\n    say[g] = say.get(g, 0) + 1\nOUTJ = dict(surum='k_montaj_v1', tarih='2 Eki 2026', kaynak='sac_pilot_K/K_sac_v1.glb (h3_k_sac_v1)', birim='m', toplam=TOPLAM,\n            kapak_pivot=[4.003, 0.0, 0.079], tasla=TASLA, ghost_t=GHOST_T, adimlar=ADIM, olaylar=OLAY, kamera=KAM, parcalar=PARCA,\n            disarida=dis, acinim=ACI, sayim=dict(kabuk=len(kabuk), dis=len(dis), grup=say), montaj_sirasi=RAP['montaj_sirasi'])\njson.dump(OUTJ, open(os.path.join(OUT, 'k_montaj.json'), 'w', encoding='utf-8'), ensure_ascii=False, separators=(',', ':'))\nprint('kabuk', len(kabuk), 'dışarıda', len(dis), 'GLB %.2f MB' % (boy / 1e6), 'süre %.1f s' % TOPLAM, say)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":388,"cache_read_input_tokens":243099,"output_tokens":13556,"output_tokens_details":{"thinking_tokens":518},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":388},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":13556,"cache_read_input_tokens":243099,"cache_creation_input_tokens":388,"cache_creation":{"ephemeral_5m_input_tokens":388,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_012FAmjnZcsELYdJKgU9eGwp":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\k_montaj_v1\\hazirla.py","content":"# -*- coding: utf-8 -*-\n\"\"\"k_montaj_v1 · K gövdesi (yalnız KABUK) montaj animasyonu verisi\ngirdi : sac_pilot_K/K_sac_v1.glb (dünya, metre) + acinim/*.json + K_sac_v1_rapor.json\nçıktı : <worktree>/otonom/hat3d/v3/k_montaj/k_montaj.glb (yalnız kabuk düğümleri, düğüm çevirisi = parça merkezi)\n        <worktree>/otonom/hat3d/v3/k_montaj/k_montaj.json (adımlar · parça hareketleri · kameralar · açınım 2B)\nHareket modeli (sayfa ile birebir): parça dünya konumu = son konum + Σ d·(1 − e(u)) + kapak dönüşü · u = (t − t0)/(t1 − t0) kırpılmış · e = smoothstep\"\"\"\nimport json, os, re, math, struct\nimport numpy as np\nimport glbio\nHERE = os.path.dirname(os.path.abspath(__file__))\nSP = os.path.dirname(HERE)\nSRC = os.path.join(SP, 'sac_pilot_K')\nWT = r'C:/Users/Kemal/Desktop/Kemal/WEBSİTE/AUTOKITCH_COORDINATION/worktrees/claude-k-montaj-v1'\nOUT = os.path.join(WT, 'otonom', 'hat3d', 'v3', 'k_montaj')\nos.makedirs(OUT, exist_ok=True)\nJ, P = glbio.oku(os.path.join(SRC, 'K_sac_v1.glb'))\nRAP = json.load(open(os.path.join(SRC, 'K_sac_v1_rapor.json'), encoding='utf-8'))\n\n# ------------------------------------------------------------------ kabuk seçimi\nKOPRU = ('MEK__kopru_kirisi_yan_20', 'MEK__kopru_kirisi_yan_380')     # K_KESICI'den gelir ama iskelete kaynaklı (atölye sırası 4)\nAR_DAHIL = re.compile(r'^ARAYUZ__arayuz_(kb_|m8_|pano_burcu|kosebent)')\nAR_DIS = re.compile(r'^ARAYUZ__arayuz_(bant_ayagi|itici_taban)')\nkabuk, dis = [], {}\nfor ad in P:\n    if ad.startswith('MEK__'):\n        if ad in KOPRU: kabuk.append(ad)\n        else: dis[ad] = 'mekanizma (kabuk dışı)'\n    elif ad.startswith('ARAYUZ__'):\n        if AR_DAHIL.match(ad): kabuk.append(ad)\n        elif AR_DIS.match(ad): dis[ad] = 'mekanizma ayağı cıvatası (mekanizma sahibi · kabuk dışı)'\n        else: raise SystemExit('sınıflanmamış arayüz ' + ad)\n    else: kabuk.append(ad)\n\n\ndef kapakla_doner(ad):\n    return ad.startswith('onyuz_kapak_K') and not re.search(r'mentese_\\d+_sabit|basac_\\d+$', ad)\n\n\nHAR = {a: [] for a in kabuk}      # [t0, t1, dx, dy, dz]\nROT = {a: [] for a in kabuk}      # [t0, t1, aci°]  (kapak · dünya y ekseni · kapak_pivot)\nGOR = {}\nKAY = set()\nADIM, KAM, OLAY = [], [], []\n\n\ndef cent(ad):\n    V = P[ad]['V']; return (V.min(0) + V.max(0)) / 2\n\n\ndef _h(a, t0, t1, d):\n    HAR[a].append([round(t0, 3), round(t1, 3)] + [round(float(x), 5) for x in d])\n\n\ndef gel(adlar, d, t0, sure, ara=0.0):\n    t = t0\n    for a in adlar:\n        _h(a, t, t + sure, d); GOR.setdefault(a, round(t, 3)); t += ara\n    return (t - ara + sure) if adlar else t0\n\n\ndef ofset(adlar, d, t0, t1):\n    for a in adlar: _h(a, t0, t1, d)\n\n\ndef kaynak(adlar, t0, sure=0.5, ara=0.12):\n    t = t0\n    for a in adlar:\n        KAY.add(a); GOR[a] = round(t, 3); _h(a, t, t + sure, (0, 0, 0)); t += ara\n    return (t - ara + sure) if adlar else t0\n\n\ndef ad_re(rx): return sorted([a for a in kabuk if re.search(rx, a)])\ndef olay(t, m): OLAY.append([round(t, 2), m])\ndef kam(t, pos, hedef): KAM.append([round(t, 2), [round(v, 4) for v in pos], [round(v, 4) for v in hedef]])\n\n\nGENEL = ([3.05, 2.35, 1.55], [4.2, 1.25, -0.38])\nt = 0.0\n# ---- 1–3: kart + 2B açınım (aşama 1)\nfor no, ad, sure, metin, liste in [\n    (1, 'Lazer kesim', 8.0,\n     \"Saclar açınım dosyalarından lazerde kesilir: N₂ kesme gazı (oksitsiz, kaynağa hazır kenar), folyolu yüz yukarı. Kare borular boru lazerde boy + delik/pencere ile kesilir. Bütün kenarlar çapaklanır.\",\n     \"41 sac: yan 2 · üst · arka · taban 3 mm · istasyon tabanı 3 mm · kapak dış/iç tava · 3 karşılık · 26 kulak · 4 tapa — 14 kare boru 30×30×2\"),\n    (2, 'PEM saplama / somun basma', 8.0,\n     \"PEM elemanlar DÜZ sacta, bükümden ÖNCE preste basılır — büküm sonrası flanş presin alt kalıbına engel olur. FHP-M5 saplamaların başı dış yüzle aynı (dışta iz yok).\",\n     \"FHP-M5-15 ×26 (yan + üst sac · kulak bağlantısı) · FHP-M5-12 ×12 (arka sac) + 4 pano burcu + 6 köşebent · SP-M5 ×6 (iç tava) · SP-M6 ×4 + SP-M5 ×8 (istasyon tabanı)\"),\n    (3, 'Abkant büküm', 8.0,\n     \"Abkantta açınımdaki büküm çizgilerinden, numaralı sırayla bükülür (iç R = 1,5 t). Folyo üstte kalır. Kapak tavaları 4 büküm, yan saclar 2, üst sac 2, arka sac 1, her kulak 1 büküm.\",\n     \"yan saclar 2 · üst sac 2 · arka sac 1 · kapak dış tava 4 · iç tava 4 · 26 kulak × 1\")]:\n    ADIM.append(dict(no=no, ad=ad, t0=t, t1=t + sure, metin=metin, liste=liste, kart='acinim'))\n    kam(t, GENEL[0], GENEL[1]); t += sure\n\n# ---- 4: iskelet\nt4 = t\nkam(t, [3.15, 2.1, 1.25], [4.2, 1.15, -0.38])\nolay(t, 'Taban sacı 3 mm fikstüre')\nt = gel(['taban_sac_3'], (0, 0.35, 0), t, 1.2) + 0.2\nolay(t, '4 köşe dikmesi taban sacına (kare / diyagonal kontrol)')\nt = gel(ad_re(r'^kose_dikmesi_\\d+_-?\\d+$'), (0, 0.6, 0), t, 1.2, 0.25) + 0.2\nolay(t, 'Alt kuşaklar (ön/arka + yan) · kısa atlamalı TIG dikiş')\nt = gel(['onyuz_kayit_140_42', 'onyuz_kayit_140_-800', 'taban_sac_tasiyici_20', 'taban_sac_tasiyici_380'], (0, 0.45, 0), t, 1.0, 0.25)\nt = kaynak(ad_re(r'^onyuz_kayit_kaynak_alt|^taban_sac_tasiyici_kaynak|^taban_sac_dikis_kaynagi'), t, 0.4, 0.07) + 0.2\nolay(t, 'K→B kovanları sol alt yan kuşağa (üst duvardan) + çevre kaynağı')\nkam(t, [3.55, 1.25, 0.15], [4.02, 0.82, -0.52])\nt = gel(ad_re(r'^taban_sac_tasiyici_20_kovan_\\d+$'), (0, 0.25, 0), t, 0.9, 0.2)\nt = kaynak(ad_re(r'kovan_kaynagi'), t, 0.4, 0.1)\nolay(t, 'K→B M8 pulu kovanın üstüne — yan boşluktan (üstteki Ø13,5 geçişten Ø16 pul geçmez)')\nt = gel(ad_re(r'^ARAYUZ__arayuz_kb_\\d+_pul$'), (-0.25, 0, 0), t, 1.0, 0.2) + 0.2\nkam(t, [3.15, 2.1, 1.25], [4.2, 1.15, -0.38])\nolay(t, 'Orta kuşaklar (ön/arka + yan · istasyon tabanını 4 kenardan taşır)')\nt = gel(['onyuz_kayit_877_42', 'onyuz_kayit_877_-800', 'istasyon_tabani_tasiyici_20', 'istasyon_tabani_tasiyici_380'], (0, 0.45, 0), t, 1.0, 0.25)\nt = kaynak(ad_re(r'^onyuz_kayit_kaynak_orta|^istasyon_tabani_tasiyici_kaynak'), t, 0.4, 0.08) + 0.2\nolay(t, \"İstasyon tabanı 3 mm (PEM'leri basılı) orta kuşaklara — köprü kirişi ve üst kuşaktan ÖNCE\")\nt = gel(['istasyon_tabani_3'] + ad_re(r'^istasyon_tabani_pem_'), (0, 0.6, 0), t, 1.4) + 0.2\nolay(t, 'Köprü yan kirişleri (K_KESICI) dikmelere')\nt = gel(list(KOPRU), (0, 0.5, 0), t, 1.0, 0.25)\nt = kaynak(ad_re(r'^kose_dikmesi_kopru_kaynagi'), t, 0.4, 0.08) + 0.2\nolay(t, 'Üst kuşaklar + dikme tapaları (2 mm · çevre alın kaynağı taşlanır)')\nt = gel(['onyuz_kayit_1840_42', 'onyuz_kayit_1840_-800'], (0, 0.4, 0), t, 1.0, 0.25)\nt = kaynak(ad_re(r'^onyuz_kayit_kaynak_ust'), t, 0.4, 0.08)\nt = gel(ad_re(r'^kose_dikmesi_\\d+_-?\\d+_tapa$'), (0, 0.2, 0), t, 0.7, 0.12) + 0.2\nolay(t, '26 panel kulağı: kaynak ayağı iskelete, saplama ayağı panel iç yüzü hizasında · kulak başına 2 dikiş')\nkam(t, [3.25, 1.75, 0.95], [4.15, 1.3, -0.3])\nt = gel(ad_re(r'^govde_kulak_sol_(on|arka|orta)_\\d+$'), (-0.3, 0, 0), t, 0.8, 0.12)\nt = gel(ad_re(r'^govde_kulak_sag_(on|arka|orta)_\\d+$'), (0.3, 0, 0), t, 0.8, 0.12)\nt = gel(ad_re(r'^govde_kulak_ust_(on|arka)_\\d+$'), (0, 0.25, 0), t, 0.8, 0.12)\nt = kaynak(ad_re(r'^govde_kulak_.*_kaynak_[ab]$'), t, 0.35, 0.04) + 0.6\nADIM.append(dict(no=4, ad='İskelet · kaynaklı alt montaj (fikstür)', t0=t4, t1=t,\n                 metin=\"Fikstürde kare/diyagonal kontrollü kurulur; kısa atlamalı TIG dikiş (141 · ER308LSi) çarpılmayı önler. İstasyon tabanı orta kuşaklar kaynaklanınca hemen konur: köprü kirişi ve üst kuşaktan sonra 397 mm genişliğindeki levha iskelete ne üstten ne yandan girer.\",\n                 liste=\"taban sacı 3 mm · 4 dikme · 6 kuşak (alt/orta/üst · ön+arka) · 4 yan kuşak · 2 köprü yan kirişi (K_KESICI) · 4 tapa · 2 kovan + 2 pul · istasyon tabanı · 26 kulak\"))\n\n# ---- 5\nt5 = t\nkam(t, [3.4, 2.2, 0.75], [4.2, 0.95, -0.38])\nolay(t, 'İstasyon tabanı: 10 yarık (delik) kaynağı orta kuşaklara + dikme çevresi köşe kaynağı (sızdırmaz)')\nt = kaynak(ad_re(r'^istasyon_tabani_delik_kaynagi|^istasyon_tabani_dikme_kaynagi'), t, 0.45, 0.12) + 0.3\nolay(t, 'Yüz taşlanır + satine · dekapaj + pasivasyon (ASTM A380 / A967)')\nTASLA = [round(t, 2), round(t + 2.2, 2)]\nt += 2.4\nolay(t, 'M8 perçin somunlar dikme / orta kuşak dış duvarına (F tarafı 4 · E tarafı 3)')\nkam(t, [3.35, 1.45, 0.55], [4.2, 1.2, -0.4])\nt = gel(ad_re(r'^govde_m8_F_'), (-0.15, 0, 0), t, 0.7, 0.15)\nt = gel(ad_re(r'^govde_m8_E_'), (0.15, 0, 0), t, 0.7, 0.15) + 0.6\nADIM.append(dict(no=5, ad='İstasyon tabanı kaynağı · taşlama · M8 noktaları', t0=t5, t1=t,\n                 metin=\"İstasyon tabanı orta kuşaklara yarık kaynağıyla bağlanır, dikme çevresi köşe kaynağıyla kapanır (yağ damlası alta inmez); yüz taşlanır. Görünür yüzler satine, iskelet dekapaj + pasivasyon. M8 perçin somunlar komşu istasyon bağlantısı içindir. Mekanizma (bant, itici, köprü, pano) bu noktada açık iskelete takılır — burada gösterilmez.\",\n                 liste=\"10 delik kaynağı · 8 dikme kaynağı · 7 M8 perçin somun (F 4 · E 3)\"))\n\n# ---- 6\nt6 = t\nkam(t, [3.0, 1.7, 0.9], [4.2, 1.3, -0.38])\nolay(t, 'Ara pullar (2 mm) perçin somun başlarına — yan sactan ÖNCE (sac ile somun başı arasında kalır)')\nt = gel(ad_re(r'^govde_m8_ara_pul_F_'), (-0.12, 0, 0), t, 0.6, 0.12)\nt = gel(ad_re(r'^govde_m8_ara_pul_E_'), (0.12, 0, 0), t, 0.6, 0.12) + 0.2\n\n\ndef bag_yon(o):\n    s = cent(o + '_saplama'); n = cent(o + '_somun') - s; return n / np.linalg.norm(n)\n\n\ndef somunlar(oneks, t, L=0.05):\n    for o in oneks:\n        d = bag_yon(o) * L\n        gel([o + '_pul'], d, t, 0.45); gel([o + '_somun'], d * 1.4, t + 0.25, 0.5); t += 0.09\n    return t + 0.6\n\n\ndef onekler(rx):\n    return sorted(set(re.sub(r'_saplama$', '', a) for a in ad_re(rx)))\n\n\nfor taraf, sx in (('sol', -1), ('sag', 1)):\n    sac = 'sol_sac_urun_girisi' if taraf == 'sol' else 'sag_sac_E_penceresi'\n    olay(t, '%s yan sac: preslenmiş FHP-M5 saplamalar kulak deliklerine oturur' % ('Sol' if taraf == 'sol' else 'Sağ'))\n    kam(t, [4.2 + sx * 1.55, 1.55, 0.75], [4.2, 1.3, -0.38])\n    t = gel([sac] + ad_re(r'^govde_kulak_%s_.*_bag_saplama$' % taraf) + ad_re(r'^ARAYUZ__arayuz_kosebent_%s_' % taraf), (sx * 0.65, 0, 0), t, 1.6) + 0.2\n    olay(t, 'Geniş pul + fiberli somun İÇERİDEN (ön açıklıktan)')\n    kam(t, [4.2 - sx * 0.05, 1.25, 0.65], [4.2 + sx * 0.19, 1.2, -0.3])\n    t = somunlar(onekler(r'^govde_kulak_%s_.*_bag_saplama$' % taraf), t)\nolay(t, 'Üst sac 4 kulağa (üstte görünür vida yok) · somunlar alttan')\nkam(t, [3.3, 2.75, 0.75], [4.2, 1.7, -0.38])\nt = gel(['ust_sac'] + ad_re(r'^govde_kulak_ust_.*_bag_saplama$'), (0, 0.6, 0), t, 1.5) + 0.2\nt = somunlar(onekler(r'^govde_kulak_ust_.*_bag_saplama$'), t)\nolay(t, 'Arka sac arkadan: 12 FHP saplama yan sacların / üst sacın arka dönüş deliklerinden geçer')\nkam(t, [5.25, 1.85, -1.75], [4.2, 1.3, -0.5])\nt = gel(['arka_sac'] + ad_re(r'^govde_bag_arka_.*_saplama$') + ad_re(r'^ARAYUZ__arayuz_pano_burcu_'), (0, 0, -0.7), t, 1.7) + 0.2\nolay(t, 'Pul + fiberli somun İÇERİDEN · dikme ile arka sac arasındaki 13,5 mm yarıktan SW8 · arka yüzde baş yok (z −830)')\nkam(t, [4.2, 1.45, 0.55], [4.15, 1.3, -0.75])\nt = somunlar(onekler(r'^govde_bag_arka_.*_saplama$'), t, 0.045) + 0.4\nADIM.append(dict(no=6, ad='Paneller · yan → üst → arka', t0=t6, t1=t,\n                 metin=\"Yan saclar kulaklara preslenmiş FHP-M5 saplamalarla oturur; pul + fiberli somun içeriden takılır (dış yüzde iz yok — komşu istasyonla yüz yüze). Üst sac 4 kulağa. Arka sac en son, arkadan gelir: saplamaları yan/üst sacların arka dönüşlerinden geçer, somunlar içeriden 13,5 mm yarıktan SW8 ile.\",\n                 liste=\"7 ara pul · sol + sağ yan sac (22 kulak) · üst sac (4 kulak) · arka sac (12 saplama + 4 pano burcu saplaması) · 38 geniş pul + 38 fiberli somun M5\"))\n\n# ---- 7 kapak\nt7 = t\nkam(t, [3.75, 1.45, 0.75], [4.03, 1.36, 0.02])\nolay(t, '3 gizli menteşe gövdesi sol ön dikmenin penceresine (önden)')\nt = gel(ad_re(r'^onyuz_kapak_K_mentese_\\d_sabit$'), (0, 0, 0.15), t, 0.8, 0.2)\nolay(t, 'Her gövdeye 2 × M5 bombe başlı vida — dikmenin iç yan duvarından (içeriden)')\nt = gel(ad_re(r'^onyuz_kapak_K_mentese_\\d_sabit_vida_[ab]$'), (0.06, 0, 0), t, 0.5, 0.1)\nolay(t, '3 bas-aç mandalı sağ ön dikmeye geçme (önden)')\nkam(t, [4.75, 1.45, 0.75], [4.37, 1.4, 0.02])\nt = gel(ad_re(r'^onyuz_kapak_K_basac_\\d$'), (0, 0, 0.12), t, 0.6, 0.15) + 0.3\nKAPAK = sorted(a for a in kabuk if kapakla_doner(a))\nST = (0.0, 0.015, 0.95)            # kapak alt montaj yeri (önde) · 15 mm kaldırma payı dahil\nolay(t, 'Kapak alt montajı (tezgâhta): iç tava (SP-M5 basılı) + 3 karşılık plakası punta')\nkam(t, [3.55, 1.85, 2.45], [4.2, 1.45, 1.0])\nic = ['onyuz_kapak_K_ic_tava'] + ad_re(r'^onyuz_kapak_K_mentese_\\d_pem_[ab]$')\ngel(ic, (0, 0.3, 0), t, 1.0); t += 1.2\ngel(ad_re(r'^onyuz_kapak_K_karsilik_\\d$'), (0, 0, 0.07), t, 0.6, 0.1); t += 1.0\nolay(t, 'Menteşe kanat yarıları arkadan (cep iç tava kesiğinden girer) + 2 × M5×6')\ngel(ad_re(r'^onyuz_kapak_K_mentese_\\d_kanat$'), (0, 0, -0.1), t, 0.8, 0.1); t += 1.1\ngel(ad_re(r'^onyuz_kapak_K_mentese_\\d_kanat_vida_[ab]$'), (0, 0, -0.05), t, 0.5, 0.06); t += 0.9\nolay(t, 'Dış tava 1,5 mm: köşeler bindirme + TIG, sonra iç tavanın üstüne oturur (derz 3 mm) · punta')\ndk = ad_re(r'^onyuz_kapak_K_kose_kaynagi_\\d$')\nGOR['onyuz_kapak_K'] = round(t, 3)\ntk = kaynak(dk, t + 0.6, 0.4, 0.15) + 0.2\nofset(['onyuz_kapak_K'] + dk, (0, 0, 0.35), tk, tk + 1.0)\nt = tk + 1.3\nTA, TB = t, t + 2.0\nTC = TB + 0.9\nolay(t, 'Kapak önden gelir, 15 mm yukarıda menteşelere hizalanır, indirilir (kaldır-tak)')\nkam(t, [3.35, 1.75, 1.9], [4.2, 1.4, 0.2])\nofset(KAPAK, (0, 0, ST[2]), TA, TB)\nofset(KAPAK, (0, ST[1], 0), TB, TC)\nt = TC + 0.4\nolay(t, 'Kapak bas-aç ile açılır: menteşe ekseni x 4003 · z 79, 0 → 100° → kapanır')\nkam(t, [3.15, 1.95, 1.75], [4.2, 1.45, 0.0])\nTO0, TO1, TO2, TO3 = t, t + 2.2, t + 3.4, t + 5.4\nfor a in KAPAK: ROT[a] += [[round(TO0, 3), round(TO1, 3), -100.0], [round(TO2, 3), round(TO3, 3), 100.0]]\nt = TO3 + 0.6\nADIM.append(dict(no=7, ad='Kapak · menteşe · bas-aç', t0=t7, t1=t,\n                 metin=\"Menteşe gövdeleri sol ön dikmenin içine gömülür (2 × M5, içeriden). Kapak tezgâhta kurulur: iç tava + karşılıklar + menteşe kanatları, üstüne dış tava (köşeler TIG) — punta. Kapak önden kaldır-tak ile asılır; kulp yok, 3 bas-aç ile açılır.\",\n                 liste=\"3 gizli menteşe (gövde + kanat) · 6 × M5×12 · 6 × M5×6 · 6 SP-M5 · 3 bas-aç · dış tava 1,5 · iç tava 1,0 · 3 karşılık · 4 köşe kaynağı\"))\n\n# ---- 8 saha\nt8 = t\nkam(t, [2.55, 2.45, 2.2], [4.2, 1.0, -0.38])\nolay(t, 'Sahada: K, B dolabının teknik sütunu üstüne (y 788) indirilir · B, F, E silik (temsili)')\nGHOST_T = round(t, 2)\nSONRA = re.compile(r'^ARAYUZ__arayuz_(kb_\\d+$|m8_)|^istasyon_tabani_tapa_')\nhepsi = [a for a in kabuk if not SONRA.match(a)]\nofset(hepsi, (0, 0.9, 0), t + 0.8, t + 3.6)\nt += 3.9\nolay(t, 'K→B: 2 × M8×50 — istasyon tabanındaki Ø16 servis deliklerinden uzatmalı lokma ile (B kuşağına)')\nkam(t, [3.65, 1.55, 0.25], [4.02, 0.95, -0.52])\nt = gel(ad_re(r'^ARAYUZ__arayuz_kb_\\d+$'), (0, 0.22, 0), t, 1.0, 0.25) + 0.2\nolay(t, 'Silikon servis tapaları Ø16')\nt = gel(ad_re(r'^istasyon_tabani_tapa_'), (0, 0.1, 0), t, 0.6, 0.2) + 0.3\nolay(t, 'F içinden 4 × M8×25 + pul · E içinden 3 × M8×25 + pul (komşu saclarda Ø9)')\nkam(t, [4.2, 2.5, 1.6], [4.2, 1.25, -0.38])\ngel(ad_re(r'^ARAYUZ__arayuz_m8_F_.*_pul$'), (-0.08, 0, 0), t, 0.5, 0.12)\nt = gel(ad_re(r'^ARAYUZ__arayuz_m8_F_[\\d_\\-]+$'), (-0.1, 0, 0), t + 0.3, 0.6, 0.12)\ngel(ad_re(r'^ARAYUZ__arayuz_m8_E_.*_pul$'), (0.08, 0, 0), t, 0.5, 0.12)\nt = gel(ad_re(r'^ARAYUZ__arayuz_m8_E_[\\d_\\-]+$'), (0.1, 0, 0), t + 0.3, 0.6, 0.12) + 0.6\nolay(t, 'Folyo sökülür · K kabuğu tamam')\nkam(t, GENEL[0], GENEL[1])\nt += 2.5\nADIM.append(dict(no=8, ad='Saha · B, F, E komşularına bağlantı', t0=t8, t1=t,\n                 metin=\"K, B dolabının teknik sütununun üstüne oturur; istasyon tabanındaki Ø16 servis deliklerinden 2 × M8 ile B kuşağına bağlanır, delikler silikon tapayla kapanır. Komşu F ve E istasyonları kendi içlerinden M8 cıvatayla K'nın perçin somunlarına bağlanır (komşu saclarda Ø9).\",\n                 liste=\"2 × M8×50 (K→B) · 2 silikon tapa · 4 × M8×25 + pul (F) · 3 × M8×25 + pul (E)\"))\nTOPLAM = round(t, 2)\neksik = [a for a in kabuk if a not in GOR]\nassert not eksik, eksik\n\n# ------------------------------------------------------------------ GLB\nMAL = {'sac': 0, 'profil': 1, 'kaynak': 2, 'baglanti': 3, 'kapak': 4, 'mekanizma': 1, 'arayuz': 3}\nMATS = [dict(name='sac', pbrMetallicRoughness=dict(baseColorFactor=[0.80, 0.82, 0.85, 1], metallicFactor=0.55, roughnessFactor=0.38)),\n        dict(name='profil', pbrMetallicRoughness=dict(baseColorFactor=[0.68, 0.71, 0.75, 1], metallicFactor=0.6, roughnessFactor=0.35)),\n        dict(name='kaynak', pbrMetallicRoughness=dict(baseColorFactor=[0.78, 0.55, 0.25, 1], metallicFactor=0.4, roughnessFactor=0.5)),\n        dict(name='baglanti', pbrMetallicRoughness=dict(baseColorFactor=[0.42, 0.45, 0.50, 1], metallicFactor=0.7, roughnessFactor=0.35)),\n        dict(name='kapak', pbrMetallicRoughness=dict(baseColorFactor=[0.86, 0.88, 0.91, 1], metallicFactor=0.5, roughnessFactor=0.32))]\ndug, PARCA = [], {}\nfor a in kabuk:\n    V = P[a]['V']; c = np.round((V.min(0) + V.max(0)) / 2, 4)\n    mat = 'arayuz' if a.startswith('ARAYUZ__') else P[a]['mat']\n    dug.append(dict(ad=a, V=V - c, F=P[a]['F'], mat=MAL[mat], translation=c))\n    PARCA[a] = dict(c=c.tolist(), m=mat, bb=[np.round(V.min(0), 7).tolist(), np.round(V.max(0), 7).tolist()], g=GOR[a], h=HAR[a])\n    if ROT[a]: PARCA[a]['r'] = ROT[a]\n    if a in KAY: PARCA[a]['k'] = 1\n    if a in KAPAK: PARCA[a]['kapak'] = 1\nyol = os.path.join(OUT, 'k_montaj.glb')\nglbio.yaz(yol, dug, MATS)\nf = open(yol, 'rb').read(); L = struct.unpack('<I', f[12:16])[0]; JJ = json.loads(f[20:20 + L]); rest = f[20 + L:]\nfor nd, d in zip(JJ['nodes'], dug): nd['translation'] = [float(x) for x in d['translation']]\njs = json.dumps(JJ, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\nwhile len(js) % 4: js += b' '\nf = struct.pack('<III', 0x46546C67, 2, 12 + 8 + len(js) + len(rest)) + struct.pack('<II', len(js), 0x4E4F534A) + js + rest\nopen(yol, 'wb').write(f); boy = len(f)\n\n\n# ------------------------------------------------------------------ açınım 2B\ndef cizgi(s, n=10):\n    if s['t'] == 'L': return [s['p'][0], s['p'][1]]\n    if s['t'] == 'A':\n        (x0, y0), (xm, ym), (x1, y1) = s['p']; cx, cy = s['c']; r = s['r']\n        a0 = math.atan2(y0 - cy, x0 - cx); am = math.atan2(ym - cy, xm - cx); a1 = math.atan2(y1 - cy, x1 - cx)\n        def yak(a, b):\n            while a - b > math.pi: a -= 2 * math.pi\n            while b - a > math.pi: a += 2 * math.pi\n            return a\n        am = yak(am, a0); a1 = yak(a1, am)\n        return [[cx + r * math.cos(a0 + (a1 - a0) * i / n), cy + r * math.sin(a0 + (a1 - a0) * i / n)] for i in range(n + 1)]\n    cx, cy = s['c']; r = s['r']\n    return [[cx + r * math.cos(2 * math.pi * i / 24), cy + r * math.sin(2 * math.pi * i / 24)] for i in range(25)]\n\n\ndef kontur(segs):\n    out = []\n    for s in segs:\n        q = cizgi(s)\n        if out and abs(out[-1][0] - q[0][0]) < 1e-6 and abs(out[-1][1] - q[0][1]) < 1e-6: q = q[1:]\n        out += q\n    return [[round(x, 2), round(y, 2)] for x, y in out]\n\n\nACI = []\nSECIM = [('sol_sac_urun_girisi', 1), ('sag_sac_E_penceresi', 1), ('ust_sac', 1), ('arka_sac', 1), ('onyuz_kapak_K', 1), ('onyuz_kapak_K_ic_tava', 1),\n         ('taban_sac_3', 1), ('istasyon_tabani_3', 1), ('govde_kulak_sol_on_841', 26), ('onyuz_kapak_K_karsilik_0', 3), ('kose_dikmesi_20_42_tapa', 4)]\nfor ad, adet in SECIM:\n    d = json.load(open(os.path.join(SRC, 'acinim', ad + '.json'), encoding='utf-8'))\n    bk = [dict(no=b['no'], ad=b['ad'], aci=b['aci'], yon=b['yon'], R=b['R'], c=[[round(v, 2) for v in p] for p in b['cizgi']],\n               s=[[round(v, 2) for v in p] for p in b['baslangic']], e=[[round(v, 2) for v in p] for p in b['bitis']]) for b in d['bukumler']]\n    pem = [dict(c=[round(v, 2) for v in k['merkez_duz']], tip=k.get('pem_tip') or k['tip']) for k in d.get('kesikler', []) if 'pem' in (k.get('tip') or '')]\n    ACI.append(dict(ad=ad, adet=adet, t=d['t'], R=d['R'], levha=d['levha'], dis=kontur(d['dis_kontur']), ek=[kontur(k) for k in d.get('ek_dis_konturlar', [])],\n                    ic=[kontur(k) for k in d['ic_konturlar']], bukum=bk, pem=pem))\n\nsay = {}\nfor a in kabuk:\n    g = 'kaynak' if a in KAY else ('arayuz' if a.startswith('ARAYUZ__') else P[a]['mat'])\n    say[g] = say.get(g, 0) + 1\nOUTJ = dict(surum='k_montaj_v1', tarih='2 Eki 2026', kaynak='sac_pilot_K/K_sac_v1.glb (h3_k_sac_v1)', birim='m', toplam=TOPLAM,\n            kapak_pivot=[4.003, 0.0, 0.079], tasla=TASLA, ghost_t=GHOST_T, adimlar=ADIM, olaylar=OLAY, kamera=KAM, parcalar=PARCA,\n            disarida=dis, acinim=ACI, sayim=dict(kabuk=len(kabuk), dis=len(dis), grup=say), montaj_sirasi=RAP['montaj_sirasi'])\njson.dump(OUTJ, open(os.path.join(OUT, 'k_montaj.json'), 'w', encoding='utf-8'), ensure_ascii=False, separators=(',', ':'))\nprint('kabuk', len(kabuk), 'dışarıda', len(dis), 'GLB %.2f MB' % (boy / 1e6), 'süre %.1f s' % TOPLAM, say)\n"}},"apiBlockIndex":1,"requestId":"req_011Cfd9rWEhzitAxZpyNypRW","attributionAgent":"general-purpose","type":"assistant","uuid":"adb3d179-d810-43ee-ac41-a146e02f40c4","timestamp":"2026-10-02T09:14:24.430Z","advisorModel":"claude-opus-5-5","effort":"m