hopify__graphql_query\nmcp__plugin_small-business_shopify__graphql_schema\nmcp__plugin_small-business_shopify__import-mock-shop-catalog\nmcp__plugin_small-business_shopify__list-customers\nmcp__plugin_small-business_shopify__list-orders\nmcp__plugin_small-business_shopify__open-digital-products-install\nmcp__plugin_small-business_shopify__publish-digital-product\nmcp__plugin_small-business_shopify__run-analytics-query\nmcp__plugin_small-business_shopify__search-collective-product-candidates\nmcp__plugin_small-business_shopify__search_collections\nmcp__plugin_small-business_shopify__search_docs_chunks\nmcp__plugin_small-business_shopify__search_products\nmcp__plugin_small-business_shopify__set-inventory\nmcp__plugin_small-business_shopify__show-collective-products\nmcp__plugin_small-business_shopify__switch-shop\nmcp__plugin_small-business_shopify__test-digital-products-connection\nmcp__plugin_small-business_shopify__update-collection\nmcp__plugin_small-business_shopify__update-product\nmcp__plugin_small-business_shopify__upload-digital-product-file\nmcp__plugin_small-business_shopify__upload-digital-product-media\nmcp__plugin_small-business_shopify__validate_graphql_codeblocks\nmcp__scheduled-tasks__create_scheduled_task\nmcp__scheduled-tasks__delete_scheduled_task\nmcp__scheduled-tasks__list_scheduled_tasks\nmcp__scheduled-tasks__list_task_runs\nmcp__scheduled-tasks__run_scheduled_task\nmcp__scheduled-tasks__update_scheduled_task\nmcp__terminal__list_terminal_tabs\nmcp__terminal__open_terminal_tab\nmcp__terminal__run_in_terminal\nmcp__terminal__stop_terminal_tab\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
