{"parentUuid":"c51f6aa4-e6b6-47a1-b1ab-6fd9971b9665","isSidechain":true,"promptId":"01633ede-b153-4109-b694-6b060ebf89c1","agentId":"ad8753bf7b96395a7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uw327nYtRCbNwHhe6EzNcv","type":"tool_result","content":"1\t/* mekanizma-v3.js · v2 (3 Eki 2026: disiplin vurgusu + MEK3_JSON) · v1 (1 Eki 2026) — MEKANİZMA AĞACI · İSTASYON ALT MONTAJI (makine_v3.html)\n2\t   Kemal: \"istasyon → mekanizma → alt kırılım: K → Sprey (motoru, kablosu, hava parçaları dahil) · Bıçak · E → Kutu katlama …\n3\t   istasyonlar ayrı alt montaj ama tıklayınca açılmıyor\".\n4\t   · Panel: istasyon → mekanizma ağacı. Mekanizmaya basınca yalnız o görünür (diğerleri gizli ya da soluk), altında tür süzgeci\n5\t     (Motor + sürücü · Elektrik güç · Kontrol · Hava · Gıda · Mekanizma · Gövde) GLB'deki üçgen başına \"kat\" etiketinden.\n6\t   · İstasyon kartına ya da 3B'de istasyona tıklayınca o istasyonun alt montajı açılır (yalnız o istasyon + mekanizma ağacı).\n7\t     Açıkken 3B'de bir parçaya tıklamak o parçanın mekanizmasını seçer. Esc / \"Tüm hat\" geri döner.\n8\t   · Üçgen → mekanizma: GLB \"mek\" etiketi (montaj yap_mek_v1 ile) varsa o; yoksa ../hat3d/v3/mekanizma_v3.json \"aralik\" tablosu\n9\t     (mevcut GLB için parça kutularından çıkarıldı). GLB ve paylaşılan betikler (kategori.js, dis-kabuk.js, model3d) değişmez;\n10\t     geometri kategori.js gibi yalnız indis alt kümesiyle değiştirilir, kenar çizgileri seçime göre yeniden hesaplanır.\n11\t   · Motor: window.MEK3 (kapak-gorunum.js de bunu kullanır). */\n12\t(() => {\n13\t  'use strict';\n14\t  const mv = document.getElementById('mv');\n15\t  if (!mv) return;\n16\t  const JSON_YOL = window.MEK3_JSON || '../hat3d/v3/mekanizma_v3.json?v=1';\n17\t  // v2 (3 Eki 2026 · Kemal \"tamam yap\" — gruplama düzeni): window.MEK3_DISIPLIN = true olan sayfada DİSİPLİN düğmeleri modelin üstünde.\n18\t  //   Basılan disiplin(ler) tam renk, geri kalan her şey soluk (gizlenmez); çoklu seçim; ana görünümde ve istasyon görünümünde çalışır.\n19\t  //   Sol menü yalnız montaj ağacı (TÜR süzgeci gizlenir). Ayar yoksa (eski sayfalar) davranış v1 ile aynı.\n20\t  const DISIPLIN = !!window.MEK3_DISIPLIN;\n21\t  const DSP_RENK = {GOVDE: '#8f99a6', MEKANIZMA: '#c9a227', MOTOR: '#7b61d6', SENSOR: '#e0479e', HAVA: '#2f8fd8', SOGUTMA: '#1fa3a0',\n22\t                    ELEKTRIK: '#e07b20', GUC: '#e07b20', KONTROL: '#2f9e44', GIDA: '#d94a3a', ROBOT: '#f08c00', URUN: '#a47551', DUKKAN: '#6c757d'};\n23\t  const vurgu = new Set();            // seçili disiplin (kat indisi) — boşsa vurgu yok\n24\t  const ESIK = Math.cos(30 * Math.PI / 180), Q = 1e4;\n25\t  const KAT_RENK = ['#8f99a6', '#c9a227', '#7b61d6', '#d94a3a', '#2f8fd8', '#1fa3a0', '#e07b20', '#2f9e44', '#f08c00', '#a47551', '#6c757d'];\n26\t  const KAT_SUZGEC = ['MOTOR', 'GUC', 'KONTROL', 'HAVA', 'GIDA', 'SOGUTMA', 'MEKANIZMA', 'GOVDE', 'ROBOT', 'URUN', 'DUKKAN'];\n27\t  const sahne = () => mv[Object.getOwnPropertySymbols(mv).find(s => s.description === 'scene')];\n28\t\n29\t  let D = null, LISTE = [], KATL = [], kayit = [], hazir = false, kuruluyor = null, is = 0;\n30\t  let mod = null;                     // null | {tip:'mek', mek:Set, kat:Set, ist:[…]} | {tip:'kapak'}\n31\t  let hayalet = 'gizle', hayaletMalz = null, kamera0 = null;\n32\t  const dinleyici = [];\n33\t  const bildir = () => dinleyici.forEach(f => { try { f(mod); } catch (e) { console.error(e); } });\n34\t\n35\t  // ------------------------------------------------------------------ kenar çizgileri (kenar-cizgi.js / kategori.js ile AYNI kural)\n36\t  function kenarlar(P, ind) {\n37\t    const anahtar = new Array(P.count), harita = new Map(), out = [];\n38\t    const k = i => anahtar[i] !== undefined ? anahtar[i] : (anahtar[i] = Math.round(P.getX(i) * Q) + ',' + Math.round(P.getY(i) * Q) + ',' + Math.round(P.getZ(i) * Q));\n39\t    for (let f = 0; f + 2 < ind.length; f += 3) {\n40\t      const a = ind[f], b = ind[f + 1], c = ind[f + 2];\n41\t      const ax = P.getX(a), ay = P.getY(a), az = P.getZ(a), ux = P.getX(b) - ax, uy = P.getY(b) - ay, uz = P.getZ(b) - az,\n42\t            wx = P.getX(c) - ax, wy = P.getY(c) - ay, wz = P.getZ(c) - az;\n43\t      let nx = uy * wz - uz * wy, ny = uz * wx - ux * wz, nz = ux * wy - uy * wx; const L = Math.hypot(nx, ny, nz);\n44\t      if (L < 1e-14) continue; nx /= L; ny /= L; nz /= L;\n45\t      const kk = [k(a), k(b), k(c)], iv = [a, b, c];\n46\t      for (let e = 0; e < 3; e++) {\n47\t        const i0 = iv[e], i1 = iv[(e + 1) % 3], k0 = kk[e], k1 = kk[(e + 1) % 3];\n48\t        if (k0 === k1) continue;\n49\t        const h = k0 < k1 ? k0 + '|' + k1 : k1 + '|' + k0, s = harita.get(h);\n50\t        if (s === undefined) harita.set(h, [i0, i1, nx, ny, nz]);\n51\t        else if (s !== null) {\n52\t          if (s[2] * nx + s[3] * ny + s[4] * nz < ESIK) out.push(P.getX(s[0]), P.getY(s[0]), P.getZ(s[0]), P.getX(s[1]), P.getY(s[1]), P.getZ(s[1]));\n53\t          harita.set(h, null);\n54\t        }\n55\t      }\n56\t    }\n57\t    for (const s of harita.values()) if (s) out.push(P.getX(s[0]), P.getY(s[0]), P.getZ(s[0]), P.getX(s[1]), P.getY(s[1]), P.getZ(s[1]));\n58\t    return out;\n59\t  }\n60\t  function kenarGeo(r, ind) {\n61\t    const P = r.g0.attributes.position, d = kenarlar(P, ind), g = new r.g0.constructor(), A = P.constructor;\n62\t    g.setAttribute('position', new A(new Float32Array(d), 3));\n63\t    const nrm = new Float32Array(d.length); for (let j = 1; j < nrm.length; j += 3) nrm[j] = 1;\n64\t    g.setAttribute('normal', new A(nrm, 3)); g.computeBoundingSphere();\n65\t    return g;\n66\t  }\n67\t  const cizgi = r => r.m.children.find(c => c.userData && c.userData.kenarCizgi) || null;\n68\t\n69\t  // ------------------------------------------------------------------ kayıtlar (her ağ: üçgen başına mekanizma · kategori · kapak)\n70\t  function dugumAnahtari(o) {\n71\t    const ad = x => x && x.userData && typeof x.userData.name === 'string' ? x.userData.name : null;\n72\t    if (ad(o)) return ad(o) + '#0';\n73\t    const p = o.parent;\n74\t    if (ad(p) && !p.isMesh) {\n75\t      const prim = p.children.filter(c => c.isMesh && !ad(c) && !(c.userData.kenarCizgi || c.userData.yalitimKesit || c.userData.mekHayalet));\n76\t      return ad(p) + '#' + Math.max(0, prim.indexOf(o));\n77\t    }\n78\t    return (o.name || '') + '#0';\n79\t  }\n80\t  function birimOf(m) {\n81\t    const mm = Array.isArray(m.material) ? m.material[0] : m.material, ad = (mm && mm.name) || '';\n82\t    const r = /^M[A-Z]_(.+?)__/.exec(ad); return [r ? r[1] : '', ad];\n83\t  }\n84\t  function mekIndisi(kod) {\n85\t    let i = LISTE.findIndex(x => x.kod === kod);\n86\t    if (i < 0) { const p = kod.split('/'); LISTE.push({kod, istasyon: p[0], ad: p.slice(1).join('/') || p[0]}); i = LISTE.length - 1; }\n87\t    return i;\n88\t  }\n89\t  function kur() {\n90\t    if (hazir || !D || !mv.loaded) return false;\n91\t    const sc = sahne(); if (!sc) return false;\n92\t    let glbListe = null;\n93\t    sc.traverse(o => { if (!glbListe && o.userData && Array.isArray(o.userData.mekanizmalar)) glbListe = o.userData.mekanizmalar; });\n94\t    const glbMap = glbListe ? glbListe.map(x => mekIndisi(x.kod)) : null;\n95\t    let katListe = null;\n96\t    sc.traverse(o => { if (!katListe && o.userData && Array.isArray(o.userData.kategoriler)) katListe = o.userData.kategoriler; });\n97\t    KATL = katListe || KAT_SUZGEC.map(k => ({kod: k, ad: k}));\n98\t    const bul = []; let glbEtiket = 0, tablo = 0, varsay = 0;\n99\t    sc.traverse(o => {\n100\t      if (!o.isMesh || !o.geometry || !o.geometry.index || (o.userData && (o.userData.kenarCizgi || o.userData.yalitimKesit || o.userData.mekHayalet))) return;\n101\t      const g0 = o.geometry, n = g0.index.count / 3 | 0, gu = g0.userData || {};\n102\t      const mek = new Uint16Array(n), kat = new Uint8Array(n).fill(255), kpk = new Uint8Array(n);\n103\t      const [birim, malAd] = birimOf(o), key = dugumAnahtari(o);\n104\t      if (!birim && !D.aralik[key] && !Array.isArray(gu.mek)) return;    // GLB etiketli her ağ modelin parçasıdır (robot / insan kutuları dahil)                                   // model-viewer'ın kendi ağları (gölge vb.) — modelin parçası değil\n105\t      if (Array.isArray(gu.mek) && glbMap) {                                  // GLB etiketi (montaj yap_mek_v1 sonrası)\n106\t        for (let i = 0; i + 2 < gu.mek.length; i += 3) mek.fill(glbMap[gu.mek[i]], gu.mek[i + 1] / 3, (gu.mek[i + 1] + gu.mek[i + 2]) / 3);\n107\t        if (Array.isArray(gu.kpk)) for (let i = 0; i + 1 < gu.kpk.length; i += 2) kpk.fill(1, gu.kpk[i] / 3, (gu.kpk[i] + gu.kpk[i + 1]) / 3);\n108\t        glbEtiket++;\n109\t      } else if (D.aralik[key]) {                                             // sayfa tablosu (mevcut GLB)\n110\t        const a = D.aralik[key];\n111\t        for (let i = 0; i + 2 < a.length; i += 3) mek.fill(a[i], a[i + 1] / 3, (a[i + 1] + a[i + 2]) / 3);\n112\t        const k = D.kapak[key]; if (k) for (let i = 0; i + 1 < k.length; i += 2) kpk.fill(1, k[i] / 3, (k[i] + k[i + 1]) / 3);\n113\t        tablo++;\n114\t      } else {                                                                // birim varsayılanı\n115\t        mek.fill(mekIndisi(D.birim[birim] || 'Çevre/Diğer'));\n116\t        if (/__on_seffaf$/.test(malAd)) kpk.fill(1);\n117\t        varsay++;\n118\t      }\n119\t      if (Array.isArray(gu.kat)) for (let i = 0; i + 2 < gu.kat.length; i += 3) kat.fill(gu.kat[i], gu.kat[i + 1] / 3, (gu.kat[i + 1] + gu.kat[i + 2]) / 3);\n120\t      const varMek = new Set(mek);\n121\t      bul.push({m: o, g0, n, mek, kat, kpk, varMek, onbellek: new Map(), cz0: undefined, gizli: false, hay: null});\n122\t    });\n123\t    if (!bul.length) return false;\n124\t    kayit = bul; hazir = true;\n125\t    console.info('mekanizma-v3: %d ağ · GLB etiketi %d · tablo %d · birim varsayılanı %d', bul.length, glbEtiket, tablo, varsay);\n126\t    return true;\n127\t  }\n128\t  function bekle() {\n129\t    if (hazir) return Promise.resolve(true);\n130\t    if (kuruluyor) return kuruluyor;\n131\t    kuruluyor = new Promise(res => {\n132\t      const t = setInterval(() => { if (kur()) { clearInterval(t); res(true); } }, 300);\n133\t    });\n134\t    return kuruluyor;\n135\t  }\n136\t\n137\t  // ------------------------------------------------------------------ uygula\n138\t  function altKume(r, sec) {\n139\t    const src = r.g0.index.array; let c = 0;\n140\t    for (let t = 0; t < r.n; t++) if (sec[t]) c++;\n141\t    if (c === r.n) return {tam: true};\n142\t    if (c === 0) return {bos: true};\n143\t    const out = new src.constructor(c * 3), orig = new Uint32Array(c); let o = 0;\n144\t    for (let t = 0; t < r.n; t++) if (sec[t]) { out[o * 3] = src[t * 3]; out[o * 3 + 1] = src[t * 3 + 1]; out[o * 3 + 2] = src[t * 3 + 2]; orig[o++] = t; }\n145\t    const g = new r.g0.constructor();\n146\t    for (const ad of Object.keys(r.g0.attributes)) g.setAttribute(ad, r.g0.attributes[ad]);\n147\t    g.setIndex(new r.g0.index.constructor(out, 1));\n148\t    g.boundingBox = r.g0.boundingBox; g.boundingSphere = r.g0.boundingSphere;\n149\t    return {geo: g, ind: out, orig, kenar: null};\n150\t  }\n151\t  function tersKume(r, sec) {                                               // soluk görünüm için kalan üçgenler\n152\t    const inv = new Uint8Array(r.n); for (let t = 0; t < r.n; t++) inv[t] = sec[t] ? 0 : 1;\n153\t    const a = altKume(r, inv); return a.tam ? {geo: r.g0} : a;\n154\t  }\n155\t  let vurguMalz = null;\n156\t  function hayaletMalzemesi(r) {\n157\t    if (vurgu.size) {                                                       // disiplin vurgusunda bağlam biraz daha görünür (yarı saydam)\n158\t      if (vurguMalz) return vurguMalz;\n159\t      const m0 = Array.isArray(r.m.material) ? r.m.material[0] : r.m.material, m = m0.clone();\n160\t      Object.assign(m, {transparent: true, opacity: 0.05, depthWrite: false, side: 0, map: null, normalMap: null, roughnessMap: null, metalnessMap: null, emissiveMap: null, aoMap: null, metalness: 0, roughness: 1});\n161\t      if (m.color) m.color.setRGB(0.2, 0.23, 0.27); if (m.emissive) m.emissive.setRGB(0, 0, 0);\n162\t      m.name = 'MEK_VURGU_SOLUK'; m.needsUpdate = true; vurguMalz = m; return m;\n163\t    }\n164\t    if (hayaletMalz) return hayaletMalz;\n165\t    const m0 = Array.isArray(r.m.material) ? r.m.material[0] : r.m.material, m = m0.clone();\n166\t    Object.assign(m, {transparent: true, opacity: 0.045, depthWrite: false, side: 0, map: null, normalMap: null, roughnessMap: null, metalnessMap: null, emissiveMap: null, aoMap: null, metalness: 0, roughness: 1});\n167\t    if (m.color) m.color.setRGB(0.42, 0.47, 0.54); if (m.emissive) m.emissive.setRGB(0, 0, 0);\n168\t    m.name = 'MEK_HAYALET'; m.needsUpdate = true; hayaletMalz = m; return m;\n169\t  }\n170\t  function hayaletKoy(r, geo) {\n171\t    if (!geo) { if (r.hay) r.hay.visible = false; return; }\n172\t    if (!r.hay) {\n173\t      const h = new r.m.constructor(geo, hayaletMalzemesi(r));\n174\t      h.userData.mekHayalet = true; h.raycast = () => {}; h.renderOrder = 2; h.name = 'HAYALET_' + (r.m.name || '');\n175\t      r.m.add(h); r.hay = h;\n176\t    }\n177\t    r.hay.material = hayaletMalzemesi(r);\n178\t    r.hay.geometry = geo; r.hay.visible = true;\n179\t  }\n180\t  let kapakGizli = false;                                                   // Kemal 2 Eki: \"Ön kapaklar\" kaydırıcısı tam solda → kapakla HAREKET EDEN her şey (ön sac, iç sac, fitil, menteşe kanadı, bas-aç) gizlenir; gövde kalır\n181\t  function secimDizisi(r) {\n182\t    const sec = new Uint8Array(r.n);\n183\t    if (mod && mod.tip === 'kapak') { for (let t = 0; t < r.n; t++) sec[t] = r.kpk[t]; return sec; }\n184\t    if (!mod) sec.fill(1);\n185\t    else { const M = mod.mek, K = mod.kat; for (let t = 0; t < r.n; t++) if (M.has(r.mek[t]) && (!K.size || K.has(r.kat[t]))) sec[t] = 1; }\n186\t    if (kapakGizli) for (let t = 0; t < r.n; t++) if (r.kpk[t]) sec[t] = 0;\n187\t    return sec;\n188\t  }\n189\t  // görünür kümeden: tam renk (vurgulanan disiplin) + soluk (vurgulanmayan görünür parçalar · 'soluk' modunda seçim dışı)\n190\t  function diziler(r) {\n191\t    const sec = secimDizisi(r);\n192\t    let tam = sec, sol = null;\n193\t    if (vurgu.size) {\n194\t      tam = new Uint8Array(r.n); sol = new Uint8Array(r.n);\n195\t      for (let t = 0; t < r.n; t++) if (sec[t]) { if (vurgu.has(r.kat[t])) tam[t] = 1; else sol[t] = 1; }\n196\t    }\n197\t    if (hayalet === 'soluk' && mod) { sol = sol || new Uint8Array(r.n); for (let t = 0; t < r.n; t++) if (!sec[t]) sol[t] = 1; }\n198\t    return {tam, sol};\n199\t  }\n200\t  function anahtarMod() {\n201\t    const v = vurgu.size ? 'v' + [...vurgu].sort((a, b) => a - b).join(',') + '|' : '';\n202\t    if (!mod) return v + (kapakGizli ? 'tum|kapaksiz' : '');\n203\t    if (mod.tip === 'kapak') return v + 'kapak|' + hayalet;\n204\t    return v + (kapakGizli ? 'kapaksiz|' : '') + [...mod.mek].sort((a, b) => a - b).join(',') + '|' + [...mod.kat].sort((a, b) => a - b).join(',') + '|' + hayalet;\n205\t  }\n206\t  async function guncelle() {\n207\t    if (!hazir) return;\n208\t    const benim = ++is, sc = sahne(), key = anahtarMod(); let hesap = 0;\n209\t    for (const r of kayit) {\n210\t      const cz = cizgi(r);\n211\t      if (cz && r.cz0 === undefined) r.cz0 = r.m.geometry === r.g0 ? cz.geometry : null;\n212\t      if (!mod && !kapakGizli && !vurgu.size) {\n213\t        r.m.geometry = r.g0; if (r.gizli) { r.m.visible = true; r.gizli = false; }\n214\t        if (r.hay) r.hay.visible = false;\n215\t        if (cz) { if (r.cz0 === null) r.cz0 = kenarGeo(r, r.g0.index.array); if (r.cz0) cz.geometry = r.cz0; }\n216\t        continue;\n217\t      }\n218\t      let c = r.onbellek.get(key);\n219\t      if (!c) {\n220\t        // hızlı yol: ağda seçilen mekanizma hiç yoksa\n221\t        const hic = !!mod && mod.tip === 'mek' && ![...r.varMek].some(x => mod.mek.has(x));\n222\t        if (hic) { c = {bos: true}; if (hayalet === 'soluk') c.hay = {geo: r.g0}; }\n223\t        else {\n224\t          const d = diziler(r);\n225\t          c = altKume(r, d.tam);\n226\t          if (d.sol) { const h = altKume(r, d.sol); c.hay = h.bos ? null : (h.tam ? {geo: r.g0} : h); }\n227\t        }\n228\t        r.onbellek.set(key, c);\n229\t      }\n230\t      if (c.bos) {\n231\t        if (c.hay) {                                                            // ağ görünür kalır ama yalnız soluk kopyası çizilir\n232\t          if (r.gizli) { r.m.visible = true; r.gizli = false; }\n233\t          r.m.geometry = BOS(r); if (cz) cz.geometry = BOS(r);\n234\t          hayaletKoy(r, c.hay.geo);\n235\t        } else { if (r.m.visible) { r.m.visible = false; r.gizli = true; } hayaletKoy(r, null); }\n236\t        continue;\n237\t      }\n238\t      if (r.gizli) { r.m.visible = true; r.gizli = false; }\n239\t      if (c.tam) {\n240\t        r.m.geometry = r.g0; hayaletKoy(r, null);\n241\t        if (cz) { if (r.cz0 === null) r.cz0 = kenarGeo(r, r.g0.index.array); if (r.cz0) cz.geometry = r.cz0; }\n242\t        continue;\n243\t      }\n244\t      r.m.geometry = c.geo;\n245\t      hayaletKoy(r, c.hay ? c.hay.geo : null);\n246\t      if (cz) {\n247\t        if (!c.kenar) {\n248\t          c.kenar = kenarGeo(r, c.ind);\n249\t          if (++hesap % 6 === 0) { yazDurum('kenar çizgileri hesaplanıyor…'); if (sc && sc.queueRender) sc.queueRender(); await new Promise(res => setTimeout(res, 0)); if (benim !== is) return; }\n250\t        }\n251\t        cz.geometry = c.kenar;\n252\t      }\n253\t    }\n254\t    if (sc && sc.queueRender) sc.queueRender();\n255\t    yazDurum('');\n256\t  }\n257\t  const bosGeo = new WeakMap();\n258\t  function BOS(r) {\n259\t    let g = bosGeo.get(r.g0);\n260\t    if (!g) {\n261\t      g = new r.g0.constructor(); for (const ad of Object.keys(r.g0.attributes)) g.setAttribute(ad, r.g0.attributes[ad]);\n262\t      g.setIndex(new r.g0.index.constructor(new r.g0.index.array.constructor(0), 1)); g.boundingSphere = r.g0.boundingSphere; g.boundingBox = r.g0.boundingBox;\n263\t      bosGeo.set(r.g0, g);\n264\t    }\n265\t    return g;\n266\t  }\n267\t  let durumEl = null;\n268\t  const yazDurum = t => { if (durumEl) durumEl.textContent = t || ozetYazi(); };\n269\t\n270\t  // diğer görünümleri kapat (aynı ağları değiştiriyorlar)\n271\t  function digerleriniKapat() {\n272\t    const dk = document.getElementById('dis-kabuk');\n273\t    if (dk && dk.getAttribute('aria-pressed') === 'true') dk.click();\n274\t    const hepsi = document.querySelector('#kat-dugmeler button');\n275\t    if (hepsi && hepsi.getAttribute('aria-pressed') === 'false') hepsi.click();\n276\t  }\n277\t  let kapiDurumu = null;\n278\t  function kapiSaydamligi(ac) {                                            // kapak görünümünde ön kapaklar metal (opak) olsun\n279\t    const k = [...document.querySelectorAll('.m3ar input[type=\"range\"]')].find(e => (e.title || '').includes('metal kapak'));\n280\t    if (!k) return;\n281\t    if (ac) { if (kapiDurumu === null) kapiDurumu = k.value; k.value = '100'; k.dispatchEvent(new Event('input', {bubbles: true})); }\n282\t    else if (kapiDurumu !== null) { k.value = kapiDurumu; kapiDurumu = null; k.dispatchEvent(new Event('input', {bubbles: true})); }\n283\t  }\n284\t  let golge0 = null;\n285\t  function golge(ac) {\n286\t    if (golge0 === null) golge0 = mv.shadowIntensity;\n287\t    mv.shadowIntensity = ac ? golge0 : 0;\n288\t  }\n289\t  async function ayarla(yeni) {\n290\t    await bekle();\n291\t    if (yeni) digerleriniKapat();\n292\t    const eskiKapak = mod && mod.tip === 'kapak';\n293\t    mod = yeni;\n294\t    golge(!mod);                                                            // Kemal 2 Eki: istasyon/mekanizma görünümünde zemin yok → gölge düzleminin kenarı boşlukta çizgi gibi görünüyordu\n295\t    if (eskiKapak && !(mod && mod.tip === 'kapak')) kapiSaydamligi(false);\n296\t    if (mod && mod.tip === 'kapak') kapiSaydamligi(true);\n297\t    bildir();\n298\t    await guncelle();\n299\t  }\n300\t  // kategori / dış kabuk düğmesine basılınca önce bu görünüm kapanır\n301\t  document.addEventListener('click', e => {\n302\t    if (!(mod || vurgu.size) || !e.target || !e.target.closest) return;\n303\t    if (e.target.closest('#kat-dugmeler button') || e.target.closest('#dis-kabuk')) { mod = null; vurgu.clear(); kapiSaydamligi(false); bildir(); disiplinBoya(); guncelle(); }\n304\t  }, true);\n305\t  // model-viewer 'load' aynı model için ikinci kez gelebiliyor; dis-kabuk.js o anda ağların geometrisini \"asıl\" diye saklıyor →\n306\t  // seçim/vurgu açıksa önce asıl geometriler geri konur (yakalama evresi = dis-kabuk'tan önce), görünüm hemen ardından yeniden uygulanır.\n307\t  document.addEventListener('load', e => {\n308\t    if (e.target !== mv || !hazir || !(mod || kapakGizli || vurgu.size)) return;\n309\t    const sc = sahne();\n310\t    if (!(sc && kayit.length && kayit.every(r => { let o = r.m; while (o.parent) o = o.parent; return o === sc; }))) return;\n311\t    for (const r of kayit) { r.m.geometry = r.g0; if (r.gizli) { r.m.visible = true; r.gizli = false; } if (r.hay) r.hay.visible = false; }\n312\t    setTimeout(() => guncelle(), 0);\n313\t  }, true);\n314\t\n315\t  // ------------------------------------------------------------------ DİSİPLİN düğmeleri (yalnız MEK3_DISIPLIN sayfalarında)\n316\t  const DSP_CSS = `\n317\t  .dsp{position:absolute;top:12px;left:150px;right:150px;z-index:5;display:flex;flex-wrap:wrap;justify-content:center;gap:4px;\n318\t       margin:0 auto;width:fit-content;padding:5px;border-radius:14px;background:rgba(21,24,29,.62);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}\n319\t  .dsp button{display:inline-flex;align-items:center;gap:6px;border:1px solid #39424f;background:rgba(35,41,50,.92);color:#dce3ea;border-radius:999px;\n320\t       padding:4px 10px;font:600 11.5px/1.2 system-ui,sans-serif;cursor:pointer;white-space:nowrap;transition:background .12s,border-color .12s}\n321\t  .m3 .et{top:76px}\n322\t  .dsp button:hover{border-color:#6b7889;color:#fff}\n323\t  .dsp button i{width:8px;height:8px;border-radius:50%;flex:none;background:var(--r)}\n324\t  .dsp button[aria-pressed=true]{background:var(--r);border-color:var(--r);color:#fff}\n325\t  .dsp button[aria-pressed=true] i{background:#fff}\n326\t  .dsp button.hep[aria-pressed=true]{background:#e6ebf0;border-color:#e6ebf0;color:#15181d}\n327\t  @media (max-width:760px){.dsp{top:auto;bottom:10px;left:8px;right:62px;width:auto;flex-wrap:nowrap;justify-content:flex-start;\n328\t       overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}.dsp::-webkit-scrollbar{display:none}.dsp button{padding:7px 12px}}`;\n329\t  let DSP = null;\n330\t  function disiplinKur() {\n331\t    if (!DISIPLIN || !hazir) return;\n332\t    if (!DSP) {\n333\t      const st = el('style'); st.textContent = DSP_CSS; document.head.appendChild(st);\n334\t      DSP = el('div', 'dsp'); DSP.id = 'disiplin'; DSP.setAttribute('role', 'toolbar'); DSP.setAttribute('aria-label', 'Disiplin vurgusu');\n335\t      DSP.addEventListener('pointerdown', e => e.stopPropagation()); DSP.addEventListener('dblclick', e => e.stopPropagation());\n336\t      mv.appendChild(DSP);\n337\t    }\n338\t    const say = new Map();\n339\t    for (const r of kayit) for (let t = 0; t < r.n; t++) say.set(r.kat[t], (say.get(r.kat[t]) || 0) + 1);\n340\t    DSP.textContent = '';\n341\t    const h = el('button', 'hep', 'Hepsi'); h.type = 'button'; h.title = 'vurguyu kaldır (her şey normal renk)'; h.dataset.k = '-1';\n342\t    h.onclick = () => disiplinSec(-1); DSP.append(h);\n343\t    KATL.forEach((k, i) => {\n344\t      if (!say.get(i)) return;\n345\t      const b = el('button', null, '<i></i>' + (k.ad || k.kod)); b.type = 'button'; b.dataset.k = String(i);\n346\t      b.style.setProperty('--r', DSP_RENK[k.kod] || '#4f86ff');\n347\t      b.title = (k.icerik || '') + (k.kime ? ' · kime: ' + k.kime : '') + ' · ' + say.get(i).toLocaleString('tr-TR') + ' üçgen · bas: yalnız bu tam renk, diğerleri soluk · birden çok seçilebilir';\n348\t      b.onclick = () => disiplinSec(i); DSP.append(b);\n349\t    });\n350\t    disiplinBoya();\n351\t  }\n352\t  function disiplinBoya() {\n353\t    if (!DSP) return;\n354\t    DSP.querySelectorAll('button').forEach(b => { const i = +b.dataset.k; b.setAttribute('aria-pressed', String(i === -1 ? !vurgu.size : vurgu.has(i))); });\n355\t  }\n356\t  async function disiplinSec(i) {\n357\t    await bekle();\n358\t    if (i === -1) vurgu.clear(); else if (vurgu.has(i)) vurgu.delete(i); else vurgu.add(i);\n359\t    const dk = document.getElementById('dis-kabuk');\n360\t    if (vurgu.size && dk && dk.getAttribute('aria-pressed') === 'true') dk.click();   // dış kabuk aynı ağları değiştirir → önce kapanır\n361\t    disiplinBoya(); yazDurum(''); await guncelle();\n362\t  }\n363\t\n364\t  // ------------------------------------------------------------------ kamera\n365\t  function cerceve(kodlar) {\n366\t    if (!D || !D.kutu) return;\n367\t    let b = null;\n368\t    kodlar.forEach(k => { const x = D.kutu[k]; if (!x) return; b = b ? [Math.min(b[0], x[0]), Math.max(b[1], x[1]), Math.min(b[2], x[2]), Math.max(b[3], x[3]), Math.min(b[4], x[4]), Math.max(b[5], x[5])] : x.slice(); });\n369\t    if (!b) return;\n370\t    if (!kamera0) kamera0 = {t: mv.getAttribute('camera-target'), o: mv.getAttribute('camera-orbit'), min: mv.getAttribute('min-camera-orbit')};\n371\t    const c = [(b[0] + b[1]) / 2, (b[2] + b[3]) / 2, (b[4] + b[5]) / 2];\n372\t    const cap = Math.hypot(b[1] - b[0], b[3] - b[2], b[5] - b[4]);\n373\t    const fov = (parseFloat(mv.getAttribute('field-of-view')) || 30) * Math.PI / 180;\n374\t    const d = Math.max(0.5, cap * 0.62 / Math.tan(fov / 2));\n375\t    const o = mv.getCameraOrbit();\n376\t    mv.minCameraOrbit = 'auto auto 0.2m';\n377\t    mv.cameraTarget = c[0].toFixed(3) + 'm ' + c[1].toFixed(3) + 'm ' + c[2].toFixed(3) + 'm';\n378\t    mv.cameraOrbit = o.theta + 'rad ' + o.phi + 'rad ' + d.toFixed(2) + 'm';\n379\t  }\n380\t  function kameraGeri() {\n381\t    if (!kamera0) return;\n382\t    mv.cameraTarget = kamera0.t || 'auto auto auto';\n383\t    const o = mv.getCameraOrbit();\n384\t    const r = (kamera0.o || '').split(/\\s+/)[2] || 'auto';\n385\t    mv.cameraOrbit = o.theta + 'rad ' + o.phi + 'rad ' + r;\n386\t  }\n387\t\n388\t  // ------------------------------------------------------------------ seçim (istasyon / mekanizma / tür)\n389\t  const istAd = k => { const s = D && D.istasyon.find(x => x.kod === k); return s ? s.ad : k; };\n390\t  const mekleri = ist => LISTE.map((m, i) => [m, i]).filter(([m]) => ist.indexOf(m.istasyon) >= 0).map(([, i]) => i);\n391\t  function istasyonAc(ist, kamera = true) {\n392\t    ist = [].concat(ist);\n393\t    const mek = new Set(mekleri(ist));\n394\t    ayarla({tip: 'mek', mek, kat: new Set(), ist, sec: null});\n395\t    if (kamera) cerceve(LISTE.filter((m, i) => mek.has(i)).map(m => m.kod));\n396\t    hashYaz('ist=' + ist.join(','));\n397\t  }\n398\t  function mekanizmaSec(i, kamera = true) {\n399\t    const m = LISTE[i]; if (!m) return;\n400\t    const ist = mod && mod.tip === 'mek' && mod.ist ? mod.ist : [m.istasyon];\n401\t    ayarla({tip: 'mek', mek: new Set([i]), kat: new Set(), ist: ist.indexOf(m.istasyon) >= 0 ? ist : [m.istasyon], sec: i});\n402\t    if (kamera) cerceve([m.kod]);\n403\t    hashYaz('mek=' + m.kod);\n404\t  }\n405\t  function katSec(k) {\n406\t    if (!mod || mod.tip !== 'mek') return;\n407\t    const kat = new Set(mod.kat); if (k === -1) kat.clear(); else if (kat.has(k)) kat.delete(k); else kat.add(k);\n408\t    ayarla(Object.assign({}, mod, {kat}));\n409\t  }\n410\t  function hepsi() { ayarla(null); kameraGeri(); hashYaz(''); }\n411\t  function hashYaz(h) { try { history.replaceState(null, '', h ? '#' + encodeURI(h) : location.pathname + location.search); } catch (e) {} }\n412\t\n413\t  function ozetYazi() {\n414\t    const v = vurgu.size ? ' · vurgu: ' + [...vurgu].map(i => (KATL[i] && (KATL[i].ad || KATL[i].kod)) || i).join(' + ') : '';\n415\t    return ozetYazi0() + v;\n416\t  }\n417\t  function ozetYazi0() {\n418\t    if (!mod) return DISIPLIN ? 'İstasyon başlığına bas ya da 3B\\'de istasyona çift tıkla.' : 'Bir istasyona ya da mekanizmaya bas · 3B\\'de istasyona tıkla.';\n419\t    if (mod.tip === 'kapak') return 'Yalnız kapaklar: ön kapaklar · kanatlar · servis / düşer kapaklar · çekmece önleri (menteşe + basaç dahil).';\n420\t    const ad = mod.sec != null ? istAd(LISTE[mod.sec].istasyon) + ' › ' + LISTE[mod.sec].ad : mod.ist.map(istAd).join(' + ') + ' · alt montaj';\n421\t    const k = mod.kat.size ? ' · ' + [...mod.kat].map(i => (KATL[i] && (KATL[i].ad || KATL[i].kod)) || i).join(' + ') : '';\n422\t    return ad + k;\n423\t  }\n424\t\n425\t  // ------------------------------------------------------------------ PANEL\n426\t  const CSS = `\n427\t  .mk{padding:0 16px 6px;color:#dce3ea;font:13px/1.4 system-ui,sans-serif}\n428\t  .mk .mk-ust{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:0 0 8px}\n429\t  .mk button{border:1px solid #39424f;background:#232932;color:#cfd6df;border-radius:8px;padding:5px 10px;font:600 12.5px system-ui,sans-serif;cursor:pointer}\n430\t  .mk button:hover{border-color:#4f86ff;color:#fff}\n431\t  .mk button[aria-pressed=true]{background:#4f86ff;border-color:#4f86ff;color:#fff}\n432\t  .mk .mk-hay{display:inline-flex;gap:0;margin-left:auto}.mk .mk-hay button{border-radius:0;padding:5px 8px;font-size:11.5px}\n433\t  .mk .mk-hay button:first-child{border-radius:8px 0 0 8px}.mk .mk-hay button:last-child{border-radius:0 8px 8px 0;border-left:0}\n434\t  .mk .mk-yol{min-height:18px;margin:2px 0 8px;color:#ffd978;font-weight:600}\n435\t  .mk .mk-tur{display:none;flex-wrap:wrap;gap:5px;margin:0 0 10px}.mk .mk-tur.on{display:flex}\n436\t  .mk .mk-tur button{border-radius:999px;padding:3px 9px;font-size:11.5px}\n437\t  .mk .mk-tur span{color:#8d97a4;font:700 11px system-ui;letter-spacing:.05em;align-self:center;margin-right:2px}\n438\t  .mk details{border:1px solid #2f3742;border-radius:10px;margin:0 0 6px;background:#1f252d}\n439\t  .mk details[open]{border-color:#3d4a5c}\n440\t  .mk summary{list-style:none;cursor:pointer;padding:8px 10px;display:flex;align-items:center;gap:8px;font-weight:700;color:#e6ebf0}\n441\t  .mk summary::-webkit-details-marker{display:none}\n442\t  .mk summary i{font-style:normal;color:#8d97a4;transition:transform .15s}.mk details[open] summary i{transform:rotate(90deg)}\n443\t  .mk summary small{margin-left:auto;color:#8d97a4;font-weight:500;font-size:11.5px}\n444\t  .mk summary.ak{color:#ffd978}\n445\t  .mk .mk-l{display:flex;flex-direction:column;gap:3px;padding:0 8px 8px 26px}\n446\t  .mk .mk-l button{display:flex;justify-content:space-between;gap:8px;text-align:left;border-color:#2f3742;background:#232932;font-weight:600}\n447\t  .mk .mk-l button small{color:#8d97a4;font-weight:500}\n448\t  .mk .mk-l button[aria-pressed=true]{background:#4f86ff;border-color:#4f86ff;color:#fff}\n449\t  .mk .mk-l button[aria-pressed=true] small{color:#e6ecff}\n450\t  .mk .mk-not{color:#6d7682;font-size:11.5px;margin:6px 0 0}\n451\t  @media (max-width:760px){.mk button{padding:7px 11px}}`;\n452\t  function el(t, c, h) { const e = document.createElement(t); if (c) e.className = c; if (h != null) e.innerHTML = h; return e; }\n453\t  let P = {};\n454\t  function panelKur() {\n455\t    if (P.kok) return;\n456\t    const st = el('style'); st.textContent = CSS; document.head.appendChild(st);\n457\t    const kok = el('div', 'mk'); kok.id = 'mek-panel';\n458\t    const ust = el('div', 'mk-ust');\n459\t    const tum = el('button', null, 'Tüm hat'); tum.type = 'button'; tum.title = 'seçimi kaldır, bütün hattı göster (Esc)'; tum.onclick = hepsi;\n460\t    const hay = el('span', 'mk-hay');\n461\t    const hg = el('button', null, 'diğerleri gizli'), hs = el('button', null, 'soluk');\n462\t    hg.type = hs.type = 'button'; hg.title = 'seçilmeyen parçalar görünmez'; hs.title = 'seçilmeyen parçalar soluk (yer algısı için)';\n463\t    const hayBoya = () => { hg.setAttribute('aria-pressed', String(hayalet === 'gizle')); hs.setAttribute('aria-pressed', String(hayalet === 'soluk')); };\n464\t    hg.onclick = () => { hayalet = 'gizle'; hayBoya(); if (mod) guncelle(); };\n465\t    hs.onclick = () => { hayalet = 'soluk'; hayBoya(); if (mod) guncelle(); };\n466\t    hayBoya(); hay.append(hg, hs);\n467\t    ust.append(tum); P.kapakYeri = el('span'); ust.append(P.kapakYeri, hay);\n468\t    const yol = el('div', 'mk-yol'); yol.setAttribute('role', 'status');\n469\t    const tur = el('div', 'mk-tur');\n470\t    const agac = el('div', 'mk-agac', '<div class=\"mk-not\">Mekanizma tablosu yükleniyor…</div>');\n471\t    const not = el('div', 'mk-not', DISIPLIN ? 'İstasyon başlığına bas ya da 3B\\'de istasyona çift tıkla: istasyon tam montajıyla açılır. Üniteye bas: yalnız o ünite (motoru, sensörü, silindiri içinde; kablosu istasyonun Elektrik ünitesinde). Disiplin vurgusu (Motor · Sensör · Hava · Elektrik …) modelin üstündeki düğmelerden.' : 'İstasyon başlığına bas: alt montaj açılır. Mekanizmaya bas: yalnız o (motoru, kablosu, hava parçaları dahil). Açık istasyonda 3B\\'de parçaya tıkla: mekanizması seçilir.');\n472\t    kok.append(ust, yol, tur, agac, not);\n473\t    P = Object.assign(P, {kok, yol, tur, agac, tum});\n474\t    durumEl = yol;\n475\t    // yerleşim: yan panel varsa \"Görünüm\"den sonra kendi bölümü, yoksa kategori çubuğunun altına\n476\t    const yerlestir = () => {\n477\t      const ic = document.querySelector('#yan .yan-ic');\n478\t      if (ic) {\n479\t        const s = el('section', 'yan-grp'); s.id = 'mek-grp';\n480\t        s.append(el('h3', null, DISIPLIN ? 'Montaj ağacı · istasyon → ünite' : 'Mekanizma · istasyon alt montajı'), kok);\n481\t        const gor = [...ic.querySelectorAll('.yan-grp')].find(x => (x.querySelector('h3') || {}).textContent === 'Görünüm');\n482\t        if (gor && gor.nextSibling) ic.insertBefore(s, gor.nextSibling); else ic.appendChild(s);\n483\t        return true;\n484\t      }\n485\t      return false;\n486\t    };\n487\t    if (!yerlestir()) {\n488\t      const kc = document.getElementById('kat-cubuk');\n489\t      (kc ? kc.parentNode : mv.parentNode).insertBefore(kok, kc ? kc.nextSibling : mv.nextSibling);\n490\t      setTimeout(() => { if (!document.getElementById('mek-grp') && document.querySelector('#yan .yan-ic')) { kok.remove(); yerlestir(); } }, 500);\n491\t    }\n492\t    dinleyici.push(panelBoya);\n493\t    yazDurum('');\n494\t  }\n495\t  function agacKur() {\n496\t    const parcaSay = {};\n497\t    Object.values(D.parca).forEach(k => { parcaSay[k] = (parcaSay[k] || 0) + 1; });\n498\t    P.agac.textContent = '';\n499\t    P.det = {}; P.mekBtn = {};\n500\t    D.istasyon.forEach(s => {\n501\t      const ids = mekleri([s.kod]); if (!ids.length) return;\n502\t      const d = el('details'); d.dataset.ist = s.kod;\n503\t      const sm = el('summary', null, '<i>›</i>' + s.ad + '<small>' + ids.length + (DISIPLIN ? ' ünite' : ' mekanizma') + '</small>');\n504\t      sm.title = s.ad + ' alt montajını aç';\n505\t      sm.onclick = e => { e.preventDefault(); const acik = mod && mod.tip === 'mek' && mod.sec == null && mod.ist.length === 1 && mod.ist[0] === s.kod; if (acik) { d.open = !d.open; return; } istasyonAc(s.kod); };\n506\t      const l = el('div', 'mk-l');\n507\t      ids.forEach(i => {\n508\t        const m = LISTE[i], b = el('button', null, '<span>' + m.ad + '</span><small>' + (parcaSay[m.kod] ? parcaSay[m.kod] + ' parça' : '') + '</small>');\n509\t        b.type = 'button'; b.dataset.mek = m.kod; b.title = m.kod;\n510\t        b.onclick = () => { if (mod && mod.tip === 'mek' && mod.sec === i) istasyonAc(mod.ist); else mekanizmaSec(i); };\n511\t        l.appendChild(b); P.mekBtn[i] = b;\n512\t      });\n513\t      d.append(sm, l); P.agac.appendChild(d); P.det[s.kod] = d;\n514\t    });\n515\t    panelBoya();\n516\t  }\n517\t  function panelBoya() {\n518\t    if (!P.kok) return;\n519\t    yazDurum('');\n520\t    const mm = mod && mod.tip === 'mek' ? mod : null;\n521\t    Object.entries(P.det || {}).forEach(([k, d]) => {\n522\t      const ak = !!(mm && mm.ist.indexOf(k) >= 0);\n523\t      if (ak) d.open = true; else if (mm) d.open = false;\n524\t      d.querySelector('summary').classList.toggle('ak', ak && mm.sec == null);\n525\t    });\n526\t    Object.entries(P.mekBtn || {}).forEach(([i, b]) => b.setAttribute('aria-pressed', String(!!(mm && mm.sec === +i))));\n527\t    P.tum.setAttribute('aria-pressed', String(!mod));\n528\t    // tür süzgeci: seçimdeki kategoriler (üçgen sayısıyla)\n529\t    P.tur.classList.toggle('on', !!mm && !DISIPLIN);                         // disiplin düğmeli sayfada sol menü yalnız montaj ağacı\n530\t    if (mm && !DISIPLIN) {\n531\t      const say = new Map();\n532\t      for (const r of kayit) {\n533\t        if (![...r.varMek].some(x => mm.mek.has(x))) continue;\n534\t        for (let t = 0; t < r.n; t++) if (mm.mek.has(r.mek[t])) say.set(r.kat[t], (say.get(r.kat[t]) || 0) + 1);\n535\t      }\n536\t      P.tur.textContent = '';\n537\t      P.tur.append(el('span', null, 'TÜR'));\n538\t      const h = el('button', null, 'Hepsi'); h.type = 'button'; h.setAttribute('aria-pressed', String(!mm.kat.size)); h.onclick = () => katSec(-1); P.tur.append(h);\n539\t      KAT_SUZGEC.forEach(kod => {\n540\t        const i = KATL.findIndex(x => x.kod === kod); if (i < 0 || !say.get(i)) return;\n541\t        const b = el('button', null, (KATL[i].ad || kod)); b.type = 'button';\n542\t        const ak = mm.kat.has(i); b.setAttribute('aria-pressed', String(ak));\n543\t        if (ak) { b.style.background = KAT_RENK[i % KAT_RENK.length]; b.style.borderColor = KAT_RENK[i % KAT_RENK.length]; }\n544\t        b.title = (KATL[i].icerik || '') + ' · ' + say.get(i).toLocaleString('tr-TR') + ' üçgen';\n545\t        b.onclick = () => katSec(i); P.tur.append(b);\n546\t      });\n547\t    }\n548\t  }\n549\t\n550\t  // ------------------------------------------------------------------ \"Ön kapaklar\" kaydırıcısı: tam solda kapak takımları tamamen gizli\n551\t  document.addEventListener('input', async e => {\n552\t    const k = e.target; if (!k || k.type !== 'range' || !((k.title || '').includes('metal kapak'))) return;\n553\t    const yeni = +k.value <= 0; if (yeni === kapakGizli) return;\n554\t    kapakGizli = yeni; await bekle(); guncelle();\n555\t  }, true);\n556\t  // ------------------------------------------------------------------ istasyon kartları + 3B tıklama\n557\t  function kartlar() {\n558\t    document.querySelectorAll('.secim a[data-k]').forEach(a => {\n559\t      if (a.dataset.mekKur) return; a.dataset.mekKur = '1';\n560\t      a.style.cursor = 'pointer'; a.title = 'tıkla: istasyon alt montajını aç';\n561\t      a.addEventListener('click', e => {\n562\t        e.preventDefault();\n563\t        const ist = D.istasyon.filter(s => s.modul.indexOf(a.dataset.k) >= 0).map(s => s.kod);\n564\t        if (ist.length) { istasyonAc(ist); odakla(ist[0]); }\n565\t      });\n566\t    });\n567\t  }\n568\t  let bas = null, surukle = false;\n569\t  mv.addEventListener('pointerdown', e => { bas = [e.clientX, e.clientY]; surukle = false; });\n570\t  mv.addEventListener('pointermove', e => { if (bas && Math.hypot(e.clientX - bas[0], e.clientY - bas[1]) > 6) surukle = true; });\n571\t  function olcuAcik() { return [...document.querySelectorAll('.m3ar button')].some(b => b.classList.contains('on') && /Ölçü/.test(b.textContent)); }\n572\t  function isabet(x, y) {\n573\t    const sc = sahne(); if (!sc || !sc.getNDC || !sc.hitFromPoint) return null;\n574\t    try { const h = sc.hitFromPoint(sc.getNDC(x, y)); return h && h.object && h.object.isMesh ? h : null; } catch (e) { return null; }\n575\t  }\n576\t  mv.addEventListener('dblclick', async e => {                               // Kemal 2 Eki: ÇİFT tık = istasyonu tam alt montajıyla aç; açıkken tık bir şey gizlemez (gizle/aç sol menüden)\n577\t    if (surukle || !D || olcuAcik()) return;\n578\t    await bekle();\n579\t    if (mod && mod.tip === 'mek') return;\n580\t    if (mod) return;                                                        // kapak görünümünde tıklama bir şey açmaz\n581\t    let istasyon = null;\n582\t    const h = isabet(e.clientX, e.clientY);\n583\t    if (h) { const r = kayit.find(x => x.m === h.object); if (r && h.faceIndex != null && r.m.geometry === r.g0) istasyon = LISTE[r.mek[h.faceIndex]] && LISTE[r.mek[h.faceIndex]].istasyon; }\n584\t    if (!istasyon) {\n585\t      const m = mv.materialFromPoint(e.clientX, e.clientY);\n586\t      const rr = m && /^M[A-Z]_(.+?)__/.exec(m.name || '');\n587\t      const k = rr && D.birim[rr[1]]; if (k) istasyon = k.split('/')[0];\n588\t    }\n589\t    if (istasyon && istasyon !== 'Çevre') { istasyonAc(istasyon); odakla(istasyon); }\n590\t  });\n591\t  function odakla(ist) {                                                    // panelde açılan istasyonun ağacı görünsün\n592\t    setTimeout(() => { const d = P.det && P.det[ist]; if (d && d.scrollIntoView) d.scrollIntoView({block: 'nearest', behavior: 'smooth'}); }, 60);\n593\t  }\n594\t  document.addEventListener('keydown', e => { if (e.key === 'Escape' && mod && !/INPUT|TEXTAREA/.test((e.target || {}).tagName || '')) hepsi(); });\n595\t\n596\t  // ------------------------------------------------------------------ yükleme\n597\t  mv.addEventListener('load', () => setTimeout(() => {\n598\t    const sc = sahne();\n599\t    const ayni = sc && kayit.length && kayit.every(r => { let o = r.m; while (o.parent) o = o.parent; return o === sc; });\n600\t    if (ayni) return;\n601\t    hazir = false; kuruluyor = null; kayit = []; mod = null; vurgu.clear(); bildir(); bekle().then(() => { if (P.agac && D) agacKur(); disiplinKur(); });\n602\t  }, 350));\n603\t  function basla() {\n604\t    panelKur();\n605\t    fetch(JSON_YOL).then(r => { if (!r.ok) throw Error('mekanizma tablosu yüklenemedi'); return r.json(); }).then(d => {\n606\t      D = d; LISTE = d.liste.slice();\n607\t      agacKur(); kartlar(); new MutationObserver(kartlar).observe(document.body, {childList: true, subtree: true});\n608\t      bekle().then(() => {\n609\t        agacKur(); disiplinKur();\n610\t        const ks = [...document.querySelectorAll('.m3ar input[type=\"range\"]')].find(e => (e.title || '').includes('metal kapak'));\n611\t        if (ks && +ks.value <= 0) { kapakGizli = true; guncelle(); }\n612\t        const h = decodeURI((location.hash || '').slice(1));\n613\t        if (/^mek=/.test(h)) { const i = LISTE.findIndex(m => m.kod === h.slice(4)); if (i >= 0) mekanizmaSec(i); }\n614\t        else if (/^ist=/.test(h)) istasyonAc(h.slice(4).split(','));\n615\t      });\n616\t    }).catch(err => { P.agac.innerHTML = '<div class=\"mk-not\">' + err.message + '</div>'; });\n617\t  }\n618\t  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', basla); else basla();\n619\t\n620\t  window.MEK3 = {\n621\t    bekle, ayarla, hepsi, istasyonAc, mekanizmaSec,\n622\t    mod: () => mod, dinle: f => dinleyici.push(f),\n623\t    kapakYeri: () => P.kapakYeri,\n624\t    _kayit: () => kayit, _liste: () => LISTE, vurgu: () => [...vurgu], disiplinSec\n625\t  };\n626\t})();\n627\t"}]},"uuid":"fc1e6f62-4cc8-4168-bde4-cff5e9662503","timestamp":"2026-10-03T09:56:41.995Z","sourceToolAssistantUUID":"c51f6aa4-e6b6-47a1-b1ab-6fd9971b9665","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
