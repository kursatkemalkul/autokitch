{"parentUuid":"e9b82c4f-d88f-451b-9230-3c7897d4ab67","isSidechain":true,"promptId":"8ab0b358-39d9-46a5-be1d-dc045a5a9a22","agentId":"a030e1e7d594f95d4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YYMaVCh2mGdg58gSvtJk3h","type":"tool_result","content":" 80758 /c/Users/Kemal/AppData/Local/Temp/claude/C--Users-Kemal-Desktop-Kemal-WEBS-TE/f3ef876a-f062-4b29-bb81-775cc8a1a6d8/scratchpad/sac_standart/GOVDE_MEVCUT_DENETIM_v1.md\n 39945 /c/Users/Kemal/AppData/Local/Temp/claude/C--Users-Kemal-Desktop-Kemal-WEBS-TE/f3ef876a-f062-4b29-bb81-775cc8a1a6d8/scratchpad/sac_standart/GOVDE_SAC_STANDARDI_v1.md\n180158 /c/Users/Kemal/AppData/Local/Temp/claude/C--Users-Kemal-Desktop-Kemal-WEBS-TE/f3ef876a-f062-4b29-bb81-775cc8a1a6d8/scratchpad/sac_standart/_govde_tablo.json\n   679 /c/Users/Kemal/AppData/Local/Temp/claude/C--Users-Kemal-Desktop-Kemal-WEBS-TE/f3ef876a-f062-4b29-bb81-775cc8a1a6d8/scratchpad/sac_standart/_sig.py\n 10296 /c/Users/Kemal/AppData/Local/Temp/claude/C--Users-Kemal-Desktop-Kemal-WEBS-TE/f3ef876a-f062-4b29-bb81-775cc8a1a6d8/scratchpad/sac_standart/q_govde_tablo.py\n   712 /c/Users/Kemal/AppData/Local/Temp/claude/C--Users-Kemal-Desktop-Kemal-WEBS-TE/f3ef876a-f062-4b29-bb81-775cc8a1a6d8/scratchpad/sac_standart/q_liste.py\n  3916 /c/Users/Kemal/AppData/Local/Temp/claude/C--Users-Kemal-Desktop-Kemal-WEBS-TE/f3ef876a-f062-4b29-bb81-775cc8a1a6d8/scratchpad/sac_standart/q_md_tablo.py\n 12306 /c/Users/Kemal/AppData/Local/Temp/claude/C--Users-Kemal-Desktop-Kemal-WEBS-TE/f3ef876a-f062-4b29-bb81-775cc8a1a6d8/scratchpad/sac_standart/yap_sac_standart_json.py\n328770 total\n# -*- coding: utf-8 -*-\n\"\"\"sac_standart_v1.json üretir (GOVDE_SAC_STANDARDI_v1.md ile aynı sayılar). Birim: mm, derece, kN.\"\"\"\nimport json, math, os\n\nHERE = os.path.dirname(os.path.abspath(__file__))\n\n# kalınlık -> (V kalıp, K) ; R_ic = 1.5 t\nTABLO = {0.8: (6, 0.41), 1.0: (8, 0.45), 1.2: (10, 0.45), 1.5: (12, 0.45), 2.0: (16, 0.41), 3.0: (24, 0.41)}\nBARTIN_BD = {0.8: 1.60, 1.0: 1.93, 1.5: 2.90, 2.0: 3.99, 3.0: 5.99}  # K6 ölçümünden türetilmiş BD90\nMIN_FLANS = {0.8: (4.5, 7), 1.0: (6, 9), 1.2: (7, 10), 1.5: (8, 12), 2.0: (11, 16), 3.0: (16, 24)}\nRELIEF_W = {0.8: 1.0, 1.0: 1.0, 1.2: 1.5, 1.5: 1.5, 2.0: 2.0, 3.0: 3.0}\nPEM_KENAR_M5 = 7.1\n\n\ndef yuvarla(x, adim=0.5):\n    return math.ceil(x / adim - 1e-9) * adim\n\n\nbukum = {}\nfor t, (V, K) in TABLO.items():\n    R = round(1.5 * t, 3)\n    BA = math.pi / 2 * (R + K * t)\n    BD = 2 * (R + t) - BA\n    bukum[str(t)] = {\n        \"t\": t,\n        \"V_kalip\": V,\n        \"R_ic_dogal_0_2V\": round(0.2 * V, 2),\n        \"R_ic_model\": R,\n        \"K\": K,\n        \"BA_90\": round(BA, 3),\n        \"BD_90\": round(BD, 2),\n        \"BD_90_bartin_olcum\": BARTIN_BD.get(t),\n        \"min_flans_mutlak\": MIN_FLANS[t][0],\n        \"min_flans_tasarim\": MIN_FLANS[t][1],\n        \"relief_genislik\": RELIEF_W[t],\n        \"relief_derinlik\": yuvarla(t + R + 0.5),\n        \"delik_flans_ic_yuz\": yuvarla(2.5 * t + R),\n        \"uzun_yarik_flans_ic_yuz\": yuvarla(4 * t + R),\n        \"panjur_flans_ic_yuz\": yuvarla(3 * t + 2 * R),\n        \"pem_m5_eksen_flans_ic_yuz\": round(PEM_KENAR_M5 + R, 1) if t <= 1.5 else None,\n        \"delik_sac_kenari\": max(2 * t, 3.0),\n        \"delik_kopru\": max(2 * t, 3.0),\n        \"min_delik_cap\": max(t, 3.0),\n        \"kuvvet_kN_m_Rm650\": round(1.33 * 650 * t * t / V / 1000 * 1000, 0) / 1.0,\n    }\n\nveri = {\n    \"meta\": {\n        \"ad\": \"AUTOKITCH gövde sac üretim standardı\",\n        \"surum\": \"v1\",\n        \"tarih\": \"2026-10-01\",\n        \"durum\": \"ONERI - modele uygulanmadi; Kemal onayi bekleyen maddeler 'kemal_onayi' altinda\",\n        \"birim\": \"mm, derece, kN\",\n        \"belge\": \"GOVDE_SAC_STANDARDI_v1.md\",\n        \"malzeme_varsayimi\": \"AISI 304 (1.4301), hava bukumu, CNC abkant\",\n    },\n    \"formul\": {\n        \"BA\": \"pi*aci/180*(R_ic + K*t)\",\n        \"OSSB_90\": \"R_ic + t\",\n        \"BD\": \"2*OSSB - BA (90 derece)\",\n        \"acinim\": \"dis olculer toplami - sum(BD)\",\n        \"R_ic_model\": \"1.5*t\",\n        \"V_kalip\": \"~8*t\",\n        \"kuvvet_kN_m\": \"1.33*Rm*t^2/V (Rm=650 MPa)\",\n        \"geri_yaylanma_derece\": [2, 5],\n        \"kalibrasyon\": \"atolye 3 adet 50x50 numune; BD sapmasi > 0.1 ise K guncellenir (Bartin yontemi)\",\n    },\n    \"bukum\": bukum,\n    \"malzeme\": {\n        \"kalite\": \"AISI 304 (1.4301)\",\n        \"kaynakli_parca\": \"304L (1.4307) kabul\",\n        \"yasak\": [\"AISI 430\"],\n        \"yuzey_ic\": \"2B\",\n        \"yuzey_dis\": \"No.4 satine, 180-240 kum, tek yon\",\n        \"satine_yonu\": \"X (hat boyunca yatay)\",\n        \"urun_temas_Ra_max_um\": 0.8,\n        \"folyo\": {\"tip\": \"PE lazer folyosu\", \"kalinlik_um\": [70, 100], \"kesim\": \"folyo yukari\", \"kaynaktan_geri_soyma\": 20},\n        \"levha_formatlari\": [[1000, 2000], [1250, 2500], [1500, 3000]],\n        \"max_acinim\": [1500, 3000],\n        \"abkant_max_boy\": 3100,\n    },\n    \"kalinlik\": {\n        \"ana_sac\": 1.2,\n        \"ana_sac_kapsam\": [\"dis panel\", \"ic panel\", \"kapak dis tava\", \"kapak ic tava\", \"ic bolme\", \"taban\"],\n        \"yuk_saci\": 1.5,\n        \"yuk_saci_kapsam\": [\"raf\", \"tasiyici tabla\", \"sogutma grubu tepsisi\"],\n        \"braket\": 3.0,\n        \"braket_kapsam\": [\"konsol\", \"aski\", \"lama\"],\n        \"ayak_tipasi\": 5.0,\n        \"iskelet_profil\": {\"tip\": \"kare boru AISI 304\", \"olcu\": [40, 40, 2.0], \"uclar\": \"kaynakla kapali\"},\n        \"sektor_karsilastirma\": {\n            \"tr_ust_tabla\": [1.0, 1.2, 1.5], \"tr_cevre_kaplama\": [0.8, 1.0, 1.2], \"tr_bant_kapak\": 1.0,\n            \"tr_raf_cekmece\": 1.0, \"tr_ayak_profil\": [40, 40, 1.2], \"eu_900xp_ust\": 2.0,\n        },\n    },\n    \"rijitlik\": {\n        \"panel_tava_donusu\": 20,\n        \"ic_tava_donusu\": 15,\n        \"desteksiz_aciklik_max_1_2\": 600,\n        \"omega_takviye\": [20, 40, 20],\n        \"gorunur_panelde_punta\": False,\n        \"gorunur_panel_takviye_baglama\": [\"MS polimer yapistirici\", \"CD saplama + somun\"],\n    },\n    \"kose\": {\n        \"gorunur\": \"TIG kapali kose + tasla + satine\",\n        \"flans_ucu_araligi_kaynakli\": [0.0, 0.3],\n        \"gizli\": \"relief / kose deligi O=2t\",\n        \"kaynaksiz_flans_bosluk_min\": 0.4,\n        \"urun_bolgesi_ic_R_min\": 3.0,\n        \"urun_bolgesi_ic_R_tercih\": 6.0,\n        \"nsf_2_duzlem_R\": 3.2,\n        \"nsf_3_duzlem_R\": 6.4,\n    },\n    \"kenar\": {\n        \"serbest_kenar\": \"90 derece donus flansi 10-20\",\n        \"kapali_hem\": {\"ic_cap\": \"t\", \"donus\": \"6t\", \"bolge\": \"yalniz gida disi\", \"max_t_304\": 1.5},\n        \"acik_hem\": {\"ic_cap\": \"t\", \"donus\": \"4t\", \"bolge\": \"yalniz gida disi\"},\n        \"teardrop_hem\": {\"ic_cap\": \"t\", \"donus\": \"4t\", \"aciklik_min\": \"t/4\", \"bolge\": \"sicrama (uclari kaynakli)\"},\n    },\n    \"tolerans\": {\n        \"genel\": \"ISO 2768-mK\",\n        \"iso2768m_lineer\": {\"0.5-6\": 0.1, \"6-30\": 0.2, \"30-120\": 0.3, \"120-400\": 0.5, \"400-1000\": 0.8, \"1000-2000\": 1.2},\n        \"lazer\": 0.1,\n        \"bukum_acisi_derece\": 0.5,\n        \"datum_bukum\": 0.25,\n        \"toplam_form\": 0.5,\n        \"iki_bukum\": 0.38,\n        \"uc_arti_bukum\": 0.76,\n        \"panel_iskelet_bosluk\": 1.0,\n        \"panel_panel_dis_bosluk_max\": 0.5,\n    },\n    \"baglanti\": {\n        \"sac_gizli_secenek_A_PEM\": {\n            \"somun\": {\"parca\": \"PEM SP-M5-1\", \"dis\": \"M5\", \"delik\": 6.35, \"delik_tol\": 0.08, \"min_sac\": 1.0, \"kenar_eksen_min\": 7.1, \"malzeme\": \"A286\", \"sac_sertlik_max\": \"HRB 90\"},\n            \"saplama\": {\"parca\": \"PEM FHP-M5-xx\", \"dis\": \"M5\", \"delik\": 5.0, \"delik_tol\": 0.08, \"sac_aralik\": [1.0, 2.4], \"kenar_eksen_min\": 7.2, \"malzeme\": \"A286\"},\n            \"yasak\": [\"PEM CLS (HRB 70 siniri, 304 sacta tutmaz)\", \"PEM FH4 (400 serisi)\"],\n            \"cakma_zamani\": \"bukumden once, duz sacta\",\n        },\n        \"sac_gizli_secenek_B_CD_saplama\": {\"standart\": \"ISO 13918 PT\", \"malzeme\": \"A2\", \"dis\": \"M5\", \"flans_cap\": 6.7, \"min_sac\": 0.5, \"flans_ic_yuz_eksen_min\": 12},\n        \"pem_diger\": {\n            \"SP-M4-1\": {\"delik\": 5.41, \"min_sac\": 1.0, \"kenar_eksen_min\": 6.9},\n            \"SP-M6-1\": {\"delik\": 8.75, \"min_sac\": 1.4},\n            \"FHP-M4\": {\"delik\": 4.0, \"sac_aralik\": [1.0, 2.4]},\n        },\n        \"percin_somun\": {\"M4\": {\"delik\": 6.0}, \"M5\": {\"delik\": 7.0, \"kavrama\": [0.5, 3.0]}, \"M6\": {\"delik\": 9.0, \"kavrama\": [0.5, 3.5]}, \"malzeme\": \"A2\", \"islak_bolge\": \"kapali uclu\"},\n        \"iskelet_baglanti\": \"M6 percin somun\",\n        \"modul_modul\": {\"civata\": \"ISO 4762 M8 A2-70\", \"somun\": \"ISO 10511 M8 A2\", \"delik\": 9.0, \"dis_derz_max\": 0.5, \"derz_dolgu\": \"gida sinifi silikon / EPDM serit\"},\n        \"vida_tipleri\": {\n            \"ISO 7380-1\": \"bombe imbus - yalniz arka/teknik/servis\",\n            \"ISO 10642\": \"havsa imbus - yalniz >= 3 mm parca (M5 bas O10 x 2.8)\",\n            \"ISO 4762\": \"silindir imbus - iskelet, modul M8\",\n            \"ISO 10511\": \"fiberli somun\",\n            \"DIN 1587\": \"kor somun - sicrama bolgesinde acik dis\",\n            \"ISO 7093\": \"genis pul (ince sac)\",\n            \"DIN 929\": \"kaynak somunu M12 - ayak burcu\",\n        },\n        \"malzeme\": \"A2-70\",\n        \"gorunur_vida_on_ust\": False,\n        \"galling_onlem\": \"gida uyumlu kaydirici / anti-seize\",\n        \"delik_iso273_orta\": {\"M4\": 4.5, \"M5\": 5.5, \"M6\": 6.6, \"M8\": 9.0},\n        \"delik_iso273_ince\": {\"M4\": 4.3, \"M5\": 5.3, \"M6\": 6.4, \"M8\": 8.4},\n        \"vida_araligi_max\": 200,\n        \"vida_koseden_max\": 80,\n        \"vida_araligi_contali_max\": 150,\n        \"kenar_basina_min_vida\": 2,\n    },\n    \"kapak\": {\n        \"kurgu\": \"cift cidarli\",\n        \"dis_tava_t\": 1.2,\n        \"dis_tava_donus\": 20,\n        \"ic_tava_t\": 1.2,\n        \"ic_tava_t_alternatif\": 1.0,\n        \"ic_tava_donus\": 15,\n        \"ic_dis_bosluk\": 0.5,\n        \"dolgu_notr\": {\"tip\": \"PE kopuk / mineral yun / Al petek\", \"kalinlik\": 20},\n        \"dolgu_soguk\": {\"tip\": \"yerinde kopuk PU\", \"yogunluk_kg_m3\": 42, \"kapak_kalinlik\": 55, \"duvar_kalinlik\": 50},\n        \"toplam_kalinlik_notr\": [22, 25],\n        \"mentese\": {\"tip\": \"gizli 180 derece paslanmaz pasive (Southco R6 sinifi)\", \"alternatif\": \"kaldir-cikar pim mentese (GN 128.2 sinifi)\", \"adet\": {\"h<=900\": 2, \"h<=1500\": 3}},\n        \"kulp\": {\"tip\": \"gomme bukumlu J-profil (kapagin kendi sacindan)\", \"cep_derinlik\": [25, 30], \"boy\": \"tam boy\"},\n        \"conta_notr\": \"EPDM/silikon gecme fitil\",\n        \"conta_soguk\": \"cikarilabilir manyetik conta\",\n        \"tutucu\": \"miknatisli tutucu / bas-ac mandal\",\n        \"derz\": 3.0,\n        \"derz_tol\": 0.5,\n        \"govde_ortusme\": [10, 15],\n    },\n    \"ayak\": {\n        \"tip\": \"hijyenik ayarli ayak AISI 304 (GN 20 sinifi)\",\n        \"dis\": \"M12\",\n        \"taban_cap\": 60,\n        \"statik_yuk_kN\": 16,\n        \"govde_alti_kot\": 123,\n        \"ayar\": 20,\n        \"burc\": \"40x40x2 alt kusak ucuna 5 mm 304 tipa kaynakli + DIN 929 M12 kaynak somunu\",\n        \"koseden_max\": 50,\n        \"ayak_araligi_max\": 1000,\n        \"supurgelik\": \"zemine contali (dudak conta) + sokulebilir klipsli\",\n        \"nsf_acik_alt_min\": 150,\n        \"nsf_acik_alt_min_erisim_150_icinde\": 100,\n    },\n    \"havalandirma\": {\n        \"panjur_taret\": {\"H_max\": \"3t\", \"H_max_1_2\": 3.6, \"aralik_min\": 6, \"acik_taraf_kenar_min\": 10, \"kapali_taraf_kenar_min\": 10, \"agiz_yonu\": \"asagi\"},\n        \"lazer_yarik\": {\"genislik\": 5, \"boy\": 60, \"uc_R\": 2.5, \"kopru_min\": 5, \"sira_araligi_min\": 10, \"kenar_min\": 10, \"arka\": \"10-15 mm su kirici perde / paslanmaz tel filtre\"},\n    },\n    \"kablo\": {\n        \"rakor_delik\": {\"M16\": 16.5, \"M20\": 20.5, \"M25\": 25.5, \"M32\": 32.5},\n        \"dis_sicrama_rakor\": \"paslanmaz hijyenik (Hummel HSK-INOX-HD-Pro, 1.4404, IP69K)\",\n        \"hd_pro_D\": {\"M20\": 33, \"M25\": 38},\n        \"eksen_araligi\": \"D + 5\",\n        \"flans_ic_yuz_min\": \"D/2 + R + 2\",\n        \"kenar_koruma\": \"EPDM kenar profili / membran grommet\",\n    },\n    \"servis_acikligi\": {\"kose_R_min\": 6, \"kenar\": \"10-15 mm ice donus ya da 1.5 mm cerceve\", \"kapak_baglanti\": \"kanca + alt donuste gizli vida\"},\n    \"su\": {\"kapali_profil\": \"kaynakla tam kapali\", \"urun_bolgesi_yatay_egim_derece_min\": 3, \"acik_kanal_tahliye_cap\": 8},\n    \"is_sirasi\": [\n        \"3B -> parca basina acinim DXF (R, K, V, yon notlu)\",\n        \"levha: 304 2B + dis yuz satine + lazer folyosu\",\n        \"fiber lazer (azot kesim, folyo yukari)\",\n        \"capak alma\",\n        \"PEM / CD saplama (duz sacta)\",\n        \"abkant (folyolu, icten disa)\",\n        \"puntalama + TIG (Ar, gerekirse arka gaz, atlamali kisa dikis)\",\n        \"taslama (ic kose R>=3) + ayni kum/yon satine\",\n        \"dekapaj (isi rengi) + pasivasyon ASTM A380/A967\",\n        \"kontrol: ISO 2768-m, isi rengi yok, bakir sulfat testi\",\n        \"montaj: iskelet -> ayak -> mekanizma -> panel -> kapak -> derz\",\n        \"teslim: folyo sokme\",\n    ],\n    \"hijyen_bolge\": {\n        \"gida\": [\"B cekmece ici\", \"disk/tabla\", \"TOPPING kaset agzi + dokme bolgesi\", \"firin bandi agzi\", \"K kesme\", \"E kutu tepsisi\"],\n        \"sicrama\": [\"on yuzler\", \"kapak dislari\", \"robot tarafi ic duvarlar\", \"tezgah\", \"soguk dolap icleri\"],\n        \"gida_disi\": [\"teknik bolmeler\", \"pano\", \"kompresor/sogutma grubu cebi\", \"iskelet ici\", \"arka yuz\"],\n        \"kurallar\": {\n            \"gida\": \"surekli kaynak, baglanti elemani yok, bindirme yok, ic R>=3\",\n            \"sicrama\": \"temizlenebilir bas, acik dis yok (kor somun), metal-metal yerine elastomer\",\n            \"gida_disi\": \"dikis kapali + capaksiz\",\n        },\n    },\n    \"kemal_onayi\": [\n        \"kabuk 1.5 -> 1.2 (mevcut kural: seffaf istasyon yuzeyleri 1.5)\",\n        \"satine yonu hat boyunca yatay\",\n        \"govde alti 123 + contali supurgelik (NSF acik alt 150 ister)\",\n        \"mentese: gizli 180 mi, kaldir-cikar pim mi\",\n        \"panjur: atolyede taret kalibi var mi\",\n        \"K kalibrasyonu atolyenin numune bukumuyle\",\n    ],\n}\n\nyol = os.path.join(HERE, \"sac_standart_v1.json\")\nwith open(yol, \"w\", encoding=\"utf-8\") as f:\n    json.dump(veri, f, ensure_ascii=False, indent=2)\nprint(\"yazildi\", yol)\nfor k, v in bukum.items():\n    print(k, v[\"R_ic_model\"], v[\"K\"], v[\"BD_90\"], v[\"BD_90_bartin_olcum\"], v[\"relief_derinlik\"], v[\"delik_flans_ic_yuz\"],\n          v[\"uzun_yarik_flans_ic_yuz\"], v[\"panjur_flans_ic_yuz\"], v[\"pem_m5_eksen_flans_ic_yuz\"], v[\"kuvvet_kN_m_Rm650\"])","is_error":false}]},"uuid":"b8947147-d225-4458-9657-efca021788e2","timestamp":"2026-10-01T21:42:35.389Z","sourceToolAssistantUUID":"e9b82c4f-d88f-451b-9230-3c7897d4ab67","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
