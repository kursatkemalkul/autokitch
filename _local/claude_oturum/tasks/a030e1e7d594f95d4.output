{"parentUuid":"5d6fca18-282d-4c59-898c-5cc927ab72fb","isSidechain":true,"agentId":"a030e1e7d594f95d4","message":{"model":"claude-opus-5-5","id":"msg_011CfcKaK4ixergccZUpzoAB","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17813,"cache_read_input_tokens":477195,"cache_creation":{"ephemeral_5m_input_tokens":17813,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":0,"requestId":"req_011CfcKaJ7RQZWupvqCUwRTg","attributionAgent":"general-purpose","type":"assistant","uuid":"097551b7-7674-4e15-ba04-0e69b278b9e2","timestamp":"2026-10-01T22:39:50.444Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
{"parentUuid":"097551b7-7674-4e15-ba04-0e69b278b9e2","isSidechain":true,"agentId":"a030e1e7d594f95d4","message":{"model":"claude-opus-5-5","id":"msg_011CfcKaK4ixergccZUpzoAB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VRTx5wtrprUWFadFQSQ2vn","name":"Write","input":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\sac_standart\\ornek_dolap_v1.py","content":"# -*- coding: utf-8 -*-\n\"\"\"ornek_dolap_v1 — h3_sac_v1 kütüphanesinin örneği: 600 × 830 × 1074 tipik alt dolap (2 Eki 2026 · Claude · YEREL · montaja bağlı DEĞİL)\n\nDeğerler: sac_kararlar_v1.json > sac_standart_v1.json (kabuk 1,5 · raf/taban 1,5 · kapak 1,5 dış + 1,0 iç tava · su kırıcı perde 1,2 ·\nbraket 3,0 · iç R = 1,5t · K standart BD tablosundan · derz 3 · PEM SP-M5 somun / FHP-M5 saplama · gizli 180° kaldır-çıkar menteşe ·\ngömme bükümlü kulp · havalandırma = lazer yarık + iç su kırıcı perde).\nDünya: x hat boyunca 0–600 · y yukarı 0–1074 (zemin 0, gövde altı 150) · z koridora: ön 0, arka −830.\nParçalar: üst tabla (öne 90° önlük + kapalı kıvırma, yanlar/arka aşağı, ön köşeler bindirme + TIG) · kendinden taşıyıcı yanlar (ön flanş + dönüş,\narka flanş, üst flanş) · taban tavası (4 flanş, köşeler kaynaklı) · sırt (3 flanş, lazer yarık) · su kırıcı perde · raf (dil-yuva ile sırta) ·\nçift cidarlı kapak (dış tava + J kulp, iç tava, arada yalıtım boşluğu) · 2 gizli menteşe · 4 ayarlı ayak (3 mm plaka + kaynaklı kör burç).\nÇıktılar (bu klasör): ornek_dolap_v1.glb · ornek_dolap_v1_rapor.json · ornek_dolap_v1_acinim/<parça>.json · ornek_dolap_v1_kesit_*.png\nÇalıştır: python -u ornek_dolap_v1.py\"\"\"\nimport os, sys, time, json\nBUR = os.path.dirname(os.path.abspath(__file__))\nsys.path.insert(0, os.path.abspath(os.path.join(BUR, \"..\", \"b3\", \"arastirma\", \"_uretec\", \"h3\"))); sys.path.insert(0, BUR)\nimport numpy as np\nimport h3_sac_v1 as S\n\nT0 = time.time()\nW, D, H = 600.0, 830.0, 1074.0\nY_B = 150.0                                   # gövde altı (taban dış yüzü); ayaklar 0–150\nDERZ = S.STD.derz(); GM = S.STD.montaj_boslugu(); KP = S.STD.kapak()\nKAPAK_D = KP[\"dis_donus\"]                     # kapak derinliği = dış tava dönüşü (20)\nZ_CER = -(KAPAK_D + DERZ)                     # gövde ön çerçevesi (yan ön flanş dış yüzü)\nAPRON = 40.0\nY_KAPAK_UST = H - APRON - DERZ\nBIRIM = \"ORNEK_DOLAP\"\nSACLAR, BIRLESIM, EK = [], [], []\n\n\ndef sac(ad, rol, **k):\n    s = S.Sac(ad, rol=rol, birim=BIRIM, **k); SACLAR.append(s); return s\n\n\ndef g_(s):\n    return s.R + s.t\n\n\ndef log(m):\n    print(\"[%5.1fs] %s\" % (time.time() - T0, m)); sys.stdout.flush()\n\n\n# ------------------------------------------------------------------ 1 · ÜST TABLA (öne 90° önlük + kapalı kıvırma)\nut = sac(\"ust_tabla\", \"dis\"); t1, g1 = ut.t, g_(ut)\nP_ut = ut.taban([(g1, g1), (W - g1, g1), (W - g1, D - g1), (g1, D - g1)], O=(0, H - t1, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"tabla\")\nut_on = P_ut.flans(0, APRON, yon=-1, ad=\"onluk\")\nut_sag = P_ut.flans(1, 25, yon=-1, ad=\"sag_flans\")\nut_arka = P_ut.flans(2, 25, yon=-1, ad=\"arka_flans\")\nut_sol = P_ut.flans(3, 25, yon=-1, ad=\"sol_flans\")\nut.kose(ut_on, ut_sag, \"bindirme\", ustte=ut_on)                 # görünür ön köşeler: bindirme + TIG + taşlama\nut.kose(ut_sol, ut_on, \"bindirme\", ustte=ut_on)\nut.kose(ut_sag, ut_arka, \"acik\")                                 # gizli arka köşeler: açık + kare relief\nut.kose(ut_arka, ut_sol, \"acik\")\nut_on.kivir(1, tip=\"kapali\", yon=-1, ad=\"onluk_kivirma\")       # önlük alt kenarı içe kapalı kıvırma (gıda dışı)\n\n\n# ------------------------------------------------------------------ 2 · YANLAR (kendinden taşıyıcı)\ndef yan(taraf):\n    s = sac(\"yan_\" + taraf, \"dis\"); t, g = s.t, g_(s)\n    xs = t1 + GM                                                  # dış yüz: üst tablanın yan flanşının içinde\n    u0, u1 = Y_B, H - t1 - g\n    if taraf == \"sol\":\n        P = s.taban([(u0, -D + g), (u1, -D + g), (u1, Z_CER - g), (u0, Z_CER - g)], O=(xs, 0, 0), ex=(0, 1, 0), ey=(0, 0, 1), ad=\"yan\")\n        k_arka, k_on, kisa_ad = 0, 2, \"son\"\n    else:\n        P = s.taban([(u0, -Z_CER + g), (u1, -Z_CER + g), (u1, D - g), (u0, D - g)], O=(W - xs, 0, 0), ex=(0, 1, 0), ey=(0, 0, -1), ad=\"yan\")\n        k_arka, k_on, kisa_ad = 2, 0, \"bas\"\n    kisa = u1 - (H - 25.0 - 2.0)                                  # arka flanş üst tablanın arka flanşının 2 mm altında biter → relief\n    arka = P.flans(k_arka, 30, yon=+1, ad=\"arka_flans\", **{kisa_ad: kisa})\n    ust = P.flans(1, 25, yon=+1, ad=\"ust_flans\")\n    on = P.flans(k_on, 40, yon=+1, ad=\"on_flans\")\n    s.kose(ust, on, \"acik\")\n    donus = on.flans(1, 12, yon=+1, ad=\"on_donus\")\n    return s, dict(yan=P, arka=arka, ust=ust, on=on, donus=donus, xs=xs, xi=xs + t)\n\n\nys, YS = yan(\"sol\")\nysg, YSG = yan(\"sag\")\nt_yan = ys.t\n\n# ------------------------------------------------------------------ 3 · SIRT (yan arka flanşlarının önünde) + lazer yarık\nsr = sac(\"sirt\", \"dis\"); ts, gs = sr.t, g_(sr)\nZ_SIRT_ARKA = -D + t_yan; Z_SIRT_ON = Z_SIRT_ARKA + ts\nx0s = YS[\"xs\"] + g_(ys) + GM; x1s = W - x0s                      # yan arka bükümünün dışında\ny1s = H - t1 - t_yan - GM                                         # yan üst flanşının altında\nP_sr = sr.taban([(x0s + gs, Y_B), (x1s - gs, Y_B), (x1s - gs, y1s - gs), (x0s + gs, y1s - gs)], O=(0, 0, Z_SIRT_ARKA), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"sirt\")\nkisa_s = (Y_B + 40.0 + 2.0) - Y_B                                 # yan flanşlar taban arka flanşının üstünden başlar → relief\nsr_sag = P_sr.flans(1, 20, yon=+1, bas=kisa_s, ad=\"sag_flans\")\nsr_ust = P_sr.flans(2, 20, yon=+1, ad=\"ust_flans\")\nsr_sol = P_sr.flans(3, 20, yon=+1, son=kisa_s, ad=\"sol_flans\")\nsr.kose(sr_sag, sr_ust, \"acik\"); sr.kose(sr_ust, sr_sol, \"acik\")\nyariklar = P_sr.lazer_yarik_dizisi(W / 2.0, 950.0, 3, 4, aci=0.0)\n\n# su kırıcı perde (yarıkların 12 mm önünde, üst flanşı sırta puntalı)\npd = sac(\"su_kirici_perde\", \"ic\"); tp_, gp_ = pd.t, g_(pd)\nP_pd = pd.taban([(0, 0), (280, 0), (280, 70 - gp_), (0, 70 - gp_)], O=(160, 915, Z_SIRT_ON + 12.0), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"perde\")\npd_ust = P_pd.flans(2, 12.0 + tp_, yon=-1, ad=\"ust_flans\")\npd.punta(sr, [(x, 985.0 - tp_ / 2.0, Z_SIRT_ON) for x in (200.0, 300.0, 400.0)], not_=\"perde üst flanşı → sırt iç yüzü\")\n\n# ------------------------------------------------------------------ 4 · TABAN TAVASI (köşeler kaynaklı)\ntb = sac(\"taban\", \"yuk\"); tt, gb = tb.t, g_(tb)\nx0b, x1b = YS[\"xi\"] + GM, W - YS[\"xi\"] - GM\nz_on_b = Z_CER - 12.0 - GM                                        # yan dönüş ucunun arkası\nP_tb = tb.taban([(x0b + gb, -z_on_b + gb), (x1b - gb, -z_on_b + gb), (x1b - gb, -Z_SIRT_ON - gb), (x0b + gb, -Z_SIRT_ON - gb)],\n                O=(0, Y_B, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"taban\")\ntb_on = P_tb.flans(0, 40, yon=+1, ad=\"on_flans\"); tb_sag = P_tb.flans(1, 40, yon=+1, ad=\"sag_flans\")\ntb_arka = P_tb.flans(2, 40, yon=+1, ad=\"arka_flans\"); tb_sol = P_tb.flans(3, 40, yon=+1, ad=\"sol_flans\")\ntb.kose(tb_on, tb_sag, \"bindirme\", ustte=tb_on); tb.kose(tb_sag, tb_arka, \"bindirme\", ustte=tb_arka)\ntb.kose(tb_arka, tb_sol, \"bindirme\", ustte=tb_arka); tb.kose(tb_sol, tb_on, \"bindirme\", ustte=tb_on)\n\n# ------------------------------------------------------------------ 5 · RAF (yanlara saplama, sırta dil-yuva)\nrf = sac(\"raf\", \"yuk\"); tr, gr = rf.t, g_(rf)\nY_RAF = 600.0; z_raf_on = -100.0; z_raf_arka = Z_SIRT_ON + GM\nP_rf = rf.taban([(x0b + gr, -z_raf_on + gr), (x1b - gr, -z_raf_on + gr), (x1b - gr, -z_raf_arka), (x0b + gr, -z_raf_arka)],\n                O=(0, Y_RAF - tr, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"raf\")\nrf_on = P_rf.flans(0, 30, yon=-1, ad=\"on_flans\")\nrf_sag = P_rf.flans(1, 25, yon=-1, son=20.0, ad=\"sag_flans\")    # arkada sırt yan flanşlarına yer → relief\nrf_sol = P_rf.flans(3, 25, yon=-1, bas=20.0, ad=\"sol_flans\")\nrf.kose(rf_on, rf_sag, \"acik\"); rf.kose(rf_sol, rf_on, \"acik\")\nv_c0, v_c1 = -(Z_SIRT_ARKA + 20.0) - GM, -z_raf_arka + 1.0       # sırt yan flanşı için arka köşe çentikleri\nfor xa, xb in ((x0s - GM - 2.0, x0s + ts + GM), (x1s - ts - GM, x1s + GM + 2.0)):\n    P_rf.dikdortgen((xa + xb) / 2.0, (v_c0 + v_c1) / 2.0, xb - xa, v_c1 - v_c0, tip=\"centik\", dfm=False)\nu_arka = x1b - gr\nDIL = [S.dil_yuva(P_rf, 2, u_arka - (xc + 10.0), 20.0, P_sr) for xc in (150.0, 450.0)]\n\n# ------------------------------------------------------------------ 6 · KAPAK (çift cidarlı: dış tava + gömme J kulp · iç tava)\nkd = sac(\"kapak_dis_tava\", \"kapak_dis\"); tk, gk = kd.t, g_(kd)\nxk0, xk1 = YS[\"xs\"], W - YS[\"xs\"]; yk0, yk1 = Y_B, Y_KAPAK_UST\nCEP = 30.0\ny_e = yk1 - 2 * tk - kd.R - CEP                                   # ön yüzün üst kenarı (kulp cebinin altı)\nP_kd = kd.taban([(xk0 + gk, yk0 + gk), (xk1 - gk, yk0 + gk), (xk1 - gk, y_e), (xk0 + gk, y_e)], O=(0, 0, -tk), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"on_yuz\")\nkd_alt = P_kd.flans(0, KAPAK_D, yon=-1, ad=\"alt_flans\"); kd_sag = P_kd.flans(1, KAPAK_D, yon=-1, ad=\"sag_flans\")\nkd_k1 = P_kd.flans(2, KAPAK_D, yon=-1, ad=\"kulp_taban\"); kd_sol = P_kd.flans(3, KAPAK_D, yon=-1, ad=\"sol_flans\")\nkd.kose(kd_alt, kd_sag, \"bindirme\", ustte=kd_alt); kd.kose(kd_sag, kd_k1, \"bindirme\", ustte=kd_k1)\nkd.kose(kd_k1, kd_sol, \"bindirme\", ustte=kd_k1); kd.kose(kd_sol, kd_alt, \"bindirme\", ustte=kd_alt)\nkd_k2 = kd_k1.flans(1, yk1 - y_e - kd.R, yon=+1, ad=\"kulp_arka\")\nkd_k3 = kd_k2.flans(1, KAPAK_D, yon=+1, ad=\"kulp_ust\")\nkd_k4 = kd_k3.flans(1, 12.0, yon=+1, ad=\"kulp_dudak\")\n\nki = sac(\"kapak_ic_tava\", \"kapak_ic\"); ti, gi = ki.t, g_(ki)\nxi0, xi1 = xk0 + tk + KP[\"ic_dis_bosluk\"], xk1 - tk - KP[\"ic_dis_bosluk\"]\nyi0, yi1 = yk0 + tk + KP[\"ic_dis_bosluk\"], y_e + kd.R - KP[\"ic_dis_bosluk\"]\nP_ki = ki.taban([(xi0 + gi, yi0 + gi), (xi1 - gi, yi0 + gi), (xi1 - gi, yi1 - gi), (xi0 + gi, yi1 - gi)], O=(0, 0, -KAPAK_D), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"ic_tava\")\nki_f = [P_ki.flans(i, KP[\"ic_donus\"], yon=+1, ad=a) for i, a in enumerate((\"alt_flans\", \"sag_flans\", \"ust_flans\", \"sol_flans\"))]\nfor i in range(4): ki.kose(ki_f[i], ki_f[(i + 1) % 4], \"acik\")\nzp = -KAPAK_D + KP[\"ic_donus\"] / 2.0\nki.punta(kd, [(x, yi0 - KP[\"ic_dis_bosluk\"] / 2.0, zp) for x in (150, 300, 450)] + [(x, yi1 + 0.0, zp) for x in (150, 300, 450)]\n         + [(xi0 - KP[\"ic_dis_bosluk\"] / 2.0, y, zp) for y in (300, 575, 850)] + [(xi1 + KP[\"ic_dis_bosluk\"] / 2.0, y, zp) for y in (300, 575, 850)],\n         not_=\"iç tava dönüşleri → dış tava dönüşleri (0,5 boşluk elektrotla kapanır)\")\n\n# gizli menteşeler (sol) — kapak cebi iç tavada, kol yan ön flanşındaki yarıktan geçer, plaka yan iç yüzünde 2 × FHP-M5\nMENTESE = []\nfor i, yh in enumerate((260.0, 900.0)):\n    M = S._M(np.column_stack([[1, 0, 0], [0, -1, 0], [0, 0, -1]]), (xk0, yh, -KAPAK_D))\n    xm = 20.0; x_yan = YS[\"xi\"] - xk0\n    MENTESE.append(S.gizli_mentese(M, xm, x_yan, 20.0, (20.0, 90.0), plaka_delik=[(25.0, 70.0, 5.5), (-25.0, 70.0, 5.5)], ad=\"gizli_mentese_%d\" % (i + 1), birim=BIRIM))\n    P_ki.dikdortgen(xk0 + xm, yh, 17.0, 51.0, tip=\"mentese_cebi\")\n    on = YS[\"on\"]; q = on.yerel((xk0 + xm, yh, Z_CER - t_yan / 2.0))\n    on.dikdortgen(q[0], q[1], 16.0, 44.0, r=2.0, tip=\"mentese_yarigi\")\n    for dy in (25.0, -25.0):\n        BIRLESIM.append(S.saplama_baglantisi(YS[\"yan\"], (YS[\"xs\"], yh - dy, -KAPAK_D - 70.0), (1, 0, 0), 3.0, ad=\"mentese%d_saplama_%+d\" % (i + 1, int(dy)), birim=BIRIM))\n\n# ------------------------------------------------------------------ 7 · AYAKLAR (3 mm plaka + kaynaklı kör burç + ayarlı ayak)\nAYAK = []\nfor i, (x, z) in enumerate(((50.0, -80.0), (550.0, -80.0), (50.0, -780.0), (550.0, -780.0))):\n    pl = sac(\"ayak_plakasi_%d\" % (i + 1), \"braket\"); tpl = pl.t\n    pl.taban([(x - 40, -z - 40), (x + 40, -z - 40), (x + 40, -z + 40), (x - 40, -z + 40)], O=(0, Y_B - tpl, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"plaka\")\n    yb = Y_B - tpl\n    bu = S.kor_burc(\"M12\", (x, yb, z), (0, -1, 0), ad=\"ayak_burcu_%d\" % (i + 1), birim=BIRIM)\n    AYAK.append(bu)\n    AYAK.append(S.kaynak_halka((x, yb, z), (0, -1, 0), bu[\"meta\"][\"D\"] / 2.0, 3.0, ad=\"burc_kaynagi_%d\" % (i + 1), birim=BIRIM))\n    for j, (p0, p1, u1) in enumerate((((x - 40, Y_B, z - 40), (x - 40, Y_B, z + 40), (-1, 0, 0)), ((x + 40, Y_B, z - 40), (x + 40, Y_B, z + 40), (1, 0, 0)),\n                                      ((x - 40, Y_B, z - 40), (x + 40, Y_B, z - 40), (0, 0, -1)), ((x - 40, Y_B, z + 40), (x + 40, Y_B, z + 40), (0, 0, 1)))):\n        AYAK.append(S.kaynak_dikisi(p0, p1, u1, (0, -1, 0), tpl, ad=\"plaka_kaynagi_%d_%d\" % (i + 1, j + 1), birim=BIRIM, taraf=\"dis (köşe)\"))\n    AYAK += S.ayarli_ayak(\"M12\", (x, 0.0, z), (0, 1, 0), yb - bu[\"meta\"][\"H\"], ad=\"ayarli_ayak_%d\" % (i + 1), birim=BIRIM)\n\n# ------------------------------------------------------------------ 8 · BİRLEŞİMLER\nfor zz in (-100.0, -415.0, -730.0):                               # üst tabla yan flanşı (FHP flush dışta) → yan\n    BIRLESIM.append(S.vidali_birlesim(ut_sol, YS[\"yan\"], (1.0, H - 14.0, zz), \"pem_saplama\", ad=\"ust_sol_%d\" % -zz, birim=BIRIM))\n    BIRLESIM.append(S.vidali_birlesim(ut_sag, YSG[\"yan\"], (W - 1.0, H - 14.0, zz), \"pem_saplama\", ad=\"ust_sag_%d\" % -zz, birim=BIRIM))\nfor zz in (-150.0, -430.0, -710.0):                               # yan (FHP flush dışta) → taban yan flanşı\n    BIRLESIM.append(S.vidali_birlesim(YS[\"yan\"], tb_sol, (YS[\"xs\"], Y_B + 22.0, zz), \"pem_saplama\", ad=\"taban_sol_%d\" % -zz, birim=BIRIM))\n    BIRLESIM.append(S.vidali_birlesim(YSG[\"yan\"], tb_sag, (W - YS[\"xs\"], Y_B + 22.0, zz), \"pem_saplama\", ad=\"taban_sag_%d\" % -zz, birim=BIRIM))\nfor zz in (-250.0, -650.0):                                       # yan → raf yan flanşı\n    BIRLESIM.append(S.vidali_birlesim(YS[\"yan\"], rf_sol, (YS[\"xs\"], Y_RAF - 15.0, zz), \"pem_saplama\", ad=\"raf_sol_%d\" % -zz, birim=BIRIM))\n    BIRLESIM.append(S.vidali_birlesim(YSG[\"yan\"], rf_sag, (W - YS[\"xs\"], Y_RAF - 15.0, zz), \"pem_saplama\", ad=\"raf_sag_%d\" % -zz, birim=BIRIM))\nfor yy in (300.0, 650.0, 950.0):                                  # yan arka flanşı (arkadan ISO 7380) → sırt (PEM SP somun)\n    BIRLESIM.append(S.vidali_birlesim(YS[\"arka\"], P_sr, (20.0, yy, -D + 0.5), \"pem_somun\", ad=\"sirt_sol_%d\" % yy, birim=BIRIM))\n    BIRLESIM.append(S.vidali_birlesim(YSG[\"arka\"], P_sr, (W - 20.0, yy, -D + 0.5), \"pem_somun\", ad=\"sirt_sag_%d\" % yy, birim=BIRIM))\nfor xx in (200.0, 400.0):                                         # sırt + taban arka flanşı birlikte: perçin somun M5\n    BIRLESIM.append(S.vidali_birlesim(P_sr, tb_arka, (xx, Y_B + 25.0, Z_SIRT_ARKA), \"percin_somun\", ad=\"sirt_taban_%d\" % xx, birim=BIRIM))\nlog(\"kuruldu: %d sac · %d birleşim · %d menteşe · %d ayak/kaynak parçası\" % (len(SACLAR), len(BIRLESIM), len(MENTESE), len(AYAK)))\n\n# ------------------------------------------------------------------ 9 · DENETİM\nRAPOR = dict(surum=\"ornek_dolap_v1 · \" + S.SURUM, olcu=[W, D, H], standart=S.STD.ozet(), parcalar={}, birlesimler=[], dil_yuva=DIL)\nos.makedirs(os.path.join(BUR, \"ornek_dolap_v1_acinim\"), exist_ok=True)\ntoplam_hata = 0\nfor s in SACLAR:\n    r = s.dogrula(); d = s.dfm(abkant=True); a = s.acinim()\n    with open(os.path.join(BUR, \"ornek_dolap_v1_acinim\", s.ad + \".json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(a, f, ensure_ascii=False, indent=1)\n    h = [m for m in d if m[\"durum\"] == \"HATA\"]; u = [m for m in d if m[\"durum\"] == \"UYARI\"]; toplam_hata += len(h)\n    ab = [m for m in d if m[\"kural\"] == \"abkant\"]\n    RAPOR[\"parcalar\"][s.ad] = dict(t=s.t, R=s.R, K=s.K, rol=s.rol, bukum=len(s.bukumler), levha=a[\"levha\"], delik=len(a[\"ic_konturlar\"]),\n                                   dogrulama={k: v for k, v in r.items() if k not in (\"kalinlik\",)}, kalinlik={k: v for k, v in r[\"kalinlik\"].items()},\n                                   dfm=d, punta=s.puntalar)\n    log(\"%-16s t%.1f R%.2f K%.2f · %d büküm · açınım %.0f×%.0f · ΔV(açınımdan) %%%s sim %%%s · kalınlık %s (%d ana/%d kenar) · kesit %s · DFM %d HATA %d UYARI%s\"\n        % (s.ad, s.t, s.R, s.K, len(s.bukumler), a[\"levha\"][\"boy\"], a[\"levha\"][\"en\"], r.get(\"hacim_farki_yuzde\"), r.get(\"simetrik_fark_yuzde\"),\n           r[\"kalinlik\"][\"gecti\"], r[\"kalinlik\"][\"ana\"], r[\"kalinlik\"][\"kenar\"], r.get(\"kesit_gecti\"), len(h), len(u),\n           (\" · abkant sıra %s\" % ab[0].get(\"sira\")) if ab else \"\"))\n    for m in h + u: print(\"        %s %-16s %s\" % (m[\"durum\"], m[\"kural\"], m[\"detay\"][:230]))\n\nPARCALAR = [p for s in SACLAR for p in s.parcalar()] + MENTESE + AYAK + [x for b in BIRLESIM for x in b[\"parcalar\"]]\nfor b in BIRLESIM:\n    RAPOR[\"birlesimler\"].append({k: v for k, v in b.items() if k != \"parcalar\"} | dict(elemanlar=[x[\"ad\"] for x in b[\"parcalar\"]]))\nlog(\"çakışma denetimi: %d parça\" % len(PARCALAR))\ncak, izin = S.cakisma_denetle(PARCALAR)\nRAPOR[\"cakisma\"] = dict(cakisan=cak, izinli=izin)\nlog(\"çakışma %d · izinli (PEM gömme başı) %d%s\" % (len(cak), len(izin), (\" → \" + str(cak[:8])) if cak else \"\"))\n\n# kesitler: büküm yarıçapları kesitte görünüyor mu (y = 500 yatay, x = 300 düşey)\nimport _ciz\nKES = {}\nfor ad_, nokta, nrm, eks in ((\"yatay_y500\", (0, 500.0, 0), (0, 1, 0), (0, 2)), (\"duşey_x300\", (300.0, 0, 0), (1, 0, 0), (2, 1))):\n    kk, yar = [], {}\n    for s in SACLAR:\n        sh = s.kati(); bb = sh.BoundingBox()\n        if not (bb.ymin - 1 < nokta[1] < bb.ymax + 1 if nrm[1] else bb.xmin - 1 < nokta[0] < bb.xmax + 1): continue\n        kn = S.kesit_kenarlari(sh, nokta, nrm); kk.append((s.ad, kn))\n        rr = sorted(set(round(r_, 3) for r_ in S.kesit_yaricaplari(sh, nokta, nrm)))\n        if rr: yar[s.ad] = rr\n    KES[ad_] = yar\n    if nrm[1]:\n        _ciz.ciz_kesit(kk, os.path.join(BUR, \"ornek_dolap_v1_kesit_yatay.png\"), eksenler=(0, 2), baslik=\"y = 500 yatay kesit (kırmızı = büküm yayı)\")\n        _ciz.ciz_kesit(kk, os.path.join(BUR, \"ornek_dolap_v1_kesit_yatay_on_sol.png\"), eksenler=(0, 2), baslik=\"y = 500 · ön sol köşe\", sinir=((-2, 50), (-50, 2)))\n    else:\n        _ciz.ciz_kesit(kk, os.path.join(BUR, \"ornek_dolap_v1_kesit_dusey.png\"), eksenler=(2, 1), baslik=\"x = 300 düşey kesit\")\n        _ciz.ciz_kesit(kk, os.path.join(BUR, \"ornek_dolap_v1_kesit_dusey_on_ust.png\"), eksenler=(2, 1), baslik=\"x = 300 · ön üst (önlük + kıvırma + J kulp)\",\n                       sinir=((-45, 3), (985, 1077)))\nRAPOR[\"kesit_yaricaplari\"] = KES\nlog(\"kesit yarıçapları: %s\" % json.dumps(KES, ensure_ascii=False))\n\n# BOM + GLB\nBOM = S.bom_topla(PARCALAR); RAPOR[\"bom\"] = BOM\nsay = lambda tur: sum(1 for p in PARCALAR if p.get(\"tur\") == tur)\nRAPOR[\"ozet\"] = dict(sac=len(SACLAR), kaynak_dikisi=say(\"kaynak\"), baglanti_elemani=say(\"baglanti\"), toplam_parca=len(PARCALAR),\n                     punta=sum(len(p[\"noktalar\"]) for s in SACLAR for p in s.puntalar), dfm_hata=toplam_hata, cakisma=len(cak))\ng = S.glb_yaz(os.path.join(BUR, \"ornek_dolap_v1.glb\"), PARCALAR)\nwith open(os.path.join(BUR, \"ornek_dolap_v1_rapor.json\"), \"w\", encoding=\"utf-8\") as f:\n    json.dump(RAPOR, f, ensure_ascii=False, indent=1, default=str)\n_ciz.ciz(PARCALAR, os.path.join(BUR, \"ornek_dolap_v1_gorunum.png\"), elev=20, azim=-55, tol=0.8, baslik=\"ornek_dolap_v1\")\nlog(\"GLB %s (%d düğüm, %.0f kB) · özet %s\" % (os.path.basename(g[\"yol\"]), g[\"dugum\"], g[\"bayt\"] / 1024.0, RAPOR[\"ozet\"]))\nfor b in BOM: print(\"   BOM %3d × %-95s %-34s %s\" % (b[\"adet\"], b[\"tanim\"][:95], b[\"olcu\"][:34], b[\"standart\"]))\nsys.stdout.flush(); os._exit(0)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":17813,"cache_read_input_tokens":477195,"output_tokens":11406,"output_tokens_details":{"thinking_tokens":9},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":17813},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":11406,"cache_read_input_tokens":477195,"cache_creation_input_tokens":17813,"cache_creation":{"ephemeral_5m_input_tokens":17813,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01VRTx5wtrprUWFadFQSQ2vn":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\sac_standart\\ornek_dolap_v1.py","content":"# -*- coding: utf-8 -*-\n\"\"\"ornek_dolap_v1 — h3_sac_v1 kütüphanesinin örneği: 600 × 830 × 1074 tipik alt dolap (2 Eki 2026 · Claude · YEREL · montaja bağlı DEĞİL)\n\nDeğerler: sac_kararlar_v1.json > sac_standart_v1.json (kabuk 1,5 · raf/taban 1,5 · kapak 1,5 dış + 1,0 iç tava · su kırıcı perde 1,2 ·\nbraket 3,0 · iç R = 1,5t · K standart BD tablosundan · derz 3 · PEM SP-M5 somun / FHP-M5 saplama · gizli 180° kaldır-çıkar menteşe ·\ngömme bükümlü kulp · havalandırma = lazer yarık + iç su kırıcı perde).\nDünya: x hat boyunca 0–600 · y yukarı 0–1074 (zemin 0, gövde altı 150) · z koridora: ön 0, arka −830.\nParçalar: üst tabla (öne 90° önlük + kapalı kıvırma, yanlar/arka aşağı, ön köşeler bindirme + TIG) · kendinden taşıyıcı yanlar (ön flanş + dönüş,\narka flanş, üst flanş) · taban tavası (4 flanş, köşeler kaynaklı) · sırt (3 flanş, lazer yarık) · su kırıcı perde · raf (dil-yuva ile sırta) ·\nçift cidarlı kapak (dış tava + J kulp, iç tava, arada yalıtım boşluğu) · 2 gizli menteşe · 4 ayarlı ayak (3 mm plaka + kaynaklı kör burç).\nÇıktılar (bu klasör): ornek_dolap_v1.glb · ornek_dolap_v1_rapor.json · ornek_dolap_v1_acinim/<parça>.json · ornek_dolap_v1_kesit_*.png\nÇalıştır: python -u ornek_dolap_v1.py\"\"\"\nimport os, sys, time, json\nBUR = os.path.dirname(os.path.abspath(__file__))\nsys.path.insert(0, os.path.abspath(os.path.join(BUR, \"..\", \"b3\", \"arastirma\", \"_uretec\", \"h3\"))); sys.path.insert(0, BUR)\nimport numpy as np\nimport h3_sac_v1 as S\n\nT0 = time.time()\nW, D, H = 600.0, 830.0, 1074.0\nY_B = 150.0                                   # gövde altı (taban dış yüzü); ayaklar 0–150\nDERZ = S.STD.derz(); GM = S.STD.montaj_boslugu(); KP = S.STD.kapak()\nKAPAK_D = KP[\"dis_donus\"]                     # kapak derinliği = dış tava dönüşü (20)\nZ_CER = -(KAPAK_D + DERZ)                     # gövde ön çerçevesi (yan ön flanş dış yüzü)\nAPRON = 40.0\nY_KAPAK_UST = H - APRON - DERZ\nBIRIM = \"ORNEK_DOLAP\"\nSACLAR, BIRLESIM, EK = [], [], []\n\n\ndef sac(ad, rol, **k):\n    s = S.Sac(ad, rol=rol, birim=BIRIM, **k); SACLAR.append(s); return s\n\n\ndef g_(s):\n    return s.R + s.t\n\n\ndef log(m):\n    print(\"[%5.1fs] %s\" % (time.time() - T0, m)); sys.stdout.flush()\n\n\n# ------------------------------------------------------------------ 1 · ÜST TABLA (öne 90° önlük + kapalı kıvırma)\nut = sac(\"ust_tabla\", \"dis\"); t1, g1 = ut.t, g_(ut)\nP_ut = ut.taban([(g1, g1), (W - g1, g1), (W - g1, D - g1), (g1, D - g1)], O=(0, H - t1, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"tabla\")\nut_on = P_ut.flans(0, APRON, yon=-1, ad=\"onluk\")\nut_sag = P_ut.flans(1, 25, yon=-1, ad=\"sag_flans\")\nut_arka = P_ut.flans(2, 25, yon=-1, ad=\"arka_flans\")\nut_sol = P_ut.flans(3, 25, yon=-1, ad=\"sol_flans\")\nut.kose(ut_on, ut_sag, \"bindirme\", ustte=ut_on)                 # görünür ön köşeler: bindirme + TIG + taşlama\nut.kose(ut_sol, ut_on, \"bindirme\", ustte=ut_on)\nut.kose(ut_sag, ut_arka, \"acik\")                                 # gizli arka köşeler: açık + kare relief\nut.kose(ut_arka, ut_sol, \"acik\")\nut_on.kivir(1, tip=\"kapali\", yon=-1, ad=\"onluk_kivirma\")       # önlük alt kenarı içe kapalı kıvırma (gıda dışı)\n\n\n# ------------------------------------------------------------------ 2 · YANLAR (kendinden taşıyıcı)\ndef yan(taraf):\n    s = sac(\"yan_\" + taraf, \"dis\"); t, g = s.t, g_(s)\n    xs = t1 + GM                                                  # dış yüz: üst tablanın yan flanşının içinde\n    u0, u1 = Y_B, H - t1 - g\n    if taraf == \"sol\":\n        P = s.taban([(u0, -D + g), (u1, -D + g), (u1, Z_CER - g), (u0, Z_CER - g)], O=(xs, 0, 0), ex=(0, 1, 0), ey=(0, 0, 1), ad=\"yan\")\n        k_arka, k_on, kisa_ad = 0, 2, \"son\"\n    else:\n        P = s.taban([(u0, -Z_CER + g), (u1, -Z_CER + g), (u1, D - g), (u0, D - g)], O=(W - xs, 0, 0), ex=(0, 1, 0), ey=(0, 0, -1), ad=\"yan\")\n        k_arka, k_on, kisa_ad = 2, 0, \"bas\"\n    kisa = u1 - (H - 25.0 - 2.0)                                  # arka flanş üst tablanın arka flanşının 2 mm altında biter → relief\n    arka = P.flans(k_arka, 30, yon=+1, ad=\"arka_flans\", **{kisa_ad: kisa})\n    ust = P.flans(1, 25, yon=+1, ad=\"ust_flans\")\n    on = P.flans(k_on, 40, yon=+1, ad=\"on_flans\")\n    s.kose(ust, on, \"acik\")\n    donus = on.flans(1, 12, yon=+1, ad=\"on_donus\")\n    return s, dict(yan=P, arka=arka, ust=ust, on=on, donus=donus, xs=xs, xi=xs + t)\n\n\nys, YS = yan(\"sol\")\nysg, YSG = yan(\"sag\")\nt_yan = ys.t\n\n# ------------------------------------------------------------------ 3 · SIRT (yan arka flanşlarının önünde) + lazer yarık\nsr = sac(\"sirt\", \"dis\"); ts, gs = sr.t, g_(sr)\nZ_SIRT_ARKA = -D + t_yan; Z_SIRT_ON = Z_SIRT_ARKA + ts\nx0s = YS[\"xs\"] + g_(ys) + GM; x1s = W - x0s                      # yan arka bükümünün dışında\ny1s = H - t1 - t_yan - GM                                         # yan üst flanşının altında\nP_sr = sr.taban([(x0s + gs, Y_B), (x1s - gs, Y_B), (x1s - gs, y1s - gs), (x0s + gs, y1s - gs)], O=(0, 0, Z_SIRT_ARKA), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"sirt\")\nkisa_s = (Y_B + 40.0 + 2.0) - Y_B                                 # yan flanşlar taban arka flanşının üstünden başlar → relief\nsr_sag = P_sr.flans(1, 20, yon=+1, bas=kisa_s, ad=\"sag_flans\")\nsr_ust = P_sr.flans(2, 20, yon=+1, ad=\"ust_flans\")\nsr_sol = P_sr.flans(3, 20, yon=+1, son=kisa_s, ad=\"sol_flans\")\nsr.kose(sr_sag, sr_ust, \"acik\"); sr.kose(sr_ust, sr_sol, \"acik\")\nyariklar = P_sr.lazer_yarik_dizisi(W / 2.0, 950.0, 3, 4, aci=0.0)\n\n# su kırıcı perde (yarıkların 12 mm önünde, üst flanşı sırta puntalı)\npd = sac(\"su_kirici_perde\", \"ic\"); tp_, gp_ = pd.t, g_(pd)\nP_pd = pd.taban([(0, 0), (280, 0), (280, 70 - gp_), (0, 70 - gp_)], O=(160, 915, Z_SIRT_ON + 12.0), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"perde\")\npd_ust = P_pd.flans(2, 12.0 + tp_, yon=-1, ad=\"ust_flans\")\npd.punta(sr, [(x, 985.0 - tp_ / 2.0, Z_SIRT_ON) for x in (200.0, 300.0, 400.0)], not_=\"perde üst flanşı → sırt iç yüzü\")\n\n# ------------------------------------------------------------------ 4 · TABAN TAVASI (köşeler kaynaklı)\ntb = sac(\"taban\", \"yuk\"); tt, gb = tb.t, g_(tb)\nx0b, x1b = YS[\"xi\"] + GM, W - YS[\"xi\"] - GM\nz_on_b = Z_CER - 12.0 - GM                                        # yan dönüş ucunun arkası\nP_tb = tb.taban([(x0b + gb, -z_on_b + gb), (x1b - gb, -z_on_b + gb), (x1b - gb, -Z_SIRT_ON - gb), (x0b + gb, -Z_SIRT_ON - gb)],\n                O=(0, Y_B, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"taban\")\ntb_on = P_tb.flans(0, 40, yon=+1, ad=\"on_flans\"); tb_sag = P_tb.flans(1, 40, yon=+1, ad=\"sag_flans\")\ntb_arka = P_tb.flans(2, 40, yon=+1, ad=\"arka_flans\"); tb_sol = P_tb.flans(3, 40, yon=+1, ad=\"sol_flans\")\ntb.kose(tb_on, tb_sag, \"bindirme\", ustte=tb_on); tb.kose(tb_sag, tb_arka, \"bindirme\", ustte=tb_arka)\ntb.kose(tb_arka, tb_sol, \"bindirme\", ustte=tb_arka); tb.kose(tb_sol, tb_on, \"bindirme\", ustte=tb_on)\n\n# ------------------------------------------------------------------ 5 · RAF (yanlara saplama, sırta dil-yuva)\nrf = sac(\"raf\", \"yuk\"); tr, gr = rf.t, g_(rf)\nY_RAF = 600.0; z_raf_on = -100.0; z_raf_arka = Z_SIRT_ON + GM\nP_rf = rf.taban([(x0b + gr, -z_raf_on + gr), (x1b - gr, -z_raf_on + gr), (x1b - gr, -z_raf_arka), (x0b + gr, -z_raf_arka)],\n                O=(0, Y_RAF - tr, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"raf\")\nrf_on = P_rf.flans(0, 30, yon=-1, ad=\"on_flans\")\nrf_sag = P_rf.flans(1, 25, yon=-1, son=20.0, ad=\"sag_flans\")    # arkada sırt yan flanşlarına yer → relief\nrf_sol = P_rf.flans(3, 25, yon=-1, bas=20.0, ad=\"sol_flans\")\nrf.kose(rf_on, rf_sag, \"acik\"); rf.kose(rf_sol, rf_on, \"acik\")\nv_c0, v_c1 = -(Z_SIRT_ARKA + 20.0) - GM, -z_raf_arka + 1.0       # sırt yan flanşı için arka köşe çentikleri\nfor xa, xb in ((x0s - GM - 2.0, x0s + ts + GM), (x1s - ts - GM, x1s + GM + 2.0)):\n    P_rf.dikdortgen((xa + xb) / 2.0, (v_c0 + v_c1) / 2.0, xb - xa, v_c1 - v_c0, tip=\"centik\", dfm=False)\nu_arka = x1b - gr\nDIL = [S.dil_yuva(P_rf, 2, u_arka - (xc + 10.0), 20.0, P_sr) for xc in (150.0, 450.0)]\n\n# ------------------------------------------------------------------ 6 · KAPAK (çift cidarlı: dış tava + gömme J kulp · iç tava)\nkd = sac(\"kapak_dis_tava\", \"kapak_dis\"); tk, gk = kd.t, g_(kd)\nxk0, xk1 = YS[\"xs\"], W - YS[\"xs\"]; yk0, yk1 = Y_B, Y_KAPAK_UST\nCEP = 30.0\ny_e = yk1 - 2 * tk - kd.R - CEP                                   # ön yüzün üst kenarı (kulp cebinin altı)\nP_kd = kd.taban([(xk0 + gk, yk0 + gk), (xk1 - gk, yk0 + gk), (xk1 - gk, y_e), (xk0 + gk, y_e)], O=(0, 0, -tk), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"on_yuz\")\nkd_alt = P_kd.flans(0, KAPAK_D, yon=-1, ad=\"alt_flans\"); kd_sag = P_kd.flans(1, KAPAK_D, yon=-1, ad=\"sag_flans\")\nkd_k1 = P_kd.flans(2, KAPAK_D, yon=-1, ad=\"kulp_taban\"); kd_sol = P_kd.flans(3, KAPAK_D, yon=-1, ad=\"sol_flans\")\nkd.kose(kd_alt, kd_sag, \"bindirme\", ustte=kd_alt); kd.kose(kd_sag, kd_k1, \"bindirme\", ustte=kd_k1)\nkd.kose(kd_k1, kd_sol, \"bindirme\", ustte=kd_k1); kd.kose(kd_sol, kd_alt, \"bindirme\", ustte=kd_alt)\nkd_k2 = kd_k1.flans(1, yk1 - y_e - kd.R, yon=+1, ad=\"kulp_arka\")\nkd_k3 = kd_k2.flans(1, KAPAK_D, yon=+1, ad=\"kulp_ust\")\nkd_k4 = kd_k3.flans(1, 12.0, yon=+1, ad=\"kulp_dudak\")\n\nki = sac(\"kapak_ic_tava\", \"kapak_ic\"); ti, gi = ki.t, g_(ki)\nxi0, xi1 = xk0 + tk + KP[\"ic_dis_bosluk\"], xk1 - tk - KP[\"ic_dis_bosluk\"]\nyi0, yi1 = yk0 + tk + KP[\"ic_dis_bosluk\"], y_e + kd.R - KP[\"ic_dis_bosluk\"]\nP_ki = ki.taban([(xi0 + gi, yi0 + gi), (xi1 - gi, yi0 + gi), (xi1 - gi, yi1 - gi), (xi0 + gi, yi1 - gi)], O=(0, 0, -KAPAK_D), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"ic_tava\")\nki_f = [P_ki.flans(i, KP[\"ic_donus\"], yon=+1, ad=a) for i, a in enumerate((\"alt_flans\", \"sag_flans\", \"ust_flans\", \"sol_flans\"))]\nfor i in range(4): ki.kose(ki_f[i], ki_f[(i + 1) % 4], \"acik\")\nzp = -KAPAK_D + KP[\"ic_donus\"] / 2.0\nki.punta(kd, [(x, yi0 - KP[\"ic_dis_bosluk\"] / 2.0, zp) for x in (150, 300, 450)] + [(x, yi1 + 0.0, zp) for x in (150, 300, 450)]\n         + [(xi0 - KP[\"ic_dis_bosluk\"] / 2.0, y, zp) for y in (300, 575, 850)] + [(xi1 + KP[\"ic_dis_bosluk\"] / 2.0, y, zp) for y in (300, 575, 850)],\n         not_=\"iç tava dönüşleri → dış tava dönüşleri (0,5 boşluk elektrotla kapanır)\")\n\n# gizli menteşeler (sol) — kapak cebi iç tavada, kol yan ön flanşındaki yarıktan geçer, plaka yan iç yüzünde 2 × FHP-M5\nMENTESE = []\nfor i, yh in enumerate((260.0, 900.0)):\n    M = S._M(np.column_stack([[1, 0, 0], [0, -1, 0], [0, 0, -1]]), (xk0, yh, -KAPAK_D))\n    xm = 20.0; x_yan = YS[\"xi\"] - xk0\n    MENTESE.append(S.gizli_mentese(M, xm, x_yan, 20.0, (20.0, 90.0), plaka_delik=[(25.0, 70.0, 5.5), (-25.0, 70.0, 5.5)], ad=\"gizli_mentese_%d\" % (i + 1), birim=BIRIM))\n    P_ki.dikdortgen(xk0 + xm, yh, 17.0, 51.0, tip=\"mentese_cebi\")\n    on = YS[\"on\"]; q = on.yerel((xk0 + xm, yh, Z_CER - t_yan / 2.0))\n    on.dikdortgen(q[0], q[1], 16.0, 44.0, r=2.0, tip=\"mentese_yarigi\")\n    for dy in (25.0, -25.0):\n        BIRLESIM.append(S.saplama_baglantisi(YS[\"yan\"], (YS[\"xs\"], yh - dy, -KAPAK_D - 70.0), (1, 0, 0), 3.0, ad=\"mentese%d_saplama_%+d\" % (i + 1, int(dy)), birim=BIRIM))\n\n# ------------------------------------------------------------------ 7 · AYAKLAR (3 mm plaka + kaynaklı kör burç + ayarlı ayak)\nAYAK = []\nfor i, (x, z) in enumerate(((50.0, -80.0), (550.0, -80.0), (50.0, -780.0), (550.0, -780.0))):\n    pl = sac(\"ayak_plakasi_%d\" % (i + 1), \"braket\"); tpl = pl.t\n    pl.taban([(x - 40, -z - 40), (x + 40, -z - 40), (x + 40, -z + 40), (x - 40, -z + 40)], O=(0, Y_B - tpl, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"plaka\")\n    yb = Y_B - tpl\n    bu = S.kor_burc(\"M12\", (x, yb, z), (0, -1, 0), ad=\"ayak_burcu_%d\" % (i + 1), birim=BIRIM)\n    AYAK.append(bu)\n    AYAK.append(S.kaynak_halka((x, yb, z), (0, -1, 0), bu[\"meta\"][\"D\"] / 2.0, 3.0, ad=\"burc_kaynagi_%d\" % (i + 1), birim=BIRIM))\n    for j, (p0, p1, u1) in enumerate((((x - 40, Y_B, z - 40), (x - 40, Y_B, z + 40), (-1, 0, 0)), ((x + 40, Y_B, z - 40), (x + 40, Y_B, z + 40), (1, 0, 0)),\n                                      ((x - 40, Y_B, z - 40), (x + 40, Y_B, z - 40), (0, 0, -1)), ((x - 40, Y_B, z + 40), (x + 40, Y_B, z + 40), (0, 0, 1)))):\n        AYAK.append(S.kaynak_dikisi(p0, p1, u1, (0, -1, 0), tpl, ad=\"plaka_kaynagi_%d_%d\" % (i + 1, j + 1), birim=BIRIM, taraf=\"dis (köşe)\"))\n    AYAK += S.ayarli_ayak(\"M12\", (x, 0.0, z), (0, 1, 0), yb - bu[\"meta\"][\"H\"], ad=\"ayarli_ayak_%d\" % (i + 1), birim=BIRIM)\n\n# ------------------------------------------------------------------ 8 · BİRLEŞİMLER\nfor zz in (-100.0, -415.0, -730.0):                               # üst tabla yan flanşı (FHP flush dışta) → yan\n    BIRLESIM.append(S.vidali_birlesim(ut_sol, YS[\"yan\"], (1.0, H - 14.0, zz), \"pem_saplama\", ad=\"ust_sol_%d\" % -zz, birim=BIRIM))\n    BIRLESIM.append(S.vidali_birlesim(ut_sag, YSG[\"yan\"], (W - 1.0, H - 14.0, zz), \"pem_saplama\", ad=\"ust_sag_%d\" % -zz, birim=BIRIM))\nfor zz in (-150.0, -430.0, -710.0):                               # yan (FHP flush dışta) → taban yan flanşı\n    BIRLESIM.append(S.vidali_birlesim(YS[\"yan\"], 