h = [m for m in d if m[\"durum\"] == \"HATA\"]; u = [m for m in d if m[\"durum\"] == \"UYARI\"]; toplam_hata += len(h)\n    ab = [m for m in d if m[\"kural\"] == \"abkant\"]\n    RAPOR[\"parcalar\"][s.ad] = dict(t=s.t, R=s.R, K=s.K, rol=s.rol, bukum=len(s.bukumler), levha=a[\"levha\"], delik=len(a[\"ic_konturlar\"]),\n                                   dogrulama={k: v for k, v in r.items() if k not in (\"kalinlik\",)}, kalinlik={k: v for k, v in r[\"kalinlik\"].items()},\n                                   dfm=d, punta=s.puntalar)\n    log(\"%-16s t%.1f R%.2f K%.2f · %d büküm · açınım %.0f×%.0f · ΔV(açınımdan) %%%s sim %%%s · kalınlık %s (%d ana/%d kenar) · kesit %s · DFM %d HATA %d UYARI%s\"\n        % (s.ad, s.t, s.R, s.K, len(s.bukumler), a[\"levha\"][\"boy\"], a[\"levha\"][\"en\"], r.get(\"hacim_farki_yuzde\"), r.get(\"simetrik_fark_yuzde\"),\n           r[\"kalinlik\"][\"gecti\"], r[\"kalinlik\"][\"ana\"], r[\"kalinlik\"][\"kenar\"], r.get(\"kesit_gecti\"), len(h), len(u),\n           (\" · abkant sıra %s\" % ab[0].get(\"sira\")) if ab else \"\"))\n    for m in h + u: print(\"        %s %-16s %s\" % (m[\"durum\"], m[\"kural\"], m[\"detay\"][:230]))\n\nPARCALAR = [p for s in SACLAR for p in s.parcalar()] + MENTESE + AYAK + [x for b in BIRLESIM for x in b[\"parcalar\"]]\nfor b in BIRLESIM:\n    RAPOR[\"birlesimler\"].append({k: v for k, v in b.items() if k != \"parcalar\"} | dict(elemanlar=[x[\"ad\"] for x in b[\"parcalar\"]]))\nlog(\"çakışma denetimi: %d parça\" % len(PARCALAR))\ncak, izin = S.cakisma_denetle(PARCALAR)\nRAPOR[\"cakisma\"] = dict(cakisan=cak, izinli=izin)\nlog(\"çakışma %d · izinli (PEM gömme başı) %d%s\" % (len(cak), len(izin), (\" → \" + str(cak[:8])) if cak else \"\"))\n\n# kesitler: büküm yarıçapları kesitte görünüyor mu (y = 500 yatay, x = 300 düşey)\nimport _ciz\nKES = {}\nfor ad_, nokta, nrm, eks in ((\"yatay_y500\", (0, 500.0, 0), (0, 1, 0), (0, 2)), (\"duşey_x300\", (300.0, 0, 0), (1, 0, 0), (2, 1))):\n    kk, yar = [], {}\n    for s in 