001, 0.0001]} \r\n711 URUN__harc_1 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n712 URUN__harc_2 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n713 URUN__harc_3 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n714 URUN__harc_4 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n715 URUN__harc_5 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n716 URUN__kiyma_0 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n717 URUN__kiyma_1 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n718 URUN__kiyma_2 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n719 URUN__kiyma_3 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n720 URUN__kusbasi_0 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n721 URUN__kusbasi_1 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n722 URUN__kusbasi_2 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n723 URUN__kusbasi_3 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n724 URUN__kesik {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n725 URUN__L2_hamur {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n726 URUN__L2_harc_0 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n727 URUN__L2_harc_1 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n728 URUN__L2_harc_2 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n729 URUN__L2_harc_3 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n730 URUN__L2_harc_4 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n731 URUN__L2_harc_5 {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n732 URUN__L2_kesik {'rotation': [0.0, 0.0, 0.0, 1.0], 'scale': [0.0001, 0.0001, 0.0001]} \r\n738 E_KOSE__CNR_MF {'rotation': [-0.0, -0.130373815870121, 0.006305155900502124, 0.9914448613738104]} \r\n739 E_KOSE__CNR_MB {'rotation': [0.0, 0.130373815870121, -0.006305155900502124, 0.9914448613738104]} \r\n740 E_KOSE__CNR_PF {'rotation': [0.0, 0.130373815870121, 0.006305155900502124, 0.9914448613738104]} \r\n741 E_KOSE__CNR_PB {'rotation': [-0.0, -0.130373815870121, -0.006305155900502124, 0.9914448613738104]} \r\n742 E_PARMAK__PARMAK {'rotation': [0.0, 0.0, -0.7071067811865476, 0.7071067811865476]} \r\n743 E_KAPAK__KOL {'rotation': [0.0, 0.0, 0.0, 1.0]} \r\n744 E_KUTU__B_ROOT {'scale': [1.0, 1.0, 1.0], 'children': [745, 746, 751, 753]} \r\n745 E_KUTU__B_SWM {'rotation': [0.0, 0.0, 0.0, 1.0], 'children': [747, 748]} child\r\n746 E_KUTU__B_SWP {'rotation': [-0.0, 0.0, 0.0, 1.0], 'children': [749, 750]} child\r\n747 E_KUTU__B_CTMF {'rotation': [0.0, 0.0, -0.0, 1.0]} child\r\n748 E_KUTU__B_CTMB {'rotation': [0.0, 0.0, 0.0, 1.0]} child\r\n749 E_KUTU__B_CTPF {'rotation': [0.0, 0.0, -0.0, 1.0]} child\r\n750 E_KUTU__B_CTPB {'rotation': [0.0, 0.0, 0.0, 1.0]} child\r\n751 E_KUTU__B_FO {'rotation': [0.0, 0.0, -0.0, 1.0], 'children': [752]} child\r\n752 E_KUTU__B_FI {'rotation': [0.0, 0.0, -0.0, 1.0]} child\r\n753 E_KUTU__B_BW {'rotation': [0.0, 0.0, 0.0, 1.0], 'children': [754]} child\r\n754 E_KUTU__B_LID {'rotation': [0.0, 0.0, 0.0, 1.0], 'children': [755, 756, 757]} child\r\n755 E_KUTU__B_LF {'rotation': [0.0, 0.0, 0.0, 1.0]} child","is_error":false}]},"uuid":"828efe74-df70-407f-8380-94bfa0fb5ba1","timestamp":"2026-10-02T22:48:46.700Z","sourceToolAssistantUUID":"c57836a6-e123-4408-86ec-341f5d6e5f7f","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8\\otonom\\hat","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
