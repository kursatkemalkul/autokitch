=============================\n376:def davlumbaz():\n377:    B = \"F_DAVLUMBAZ\"\n384:    ekle(\"f_davlumbaz_kutusu\", w, \"sac\", B, kaynak=\"SPEC §2.4 basit sac kutu · üst 1790 KARAR (hava hattı K dalı)\",\n387:    ekle(\"f_davlumbaz_atis_kanali\", kut(ATIS[0], ATIS[1], y1, Y_TAVAN, ATIS[2], ATIS[3]).cut(kut(ATIS[0] + SAC, ATIS[1] - SAC, y1 - 1.0, Y_TAVAN + 1.0, ATIS[2] + SAC, ATIS[3] - SAC)),\n388:         \"sac\", B, bom=(\"Atış kanalı 304 1,5 · 300 × 200 × 70\", 1, \"abkant + kaynak\", \"davlumbaz kutusu → üst sac atış ağzı\", \"ÜRETİM\"))\n392:        ekle(\"f_davlumbaz_askisi_%s\" % tag, kb, \"paslanmaz\", B,\n425:    govde(); kapaklar(); yaylar(); davlumbaz(); kompresor_ayaklari()\n615:    _dm = min(_mes(HV[i][1], s) for i in (0, 1) for a, s in S if a.startswith((\"f_ust_yan_\", \"f_davlumbaz_\", \"f_ust_tavan\", \"f_ust_arka_sac\", \"f_ust_rakor_\")))\n624:    _dv = BB[\"f_davlumbaz_kutusu\"]\n625:    kontrol(\"DAVLUMBAZ KUTUSU x %.1f–%.1f · y %.0f–%.0f · z %.1f…%.1f: hava hattının (y 1804–1814) altında, pizza (−424) / kompresör (−420 gerçek) arkasında\"\n706:    print(\"   BİLGİ · HAVALANDIRMA: kapak yarıkları alt %.0f + üst %.0f mm² (serbest) · davlumbaz emiş yarıkları %.0f mm² · arka panjur 2 × %.0f mm² · doğal çekiş (h 0,41 m, ΔT 15 K) \"\n707:          \"≈ %.0f m³/h → ≈ %.0f W taşır: fırın üst yüzü + kompresör için YETMEZ → davlumbaz fanı bölmeden emer (cebri, AÇIK: fan seçimi)\"","is_error":false}]},"uuid":"04a1432d-4977-4a03-a496-fd68c6512733","timestamp":"2026-10-02T20:21:13.130Z","sourceToolAssistantUUID":"cda71586-3523-44ce-ba84-6a7d5df33940","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8\\otonom\\hat","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
