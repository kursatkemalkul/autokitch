NS_Z, ['ust', ('ust', (0.0, 0.0, 30.0)), 'on'], t, 'Zincir kanalı + 2 L konsol (tezgâhta kör perçinli) → zemin geçişine, konsollar tabandaki saplamalara', kamera_yakin=True)\"\"\")\n16\tR(\"adim('Zincir kanalı + B elektrik montaj plakası', \\\"Teknik bölme boşken: enerji zinciri\", \"adim('Teknik bölme: soğutma grubu, elektrik plakası, zincir kanalı', \\\"Teknik bölme boşken: soğutma grubu (kompresör + kondenser + fan, tek ürün) iner, taban raylarının uçları 4 × ISO 4762 M4 + pul ile. Enerji zinciri\")\n17\ta = s.index(\"    if k == 5:\\n        t = baglantilari_tamamla(t) + 0.1\\n        olay(t, 'Teknik kapama sacından önce\"); b = s.index(\"    b = 'g_bolme_%d_sac_b' % k if k < 5 else 'g_teknik_sol_duvar'\")\n18\ts = s[:a] + s[b:]\n19\tR(\"\"\"[('on', YAN), 'sag', 'ust'] if k < 5 else ['ust', ('on', YAN)]\"\"\", \"\"\"[('on', YAN), 'sag', 'ust'] if k < 5 else ['on', ('on', YAN), 'ust']\"\"\")\n20\t# taban tapaları\n21\tR(\"\"\"for a in ['g_ic_taban_1', 'g_ic_taban_2']: t = yerlestir([a], ['ust', 'on'], t, '%s (arka kenarı yukarı bükülü) → yalıtım levhasının üstüne' % P[a]['ac'])\"\"\",\n22\t\"\"\"TAPA = sorted(a for a in P if a.startswith('g_pu_taban_tapa'))\n23\tfor a in TAPA: P[a]['ac'] = 'PU tapa Ø25'; yerlestir([a], ['ust'], t, None, sure_bekle=0.0)\n24\tt = bitti(); olay(t - 0.4, 'PU tapa Ø25 × 10 → levhadaki deliklerden şase cıvatalarının başı üstüne')\n25\tfor a in ['g_ic_taban_1', 'g_ic_taban_2']: t = yerlestir([a], ['ust', 'on'], t, '%s (arka kenarı yukarı bükülü) → yalıtım levhasının üstüne' % P[a]['ac'])\"\"\")\n26\tR(\"\"\"adim('Taban yalıtımı + iç taban', 'GFRP ısı köprüsü takozları (dikme altları) dış tabana; taban yalıtım levhası (PU, kesilmiş: dikme, takoz ve cıvata boşlukları açık) dış tabana yapıştırılır (yeşil yapıştırıcı);\"\"\",\n27\t\"\"\"adim('Taban yalıtımı + iç taban', 'GFRP ısı köprüsü takozları (dikme altları) dış tabana; taban yalıtım levhası (PU, kesilmiş: dikme ve takoz boşlukları, şase cıvatalarının üstünde Ø25 delik) dış tabana yapıştırılır (yeşil yapıştırıcı), deliklere PU tapa;\"\"\")\n28\t# iç tavan + PU tavan tezgâh sandviçi\n29\tR(\"\"\"for a in ['g_ic_tavan_1', 'g_ic_tavan_2']: t = yerlestir([a], ['ust', 'on'], t, '%s → bölmelerin üstüne' % P[a]['ac'])\n30\tt = baglantilari_tamamla(t) + 0.1\n31\tfor a in ['g_pu_tavan_yuksek', 'g_pu_tavan_topping', 'g_pu_tavan_firin']:\n32\t    t = yerlestir([a], ['ust', 'on'], t, '%s → iç tavanın üstüne' % P[a]['ac']); t = yapistir(a, 1, -1, t)\"\"\",\n33\t\"\"\"for sac_, pus in (('g_ic_tavan_1', ['g_pu_tavan_yuksek']), ('g_ic_tavan_2', ['g_pu_tavan_topping', 'g_pu_tavan_firin'])):\n34\t    yp = [yapistirici(a, 1, -1) for a in pus]\n35\t    t = yerlestir([sac_] + pus + yp, ['ust', 'on'], t, '%s + tavan yalıtım levhası (tezgâhta yapıştırılmış; perçin uçları için levha altı cepli) → bölmelerin üstüne' % P[sac_]['ac'], tezgah_kaynak=yp)\n36\t    for n_ in yp:\n37\t        while n_ in YERINDE: YERINDE.remove(n_)\n38\tt = baglantilari_tamamla(t, 'İç tavan: bölme ve sol duvar üst flanşlarına alttan (gıda tarafından) DIN 7337 Ø4 kör perçin (mavi)') + 0.1\"\"\")\n39\tR(\"\"\"'İç tavan 1 / 2 bölmelerin üstüne — bölme ve sol duvar flanşlarına alttan kör perçin; tavan yalıtım levhaları (PU) yapıştırılır;\"\"\",\n40\t\"\"\"'İç tavan 1 / 2 tezgâhta tavan yalıtım levhalarıyla (PU, yapıştırılmış) birlikte bölmelerin üstüne iner — bölme ve sol duvar flanşlarına alttan kör perçin;\"\"\")\n41\t# kelepçe / konsol adayları\n42\tR(\"\"\"                tt_ = yerlestir([a], ['on', 'ust', 'sag', 'sol', 'alt', 'arka'], tt_, None, sure_bekle=0.0); continue\"\"\",\n43\t\"\"\"                n_ = np.asarray(P[a]['n'], float) if P[a].get('n') else np.zeros(3)\n44\t                ad_ = ['on', 'ust', ('on', tuple(-12.0 * n_)), ('ust', tuple(-12.0 * n_)), ('on', (12.0, 0, 0)), ('on', (-12.0, 0, 0)), ('ust', (12.0, 0, 0)), 'sag', 'sol', 'alt', 'arka']\n45\t                tt_ = yerlestir([a], ad_, tt_, None, sure_bekle=0.0); continue\"\"\")\n46\tio.open(p, 'w', encoding='utf-8', newli