-research_c-trials__get_trial_details\nmcp__plugin_bio-research_c-trials__search_by_eligibility\nmcp__plugin_bio-research_c-trials__search_by_sponsor\nmcp__plugin_bio-research_c-trials__search_investigators\nmcp__plugin_bio-research_c-trials__search_trials\nmcp__plugin_bio-research_chembl__compound_search\nmcp__plugin_bio-research_chembl__drug_search\nmcp__plugin_bio-research_chembl__get_admet\nmcp__plugin_bio-research_chembl__get_bioactivity\nmcp__plugin_bio-research_chembl__get_mechanism\nmcp__plugin_bio-research_chembl__target_search\nmcp__plugin_bio-research_consensus__search\nmcp__plugin_bio-research_ot__batch_query_open_targets_graphql\nmcp__plugin_bio-research_ot__get_open_targets_graphql_schema\nmcp__plugin_bio-research_ot__get_type_dependencies\nmcp__plugin_bio-research_ot__query_open_targets_graphql\nmcp__plugin_bio-research_ot__search_entities\nmcp__plugin_bio-research_pubmed__convert_article_ids\nmcp__plugin_bio-research_pubmed__find_related_articles\nmcp__plugin_bio-research_pubmed__get_article_metadata\nmcp__plugin_bio-research_pubmed__get_copyright_status\nmcp__plugin_bio-research_pubmed__get_full_text_article\nmcp__plugin_bio-research_pubmed__lookup_article_by_citation\nmcp__plugin_bio-research_pubmed__search_articles\nmcp__plugin_small-business_gmail__apply_sensitive_message_label\nmcp__plugin_small-business_gmail__apply_sensitive_thread_label\nmcp__plugin_small-business_gmail__create_draft\nmcp__plugin_small-business_gmail__create_label\nmcp__plugin_small-business_gmail__get_draft\nmcp__plugin_small-business_gmail__get_message\nmcp__plugin_small-business_gmail__get_thread\nmcp__plugin_small-business_gmail__label_message\nmcp__plugin_small-business_gmail__label_thread\nmcp__plugin_small-business_gmail__list_drafts\nmcp__plugin_small-business_gmail__list_labels\nmcp__plugin_small-business_gmail__mark_message_spam\nmcp__plugin_small-business_gmail__mark_thread_spam\nmcp__plugin_small-business_gmail__search_threads\nmcp__plugin_small-business_gmail__tr