{"parentUuid":"ea40c2fa-0ac6-436a-ae6a-6048ca6b08e7","isSidechain":true,"agentId":"adc2a93d082554cd4","message":{"model":"claude-opus-5-5","id":"msg_011CfbzYHUhp9he92njU5fpj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AbzyYHKRiHQFekrcgr5PL3","name":"Write","input":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\elk_v36\\yama_hat.py","content":"# -*- coding: utf-8 -*-\n\"\"\"v3.6 · h3_elk_hat_v1.py yaması: zemin üstü kanal ön ayakların arkasına + bina beslemesi zemin kanalına · plint delikleri kalktı ·\ndolap taban rakoru → Harting · iniş K / E / TOPPING → Harting · TOPPING üst hattı A'ya uzar\"\"\"\nimport io, sys\nP = sys.argv[1]\ns = io.open(P, encoding=\"utf-8\").read()\n\n\ndef rep(a, b, n=1):\n    global s\n    assert s.count(a) == n, (a[:90], s.count(a)); s = s.replace(a, b)\n\n\ndef blok(bas, son, yeni):\n    global s\n    i = s.index(bas); j = s.index(son, i); s = s[:i] + yeni + s[j:]\n\n\n# 0 · docstring\nrep('  Fırın altı kanalındaki kablolar SİLİKON yalıtımlı (Lapp ÖLFLEX HEAT 180 SiF) — VARSAYIM: boşluk sıcaklığı ölçülecek (AÇIK).\"\"\"',\n    '  Fırın altı kanalındaki kablolar SİLİKON yalıtımlı (Lapp ÖLFLEX HEAT 180 SiF) — VARSAYIM: boşluk sıcaklığı ölçülecek (AÇIK).\\n'\n    'v3.6 (1 Eki 2026 · Claude · YEREL) — Kemal: \"ana pano + beyin U_F\\'de (h3_ana_pano_v1) · her istasyon kendi kutusu + Harting fişiyle · alt etekler kalkıyor\".\\n'\n    '  · ANA HAT YÖNÜ TERS: U_F ana pano → toplama kanalı (pano solu, U_F tavanı altında) → U_F üst hattı → (K · E inişleri) / (TOPPING · A) / gövde kanalı aşağı →\\n'\n    '    TOPPING kuru bölmesi → C kaidesi → fırın altı (F kutusu yukarı) → teknik sütun → zemin üstü kanal (DOLAP Harting · QR + ROBOT · bina beslemesi).\\n'\n    '  · ZEMİN ÜSTÜ KANAL ön ayak sırasının ARKASINA (z −195…−135) alındı: etekler kalkınca önden görünmez · plint geçiş delikleri KALKTI ·\\n'\n    '    bina beslemesi QR\\'ye girmez: bağlantı kutusundan zemin üstü kanalla koridor kör ucuna, oradan ana hatla ana panoya.\\n'\n    '  · İSTASYON GİRİŞLERİ Harting Han 10B (soket istasyon gövdesinde, fiş + M32 ana hat ucunda): TOPPING (kuru pano sağ yüzü) · K / E (tavan, U_KE rafında fiş kesiği) ·\\n'\n    '    DOLAP (teknik sütun tabanı, fiş zemin kanalının içine) · A + F (yeni istasyon kutuları, istasyon_kur) · QR + ROBOT (h3_elk_qr_v1).\"\"\"')\n# 1 · zemin üstü kanal + bina beslemesi\nblok('    ZU = [(5349.0, 5409.0, -70.0, 600.0),', '    ekle(\"zemin_ustu_kanal\", g, \"paslanmaz\", B,',\n     '    ZU = [(5349.0, 5409.0, -195.0, 600.0),                   # koridor kör ucu (ray + oluk 5100\\'de biter) · QR girişindeki başlığa kadar\\n'\n     '          (4040.0, 5409.0, -195.0, -135.0),                  # v3.6 · E + dolap ön AYAK SIRASININ ARKASI (ayak z −130,4…−89,6): etekler kalkınca önden görünmez\\n'\n     '          (4040.0, 4130.0, -829.0, -135.0),                  # teknik sütunun altı: ana yükseliş çıkışı (z −686…−646)\\n'\n     '          (4040.0, 4300.0, -680.0, -590.0),                  # v3.6 · DOLAP Harting fişi (teknik sütun tabanı x 4217–4283, fiş kanalın içine iner)\\n'\n     '          (5349.0, 5500.0, 540.0, 600.0), (5440.0, 5500.0, 540.0, 755.0), (5440.0, 5735.0, 695.0, 755.0)]   # v3.6 · bina beslemesi: bağlantı kutusu → kör uç\\n'\n     '    g, k = zu_kanal(ZU)\\n'\n     '    CIK = [(4100.0, 4130.0, -686.0, -646.0)]                                          # ana yükseliş girişi (v3.6: dolap rakoru → Harting)\\n'\n     '    for x0, x1, z0, z1 in CIK:\\n'\n     '        k = k.cut(kut(x0, x1, 49.0, 53.0, z0, z1))\\n'\n     '    k = k.cut(kut(DOLAP_HARTING[0] - 36.0, DOLAP_HARTING[0] + 36.0, 49.0, 53.0, DOLAP_HARTING[2] - 24.0, DOLAP_HARTING[2] + 24.0))   # v3.6 · DOLAP fişi\\n')\nrep('\"lazer + abkant\", \"gömme YOK (Kemal 1 Eki) · koridorda iki yan rampa\"))',\n    '\"lazer + abkant\", \"gömme YOK (Kemal 1 Eki) · koridorda iki yan rampa · v3.6: ön ayakların arkasında, bina beslemesi de bu kanalda\"))')\nrep('    for nm, (x0, x1, yon) in ((\"sol\", (5319.0, 5349.0, \"-x\")), (\"sag\", (5409.0, 5439.0, \"+x\"))):\\n        ekle(\"zemin_ustu_kanal_rampa_%s\" % nm, rampa(x0, x1, 80.0, 598.0, 51.5, yon), \"paslanmaz\", B,',\n    '    for nm, (x0, x1, yon, zr1) in ((\"sol\", (5319.0, 5349.0, \"-x\", 598.0)), (\"sag\", (5409.0, 5439.0, \"+x\", 538.0))):   # v3.6 · sağ rampa bina kanalına kadar\\n        ekle(\"zemin_ustu_kanal_rampa_%s\" % nm, rampa(x0, x1, 80.0, zr1, 51.5, yon), \"paslanmaz\", B,')\nblok('    for i, (x0, x1, z0, z1) in enumerate(CIK):\\n        ekle(\"zemin_ustu_cikis_%d\" % i,', '    # QR girişi (b) başlığı',\n     '    for i, (x0, x1, z0, z1) in enumerate(CIK):\\n'\n     '        ekle(\"zemin_ustu_cikis_%d\" % i, ici_bos([(x0 - T, x1 + T, 50.0, 123.0, z0 - T, z1 + T)], [(x0, x1, 49.0, 124.0, z0, z1)]), \"paslanmaz\", B,\\n'\n     '             bom=(\"Kanal çıkış kutusu 304 (kanal kapağından dolap tabanına)\", 1, \"\", \"\") if i == 0 else None)\\n')\nblok('    # BİNA BESLEMESİ (5G6, QR sağ yan girişi c)', '    # ---------------- 2 · DOLAP',\n     '    # BİNA BESLEMESİ (5G6): v3.6 · QR\\'ye girmez — bağlantı kutusundan zemin üstü kanalla (ZU son 3 kutu) koridor kör ucuna → ana hat → U_F ana panosu (M32)\\n'\n     '    ekle(\"zemin_ustu_bina_baglanti_kutusu\", ici_bos([(5735.0, 5855.0, 0.0, 200.0, 665.0, 785.0)], [(5735.0 + T, 5855.0 - T, T, 200.0 - T, 665.0 + T, 785.0 - T),\\n'\n     '                                                                                              (5733.0, 5737.0, T, 50.0, 695.0 + T, 755.0 - T)]),\\n'\n     '         \"cihaz_koyu\", B, bom=(\"Bina bağlantı kutusu IP65 120 × 200 × 120 (5G6 → bina tesisatı, sigortalı ayırıcı yeri)\", 1, \"Spelsberg / Hensel sınıfı\", \"AÇIK: dükkân tesisatçısı\"))\\n'\n     '    # v3.6 · plint (alt etek) geçiş delikleri KALKTI (montaj etekleri kaldırıyor: E onyuz_plint · B onyuz_plint_donus_sag)\\n')\n# 2 · dolap: taban rakoru → Harting (istasyon_kur) · dikey kanal + pano altı kanalı kalır\nblok('    rx, rz = (DOLAP_RIS[\"x\"][0] + DOLAP_RIS[\"x\"][1]) / 2.0, (DOLAP_RIS[\"z\"][0] + DOLAP_RIS[\"z\"][1]) / 2.0\\n', '    g = kut(DOLAP_RIS[\"x\"][0], DOLAP_RIS[\"x\"][1], 135.0, 415.0,',\n     '    # v3.6 · dolap taban rakoru M25 KALKTI → DOLAP Harting Han 10B (teknik sütun tabanı, istasyon_kur) · içeride Harting → dikey kanal → pano (iç tesisat)\\n')\n# 3 · inişler: K / E → Harting\nblok('    for nm, xd, yalt, zd, mods in ((\"E\", 5100.0, 1840.0, -805.0,', '    # TOPPING panosu: kuru bölme kanalından',\n     '    for nm, xd, zd, mods in ((\"E\", 5100.0, -775.0, ((\"UD\", \"ust_ke_taban_sac\"), (\"KC\", \"ust_sac\"))), (\"K\", 4300.0, -775.0, ((\"UD\", \"ust_ke_taban_sac\"), (\"KS\", \"ust_sac\")))):\\n'\n     '        H = EO.harting((xd, 1863.9, zd + 15.0), \"+y\", \"x\", t_duvar=3.8)                 # v3.6 · istasyon tavanı (2,3) + U_KE tabanı (2,3) üst üste\\n'\n     '        for m_, a_ in mods:\\n'\n     '            DELIKLER.append((m_, a_, H[\"kesik\"], \"v3.6 %s Harting Han 10B soket kesiği\" % nm))\\n'\n     '        DELIKLER.append((\"UD\", \"ust_ke_icecek_rafi\", kut(xd - 45.0, xd + 45.0, 1890.0, 1898.0, zd + 15.0 - 26.0, zd + 15.0 + 26.0), \"v3.6 %s Harting fişi raf kesiği\" % nm))\\n'\n     '        ekle(\"harting_%s_soket\" % nm, H[\"soket\"], \"rakor\", B); ekle(\"harting_%s_fis\" % nm, H[\"fis\"], \"rakor\", B); ekle(\"harting_%s_rakoru_M32\" % nm, H[\"rakor\"], \"rakor\", B)\\n'\n     '        u_ = H[\"uc\"]; yk = u_[1] + 5.0\\n'\n     '        g = kut(xd - 20.0, xd + 20.0, yk, ys0, zd, zd + 30.0).cut(kut(xd - 20.0 + T, xd + 20.0 - T, yk - 1.0, ys0 + 1.0, zd + T, zd + 31.0))\\n'\n     '        ekle(\"inis_%s_kanali\" % nm, g, \"kanal\", B, bom=(\"İniş kanalı PVC 40 × 30 + kapak (üst hat → Harting fişi)\", 2, \"\", \"\") if nm == \"E\" else None)\\n'\n     '        ekle(\"inis_%s_kanali_kapak\" % nm, kut(xd - 20.0, xd + 20.0, yk, ys0, zd + 30.0, zd + 30.0 + T), \"kanal\", B)\\n'\n     '        ekle(\"inis_%s_ana_hat_ucu\" % nm, boru([u_, (u_[0], yk + 8.0, u_[2])], 8.5), \"kablo\", B)\\n')\n# 4 · TOPPING: rakor → Harting (kuru pano sağ yüzü) · üst hat A'ya uzar\nblok('    # TOPPING panosu: kuru bölme kanalından', '__SON__' if '__SON__' in s else None, '') if False else None\ni = s.index('    # TOPPING panosu: kuru bölme kanalından')\ns = s[:i] + ('    # v3.6 · TOPPING: kuru panonun SAĞ yüzünde Harting Han 10B (fiş +x) → M32 → üst hat kanalının tabanından içeri\\n'\n             '    H = EO.harting(TOPPING_HARTING, \"+x\", \"y\", t_duvar=1.5)\\n'\n             '    DELIKLER.append((\"TC\", \"kuru_pano_kutusu\", H[\"kesik\"], \"v3.6 TOPPING Harting Han 10B soket kesiği\"))\\n'\n             '    ekle(\"harting_TOPPING_soket\", H[\"soket\"], \"rakor\", B); ekle(\"harting_TOPPING_fis\", H[\"fis\"], \"rakor\", B); ekle(\"harting_TOPPING_rakoru_M32\", H[\"rakor\"], \"rakor\", B)\\n'\n             '    u_ = H[\"uc\"]\\n'\n             '    ekle(\"inis_TOPPING_ana_hat_ucu\", boru([u_, (TOPPING_UST_X, u_[1], u_[2]), (TOPPING_UST_X, yf0 + 8.0, u_[2])], 8.5), \"kablo\", B)\\n')\nio.open(P, \"w\", encoding=\"utf-8\").write(s)\nprint(\"hat yamalandı\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8184,"cache_read_input_tokens":394995,"output_tokens":5640,"output_tokens_details":{"thinking_tokens":575},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":8184},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":5640,"cache_read_input_tokens":394995,"cache_creation_input_tokens":8184,"cache_creation":{"ephemeral_5m_input_tokens":8184,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01AbzyYHKRiHQFekrcgr5PL3":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\elk_v36\\yama_hat.py","content":"# -*- coding: utf-8 -*-\n\"\"\"v3.6 · h3_elk_hat_v1.py yaması: zemin üstü kanal ön ayakların arkasına + bina beslemesi zemin kanalına · plint delikleri kalktı ·\ndolap taban rakoru → Harting · iniş K / E / TOPPING → Harting · TOPPING üst hattı A'ya uzar\"\"\"\nimport io, sys\nP = sys.argv[1]\ns = io.open(P, encoding=\"utf-8\").read()\n\n\ndef rep(a, b, n=1):\n    global s\n    assert s.count(a) == n, (a[:90], s.count(a)); s = s.replace(a, b)\n\n\ndef blok(bas, son, yeni):\n    global s\n    i = s.index(bas); j = s.index(son, i); s = s[:i] + yeni + s[j:]\n\n\n# 0 · docstring\nrep('  Fırın altı kanalındaki kablolar SİLİKON yalıtımlı (Lapp ÖLFLEX HEAT 180 SiF) — VARSAYIM: boşluk sıcaklığı ölçülecek (AÇIK).\"\"\"',\n    '  Fırın altı kanalındaki kablolar SİLİKON yalıtımlı (Lapp ÖLFLEX HEAT 180 SiF) — VARSAYIM: boşluk sıcaklığı ölçülecek (AÇIK).\\n'\n    'v3.6 (1 Eki 2026 · Claude · YEREL) — Kemal: \"ana pano + beyin U_F\\'de (h3_ana_pano_v1) · her istasyon kendi kutusu + Harting fişiyle · alt etekler kalkıyor\".\\n'\n    '  · ANA HAT YÖNÜ TERS: U_F ana pano → toplama kanalı (pano solu, U_F tavanı altında) → U_F üst hattı → (K · E inişleri) / (TOPPING · A) / gövde kanalı aşağı →\\n'\n    '    TOPPING kuru bölmesi → C kaidesi → fırın altı (F kutusu yukarı) → teknik sütun → zemin üstü kanal (DOLAP Harting · QR + ROBOT · bina beslemesi).\\n'\n    '  · ZEMİN ÜSTÜ KANAL ön ayak sırasının ARKASINA (z −195…−135) alındı: etekler kalkınca önden görünmez · plint geçiş delikleri KALKTI ·\\n'\n    '    bina beslemesi QR\\'ye girmez: bağlantı kutusundan zemin üstü kanalla koridor kör ucuna, oradan ana hatla ana panoya.\\n'\n    '  · İSTASYON GİRİŞLERİ Harting Han 10B (soket istasyon gövdesinde, fiş + M32 ana hat ucunda): TOPPING (kuru pano sağ yüzü) · K / E (tavan, U_KE rafında fiş kesiği) ·\\n'\n    '    DOLAP (teknik sütun tabanı, fiş zemin kanalının içine) · A + F (yeni istasyon kutuları, istasyon_kur) · QR + ROBOT (h3_elk_qr_v1).\"\"\"')\n# 1 · zemin üstü kanal + bina beslemesi\nblok('    ZU = [(5349.0, 5409.0, -70.0, 600.0),', '    ekle(\"zemin_ustu_kanal\", g, \"paslanmaz\", B,',\n     '    ZU = [(5349.0, 5409.0, -195.0, 600.0),                   # koridor kör ucu (ray + oluk 5100\\'de biter) · QR girişindeki başlığa kadar\\n'\n     '          (4040.0, 5409.0, -195.0, -135.0),                  # v3.6 · E + dolap ön AYAK SIRASININ ARKASI (ayak z −130,4…−89,6): etekler kalkınca önden görünmez\\n'\n     '          (4040.0, 4130.0, -829.0, -135.0),                  # teknik sütunun altı: ana yükseliş çıkışı (z −686…−646)\\n'\n     '          (4040.0, 4300.0, -680.0, -590.0),                  # v3.6 · DOLAP Harting fişi (teknik sütun tabanı x 4217–4283, fiş kanalın içine iner)\\n'\n     '          (5349.0, 5500.0, 540.0, 600.0), (5440.0, 5500.0, 540.0, 755.0), (5440.0, 5735.0, 695.0, 755.0)]   # v3.6 · bina beslemesi: bağlantı kutusu → kör uç\\n'\n     '    g, k = zu_kanal(ZU)\\n'\n     '    CIK = [(4100.0, 4130.0, -686.0, -646.0)]                                          # ana yükseliş girişi (v3.6: dolap rakoru → Harting)\\n'\n     '    for x0, x1, z0, z1 in CIK:\\n'\n     '        k = k.cut(kut(x0, x1, 49.0, 53.0, z0, z1))\\n'\n     '    k = k.cut(kut(DOLAP_HARTING[0] - 36.0, DOLAP_HARTING[0] + 36.0, 49.0, 53.0, DOLAP_HARTING[2] - 24.0, DOLAP_HARTING[2] + 24.0))   # v3.6 · DOLAP fişi\\n')\nrep('\"lazer + abkant\", \"gömme YOK (Kemal 1 Eki) · koridorda iki yan rampa\"))',\n    '\"lazer + abkant\", \"gömme YOK (Kemal 1 Eki) · koridorda iki yan rampa · v3.6: ön ayakların arkasında, bina beslemesi de bu kanalda\"))')\nrep('    for nm, (x0, x1, yon) in ((\"sol\", (5319.0, 5349.0, \"-x\")), (\"sag\", (5409.0, 5439.0, \"+x\"))):\\n        ekle(\"zemin_ustu_kanal_rampa_%s\" % nm, rampa(x0, x1, 80.0, 598.0, 51.5, yon), \"paslanmaz\", B,',\n    '    for nm, (x0, x1, yon, zr1) in ((\"sol\", (5319.0, 5349.0, \"-x\", 598.0)), (\"sag\", (5409.0, 5439.0, \"+x\", 538.0))):   # v3.6 · sağ rampa bina kanalına kadar\\n        ekle(\"zemin_ustu_kanal_rampa_%s\" % nm, rampa(x0, x1, 80.0, zr1, 51.5, yon), \"paslanmaz\", B,')\nblok('    for i, (x0, x1, z0, z1) in enumerate(CIK):\\n        ekle(\"zemin_ustu_cikis_%d\" % i,', '    # QR girişi (b) başlığı',\n     '    for i, (x0, x1, z0, z1) in enumerate(CIK):\\n'\n     '        ekle(\"zemin_ustu_cikis_%d\" % i, ici_bos([(x0 - T, x1 + T, 50.0, 123.0, z0 - T, z1 + T)], [(x0, x1, 49.0, 124.0, z0, z1)]), \"paslanmaz\", B,\\n'\n     '             bom=(\"Kanal çıkış kutusu 304 (kanal kapağından dolap tabanına)\", 1, \"\", \"\") if i == 0 else None)\\n')\nblok('    # BİNA BESLEMESİ (5G6, QR sağ yan girişi c)', '    # ---------------- 2 · DOLAP',\n     '    # BİNA BESLEMESİ (5G6): v3.6 · QR\\'ye girmez — bağlantı kutusundan zemin üstü kanalla (ZU son 3 kutu) koridor kör ucuna → ana hat → U_F ana panosu (M32)\\n'\n     '    ekle(\"zemin_ustu_bina_baglanti_kutusu\", ici_bos([(5735.0, 5855.0, 0.0, 200.0, 665.0, 785.0)], [(5735.0 + T, 5855.0 - T, T, 200.0 - T, 665.0 + T, 785.0 - T),\\n'\n     '                                                                                              (5733.0, 5737.0, T, 50.0, 695.0 + T, 755.0 - T)]),\\n'\n     '         \"cihaz_koyu\", B, bom=(\"Bina bağlantı kutusu IP65 120 × 200 × 120 (5G6 → bina tesisatı, sigortalı ayırıcı yeri)\", 1, \"Spelsberg / Hensel sınıfı\", \"AÇIK: dükkân tesisatçısı\"))\\n'\n     '    # v3.6 · plint (alt etek) geçiş delikleri KALKTI (montaj etekleri kaldırıyor: E onyuz_plint · B onyuz_plint_donus_sag)\\n')\n# 2 · dolap: taban rakoru → Harting (istasyon_kur) · dikey kanal + pano altı kanalı kalır\nblok('    rx, rz = (DOLAP_RIS[\"x\"][0] + DOLAP_RIS[\"x\"][1]) / 2.0, (DOLAP_RIS[\"z\"][0] + DOLAP_RIS[\"z\"][1]) / 2.0\\n', '    g = kut(DOLAP_RIS[\"x\"][0], DOLAP_RIS[\"x\"][1], 135.0, 415.0,',\n     '    # v3.6 · dolap taban rakoru M25 KALKTI → DOLAP Harting Han 10B (teknik sütun tabanı, istasyon_kur) · içeride Harting → dikey kanal → pano (iç tesisat)\\n')\n# 3 · inişler: K / E → Harting\nblok('    for nm, xd, yalt, zd, mods in ((\"E\", 5100.0, 1840.0, -805.0,', '    # TOPPING panosu: kuru bölme kanalından',\n     '    for nm, xd, zd, mods in ((\"E\", 5100.0, -775.0, ((\"UD\", \"ust_ke_taban_sac\"), (\"KC\", \"ust_sac\"))), (\"K\", 4300.0, -775.0, ((\"UD\", \"ust_ke_taban_sac\"), (\"KS\", \"ust_sac\")))):\\n'\n     '        H = EO.harting((xd, 1863.9, zd + 15.0), \"+y\", \"x\", t_duvar=3.8)                 # v3.6 · istasyon tavanı (2,3) + U_KE tabanı (2,3) üst üste\\n'\n     '        for m_, a_ in mods:\\n'\n     '            DELIKLER.append((m_, a_, H[\"kesik\"], \"v3.6 %s Harting Han 10B soket kesiği\" % nm))\\n'\n     '        DELIKLER.append((\"UD\", \"ust_ke_icecek_rafi\", kut(xd - 45.0, xd + 45.0, 1890.0, 1898.0, zd + 15.0 - 26.0, zd + 15.0 + 26.0), \"v3.6 %s Harting fişi raf kesiği\" % nm))\\n'\n     '        ekle(\"harting_%s_soket\" % nm, H[\"soket\"], \"rakor\", B); ekle(\"harting_%s_fis\" % nm, H[\"fis\"], \"rakor\", B); ekle(\"harting_%s_rakoru_M32\" % nm, H[\"rakor\"], \"rakor\", B)\\n'\n     '        u_ = H[\"uc\"]; yk = u_[1] + 5.0\\n'\n     '        g = kut(xd - 20.0, xd + 20.0, yk, ys0, zd, zd + 30.0).cut(kut(xd - 20.0 + T, xd + 20.0 - T, yk - 1.0, ys0 + 1.0, zd + T, zd + 31.0))\\n'\n     '        ekle(\"inis_%s_kanali\" % nm, g, \"kanal\", B, bom=(\"İniş kanalı PVC 40 × 30 + kapak (üst hat → Harting fişi)\", 2, \"\", \"\") if nm == \"E\" else None)\\n'\n     '        ekle(\"inis_%s_kanali_kapak\" % nm, kut(xd - 20.0, xd + 20.0, yk, ys0, zd + 30.0, zd + 30.0 + T), \"kanal\", B)\\n'\n     '        ekle(\"inis_%s_ana_hat_ucu\" % nm, boru([u_, (u_[0], yk + 8.0, u_[2])], 8.5), \"kablo\", B)\\n')\n# 4 · TOPPING: rakor → Harting (kuru pano sağ yüzü) · üst hat A'ya uzar\nblok('    # TOPPING panosu: kuru bölme kanalından', '__SON__' if '__SON__' in s else None, '') if False else 