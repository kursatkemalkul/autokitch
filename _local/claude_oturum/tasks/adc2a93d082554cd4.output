{"parentUuid":"5e760c34-50b7-4bba-8083-66c64454a24b","isSidechain":true,"promptId":"8a521ac4-83eb-4db0-a081-8d4c4bb0dae9","agentId":"adc2a93d082554cd4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TvMHtBYZpp3pmruuSY4bNM","type":"tool_result","content":"220\t\n221\t# ================================================================ v3.6 · İSTASYON KUTULARI + HARTING + ANA PANO TARAFI ================================================================\n222\tdef _kutu(x, y, z, t=1.2, kapak=\"+z\"):\n223\t    \"\"\"küçük pano kutusu (304 1,5 · IP65): gövde (kapak tarafı açık) + kapak · kapak '+z' (öne bakar)\"\"\"\n224\t    x0, x1 = x; y0, y1 = y; z0, z1 = z\n225\t    g = kut(x0, x1, y0, y1, z0, z1 - 2.0).cut(kut(x0 + t, x1 - t, y0 + t, y1 - t, z0 + t, z1 - 1.0))\n226\t    return g, kut(x0, x1, y0, y1, z1 - 2.0, z1)\n227\t\n228\t\n229\tdef istasyon_kur(ekle, DELIKLER, DUSUR, ER, RAPOR):\n230\t    \"\"\"h3_elektrik_v1.kur() istasyon kabloları (EI) BİTTİKTEN sonra çağırır (ER yol dünyasında her şey var):\n231\t    A + F istasyon kutuları (Harting) · DOLAP Harting (teknik sütun tabanı) · ana pano (U_F, h3_ana_pano_v1) fişleri + toplama kanalı · kısa ana hat uçları + P-kelepçe.\"\"\"\n232\t    B = \"ELK_ISTASYON\"\n233\t\n234\t    def parca(ad, sh, mal, bom=None):\n235\t        ekle(ad, sh, mal, B, bom); ER.ekli_ekle(ad, sh)\n236\t\n237\t    def kablo(ad, pts, r, mal=\"kablo\", bom=None, haric=()):\n238\t        sh = boru(pts, r)\n239\t        ok, engel = ER.temiz(sh, haric)\n240\t        if not ok:\n241\t            RAPOR[\"bulunamadi\"].append((ad, pts[0], pts[-1], engel)); return\n242\t        parca(ad, sh, mal, bom)\n243\t        kl, aski = ER.kelepceler(pts, r, haric=haric)\n244\t        for j, (_p, ks) in enumerate(kl): parca(\"%s_kelepce_%d\" % (ad, j), ks, \"celik\")\n245\t        RAPOR[\"yol\"].append((ad, round(EO.uzunluk(pts)), len(pts) - 1, len(kl)))\n246\t        RAPOR[\"askida\"] += [(ad,) + tuple(a) for a in aski]\n247\t\n248\t    def harting_ekle(ad, H, soket=True):\n249\t        if soket: parca(\"harting_%s_soket\" % ad, H[\"soket\"], \"rakor\")\n250\t        parca(\"harting_%s_fis\" % ad, H[\"fis\"], \"rakor\"); parca(\"harting_%s_rakoru_M32\" % ad, H[\"rakor\"], \"rakor\")\n251\t\n252\t    def din_zarf(ad, x0, w, yc, h, zr, d, bom=None, mal=\"cihaz\"):\n253\t        parca(ad, kut(x0, x0 + w, yc - h / 2.0, yc + h / 2.0, zr, zr + d), mal, bom)\n254\t\n255\t    KB = (\"İstasyon kutusu 304 1,5 · IP65 contalı kapak · 2 mm galvaniz plaka + TS35 ray\", 2, \"lazer + abkant + kaynak\", \"v3.6 · A ve F (diğer istasyonlarda mevcut panolar kutu sayılır)\")\n256\t    # ---------------- A · İSTASYON KUTUSU (açıcı hazır alınır: tek besleme noktası) ----------------\n257\t    g, k = _kutu(A_KUTU[\"x\"], A_KUTU[\"y\"], A_KUTU[\"z\"])\n258\t    HA = EO.harting(((A_KUTU[\"x\"][0] + A_KUTU[\"x\"][1]) / 2.0 - 30.0, A_KUTU[\"y\"][1], (A_KUTU[\"z\"][0] + A_KUTU[\"z\"][1]) / 2.0), \"+y\", \"x\", t_duvar=1.2)\n259\t    parca(\"A_istasyon_kutusu_160x170x100\", g.cut(HA[\"kesik\"]), \"pano\", KB)\n260\t    parca(\"onyuz_A_istasyon_kutusu_kapagi\", k, \"pano\")\n261\t    zr = A_KUTU[\"z\"][0] + 1.2\n262\t    parca(\"A_kutu_din_rayi\", kut(A_KUTU[\"x\"][0] + 8.0, A_KUTU[\"x\"][1] - 8.0, 1932.5, 1967.5, zr, zr + 7.5), \"din\")\n263\t    din_zarf(\"A_sigorta_iC60N_1PN_C16\", A_KUTU[\"x\"][1] - 90.0, 36.0, 1950.0, 90.0, zr + 7.5, 75.0,\n264\t             bom=(\"A besleme: iC60N 1P+N C16 + 6 klemens (açıcının kendi kablosu buraya bağlanır, açıcı satın alınır)\", 1, \"ZARF [VARSAYIM]\", \"Kemal 1 Eki: açıcı çevresinde başka elektrik yok\"))\n265\t    for i in range(6):\n266\t        din_zarf(\"A_klemens_%d\" % i, A_KUTU[\"x\"][1] - 50.0 + 5.2 * i, 5.2, 1950.0, 60.0, zr + 7.5, 45.0)\n267\t    harting_ekle(\"A\", HA)\n268\t    u_ = HA[\"uc\"]\n269\t    kablo(\"A_ana_hat_ucu\", [u_, (u_[0], 2154.0, u_[2]), (1352.0, 2154.0, u_[2])], 8.5)\n270\t    # ---------------- F · İSTASYON KUTUSU (fırın TP10 CEE prizi + sinyal kutusu · ana hat fırın altından) ----------------\n271\t    g, k = _kutu(F_KUTU[\"x\"], F_KUTU[\"y\"], F_KUTU[\"z\"])\n272\t    HF = EO.harting((2840.0, F_KUTU[\"y\"][1], (F_KUTU[\"z\"][0] + F_KUTU[\"z\"][1]) / 2.0), \"+y\", \"x\", t_duvar=1.2)\n273\t    for ad_, r_, p_ in ((\"sinyal\", 3.0, (F_KUTU[\"x\"][0], 860.0, -800.0)),):          # v3.6b · fırın gücü binadan (kendi CEE 32 A devresi): F kutusu yalnız sinyal + Ethernet\n274\t        rk_, d_ = rakor(p_, \"x\", r_, 1.2, yon=\"-\", disli=max(8.0, r_ + 3.0)); g = g.cut(d_)\n275\t        parca(\"F_kutu_rakoru_%s\" % ad_, rk_, \"rakor\", RK_BOM)\n276\t    parca(\"F_istasyon_kutusu_160x120x100\", g.cut(HF[\"kesik\"]), \"pano\", None)\n277\t    parca(\"onyuz_F_istasyon_kutusu_kapagi\", k, \"pano\")\n278\t    zr = F_KUTU[\"z\"][0] + 1.2\n279\t    parca(\"F_kutu_din_rayi\", kut(F_KUTU[\"x\"][0] + 8.0, F_KUTU[\"x\"][1] - 8.0, 867.5, 902.5, zr, zr + 7.5), \"din\")\n280\t    din_zarf(\"F_sigorta_iC60N_1PN_C6\", F_KUTU[\"x\"][1] - 80.0, 18.0, 885.0, 90.0, zr + 7.5, 75.0,\n281\t             bom=(\"F kutusu: iC60N 1P+N C6 (24 V) + fırın sinyal röleleri + klemens · ana panoda DIO + Ethernet\", 1, \"ZARF [VARSAYIM]\",\n282\t                  \"v3.6b · fırın 400 V 32 A gücü BİNADAN kendi CEE devresiyle (bina tesisat bandı f_ust_rakor_cee_firin) — ana panodan değil\"))\n283\t    for i in range(8):\n284\t        din_zarf(\"F_klemens_%d\" % i, F_KUTU[\"x\"][1] - 56.0 + 5.2 * i, 5.2, 885.0, 60.0, zr + 7.5, 45.0)\n285\t    harting_ekle(\"F\", HF)\n286\t    u_ = HF[\"uc\"]; xi, zi = F_INIS[\"x\"], F_INIS[\"z\"]\n287\t    rk_, d_ = rakor((xi, 788.0, zi), \"y\", 8.5, 1.5, yon=\"+\", disli=12.0)\n288\t    parca(\"F_ana_hat_tavan_rakoru_M32\", rk_, \"rakor\", (\"Rakor M32 (dolap tavanı → fırın altı ana besleme kanalı · F ana hattı)\", 1, \"Lapp SKINTOP ST-M 32\", \"v3.6\"))\n289\t    DELIKLER.append((\"SC\", \"tavan_dis_sac\", d_, \"v3.6 F ana hattı dolap tavanı geçişi\"))\n290\t    kablo(\"F_ana_hat_ucu\", [u_, (u_[0], 1055.0, u_[2]), (xi, 1055.0, u_[2]), (xi, 1055.0, zi), (xi, 772.0, zi)], 8.5, haric=(\"B_KASA|tavan_dis_sac\",))\n291\t    kablo(\"F_firin_sinyal\", [(F_KUTU[\"x\"][0] - 12.0, 860.0, -800.0), (2560.0, 860.0, -800.0), (2560.0, 860.0, -656.1)], 3.0,\n292\t          bom=(\"Fırın sinyal kablosu (çalışıyor / hazır / bant hızı) LiYCY 7 × 0,5\", 1, \"Lapp UNITRONIC LiYCY [VARSAYIM]\", \"TP10 sinyal kutusuna\"))\n293\t    # ---------------- DOLAP (B) · teknik sütun tabanında Harting (fiş zemin üstü kanalın içine) ----------------\n294\t    HB = EO.harting((DOLAP_HARTING[0], 122.6, DOLAP_HARTING[2]), \"-y\", \"x\", t_duvar=2.3)\n295\t    DELIKLER.append((\"SC\", \"taban_dis_sac\", HB[\"kesik\"], \"v3.6 DOLAP Harting Han 10B soket kesiği\"))\n296\t    harting_ekle(\"DOLAP\", HB)\n297\t    # ---------------- ANA PANO (U_F · h3_ana_pano_v1): soketlere fiş + rakor · ana hat uçları + bina beslemesi + modem → TOPLAMA kanalı → U_F üst hattı ----------------\n298\t    try:\n299\t        import h3_ana_pano_v1 as AP\n300\t        SOK, GIR = list(AP.HARTING_SOKETLERI), list(AP.GIRIS_RAKORLARI)\n301\t    except Exception as e:\n302\t        print(\"   UYARI · h3_ana_pano_v1 okunamadı (%s) — ana pano fişleri kurulmadı\" % e); SOK, GIR = [], []\n303\t    tx0, tx1 = TOPLAMA[\"x\"]; ty0, ty1 = TOPLAMA[\"y\"]; tz0, tz1 = TOPLAMA[\"z\"]\n304\t    X_SIRA = lambda y: 3410.0 if y > 2070.0 else (3390.0 if y > 1970.0 else 3370.0)\n305\t    delik = []\n306\t    for sk in SOK:\n307\t        ist, xm, ys, zs, yon = sk[:5]\n308\t        if yon == \"-z\":                                                               # v3.6 · panonun ARKA yüzü (A · F): fiş −z, kablo yukarı → U_F üst hattının ön yüzüne\n309\t            L_ = sk[5] if len(sk) > 5 and sk[5] in (\"x\", \"y\") else \"y\"\n310\t            H = EO.harting((xm, ys, zs + 28.0), \"-z\", L_)\n311\t            parca(\"harting_ANA_PANO_%s_fis\" % ist, H[\"fis\"], \"rakor\"); parca(\"harting_ANA_PANO_%s_rakoru_M32\" % ist, H[\"rakor\"], \"rakor\")\n312\t            u_ = H[\"uc\"]\n313\t            kablo(\"ANA_PANO_%s_ana_hat_ucu\" % ist, [u_, (u_[0], u_[1], u_[2] - 15.0), (u_[0], 2154.0, u_[2] - 15.0), (u_[0], 2154.0, -765.9)], 8.5)\n314\t            continue\n315\t        assert yon == \"-x\", yon\n316\t        H = EO.harting((xm + 28.0, ys, zs), \"-x\", \"y\")\n317\t        parca(\"harting_ANA_PANO_%s_fis\" % ist, H[\"fis\"], \"rakor\"); parca(\"harting_ANA_PANO_%s_rakoru_M32\" % ist, H[\"rakor\"], \"rakor\")\n318\t        u_ = H[\"uc\"]; xr = X_SIRA(ys)\n319\t        kablo(\"ANA_PANO_%s_ana_hat_ucu\" % ist, [u_, (xr, ys, zs), (xr, ty0 + 8.0, zs)], 8.5)\n320\t        delik.append((xr, zs, 9.5))\n321\t    for ad, xr_, yr, zr_, yon, m in GIR:\n322\t        if \"kor_tapa\" in ad: continue\n323\t        r_ = 9.95 if m >= 32.0 else 4.35; xk = 3360.0 if m >= 32.0 else 3400.0\n324\t        kablo(\"ANA_PANO_%s_ucu\" % ad, [(xr_ - 12.0, yr, zr_), (xk, yr, zr_), (xk, ty0 + 8.0, zr_)], r_, mal=\"kablo\" if m >= 32.0 else \"kablo_veri\",\n325\t              bom=(\"Bina beslemesi H07RN-F 5G6 (Lapp 16001313) · bağlantı kutusundan zemin üstü kanal + ana hatla ana panoya\", 1, \"\", \"v3.6 · QR'ye girmez\") if m >= 32.0 else None)\n326\t        delik.append((xk, zr_, r_ + 1.0))\n327\t    gv = kut(tx0, tx1, ty0, ty1 - T, tz0, tz1).cut(kut(tx0 + T, tx1 - T, ty0 + T, ty1, tz0 - 1.0, tz1 - T))\n328\t    for xd, zd, rd in delik:\n329\t        gv = gv.cut(sil((xd, ty0 - 1.0, zd), (xd, ty0 + T + 1.0, zd), rd))\n330\t    parca(\"ana_pano_toplama_kanali\", gv, \"paslanmaz\",\n331\t          (\"Ana pano toplama kanalı 304 1,5 · 90 × 30 (U_F tavanı altında, ana panonun solu → U_F üst hattına) + kapak\", 1, \"lazer + abkant\",\n332\t           \"v3.6 · 6 Harting ana hat ucu + bina beslemesi + modem tabandaki deliklerden girer\"))\n333\t    parca(\"ana_pano_toplama_kanali_kapak\", kut(tx0, tx1, ty1 - T, ty1, tz0, tz1), \"paslanmaz\")\n334\t    for i, zk in enumerate((-700.0, -420.0)):\n335\t        parca(\"ana_pano_toplama_kanali_askisi_%d\" % i, kut(tx1, tx1 + 2.0, ty0, 2178.5, zk, zk + 25.0), \"paslanmaz\",\n336\t              (\"Kanal askısı 304 2 mm (U_F tavanına)\", 2, \"\", \"\") if i == 0 else None)\n337\t    eksik = sorted(set((\"A\", \"F\")) - set(s_[0] for s_ in SOK))\n338\t    if eksik: print(\"   AÇIK · ana panoda soketi olmayan istasyonlar (kablo kanalda bekler): %s\" % \", \".join(eksik))\n339\t    return eksik\n340\t\n341\t\n342\tRK_BOM = (\"Kablo rakoru IP68 PA M16 / M25 + kontra somun (istasyon kutusu çıkışı)\", 2, \"Lapp SKINTOP ST-M\", \"\")\n343\t"}]},"uuid":"f98d0b11-291a-4a2c-8838-dd94860f306d","timestamp":"2026-10-01T21:34:33.115Z","sourceToolAssistantUUID":"5e760c34-50b7-4bba-8083-66c64454a24b","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
