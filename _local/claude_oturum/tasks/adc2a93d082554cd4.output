"z\"][0] + T, UF[\"z\"][1] - T),                         # üst hatta açılır (yalnız üst hat kesitinde)\n155\t         (F_INIS[\"x\"] - 16.0, F_INIS[\"x\"] + 16.0, FA[\"y\"][1] - 1.0, FA[\"y\"][1] + T + 1.0, F_INIS[\"z\"] - 16.0, F_INIS[\"z\"] + 16.0)]   # F çıkışı (kanal tavanı)\n156\t    D = [(q[0] - T if q[0] > 2423 else 2421.0, q[1] + T, q[2] - T, q[3] + T, q[4] - T, q[5] + T) for q in I[:6]]\n157\t    D[0] = (TS[\"x\"][0] - T, TS[\"x\"][1] + T, 125.5, TS[\"y\"][1] + T, TS[\"z\"][0] - T, TS[\"z\"][1] + T)\n158\t    D[4] = (2421.0, FB[\"x\"][1] + T, FB[\"y\"][0] - T, FB[\"y\"][1] + T, FB[\"z\"][0] - T, -631.0)\n159\t    D[3] = (2421.0, RU[\"x\"][1] + T, RU[\"y\"][0] - 0.5, RU[\"y\"][1], RU[\"z\"][0] - T, -631.0)\n160\t    D[5] = (GV[\"x\"][0] - T, GV[\"x\"][1] + T, GV[\"y\"][0], 2113.0, GV[\"z\"][0] - T, GV[\"z\"][1] + T)\n161\t    kanal_ekle(\"ana_besleme_kanali\", ici_bos(D, I), \"paslanmaz\", B,\n162\t               bom=(\"Ana besleme kanalı 304 1,5 kapalı (v3.7 doluluğa göre: fırın altı 40 × 118 · yükseliş 30 × 140 / 45 × 55 · gövde 26 × 125 · teknik sütun 40 × 58), vidalı kapaklı\", 1,\n163\t                    \"lazer + abkant\", \"doluluk ≤ %50 · fırın altında kablolar silikon (Lapp ÖLFLEX HEAT 180 SiF) VARSAYIM: boşluk sıcaklığı ölçülecek\"))\n164\t    ekle(\"ana_besleme_taban_cercevesi\", ici_bos([(TS[\"x\"][0] - 8.0, TS[\"x\"][1] + 8.0, 125.0, 131.0, TS[\"z\"][0] - 8.0, TS[\"z\"][1] + 8.0)],\n165\t                                                [(TS[\"x\"][0], TS[\"x\"][1], 124.0, 132.0, TS[\"z\"][0], TS[\"z\"][1])]), \"rakor\", B,\n166\t         bom=(\"Kablo giriş çerçevesi bölmeli conta · dolap tabanı (ana yükseliş)\", 1, \"icotek KEL-DPZ 24 sınıfı\", \"VARSAYIM: çerçeve no. demet çaplarına göre\"))\n167\t    zl, zh = min(RL[\"z\"][0], FA[\"z\"][0]) - T, max(RL[\"z\"][1], FA[\"z\"][1]) + T\n168\t    DELIKLER.append((\"SC\", \"taban_dis_sac\", kut(TS[\"x\"][0], TS[\"x\"][1], 120.0, 128.0, TS[\"z\"][0], TS[\"z\"][1]), \"ana besleme dolap tabanı girişi\"))\n169\t    for a_ in (\"bolme_4_sac_a\", \"bolme_4_pu\", \"bolme_4_sac_b\"):\n170\t        DELIKLER.append((\"SC\", a_, kut(3990.0, 4032.0, FA[\"y\"][0] - T, FA[\"y\"][1] + T, FA[\"z\"][0] - T, FA[\"z\"][1] + T), \"ana besleme bölme 4 geçişi\"))\n171\t    DELIKLER.append((\"SC\", \"isi_kalkani_sol_sac\", kut(2498.0, 2503.0, FA[\"y\"][0] - T, FA[\"y\"][1] + T, FA[\"z\"][0] - T, FA[\"z\"][1] + T), \"ana besleme ısı kalkanı geçişi\"))\n172\t    DELIKLER.append((\"SC\", \"tavan_pu_T\", kut(2421.0 - T, 2503.0, FA[\"y\"][0] - T, 788.5, zl, zh), \"ana besleme dolap tavan PU geçişi\"))\n173\t    DELIKLER.append((\"SC\", \"tavan_dis_sac\", kut(2421.0 - T, RL[\"x\"][1] + T, 785.0, 789.0, RL[\"z\"][0] - T, RL[\"z\"][1] + T), \"ana besleme dolap tavanı → C kaidesi\"))\n174\t    DELIKLER.append((\"KD\", \"kaide_C_ust_plaka_4\", kut(2421.0 - T, RL[\"x\"][1] + T, 887.0, 893.0, RL[\"z\"][0] - T, RL[\"z\"][1] + T), \"ana besleme C kaidesi üst plakası\"))\n175\t    DELIKLER.append((\"TC\", \"dis_taban\", kut(2421.0 - T, RL[\"x\"][1] + T, 891.0, 895.0, RL[\"z\"][0] - T, RL[\"z\"][1] + T), \"ana besleme TOPPING tabanı\"))\n176\t    # ---------------- 4 · ÜST HAT: U_KE (60 × 40) · U_F + TOPPING-B (70 × 62) · TOPPING-A (60 × 22) ----------------\n177\t    ys0, ys1 = UST_KE[\"y\"]; zs0, zs1 = UST_KE[\"z\"]\n178\t    g, k = u_kanal_x(4016.0, 5200.0, ys0, ys1, zs0, zs1, acik=\"+y\")\n179\t    kanal_ekle(\"ust_hat_U_KE_arka\", g, \"kanal\", B, bom=(\"Üst hat kablo kanalı PVC 60 × 40 + kapak (U_KE arkası)\", 1, \"Hager tehalit BA7A40060\", \"\")); kanal_ekle(\"ust_hat_U_KE_arka_kapak\", k, \"kanal\", B)\n180\t    for i, xk in enumerate((4200.0, 4700.0, 5100.0)):\n181\t        ekle(\"ust_hat_U_KE_konsol_%d\" % i, kut(xk, xk + 30.0, ys0 - 3.0, ys1, -828.5, zs0), \"paslanmaz\", B, bom=(\"Kanal konsolu 304 (arka saca)\", 9, \"\", \"\") if i == 0 else None)\n182\t    yf0, yf1 = UF[\"y\"]; zf0, zf1 = UF[\"z\"]\n183\t    for nm, (a, b) in ((\"U_F\", (2516.0, 3984.0)), (\"TOPPING\", (1993.0, 2468.0)