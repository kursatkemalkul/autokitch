{"parentUuid":"e9395675-b442-4f8b-b172-e45fc6b342b6","isSidechain":true,"promptId":"4c0b6d8f-63b8-4a7c-b6d7-9a9fdf884ead","agentId":"adc2a93d082554cd4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RkxV19UgkzLuvAdJX45dzS","type":"tool_result","content":"20\t  · İSTASYON GİRİŞLERİ Harting Han 10B (soket istasyon gövdesinde, fiş + M32 ana hat ucunda): TOPPING (kuru pano sağ yüzü) · K / E (tavan, U_KE rafında fiş kesiği) ·\n21\t    DOLAP (teknik sütun tabanı, fiş zemin kanalının içine) · A + F (yeni istasyon kutuları, istasyon_kur) · QR + ROBOT (h3_elk_qr_v1).\"\"\"\n22\timport math\n23\timport cadquery as cq\n24\timport h3_elk_ortak as EO\n25\tfrom h3_elk_ortak import kut, sil, boru, rakor\n26\t\n27\tV = cq.Vector\n28\tT = 1.5                                                    # kanal sacı\n29\tZK = dict(y=(-60.0, 0.0))                                  # zemin kanalı (gömülü, kapak zemin hizasında)\n30\tZ_ON_SERIT = (80.0, 120.0)                                 # makine önü zemin şeridi (makine +79 · ray ≥ 240)\n31\tDOLAP_KOL_X = (4032.0, 4072.0)\n32\tE_RISER = dict(x=(5232.0, 5292.0), z=(-40.0, 20.0), y=(0.0, 2160.0))\n33\tUST_KE = dict(y=(2125.0, 2165.0), z=(-826.0, -766.0))\n34\tUST_FT = dict(y=(2143.0, 2165.0), z=(-826.0, -766.0))\n35\tDOLAP_RIS = dict(x=(4032.0, 4062.0), z=(-826.0, -792.0))   # teknik sütun arka-sol köşe (tava −785 · gider −748 · boyuna şase −790'ın arkası)\n36\t# ---- v3.6 · istasyon Harting girişleri + ana pano toplama kanalı ----\n37\tTOPPING_HARTING = (1993.0, 2040.0, -796.0)                # kuru pano SAĞ yüzü (fiş +x) · L y boyunca\n38\tTOPPING_UST_X = 2100.0                                    # Harting kablosu üst hat kanalına bu x'te tabandan girer\n39\tDOLAP_HARTING = (4250.0, 123.0, -632.0)                   # teknik sütun tabanı ALT yüzü (fiş −y, zemin kanalının içine) · tava (z ≤ −705) ve montaj rayı (z ≥ −562) arası\n40\tTOPLAMA = dict(x=(3345.0, 3435.0), y=(2145.0, 2176.5), z=(-767.0, -125.0))   # ana panonun solunda, U_F tavanının altında → U_F üst hattına\n41\tA_KUTU = dict(x=(1240.0, 1400.0), y=(1880.0, 2050.0), z=(-828.5, -728.5))   # A istasyon kutusu (U_A arka sacında · A + U_A tek kutu, v3.4)\n42\tF_KUTU = dict(x=(2800.0, 2960.0), y=(830.0, 950.0), z=(-828.0, -728.0))     # F istasyon kutusu (fırın üstü kabinin arka teknik boşluğu · fırın gövdesi −651)\n43\tF_INIS = dict(x=2990.0, z=-672.0)                          # F ana hat kablosu: dolap tavanı rakoru → fırın altı ana besleme kanalı\n44\t\n45\t\n46\tdef u_kanal_x(x0, x1, y0, y1, z0, z1, acik=\"+y\"):\n47\t    \"\"\"x boyunca U kanal (acik: kapak yönü '+y' | '-z' …) · döner (gövde, kapak)\"\"\"\n48\t    dis = kut(x0, x1, y0, y1, z0, z1)\n49\t    if acik == \"+y\": return dis.cut(kut(x0 - 1, x1 + 1, y0 + T, y1 + 1, z0 + T, z1 - T)), kut(x0, x1, y1, y1 + T, z0, z1)\n50\t    if acik == \"-y\": return dis.cut(kut(x0 - 1, x1 + 1, y0 - 1, y1 - T, z0 + T, z1 - T)), kut(x0, x1, y0 - T, y0, z0, z1)\n51\t    if acik == \"+z\": return dis.cut(kut(x0 - 1, x1 + 1, y0 + T, y1 - T, z0 + T, z1 + 1)), kut(x0, x1, y0, y1, z1, z1 + T)\n52\t    return dis.cut(kut(x0 - 1, x1 + 1, y0 + T, y1 - T, z0 - 1, z1 - T)), kut(x0, x1, y0, y1, z0 - T, z0)\n53\t\n54\t\n55\tdef zemin_kanal(noktalar, gen=40.0):\n56\t    \"\"\"zemin kanalı: xz düzleminde köşeli yol (her segment x ya da z) · 40 geniş · y −60…0 · döner (gövde, kapak) tek katı\"\"\"\n57\t    y0, y1 = ZK[\"y\"]; h = gen / 2.0; gv, kp = None, None\n58\t    for (xa, za), (xb, zb) in zip(noktalar[:-1], noktalar[1:]):\n59\t        if abs(za - zb) < 1e-6:\n60\t            x0, x1 = min(xa, xb) - h, max(xa, xb) + h; z0, z1 = za - h, za + h\n61\t        else:\n62\t            z0, z1 = min(za, zb) - h, max(za, zb) + h; x0, x1 = xa - h, xa + h\n63\t        dis = kut(x0, x1, y0, y1 - T, z0, z1); ic = kut(x0 + T, x1 - T, y0 + T, y1, z0 + T, z1 - T)\n64\t        gv = dis if gv is None else gv.fuse(dis); kp = kut(x0, x1, y1 - T, y1, z0, z1) if kp is None else kp.fuse(kut(x0, x1, y1 - T, y1, z0, z1))\n65\t        gv = gv.cut(ic) if False else gv\n66\t    ic_top = None\n67\t    for (xa, za), (xb, zb) in zip(noktalar[:-1], noktalar[1:]):\n68\t        if abs(za - zb) < 1e-6: x0, x1 = min(xa, xb) - h + T, max(xa, xb) + h - T; z0, z1 = za - h + T, za + h - T\n69\t        else: z0, z1 = min(za, zb) - h + T, max(za, zb) + h - T; x0, x1 = xa - h + T, xa + h - T\n70\t        c = kut(x0, x1, y0 + T, y1, z0, z1); ic_top = c if ic_top is None else ic_top.fuse(c)\n71\t    return gv.cut(ic_top).clean(), kp.clean()\n72\t\n73\t\n74\tdef zu_kanal(kutular, h=50.0):\n75\t    \"\"\"ZEMİN ÜSTÜ kanal (y 0…h): kutular [(x0, x1, z0, z1)] birleşik taban + yanlar (içi boş) · kapak h…h + T · döner (gövde, kapak)\"\"\"\n76\t    dis = ic = kp = None\n77\t    for x0, x1, z0, z1 in kutular:\n78\t        d = kut(x0, x1, 0.0, h, z0, z1); c = kut(x0 + T, x1 - T, T, h + 1.0, z0 + T, z1 - T); k = kut(x0, x1, h, h + T, z0, z1)\n79\t        dis = d if dis is None else dis.fuse(d); ic = c if ic is None else ic.fuse(c); kp = k if kp is None else kp.fuse(k)\n80\t    return dis.cut(ic).clean(), kp.clean()\n81\t\n82\t\n83\tdef ici_bos(kutular, ici):\n84\t    \"\"\"kapalı sac kanal: dış kutular birleşimi − iç kutular birleşimi (uçları iç kutularla açılır)\"\"\"\n85\t    dis = None\n86\t    for q in kutular:\n87\t        d = kut(*q); dis = d if dis is None else dis.fuse(d)\n88\t    for q in ici:\n89\t        dis = dis.cut(kut(*q))\n90\t    return dis.clean()\n91\t\n92\t\n93\tdef rampa(x0, x1, z0, z1, h, yon):\n94\t    \"\"\"yürünebilir kanal kenarı: üçgen kesitli rampa (x boyunca h → 0) · yon '+x' | '-x'\"\"\"\n95\t    if yon == \"+x\": pts = [(x0, 0.0), (x0, h), (x1, 0.0)]\n96\t    else: pts = [(x0, 0.0), (x1, h), (x1, 0.0)]\n97\t    return cq.Workplane(\"XY\").polyline(pts).close().extrude(z1 - z0).translate((0, 0, z0)).val()\n98\t\n99\t\n100\tdef kur(ekle, DELIKLER, DUSUR):\n101\t    B = \"ELK_ANA_HAT\"\n102\t    # ---------------- 1 · ZEMİN ÜSTÜ KANAL (gömme YOK): QR giriş (x 5395) → koridorun kör ucu → E / dolap ayakları arası → teknik sütun altı ----------------\n103\t    ZU = [(5349.0, 5409.0, -195.0, 600.0),                   # koridor kör ucu (ray + oluk 5100'de biter) · QR girişindeki başlığa kadar\n104\t          (4040.0, 5409.0, -195.0, -135.0),                  # v3.6 · E + dolap ön AYAK SIRASININ ARKASI (ayak z −130,4…−89,6): etekler kalkınca önden görünmez\n105\t          (4040.0, 4130.0, -829.0, -135.0),                  # teknik sütunun altı: ana yükseliş çıkışı (z −686…−646)\n106\t          (4040.0, 4300.0, -680.0, -590.0),                  # v3.6 · DOLAP Harting fişi (teknik sütun tabanı x 4217–4283, fiş kanalın içine iner)\n107\t          (5349.0, 5500.0, 540.0, 600.0), (5440.0, 5500.0, 540.0, 755.0), (5440.0, 5735.0, 695.0, 755.0)]   # v3.6 · bina beslemesi: bağlantı kutusu → kör uç\n108\t    g, k = zu_kanal(ZU)\n109\t    CIK = [(4100.0, 4130.0, -686.0, -646.0)]                                          # ana yükseliş girişi (v3.6: dolap rakoru → Harting)\n110\t    for x0, x1, z0, z1 in CIK:\n111\t        k = k.cut(kut(x0, x1, 49.0, 53.0, z0, z1))\n112\t    k = k.cut(kut(DOLAP_HARTING[0] - 36.0, DOLAP_HARTING[0] + 36.0, 49.0, 53.0, DOLAP_HARTING[2] - 24.0, DOLAP_HARTING[2] + 24.0))   # v3.6 · DOLAP fişi\n113\t    ekle(\"zemin_ustu_kanal\", g, \"paslanmaz\", B, bom=(\"Zemin üstü kablo kanalı 304 1,5 · 60 × 50 (koridor kör ucu + E / dolap ayakları arası) · zemine dübelli\", 1,\n114\t                                                     \"lazer + abkant\", \"gömme YOK (Kemal 1 Eki) · koridorda iki yan rampa · v3.6: ön ayakların arkasında, bina beslemesi de bu kanalda\"))\n115\t    ekle(\"zemin_ustu_kanal_kapak\", k, \"paslanmaz\", B, bom=(\"Kanal kapağı 304 1,5 gözyaşı desenli (basılır)\", 1, \"\", \"\"))\n116\t    for nm, (x0, x1, yon, zr1) in ((\"sol\", (5319.0, 5349.0, \"-x\", 598.0)), (\"sag\", (5409.0, 5439.0, \"+x\", 538.0))):   # v3.6 · sağ rampa bina kanalına kadar\n117\t        ekle(\"zemin_ustu_kanal_rampa_%s\" % nm, rampa(x0, x1, 80.0, zr1, 51.5, yon), \"paslanmaz\", B,\n118\t             bom=(\"Kanal rampası 304 (koridor kör ucu, 30 × 51,5)\", 2, \"\", \"\") if nm == \"sol\" else None)\n119\t    for i, (x0, x1, z0, z1) in enumerate(CIK):\n120\t        ekle(\"zemin_ustu_cikis_%d\" % i, ici_bos([(x0 - T, x1 + T, 50.0, 123.0, z0 - T, z1 + T)], [(x0, x1, 49.0, 124.0, z0, z1)]), \"paslanmaz\", B,\n121\t             bom=(\"Kanal çıkış kutusu 304 (kanal kapağından dolap tabanına)\", 1, \"\", \"\") if i == 0 else None)\n122\t    # QR girişi (b) başlığı: icotek KEL-DPZ 16|14 çerçevesi (x 5308–5428 · y 21–79 · z 656–670) ve kablo uçları (z 640) başlığın içinde · ucu z 655\n123\t    ekle(\"zemin_ustu_kanal_QR_basligi\", ici_bos([(5303.0, 5432.0, 0.0, 86.0, 600.0, 655.0)], [(5303.0 + T, 5432.0 - T, T, 86.0 - T, 600.0 + T, 656.0),\n124\t                                                                                       (5349.0 + T, 5409.0 - T, T, 50.0, 590.0, 602.0)]), \"paslanmaz\", B,\n125\t         bom=(\"Kanal başlığı 304 1,5 (QR alt ön bandındaki kablo giriş çerçevesini sarar · üst kapak vidalı)\", 1, \"lazer + abkant\", \"QR'ye 2 × M5\"))\n126\t    # BİNA BESLEMESİ (5G6): v3.6 · QR'ye girmez — bağlantı kutusundan zemin üstü kanalla (ZU son 3 kutu) koridor kör ucuna → ana hat → U_F ana panosu (M32)\n127\t    ekle(\"zemin_ustu_bina_baglanti_kutusu\", ici_bos([(5735.0, 5855.0, 0.0, 200.0, 665.0, 785.0)], [(5735.0 + T, 5855.0 - T, T, 200.0 - T, 665.0 + T, 785.0 - T),\n128\t                                                                                              (5733.0, 5737.0, T, 50.0, 695.0 + T, 755.0 - T)]),\n129\t         \"cihaz_koyu\", B, bom=(\"Bina bağlantı kutusu IP65 120 × 200 × 120 (5G6 → bina tesisatı, sigortalı ayırıcı yeri)\", 1, \"Spelsberg / Hensel sınıfı\", \"AÇIK: dükkân tesisatçısı\"))\n130\t    # v3.6 · plint (alt etek) geçiş delikleri KALKTI (montaj etekleri kaldırıyor: E onyuz_plint · B onyuz_plint_donus_sag)\n131\t    # ---------------- 2 · DOLAP: taban rakoru + arka-sol köşe dikey kanal + pano altı kanalı ----------------\n132\t    # v3.6 · dolap taban rakoru M25 KALKTI → DOLAP Harting Han 10B (teknik sütun tabanı, istasyon_kur) · içeride Harting → dikey kanal → pano (iç tesisat)\n133\t    g = kut(DOLAP_RIS[\"x\"][0], DOLAP_RIS[\"x\"][1], 135.0, 415.0, DOLAP_RIS[\"z\"][0], DOLAP_RIS[\"z\"][1]).cut(\n134\t        kut(DOLAP_RIS[\"x\"][0] + T, DOLAP_RIS[\"x\"][1] - T, 134.0, 416.0, DOLAP_RIS[\"z\"][0] + T, DOLAP_RIS[\"z\"][1] + 1.0))\n135\t    ekle(\"dolap_dikey_kanal\", g, \"kanal\", B, bom=(\"Dikey kablo kanalı PVC 30 × 40 (teknik sütun arka-sol köşe) + kapak\", 1, \"Hager tehalit BA7A40030 (model 34 derin: AÇIK)\", \"\"))\n136\t    ekle(\"dolap_dikey_kanal_kapak\", kut(DOLAP_RIS[\"x\"][0], DOLAP_RIS[\"x\"][1], 135.0, 415.0, DOLAP_RIS[\"z\"][1], DOLAP_RIS[\"z\"][1] + T), \"kanal\", B)\n137\t    g, k = u_kanal_x(DOLAP_RIS[\"x\"][0], 4390.0, 415.0, 450.0, DOLAP_RIS[\"z\"][0], DOLAP_RIS[\"z\"][1], acik=\"+z\")\n138\t    ekle(\"dolap_pano_alti_kanal\", g, \"kanal\", B, bom=(\"Pano altı kablo kanalı PVC 40 × 40 (+ kapak) · teknik sütun\", 1, \"Hager tehalit BA7A40040 (model 35 × 34: AÇIK)\", \"B panosu (PLC + röleler) klemensine kısa uçlar\"))\n139\t    ekle(\"dolap_pano_alti_kanal_kapak\", k, \"kanal\", B)\n140\t    for i, (xk, yk, zk) in enumerate(((4352.0, 625.0, -790.0), (4200.0, 470.0, -780.0))):\n141\t        ekle(\"dolap_pano_ucu_%d\" % i, boru([(xk, 450.0, -800.0), (xk, 452.0 + 0.0, -800.0), (xk, yk, -800.0)], 3.5), \"kablo\", B)\n142\t    # ---------------- 3 · ANA BESLEME YÜKSELİŞİ (içeriden): teknik sütun → fırın altı ılık boşluk → C kaidesi → TOPPING kuru bölmesi → gövde kanalı → üst hat ----------------\n143\t    ZA = (-686.0, -646.0)                                    # kanal z bandı (pano bileşenleri ≤ −744 · kondenser −504 · taşıyıcı kiriş ≥ −640 · FRL ≤ −700)\n144\t    YA = (744.0, 784.0)                                      # fırın altı bandı (ışınım sacı 741 · dolap tavanı 786)\n145\t    DIS = [(4100.0 - T, 4130.0 + T, 125.5, YA[1] + T, ZA[0] - T, ZA[1] + T),           # teknik sütun dikey\n146\t           (2421.0, 4130.0 + T, YA[0] - T, YA[1] + T, ZA[0] - T, ZA[1] + T),           # fırın altı yatay (sol dış yüz 2421: perde 2420)\n147\t           (2421.0, 2451.0 + T, YA[0] - T, 1300.0 + T, ZA[0] - T, ZA[1] + T),          # kaide + kuru bölme yükselişi (FRL manometresi z ≤ −690)\n148\t           (2421.0, 2478.0 + T, 1260.0 - T, 1300.0 + T, ZA[0] - T, ZA[1] + T),         # FRL üstü bağlantı (ön)\n149\t           (2452.0 - T, 2478.0 + T, 1260.0 - T, 1300.0 + T, -788.0, ZA[1] + T),        # FRL üstü bağlantı (arkaya)\n150\t           (2452.0 - T, 2478.0 + T, 1260.0 - T, 2143.0, -828.0, -788.0)]               # gövde kanalı → üst hat (arka yüz −828: TOPPING arka sacı)\n151\t    ICI = [(4100.0, 4130.0, 124.0, YA[1], ZA[0], ZA[1]), (2421.0 + T, 4130.0, YA[0], YA[1], ZA[0], ZA[1]), (2421.0 + T, 2451.0, YA[0], 1300.0, ZA[0], ZA[1]),\n152\t           (2421.0 + T, 2478.0, 1260.0, 1300.0, ZA[0], ZA[1]), (2452.0, 2478.0, 1260.0, 1300.0, -788.0 + T, ZA[1]),\n153\t           (2452.0, 2478.0, 1260.0, 2144.0, -828.0 + T, -788.0 - T)]\n154\t    ICI.append((F_INIS[\"x\"] - 16.0, F_INIS[\"x\"] + 16.0, YA[1] - 1.0, YA[1] + T + 1.0, F_INIS[\"z\"] - 16.0, F_INIS[\"z\"] + 16.0))   # v3.6 · F ana hat girişi (kanal tavanı)\n155\t    ekle(\"ana_besleme_kanali\", ici_bos(DIS, ICI), \"paslanmaz\", B,\n156\t         bom=(\"Ana besleme kanalı 304 1,5 kapalı (30–57 × 40, vidalı kapaklı) · teknik sütun → fırın altı → C kaidesi → TOPPING kuru bölmesi → üst hat\", 1, \"lazer + abkant\",\n157\t              \"fırın altı bölümünde kablolar silikon (Lapp ÖLFLEX HEAT 180 SiF) · VARSAYIM: boşluk sıcaklığı ölçülecek\"))\n158\t    ekle(\"ana_besleme_taban_cercevesi\", ici_bos([(4092.0, 4138.0, 125.0, 131.0, ZA[0] - 8.0, ZA[1] + 8.0)], [(4100.0, 4130.0, 124.0, 132.0, ZA[0], ZA[1])]), \"rakor\", B,\n159\t         bom=(\"Kablo giriş çerçevesi bölmeli conta (4 demet) · dolap tabanı\", 1, \"icotek KEL-DPZ 24 sınıfı\", \"VARSAYIM: çerçeve no. demet çaplarına göre seçilecek\"))\n160\t    DELIKLER.append((\"SC\", \"taban_dis_sac\", kut(4100.0, 4130.0, 120.0, 128.0, ZA[0], ZA[1]), \"ana besleme dolap tabanı girişi\"))\n161\t    for a_ in (\"bolme_4_sac_a\", \"bolme_4_pu\", \"bolme_4_sac_b\"):\n162\t        DELIKLER.append((\"SC\", a_, kut(3990.0, 4032.0, YA[0] - T, YA[1] + T, ZA[0] - T, ZA[1] + T), \"ana besleme bölme 4 geçişi (teknik sütun ↔ fırın altı, ikisi de sıcak)\"))\n163\t    DELIKLER.append((\"SC\", \"isi_kalkani_sol_sac\", kut(2498.0, 2503.0, YA[0] - T, YA[1] + T, ZA[0] - T, ZA[1] + T), \"ana besleme ısı kalkanı geçişi\"))\n164\t    DELIKLER.append((\"SC\", \"tavan_pu_T\", kut(2421.0 - T, 2503.0, YA[0] - T, 788.5, ZA[0] - T, ZA[1] + T), \"ana besleme dolap tavan PU geçişi (altında 75 mm PU kalır)\"))\n165\t    DELIKLER.append((\"SC\", \"tavan_dis_sac\", kut(2421.0 - T, 2451.0 + T, 785.0, 789.0, ZA[0] - T, ZA[1] + T), \"ana besleme dolap tavanı → C kaidesi\"))\n166\t    DELIKLER.append((\"KD\", \"kaide_C_ust_plaka_4\", kut(2421.0 - T, 2451.0 + T, 887.0, 893.0, ZA[0] - T, ZA[1] + T), \"ana besleme C kaidesi üst plakası\"))\n167\t    DELIKLER.append((\"TC\", \"dis_taban\", kut(2421.0 - T, 2451.0 + T, 891.0, 895.0, ZA[0] - T, ZA[1] + T), \"ana besleme TOPPING tabanı\"))\n168\t\n169\t    # ---------------- 4 · ÜST HAT: U_KE (60 × 40) → U_F + TOPPING (60 × 22) ----------------\n170\t    ys0, ys1 = UST_KE[\"y\"]; zs0, zs1 = UST_KE[\"z\"]                     # v3.4: U_KE sağ yan kolu + dış girişi kalktı\n171\t    g, k = u_kanal_x(4016.0, 5200.0, ys0, ys1, zs0, zs1, acik=\"+y\")\n172\t    ekle(\"ust_hat_U_KE_arka\", g, \"kanal\", B, bom=(\"Üst hat kablo kanalı PVC 60 × 40 + kapak (U_KE arkası)\", 1, \"Hager tehalit BA7A40060 / OBO LK4 40060 6178014\", \"\")); ekle(\"ust_hat_U_KE_arka_kapak\", k, \"kanal\", B)\n173\t    for i, xk in enumerate((4200.0, 4700.0, 5100.0)):\n174\t        ekle(\"ust_hat_U_KE_konsol_%d\" % i, kut(xk, xk + 30.0, ys0 - 3.0, ys1, -828.5, zs0), \"paslanmaz\", B,\n175\t             bom=(\"Kanal konsolu 304 (arka saca)\", 3, \"\", \"\") if i == 0 else None)\n176\t    # U_F + TOPPING kuru bölme (60 × 22)\n177\t    yf0, yf1 = UST_FT[\"y\"]\n178\t    for nm, (a, b) in ((\"U_F\", (2516.0, 3984.0)), (\"TOPPING\", (1340.0, 2468.0))):            # v3.6 · TOPPING kanalı A istasyon kutusuna kadar (U_A)\n179\t        g, k = u_kanal_x(a, b, yf0, yf1, zs0, zs1, acik=\"+y\")\n180\t        if nm == \"TOPPING\": g = g.cut(kut(2452.0, 2478.0, yf0 - 1.0, yf0 + T + 0.5, -828.0, -788.0 - T))        # v3.4 · ana besleme gövde kanalı aşağıdan girer\n181\t        if nm == \"TOPPING\": g = g.cut(sil((TOPPING_UST_X, yf0 - 1.0, TOPPING_HARTING[2]), (TOPPING_UST_X, yf0 + T + 1.0, TOPPING_HARTING[2]), 9.5))   # v3.6 · TOPPING Harting kablosu\n182\t        if nm == \"U_F\": g = g.cut(kut(TOPLAMA[\"x\"][0] + T, TOPLAMA[\"x\"][1] - T, TOPLAMA[\"y\"][0] + T, yf1 + 1.0, zs1 - T - 1.0, zs1 + 1.0))   # v3.6 · ana pano toplama kanalı ağzı\n183\t        ekle(\"ust_hat_%s\" % nm, g, \"kanal\", B, bom=(\"Üst hat kablo kanalı PVC 60 × 22 + kapak (%s)\" % nm, 1, \"arka saca konsollu\", \"\") if nm == \"U_F\" else None)\n184\t        ekle(\"ust_hat_%s_kapak\" % nm, k, \"kanal\", B)\n185\t    for i, xk in enumerate((2700.0, 3300.0, 3800.0)):\n186\t        ekle(\"ust_hat_U_F_konsol_%d\" % i, kut(xk, xk + 30.0, yf0 - 3.0, yf1, -828.5, zs0), \"paslanmaz\", B)\n187\t    ekle(\"ust_hat_TOPPING_konsol_0\", kut(2200.0, 2230.0, yf0 - 3.0, yf1, -828.5, zs0), \"paslanmaz\", B)\n188\t    ekle(\"ust_hat_TOPPING_konsol_1\", kut(1700.0, 1730.0, 2140.5, yf1, -828.5, zs0), \"paslanmaz\", B)            # v3.6 · A uzantısı\n189\t    ekle(\"ust_hat_TOPPING_konsol_A\", kut(1360.0, 1390.0, yf0 - 3.0, yf1, -828.5, zs0), \"paslanmaz\", B)            # v3.6 · U_A arka sacına\n190\t    for m_, a_, xa_, xb_ in ((\"TC\", \"dis_yan_sol\", 1434.0, 1469.0), (\"UD\", \"ust_a_yan_sag\", 1418.0, 1437.5)):\n191\t        DELIKLER.append((m_, a_, kut(xa_, xb_, yf0 - 1.0, yf1 + T + 1.0, zs0 - 1.0, zs1 + 1.0), \"v3.6 üst hat TOPPING → A geçişi\"))\n192\t    # duvar geçişleri (U_KE|U_F · U_F|TOPPING) — kanal geçiş parçası + sac kesikleri\n193\t    for nm, (xa, xb), mod, ad in ((\"KE_F\", (3984.0, 4016.0), \"UD\", \"ust_ke_yan_sol\"), (\"F_KE\", (3984.0, 4016.0), \"UD\", \"ust_f_yan_sag\"),\n194\t                                  (\"F_T\", (2468.0, 2516.0), \"UD\", \"ust_f_yan_sol\"), (\"T_F\", (2468.0, 2516.0), \"TC\", \"dis_yan_sag\")):\n195\t        DELIKLER.append((mod, ad, kut(xa - 1.0, xb + 1.0, yf0 - 1.0, yf1 + 1.0, zs0 - 1.0, zs1 + 1.0), \"üst hat geçişi\"))\n196\t    for nm, (xa, xb) in ((\"KE_F\", (3984.0, 4016.0)), (\"F_T\", (2468.0, 2516.0))):\n197\t        g = kut(xa, xb, yf0, yf1, zs0, zs1).cut(kut(xa - 1.0, xb + 1.0, yf0 + T, yf1 - T, zs0 + T, zs1 - T))\n198\t        if nm == \"F_T\": g = g.cut(kut(2468.0, 2478.0, yf0 - 1.0, yf0 + T + 0.5, -828.0, -788.0 - T))\n199\t        ekle(\"ust_hat_gecis_%s\" % nm, g, \"kanal\", B, bom=(\"Duvar geçiş kanalı + lastik çerçeve\", 2, \"\", \"\") if nm == \"KE_F\" else None)\n200\t    # ---------------- 5 · İNİŞLER (rakorlu) ----------------\n201\t    # E panosu: U_KE arka kanalından (x 5100) aşağı → U_KE tabanı + E tavanı → E pano kanalı üstüne (y 1837)\n202\t    for nm, xd, zd, mods in ((\"E\", 5100.0, -775.0, ((\"UD\", \"ust_ke_taban_sac\"), (\"KC\", \"ust_sac\"))), (\"K\", 4300.0, -775.0, ((\"UD\", \"ust_ke_taban_sac\"), (\"KS\", \"ust_sac\")))):\n203\t        H = EO.harting((xd, 1863.9, zd + 15.0), \"+y\", \"x\", t_duvar=3.8)                 # v3.6 · istasyon tavanı (2,3) + U_KE tabanı (2,3) üst üste\n204\t        for m_, a_ in mods:\n205\t            DELIKLER.append((m_, a_, H[\"kesik\"], \"v3.6 %s Harting Han 10B soket kesiği\" % nm))\n206\t        DELIKLER.append((\"UD\", \"ust_ke_icecek_rafi\", kut(xd - 45.0, xd + 45.0, 1890.0, 1898.0, zd + 15.0 - 26.0, zd + 15.0 + 26.0), \"v3.6 %s Harting fişi raf kesiği\" % nm))\n207\t        ekle(\"harting_%s_soket\" % nm, H[\"soket\"], \"rakor\", B); ekle(\"harting_%s_fis\" % nm, H[\"fis\"], \"rakor\", B); ekle(\"harting_%s_rakoru_M32\" % nm, H[\"rakor\"], \"rakor\", B)\n208\t        u_ = H[\"uc\"]; yk = u_[1] + 5.0\n209\t        g = kut(xd - 20.0, xd + 20.0, yk, ys0, zd, zd + 30.0).cut(kut(xd - 20.0 + T, xd + 20.0 - T, yk - 1.0, ys0 + 1.0, zd + T, zd + 31.0))\n210\t        ekle(\"inis_%s_kanali\" % nm, g, \"kanal\", B, bom=(\"İniş kanalı PVC 40 × 30 + kapak (üst hat → Harting fişi)\", 2, \"\", \"\") if nm == \"E\" else None)\n211\t        ekle(\"inis_%s_kanali_kapak\" % nm, kut(xd - 20.0, xd + 20.0, yk, ys0, zd + 30.0, zd + 30.0 + T), \"kanal\", B)\n212\t        ekle(\"inis_%s_ana_hat_ucu\" % nm, boru([u_, (u_[0], yk + 8.0, u_[2])], 8.5), \"kablo\", B)\n213\t    # v3.6 · TOPPING: kuru panonun SAĞ yüzünde Harting Han 10B (fiş +x) → M32 → üst hat kanalının tabanından içeri\n214\t    H = EO.harting(TOPPING_HARTING, \"+x\", \"y\", t_duvar=1.5)\n215\t    DELIKLER.append((\"TC\", \"kuru_pano_kutusu\", H[\"kesik\"], \"v3.6 TOPPING Harting Han 10B soket kesiği\"))\n216\t    ekle(\"harting_TOPPING_soket\", H[\"soket\"], \"rakor\", B); ekle(\"harting_TOPPING_fis\", H[\"fis\"], \"rakor\", B); ekle(\"harting_TOPPING_rakoru_M32\", H[\"rakor\"], \"rakor\", B)\n217\t    u_ = H[\"uc\"]\n218\t    ekle(\"inis_TOPPING_ana_hat_ucu\", boru([u_, (TOPPING_UST_X, u_[1], u_[2]), (TOPPING_UST_X, yf0 + 8.0, u_[2])], 8.5), \"kablo\", B)\n219\t\n220\t\n221\t# ================================================================ v3.6 · İSTASYON KUTULARI + HARTING + ANA PANO TARAFI ================================================================\n222\tdef _kutu(x, y, z, t=1.2, kapak=\"+z\"):\n223\t    \"\"\"küçük pano kutusu (304 1,5 · IP65): gövde (kapak tarafı açık) + kapak · kapak '+z' (öne bakar)\"\"\"\n224\t    x0, x1 = x; y0, y1 = y; z0, z1 = z"}]},"uuid":"b577e2b6-8645-4179-9c23-afb87ca17603","timestamp":"2026-10-01T21:25:16.957Z","sourceToolAssistantUUID":"e9395675-b442-4f8b-b172-e45fc6b342b6","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Ke