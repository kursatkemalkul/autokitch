, (ya, yb), (za, zb) in ((\"UD\", \"ust_ke_yan_sol\", (3984.0, 4016.0), KE_GECIS[\"y\"], KE_GECIS[\"z\"]), (\"UD\", \"ust_f_yan_sag\", (3984.0, 4016.0), KE_GECIS[\"y\"], KE_GECIS[\"z\"]),\n200\t                                                  (\"UD\", \"ust_f_yan_sol\", (2468.0, 2516.0), (yf0, yf1 + T), UF[\"z\"]), (\"TC\", \"dis_yan_sag\", (2468.0, 2516.0), (yf0, yf1 + T), UF[\"z\"])):\n201\t        DELIKLER.append((mod, ad, kut(xa - 1.0, xb + 1.0, ya - 1.0, yb + 1.0, za - 1.0, zb + 1.0), \"üst hat geçişi\"))\n202\t    g = kut(3984.0, 4016.0, KE_GECIS[\"y\"][0], KE_GECIS[\"y\"][1], KE_GECIS[\"z\"][0], KE_GECIS[\"z\"][1]).cut(\n203\t        kut(3983.0, 4017.0, KE_GECIS[\"y\"][0] + T, KE_GECIS[\"y\"][1] - T, KE_GECIS[\"z\"][0] + T, KE_GECIS[\"z\"][1] - T))\n204\t    kanal_ekle(\"ust_hat_gecis_KE_F\", g, \"kanal\", B, bom=(\"Duvar geçiş kanalı + lastik çerçeve\", 2, \"\", \"\"))\n205\t    g = kut(2468.0, 2516.0, yf0, yf1 + T, zf0, zf1).cut(kut(2467.0, 2517.0, yf0 + T, yf1, zf0 + T, zf1 - T))\n206\t    kanal_ekle(\"ust_hat_gecis_F_T\", g, \"kanal\", B)\n207\t    # toplama kanalı (ana pano solu)\n208\t    tx0, tx1 = TOPLAMA[\"x\"]; ty0, ty1 = TOPLAMA[\"y\"]; tz0, tz1 = TOPLAMA[\"z\"]\n209\t    gv = kut(tx0, tx1, ty0, ty1 - T, tz0, tz1).cut(kut(tx0 + T, tx1 - T, ty0 + T, ty1, tz0 - 1.0, tz1 - T))\n210\t    kanal_ekle(\"ana_pano_toplama_kanali\", gv, \"paslanmaz\", B,\n211\t               (\"Ana pano toplama kanalı 304 1,5 · 99 × 38,5 (U_F tavanı altında, ana panonun solu → üst hatta) + kapak\", 1, \"lazer + abkant\",\n212\t                \"v3.7 · 12 istasyon kablosu + modem iki katta (sütun sırasına göre: arka sütun alt kat, ön sütun üst kat) + bina 5G6 · doluluk %43\"))\n213\t    kanal_ekle(\"ana_pano_toplama_kanali_kapak\", kut(tx0, tx1, ty1 - T, ty1, tz0, tz1), \"paslanmaz\", B)\n214\t    for i, zk in enumerate((-700.0, -420.0)):"}]},"uuid":"aba63a21-533b-425a-9e2e-3da309342287","timestamp":"2026-10-01T22:38:07.108Z","sourceToolAssistantUUID":"230f0353-cc9a-486a-b8b