{"parentUuid":"8e23fa78-86d9-45c7-85a8-f56467c34b00","isSidechain":true,"promptId":"3e109f99-0047-4e4e-9654-86f16f99b2ef","agentId":"ae66c34020827ffa6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U6Pr3bZjgVbCK3qQkBE1Zj","type":"tool_result","content":"160\timport importlib, io, json, math, os, sys, time\n161\timport cadquery as cq\n162\t\n163\tU = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); KOK = os.path.dirname(os.path.dirname(U)); sys.path.insert(0, U); sys.path.insert(0, os.path.join(U, \"h3\"))   # v3: dosya h3/ içinde, U = _uretec\n164\tOUT = os.path.join(KOK, \"otonom\", \"hat3d\", \"v3\"); STEP = os.path.join(KOK, \"arastirma\", \"FULL_MAKINE\")   # v2: ayrı klasör (v1 hat3d'ye DOKUNMAZ)\n165\timport h3_hesap_v1 as HS\n166\tos.makedirs(OUT, exist_ok=True)\n167\tfrom kaset_3d_v3 import Mesh, MM, doku_ad, doku_montaj, etiket_yuzu, usdz_yaz, MALZEME\n168\tMALZEME.setdefault(\"kutu\", dict(renk=(0.62, 0.66, 0.72, 1.0), met=0.0, ruf=0.6, saydam=False))   # v67 opak\n169\tMALZEME.setdefault(\"katalog\", dict(renk=(0.42, 0.46, 0.52, 1.0), met=0.3, ruf=0.5, saydam=False))   # v67 opak\n170\tMALZEME.setdefault(\"kabin\", dict(renk=(0.80, 0.83, 0.87, 1.0), met=0.1, ruf=0.4, saydam=False))   # v67 opak\n171\tMALZEME.setdefault(\"soguk\", dict(renk=(0.25, 0.55, 0.85, 1.0), met=0.0, ruf=0.5, saydam=False))   # v67 opak\n172\tMALZEME.setdefault(\"sicak\", dict(renk=(0.85, 0.35, 0.22, 1.0), met=0.0, ruf=0.5, saydam=False))   # v67 opak\n173\tMALZEME.setdefault(\"robot\", dict(renk=(0.96, 0.62, 0.10, 1.0), met=0.2, ruf=0.45, saydam=False))   # v67 opak\n174\tMALZEME.setdefault(\"sac\", dict(renk=(0.74, 0.77, 0.80, 1.0), met=0.85, ruf=0.32))\n175\tMALZEME.setdefault(\"pu\", dict(renk=(0.93, 0.88, 0.72, 1.0), met=0.0, ruf=0.85))\n176\tMALZEME.setdefault(\"motor\", dict(renk=(0.18, 0.19, 0.22, 1.0), met=0.5, ruf=0.45))\n177\tMALZEME.setdefault(\"bakir\", dict(renk=(0.72, 0.45, 0.20, 1.0), met=0.9, ruf=0.35))\n178\tMALZEME.setdefault(\"kart\", dict(renk=(0.10, 0.35, 0.22, 1.0), met=0.1, ruf=0.6))\n179\t\n180\t# ---------------------------------------------------------------- v35 · PAFTA: HAT ATOSA TABLALI v7 ----------------------------------------------------------------\n181\t# Yerlesim (modul genislikleri, firin/kesme/kutu ic duzeni, robot, QR) ATOSA TABLALI v7'den OKUNUR.\n182\t# Cekmece modulu B'nin ic verisi (kolonlar, kotlar) v19 ile BIREBIR ayni (\"ORTAK VERI\") -> v19'dan okunmaya devam eder.\n183\t_p = open(os.path.join(U, \"teknik_hat_2kol_v19.py\"), encoding=\"utf-8\").read()\n184\t_g = {\"__name__\": \"_pafta\", \"os\": os, \"math\": math}\n185\texec(_p[_p.index(\"# ======================= VERI =======================\"):_p.index(\"# ======================= YERLESIM =======================\")], _g)\n186\t_p7 = open(os.path.join(U, \"teknik_hat_atosa_tablali_v7.py\"), encoding=\"utf-8\").read()\n187\t_g7 = {\"__name__\": \"_pafta7\", \"os\": os, \"math\": math}\n188\texec(_p7[_p7.index(\"# ======================= ORTAK VERI (HAT 2 KOL v19) =======================\"):_p7.index(\"\\nOX, FY_TOP\")], _g7)\n189\tDZ = _g7[\"DZ\"]                                                                           # 830\n190\t# ---- v57 · ALÇAK HAT (SPEC_alcak_hat_v57.md · ALCAK_HAT_RESIM1_v4 + QR_TEZGAH_v4) · pafta v7'nin taban 1060 / üst 2030 / B genişliği 2500 değerleri GEÇERSİZ ----\n191\t# v56'daki tek taban sabiti (1060) dört ayrı şey demekti (B üstü · A/C kabin tabanı · TOPPING CAD orijini · K istasyon tabanı) → ikiye ayrıldı.\n192\t# Toptan yeniden adlandırma parçaları sessizce kaydırırdı (keşif riski 1); her kullanım tek tek Y_DUZ / Y_MEK yapıldı.\n193\tDY = -168.0                                   # v56 → v57 bütün mekanizma kotlarının farkı (1060 → 892)\n194\tY_DUZ = 788.0                                 # TEK DÜZ ÇİZGİ: çekmeceli dolap üstü = A/C kabin tabanı = fırın gövdesi altı (basamak yok)\n195\tY_MEK = 892.0                                 # A/C mekanizma tabanı (Y_DUZ + kaide 104) = TOPPING CAD (TC, yerel y) orijini = K istasyon tabanı\n196\tH_MAK = 1862.0                                # istasyon üstü (A · F · K · E) — v2: makine üstü H_UST\n197\tH_UST = HS.H_UST                              # v2 · makine üstü 2200 = iki katlı TOPPING = üst depo (U) üstü\n198\tW_B = HS.W_B                                  # v2 · çekmeceli dolap TEK PARÇA 507,5–4000 (3492,5 · K4 kolonu çıktı)\n199\tassert abs(Y_MEK - (_g7[\"H_B\"] + DY)) < 0.01 and abs(H_MAK - (_g7[\"H_MAK\"] + DY)) < 0.01, \"v57: pafta v7 kotlari + DY tutmuyor\"\n200\t\n201\t\n202\tdef _gk(ok):\n203\t    \"\"\"v57 · denetim satırının sonucu (açık PASS / FAIL)\"\"\"\n204\t    return \"GECTI [PASS]\" if ok else \"KALDI [FAIL]\"\n205\t\n206\t\n207\tX_A, W_A, X_BC, W_BC = _g7[\"X_A\"], _g7[\"W_A\"], _g7[\"X_C\"], _g7[\"W_C\"]                     # A 0-700 · C 700-2500 · v57: W_B yukarıda (4000)\n208\tX_A = HS.A_X[0]                                                                          # v2 · A 507,5–1207,5 · X_BC 700 = TOPPING ÇERÇEVE ORİJİNİ (TC / TU yerel) OLARAK KALIR\n209\tX_C0 = HS.C_X[0]                                                                         # v2 · TOPPING'in dünya solu 1207,5 (1292,5 geniş)\n210\tX_D, W_D = _g7[\"X_F\"], _g7[\"W_F\"]                # FIRIN: paftada F, sitede oven.html modul_D'yi yukluyor -> harf D\n211\tX_K, W_K, X_E, W_E = _g7[\"X_K\"], _g7[\"W_K\"], _g7[\"X_E\"], _g7[\"W_E\"]\n212\t# v38 · E = kutu_cad_v2: standart 32 × 32 × 4,2 kutunun açılımı 804 × 404 → 700'e sığmıyor, modül 830.\n213\t# PAFTA v7'de E hâlâ 700; pafta v8 Kemal'in onayını bekliyor. Model burada ÖNDEN gidiyor (bilerek).\n214\tW_K = 400.0\n215\tX_E = X_K + W_K\n216\tW_E = 830.0\n217\tHAT_W = X_E + W_E                                                                        # v38: 5430 (pafta v7: 5300)\n218\tHAZNE = _g7[\"HAZNE\"]                                                                     # firin pisirme haznesi 1400\n219\tRZ, OMUZ, ERISIM, RX = _g7[\"RZ\"], _g7[\"OMUZ\"], _g7[\"ERISIM\"], _g7[\"RX\"]\n220\t# v57: QR yeri ve ölçüsü qr_cad_v1'den (pafta v7'deki QR yer tutucusu kalktı) · S modülü (QR + tezgâh) · ray ekleri · A/C kaidesi — hepsi dünya koordinatı\n221\timport qr_cad_v1 as QR, tezgah_cad_v2 as TZ, h3_ray_ek_v2 as RE, h3_kaide_v1 as KD      # v86: C kaidesinde soğutma grubu cebi + hava pencereleri · v81: kaideler istasyon yüzleriyle aynı hiza\n222\tKOLON, KOL_Y0, K1_TABAN = _g[\"KOLON\"], _g[\"KOL_Y0\"], _g[\"K1_TABAN\"]\n223\timport topping_hesap_v7 as TH, h3_tc_v1 as TC                                      # v48: tekne 2500'de biter                                      # TOPPING modülü: derinlik dizilimi ve yuva konumları ORADAN okunur\n224\tKASET_Z = (TH.Z_KASET[1], TH.Z_KASET[0])\n225\tT_KAS = (Y_MEK + TC.KAS[0], Y_MEK + TC.KAS[1])    # v35: kaset kotu CAD'den · v57: Y_MEK (ölü sabit — kaset döngüsü boş)\n226\t\n227\t# ---- v35 · SUREC KOTU (Kemal 24 Eyl \"B\": TOPPING'e dokunma, digerleri tablanin kotuna insin) ----\n228\t# Sayilar topping_cad_v22'den; yazildiktan sonra ASAGIDA parcalarin gercek kutusundan OLCULUP assert edilir.\n229\tDISK_UST_Y = 108.0                                # calisma_diski ust yuzu (yerel y)\n230\tP = Y_MEK + DISK_UST_Y                            # 1000 (v56: 1168)\n231\tBANT_UST = Y_MEK + 106.0                          # 998 · firin bandi ust kosu (CAD AKT_Y: diskin 2 mm alti) · v56: 1166\n232\tZT = TH.Z_KASET[0] + 30.0                         # -170 · tabla ekseni (topping_cad_v22 ile ayni formul)\n233\tBANT_Z = (ZT - 145.0, ZT + 145.0)                 # 290 genis · TOPPING'deki aktarma bandiyla ayni\n234\tBANT_X0 = X_BC + 2195.0 + 35.0                           # CAD'deki aktarma bandinin tahrik silindiri (hat x 2895) -> devam buradan\n235\tPLAKA = BANT_UST - 2.0                            # 996 · kesme plakasi bandin 2 mm ALTINDA: urun hep asagi iner\n236\tTEPSI_Y = PLAKA - 60.0                            # 936 · kutu tepsisi yuzu (pafta kurali: surec - 60) -> kutu agzi ~981\n237\tE_A0, E_A1 = PLAKA - 90.0, PLAKA + 160.0          # kutulama agzi (pafta: P-90 ... P+160)\n238\tF_G1 = BANT_UST + 320.0                           # (ölü) firin govdesi ustu (pafta: bant + 320)\n239\tKAIDE = OMUZ - 152.0                              # FR5 taban -> omuz 152 [katalog Fairino FR5 d1]\n240\t\n241\tX_S = TZ.X0 - TZ.TASMA                                   # v57 · S modülü solu = tezgâh tablası (3935) … sağı = QR dolabının sağı = hattın ucu (5430)\n242\tMODUL = [(\"A\", \"MODÜL A · KONİLİ AÇICI (dolap üstünde · kaide 104)\", X_A, W_A), (\"B\", \"MODÜL B · ÇEKMECELİ DOLAP (tek parça 736–4400 · 21 çekmece + K altında teknik sütun)\", X_A, W_B),\n243\t         (\"C\", \"MODÜL C · TOPPING İKİ KATLI (dolap üstünde · kaide 104 · 2200)\", X_C0, HS.C_X[1] - X_C0), (\"D\", \"MODÜL F · KONVEYÖR FIRIN\", X_D, W_D),\n244\t         (\"K\", \"MODÜL K · KESME + SPREY · 400 mm prototip\", X_K, W_K), (\"E\", \"MODÜL E · KUTU KATLAMA (tek parça)\", X_E, W_E),\n245\t         (\"S\", \"MODÜL S · SERVİS / TESLİM (QR dolabı + tezgâh)\", X_S, QR.X0 + QR.W - X_S),\n246\t         (\"U\", \"MODÜL U · ÜST DEPO (A · fırın · K + E üstünde, 1862–2200)\", X_A, X_E + W_E - X_A)]\n247\tMODUL_Y = {\"A\": (Y_DUZ, H_MAK), \"B\": (0.0, Y_DUZ), \"C\": (Y_DUZ, H_UST), \"U\": (H_MAK, H_UST), \"D\": (Y_DUZ, H_MAK), \"K\": (0.0, H_MAK), \"E\": (0.0, H_MAK), \"S\": (QR.Y0, QR.Y0 + QR.H)}\n248\t\n249\t# ---------------------------------------------------------------- KÜTÜK ----------------------------------------------------------------\n250\t# (kod, ad, modül, durum, x0, x1, y0, y1, z0, z1, malzeme, kaynak/not, sayfa)\n251\tB = []\n252\tdef birim(kod, ad, mod, durum, x, y, z, mal=\"kutu\", kaynak=\"\", sayfa=\"\"):\n253\t    B.append(dict(kod=kod, ad=ad, modul=mod, durum=durum, x=x, y=y, z=z, mal=mal, kaynak=kaynak, sayfa=sayfa))\n254\t\n255\t\n256\t\n257\tdef _dis_birim(M, durum, kaynak, sayfa):\n258\t    \"\"\"v57 · dünya koordinatlı yeni üreteçlerin birimleri (bulasik_cad_v2 sözleşmesi: kur() · PARCALAR · dunya(p) · BIRIMLER · BIRIM_MODUL)\"\"\"\n259\t    for _k, _a in M.BIRIMLER:\n260\t        _bb = [M.dunya(_p).BoundingBox() for _p in M.PARCALAR if _p[\"birim\"] == _k]\n261\t        assert _bb, \"%s: %s biriminin parcasi yok\" % (kaynak, _k)\n262\t        birim(_k, _a, M.BIRIM_MODUL[_k], durum, (min(q.xmin for q in _bb), max(q.xmax for q in _bb)), (min(q.ymin for q in _bb), max(q.ymax for q in _bb)),\n263\t              (min(q.zmin for q in _bb), max(q.zmax for q in _bb)), \"sac\", kaynak, sayfa(_k) if callable(sayfa) else sayfa)\n264\t\n265\t\n266\t# --- C · TOPPING: dozaj kasetleri (GERÇEK olanlar burada) ---\n267\t# v41 (Kemal 25 Eyl): YALNIZ Isaac/Codex deneyindeki iki kaset. KIYMA v9 · KUŞBAŞI v8 · HARÇ v4 şimdilik modelde YOK\n268\t#      (üreteçleri duruyor, geri almak = bu sözlüğe satırı geri eklemek).\n269\tKASET_CAD = {}   # v42: kaşar + sucuk kasetleri TOPPING v2 modelinin (topping_uno_cad_v3) içinde, yeni yerlerinde\n270\tYUVA_V1 = [(ad, x1 - x0, (x0 + x1) / 2.0) for ad, x0, x1, gen in TC.YUVA]     # yuva adı, genişlik, merkez (modül yerelinde)\n271\tfor urun, gw, xc in YUVA_V1:\n272\t    xa = X_BC + xc - gw / 2.0; anahtar = urun.split()[0] if urun.startswith(\"HARÇ\") else urun\n273\t    cad = KASET_CAD.get(anahtar)\n274\t    if not cad:\n275\t        continue                                                                         # v41: bu yuva şimdilik boş\n276\t    birim(\"KASET_\" + urun.replace(\" \", \"_\"), (cad[1] if cad else \"Harç kaseti (KARAR: yap / satın al)\"), \"C\", \"GERCEK\" if cad else \"KUTU\",\n277\t          (xa + 1.0, xa + gw - 1.0), (T_KAS[0], T_KAS[0] + 360.0), KASET_Z, \"pom\" if cad else \"kutu\",\n278\t          (cad[0] + \".py\") if cad else \"modellenmedi · kıyma kaseti macunu pideye YAYAMIYOR, harçta sorun daha ağır (yayıcı kararı)\", cad[2] if cad else \"\")\n279\tFT_ZS_ON = 79.0                                           # v63 · ön düzlem (fırın gövdesinin ön yüzü; FT.ZS ile sözleşmede eşitlenir)\n280\tbirim(\"TOPPING_MODUL\", \"TOPPING İKİ KATLI (v3): ALT KAT kıyma · kuşbaşı UNO + kaşar · küp sucuk kaseti · ÜST KAT YALNIZ sos + harç UNO · sos / harç hortumu DİK iner, yayıcılar alt kat dozajlayıcılarının arasında (sos 1645 · harç 2160) · \"\n281\t      \"evaporatör kaseti dönüşü alt kattan, üflemesi üst kata · tabla mekanizması v1'den (kısaldı)\", \"C\", \"GERCEK_MODUL\",\n282\t      (X_C0, HS.C_X[1]), (Y_MEK, Y_MEK + TC.Y), (-DZ, FT_ZS_ON), \"sac\", \"h3/h3_topping_v1.py (topping_cad_v32 + topping_uno_cad_v19 parçaları, iki katlı · v3)\", \"hat/makine_v3.html\")\n283\tbirim(\"HAVA_KOMPRESOR\", \"Kompresör JUN-AIR OF302-15B (yağsız, 15 L, 25 kg) · FIRIN ÜSTÜNDE (havalandırmalı raf 1348, ortam sınırı 40 °C, davlumbaz bölmesinin ön yarısı, kutu yedeğinin yanı — TOPPING'in tek istisnası) · Ø10 ana hat y 1809'da fırın üstünde ARKADAN (z −740) TOPPING sağ yan sac rakorundan kuru bölmeye → dikine şartlandırıcıya (v86: teknik cep yok) · K'ye dal (MS4 tepesi 1692 + 10)\", \"D\", \"GERCEK_HAVA\",\n284\t      (3600.0, 3980.0), (1348.0, 1858.0), (-420.0, -40.0), \"sac\", \"topping_uno_cad_v16.py\", \"hat/topping_v2.html\")     # v57: y −168 (raf üstü 1348 · sözleşmede ölçülür)\n285\t# ---- v42 · TOPPING v2 parçaları ----\n286\timport importlib.util as _ilu\n287\t_sp = _ilu.spec_from_file_location(\"TU11\", os.path.join(U, \"h3\", \"h3_tu_v1.py\"))   # v2 · iki katlı soğuk paket   # v89: evaporatör kuru bölmede (arka duvarda 2 kanal)   # v86: dikdörtgen soğuk kutu + eşit kapaklar   # v83: soğuk kutu 60 sandviç + evaporatör içeride   # v56: yalıtım yalnız soğuk hacmi sarar   # v54: yalıtım tek dikdörtgen + teknik ayırma saçı   # v51: fitil tam   # v49: katalog yay/pim, haç 7,0   # v48: kaset yuvaları + yalıtım bloğu + fitil   # v45: kama yarık + dönen gruplar\n288\tTU = _ilu.module_from_spec(_sp); _sp.loader.exec_module(TU)\n289\t_n_tu = TU.den_assert(); print(\"v86 · TU topping_uno_cad_v19 modul denetimi %d / %d GECTI (den_assert zorunlu)\" % (_n_tu, _n_tu))\n290\tfor _k, (_r, _m, _ru, _say) in TU.M.items():\n291\t    MALZEME.setdefault(_k, dict(renk=_r, met=_m, ruf=_ru, saydam=_say))\n292\t# v55 · görünürlük: yalıtım yarı saydam krem · ayırma saçı mavi · yedek yığınları karton\n293\tMALZEME[\"yalitim_gorunur\"] = dict(renk=(0.95, 0.84, 0.52, 1.0), met=0.0, ruf=0.8, saydam=False)   # v67: PU opak (Kemal)\n294\tMALZEME[\"saydam_celik\"] = dict(renk=(0.78, 0.80, 0.83, 1.0), met=0.6, ruf=0.3, saydam=False)       # v67: UNO ürün silindiri gerçekte paslanmaz → opak\n295\tif \"pu\" in MALZEME: MALZEME[\"pu\"] = dict(MALZEME[\"pu\"], renk=(0.93, 0.86, 0.55, 1.0), saydam=False)  # v67: PU opak\n296\tMALZEME[\"kabuk\"] = dict(renk=(0.74, 0.77, 0.80, 1.0), met=0.85, ruf=0.32, saydam=False)            # v68: dış sac 304 1,5 opak (süzgeç kalkınca görünür)\n297\tMALZEME[\"ayirma_saci\"] = dict(renk=(0.18, 0.36, 0.92, 1.0), met=0.3, ruf=0.4, saydam=False)\n298\tMALZEME[\"karton\"] = dict(renk=(0.80, 0.64, 0.42, 1.0), met=0.0, ruf=0.85, saydam=False)\n299\tfor _q in TU.P:\n300\t    if _q[\"ad\"] == \"yalitim_blogu\":\n301\t        _q[\"mal\"] = \"yalitim_gorunur\"\n302\t    elif _q[\"ad\"].startswith(\"teknik_ayirma_saci\"):\n303\t        _q[\"mal\"] = \"ayirma_saci\"\n304\t    elif _q[\"ad\"] in (\"kabin_sol_duvar_PU\", \"kabin_sag_duvar_PU\", \"alt_yalitim_PU\"):     # v56: yan PU duvarlar da görünür · v60: + alt yalıtım (v12)\n305\t        _q[\"mal\"] = \"yalitim_gorunur\"\n306\t# ---- v57 · ALÇAK HAT: TU (topping_uno_cad_v15, DÜNYA y) BİR KEZ −168 kaydırılır — bütün parçalar + dönen grup pivotları (VALF_/PISTON_/HELEZON_/KARISTIRICI_/TABLA).\n307\t#      TC (topping_cad_v27, YEREL y) KAYDIRILMAZ: TOPPING_MODUL y0 = Y_MEK ile yerleşir. İkisi karışırsa ya iki kez ya hiç kaymaz (keşif riski 2).\n308\tfor _q in TU.P:\n309\t    _q[\"sh\"] = _q[\"sh\"].translate(cq.Vector(0.0, DY, 0.0))\n310\tfor _g in list(TU.GRUP):\n311\t    if _g != \"SABIT\":\n312\t        TU.GRUP[_g] = (TU.GRUP[_g][0], TU.GRUP[_g][1] + DY, TU.GRUP[_g][2])\n313\tTU_YAL_Y0 = TU.YAL_Y0 + DY                                                                # soğuk oda yalıtım altı 1277 → 1109 (aktarma iticisinin kirişi buna bağlanır: IT.TAVAN)\n314\timport firin_tp10_cad_v10 as FT\n315\tFT.KOMP_ACIKLIK = (HS.KOMP_ACIKLIK_X[0], HS.KOMP_ACIKLIK_X[1], FT.KOMP_ACIKLIK[2], FT.KOMP_ACIKLIK[3])   # v3 · raf açıklığı kompresörle 241 sola (h3_hesap_v1)                                                          # v57: alçak hat (BANT_UST_HAT 998 · gövde 788–1305 · raf 1348) · v49: havalandırmalı raf\n316\timport bantli_tabla_montaj_v1 as BT                                                      # v70: bantlı tabla (kaset, sabit tahrik, yükleme bandı) · itici_cad_v5 KALKTI\n317\timport bulasik_cad_v2 as BM                                                            # v53: MEIKO M-iClean US gerçek modeli (föy ölçüleri)\n318\tfor _k, _v in BM.MALZEME.items():\n319\t    MALZEME.setdefault(_k, dict(renk=_v[\"renk\"], met=_v[\"met\"], ruf=_v[\"ruf\"], saydam=False))\n320\tAKTARMA_TP10 = (\"bant_burun_silindiri\", \"bant_tahrik_silindiri\", \"bant\", \"bant_tasiyici_saci\", \"bant_yan_saci_0\", \"bant_yan_saci_1\", \"bant_motoru\", \"bant_ayagi\")\n321\tYARIK_V2 = FT.kut(*FT.YARIK_V2[0]).cut(FT.kut(*FT.YARIK_V2[1])).val()                          # TOPPING çıkış yarığı çerçevesi v2 (dünya)\n322\tV1_CIKAN = (\"hava_hatti_acici\", \"rakor_hava_acici\", \"pu_\", \"ic_kabuk\", \"bolme\", \"on_kapak\", \"kapak_contasi\", \"dozaj_kovani_\", \"konum_pimi_\", \"kovan_\", \"mil_\", \"motor_\", \"reduktor_\",\n323\t            \"soket_\", \"yay_\", \"ray_\", \"yuva_etiketi_\", \"hava_perdesi\", \"din_ray\", \"_bom\")\n324\t\n325\t\n326\tdef v1_kalir(ad):\n327\t    if ad.startswith((\"ray_kirisi\", \"ray_ortu\")): return True\n328\t    if ad.startswith(\"surucu_\"): return ad in (\"surucu_0\", \"surucu_1\", \"surucu_2\", \"surucu_3\")\n329\t    if ad == \"din_ray_ups\": return True\n330\t    return not ad.startswith(V1_CIKAN)\n331\t\n332\t\n333\tV1_TASI = {\"sogutma_grubu\": (790.0, 0.0, 0.0), \"pano_kutusu\": (80.0, 0.0, 0.0), \"ups\": (140.0, 0.0, 0.0), \"din_ray_ups\": (140.0, 0.0, 0.0),\n334\t           \"guc_kaynagi\": (1196.0, 0.0, 0.0), \"fire_silecegi\": (520.0, 0.0, 0.0)}\n335\tfor _i in range(4):\n336\t    V1_TASI[\"surucu_%d\" % _i] = (480.0 - 605.0, 1600.0 - 1776.0, -620.0)\n337\tV1_TASI = {}                                  # v2 · TC parçaları h3_topping_v1'de SON yerlerinde (v1 düzeltme ötelemeleri uygulanmaz)\n338\tV3_CIKAN = (\"kabin_taban_saci\", \"kabin_arka_saci\", \"kabin_ust_saci\", \"kabin_sag_teknik_sac\", \"tabla_diski\",   # v60: yan PU duvarlar ARTIK girer (eski \"kabin_\" öneki onları da düşürüyordu)\n339\t            \"pide\", \"baglam_\", \"teknik_bant_\", \"kompresor_\", \"hava_ana_hatti\")\n340\tV3_HAVA = (\"kompresor_\", \"hava_ana_hatti\")\n341\tKOMP_KAY = (-510.0 + HS.KOMP_DX, 976.0, 0.0)   # v3 · tank 3359–3739 (v2 3600–3980)               # v48: kompresör (TU x 3410–3790 · z −40…−420) → fırın üstü raf: dünya x 3600–3980 · v57: TU −168 kaydırıldığı için AYNI kalır → y 1348–1844 (raf üstü 1348)\n342\tANA_V44 = [(3090 + HS.KOMP_DX, 1977, -380), (3090 + HS.KOMP_DX, 1977, -740), (1785, 1977, -740), (1785, 1335, -740), (1770, 1335, -740)]   # v2: kaset (1790–2330 × 1383–1765) sağından iner → FRL'nin (2420–2470) SAĞ portu   # v86: fırın üstünde ARKAYA (z −740), TOPPING'e kuru bölmeden (teknik cep yok · TC v30 RAKOR_ANA)   # v56: teknik cepte 1977 düz (zarflar 1731,5–1971,5)   # v54: yığınların arkası (z −432) · TOPPING teknik cebinden   # v48: fırın üstü → TOPPING rakoru (dünya 2500, y 2000, z −415) → teknik cep → kuru bölme → şartlandırıcı sol yüzü\n343\tANA_K48 = [(3090 + HS.KOMP_DX, 1977, -432), (3090 + HS.KOMP_DX, 1977, -770), (3294, 1977, -770)]   # v3 · kompresör vanası 3549   # v87: K v8 sol duvar rakoruna (KS.Y_HAVA_GIRIS 1809 · z −770 · dış ucu K x −6); istasyon kendi içinde AW20'ye bağlar · v86: MS4 tepesine   # v54: K şartlandırıcısının (MS4) tepesine · köşe dikmesinin (z −798) önünden   # v48: K'ye dal — K besleme hattının tepesine (dünya x 4160, y 1700, z −795)\n344\t\n345\t# v57 · hava ana hattı TOPPING / fırın / K ile birlikte RİJİT −168: teknik cep 1977 → 1809 · fırın üstü 1335 → 1167 · K dalı ucu 1870 → 1702 (MS4 tepesi 1692 + 10, sözleşmede ölçülür)\n346\tANA_V44 = [(x_, y_ + DY, z_) for x_, y_, z_ in ANA_V44]\n347\tANA_K48 = [(x_, y_ + DY, z_) for x_, y_, z_ in ANA_K48]\n348\t\n349\t# --- B · ÇEKMECE MODÜLÜ (v36: GERÇEK üretim modeli store_cad_v1 — her çekmece ayrı birim) ---\n350\timport h3_store_v1 as SC                                  # v57: TEK PARÇA çekmeceli dolap 0–4000 × 123–788 (24 çekmece · fırın altı PU 60 + taşıyıcı · robot çöpü şeridi) · v44: tam kaplayan kapaklar\n351\tY_ALT = SC.Y_PLINT                                         # v40 · ALT TABAN ÇİZGİSİ: bütün istasyon gövdeleri yerden buradan başlar (123)\n352\tSC_OZET = {k: (t, n) for k, t, n, _u, _a in SC.modul()}\n353\t_SC_AD = {\"B_KASA\": \"ÇEKMECELİ DOLAP gövdesi (tek parça, +3 °C): sandviç kabuk + PU + 6 bölme · 0–4000 × 123–788 · ön çerçeve + plint · sol yan PU 60 · fırın altında HAVA BOŞLUKLU ısı kalkanı (v59: PU yok — ayırma sacı 728 + parlak paslanmaz ışınım sacı 740 + arka 6 yarık · fırın kirişlere oturur)\",\n354\t          \"B_ELEKTRIK\": \"K4 · Secop'un arkasında pano: Siemens S7-1200 + Mean Well NDR-240-24 + Electromen EM-324C + %d seçici röle\" % len(SC.CEK),\n355\t          \"B_KABLO\": \"Kablo kanalları 40 × 25: her kolonda dikey + yatay (K1→K4 703–728 · K4→K6 643–668, bölmelerden geçer)\",\n356\t          \"B_SOGUTMA\": \"Soğutma (v59 standart düzen · sogutma_hesabi_v1): Secop CU NLE8.8CN R290 688 W @ −10/32 °C (gereken 552–661 W) K4 altında ızgaralı kapak arkasında · 2 bölge lamelli epoksi kaplı evaporatör (sol K2 arkası → K1–K3 · sağ K5 arkası → K4 depo + K5–K6) + davlumbaz + 4 × ebm-papst 4414 FL · bölmelerde arka hava geçişleri · damlama teknesi → Ø12 gider → plintte kondenser atış kanalı + buharlaştırma tavası\",\n357\t          \"B_DEPO\": \"K4 kaşar + sucuk deposu · kapaklı · +3 °C · 2 gün (GN 1/1-100 kaşar + GN 1/2-100 sucuk) · 4 günün 2. yarısı\",\n358\t          \"B_TASIYICI\": \"Fırın taşıyıcı çerçevesi 304: 2 kiriş 40 × 40 × 2 (y 746,5–786,5) + 3 çapraz + 6 dikme (bölmelerin içinde, altlarında ayak) · fırın 200 kg + raf 99 kg (VARSAYIM)\",\n359\t          \"B_COP\": \"ROBOT ÇÖPÜ şeridi 3810–4000 (soğuk DEĞİL, 3810'da yalıtımlı ara duvar): 15 L kova 165 × 300 × 400 (poşetli, kızaklı) · atma boşluğu · ön yüzde 130 × 130 yaylı klape (y 610–740, menteşe 748)\"}\n360\t_TIP_AD = {\"hamur\": \"taze pide\", \"lahm\": \"lahmacun\", \"icecek\": \"içecek + tatlı · 2 katlı\", \"ic1\": \"içecek · tek kat · yaylı itici\",\n361\t           \"ic1d\": \"içecek · tek kat (dar) · yaylı itici\", \"tatli\": \"tatlı · 2 şerit\"}\n362\t_BIRIM_AD = {\"hamur\": \"top\", \"lahm\": \"top\", \"icecek\": \"kutu\", \"ic1\": \"kutu\", \"ic1d\": \"kutu\", \"tatli\": \"kap\"}\n363\tfor _kod in dict.fromkeys(p[\"birim\"] for p in SC.PARCALAR):\n364\t    _ps = [p for p in SC.PARCALAR if p[\"birim\"] == _kod]\n365\t    _bb = [p[\"wp\"].val().BoundingBox() for p in _ps]\n366\t    _x = (min(q.xmin for q in _bb), max(q.xmax for q in _bb)); _y = (min(q.ymin for q in _bb), max(q.ymax for q in _bb))\n367\t    _z = (min(q.zmin for q in _bb), max(q.zmax for q in _bb))\n368\t    if _kod in SC_OZET:\n369\t        _t, _n = SC_OZET[_kod]; _kol = _kod.split(\"_\")[1]\n370\t        _ad = \"%s · %s çekmecesi %s · %d %s · fitilli · Transmotec motor + GT3 kayış · strok %.0f\" % (\n371\t            _kol, _TIP_AD[_t], _kod.rsplit(\"_\", 1)[1], _n, _BIRIM_AD[_t], SC.STROK)\n372\t    else:\n373\t        _ad = getattr(SC, \"BIRIM_AD\", {}).get(_kod, _SC_AD.get(_kod, _kod))                  # v2: dolap birim metinleri h3_store_v1'den (K4 yok)\n374\t    birim(_kod, _ad, \"B\", \"GERCEK_STORE\", _x, _y, _z, \"sac\", \"h3_store_v1.py (v3 dolap · store_cad_v14 çekmeceleri · teknik sütun K altında)\", \"\")\n375\t\n376\t# --- A · PRESS ---\n377\t# v28 · PRESS ARTIK \"ACICI\": Fersah PZP-400 komple makine olarak KULLANILAMIYOR.\n378\t# Sebebi olculdu: presin alt plakasi (1150-1170) bizim tablanin yerini istiyor ve\n379\t# tabla plakanin TAM ICINDE kaliyor (plaka 580x640, tabla Ø340) — biri digerinin\n380\t# altina giremiyor. Ustelik tepsi kalktigi icin duz presin 3-12 kN'lik kuvveti\n381\t# dogrudan tablaya, doner yataga ve raya binerdi; o yatak bunu tasimaz.\n382\t# Yerine KONILI DONEN ACICI: hamuru yuvarlayarak acar, 40-160 N ister (75 kat az).\n383\t# TOPPING'in tablasi modul A'ya girip bu kafanin altina gelir, hamur orada acilir.\n384\t# v29: ACICI birimleri MODUL C'ye yazildi. Fiziksel olarak modul A'nin ayak izinde\n385\t# duruyorlar ama ISLEVLERI TOPPING'in — ve TOPPING sayfasi ile animasyonu yalniz\n386\t# modul_C.glb yukluyor; \"A\" yazilinca kafa sayfada hic gorunmuyordu.\n387\t# v63: A_KABIN KUTU yer tutucusu kalktı → acici_kabin_cad_v1 (A_GOVDE + A_ONYUZ, aşağıda KD.kur() sonrası)\n388\t# ---- v57 · A + C MEKANİZMA KAİDESİ 104 (kaide_cad_v2, dünya): dolap üstü 788 → mekanizma tabanı 892 · A: açıcı kolonu + tekne sacı 892–893,5 · C: TOPPING dis_taban ----\n389\tKD.kur()\n390\t_dis_birim(KD, \"GERCEK_KAIDE\", \"kaide_cad_v4.py\", lambda k_: \"hat/press.html\" if KD.BIRIM_MODUL[k_] == \"A\" else \"hat/topping_v2.html\")\n391\timport h3_acici_v1 as AK                                                         # v63: A gerçek kabin (dünya · 304 1,5 · ön tava 20 · robot ağzı · ışık perdesi)\n392\tAK.kur()\n393\t\n394\tdef _v34_ac(PL_, ad_, x0_=770.0, x1_=1402.0, z0_=-796.0, z1_=7.0):           # v3.4 · Kemal: \"üstteki rafı kaldır, bu kutu temiz kalsın\"\n395\t    for p_ in PL_:\n396\t        if p_[\"ad\"] == ad_:\n397\t            s_ = p_[\"wp\"].val() if hasattr(p_[\"wp\"], \"val\") else p_[\"wp\"]; b_ = s_.BoundingBox()\n398\t            p_[\"wp\"] = cq.Workplane(obj=s_.cut(cq.Solid.makeBox(x1_ - x0_, b_.ylen + 2.0, z1_ - z0_, cq.Vector(x0_, b_.ymin - 1.0, z0_))))\n399\t            return True\n400\t    raise AssertionError(\"v3.4 · açılacak sac yok: \" + ad_)\n401\tAK.PARCALAR[:] = [p_ for p_ in AK.PARCALAR if p_[\"ad\"] != \"a_govde_ust_omega\"]; _v34_ac(AK.PARCALAR, \"a_govde_ust\")   # v3.4 · A tek temiz kutu\n402\t_dis_birim(AK, \"GERCEK_ACICI\", \"h3_acici_v1.py\", \"hat/press.html\")\n403\timport h3_ust_depo_v2 as UD                                                             # v2 · ÜST DEPO (U): A · fırın · K + E üstünde 1862–2200, içecek yedeği + fırın bacası\n404\tUD.kur()\n405\t_v34_ac(UD.PARCALAR, \"ust_a_taban_sac\")                                          # v3.4 · U_A rafı kalktı (A ile tek kutu)\n406\t_dis_birim(UD, \"GERCEK_UST\", \"h3_ust_depo_v2.py\", \"hat/makine_v3.html\")\n407\timport h3_elektrik_v1 as EL, h3_duzeltme_v1 as DZM                                 # v3.2 · elektrik tesisatı (önbellek h3/_elk) + havada kalan parçaların montajı\n408\tEL.yukle(); DZM.kur()\n409\t_dis_birim(EL, \"GERCEK_ELEKTRIK\", \"h3_elektrik_v1.py\", \"hat/makine_v3.html\")\n410\t_dis_birim(DZM, \"GERCEK_DUZELTME\", \"h3_duzeltme_v1.py\", \"hat/makine_v3.html\")\n411\t_ELK_ONEK = {\"TC\": (\"TOPPING_MODUL\",), \"TU\": (\"TOPPING\",), \"KS\": (\"K_\",), \"KC\": (\"E_\",), \"SC\": (\"B_\", \"CEK_\"), \"FU\": (\"F_\",), \"UD\": (\"U_\",),\n412\t             \"QR\": (\"QR_\",), \"RE\": (\"ROBOT\", \"ZEMIN\"), \"AK\": (\"A_\",), \"FT\": (\"F_TP10\",), \"KD\": (\"KAIDE_\",)}                          # modül → montaj birim öneki (delikler dünya kesicisi)\n413\t_ELK_DELIK = {}\n414\tfor _m32, _a32, _k32, _n32 in EL.DELIKLER: _ELK_DELIK.setdefault(_a32, []).append((_ELK_ONEK[_m32], _k32))\n415\t_ELK_DUS = set(_a32 for _m32, _a32 in EL.DUSUR) | {\"servis_kapagi_alt\", \"servis_mentesesi_0\"}\n416\t_ELK_KESILEN = set()\n417\t\n418\t# ============================ v57 · ALÇAK HAT (v35 TABAN HIZASI'nın yerine) ============================\n419\t# Kemal 27 Eyl (ALCAK_HAT_RESIM1_v4): TEK DÜZ ÇİZGİ 788 — çekmeceli dolabın üstü = A/C kabin tabanı = fırın gövdesinin altı (basamak yok).\n420\t# A/C mekanizmaları kaide 104 üstünde (892) · K istasyon tabanı 892 · E (kutu katlama) KESİLMEZ: yerden 1862'ye tek parça.\n421\t# SÜREÇ: disk 1000 > fırın bandı 998 > kesme plakası 996 > kutu ağzı ~981 — ürün hep aşağı iner.\n422\t# F TABAN DOLABI KALKTI (yeri dolabın K5, K6 ve şeridi) · temizlik → tezgâh · deterjan → K altı · robot kontrol / ana pano / UPS → QR dolabı · içecek yedeği → E altı.\n423\t\n424\t# --- D · (paftada F) KONVEYOR FIRIN · fırın üstü raf (1305–1348) ---\n425\tPIZZA_UST_KUTU = 320                                                                     # fırın üstü raftaki pizza kutusu yedeği (kural 5.5)\n426\timport h3_firin_ust_v1 as FU                                                     # v63: fırın üstü kabin (yanlar + üst + tek parça arka + düşer kapaklar) + davlumbaz sac kutusu + kompresör tavası\n427\tFU.kur()\n428\t_dis_birim(FU, \"GERCEK_FIRIN_UST\", \"firin_ust_kabin_cad_v1.py\", \"hat/oven.html\")\n429\tbirim(\"D_PIZZA_YEDEK_UST\", \"Pizza kutusu yedeği · TEK YER: fırın üstü SOL, rafta %d kutu düz (804 × 404 × 512) · E şarjörü 462 + %d = 782 ≈ 2,8 gün (SPEC · şarjörün kullanılabilir kısmı ≈ 432 → 752, karar Kemal'de) (Kemal 27 Eyl: sola koy)\" % (PIZZA_UST_KUTU, PIZZA_UST_KUTU), \"D\", \"KUTU\",\n430\t      (X_D + 20.0, X_D + 824.0), (FT.UST_RAF_Y[1], FT.UST_RAF_Y[1] + 512.0), (-424.0, -20.0), \"karton\", \"v48 · kural 5.5 · v57 raf 1348\")\n431\tFT.kur(ayak=False, plaka=False, uyarla=True)\n432\tfor _p63 in FT.PARCALAR:                                                               # v63: fırın ön kabuğu ön saclarla aynı ton (SPEC: tek ön malzeme)\n433\t    if _p63[\"ad\"] == \"govde_kabugu\": _p63[\"mal\"] = \"sac\"\n434\tfor _k, _a in FT.BIRIMLER:\n435\t    _bb = [FT.dunya(_p).BoundingBox() for _p in FT.PARCALAR if _p[\"birim\"] == _k]\n436\t    birim(_k, _a, \"D\", \"GERCEK_FIRIN\", (min(q.xmin for q in _bb), max(q.xmax for q in _bb)), (min(q.ymin for q in _bb), max(q.ymax for q in _bb)),\n437\t          (min(q.zmin for q in _bb), max(q.zmax for q in _bb)), \"sac\", \"firin_tp10_cad_v10.py\", \"hat/oven.html\")\n438\t# ---- v70: aktarma iticisi KALKTI (bantlı tabla: kaset bandı pideyi yükleme bandına verir) ----\n439\t\n440\t# --- K · KESME + SPREY (v45: GERÇEK üretim modeli kesme_cad_v1 — işlevsel birimlere ayrılır) ---\n441\timport h3_kesme_v1 as KS                                  # v58: deterjan + parlatıcı kanisterleri, rafı ve dozaj hortumları KALKTI (Kemal: \"şimdilik sil\") · kutu_cad_v8'yı içe alır · v57: alçak hat (taban 892, bant 996, üst 1862) + bulaşık yeri · v54: tank + pano yukarıda\n442\tKS.modul()\n443\tfor _fad, _fkes, _fnot in KS.F_DUVAR_DELIKLERI:                                             # v3 · yağ emiş / dönüş hortumu fırın üstü kabinin sağ yan sacından K'ya geçer\n444\t    _fp = [p_ for p_ in FU.PARCALAR if p_[\"ad\"] == _fad]; assert len(_fp) == 1, _fad\n445\t    _fp[0][\"wp\"] = cq.Workplane(obj=FU.dunya(_fp[0]).cut(_fkes))\n446\tK_BIRIM = [                                                  # v87: kesme_cad_v11 (Codex K400 v7 üstüne üretim modeli) adlarıyla\n447\t    (\"K_GOVDE\", \"KESME istasyonu gövdesi K400 (v3: ALT DOLAP YOK — dolabın teknik sütunu üstünde): 304 kabuk · köşe dikmeleri · taban 788 · istasyon tabanı 892 · ön alt bant sacı + 2 ön kapak (tava 20, ön düzlem +79)\",\n448\t     (\"ayak_\", \"taban_sac\", \"taban_hortum_rakoru\", \"plint_on\", \"istasyon_tabani\", \"arka_sac\", \"ust_sac\", \"sol_sac\", \"sag_sac\", \"kose_dikmesi\", \"onyuz_\")),\n449\t    (\"K_BANT\", \"K bandı: Interroll RollerDrive EC5000 ø50 IP66 24 V 49:1 (0,02–0,37 m/s) + avara ø50 · Habasit CD.F20-A-UW 2 mm beyaz TPU 380 · UHMW kayma tablası · POM çitler (36 mm içeri) · 2 çift Omron E3Z-T61 ışın · ölü plaka\",\n450\t     (\"bant_\", \"kayma_tablasi\", \"tahrik_rulosu\", \"avara_\", \"olu_plaka\", \"cit_\", \"urun_sensoru_\")),\n451\t    (\"K_KESICI\", \"Kesici: Festo DGRF-C-GF-63-125-PPV-A-R (6 bar 1870 N · 16,5 mm bağlantı plakası arka kirişe) · yıldız bıçak Ø296 × 6 · koruma halkası (v88: sprey kafadan alındı)\",\n452\t     (\"kopru_kirisi\", \"DGRF\", \"kafa_adaptoru\", \"ara_dikme\", \"kafa_plakasi\", \"bicak_\", \"koruma_\", \"kelebek_\")),\n453\t    (\"K_YAG\", \"SIVI YAĞ sistemi (v89 · v3 yerleşim): Spraying Systems gıda PulsaJet AAB10000AUH-104210-VIFC + TPU11002 PWMD ÜRÜN GİRİŞİNDE SABİT (ısıtıcı yok) · FIRIN ÜSTÜNDE sağda standart 18 L yağ tenekesi \"\n454\t     \"TARTIDA (HBM PW15AH 50 kg · kalan yağ ekranda) · ProMinent 1038304 emme borusu (seviye şalterli) · 10 µm filtre → Micropump GJ-N21 + EagleDrive → ifm PM1704 → Swagelok KBP (≈ 3,1 bar, fazlası tenekeye) · \"\n455\t     \"SMC PFA 10 × 8 hortum sağdan nozüle · damlama tavası · v3: pompa grubu K'nın üst önünde, emiş / dönüş F|K duvarından (y 1828)\",\n456\t     (\"yag_\", \"PulsaJet\", \"nozul_\", \"taban_hortum_gecisi\")),\n457\t    (\"K_ITICI\", \"İtici: SMC MY1B10G-250 (X) + MY1B10G-350 (Z) rodless · MY-J10 yüzer bağlantı · HIWIN MGN15 · 2 × RB0805 şok emici · X arabası 4,7 kg (6082) · Z 2,92 s / X 1,67 s (katalog tampon sınırı)\",\n458\t     (\"itici_\", \"eksen_ayagi\")),\n459\t    (\"K_ELEKTRIK\", \"Pano (arka üst): Siemens S7-1200 1214C + SIWAREX WP231 tartı modülü · Mean Well NDR-240-24 · SMC SS5Y3-20-04 + 3 × SY3120 · AW20-F02-A şartlandırıcı · hortumlar (v89: E5DC / SSR kalktı — ısıtma yok)\",\n460\t     (\"pano_\", \"din_rayi\", \"plc_\", \"sicaklik\", \"SSR_\", \"sigorta_\", \"guc_\", \"klemens\", \"sartlandirici\", \"valf_\", \"hava_\")),\n461\t]\n462\tK_HARIC_GRUP = (\"URUN\", \"URUN_IZ\", \"REF\", \"SPREY\")          # ürün, sprey konisi ve komşu referansları montaja girmez\n463\tK_PARCA = {k: [] for k, _a, _o in K_BIRIM}\n464\tfor _p in KS.PARCALAR:\n465\t    if _p[\"grup\"] in K_HARIC_GRUP:\n466\t        continue\n467\t    for _k, _a, _o in K_BIRIM:\n468\t        if _p[\"ad\"].startswith(_o):\n469\t            K_PARCA[_k].append(_p); break\n470\t    else:\n471\t        raise AssertionError(\"kesme_cad_v11 parcasi birimsiz kaldi: \" + _p[\"ad\"])\n472\tfor _k, _a, _o in K_BIRIM:\n473\t    _bb = [q[\"wp\"].val().BoundingBox() for q in K_PARCA[_k] if not q[\"ad\"].endswith(\"_kulp\") and q[\"ad\"] != \"acil_stop\"]\n474\t    birim(_k, _a, \"K\", \"GERCEK_KESME\", (X_K + min(q.xmin for q in _bb), X_K + max(q.xmax for q in _bb)), (min(q.ymin for q in _bb), max(q.ymax for q in _bb)),\n475\t          (min(q.zmin for q in _bb), max(q.zmax for q in _bb)), \"sac\", \"kesme_cad_v11.py\", \"hat/kesme.html\")\n476\t\n477\t# K400: Kemal onayıyla bulaşık ana montajdan kaldırıldı.\n478\tBM.PARCALAR.clear()\n479\tBM_KOD = {}\n480\t\n481\t# --- E · KUTU KATLAMA (TEK PARCA, kesilmez) ---\n482\t# --- E · KUTU KATLAMA MODÜLÜ (v38: GERÇEK üretim modeli kutu_cad_v2 — işlevsel birimlere ayrılır) ---\n483\timport kutu_cad_v12 as _KC12_saat                            # v88: E v13 kinematiği v12 ile aynı mı (K v9 → K v8 → E v12 saat bağı)\n484\timport h3_kutu_v1 as KC                                  # v58: içecek yedeğinin ÖNÜ AÇIK (ön alt sac kalktı · Kemal: ön taraflara kapak yok) · v57: alçak hat (tepsi 936, alt raf 618–622, şarjör 462) + içecek yedeği 6 koli · v54: kalıp ayakları alt rafta\n485\tKC.modul()\n486\tfor _kad, _kes, _knot in KC.K_DUVAR_DELIKLERI:                                             # v2 · B'nin yoğuşma suyu gideri K'nın iki yan sacından geçer (h3_kutu_v1)\n487\t    _kp = [p_ for p_ in KS.PARCALAR if p_[\"ad\"] == _kad]; assert len(_kp) == 1, _kad\n488\t    _kp[0][\"wp\"] = cq.Workplane(obj=_kp[0][\"wp\"].val().cut(_kes.val() if hasattr(_kes, \"val\") else _kes))\n489\tassert (KC.DONGU_GERCEK, KC.E_HAZIR_GERCEK, tuple(KC.Z_CATAL_GERCEK)) == (_KC12_saat.DONGU_GERCEK, _KC12_saat.E_HAZIR_GERCEK, tuple(_KC12_saat.Z_CATAL_GERCEK)), \\\n490\t    \"v88/v90: E v14 saati v12'den farkli (K v9 saat bagi v12'ye kurulu)\"\n491\t_ION = KC.icecek_on_olcum()                                   # v58: içecek yedeğinin önü (kutu_cad_v8 katılardan ölçer: öndeki engeller · net açıklık · sütunların düz çekme yolu)\n492\tassert KC.ICECEK_YEDEK[\"kutu\"] == 0, \"v2: E altinda icecek yedegi kalmamali (ust depoya cikti)\"   # v2 · içecek yedeği U'da\n493\tE_BIRIM = [\n494\t    (\"E_KOSE\", \"4 motorlu köşe katlayıcı + ortak kaldırma: katlama 38 / geri dönüş 60 mm; kinematik prototip\", (\"kose_takim_\", \"kose_CNR_\")),\n495\t    (\"E_GOVDE\", \"KUTU modülü gövdesi: 304 kabuk (saydam) · ayaklar · taban · şarjör yan kapısı · ön çerçeve + kapaklar · alt önü AÇIK (v58: ön alt sac kalktı) · v90: ağız üst kirişi kalktı\", (\"ayak_\", \"taban_sac\", \"plint_on\", \"arka_sac\", \"ust_sac\", \"sol_sac\", \"sag_sac\", \"sarjor_yan_kapisi\", \"on_ust_kapak\", \"kose_dikme_\", \"onyuz_\")),   # v63: ön çerçeve + kapaklar\n496\t    (\"E_SARJOR\", \"Şarjör + asansör: motor taban ÜSTÜNDE; 462 geometrik / en çok 419 beslenebilir (ray hareket sınırı; son 43 kalır). Sağ dolum için en az 804 mm yan boşluk; menteşe açılması doğrulanmadı. Tr16×4 · NEMA23 · 2:1 GT3\", (\"kilavuz_\", \"sarjor_kapi_esigi\", \"karton_yigini\", \"asansor_\")),\n497\t    (\"E_BESLEYICI\", \"Vakumlu alma/bırakma (v88 gerçek parça): SMC CDQ2B16-20DZ · 4 × ZP3C-T32CFS-MF-A8 (karton için) · ZK2G15K5RWA-08 vakum ünitesi · 411 mm ray\", (\"besleyici_\", \"itici_\", \"vakum_\")),\n498\t    (\"E_KALIP\", \"Kılavuzlu motorlu destek tablası: katlama boyunca tabana temas; son kot 936 korunur\", (\"kalip_\", \"tepsi_\", \"destek_\")),\n499\t    (\"E_KOPRU\", \"Pizza köprüsü: katlamada 30 mm aşağıda · SFU1605 + NEMA 23 + 2 LM12UU\", (\"kopru_\",)),\n500\t    (\"E_PISTON\", \"Piston: 296 × 296 kafa · SFU1610 (üstten BK12) · 2 HGR15 · FRENLİ motor Oriental PKP268D28M2 (0,8 N·m · kafa düşmez) · taban / kilit / kapak\", (\"piston_\",)),\n501\t    (\"E_PARMAK\", \"Ön çift duvar: baskı kafası üzerinde 180° katlayıcı, 1:1 kayış, çift yatak, dışa park; kartona pozitif temas\", (\"devirme_parmagi\", \"parmak_\")),\n502\t    (\"E_KAPAK\", \"Kapak masası + U flap katlayıcı (SFU1605) + kapak kolu (NEMA 23 + SureGear 10:1)\", (\"kapak_\", \"flap_\", \"kol_\")),\n503\t    (\"E_ELEKTRIK\", \"Pano (v88): S7-1200 1214C + SM1221 + SM1222 (istasyon denetçisi) · Beckhoff CX9240 + EL6631-0010 PROFINET + 7 × EL7062 (13 step ekseni) · Mean Well 24/48 V · sensörler\",\n504\t     (\"pano_\", \"din_rayi\", \"plc_\", \"guc_\", \"surucu_\", \"klemens_\", \"kablo_kanali\", \"sensor_\", \"beckhoff_\")),\n505\t    (\"E_KUTU\", \"Pizza kutusu 32 × 32 × 4,2 E-dalga: düz açılım 804 × 404 → katlanır (menteşeli paneller)\", (\"B_\",)),\n506\t    (\"E_PIZZA\", \"Pizza Ø300 (K plakasından kutuya kayar)\", (\"pizza_\",)),\n507\t    (\"E_ICECEK_YEDEK\", \"İçecek yedeği 6 koli (2 sütun × 3 kat · koli 400 × 267 × 123 · 24 kutu) = 144 · E altı önde, soğutmasız · dolaptaki 144 + 144 = 288 (4 gün 277) · ÖNÜ AÇIK (v58 · Kemal: ön taraflara kapak yok — ön alt sac kalktı) · önde yalnız sol ön dikme + dikey kablo kanalı, net açıklık %.1f: tek koli düz geçer; dikme sol sütunun önüne %.1f mm, kanal sağ sütunun önüne %.1f mm yandan biner → koli yana kaydırılıp çekilir\"\n508\t     % (_ION[\"net\"][1] - _ION[\"net\"][0], _ION[\"sutun\"][0][\"bindirme\"], _ION[\"sutun\"][1][\"bindirme\"]), (\"icecek_\",)),\n509\t]\n510\tE_BIRIM = [e_ for e_ in E_BIRIM if e_[0] != \"E_ICECEK_YEDEK\"]                                  # v2 · içecek yedeği E'den ÇIKTI (üst depoda U_ICECEK_YEDEK)\n511\tE_BIRIM += [(k_, a_, KC.E_ALT_ONEK[k_]) for k_, a_, _o in KC.E_ALT_BIRIM]                  # v3 · robot çöpü E'nin sol altında (E_COP)\n512\tE_HARIC = (\"robot_catal_\", \"robot_flansi\", \"REF_K_\")          # robotun çatalı (R'nin aleti) ve K referansı montaja girmez\n513\tE_PARCA = {k: [] for k, _a, _o in E_BIRIM}\n514\tfor _p in KC.PARCALAR:\n515\t    if _p[\"ad\"].startswith(E_HARIC):\n516\t        continue\n517\t    for _k, _a, _o in E_BIRIM:\n518\t        if _p[\"ad\"].startswith(_o):\n519\t            E_PARCA[_k].append(_p); break\n520\t    else:\n521\t        raise AssertionError(\"kutu_cad_v8 parcasi birimsiz kaldi: \" + _p[\"ad\"])\n522\t_W0 = KC.blank_dunya(0.0)\n523\tfor _k, _a, _o in E_BIRIM:\n524\t    _bb = []\n525\t    for _p in E_PARCA[_k]:\n526\t        if \"_kulp\" in _p[\"ad\"]:\n527\t            continue                                            # kapı tutamakları zarfın 18–22 mm dışına çıkar (tutamak)\n528\t        _sh = _p[\"wp\"].val()\n529\t        if _p[\"grup\"].startswith(\"B_\"):\n530\t            _sh = KC.uygula(_sh, _W0[_p[\"grup\"]])\n531\t        else:\n532\t            _sh = KC.uygula(_sh, KC.grup_matrisi(_p[\"grup\"],0))\n533\t        _bb.append(_sh.BoundingBox())\n534\t    _x = (X_E + min(q.xmin for q in _bb), X_E + max(q.xmax for q in _bb)); _y = (min(q.ymin for q in _bb), max(q.ymax for q in _bb))\n535\t    _z = (min(q.zmin for q in _bb), max(q.zmax for q in _bb))\n536\t    birim(_k, _a, \"E\", \"GERCEK_KUTU\", _x, _y, _z, \"sac\", \"kutu_cad_v14.py\", \"hat/pack.html\")\n537\t\n538\t# --- ROBOT (tek FR5, yer rayinda) + QR DOLABI (hattin onunde, z > 0) ---\n539\tbirim(\"ROBOT_RAY\", \"Yer rayı · tek araba · x %.1f–%.0f (v3: sol ucu A ile 736 kısaldı)\" % HS.ROBOT_RAY_X, \"-\", \"KATALOG\", HS.ROBOT_RAY_X, (0.0, 60.0), (RZ - 120.0, RZ + 120.0), \"katalog\", \"pafta v7\")\n540\tbirim(\"ROBOT_1\", \"Fairino FR5 · tek robot (pafta konumu x %.0f)\" % RX, \"-\", \"KATALOG\", (RX - 90.0, RX + 90.0), (60.0, KAIDE), (RZ - 90.0, RZ + 90.0), \"robot\", \"katalog · kaide + araba\")\n541\tbirim(\"ROBOT_1_KOL\", \"FR5 omuz + kol zarfı (erişim %.0f)\" % ERISIM, \"-\", \"KATALOG\", (RX - 120.0, RX + 120.0), (KAIDE, OMUZ + 180.0), (RZ - 120.0, RZ + 120.0), \"robot\", \"yalnız ZARF · gerçek kol modeli yok\")\n542\t# ---- v57 · yeni üreteçlerin (kaide · ray ekleri · QR · tezgâh) malzemeleri — store_cad_v14 / kesme_cad_v11 / kutu_cad_v8'dan SONRA kaydedilir:\n543\t#      montajda önce olan ad kendi rengini korur (ortak adlar: plastik · sensor · poset — önce kaydedilince dolap / E / K parçalarının rengi değişiyordu, inceleme)\n544\tfor _M in (KD, RE, QR, TZ, EL, DZM):\n545\t    for _k, _v in _M.MALZEME.items():\n546\t        MALZEME.setdefault(_k, dict(renk=_v[\"renk\"], met=_v[\"met\"], ruf=_v[\"ruf\"], saydam=_v.get(\"saydam\", False)))\n547\t# ---- v57 · RAY EKLERİ (ray_ek_cad_v1, modül \"-\"): zincir oluğu · enerji zinciri (yalnız robot x 2650 için modellendi → animasyonda SABİT) · robot kablosu 4 + 11 m · zemin kanalı ----\n548\tRE.kur()\n549\t_dis_birim(RE, \"GERCEK_RAY\", \"h3_ray_ek_v2.py\", \"hat/robot.html\")\n550\t# ---- v57 · MODÜL S · SERVİS / TESLİM (koridorun karşısında): QR teslim dolabı (qr_cad_v1) + personel tezgâhı (tezgah_cad_v2) ----\n551\t# pafta v7 QR yer tutucusu (x 4295–5300, z 900–1340) ve F dolabındaki robot kontrol / ana pano / UPS / temizlik kalktı → hepsi burada.\n552\t# DİKKAT (denetçi): QR.X0/Y0/Z0 DEĞİŞTİRİLMEZ — ray_ek_cad_v1 kablo yolunu import anında onlardan hesaplıyor.\n553\tQR.kur()\n554\tQR.PARCALAR[:] = [p_ for p_ in QR.PARCALAR if p_[\"ad\"] not in _ELK_DUS]                           # v3.2 · ana pano yükseltildi (h3_elk_qr_v1)\n555\tQR.BIRIMLER[:] = [(k_, a_) for k_, a_ in QR.BIRIMLER if any(p_[\"birim\"] == k_ for p_ in QR.PARCALAR)]\n556\t_dis_birim(QR, \"GERCEK_QR\", \"qr_cad_v1.py\", \"hat/service.html\")\n557\tTZ.kur()\n558\t_dis_birim(TZ, \"GERCEK_TEZGAH\", \"tezgah_cad_v2.py\", \"hat/service.html\")\n559\t# ---- v61 · ÖN KAPAKLAR ŞEFFAF (Kemal: \"ön kapakları şeffaf yap, çekmeceleri de\") — yalnız görünüm, parça ve denetim aynı\n560\timport re as _re61\n561\tMALZEME[\"on_seffaf\"] = dict(renk=(0.70, 0.82, 0.95, 0.16), met=0.1, ruf=0.15, saydam=True)\n562\tON_SEFFAF = _re61.compile(r\"^(onyuz_|CEK_K\\d_[a-z0-9]+_\\d+_on_(dis_sac|pu|ic_sac|fitil)|k4_kapak_|k4_izgara_|serit_on_|klape_levhasi$|servis_kapagi_|\"\n563\t                          r\"musteri_(alt|ust)_panel$|goz_\\d\\d_musteri_kapisi$|on_kapak$|cekmece_onu$|on_ust_kapak$)\")\n564\t# v91 · ÇERÇEVE SAYDAM DEĞİL (Kemal: TOPPING'de \"bu ne havada uçuyor\" = mekanizma bandının ön çerçevesi) — \"onyuz_\" adlı çerçeve / dikme / kayıt / kuşak / plint /\n565\t#       dayama dudağı / lama / menteşe tabanı / kılavuz / emniyet sensörü / ışık perdesi opak kalır; yalnız kapak kanadı, paneli ve kanada bağlı donanım saydam.\n566\t#       v91 · E şarjör yan kapısı listeden çıktı (Kemal: \"kırmızı seçtiğim dış gövdeyle aynı olmalı\" — saydam kapıdan içerideki kılavuz taşıyıcı şerit gibi görünüyordu)\n567\tON_CERCEVE = _re61.compile(r\"(cerceve(?!_saci)|dikme|kayit|kusak|plint|dayama|lama|mentese_tabani|kilavuz|emniyet_sensoru|isik_perdesi|mentese_\\d+_sabit|mentese_sabit|mentese_\\d+_taban|basac(?!_K\\d)|panel_tutucu)\")   # v92: gövdedeki menteşe yarısı, basmalı kilit, panel tutucusu da opak · TOPPING soğuk dolap K1/K2 kilidi saydam yüz sacına bağlı, kapakla saydam kalır   # yüz sacı (çerçeve SACI) saydam kalır: B çekmeceleri görünsün\n568\t\n569\t\n570\tdef _seffaf_mi(ad):\n571\t    return bool(ON_SEFFAF.match(ad)) and not ON_CERCEVE.search(ad)\n572\t\n573\t\n574\t\n575\t_ON61 = {}\n576\tfor _ad61, _L61 in ((\"B\", SC.PARCALAR), (\"QR\", QR.PARCALAR), (\"TEZGAH\", TZ.PARCALAR), (\"E\", KC.PARCALAR), (\"K\", KS.PARCALAR), (\"A\", AK.PARCALAR), (\"D\", FU.PARCALAR), (\"BULASIK\", BM.PARCALAR), (\"TU\", TU.P), (\"U\", UD.PARCALAR)):\n577\t    for _p61 in _L61:\n578\t        if _seffaf_mi(_p61[\"ad\"]):\n579\t            _p61[\"mal\"] = \"on_seffaf\"; _ON61[_ad61] = _ON61.get(_ad61, 0) + 1"}]},"uuid":"e38ffaac-b7ed-444d-9366-d4441bf3b936","timestamp":"2026-10-01T19:03:18.814Z","sourceToolAssistantUUID":"8e23fa78-86d9-45c7-85a8-f56467c34b00","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
