                               # v87: rulo düğümünün yeri sabit\n2162\t                out = [V[0]] * len(TT2)\n2163\t            elif g_ == \"surekli\":                                                        # v87: bant hiç durmaz · 2. ürünün yükleme bandı atılımı D sonra\n2164\t                r_, tip_ = SUREKLI[ad]\n2165\t                for t in TT2:\n2166\t                    b_ = Z[\"FIRIN_V\"] * t\n2167\t                    if tip_ == \"GB\":\n2168\t                        for d_ in (0.0, D):\n2169\t                            b_ += Z[\"EK_Y\"] * min(1.0, max(0.0, (t - d_ - Z[\"T_B0\"]) / (Z[\"T_B1\"] - Z[\"T_B0\"])))\n2170\t                    a_ = -b_ / r_\n2171\t                    out.append(_np.array([0.0, 0.0, _m.sin(a_ / 2.0), _m.cos(a_ / 2.0)]))\n2172\t            elif g_ in (\"e\", \"urun1\"):\n2173\t                out = [samp(V, t if t < T_H1 else (T_H1 if t < T_H1 + D else t - D), yol) for t in TT2]\n2174\t            else:\n2175\t                continue\n2176\t            yeni.append((ad, TT2, [tuple(float(c) for c in v_) for v_ in out], yol))\n2177\t        src = {(ad, yol): V for ad, yol, V in ch}\n2178\t        for l2 in L2_ADLAR:\n2179\t            for yol in (\"translation\", \"rotation\", \"scale\"):\n2180\t                V = src[(\"URUN__\" + l2, yol)]; out = []\n2181\t                for t in TT2:\n2182\t                    if t < D:\n2183\t                        out.append(_np.array([1e-4] * 3) if yol == \"scale\" else V[0])\n2184\t                    else:\n2185\t                        v_ = samp(V, t - D, yol).copy()\n2186\t                        if yol == \"translation\" and t - D >= T_H1 - 2.0: v_[1] += 0.003     # 2. lahmacun kutuda 1.'nin 3 mm üstünde\n2187\t                        out.append(v_)\n2188\t                yeni.append((\"URUN__L2_\" + l2, TT2, [tuple(float(c) for c in v_) for v_ in out], yol))\n2189\t        print(\"   v66 · IKI LAHMACUN uyari %d%s\" % (len(uyari), (\": \" + \" | \".join(uyari[:6])) if uyari else \"\"))\n2190\t        assert not [u_ for u_ in uyari if \"basliyor\" in u_], \"v66: iki cevrim ust uste biniyor: %s\" % uyari[:3]\n2191\t        return yeni, D, T2\n2192\t    def iki_adim(adim, D):\n2193\t        a1, a2 = [], []\n2194\t        for a in adim:\n2195\t            if a[\"ad\"] in (\"ROBOT → QR\", \"QR DOLABI\"):\n2196\t                a2.append(dict(t=round(a[\"t\"] + D, 2), ad=a[\"ad\"], not_=a[\"not_\"])); continue\n2197\t            n1 = n2 = a[\"not_\"]\n2198\t            if a[\"ad\"] == \"KUTU\":\n2199\t                n1 = \"1. lahmacun katlanmış kutuya girer; kutunun kapağı AÇIK kalır, kutu makinesi 2. lahmacunu bekler.\"\n2200\t                n2 = \"2. lahmacun ilkinin üstüne girer; kol + piston kapağı kapatıp bastırır. Kutuda 2 lahmacun.\"\n2201\t            if a[\"ad\"] == \"ÇEKMECE\":\n2202\t                n2 = \"Robot 2. lahmacun topunu aynı çekmeceden alır (tabla açıcıya dönmüş).\"\n2203\t            a1.append(dict(t=a[\"t\"], ad=a[\"ad\"] + \" (1)\", not_=n1)); a2.append(dict(t=round(a[\"t\"] + D, 2), ad=a[\"ad\"] + \" (2)\", not_=n2))\n2204\t        return sorted(a1 + a2, key=lambda x_: x_[\"t\"])\n2205\t    for _n, (_nm, _A) in enumerate(ANIM_SIP):\n2206\t        if _nm == \"siparis_lahmacun\":\n2207\t            _A2, _D, _T2 = iki_lahmacun(_A, LAH_Z)\n2208\t            ANIM_SIP[_n] = (_nm, _A2)\n2209\t            _sd = [s_ for s_ in SIP_DURUM if s_[\"kod\"] == \"lahmacun\"][0]\n2210\t            _sd[\"adim\"] = iki_adim(_sd[\"adim\"], _D); _sd[\"sure\"] = _T2; _sd[\"ad\"] = \"Lahmacun (2 adet)\"\n2211\t        else:\n2212\t            _TT = _A[0][1]\n2213\t            _h0 = [a_ for a_ in _A if a_[0] == \"URUN__hamur\" and (a_[3] if len(a_) > 3 else \"translation\") == \"translation\"][0][2][0]\n2214\t            for _ad in L2_ADLAR:\n2215\t                _A.append((\"URUN__L2_\" + _ad, _TT, [_h0] * len(_TT), \"translation\"))\n2216\t                _A.append((\"URUN__L2_\" + _ad, _TT, [(0.0, 0.0, 0.0, 1.0)] * len(_TT), \"rotation\"))\n2217\t                _A.append((\"URUN__L2_\" + _ad, _TT, [(1e-4,) * 3] * len(_TT), \"scale\"))\n2218\t    assert len(set(tuple(sorted((k_[0], k_[3] if len(k_) > 3 else 'translation') for k_ in a_)) for _n, a_ in ANIM_SIP)) == 1, \"v65: siparis animasyonlarinin dugum kumesi ayni olmali\"\n2219\t    print(\"ANA MONTAJ ANIMASYONU (v58): tek tam dongu %.0f sn · %d kanal · %d adim · %d eksenli doner dugum\" % (T_J, len(ANIM_HAT), len(ADIM_HAT), len(OZEL_T)))\n2220\t    print(\"SAPMA DENETIMI (kareler arasi, glTF ara degerleme <-> tam kinematik): en kotu 15 / %d dugum\" % len(SAPMA))\n2221\t    for e_, t_, a_ in SAPMA[:15]: print(\"   %8.2f mm  t=%6.2f  %s\" % (e_, t_, a_))\n2222\t    _kotu = [r for r in SAPMA if r[2].startswith(\"TOPPING_DONER__\") and r[0] > 3.0]   # 3 mm: spiral sonundaki x hızı sıçraması (eksen değil)\n2223\t    assert not _kotu, \"TOPPING donen dugumu ekseninden kayiyor: %s\" % _kotu[:3]\n2224\t    _kotu = [r for r in SAPMA if r[2].startswith(\"F_DONER__\") and r[0] > 3.0]\n2225\t    assert not _kotu, \"firin / giris bandi rulosu ekseninden kayiyor: %s\" % _kotu[:3]\n2226\t\n2227\t    # ================= v48 · FIRIN DENETİMİ: gerçek katı kesişimi (mm³) + ürün yolu taraması =================\n2228\t    def _hacim(a_, b_):\n2229\t        try: return a_.intersect(b_).Volume()\n2230\t        except Exception: return -1.0\n2231\t    def _bbk(a_, b_):\n2232\t        A_, B_ = a_.BoundingBox(), b_.BoundingBox()\n2233\t        return A_.xmin < B_.xmax and B_.xmin < A_.xmax and A_.ymin < B_.ymax and B_.ymin < A_.ymax and A_.zmin < B_.zmax and B_.zmin < A_.zmax\n2234\t    def _tek(wp):\n2235\t        v = wp.vals() if hasattr(wp, \"vals\") else [wp]\n2236\t        return v[0] if len(v) == 1 else cq.Compound.makeCompound([o for o in v if isinstance(o, cq.Shape)])\n2237\t    _F = [(p[\"birim\"] + \":\" + p[\"ad\"], FT.dunya(p)) for p in FT.PARCALAR]\n2238\t    _DG = []\n2239\t    TC.PARCALAR[:] = []; TC.modul()\n2240\t    for p in TC.PARCALAR:\n2241\t        if p[\"ad\"].startswith(\"_bom\") or p[\"ad\"] in KAPAK or p[\"ad\"] in AKTARMA_TP10 or not v1_kalir(p[\"ad\"]):\n2242\t            continue\n2243\t        _d = V1_TASI.get(p[\"ad\"], (0.0, 0.0, 0.0))\n2244\t        sh = p[\"wp\"].val().translate(cq.Vector(X_BC + _d[0], Y_MEK + _d[1], _d[2]))\n2245\t        if p[\"ad\"] == \"cikis_yarigi_contasi\": sh = YARIK_V2\n2246\t        if sh.BoundingBox().xmax > 2440.0: _DG.append((\"TOPPING:\" + p[\"ad\"], sh))\n2247\t    _TABLA = [p for p in TC.PARCALAR if grup_modul(p[\"ad\"]) == \"TABLA\"]\n2248\t    for p in _TABLA:                                                                     # tabla AKTARMA KONUMUNDA (dinamik)\n2249\t        _DG.append((\"TOPPING(aktarmada):\" + p[\"ad\"], p[\"wp\"].val().translate(cq.Vector(X_BC + TH.X_AKTARMA - TC.XC_TABLA, Y_MEK, 0.0))))\n2250\t    for q in TU.P:\n2251\t        if q[\"ad\"].startswith(V3_CIKAN): continue\n2252\t        sh = q[\"sh\"].translate(cq.Vector(X_BC, 0.0, 0.0))\n2253\t        if sh.BoundingBox().xmax > 2440.0: _DG.append((\"TOPPING2:\" + q[\"ad\"], sh))\n2254\t    for p in KS.PARCALAR:\n2255\t        if p[\"grup\"] in K_HARIC_GRUP: continue\n2256\t        sh = _tek(p[\"wp\"]).translate(cq.Vector(X_K, 0.0, 0.0))\n2257\t        if sh.BoundingBox().xmin < 4330.0: _DG.append((\"K:\" + p[\"ad\"], sh))\n2258\t    for _rota in (ANA_V44, ANA_K48):\n2259\t        _an = TU.boru(_rota, 5.0); _an = _an.val() if hasattr(_an, \"val\") else _an\n2260\t        _DG.append((\"HAVA:ana_hat\", _an.translate(cq.Vector(X_BC, 0.0, 0.0))))\n2261\t    for q in TU.P:                                                                       # kompresör fırın üstünde (rafın üstü)\n2262\t        if q[\"ad\"].startswith(\"kompresor_\"): _DG.append((\"HAVA:\" + q[\"ad\"], q[\"sh\"].translate(cq.Vector(X_BC + KOMP_KAY[0], KOMP_KAY[1], KOMP_KAY[2]))))\n2263\t    for b in B:\n2264\t        if b[\"modul\"] == \"D\" and b[\"durum\"] in (\"KUTU\", \"KATALOG\") and not b[\"kod\"].startswith(\"D_SUPURGELIK\"):\n2265\t            _DG.append((\"D:\" + b[\"kod\"], kutu_kat(b).val()))\n2266\t    for p in BM.PARCALAR:                                                                # v53: bulaşık makinesi gerçek parçaları\n2267\t        _DG.append((\"BULASIK:\" + p[\"ad\"], BM.dunya(p)))\n2268\t    _cak = []\n2269\t    for a_, sa in _F:\n2270\t        for c_, sc in _DG:\n2271\t            if _bbk(sa, sc):\n2272\t                v_ = _hacim(sa, sc)\n2273\t                if v_ > 1.0 or v_ < 0: _cak.append((round(v_, 1), a_, c_))\n2274\t    for i_, (a_, sa) in enumerate(_F):\n2275\t        for c_, sc in _F[i_ + 1:]:\n2276\t            if _bbk(sa, sc):\n2277\t                v_ = _hacim(sa, sc)\n2278\t                if v_ > 1.0 or v_ < 0: _cak.append((round(v_, 1), a_, c_))\n2279\t    _CER = [x_ for x_ in _DG if x_[0] == \"TOPPING:cikis_yarigi_contasi\"][0]              # yeni çerçeve ↔ TOPPING (tabla aktarmada dahil)\n2280\t    for c_, sc in _DG:\n2281\t        if c_ == _CER[0] or not c_.startswith(\"TOPPING\"): continue\n2282\t        if _bbk(_CER[1], sc):\n2283\t            v_ = _hacim(_CER[1], sc)\n2284\t            if v_ > 1.0 or v_ < 0: _cak.append((round(v_, 1), _CER[0] + \"(v2)\", c_))\n2285\t    _KOMP = [x_ for x_ in _DG if x_[0].startswith(\"HAVA:kompresor\")]                     # kompresör ↔ raf üstündeki komşular (kutu yedeği kutusu, davlumbaz)\n2286\t    for a_, sa in _KOMP:\n2287\t        for c_, sc in _DG:\n2288\t            if c_.startswith(\"HAVA:\") or c_.startswith(\"D:D_DAVLUMBAZ\") is False and not c_.startswith(\"D:\"): continue\n2289\t            if _bbk(sa, sc):\n2290\t                v_ = _hacim(sa, sc)\n2291\t                if v_ > 1.0 or v_ < 0: _cak.append((round(v_, 1), a_, c_))\n2292\t    print(\"FIRIN CAKISMA (gercek kati kesisimi > 1 mm3 · TOPPING + tabla aktarmada + K + hava + kompresor + F kutulari + kendi arasinda + yeni cerceve): %s\"\n2293\t          % (\"TEMIZ\" if not _cak else \"%d BULGU\" % len(_cak)))\n2294\t    for x_ in sorted(_cak, reverse=True)[:40]: print(\"   %10.1f mm3  %s  <->  %s\" % x_)\n2295\t    _YOL = []\n2296\t    _stat = [(a_, sa) for a_, sa in _F] + [(c_, sc) for c_, sc in _DG if c_.startswith((\"K:\", \"TOPPING\"))]\n2297\t    _kz87 = {}                                                                     # v87: K400'de ürün z'si çitlerle −170 → −206 (KS.urun_merkez · GELİŞ + TAŞI)\n2298\t    for _i87 in range(0, int(KS.Z_TASI[1] * 50) + 1):\n2299\t        _x87, _y87, _z87 = KS.urun_merkez(_i87 / 50.0)\n2300\t        _xw87 = int(round(X_K + _x87))\n2301\t        _kz87[_xw87] = min(_kz87.get(_xw87, 9e9), _z87)\n2302\t    def _zk87(xw):\n2303\t        if xw < X_K - 60.0: return FT.urun_z(xw)\n2304\t        ks_ = [k_ for k_ in _kz87 if abs(k_ - xw) <= 5]\n2305\t        return min(_kz87[k_] for k_ in ks_) if ks_ else FT.urun_z(xw)\n2306\t    _kon = [(float(x_), _zk87(float(x_)), R_) for R_ in (139.5, 149.5) for x_ in range(int(math.ceil(BT.AKT)), int(X_K + 421), 10)]   # v70: kasetten · v87: K boyunca 4420'ye (bekleme yeri)\n2307\t    def _alt(xc, R_):                                                               # rijit ürün diski: ayak izinin altındaki EN YÜKSEK yüzeyin 0,5 üstü\n2308\t        if xc - R_ <= FT.YB_SON: return P + 0.5                                     # v70: arka kenar yükleme bandının sonunu (2845,3) geçene kadar kaset / yükleme bandında (ikisi de 1000)\n2309\t        if xc - R_ <= FT.BANT_X[1]: return FT.BANT_UST_HAT + 0.5\n2310\t        if xc - R_ <= FT.OLU_X[1]: return KS.BANT + 2.0\n2311\t        return KS.BANT + 0.5\n2312\t    for xc, zc, R_ in _kon:\n2313\t        y_ = _alt(xc, R_)\n2314\t        cyl = cq.Solid.makeCylinder(R_, 28.0, cq.Vector(xc, y_, zc), cq.Vector(0, 1, 0))\n2315\t        for a_, sa in _stat:\n2316\t            if _bbk(cyl, sa):\n2317\t                v_ = _hacim(cyl, sa)\n2318\t                if v_ > 5.0 or v_ < 0: _YOL.append((int(round(xc)), round(zc, 1), round(v_, 1), \"Ø%.0f %s\" % (2 * R_ + 1, a_)))\n2319\t    _n280 = len([k_ for k_ in _kon if k_[2] < 145]); _n300 = len(_kon) - _n280\n2320\t    print(\"FIRIN URUN YOLU (O280 %d konum + O300 zarf %d konum · 28 yuksek · 10 mm adim · −170 düz, K'da çitle −206: kaset (aktarma) + yarik + yukleme bandi + firin + K → 4420): %s\"\n2321\t          % (_n280, _n300, \"TEMIZ\" if not _YOL else \"%d BULGU\" % len(_YOL)))\n2322\t    for x_ in _YOL[:40]: print(\"   x %d  z %.1f  %.1f mm3  %s\" % x_)\n2323\t    # TOPPING teknesi modülün içinde mi (v24)\n2324\t    _tx = max(p[\"wp\"].val().BoundingBox().xmax for p in TC.PARCALAR if not p[\"ad\"].startswith(\"_bom\") and v1_kalir(p[\"ad\"]) and p[\"ad\"] not in AKTARMA_TP10 and grup_modul(p[\"ad\"]) not in (\"TABLA\", \"ARABA\"))\n2325\t    print(\"TOPPING SABIT PARCALARIN SAG UCU: x %.1f (dunya %.1f) · duvar 2500 → %s\" % (_tx, _tx + X_BC, \"ICERIDE\" if _tx + X_BC <= 2500.0 else \"TASIYOR\"))\n2326\t    assert _tx + X_BC <= 2500.0, \"TOPPING sabit parcasi 2500'u geciyor\"\n2327\t    FIRIN_OZET = (\"gerçek katı kesişimi %s (%d fırın/uyarlama parçası × %d komşu parça + yeni çerçeve + kompresör) · ürün yolu %s (Ø280 %d + Ø300 %d konum) · TOPPING sabit parçaları 2500'ün içinde (%.0f)\"\n2328\t                  % (\"TEMİZ\" if not _cak else \"%d BULGU\" % len(_cak), len(_F), len(_DG), \"TEMİZ\" if not _YOL else \"%d BULGU\" % len(_YOL), _n280, _n300, _tx + X_BC))\n2329\t    assert not _cak and not _YOL, \"v48: cakisma / urun yolu bulgusu var\"\n2330\t    # ================= v49 · İTİCİ DENETİMİ =================\n2331\t    _DGI = []\n2332\t    for p in TC.PARCALAR:\n2333\t        if p[\"ad\"].startswith(\"_bom\") or p[\"ad\"] in KAPAK or p[\"ad\"] in AKTARMA_TP10 or not v1_kalir(p[\"ad\"]) or grup_modul(p[\"ad\"]) == \"TABLA\": continue\n2334\t        _d = V1_TASI.get(p[\"ad\"], (0.0, 0.0, 0.0))\n2335\t        sh = p[\"wp\"].val().translate(cq.Vector(X_BC + _d[0], Y_MEK + _d[1], _d[2]))\n2336\t        if p[\"ad\"] == \"cikis_yarigi_contasi\": sh = YARIK_V2\n2337\t        if sh.BoundingBox().xmax > 1900.0: _DGI.append((\"TOPPING:\" + p[\"ad\"], sh))\n2338\t    for p in _TABLA:\n2339\t        for _ad_, _xk in ((\"park\", TC.XC_TABLA), (\"aktarma\", TH.X_AKTARMA)):\n2340\t            _DGI.append((\"TABLA(%s):%s\" % (_ad_, p[\"ad\"]), p[\"wp\"].val().translate(cq.Vector(X_BC + _xk - TC.XC_TABLA, Y_MEK, 0.0))))\n2341\t    for q in TU.P:\n2342\t        if q[\"ad\"].startswith(V3_CIKAN): continue\n2343\t        sh = q[\"sh\"].translate(cq.Vector(X_BC, 0.0, 0.0))\n2344\t        if sh.BoundingBox().xmax > 1900.0: _DGI.append((\"TOPPING2:\" + q[\"ad\"], sh))\n2345\t    _DGI += [(a_, sa) for a_, sa in _F if sa.BoundingBox().xmin < 2700.0]\n2346\t    _DGI += [(c_, sc) for c_, sc in _DG if c_.startswith(\"K:\")]\n2347\t    _cak_it = []\n2348\t    # (1) ARABA + TABLA (kaset) AKTARMADA ↔ TOPPING sabitleri + TU + fırın + yükleme bandı + K (v69'da araba aktarmada denetlenmiyordu)\n2349\t    _MOB = [p for p in TC.PARCALAR if grup_modul(p[\"ad\"]) in (\"TABLA\", \"ARABA\")]\n2350\t    _dx_ak = X_BC + TH.X_AKTARMA - TC.XC_TABLA\n2351\t    for p in _MOB:\n2352\t        sa = p[\"wp\"].val().translate(cq.Vector(_dx_ak, Y_MEK, 0.0))\n2353\t        for c_, sc in _DGI:\n2354\t            if c_.startswith(\"TABLA(\"): continue\n2355\t            if _bbk(sa, sc):\n2356\t                v_ = _hacim(sa, sc)\n2357\t                if v_ > 1.0 or v_ < 0: _cak_it.append((round(v_, 1), \"AKTARMA:\" + p[\"ad\"], c_))\n2358\t    # (2) KASET DÖNÜŞ SÜPÜRMESİ istasyonlarda (bantli_tabla_cad_v1 D4 yöntemi: r(y) profili 2 mm dilim, +0,5 pay, istasyon x aralığında stadyum) ↔ TOPPING + TU + sabit tahrik\n2359\t    _XP = X_BC + TC.XC_TABLA\n2360\t    _NOK = []\n2361\t    for p in _TABLA:\n2362\t        if not p[\"ad\"].startswith((\"bk_\", \"ayar_konum_pimi_\")): continue\n2363\t        for f_ in p[\"wp\"].val().translate(cq.Vector(X_BC, Y_MEK, 0.0)).Faces():\n2364\t            vs_, _t = f_.tessellate(0.3, 0.4); _NOK += [(v_.x - _XP, v_.y, v_.z - ZT) for v_ in vs_]\n2365\t    _Y0 = min(q[1] for q in _NOK); _prof = {}\n2366\t    for x_, y_, z_ in _NOK:\n2367\t        k_ = int((y_ - _Y0) // 2.0); r_ = math.hypot(x_, z_)\n2368\t        if r_ > _prof.get(k_, 0.0): _prof[k_] = r_\n2369\t    _R_CAD = max(_prof.values())\n2370\t    def _supur(x0, x1, pay=0.5):\n2371\t        kat = None\n2372\t        for k_, r_ in sorted(_prof.items()):\n2373\t            y0 = _Y0 + k_ * 2.0; y1 = y0 + 2.0; r_ += pay\n2374\t            if x1 - x0 < 0.01: w_ = cq.Workplane(\"XZ\").center(x0, ZT).circle(r_).extrude(-(y1 - y0)).translate((0, y0, 0))\n2375\t            else: w_ = cq.Workplane(\"XZ\").center((x0 + x1) / 2.0, ZT).slot2D(x1 - x0 + 2 * r_, 2 * r_, 0).extrude(-(y1 - y0)).translate((0, y0, 0))\n2376\t            kat = w_ if kat is None else kat.union(w_)\n2377\t        return kat.val()\n2378\t    import h3_ist_v1 as _TH2                                                   # v83: istasyon aralıkları dozaj hesabından (sucuk r_ic 30 → tabla 22,4 mm erken durur)\n2379\t    _IST = []\n2380\t    for _i2 in _TH2.IST:\n2381\t        _x2 = X_BC + _i2[\"x\"]\n2382\t        if _i2[\"tip\"] == \"YAYICI\":\n2383\t            _IST.append((_i2[\"kod\"].lower(), _x2, _x2)); continue\n2384\t        _d2 = _TH2.spiral(_i2, 100.0)\n2385\t        # v3: NOKTA istasyonları da tabla_x (TARAF) ile — v81'de iki yan temkinli alınıyordu; v3'te TOPPING sol duvarı kıymanın dibinde (1436):\n2386\t        #     kıymada tabla yalnız SAĞA açılır (1616 → 1708), sola hiç gitmez (makine_kodu / sim aynı TARAF tablosunu kullanır)\n2387\t        _IST.append((_i2[\"kod\"].lower(), X_BC + _TH2.tabla_x(_i2, _d2[\"r_dis\"]), X_BC + _TH2.tabla_x(_i2, _d2[\"r_ic\"])))\n2388\t    _IST = [(a_, round(min(u_, v_), 1), round(max(u_, v_), 1)) for a_, u_, v_ in _IST]\n2389\t    print(\"   v83 · kaset donus istasyonlari (dunya tabla ekseni x, topping_v2_hesap_v2): %s\" % _IST)"}]},"uuid":"d8e93646-783b-495d-a5c0-b7a66dfe1928","timestamp":"2026-10-01T19:04:04.471Z","sourceToolAssistantUUID":"33aaa218-36cc-4d82-8e21-4005321c47bd","userType":"external","ent