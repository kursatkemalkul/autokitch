b, c, d, na, nb=None, nc=None, nd=None, uv=None):\n51-        nb = nb or na; nc = nc or na; nd = nd or na\n52-        u = uv or [None] * 4\n53-        i0 = self.v(a, na, u[0]); i1 = self.v(b, nb, u[1]); i2 = self.v(c, nc, u[2]); i3 = self.v(d, nd, u[3])\n54-        self.I += [i0, i1, i2, i0, i2, i3]\n55-\n56-    def ekle(self, o):\n57-        off = len(self.P)\n58-        self.P += o.P; self.N += o.N; self.I += [i + off for i in o.I]\n59-        return self\n60-\n61-    def duzelt(self):\n62-        \"\"\"ucgen sarimini verilen normallere uydur (isik dogru dussun)\"\"\"\n63-        I = self.I\n64-        for k in range(0, len(I), 3):\n65-            a, b, c = I[k], I[k + 1], I[k + 2]\n66-            g = cross(sub(self.P[b], self.P[a]), sub(self.P[c], self.P[a]))\n67-            n = add(add(self.N[a], self.N[b]), self.N[c])\n68-            if dot(g, n) < 0: I[k + 1], I[k + 2] = c, b\n69-        return self\n70-\n71-\n72-# ======================= TEMEL SEKILLER =======================\n73-def kutu(x0, x1, y0, y1, z0, z1):\n74-    m = Mesh()\n75-    m.quad((x0, y0, z1), (x1, y0, z1), (x1, y1, z1), (x0, y1, z1), (0, 0, 1))\n76-    m.quad((x1, y0, z0), (x0, y0, z0), (x0, y1, z0), (x1, y1, z0), (0, 0, -1))\n77-    m.quad((x1, y0, z1), (x1, y0, z0), (x1, y1, z0), (x1, y1, z1), (1, 0, 0))\n78-    m.quad((x0, y0, z0), (x0, y0, z1), (x0, y1, z1), (x0, y1, z0), (-1, 0, 0))\n79-    m.quad((x0, y1, z1), (x1, y1, z1), (x1, y1, z0), (x0, y1, z0), (0, 1, 0))\n80-    m.quad((x0, y0, z0), (x1, y0, z0), (x1, y0, z1), (x0, y0, z1), (0, -1, 0))\n81-    return m\n82-\n83-\n84-def _taban(eksen):\n85-    e = unit(eksen)\n86-    yard = (1, 0, 0) if abs(e[0]) < 0.9 else (0, 1, 0)\n87-    u = unit(cross(e, yard)); w = cross(e, u)\n88-    return e, u, w\n89-\n90-\n91-def silindir(p0, p1, r0, r1=None, seg=28, kapak=True, ic=False):\n92-    \"\"\"p0→p1 arasi silindir / koni · duzgun (smooth) normaller · ic=True: normaller iceri\"\"\"\n93-    r1 = r0 if r1 is None else r1\n94-    e, u, w = _taban