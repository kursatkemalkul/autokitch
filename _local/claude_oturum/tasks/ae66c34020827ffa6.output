{"parentUuid":"506ec694-561d-437a-b424-36ac4f9c745c","isSidechain":true,"agentId":"ae66c34020827ffa6","message":{"model":"claude-sonnet-5-5","id":"msg_011CfdA4i8QZCSHA5TTcQ7qU","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4998,"cache_read_input_tokens":398515,"cache_creation":{"ephemeral_5m_input_tokens":4998,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"apiBlockIndex":0,"requestId":"req_011CfdA4hq4Rk8upim8cYG3T","attributionAgent":"general-purpose","type":"assistant","uuid":"b1319247-6eb2-441f-88ea-e875d18bb196","timestamp":"2026-10-02T09:16:24.829Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
{"parentUuid":"b1319247-6eb2-441f-88ea-e875d18bb196","isSidechain":true,"agentId":"ae66c34020827ffa6","message":{"model":"claude-sonnet-5-5","id":"msg_011CfdA4i8QZCSHA5TTcQ7qU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MNfj5CysToKzjMAQgoXo5z","name":"Write","input":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\b3_hiz\\arastirma\\_uretec\\h3\\h3_hiz_onbellek.py","content":"# -*- coding: utf-8 -*-\n\"\"\"HAT v3 · İŞLEM ÖNBELLEĞİ (OCC işlem belleği) — h3_hiz_onbellek.py (2 Eki 2026 · Claude). Üreteçlere / montaja DOKUNMAZ; çalışma zamanı yaması.\n\nNEDEN İŞLEM DÜZEYİ (modül düzeyi değil): her üreteç kur()'u ayrı ayrı \"değişti mi\" diye izlemek bağımlılık ağacı ister (bir üreteç 6 başkasını içe alır, ortam sabitleri vb.).\nBurada her pahalı OCC işlemi (boolean · clean · öteleme/dönme · sınır kutusu · hacim) kendi GİRDİSİNİN içeriğiyle anahtarlanır → bir istasyonun üreteci değişince YALNIZ değişen\nişlemler yeniden hesaplanır, geri kalan her şey (başka istasyonlar da, aynı istasyonun değişmeyen kısımları da) diskten gelir. Bağımlılık izleme gerekmez: girdi aynıysa sonuç aynıdır.\n\nANAHTAR (Merkle): her cq.Shape bir BELİRTEÇ (token) taşır.\n  · işlem sonucu  → H(işlem adı + seçenekler + girdi belirteçleri)  (sonuç diskten gelse de hesaplansa da AYNI belirteç)\n  · diğer şekiller (makeBox, STEP, Compound.makeCompound …) → H(BinTools baytları, üçgensiz) — ilk kez girdi olduğunda tembel hesaplanır\n  Belirteç wrapper nesnesine zayıf bağlıdır; wrapped (TShape + Location) sonradan değişirse (move vb.) geçersiz sayılır.\nSAKLAMA: tek sqlite (h3/_hiz/op.sqlite · WAL · senkron KAPALI) · BinTools ikili (çift duyarlık TAM, üçgen yok) · yazmalar bellekte birikir, flush() ile (montaj çıkışında) yazılır.\nTAM EŞDEĞERLİK İLKESİ: yalnız saf geometri işlemleri önbelleğe girer; sonuç diskten BinTools gidiş-dönüşüyle gelir (çift duyarlık aynı, topoloji sırası aynı).\n  H3_HIZ_OP_DOGRULA=1 → her isabette işlem yine yapılır, hacim / yüz sayısı / kutu karşılaştırılır (fark = AssertionError).\n  H3_HIZ_OP=0 → hiçbir şey yamalanmaz. H3_HIZ_OP_DIZIN → önbellek klasörü.\nKapsam bayrakları (env): H3_HIZ_OP_BB=0 (sınır kutusu kalıcı önbelleği kapalı) · H3_HIZ_OP_MASS=0 · H3_HIZ_OP_TESS=1 (tessellate önbelleği açık — varsayılan KAPALI).\"\"\"\nimport atexit, hashlib, io, os, sqlite3, struct, sys, time, weakref\n\nH3 = os.path.dirname(os.path.abspath(__file__))\nDIZIN = os.environ.get(\"H3_HIZ_OP_DIZIN\") or os.path.join(H3, \"_hiz\", \"op\")\nDB = os.path.join(DIZIN, \"op.sqlite\")\nDOGRULA = bool(os.environ.get(\"H3_HIZ_OP_DOGRULA\"))\nS = dict(bool_hit=0, bool_miss=0, clean_hit=0, clean_miss=0, tr_hit=0, tr_miss=0, bb_hit=0, bb_miss=0, bb_atla=0, mass_hit=0, mass_miss=0,\n         tess_hit=0, tess_miss=0, bayt_tok=0, yazilan=0, okunan_bayt=0, yazilan_bayt=0, dogrulanan=0,\n         t_bool=0.0, t_okuma=0.0, t_tok=0.0, t_yazma=0.0)\n_CON = [None]\n_PEND = {}\n_PEND_B = [0]\nFLUSH_BAYT = 256 * 1024 * 1024\n_TOK = {}                                  # id(wrapper) → (hash(wrapped), token, weakref)\n_KURULDU = [False]\n_ASIL = {}\n\n\n# ---------------------------------------------------------------- depo ----------------------------------------------------------------\ndef _db():\n    if _CON[0] is None:\n        os.makedirs(DIZIN, exist_ok=True)\n        c = sqlite3.connect(DB, timeout=300, isolation_level=None, check_same_thread=False)\n        c.execute(\"PRAGMA journal_mode=WAL\"); c.execute(\"PRAGMA synchronous=OFF\"); c.execute(\"PRAGMA cache_size=-65536\"); c.execute(\"PRAGMA wal_autocheckpoint=20000\")\n        c.execute(\"CREATE TABLE IF NOT EXISTS kv (k TEXT PRIMARY KEY, v BLOB) WITHOUT ROWID\")\n        _CON[0] = c\n    return _CON[0]\n\n\ndef al(k):\n    v = _PEND.get(k)\n    if v is not None: return v\n    t = time.time()\n    r = _db().execute(\"SELECT v FROM kv WHERE k=?\", (k,)).fetchone()\n    S[\"t_okuma\"] += time.time() - t\n    if r is None: return None\n    S[\"okunan_bayt\"] += len(r[0])\n    return r[0]\n\n\ndef koy(k, v):\n    if k in _PEND: return\n    _PEND[k] = v; _PEND_B[0] += len(v) + 64\n    if _PEND_B[0] >= FLUSH_BAYT: flush()\n\n\ndef flush():\n    if not _PEND: return\n    t = time.time()\n    c = _db()\n    c.execute(\"BEGIN\")\n    c.executemany(\"INSERT OR IGNORE INTO kv VALUES (?, ?)\", list(_PEND.items()))\n    c.execute(\"COMMIT\")\n    S[\"yazilan\"] += len(_PEND); S[\"yazilan_bayt\"] += _PEND_B[0]\n    _PEND.clear(); _PEND_B[0] = 0\n    S[\"t_yazma\"] += time.time() - t\n\n\n# ---------------------------------------------------------------- şekil ↔ bayt ----------------------------------------------------------------\ndef bayt(w):\n    from OCP.BinTools import BinTools, BinTools_FormatVersion\n    b = io.BytesIO(); BinTools.Write_s(w, b, False, False, BinTools_FormatVersion.BinTools_FormatVersion_CURRENT)\n    return b.getvalue()\n\n\ndef sekil(bts):\n    from OCP.BinTools import BinTools\n    from OCP.TopoDS import TopoDS_Shape\n    s = TopoDS_Shape(); BinTools.Read_s(s, io.BytesIO(bts))\n    if s.IsNull(): raise ValueError(\"önbellek şekli okunamadı\")\n    return s\n\n\ndef _h(*parcalar):\n    h = hashlib.blake2b(digest_size=16)\n    for p in parcalar:\n        if isinstance(p, str): p = p.encode(\"utf-8\")\n        h.update(p); h.update(b\"\\x1f\")\n    return h.hexdigest()\n\n\n# ---------------------------------------------------------------- belirteç ----------------------------------------------------------------\ndef _ata(sh, t):\n    i = id(sh)\n    def cb(r, i=i):\n        e = _TOK.get(i)\n        if e is not None and e[2] is r: del _TOK[i]\n    r = weakref.ref(sh, cb)\n    _TOK[i] = (hash(sh.wrapped), t, r)\n\n\ndef tok(sh):\n    e = _TOK.get(id(sh))\n    hc = hash(sh.wrapped)\n    if e is not None and e[0] == hc and e[2]() is sh: return e[1]\n    t0 = time.time()\n    t = \"b\" + _h(\"bayt\", bayt(sh.wrapped))\n    S[\"bayt_tok\"] += 1; S[\"t_tok\"] += time.time() - t0\n    _ata(sh, t)\n    return t\n\n\n# ---------------------------------------------------------------- yamalar ----------------------------------------------------------------\ndef _fark_kontrol(a, b, ad):\n    \"\"\"DOGRULA: önbellekten gelen ile yeni hesaplanan aynı mı\"\"\"\n    ASIL = _ASIL[\"computeMass\"]\n    va, vb = ASIL(a), ASIL(b)\n    assert abs(va - vb) <= 1e-6 * max(1.0, abs(vb)) + 1e-6, \"%s: önbellek hacmi %r ≠ hesap %r\" % (ad, va, vb)\n    assert len(a.Faces()) == len(b.Faces()), \"%s: yüz sayısı %d ≠ %d\" % (ad, len(a.Faces()), len(b.Faces()))\n    ba, bb = _ASIL[\"bb\"](a), _ASIL[\"bb\"](b)\n    for k in (\"xmin\", \"xmax\", \"ymin\", \"ymax\", \"zmin\", \"zmax\"):\n        assert abs(getattr(ba, k) - getattr(bb, k)) <= 1e-6, \"%s: kutu %s %r ≠ %r\" % (ad, k, getattr(ba, k), getattr(bb, k))\n    S[\"dogrulanan\"] += 1\n\n\ndef kur():\n    if _KURULDU[0]: return\n    _KURULDU[0] = True\n    import cadquery as cq\n    from cadquery.occ_impl import shapes as SH, geom as G\n    Shape = SH.Shape\n    _ASIL[\"bool_op\"] = Shape._bool_op; _ASIL[\"clean\"] = Shape.clean; _ASIL[\"apply\"] = Shape._apply_transform\n    _ASIL[\"computeMass\"] = Shape.computeMass; _ASIL[\"bb\"] = Shape.BoundingBox; _ASIL[\"tess\"] = Shape.tessellate\n    asil_bool, asil_clean, asil_apply, asil_mass, asil_bb, asil_tess = _ASIL[\"bool_op\"], _ASIL[\"clean\"], _ASIL[\"apply\"], _ASIL[\"computeMass\"], _ASIL[\"bb\"], _ASIL[\"tess\"]\n\n    def bool_op(self, args, tools, op, parallel=True):\n        args = list(args); tools = list(tools)\n        try:\n            ayar = (type(op).__name__, repr(op.FuzzyValue()), repr(op.Glue()), repr(op.NonDestructive()), repr(op.CheckInverted()), repr(parallel))\n        except Exception:\n            ayar = None\n        if ayar is None:\n            return asil_bool(self, args, tools, op, parallel)\n        k = _h(\"bool\", *ayar, \"A\", *[tok(a) for a in args], \"T\", *[tok(t) for t in tools])\n        v = al(k)\n        if v is not None:\n            t0 = time.time(); r = Shape.cast(sekil(v)); S[\"bool_hit\"] += 1; S[\"t_bool\"] += 0.0\n            if DOGRULA:\n                _fark_kontrol(r, asil_bool(self, args, tools, op, parallel), \"bool\")\n            _ata(r, \"o\" + k)\n            return r\n        S[\"bool_miss\"] += 1\n        r = asil_bool(self, args, tools, op, parallel)\n        try: koy(k, bayt(r.wrapped))\n        except Exception: return r\n        _ata(r, \"o\" + k)\n        return r\n\n    def clean(self):\n        k = _h(\"clean\", tok(self))\n        v = al(k)\n        if v is not None:\n            S[\"clean_hit\"] += 1; r = self.__class__(sekil(v)); _ata(r, \"o\" + k)\n            if DOGRULA: _fark_kontrol(r, asil_clean(self), \"clean\")\n            return r\n        S[\"clean_miss\"] += 1\n        r = asil_clean(self)\n        koy(k, bayt(r.wrapped)); _ata(r, \"o\" + k)\n        return r\n\n    def apply_transform(self, Tr):\n        try:\n            m = struct.pack(\"<13d\", *[Tr.Value(i, j) for i in (1, 2, 3) for j in (1, 2, 3, 4)], Tr.ScaleFactor())\n            form = str(Tr.Form())\n        except Exception:\n            return asil_apply(self, Tr)\n        k = _h(\"tr\", tok(self), m, form, self.__class__.__name__)\n        v = al(k)\n        if v is not None:\n            S[\"tr_hit\"] += 1; r = self.__class__(sekil(v)); _ata(r, \"o\" + k)\n            if DOGRULA: _fark_kontrol(r, asil_apply(self, Tr), \"tr\")\n            return r\n        S[\"tr_miss\"] += 1\n        r = asil_apply(self, Tr)\n        koy(k, bayt(r.wrapped)); _ata(r, \"o\" + k)\n        return r\n\n    Shape._bool_op = bool_op\n    Shape.clean = clean\n    Shape._apply_transform = apply_transform\n\n    # ---- hacim / alan (computeMass) ----\n    if os.environ.get(\"H3_HIZ_OP_MASS\", \"1\") != \"0\":\n        def compute_mass(obj, tol=None):\n            try:\n                f = Shape._mass_calc_function(obj)\n                k = _h(\"mass\", tok(obj), getattr(f, \"__name__\", repr(f)), repr(tol))\n            except Exception:\n                return asil_mass(obj, tol)\n            v = al(k)\n            if v is not None:\n                S[\"mass_hit\"] += 1\n                r = struct.unpack(\"<d\", v)[0]\n                if DOGRULA: assert abs(r - asil_mass(obj, tol)) <= 1e-6 * max(1.0, abs(r)), \"mass farklı\"\n                return r\n            S[\"mass_miss\"] += 1\n            r = asil_mass(obj, tol)\n            koy(k, struct.pack(\"<d\", r))\n            return r\n        Shape.computeMass = staticmethod(compute_mass)\n\n    # ---- sınır kutusu: kalıcı önbellek YALNIZ üçgenlenmemiş şekilde (AddOptimal üçgen varsa onu kullanır → durum bağımlı) ----\n    if os.environ.get(\"H3_HIZ_OP_BB\", \"1\") != \"0\":\n        from OCP.Bnd import Bnd_Box\n        from OCP.BRep import BRep_Tool\n        from OCP.TopLoc import TopLoc_Location\n        from OCP.TopExp import TopExp_Explorer\n        from OCP.TopAbs import TopAbs_FACE\n\n        def ucgenli_mi(w):\n            ex = TopExp_Explorer(w, TopAbs_FACE)\n            loc = TopLoc_Location()\n            while ex.More():\n                from OCP.TopoDS import TopoDS\n                if BRep_Tool.Triangulation_s(TopoDS.Face_s(ex.Current()), loc) is not None: return True\n                ex.Next()\n            return False\n\n        def bounding_box(self, tolerance=None):\n            if tolerance is not None: return asil_bb(self, tolerance)\n            if ucgenli_mi(self.wrapped):\n                S[\"bb_atla\"] += 1\n                return asil_bb(self)\n            k = _h(\"bb\", tok(self))\n            v = al(k)\n            if v is not None:\n                S[\"bb_hit\"] += 1\n                x0, y0, z0, x1, y1, z1 = struct.unpack(\"<6d\", v)\n                b = Bnd_Box(); b.Update(x0, y0, z0, x1, y1, z1)\n                r = G.BoundBox(b)\n                if DOGRULA:\n                    f = asil_bb(self)\n                    for a_, b_ in ((r.xmin, f.xmin), (r.xmax, f.xmax), (r.ymin, f.ymin), (r.ymax, f.ymax), (r.zmin, f.zmin), (r.zmax, f.zmax)):\n                        assert abs(a_ - b_) <= 1e-9 * max(1.0, abs(b_)), \"kutu önbelleği farklı: %r %r\" % (a_, b_)\n                return r\n            S[\"bb_miss\"] += 1\n            r = asil_bb(self)\n            koy(k, struct.pack(\"<6d\", r.xmin, r.ymin, r.zmin, r.xmax, r.ymax, r.zmax))\n            return r\n        Shape.BoundingBox = bounding_box\n    atexit.register(flush)\n\n\ndef rapor(yaz=None):\n    flush()\n    p = lambda s: (yaz or sys.stdout.write)(s + \"\\n\")\n    p(\"hız · işlem önbelleği: bool %d isabet / %d yeni · clean %d / %d · öteleme %d / %d · kutu %d / %d (%d üçgenli atlandı) · hacim %d / %d · bayt-belirteç %d (%.1f sn) · \"\n      \"okuma %.1f sn · yazma %.1f sn (%d kayıt, %.0f MB)%s\"\n      % (S[\"bool_hit\"], S[\"bool_miss\"], S[\"clean_hit\"], S[\"clean_miss\"], S[\"tr_hit\"], S[\"tr_miss\"], S[\"bb_hit\"], S[\"bb_miss\"], S[\"bb_atla\"], S[\"mass_hit\"], S[\"mass_miss\"],\n         S[\"bayt_tok\"], S[\"t_tok\"], S[\"t_okuma\"], S[\"t_yazma\"], S[\"yazilan\"], S[\"yazilan_bayt\"] / 1048576.0, (\" · doğrulanan %d (hepsi aynı)\" % S[\"dogrulanan\"]) if DOGRULA else \"\"))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4998,"cache_read_input_tokens":398515,"output_tokens":12033,"output_tokens_details":{"thinking_tokens":5669},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":4998},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":12033,"cache_read_input_tokens":398515,"cache_creation_input_tokens":4998,"cache_creation":{"ephemeral_5m_input_tokens":4998,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01MNfj5CysToKzjMAQgoXo5z":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\b3_hiz\\arastirma\\_uretec\\h3\\h3_hiz_onbellek.py","content":"# -*- coding: utf-8 -*-\n\"\"\"HAT v3 · İŞLEM ÖNBELLEĞİ (OCC işlem belleği) — h3_hiz_onbellek.py (2 Eki 2026 · Claude). Üreteçlere / montaja DOKUNMAZ; çalışma zamanı yaması.\n\nNEDEN İŞLEM DÜZEYİ (modül düzeyi değil): her üreteç kur()'u ayrı ayrı \"değişti mi\" diye izlemek bağımlılık ağacı ister (bir üreteç 6 başkasını içe alır, ortam sabitleri vb.).\nBurada her pahalı OCC işlemi (boolean · clean · öteleme/dönme · sınır kutusu · hacim) kendi GİRDİSİNİN içeriğiyle anahtarlanır → bir istasyonun üreteci değişince YALNIZ değişen\nişlemler yeniden hesaplanır, geri kalan her şey (başka istasyonlar da, aynı istasyonun değişmeyen kısımları da) diskten gelir. Bağımlılık izleme gerekmez: girdi aynıysa sonuç aynıdır.\n\nANAHTAR (Merkle): her cq.Shape bir BELİRTEÇ (token) taşır.\n  · işlem sonucu  → H(işlem adı + seçenekler + girdi belirteçleri)  (sonuç diskten gelse de hesaplansa da AYNI belirteç)\n  · diğer şekiller (makeBox, STEP, Compound.makeCompound …) → H(BinTools baytları, üçgensiz) — ilk kez girdi olduğunda tembel hesaplanır\n  Belirteç wrapper nesnesine zayıf bağlıdır; wrapped (TShape + Location) sonradan değişirse (move vb.) geçersiz sayılır.\nSAKLAMA: tek sqlite (h3/_hiz/op.sqlite · WAL · senkron KAPALI) · BinTools ikili (çift duyarlık TAM, üçgen yok) · yazmalar bellekte birikir, flush() ile (montaj çıkışında) yazılır.\nTAM EŞDEĞERLİK İLKESİ: yalnız saf geometri işlemleri önbelleğe girer; sonuç diskten BinTools gidiş-dönüşüyle gelir (çift duyarlık aynı, topoloji sırası aynı).\n  H3_HIZ_OP_DOGRULA=1 → her isabette işlem yine yapılır, hacim / yüz sayısı / kutu karşılaştırılır (fark = AssertionError).\n  H3_HIZ_OP=0 → hiçbir şey yamalanmaz. H3_HIZ_OP_DIZIN → önbellek klasörü.\nKapsam bayrakları (env): H3_HIZ_OP_BB=0 (sınır kutusu kalıcı önbelleği kapalı) · H3_HIZ_OP_MASS=0 · H3_HIZ_OP_TESS=1 (tessellate önbelleği açık — varsayılan KAPALI).\"\"\"\nimport atexit, hashlib, io, os, sqlite3, struct, sys, time, weakref\n\nH3 = os.path.dirname(os.path.abspath(__file__))\nDIZIN = os.environ.get(\"H3_HIZ_OP_DIZIN\") or os.path.join(H3, \"_hiz\", \"op\")\nDB = os.path.join(DIZIN, \"op.sqlite\")\nDOGRULA = bool(os.environ.get(\"H3_HIZ_OP_DOGRULA\"))\nS = dict(bool_hit=0, bool_miss=0, clean_hit=0, clean_miss=0, tr_hit=0, tr_miss=0, bb_hit=0, bb_miss=0, bb_atla=0, mass_hit=0, mass_miss=0,\n         tess_hit=0, tess_miss=0, bayt_tok=0, yazilan=0, okunan_bayt=0, yazilan_bayt=0, dogrulanan=0,\n         t_bool=0.0, t_okuma=0.0, t_tok=0.0, t_yazma=0.0)\n_CON = [None]\n_PEND = {}\n_PEND_B = [0]\nFLUSH_BAYT = 256 * 1024 * 1024\n_TOK = {}                                  # id(wrapper) → (hash(wrapped), token, weakref)\n_KURULDU = [False]\n_ASIL = {}\n\n\n# ---------------------------------------------------------------- depo ----------------------------------------------------------------\ndef _db():\n    if _CON[0] is None:\n        os.makedirs(DIZIN, exist_ok=True)\n        c = sqlite3.connect(DB, timeout=300, isolation_level=None, check_same_thread=False)\n        c.execute(\"PRAGMA journal_mode=WAL\"); c.execute(\"PRAGMA synchronous=OFF\"); c.execute(\"PRAGMA cache_size=-65536\"); c.execute(\"PRAGMA wal_autocheckpoint=20000\")\n        c.execute(\"CREATE TABLE IF NOT EXISTS kv (k TEXT PRIMARY KEY, v BLOB) WITHOUT ROWID\")\n        _CON[0] = c\n    return _CON[0]\n\n\ndef al(k):\n    v = _PEND.get(k)\n    if v is not None: return v\n    t = time.time()\n    r = _db().execute(\"SELECT v FROM kv WHERE k=?\", (k,)).fetchone()\n    S[\"t_okuma\"] += time.time() - t\n    if r is None: return None\n    S[\"okunan_bayt\"] += len(r[0])\n    return r[0]\n\n\ndef koy(k, v):\n    if k in _PEND: return\n    _PEND[k] = v; _PEND_B[0] += len(v) + 64\n    if _PEND_B[0] >= FLUSH_BAYT: flush()\n\n\ndef flush():\n    if not _PEND: return\n    t = time.time()\n    c = _db()\n    c.execute(\"BEGIN\")\n    c.executemany(\"INSERT OR IGNORE INTO kv VALUES (?, ?)\", list(_PEND.items()))\n    c.execute(\"COMMIT\")\n    S[\"yazilan\"] += len(_PEND); S[\"yazilan_bayt\"] += _PEND_B[0]\n    _PEND.clear(); _PEND_B[0] = 0\n    S[\"t_yazma\"] += time.time() - t\n\n\n# ---------------------------------------------------------------- şekil ↔ bayt ----------------------------------------------------------------\ndef bayt(w):\n    from OCP.BinTools import BinTools, BinTools_FormatVersion\n    b = io.BytesIO(); BinTools.Write_s(w, b, False, False, BinTools_FormatVersion.BinTools_FormatVersion_CURRENT)\n    return b.getvalue()\n\n\ndef sekil(bts):\n    from OCP.BinTools import BinTools\n    from OCP.TopoDS import TopoDS_Shape\n    s = TopoDS_Shape(); BinTools.Read_s(s, io.BytesIO(bts))\n    if s.IsNull(): raise ValueError(\"önbellek şekli okunamadı\")\n    return s\n\n\ndef _h(*parcalar):\n    h = hashlib.blake2b(digest_size=16)\n    for p in parcalar:\n        if isinstance(p, str): p = p.encode(\"utf-8\")\n        h.update(p); h.update(b\"\\x1f\")\n    return h.hexdigest()\n\n\n# ---------------------------------------------------------------- belirteç ----------------------------------------------------------------\ndef _ata(sh, t):\n    i = id(sh)\n    def cb(r, i=i):\n        e = _TOK.get(i)\n        if e is not None and e[2] is r: del _TOK[i]\n    r = weakref.ref(sh, cb)\n    _TOK[i] = (hash(sh.wrapped), t, r)\n\n\ndef tok(sh):\n    e = _TOK.get(id(sh))\n    hc = hash(sh.wrapped)\n    if e is not None and e[0] == hc and e[2]() is sh: return e[1]\n    t0 = time.time()\n    t = \"b\" + _h(\"bayt\", bayt(sh.wrapped))\n    S[\"bayt_tok\"] += 1; S[\"t_tok\"] += time.time() - t0\n    _ata(sh, t)\n    return t\n\n\n# ---------------------------------------------------------------- yamalar ----------------------------------------------------------------\ndef _fark_kontrol(a, b, ad):\n    \"\"\"DOGRULA: önbellekten gelen ile yeni hesaplanan aynı mı\"\"\"\n    ASIL = _ASIL[\"computeMass\"]\n    va, vb = ASIL(a), ASIL(b)\n    assert abs(va - vb) <= 1e-6 * max(1.0, abs(vb)) + 1e-6, \"%s: önbellek hacmi %r ≠ hesap %r\" % (ad, va, vb)\n    assert len(a.Faces()) == len(b.Faces()), \"%s: yüz sayısı %d ≠ %d\" % (ad, len(a.Faces()), len(b.Faces()))\n    ba, bb = _ASIL[\"bb\"](a), _ASIL[\"bb\"](b)\n    for k in (\"xmin\", \"xmax\", \"ymin\", \"ymax\", \"zmin\", \"zmax\"):\n        assert abs(getattr(ba, k) - getattr(bb, k)) <= 1e-6, \"%s: kutu %s %r ≠ %r\" % (ad, k, getattr(ba, k), getattr(bb, k))\n    S[\"dogrulanan\"] += 1\n\n\ndef kur():\n    if _KURULDU[0]: return\n    _KURULDU[0] = True\n    import cadquery as cq\n    from cadquery.occ_impl import shapes as SH, geom as G\n    Shape = SH.Shape\n    _ASIL[\"bool_op\"] = Shape._bool_op; _ASIL[\"clean\"] = Shape.clean; _ASIL[\"apply\"] = Shape._apply_transform\n    _ASIL[\"computeMass\"] = Shape.computeMass; _ASIL[\"bb\"] = Shape.BoundingBox; _ASIL[\"tess\"] = Shape.tessellate\n    asil_bool, asil_clean, asil_apply, asil_mass, asil_bb, asil_tess = _ASIL[\"bool_op\"], _ASIL[\"clean\"], _ASIL[\"apply\"], _ASIL[\"computeMass\"], _ASIL[\"bb\"], _ASIL[\"tess\"]\n\n    def bool_op(self, args, tools, op, parallel=True):\n        args = list(args); tools = list(tools)\n        try:\n            ayar = (type(op).__name__, repr(op.FuzzyValue()), repr(op.Glue()), repr(op.NonDestructive()), repr(op.CheckInverted()), repr(parallel))\n        except Exception:\n            ayar = None\n        if ayar is None:\n            return asil_bool(self, args, tools, op, parallel)\n        k = _h(\"bool\", *ayar, \"A\", *[tok(a) for a in args], \"T\", *[tok(t) for t in tools])\n        v = al(k)\n        if v is not None:\n            t0 = time.time(); r = Shape.cast(sekil(v)); S[\"bool_hit\"] += 1; S[\"t_bool\"] += 0.0\n            if DOGRULA:\n                _fark_kontrol(r, asil_bool(self, args, tools, op, parallel), \"bool\")\n            _ata(r, \"o\" + k)\n            return r\n        S[\"bool_miss\"] += 1\n        r = asil_bool(self, args, tools, op, parallel)\n        try: koy(k, bayt(r.wrapped))\n        except Exception: return r\n        _ata(r, \"o\" + k)\n        return r\n\n    def clean(self):\n        k = _h(\"clean\", tok(self))\n        v = al(k)\n        if v is not None:\n            S[\"clean_hit\"] += 1; r = self.__class__(sekil(v)); _ata(r, \"o\" + k)\n            if DOGRULA: _fark_kontrol(r, asil_clean(self), \"clean\")\n            return r\n        S[\"clean_miss\"] += 1\n        r = asil_clean(self)\n        koy(k, bayt(r.wrapped)); _ata(r, \"o\" + k)\n        return r\n\n    def apply_transform(self, Tr):\n        try:\n            m = struct.pack(\"<13d\", *[Tr.Value(i, j) for i in (1, 2, 3) for j in (1, 2, 3, 4)], Tr.ScaleFactor())\n            form = str(Tr.Form())\n        except Exception:\n            return asil_apply(self, Tr)\n        k = _h(\"tr\", tok(self), m, form, self.__class__.__name__)\n        v = al(k)\n        if v is not None:\n            S[\"tr_hit\"] += 1; r = self.__class__(sekil(v)); _ata(r, \"o\" + k)\n            if DOGRULA: _fark_kontrol(r, asil_apply(self, Tr), \"tr\")\n            return r\n        S[\"tr_miss\"] += 1\n        r = asil_apply(self, Tr)\n        koy(k, bayt(r.wrapped)); _ata(r, \"o\" + k)\n        return r\n\n    Shape._bool_op = bool_op\n    Shape.clean = clean\n    Shape._apply_transform = apply_transform\n\n    # ---- hacim / alan (computeMass) ----\n    if os.environ.get(\"H3_HIZ_OP_MASS\", \"1\") != \"0\":\n        def compute_mass(obj, tol=None):\n            try:\n                f = Shape._mass_calc_function(obj)\n                k = _h(\"mass\", tok(obj), getattr(f, \"__name__\", repr(f)), repr(tol))\n            except Exception:\n                return asil_mass(obj, tol)\n            v = al(k)\n            if v is not None:\n                S[\"mass_hit\"] += 1\n                r = struct.unpack(\"<d\", v)[0]\n                if DOGRULA: assert abs(r - asil_mass(obj, tol)) <= 1e-6 * max(1.0, abs(r)), \"mass farklı\"\n                return r\n            S[\"mass_miss\"] += 1\n            r = asil_mass(obj, tol)\n            koy(k, struct.pack(\"<d\", r))\n            return r\n        Shape.computeMass = staticmethod(compute_mass)\n\n    # ---- sınır kutusu: kalıcı önbellek YALNIZ üçgenlenmemiş şekilde (AddOptimal üçgen varsa onu kullanır → durum bağımlı) ----\n    if os.environ.get(\"H3_HIZ_OP_BB\", \"1\") != \"0\":\n        from OCP.Bnd import Bnd_Box\n        from OCP.BRep import BRep_Tool\n        from OCP.TopLoc import TopLoc_Location\n        from OCP.TopExp import TopExp_Explorer\n        from OCP.TopAbs import TopAbs_FACE\n\n        def ucgenli_mi(w):\n            ex = TopExp_Explorer(w, TopAbs_FACE)\n            loc = TopLoc_Location()\n            while ex.More():\n                from OCP.TopoDS import TopoDS\n                if BRep_Tool.Triangulation_s(TopoDS.Face_s(ex.Current()), loc) is not None: return True\n                ex.Next()\n            return False\n\n        def bounding_box(self, tolerance=None):\n            if tolerance is not None: return asil_bb(self, tolerance)\n            if ucgenli_mi(self.wrapped):\n                S[\"bb_atla\"] += 1\n                return asil_bb(self)\n            k = _h(\"bb\", tok(self))\n            v = al(k)\n            if v is not None:\n                S[\"bb_hit\"] += 1\n                x0, y0, z0, x1, y1, z1 = struct.unpack(\"<6d\", v)\n                b = Bnd_Box(); b.Update(x0, y0, z0, x1, y1, z1)\n                r = G.BoundBox(b)\n                if DOGRULA:\n                    f = asil_bb(self)\n                    for a_, b_ in ((r.xmin, f.xmin), (r.xmax, f.xmax), (r.ymin, f.ymin), (r.ymax, f.ymax), (r.zmin, f.zmin), (r.zmax, f.zmax)):\n                        assert abs(a_ - b_) <= 1e-9 * max(1.0, abs(b_)), \"kutu önbelleği farklı: %r %r\" % (a_, b_)\n                return r\n            S[\"bb_miss\"] += 1\n            r = asil_bb(self)\n            koy(k, struct.pack(\"<6d\", r.xmin, r.ymin, r.zmin, r.xmax, r.ymax, r.zmax))\n            return r\n        Shape.BoundingBox = bounding_box\n    atexit.register(flush)\n\n\ndef rapor(yaz=None):\n    flush()\n    p = lambda s: (yaz or sys.stdout.write)(s + \"\\n\")\n    p(\"hız · işlem önbelleği: bool %d isabet / %d yeni · clean %d / %d · öteleme %d / %d · kutu %d / %d (%d üçgenli atlandı) · hacim %d / %d · bayt-belirteç %d (%.1f sn) · \"\n      \"okuma %.1f sn · yazma %.1f sn (%d kayıt, %.0f MB)%s\"\n      % (S[\"bool_hit\"], S[\"bool_miss\"], S[\"clean_hit\"], S[\"clean_miss\"], S[\"tr_hit\"], S[\"tr_miss\"], S[\"bb_hit\"], S[\"bb_miss\"], S[\"bb_atla\"], S[\"mass_hit\"], S[\"mass_miss\"],\n         S[\"bayt_tok\"], S[\"t_tok\"], S[\"t_okuma\"], S[\"t_yazma\"], S[\"yazilan\"], S[\"yazilan_bayt\"] / 1048576.0, (\" · doğrulanan %d (hepsi aynı)\" % S[\"dogrulanan\"]) if DOGRULA else \"\"))\n"}},"apiBlockIndex":1,"requestId":"req_011CfdA4hq4Rk8upim8cYG3T","attributionAgent":"general-purpose","type":"assistant","uuid":"1f9db50b-4f88-48a2-8620-8beb3389579c","timestamp":"2026-10-02T09:17:01.794Z","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
