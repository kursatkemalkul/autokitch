{"parentUuid":"ed0a6ffc-91f7-48d9-9e9f-3db50331c15b","isSidechain":true,"agentId":"ac0532426d262e511","message":{"model":"claude-opus-5-5","id":"msg_011CfgMVu5DU4efGLE9GcsEF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Tz9yGhP5HTZRo4dDkmJQtx","name":"Read","input":{"file_path":"C:\\Users\\Kemal\\.claude\\projects\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\tool-results\\b4n0hxr41.txt"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1429,"cache_read_input_tokens":115130,"cache_creation":{"ephemeral_5m_input_tokens":1429,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Tz9yGhP5HTZRo4dDkmJQtx":{"file_path":"C:\\Users\\Kemal\\.claude\\projects\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\tool-results\\b4n0hxr41.txt"}},"apiBlockIndex":0,"requestId":"req_011CfgMVtnbzdYZsnaXTPrq1","attributionAgent":"general-purpose","type":"assistant","uuid":"753f97ff-bf3d-478e-94c1-239af5ece6f3","timestamp":"2026-10-04T01:47:28.855Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.286","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
{"parentUuid":"753f97ff-bf3d-478e-94c1-239af5ece6f3","isSidechain":true,"promptId":"ae908f31-fde0-4450-b794-006a65824d95","agentId":"ac0532426d262e511","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tz9yGhP5HTZRo4dDkmJQtx","type":"tool_result","content":"1\t    BASLIK.update(kod='A', ad='A · HAMUR AÇMA — kabuk + açıcı montajı',\n2\t                  lead=\"A istasyonunun üretim sacı gövdesi (kaynaklı kaide, iskelet, 4 bükümlü panel, çift cidarlı kapak) atölyede hangi sırayla, hangi yönden, neyle birleşir; sonra satın alınan açıcı (dönme kafası) kaidedeki M8 PEM'lere oturur. A içinde kablo / hava yok (kural).\")\n3\t    SECIM[:] = [('sol_yan_sac', 1), ('sag_yan_sac_tabla_gecisi', 1), ('ust_sac', 1), ('arka_sac', 1), ('onyuz_kapak_A', 1), ('onyuz_kapak_A_ic_tava', 1), ('kaide_ust_plaka_4', 1), ('kaide_damlama_saci', 1), ('govde_kulak_sol_on_1080', 22)]\n4\t    t = kartlar(0.0, 'kaide 7 boru · 4 dikme · üst halka · 4 panel · kapak dış/iç tava · 22 kulak')\n5\t    # 4 kaide\n6\t    t4 = t; kam(t, R(r'^kaide_'), (0, 1, 0))\n7\t    olay(t, 'Kaide boruları (40 × 100) kaynak fikstürüne: ön, arka, sol, sağ')\n8\t    t = gel(R(r'^kaide_(on|arka|sol|sag)_boru$'), (0, 0.45, 0), t, 1.0, 0.2) + 0.1\n9\t    olay(t, 'Enine + boyuna borular (açıcı kolonu ve tabla rayının altı) · köşe dikişleri TIG')\n10\t    t = gel(R(r'^kaide_(enine|boyuna)_boru'), (0, 0.45, 0), t, 1.0, 0.2)\n11\t    t = kaynak(R(r'^kaide_.*boru.*kaynak'), t) + 0.2\n12\t    olay(t, 'Kaide üst plakası 4 mm — PEM M8 (açıcı) + M6 (ray) DÜZ sacta basılı geldi')\n13\t    t = gel(R(r'^kaide_ust_plaka(_\\d+)?$') + R(r'^kaide_ust_plaka_pem_'), (0, 0.55, 0), t, 1.3) + 0.1\n14\t    olay(t, '16 delik (tapa) kaynağı plakayı borulara bağlar · yüz taşlanır')\n15\t    t = kaynak(R(r'^kaide_ust_plaka_delik_kaynagi'), t, 0.4, 0.06) + 0.2\n16\t    olay(t, 'Damlama sacı 1,5 mm alttan, kaide içine · dikmelere 2 dikiş')\n17\t    t = gel(R(r'^kaide_damlama_saci$'), (0, -0.35, 0), t, 1.0)\n18\t    t = kaynak(R(r'^kaide_damlama_dikme_kaynagi'), t) + 0.4\n19\t    adim(4, 'Kaide · kaynaklı alt montaj', t4, t,\n20\t         \"Kaide 40 × 100 kutu profillerden fikstürde kurulur (kare / diyagonal kontrol). Üst plaka 4 mm'dir; açıcı kolonunun 4 × M8 ve tabla rayının 4 × M6 PEM somunları plakaya düz hâlde basılmıştır. Plaka borulara delik (tapa) kaynağıyla bağlanır; altına damlama sacı gelir.\",\n21\t         '7 kaide borusu · üst plaka 4 mm (4 PEM M8 + 4 PEM M6) · 16 delik kaynağı · damlama sacı 1,5 mm')\n22\t    # 5 iskelet\n23\t    t5 = t; kam(t, None)\n24\t    olay(t, '4 köşe dikmesi (30 × 30) kaide plakasına · şakül kontrol')\n25\t    t = gel(R(r'^kose_dikmesi_\\d+_-?\\d+$'), (0, 0.7, 0), t, 1.1, 0.2) + 0.1\n26\t    olay(t, 'Üst halka (ön, arka, sol, sağ) dikmelerin tepesine · köşe dikişleri')\n27\t    t = gel(R(r'^ust_halka_(on|arka|sol|sag)$'), (0, 0.4, 0), t, 1.0, 0.2)\n28\t    t = kaynak(R(r'^ust_halka_.*kaynak'), t) + 0.1\n29\t    t = gel(R(r'^kose_dikmesi_.*_tapa$'), (0, 0.15, 0), t, 0.6, 0.1) + 0.1\n30\t    olay(t, '22 panel kulağı iskelete (kaynak ayağı) — saplama ayağı panel iç yüzü hizasında · kulak başına 2 dikiş')\n31\t    kam(t, R(r'^govde_kulak_'), (0, 1, 0))\n32\t    t = gel(R(r'^govde_kulak_sol_(on|arka)_\\d+$'), (-0.3, 0, 0), t, 0.7, 0.08)\n33\t    t = gel(R(r'^govde_kulak_sag_(on|arka)_\\d+$'), (0.3, 0, 0), t, 0.7, 0.08)\n34\t    t = gel(R(r'^govde_kulak_ust_(on|arka)_\\d+$'), (0, 0.25, 0), t, 0.7, 0.08)\n35\t    t = kaynak(R(r'^govde_kulak_.*_kaynak_[ab]$'), t, 0.35, 0.03) + 0.5\n36\t    adim(5, 'İskelet · dikmeler, üst halka, kulaklar', t5, t,\n37\t         \"Dikmeler kaide plakasının köşelerinde, panel dönüşlerine yer bırakmak için 3,5 / 15 mm içeride. Üst halka dört kenardan dikmeleri bağlar. Kulaklar paneli taşır: kaynak ayağı iskelete, delikli ayağı panel saplamasına.\",\n38\t         '4 dikme + 4 tapa · 4 üst halka profili · 22 kulak (44 dikiş)')\n39\t    # 6 paneller\n40\t    t6 = t\n41\t    for taraf, sx, sac in (('sol', -1, 'sol_yan_sac'), ('sag', 1, 'sag_yan_sac_tabla_gecisi')):\n42\t        olay(t, '%s yan sac: preslenmiş FHP-M5 saplamalar kulak deliklerine oturur%s' % ('Sol' if sx < 0 else 'Sağ', '' if sx < 0 else ' · tabla geçiş ağzı bu sacta'))\n43\t        sap = R(r'^govde_kulak_%s_.*_bag_saplama$' % taraf)\n44\t        kam(t, [sac], (sx, 0, 0))\n45\t        t = gel([sac] + sap, (sx * 0.6, 0, 0), t, 1.4) + 0.1\n46\t        olay(t, 'Pul + fiberli somun İÇERİDEN (ön açıklıktan)')\n47\t        t = somunlar(sap, t)\n48\t    olay(t, 'Üst sac 6 kulağa — üstte görünür vida yok, somunlar alttan')\n49\t    sap = R(r'^govde_kulak_ust_.*_bag_saplama$'); kam(t, ['ust_sac'], (0, 1, 0))\n50\t    t = gel(['ust_sac'] + sap, (0, 0.55, 0), t, 1.4) + 0.1\n51\t    t = somunlar(sap, t)\n52\t    olay(t, 'Arka sac arkadan: saplamalar yan / üst sacın arka dönüş deliklerinden geçer · somunlar içeriden')\n53\t    sap = R(r'^govde_bag_arka_.*_saplama$'); kam(t, ['arka_sac'], (0, 0, -1))\n54\t    t = gel(['arka_sac'] + sap, (0, 0, -0.6), t, 1.5) + 0.1\n55\t    t = somunlar(sap, t) + 0.3\n56\t    adim(6, 'Paneller · yan → üst → arka', t6, t,\n57\t         \"Yan saclar kulaklara preslenmiş FHP-M5 saplamalarla oturur, pul + fiberli somun içeriden takılır (dış yüzde iz yok). Sağ yan sacta tabla geçiş ağzı vardır (TOPPING'e). Üst sac kulaklara, arka sac en son arkadan gelir.\",\n58\t         'sol yan · sağ yan (tabla geçişi) · üst · arka · M5 pul + fiberli somun')\n59\t    t = sac_tamam(t)\n60\t    t7 = t\n61\t    ac = R(r'^M__')\n62\t    olay(t, \"Açıcı satın alınır (hazır ünite). Ön açıklıktan içeri alınır, kolon flanşı kaidedeki 4 PEM M8'in üstüne indirilir\")\n63\t    kam(t, ac, (0, 0.3, 1))\n64\t    t = gel(ac, (0, 0.35, 0.9), t, 2.2) + 0.2\n65\t    olay(t, '4 × ISO 4762 M8 + DIN 125 pul — kolon flanşından kaide plakasındaki PEM somunlara (tork 25 N·m)')\n66\t    kam(t, R(r'^arayuz_acici'), (0, 1, 0.4), uzak=0.9)\n67\t    t = gel(R(r'^arayuz_acici'), (0, 0.12, 0), t, 0.7, 0.15) + 0.6\n68\t    adim(7, 'Açıcı (dönme kafası) montaj tabanına', t7, t,\n69\t         \"A'nın tek mekanizması satın alınan hamur açıcıdır. Kolon flanşı (90 × 125 eksen, 4 × Ø9) kaide plakasındaki PEM SP-M8'lere cıvatalanır. Açıcıya bu istasyonda kablo / hava bağlanmaz (kural); X ekseni motoru TOPPING ucundadır.\",\n70\t         'açıcı ünitesi (kolon + dönme kafası + koni) · 4 × M8 + DIN 125')\n71\t    # 8 kapak\n72\t    t8 = t\n73\t    KAP = sorted(a for a in P if a.startswith('onyuz_kapak_A') and not re.search(r'mentese_\\d+_sabit|basac_\\d+$', a))\n74\t    olay(t, '3 gizli menteşe gövdesi sol ön dikmeye (önden) + 2 × M5 vida içeriden')\n75\t    kam(t, R(r'mentese_\\d_sabit'), (0, 0, 1), uzak=1.1)\n76\t    t = gel(R(r'^onyuz_kapak_A_mentese_\\d_sabit$'), (0, 0, 0.15), t, 0.7, 0.15)\n77\t    t = gel(R(r'^onyuz_kapak_A_mentese_\\d_sabit_vida_[ab]$'), (0.06, 0, 0), t, 0.45, 0.06)\n78\t    olay(t, '3 bas-aç mandalı sağ ön dikmeye geçme')\n79\t    t = gel(R(r'^onyuz_kapak_A_basac_\\d$'), (0, 0, 0.12), t, 0.6, 0.12) + 0.2\n80\t    t = kapak_alt('onyuz_kapak_A', KAP, t, 'onyuz_kapak_A_ic_tava', r'^onyuz_kapak_A_mentese_\\d_pem_[ab]$', r'^onyuz_kapak_A_karsilik_\\d$',\n81\t                  r'^onyuz_kapak_A_mentese_\\d_kanat$', r'^onyuz_kapak_A_mentese_\\d_kanat_vida_[ab]$', r'^onyuz_kapak_A_kose_kaynagi_\\d$')\n82\t    olay(t, 'Kapak bas-aç ile açılır: menteşe ekseni x 736 · z 79, 0 → 100° → kapanır')\n83\t    kam(t, ['onyuz_kapak_A'], (1, 0, 1), uzak=2.6, yon=(1.2, 0.6, 1.4))\n84\t    kapak_doner(KAP, (0.736, 0.079), -100.0, t, t + 2.0, t + 3.0, t + 5.0)\n85\t    t += 5.6\n86\t    adim(8, 'Kapak · menteşe · bas-aç', t8, t,\n87\t         \"Menteşe gövdeleri sol ön dikmenin içine gömülür. Kapak tezgâhta kurulur: iç tava + karşılıklar + menteşe kanatları, üstüne dış tava (köşeler TIG). Kapak önden asılır; kulp yok, 3 bas-aç ile açılır.\",\n88\t         '3 gizli menteşe · 6 × M5 · 3 bas-aç · dış tava 1,5 · iç tava 1,0 · 3 karşılık · 4 köşe kaynağı')\n89\t    # 9 saha\n90\t    t9 = t\n91\t    GHOST_T.append(round(t, 2))\n92\t    olay(t, 'Sahada: A, B dolabının üstüne oturur — 6 × M8 kaide borusunun içinden B tavanına (B silik)')\n93\t    GHOST.append([0.736, 4.4, 0.106, 0.788, -0.83, 0.039])\n94\t    GHOST.append([1.436, 2.5, 0.788, 2.2, -0.83, 0.079])\n95\t    kam(t, R(r'^arayuz_ab'), (0, 1, 0.3))\n96\t    t = gel(R(r'^arayuz_ab\\d*_pul$'), (0, 0.12, 0), t, 0.5, 0.08)\n97\t    t = gel(R(r'^arayuz_ab'), (0, 0.18, 0), t, 0.6, 0.08) + 0.2\n98\t    olay(t, 'Silikon servis tapaları Ø16 deliklere bastırılır')\n99\t    t = yerinde(R(r'^kaide_servis_tapasi'), t, 0.5, 0.1) + 0.2\n100\t    olay(t, 'A → TOPPING: 4 × M8 × 16 + DIN 9021, A içinden sağ yan sactaki Ø9 deliklerden (TOPPING silik)')\n101\t    kam(t, R(r'^arayuz_m8_T'), (1, 0, 0))\n102\t    t = gel(R(r'^arayuz_m8_T.*_pul$'), (-0.08, 0, 0), t, 0.5, 0.1)\n103\t    t = gel(R(r'^arayuz_m8_T\\d*(_-?\\d+)*$'), (-0.1, 0, 0), t, 0.6, 0.1) + 0.2\n104\t    olay(t, 'Folyo sökülür · A tamam')\n105\t    kam(t, None); t += 2.5\n106\t    for a in R(r'^arayuz_'): GIZLI.add(a)\n107\t    adim(9, 'Saha · B ve TOPPING bağlantısı', t9, t,\n108\t         \"A, B dolabının tavanına kaide borusunun içinden 6 × M8 ile bağlanır (servis delikleri silikon tapayla kapanır). TOPPING ile 4 × M8 A içinden. Tabla rayının 4 × M6 cıvatası ray TOPPING ile geldiğinde takılır (bu sayfada gösterilmez).\",\n109\t         '6 × M8 × 25 + DIN 9021 (B) · 6 silikon tapa · 4 × M8 × 16 (TOPPING)')\n110\t    return t\n111\t\n112\t\n113\t\n114\t# ------------------------------------------------------------------ ortak: sac + üstündeki saplamalar · diğer parçalar\n115\tSAPLAMA_RX = r'(_saplama|_pem_?[ab]?|_pem_M\\d.*|_pem_m8.*|pem_m8_.*|_pem)$'\n116\t\n117\t\n118\tdef sahip_ata(panel_sira):\n119\t    \"\"\"her saplama/PEM → zarfı onu içeren SON panel (K: arka sacın saplamaları yan sacın dönüş deliklerinden geçer)\"\"\"\n120\t    own = {}\n121\t    adaylar = [a for a in P if P[a]['kay'] == 'sac' and (re.search(SAPLAMA_RX, a) or re.match(r'^ray_pem_[0-9_]+$', a)) and P[a]['tur'] != 'arayuz']\n122\t    for s in adaylar:\n123\t        c = cent(s)\n124\t        for pnl in panel_sira:\n125\t            lo, hi = bbox([pnl])\n126\t            if np.all(c >= lo - 0.004) and np.all(c <= hi + 0.004): own[s] = pnl\n127\t    return own\n128\t\n129\t\n130\tSAHIP = {}\n131\t\n132\t\n133\tdef panel(sacs, d, t, metin, sure=1.4, somun_metin='Pul + fiberli somun içeriden', kamd=None):\n134\t    sap = sorted(s for s, p in SAHIP.items() if p in sacs and s not in GOR)\n135\t    olay(t, metin); kam(t, sacs, kamd or d)\n136\t    t = gel(list(sacs) + sap, d, t, sure, 0) + 0.1\n137\t    vs = [s for s in sap if s.endswith('_saplama')]\n138\t    if vs:\n139\t        olay(t, somun_metin); t = somunlar(vs, t)\n140\t    return t\n141\t\n142\t\n143\tNAD = {'E_SARJOR': 'şarjör + asansör', 'E_BESLEYICI': 'besleyici (vakum)', 'E_KALIP': 'katlama kalıbı', 'E_KOPRU': 'köprü', 'E_PISTON': 'piston',\n144\t       'E_PARMAK': 'ön parmak', 'E_KAPAK': 'kapak katlayıcı', 'E_KOSE': 'köşe katlayıcı + kaldırıcı', 'E_COP': 'robot çöpü', 'DUZ_E_OLUK': 'çöp oluğu',\n145\t       'B_SOGUTMA': 'soğutma grubu (Secop)', 'DUZ_B_SERPANTIN': 'evaporatör serpantini', 'B_DEPO': 'soğuk depo çekmecesi',\n146\t       'U_F_HAVALANDIRMA': 'havalandırma fanı + panjur', 'TOPPING_MODUL': 'açıcı', 'TOPPING_DONER': 'açıcı konisi', 'E_KUTU': 'kutu',\n147\t       'E_ELEKTRIK': 'E elektrik', 'U_F_GOVDE': 'U_F kapak elemanı'}\n148\t\n149\t\n150\tdef sinif(a):\n151\t    p = P[a]; c = p['m']; dg = ANA_BILGI[a]['dugum']\n152\t    if c == 'urun': return 'urun'\n153\t    if ANA_BILGI[a]['kpk'] or c == 'kapak_s': return 'kapak'\n154\t    if c == 'hava': return 'hava'\n155\t    if c in ('guc', 'bilgi'): return 'kablo'\n156\t    if c == 'fis': return 'fis'\n157\t    if c == 'kanal': return 'kanal'\n158\t    if 'ELEKTRIK' in dg or dg.startswith('ELK_'): return 'elektrik'\n159\t    return 'mek'\n160\t\n161\t\n162\tdef diger(t, no, adlar, mek_metin):\n163\t    \"\"\"ana GLB gruplarını sırayla yerleştirir: mekanizmalar → elektrik kutusu + kanallar → kablolar + fiş → hava → kapaklar → ürün\"\"\"\n164\t    S = {}\n165\t    for a in adlar:\n166\t        if a in GOR or a in GIZLI: continue\n167\t        S.setdefault(sinif(a), []).append(a)\n168\t    if S.get('mek'):\n169\t        t0 = t; kam(t, S['mek'], (0, 0.2, 1))\n170\t        grp = {}\n171\t        for a in S['mek']: grp.setdefault(ANA_BILGI[a]['dugum'].split('__')[0], []).append(a)\n172\t        sira = sorted(grp, key=lambda k: (round(bbox(grp[k])[0][1], 1), bbox(grp[k])[0][0]))\n173\t        for k in sira:\n174\t            olay(t, '%s — ön açıklıktan içeri, PEM saplamalara pul + fiberli somunla' % NAD.get(k, k.replace('_', ' ').lower()))\n175\t            kam(t, grp[k], (0, 0.2, 1))\n176\t            t = gel(sorted(grp[k]), (0, 0.15, 0.85), t, 1.3) + 0.25\n177\t        adim(no, 'Mekanizmalar', t0, t + 0.3, mek_metin, ' · '.join(NAD.get(k, k) for k in sira)); t += 0.3; no += 1\n178\t    el = S.get('elektrik', []) + S.get('kanal', [])\n179\t    if el:\n180\t        t0 = t\n181\t        if S.get('elektrik'):\n182\t            olay(t, 'Elektrik kutusu / pano, DIN ray cihazları ve sensör braketleri yerine (PEM saplamalara)')\n183\t            kam(t, S['elektrik'], (0, 0.2, 1))\n184\t            t = gel(sorted(S['elektrik']), (0, 0.1, 0.7), t, 1.3, min(0.15, 3.0 / max(1, len(S['elektrik'])))) + 0.3\n185\t        if S.get('kanal'):\n186\t            olay(t, 'İç kablo kanalları duvar / tavan boyunca (PEM saplamalı kanal ayakları)')\n187\t            kam(t, S['kanal'], (0, 0.2, 1))\n188\t            t = gel(sorted(S['kanal']), (0, 0, 0.5), t, 1.2, 0.15) + 0.3\n189\t        adim(no, 'Elektrik kutusu + iç kanallar', t0, t + 0.3, \"Elektrik kutusu (sürücüler, G/Ç, sigorta) istasyonun kendi gövdesinde, PEM saplamalara oturur. Kablolar yalnız kanal içinden yürür; kanal kapakları kablolar çekildikten sonra kapanır.\",\n190\t             'elektrik kutusu · DIN ray cihazları · sensör braketleri · iç kanallar'); t += 0.3; no += 1\n191\t    kb = S.get('kablo', []) + S.get('fis', [])\n192\t    if kb:\n193\t        t0 = t\n194\t        guc = [a for a in S.get('kablo', []) if P[a]['m'] == 'guc']; bil = [a for a in S.get('kablo', []) if P[a]['m'] == 'bilgi']\n195\t        if S.get('fis'):\n196\t            olay(t, 'Gömme fiş paneli: Harting / M12 soketler + kablo rakorları (dışarıdan, contalı)')\n197\t            kam(t, S['fis'], (0, 0.1, 1))\n198\t            t = gel(sorted(S['fis']), (0, 0, 0.35), t, 1.0, 0.1) + 0.3\n199\t        if guc:\n200\t            olay(t, 'Güç kabloları (KIRMIZI) — fiş panelinden kutuya, kutudan motorlara, kanal içinden')\n201\t            kam(t, guc, (0, 0.2, 1)); t = gel(sorted(guc), (0, 0, 0.45), t, 1.4, 0.12) + 0.3\n202\t        if bil:\n203\t            olay(t, 'Bilgi kabloları (MAVİ) — sensör, enkoder, EtherCAT / G/Ç, ayrı kanal bölmesinden')\n204\t            kam(t, bil, (0, 0.2, 1)); t = gel(sorted(bil), (0, 0, 0.45), t, 1.4, 0.12) + 0.3\n205\t        adim(no, 'Kablolar + fiş paneli', t0, t + 0.3, \"İstasyona dışarıdan yalnız gömme fiş panelinden girilir (Harting güç, M12 bilgi). İçeride güç (kırmızı) ve bilgi (mavi) kabloları ayrı kanal bölmelerinden yürür; uçlar yüksük + etiketle klemense.\",\n206\t             'fiş paneli · güç kabloları (kırmızı) · bilgi kabloları (mavi)'); t += 0.3; no += 1\n207\t    if S.get('hava'):\n208\t        t0 = t; olay(t, 'Hava hortumları (YEŞİL) — valf adasından silindir / vakuma, kanal ve kelepçelerle')\n209\t        kam(t, S['hava'], (0, 0.2, 1)); t = gel(sorted(S['hava']), (0, 0, 0.45), t, 1.4, 0.12) + 0.6\n210\t        adim(no, 'Hava hattı', t0, t, \"Basınçlı hava gömme rakordan girer, şartlandırıcı + valf adasından hortumlarla tüketicilere gider. Hortumlar kablo kanalının hava bölmesinden ve kelepçelerle.\",\n211\t             'rakor · valf adası · hava hortumları (yeşil)'); no += 1\n212\t    if S.get('kapak'):\n213\t        t0 = t; olay(t, 'Kapak elemanları önden takılır (menteşe, bas-aç, fitil)')\n214\t        kam(t, S['kapak'], (0, 0.1, 1)); t = gel(sorted(S['kapak']), (0, 0, 0.5), t, 1.3, 0.12) + 0.6\n215\t        adim(no, 'Kapak elemanları', t0, t, \"Kapak elemanları en son, iç montaj ve kablolama bittikten sonra takılır: menteşe yarıları, bas-aç mandalları ve fitiller.\", 'menteşe · bas-aç · fitil'); no += 1\n216\t    if S.get('urun'):\n217\t        t0 = t; olay(t, 'Ürün / sarf yüklenir (görsel)')\n218\t        kam(t, S['urun'], (0, 1, 0.6)); t = gel(sorted(S['urun']), (0, 0.35, 0.2), t, 1.2, min(0.1, 3.0 / len(S['urun']))) + 0.6\n219\t        adim(no, 'Ürün', t0, t, \"En son ürün ve sarf malzemesi yüklenir — devreye alma testi için.\", 'ürün (görsel)'); no += 1\n220\t    return t, no\n221\t\n222\t\n223\tdef seq_B():\n224\t    global SAHIP\n225\t    BASLIK.update(kod='B')\n226\t    SECIM[:] = [('dis_sol_yan', 1), ('dis_taban_1', 1), ('dis_arka_1', 1), ('dis_tavan_2', 1), ('ic_sol_duvar', 1), ('ic_taban_1', 1), ('bolme_1_sac_a', 1),\n227\t                ('isi_kalkani_u', 1), ('on_cerceve_1', 1), ('kosebent_sol_alt_2', 1)]\n228\t    t = kartlar(0.0, 'dış kabuk 2 parçalı + ek lamaları · iç kabuk · 9 bölme sacı · 14 kovan · ısı kalkanı · ön çerçeve 2 parça · 126 ray PEM SP-M5')\n229\t    PANEL = ['dis_taban_1', 'dis_taban_2', 'dis_sol_yan', 'dis_sag_yan', 'dis_arka_1', 'dis_arka_2', 'ic_taban_1', 'ic_taban_2', 'ic_sol_duvar', 'teknik_sol_duvar',\n230\t             'ic_arka_1', 'ic_arka_2'] + R(r'^bolme_\\d_sac_[ab]$') + ['ic_tavan_1', 'ic_tavan_2', 'dis_tavan_1', 'dis_tavan_2']\n231\t    SAHIP = sahip_ata(PANEL)\n232\t    t4 = t; kam(t, None)\n233\t    olay(t, '14 ayarlı ayak zemine, terazide')\n234\t    t = gel(R(r'^M__B_KASA__celik'), (0, 0.25, 0), t, 1.0) + 0.1\n235\t    olay(t, \"Alt şase + PU'ya gömülecek dikme / kirişler (B_MODULER) + GFRP pedler — ayakların üstüne\")\n236\t    t = gel(R(r'^M__B_MODULER__'), (0, 0.5, 0), t, 1.5, 0.2) + 0.1\n237\t    olay(t, \"Taşıyıcı (K'nın oturduğu çapraz kirişler)\")\n238\t    t = gel(R(r'^M__B_TASIYICI__'), (0, 0.4, 0), t, 1.1) + 0.5\n239\t    adim(4, 'Ayaklar · alt şase · gömülü iskelet', t4, t,\n240\t         \"B dolabı kendi şasesi üstünde kurulur: ayaklar, alt şase boyunaları, PU'ya gömülecek dikme ve kirişler (A ve K bunların üstüne oturur) ve aradaki GFRP ısı köprüsü pedleri. Sac kabuk bu iskeletin çevresine kapanır.\",\n241\t         '14 ayak · alt şase + dikmeler (B_MODULER) · GFRP ped · taşıyıcı kirişler')\n242\t    t5 = t\n243\t    t = panel(['dis_taban_1', 'dis_taban_2'], (0, 0.4, 0), t, 'Dış taban 2 parça (ek x 2091) dikmelerin geçişlerinden iner')\n244\t    t = gel(['dis_taban_ek_lamasi'], (0, 0.15, 0), t, 0.7) + 0.1\n245\t    olay(t, '10 × M8 × 20 + DIN 9021 içeriden şaseye (köpüklemeden ÖNCE)')\n246\t    kam(t, R(r'^arayuz_sase'), (0, 1, 0.3))\n247\t    t = gel(R(r'^arayuz_sase.*_pul$'), (0, 0.12, 0), t, 0.45, 0.05)\n248\t    t = gel(R(r'^arayuz_sase'), (0, 0.18, 0), t, 0.5, 0.05) + 0.2\n249\t    olay(t, 'Alt köşebentler (yan sacı tabana bağlar)')\n250\t    t = gel(R(r'^kosebent_s(ol|ag)_alt'), (0, 0.2, 0), t, 0.7, 0.06) + 0.1\n251\t    t = panel(['dis_sol_yan'], (-0.6, 0, 0), t, 'Sol dış yan sac (yalnız arka dönüş) — köşebentlere')\n252\t    t = panel(['dis_sag_yan'], (0.6, 0, 0), t, 'Sağ dış yan sac — E kabuğuna yüz yüze, dış yüz düz')\n253\t    t = panel(['dis_arka_1', 'dis_arka_2'], (0, 0, -0.6), t, 'Dış arka 2 parça arkadan + ek laması')\n254\t    t = gel(['dis_arka_ek_lamasi'], (0, 0, -0.15), t, 0.7) + 0.1\n255\t    olay(t, 'Ek yerleri ve arka köşeler gıda silikonuyla kapatılır (köpük sızmasın)')\n256\t    t = yerinde(R(r'^ek_yeri_silikon_(taban|arka)$') + R(r'^arka_kose_silikonu'), t, 0.5, 0.15) + 0.4\n257\t    adim(5, 'Dış kabuk · taban → yanlar → arka', t5, t,\n258\t         \"Dış kabuk iki parçalıdır (levha boyu 3000 sınırı): taban ve arka x 2091'de ek lamasıyla birleşir. Yan saclar tava değil, yalnız arka dönüşlü; tabana köşebentle bağlanır. Şase cıvataları köpüklemeden önce içeriden takılır.\",\n259\t         'dış taban 2 + ek laması · 10 × M8 şase cıvatası · 8 alt köşebent · 2 yan · dış arka 2 + ek laması · silikon')\n260\t    t6 = t\n261\t    t = panel(['ic_taban_1', 'ic_taban_2'], (0, 0, 0.9), t, 'İç taban 2 parça önden — dikme geçişleri 31 × 31')\n262\t    t = panel(['ic_sol_duvar', 'teknik_sol_duvar'], (0, 0, 0.9), t, \"İç sol duvar + teknik bölme duvarı — ray PEM'leri düz sacta basılı geldi\")\n263\t    t = panel(['ic_arka_1', 'ic_arka_2'], (0, 0, 0.9), t, 'İç arka 2 parça · iç köşeler TIG + taşlama')\n264\t    olay(t, \"Bölme sacları (çift cidar a/b) önden — her yüzde 3 ray PEM'i SP-M5\")\n265\t    kam(t, R(r'^bolme_\\d_sac'), (0, 0.3, 1))\n266\t    for b in sorted(set(re.sub(r'_sac_[ab]$', '', a) for a in R(r'^bolme_\\d_sac_[ab]$'))):\n267\t        sacs = R(r'^%s_sac_[ab]$' % b)\n268\t        sap = sorted(s for s, p in SAHIP.items() if p in sacs and s not in GOR)\n269\t        t = gel(sacs + sap, (0, 0, 0.9), t, 1.0, 0) + 0.15\n270\t    olay(t, 'Kablo / gider kovanları (U, L) bölmelere · köpüğe açılan köşe ağızları TIG')\n271\t    t = gel(R(r'^bolme_\\d_kovan_\\d+(_ust_L)?$'), (0, 0.15, 0), t, 0.7, 0.05)\n272\t    t = kaynak(R(r'kovan_\\d+_kose_kaynagi'), t) + 0.2\n273\t    t = panel(['ic_tavan_1', 'ic_tavan_2'], (0, 0, 0.9), t, 'İç tavan 2 parça önden')\n274\t    olay(t, 'Isı kalkanı (fırın altı): U sac + ışınım sacı + 12 PTFE / cam elyaf takoz')\n275\t    kam(t, R(r'^isi_kalkani'), (0, 0.4, 1))\n276\t    t = gel(R(r'^isi_kalkani_takozu'), (0, 0.15, 0), t, 0.5, 0.04)\n277\t    t = gel(R(r'^isi_kalkani_(u|isinim)'), (0, 0, 0.9), t, 1.2, 0.2) + 0.1\n278\t    t = gel(R(r'^tk_ara_arka_sac'), (0, 0, 0.6), t, 0.9) + 0.4\n279\t    adim(6, 'İç kabuk · bölmeler · kovanlar · ısı kalkanı', t6, t,\n280\t         \"İç kabuk ve bölme ön kenarları ön çerçeveye ALIN gelir. Çekmece raylarının 126 PEM SP-M5'i duvar ve bölme saclarına düz hâlde basılmıştır. Bölmelerde kanal ve gider için 1 mm boşluklu U / L kovanlar; köpüğe açılan köşe ağızları kaynakla kapanır. Fırın altına ısı kalkanı.\",\n281\t         'iç taban 2 · iç sol duvar · teknik duvar · iç arka 2 · 9 bölme sacı · 14 kovan · iç tavan 2 · ısı kalkanı + 12 takoz')\n282\t    t7 = t\n283\t    olay(t, 'Üst köşebentler')\n284\t    t = gel(R(r'^kosebent_s(ol|ag)_ust'), (0, 0.2, 0), t, 0.7, 0.06) + 0.1\n285\t    t = panel(['dis_tavan_1', 'dis_tavan_2'], (0, 0.5, 0), t, 'Dış tavan 2 parça üstten (A ve K bağlantı delikleri Ø9 hazır)')\n286\t    t = gel(R(r'^dis_tavan_ek_lamasi'), (0, 0.15, 0), t, 0.6, 0.08) + 0.1\n287\t    olay(t, 'Köpüklemeden önce: PEM gövdelerine PE köpük kapağı, ek yeri + gider silikonları')\n288\t    kam(t, None)\n289\t    t = yerinde(R(r'_kopuk_kapagi$'), t, 0.4, 0.01)\n290\t    t = yerinde(R(r'^ek_yeri_silikon_tavan$') + R(r'gider_silikonu'), t, 0.4, 0.08) + 0.3\n291\t    olay(t, 'PU köpükleme (SARI): kalıpta, iç / dış kabuk arası 40 kg/m³ — 24 saat kür')\n292\t    pu = [a for a in P if P[a]['tur'] == 'pu' and a not in GOR]\n293\t    t = yerinde(sorted(pu), t, 1.6, 0.12) + 0.6\n294\t    adim(7, 'Tavan · köpük hazırlığı · PU köpükleme', t7, t,\n295\t         \"Tavan kapanınca gövde köpükleme kalıbına girer. Önce bütün PEM gövdelerine PE köpük kapağı, ek yerlerine ve gider halkalarına silikon; sonra iç ve dış kabuk arası PU ile doldurulur (sahnede sarı; normalde görünmez).\",\n296\t         '7 üst köşebent · dış tavan 2 + 3 ek laması · 126 köpük kapağı · silikonlar · 19 PU bloğu')\n297\t    t8 = t\n298\t    olay(t, 'Ön çerçeve 2 parça (430) önden — ek x 2091 · 35 mm ek laması arkasında')\n299\t    kam(t, R(r'^on_cerceve'), (0, 0.2, 1))\n300\t    t = gel(['on_cerceve_ek_lamasi'], (0, 0, 0.5), t, 0.8) + 0.1\n301\t    t = gel(R(r'^on_cerceve_\\d$'), (0, 0, 0.7), t, 1.3, 0.3) + 0.5\n302\t    adim(8, 'Ön çerçeve', t8, t, \"Kalıptan çıkan gövdeye ön çerçeve takılır; iç kabuk ve bölmeler çerçeveye alın gelir (açık oluk / görünür PU yok).\",\n303\t         'ön çerçeve 2 parça + ek laması')\n304\t    t = sac_tamam(t)\n305\t    rest = R(r'^M__')\n306\t    raylar = [a for a in rest if re.match(r'^M__CEK_.*__celik__\\d+$', a)]\n307\t    cek_govde = [a for a in rest if a.startswith('M__CEK_') and a not in raylar and P[a]['m'] not in ('urun', 'kapak_s') and not ANA_BILGI[a]['kpk']]\n308\t    cek_on = [a for a in rest if a.startswith('M__CEK_') and (P[a]['m'] == 'kapak_s' or ANA_BILGI[a]['kpk'])]\n309\t    no = 9\n310\t    t, no = diger(t, no, [a for a in rest if not a.startswith('M__CEK_') and sinif(a) == 'mek'],\n311\t                  \"Soğutma grubu teknik bölmeye, evaporatör ve soğuk depo yerine; hepsi gövdedeki PEM saplamalara pul + fiberli somunla.\")\n312\t    t, no = diger(t, no, [a for a in rest if not a.startswith('M__CEK_') and sinif(a) in ('elektrik', 'kanal', 'kablo', 'fis', 'hava')], '')\n313\t    t0 = t\n314\t    olay(t, '42 sabit çekmece rayı önden duvar / bölme yüzlerine')\n315\t    kam(t, raylar, (0, 0.3, 1))\n316\t    t = gel(sorted(raylar), (0, 0, 0.8), t, 1.0, 0.04) + 0.2\n317\t    olay(t, \"Her ray 3 × DIN 7991 M5 × 10 havşa başlı — duvardaki PEM SP-M5'lere\")\n318\t    t = gel(R(r'^arayuz_ray'), (0, 0, 0.12), t, 0.4, 0.008) + 0.4\n319\t    adim(no, 'Çekmece rayları', t0, t, \"Sabit raylar duvar ve bölme saclarındaki PEM SP-M5'lere havşa başlı vidayla bağlanır (sacın arkası köpüklü olduğu için somun yok — PEM şart).\",\n320\t         '42 sabit ray · 126 × M5 × 10 havşa başlı'); no += 1\n321\t    t0 = t\n322\t    olay(t, 'Çekmeceler (tahrik + kızak + kasa) önden raylara sürülür')\n323\t    kam(t, cek_govde, (0, 0.3, 1))\n324\t    grp = {}\n325\t    for a in cek_govde: grp.setdefault(ANA_BILGI[a]['dugum'].split('__')[0], []).append(a)\n326\t    for k in sorted(grp, key=lambda k: (bbox(grp[k])[0][0], bbox(grp[k])[0][1])):\n327\t        t = gel(sorted(grp[k]), (0, 0, 0.9), t, 0.9) + 0.1\n328\t    if cek_on:\n329\t        olay(t + 0.3, 'Çekmece ön kapakları + fitiller')\n330\t        t = gel(sorted(cek_on), (0, 0, 0.4), t + 0.3, 0.8, 0.05) + 0.4\n331\t    adim(no, 'Çekmeceler + ön kapaklar', t0, t, \"Her çekmece kendi tahrik motoru ve kızağıyla hazır gelir, önden raya sürülür; ön kapak ve fitil en son.\",\n332\t         '%d çekmece · ön kapaklar · fitiller' % len(grp)); no += 1\n333\t    t, no = diger(t, no, R(r'^M__'), '')\n334\t    olay(t, 'B tamam'); kam(t, None); t += 2.0\n335\t    for a in R(r'^arayuz_'): GIZLI.add(a)\n336\t    return t\n337\t\n338\t\n339\tdef seq_E():\n340\t    global SAHIP\n341\t    BASLIK.update(kod='E')\n342\t    SECIM[:] = [('sol_sac_pizza_penceresi', 1), ('sag_sac', 1), ('arka_sac', 1), ('ust_sac', 1), ('taban_sac_3', 1), ('onyuz_kapak_E_ust_sol', 1),\n343\t                ('onyuz_kapak_E_alt_sag_ic_tava', 1), ('sarjor_yan_kapisi', 1), ('govde_kulak_sol_on_1100', 18)]\n344\t    t = kartlar(0.0, 'taban 3 mm · ön kasa 3 dikme + 2 kayıt · yan / arka / üst sac · 4 kapak dış + iç tava · şarjör yan kapısı · kulaklar')\n345\t    PANEL = ['taban_sac_3', 'sol_sac_pizza_penceresi', 'sag_sac', 'arka_sac', 'ust_sac']\n346\t    SAHIP = sahip_ata(PANEL)\n347\t    t4 = t; kam(t, None)\n348\t    olay(t, '6 ayarlı ayak (GN 20 sınıfı M12) + kontra somun')\n349\t    t = gel(R(r'^ayak_\\d+(_kontra)?$'), (0, 0.2, 0), t, 0.8, 0.06) + 0.1\n350\t    olay(t, 'Kaide rayları (60 × 60) + kayıtlar (40 × 60) fikstürde · uç tapaları · TIG')\n351\t    t = gel(R(r'^kaide_e_ray_(on|arka)$'), (0, 0.4, 0), t, 1.0, 0.2)\n352\t    t = gel(R(r'^kaide_e_kayit_(sol|orta|sag)$'), (0, 0.4, 0), t, 1.0, 0.15)\n353\t    t = kaynak(R(r'^kaide_e_kayit_.*kaynak'), t)\n354\t    t = gel(R(r'^kaide_e_ray_.*_tapa'), (0, 0, 0.1), t, 0.5, 0.08)\n355\t    t = gel(R(r'^kaide_e_ayak_somunu'), (0, -0.1, 0), t, 0.5, 0.05) + 0.4\n356\t    adim(4, 'Ayaklar · kaynaklı kaide', t4, t, \"Kaide 60 × 60 × 3 raylar ve 40 × 60 × 3 kayıtlardan kaynaklı çerçevedir; uçlar tapalı. Ayaklar kaide rayının altındaki somunlara vidalanır, terazide ayarlanır.\",\n357\t         '6 ayak + kontra · 2 ray + 4 tapa · 3 kayıt · ayak somunları')\n358\t    t5 = t\n359\t    t = panel(['taban_sac_3'], (0, 0.4, 0), t, 'Taban sacı 3 mm kaideye')\n360\t    olay(t, 'Taban → kaide: M8 vida + somun')\n361\t    t = gel(R(r'^kaide_e_vida_'), (0, 0.15, 0), t, 0.5, 0.06)\n362\t    t = gel(R(r'^kaide_e_somun_'), (0, -0.12, 0), t, 0.5, 0.06) + 0.1\n363\t    olay(t, 'Ön kasa: 3 dikme (sol, orta, sağ) tabana · köşe dikişleri · tepe tapaları')\n364\t    kam(t, R(r'^onyuz_dikme_'), (0, 0.2, 1))\n365\t    t = gel(R(r'^onyuz_dikme_(sol|sag|orta)$'), (0, 0.6, 0), t, 1.0, 0.2)\n366\t    t = kaynak(R(r'^onyuz_dikme_.*taban_kaynagi'), t)\n367\t    t = gel(R(r'^onyuz_dikme_.*_tapa$'), (0, 0.15, 0), t, 0.5, 0.08)\n368\t    olay(t, 'Ön kayıtlar (y 788) dikmeler arasına')\n369\t    t = gel(R(r'^onyuz_kayit_788_(sol|sag)$'), (0, 0, 0.3), t, 0.8, 0.15)\n370\t    t = kaynak(R(r'^onyuz_kayit.*kaynak'), t) + 0.1\n371\t    olay(t, 'Panel kulakları: dikme arkasına (yan) ve tabana · kulak başına 2 dikiş')\n372\t    kam(t, R(r'^govde_kulak_'), (0, 0.3, 1))\n373\t    t = gel(R(r'^govde_kulak_sol_(on|taban)_\\d+$'), (-0.25, 0, 0), t, 0.6, 0.05)\n374\t    t = gel(R(r'^govde_kulak_sag_(on|taban)_\\d+$'), (0.25, 0, 0), t, 0.6, 0.05)\n375\t    t = gel(R(r'^govde_kulak_ust_(sol|orta|sag)$'), (0, 0.25, 0), t, 0.6, 0.08)\n376\t    t = kaynak(R(r'^govde_kulak_.*_kaynak_[ab]$'), t, 0.3, 0.03)\n377\t    t = gel(R(r'^govde_kosebent_[a-z_]+$'), (0.2, 0, 0), t, 0.6) + 0.4\n378\t    adim(5, 'Taban · ön kasa · kulaklar', t5, t, \"Taban 3 mm sac kaideye cıvatalanır. Ön kasanın 3 dikmesi tabana kaynaklanır; y 788'de kayıtlar alt ve üst kapakları ayırır. Kulaklar yan ve üst sacı taşır.\",\n379\t         'taban 3 mm · 7 M8 vida + somun · 3 dikme + tapa · 2 kayıt · 39 kulak · köşebent')\n380\t    t6 = t\n381\t    t = panel(['sol_sac_pizza_penceresi'], (-0.6, 0, 0), t, \"Sol yan sac (pizza penceresi, K'dan gelen ürün için) — FHP saplamalar kulaklara\")\n382\t    t = panel(['sag_sac'], (0.6, 0, 0), t, 'Sağ yan sac (şarjör kapısı açıklığı) — saplamalar kulaklara')\n383\t    t = panel(['arka_sac'], (0, 0, -0.6), t, 'Arka sac arkadan: taban üstünden başlar, alt iç dönüş tabana')\n384\t    t = panel(['ust_sac'], (0, 0.55, 0), t, 'Üst sac yan sacların ARASINA oturur (21,5 aşağı dönüş) · U_KE için 3 × PEM SP-M8')\n385\t    olay(t, 'Şarjör kapısı taşıyıcı lamaları (arka sacta menteşe, yan sacta bas-aç)')\n386\t    kam(t, R(r'^sarjor_yan_kapisi_(mentese|basac)_lamasi'), (1, 0, 0))\n387\t    t = gel(R(r'^sarjor_yan_kapisi_(mentese|basac)_lamasi$'), (0.2, 0, 0), t, 0.7, 0.1)\n388\t    vs = R(r'^govde_bag_kapi_.*_saplama$')\n389\t    t = gel(vs, (0.15, 0, 0), t, 0.5, 0.05)\n390\t    t = somunlar(vs, t)\n391\t    kal = R(r'_saplama$')\n392\t    if kal:\n393\t        olay(t, 'Kalan köşe bağlantıları (köşebent) · pul + somun')\n394\t        t = gel(kal, (0, 0, 0.1), t, 0.5, 0.05); t = somunlar(kal, t)\n395\t    t = yerinde(R(r'^govde_pem_m8_ust'), t, 0.4, 0.05) + 0.3\n396\t    adim(6, 'Paneller · yan → arka → üst', t6, t, \"Yan saclar kulaklara preslenmiş FHP-M5 saplamalarla oturur, pul + fiberli somun içeriden (dışta iz yok). Arka sac arkadan, üst sac yan sacların arasına. Şarjör yan kapısının lamaları arka ve yan saca bağlanır.\",\n397\t         'sol yan (pizza penceresi) · sağ yan · arka · üst · şarjör kapısı lamaları · M5 pul + fiberli somun')\n398\t    t = sac_tamam(t)\n399\t    no = 7\n400\t    rest = R(r'^M__')\n401\t    t, no = diger(t, no, [a for a in rest if sinif(a) in ('mek', 'elektrik', 'kanal', 'kablo', 'fis', 'hava')],\n402\t                  \"Mekanizmalar alttan yukarı sırayla ön açıklıktan girer (kapaklar daha takılmadı): her biri gövdedeki PEM saplamalara (ARAYÜZ listesi) pul + fiberli somunla bağlanır.\")\n403\t    t0 = t\n404\t    olay(t, '12 gizli menteşe gövdesi dikmelere + 2 × M5 · 6 bas-aç orta dikmeye')\n405\t    kam(t, R(r'^onyuz_kapak_E_mentese_.*_sabit$'), (0, 0, 1))\n406\t    t = gel(R(r'^onyuz_kapak_E_mentese_(sol|sag)_\\d+_sabit$'), (0, 0, 0.15), t, 0.6, 0.06)\n407\t    t = gel(R(r'^onyuz_kapak_E_mentese_(sol|sag)_\\d+_sabit_vida_[ab]$'), (0, 0, 0.06), t, 0.4, 0.02)\n408\t    t = gel(R(r'^onyuz_kapak_E_basac_'), (0, 0, 0.12), t, 0.5, 0.06) + 0.2\n409\t    for kap_ad, taraf in [('onyuz_kapak_E_alt_sol', 'sol'), ('onyuz_kapak_E_alt_sag', 'sag'), ('onyuz_kapak_E_ust_sol', 'sol'), ('onyuz_kapak_E_ust_sag', 'sag')]:\n410\t        mn = '[012]' if '_alt_' in kap_ad else '[345]'\n411\t        rx_kanat = r'^onyuz_kapak_E_mentese_%s_%s_kanat$' % (taraf, mn)\n412\t        KAP = sorted(set([a for a in P if a.startswith(kap_ad) and a not in GOR] + R(rx_kanat)))\n413\t        t = kapak_alt(kap_ad, KAP, t, kap_ad + '_ic_tava', r'^%s_robot_agzi_kasa_\\w+$' % kap_ad, r'^%s_karsilik_\\d$' % kap_ad,\n414\t                      rx_kanat, r'^$', r'^%s_kose_kaynagi_\\d$' % kap_ad, etiket='%s ' % kap_ad.replace('onyuz_kapak_E_', '').replace('_', ' '))\n415\t        piv = (4.402, 0.079) if taraf == 'sol' else (5.23, 0.079)\n416\t        KAPAK_PIV[kap_ad] = (KAP, piv, -100.0 if taraf == 'sol' else 100.0)\n417\t    olay(t, 'Kapaklar bas-aç ile açılır / kapanır — sol kanatlar x 4402, sağ kanatlar x 5230 ekseninde')\n418\t    kam(t, None, yon=(0.4, 0.5, 1.2))\n419\t    for kad, (KAP, piv, aci) in KAPAK_PIV.items(): kapak_doner(KAP, piv, aci, t, t + 2.0, t + 3.0, t + 5.0)\n420\t    t += 5.5\n421\t    olay(t, 'Şarjör yan kapısı: iç tava + dış tava, menteşeler arka sactaki lamaya, bas-aç yan sactaki lamaya')\n422\t    kam(t, ['sarjor_yan_kapisi'], (1, 0, 0))\n423\t    t = gel(R(r'^sarjor_yan_kapisi_mentese_?\\d*$'), (0.12, 0, 0), t, 0.6, 0.1)\n424\t    t = gel(R(r'^sarjor_yan_kapisi'), (0.5, 0, 0), t, 1.2) + 0.5\n425\t    adim(no, 'Kapaklar · menteşe · bas-aç', t0, t, \"4 ön kapak (2 × 2) tezgâhta kurulur: iç tava + karşılıklar + menteşe kanatları, üstüne dış tava (köşeler TIG); üst sol kapakta robot ağzı kasası. Kapaklar önden asılır, kulp yok, bas-aç ile açılır. Şarjör yan kapısı sağdan.\",\n426\t         '12 gizli menteşe · 6 bas-aç · 4 kapak (dış + iç tava) · robot ağzı kasası · şarjör yan kapısı'); no += 1\n427\t    t, no = diger(t, no, R(r'^M__'), '')\n428\t    olay(t, 'E tamam'); kam(t, None); t += 2.0\n429\t    return t\n430\t\n431\t\n432\tdef seq_U():\n433\t    global SAHIP\n434\t    BASLIK.update(kod='U')\n435\t    SECIM[:] = [('ust_f_taban_sac', 1), ('ust_f_yan_sol', 1), ('ust_f_arka_sac', 1), ('ust_f_tavan_sac', 1), ('ust_ke_tavan_sac', 1), ('f_ust_yan_sag', 1),\n436\t                ('f_ust_taban_levhasi', 1), ('f_ust_tavan_sac', 1), ('f_davlumbaz_bolme_duvari', 1), ('ust_f_giris_cebi', 1)]\n437\t    t = kartlar(0.0, 'F üst kabin 10 sac + 6 profil · U_F 6 sac · U_KE 5 sac · omega profiller · panjur lamelleri')\n438\t    PANEL = ['f_ust_taban_levhasi', 'f_ust_yan_sol', 'f_ust_yan_sag', 'f_ust_arka_sac', 'f_davlumbaz_bolme_duvari', 'f_ust_tavan_sac',\n439\t             'ust_f_taban_sac', 'ust_f_yan_sol', 'ust_f_yan_sag', 'ust_f_arka_sac', 'ust_f_tavan_sac', 'ust_f_giris_cebi',\n440\t             'ust_ke_taban_sac', 'ust_ke_yan_sol', 'ust_ke_yan_sag', 'ust_ke_arka_sac', 'ust_ke_tavan_sac']\n441\t    SAHIP = sahip_ata(PANEL)\n442\t    t4 = t; kam(t, R(r'^f_ust_|^onyuz_f_ust'), (0, 1, 0))\n443\t    olay(t, 'F üst kabini: 3 alt profil (ön, orta, arka) fikstürde · yan kaynaklar')\n444\t    t = gel(R(r'^f_ust_alt_profil_(on|orta|arka)$'), (0, 0.4, 0), t, 1.0, 0.2)\n445\t    t = kaynak(R(r'^f_ust_alt_profil_.*kaynagi'), t) + 0.1\n446\t    t = panel(['f_ust_taban_levhasi'], (0, 0.45, 0), t, 'Taban levhası profillerin üstüne · 15 delik kaynağı')\n447\t    t = kaynak(R(r'^f_ust_taban_levhasi_delik_kaynagi'), t, 0.35, 0.05)\n448\t    olay(t, 'Rakor + kablo kovanları tabandan; taş yünü yalıtım kılıf tavasına, kılıf perçinle tabana')\n449\t    t = gel(R(r'^f_ust_taban_(rakor|v2)_kovani$'), (0, -0.2, 0), t, 0.7, 0.15)\n450\t    t = yerinde(R(r'^f_ust_taban_yalitimi_'), t, 0.8, 0.2)\n451\t    t = gel(R(r'^f_ust_taban_yalitim_kilifi_'), (0, -0.3, 0), t, 1.0, 0.2)\n452\t    t = yerinde(R(r'^f_ust_kilif_percin_'), t, 0.3, 0.02) + 0.1\n453\t    olay(t, 'Ön üst kayıt + orta dikme + tavan kirişi (tapalı) · kaynaklar')\n454\t    t = gel(R(r'^onyuz_f_ust_ust_kayit$') + R(r'^onyuz_f_ust_dikme_\\d$'), (0, 0, 0.35), t, 0.9, 0.2)\n455\t    t = gel(R(r'^f_ust_tavan_kirisi$'), (0, 0.3, 0), t, 0.8)\n456\t    t = gel(R(r'^f_ust_tavan_kirisi_tapa$'), (0, 0, -0.1), t, 0.5)\n457\t    t = kaynak(R(r'^onyuz_f_ust_.*kaynagi|^f_ust_tavan_kirisi_kaynagi'), t) + 0.4\n458\t    adim(4, 'F üst kabini · profiller · taban · yalıtım', t4, t, \"F'nin üst kabini fırının üstündedir: 3 alt profil taban levhasını taşır, levhanın altı taş yünüyle yalıtılır (kılıf tavası perçinli). Önde üst kayıt ve orta dikme, üstte tavan kirişi.\",\n459\t         '3 alt profil · taban levhası + 15 delik kaynağı · 2 kovan · taş yünü + kılıf · ön kayıt + dikme · tavan kirişi')\n460\t    t5 = t\n461\t    t = panel(['f_ust_yan_sol'], (-0.6, 0, 0), t, 'Sol yan sac (y 788–1862, fırın bölgesi dahil) — J1 ağzı')\n462\t    t = panel(['f_ust_yan_sag'], (0.6, 0, 0), t, \"Sağ yan sac — K'dan gelen tartı / yağ hortumu geçişleri\")\n463\t    t = panel(['f_ust_arka_sac'], (0, 0, -0.6), t, 'Arka sac arkadan · köşebent')\n464\t    t = gel(R(r'^govde_fu_kosebent_[a-z_]+$'), (0, 0, -0.2), t, 0.6) + 0.1\n465\t    t = panel(['f_davlumbaz_bolme_duvari'], (0, 0.45, 0), t, 'Davlumbaz bölme duvarı (atış kanalı ile ayrılır)')\n466\t    olay(t, 'Panjur lamelleri (2 × 8) havalandırma ağzına · lamel başına 2 dikiş')\n467\t    kam(t, R(r'^f_ust_panjur_lameli_\\d_\\d$'), (0, 0.3, -1))\n468\t    t = gel(R(r'^f_ust_panjur_lameli_\\d_\\d$'), (0, 0, -0.2), t, 0.5, 0.04)\n469\t    t = kaynak(R(r'^f_ust_panjur_lameli_.*_kaynak'), t, 0.3, 0.02)\n470\t    t = panel(['f_ust_tavan_sac'], (0, 0.5, 0), t, 'Tavan sacı üstten')\n471\t    kal = R(r'^govde_fu_.*_saplama$')\n472\t    if kal:\n473\t        olay(t, 'Kalan bağlantılar · pul + somun'); t = gel(kal, (0, 0, 0.1), t, 0.5, 0.03); t = somunlar(kal, t)\n474\t    t = yerinde(R(r'^govde_fu_pem'), t, 0.4, 0.05) + 0.3\n475\t    adim(5, 'F üst kabini · yanlar · arka · bölme · panjur · tavan', t5, t, \"Yan saclar yalnız arka dönüşlü (J1/J2 kanalı için kısaltıldı); FHP saplamalı bağlantılar içeriden pul + fiberli somunla. Davlumbaz bölme duvarı, panjur lamelleri ve tavan sacı.\",\n476\t         'sol / sağ yan · arka + köşebent · davlumbaz bölme duvarı · 16 panjur lameli · tavan')\n477\t    t6 = t\n478\t    GHOST_T.append(round(t, 2))\n479\t    GHOST.extend([[2.5, 4.4, 0.106, 0.788, -0.83, 0.039], [4.0, 4.4, 0.788, 1.862, -0.83, 0.079], [4.4, 5.23, 0.0, 1.862, -0.83, 0.079]])\n480\t    olay(t, 'U_F ve U_KE sahada F üst kabini, K ve E üstüne kurulur (B, K, E silik)')\n481\t    for b, ad in (('f', 'U_F (F üstü, ana pano bölmesi)'), ('ke', 'U_KE (K + E üstü)')):\n482\t        t = panel(['ust_%s_taban_sac' % b], (0, 0.45, 0), t, '%s: taban sacı' % ad)\n483\t        t = panel(['ust_%s_yan_sol' % b], (-0.5, 0, 0), t, 'Sol yan sac')\n484\t        t = panel(['ust_%s_yan_sag' % b], (0.5, 0, 0), t, 'Sağ yan sac · taban yan kaynakları')\n485\t        t = kaynak(R(r'^ust_%s_taban_yan_kaynagi' % b), t, 0.3, 0.04)\n486\t        t = panel(['ust_%s_arka_sac' % b], (0, 0, -0.5), t, 'Arka sac arkadan')\n487\t        if b == 'f': t = panel(['ust_f_giris_cebi'], (0, 0, -0.3), t, 'Gömme bina giriş cebi (rakorlar cebin içinde)')\n488\t        olay(t, 'Omega profil (hazır haddeli) tavanın altına · punta')\n489\t        t = gel(R(r'^ust_%s_tavan_omegasi' % b), (0, 0.3, 0), t, 0.7)\n490\t        t = panel(['ust_%s_tavan_sac' % b], (0, 0.45, 0), t, 'Tavan yan sacların ARASINA, dört kenar dönüşlü')\n491\t        kal = R(r'^govde_%s_.*_saplama$' % b)\n492\t        if kal:\n493\t            olay(t, 'Kalan bağlantılar · pul + somun'); t = gel(kal, (0, 0, 0.1), t, 0.5, 0.03); t = somunlar(kal, t)\n494\t    olay(t, \"U_F ↔ U_KE: 3 × M8 vida + 2 pul + somun · U_F → fırın PEM'leri\")\n495\t    kam(t, R(r'^govde_f_ke_m8'), (0, 1, 0.4))\n496\t    t = gel(R(r'^govde_f_ke_m8.*_vida$'), (-0.12, 0, 0), t, 0.5, 0.1)\n497\t    t = gel(R(r'^govde_f_ke_m8.*_(pul\\d|somun)$'), (0.12, 0, 0), t, 0.5, 0.05)\n498\t    t = yerinde(R(r'^govde_f_m8_firin|^govde_ke_m8_e'), t, 0.4, 0.06) + 0.4\n499\t    adim(6, 'U_F + U_KE kabinleri', t6, t, \"Üst kabinler aynı düzende: taban → yanlar (taban yan kaynakları) → arka → omega + tavan. Tavan yan sacların arasına oturur. U_F'de bina beslemesi için gömme giriş cebi; U_F ile U_KE 3 × M8 ile birbirine bağlanır.\",\n500\t         'U_F: taban, 2 yan, arka, giriş cebi, omega, tavan · U_KE: taban, 2 yan, arka, omega, tavan · 3 × M8')\n501\t    t = sac_tamam(t)\n502\t    no = 7\n503\t    t, no = diger(t, no, R(r'^M__'), \"Ana pano U_F'nin içinde bağımsız bir paslanmaz pano ürünüdür (ayakları U_F tabanındaki PEM'lere); havalandırma fanı ve panjuru U_F arka sacına.\")\n504\t    olay(t, 'U tamam'); kam(t, None); t += 2.0\n505\t    return t\n506\t\n507\t\n508\tSEQ = {'A': seq_A, 'B': seq_B, 'E': seq_E, 'U': seq_U}\n509\tTOPLAM = round(SEQ[IST](), 2)\n510\teksik = kalan()\n511\tif eksik:\n512\t    print('YERLEŞMEYEN', len(eksik)); [print('   ', a) for a in eksik[:80]]\n513\t    raise SystemExit(1)\n514\t\n515\t# ------------------------------------------------------------------ GLB\n516\tMATAD = ['sac', 'kapak', 'profil', 'kaynak', 'baglanti', 'arayuz', 'pu', 'yalitim', 'mekanizma', 'motor', 'alu', 'koyu', 'sensor', 'elektrik',\n517\t         'kanal', 'fis', 'guc', 'bilgi', 'hava', 'kapak_s', 'urun']\n518\tMATS = [dict(name=m, pbrMetallicRoughness=dict(baseColorFactor=[0.8, 0.8, 0.8, 1], metallicFactor=0.5, roughnessFactor=0.4)) for m in MATAD]\n519\tdug, PARCA = [], {}\n520\tgos = [a for a in P if a not in GIZLI]\n521\tfor a in gos:\n522\t    V = P[a]['V']; c = np.round((V.min(0) + V.max(0)) / 2, 4)\n523\t    dug.append(dict(ad=a, V=(V - c).astype(np.float32), F=np.asarray(P[a]['F'], np.uint32), mat=MATAD.index(P[a]['m']), translation=c))\n524\t    PARCA[a] = dict(c=c.tolist(), m=P[a]['m'], bb=[np.round(V.min(0), 6).tolist(), np.round(V.max(0), 6).tolist()], g=GOR[a], h=HAR[a])\n525\t    if ROT[a]: PARCA[a]['r'] = ROT[a]\n526\t    if a in KAY: PARCA[a]['k'] = 1\n527\tyol = os.path.join(OUT, '%s_montaj.glb' % ist)\n528\tglbio.yaz(yol, dug, MATS)\n529\tf = open(yol, 'rb').read(); L = struct.unpack('<I', f[12:16])[0]; JJ = json.loads(f[20:20 + L]); rest = f[20 + L:]\n530\tfor nd, d in zip(JJ['nodes'], dug): nd['translation'] = [float(x) for x in d['translation']]\n531\tjs = json.dumps(JJ, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\n532\twhile len(js) % 4: js += b' '\n533\tf = struct.pack('<III', 0x46546C67, 2, 12 + 8 + len(js) + len(rest)) + struct.pack('<II', len(js), 0x4E4F534A) + js + rest\n534\topen(yol, 'wb').write(f); boy = len(f)\n535\t\n536\tsay = {}\n537\tfor a in gos:\n538\t    g = 'ana:' + P[a]['m'] if P[a]['kay'] == 'ana' else P[a]['tur']\n539\t    say[g] = say.get(g, 0) + 1\n540\tACI = acinim_liste(SECIM)\n541\tOUTJ = dict(surum='%s_montaj_v1' % ist, ist=IST, tarih='4 Eki 2026', kaynak='gece2/adim5/%s_sac_v1.glb (h3_%s_sac_v1) + hat3_v8zq.glb (gövde dışı, salt okunur)' % (IST, ist),\n542\t            birim='m', toplam=TOPLAM, baslik=BASLIK, zarf=ZARF.round(4).tolist(), ghost=GHOST, ghost_t=GHOST_T[0] if GHOST_T else None,\n543\t            adimlar=ADIM, olaylar=OLAY, kamera=KAM, parcalar=PARCA, acinim=ACI, montaj_sirasi=MONTAJ_SIRASI,\n544\t            sayim=dict(gosterilen=len(gos), sac_parca=sum(1 for a in gos if P[a]['kay'] == 'sac'), ana_grup=sum(1 for a in gos if P[a]['kay'] == 'ana'),\n545\t                       gizli=len(GIZLI), ucgen=int(sum(len(P[a]['F']) for a in gos)), grup=say),\n546\t            ana_gruplar=ANA_BILGI)\n547\tjson.dump(OUTJ, open(os.path.join(OUT, '%s_montaj.json' % ist), 'w', encoding='utf-8'), ensure_ascii=False, separators=(',', ':'))\n548\tprint(IST, 'parça', len(gos), 'gizli', len(GIZLI), 'üçgen', OUTJ['sayim']['ucgen'], 'GLB %.2f MB' % (boy / 1e6), 'süre %.1f s' % TOPLAM, 'adım', len(ADIM))\n549\tprint(say)\n550\t"}]},"uuid":"52061ef7-3817-4f13-a42e-2b9c657ef702","timestamp":"2026-10-04T01:47:29.237Z","sourceToolAssistantUUID":"753f97ff-bf3d-478e-94c1-239af5ece6f3","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE\\AUTOKITCH_COORDINATION\\worktrees\\claude-hat3-v8"