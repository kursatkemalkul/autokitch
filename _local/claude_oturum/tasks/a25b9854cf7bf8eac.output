{"parentUuid":"59570ff1-998f-4155-b4b1-0c990487876d","isSidechain":true,"promptId":"6d13b065-9608-42c4-83ca-508fc3c4db72","agentId":"a25b9854cf7bf8eac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PV3AnAhk8naWZRt6633GMA","type":"tool_result","content":"1600\t    \"\"\"nokta: baş oturma yüzeyi merkezi (havşada dış yüz) · eksen: uca doğru\"\"\"\n1601\t    d = D_NOM[dis]; ds = d * 0.98\n1602\t    if std in (\"ISO7380\", \"ISO 7380-1\"):\n1603\t        dk, k, s = ISO7380[dis]\n1604\t        prof = [V(0, 0, 0), V(dk / 2, 0, 0), V(dk / 2, 0, -0.15 * k), V(0.8 * dk / 2, 0, -0.65 * k), V(0.45 * dk / 2, 0, -0.93 * k), V(0, 0, -k)]\n1605\t        bas = cq.Solid.revolve(cq.Wire.makePolygon(prof, close=True), [], 360.0, V(0, 0, 0), V(0, 0, 1)).cut(_altigen(s, 0.6 * k + 0.1, -k - 0.1))\n1606\t        sh = bas.fuse(_silindir(ds / 2, boy)); ad_s = \"ISO 7380-1\"; tanim = \"Bombe başlı imbus vida %s×%g\" % (dis, boy)\n1607\t    elif std in (\"DIN7991\", \"ISO10642\", \"DIN 7991\"):\n1608\t        dk, k, s = DIN7991[dis]\n1609\t        bas = cq.Solid.makeCone(dk / 2, ds / 2, k, V(0, 0, 0), V(0, 0, 1)).cut(_altigen(s, 0.6 * k, -0.01))\n1610\t        sh = bas.fuse(_silindir(ds / 2, boy)); ad_s = \"DIN 7991 / ISO 10642\"; tanim = \"Havşa başlı imbus vida %s×%g\" % (dis, boy)\n1611\t    elif std in (\"ISO4762\", \"DIN912\", \"ISO 4762\"):\n1612\t        dk, k, s = ISO4762[dis]\n1613\t        sh = _silindir(dk / 2, k, -k).cut(_altigen(s, 0.5 * k, -k - 0.01)).fuse(_silindir(ds / 2, boy)); ad_s = \"ISO 4762\"; tanim = \"Silindir başlı imbus cıvata %s×%g\" % (dis, boy)\n1614\t    else:\n1615\t        raise ValueError(std)\n1616\t    return _bp(ad, _tasi(sh, _cerceve(nokta, eksen)), ad_s, tanim, \"%s×%g\" % (dis, boy), malzeme, birim=birim, meta=dict(dis=dis, boy=boy))\n1617\t\n1618\t\n1619\tdef somun(std, dis, nokta, eksen, ad=\"somun\", birim=\"BAGLANTI\", malzeme=\"A2\"):\n1620\t    \"\"\"nokta: oturma yüzü merkezi · eksen: somunun uzandığı yön\"\"\"\n1621\t    d = D_NOM[dis]\n1622\t    if std == \"ISO4032\": s, m = ISO4032[dis]; ad_s, tn = \"ISO 4032\", \"Altıgen somun %s\" % dis\n1623\t    elif std == \"ISO10511\": s, m = ISO10511[dis]; ad_s, tn = \"ISO 10511\", \"Fiberli (naylon halkalı) somun %s\" % dis\n1624\t    elif std == \"DIN1587\": s, m = DIN1587[dis]; ad_s, tn = \"DIN 1587\", \"Kör (kapalı) somun %s\" % dis\n1625\t    else: raise ValueError(std)\n1626\t    sh = _altigen(s, m).cut(_silindir(d / 2, (m + 0.02) if std != \"DIN1587\" else 0.75 * m, -0.01))\n1627\t    return _bp(ad, _tasi(sh, _cerceve(nokta, eksen)), ad_s, tn, \"%s s%g m%g\" % (dis, s, m), malzeme, birim=birim, meta=dict(dis=dis, s=s, m=m))\n1628\t\n1629\t\n1630\tdef pul(std, dis, nokta, eksen, ad=\"pul\", birim=\"BAGLANTI\", malzeme=\"A2\"):\n1631\t    d1, d2, h = (DIN125 if std == \"DIN125\" else DIN9021)[dis]\n1632\t    ad_s = \"DIN 125-A / ISO 7089\" if std == \"DIN125\" else \"DIN 9021 / ISO 7093\"\n1633\t    return _bp(ad, _tasi(_halka(d2 / 2, d1 / 2, h), _cerceve(nokta, eksen)), ad_s, \"%s pul %s\" % (\"Düz\" if std == \"DIN125\" else \"Geniş\", dis),\n1634\t               \"%g/%g×%g\" % (d1, d2, h), malzeme, birim=birim, meta=dict(dis=dis, d1=d1, d2=d2, h=h))\n1635\t\n1636\t\n1637\tdef pem_somun(tip, dis, nokta, eksen, sac_t, ad=\"pem_somun\", birim=\"BAGLANTI\"):\n1638\t    \"\"\"PEM kendinden kenetli somun · nokta: gövdenin oturduğu sac yüzü merkezi · eksen: gövde tarafına (sacdan dışarı).\n1639\t    Gövde yüzünün karşısı (sap ucu) sacla aynı düzlemde (flush) → karşı parça o yüze gelir.\"\"\"\n1640\t    c = dict(PEM_SOMUN[dis])\n1641\t    if tip == \"SP\":\n1642\t        dl, kn = STD.pem_delik(\"SP\", dis)\n1643\t        if dl: c[\"delik\"] = float(dl)\n1644\t        if kn: c[\"kenar\"] = float(kn)\n1645\t    kod = max((k for k, (ms, A) in c[\"kod\"].items() if ms <= sac_t + 1e-9), default=None)\n1646\t    if kod is None: raise ValueError(\"PEM %s-%s: sac %.2f < en küçük kod\" % (tip, dis, sac_t))\n1647\t    ms, A = c[\"kod\"][kod]\n1648\t    d = D_NOM[dis]\n1649\t    sh = _silindir(c[\"delik\"] / 2 - 0.01, A, -A).fuse(_silindir(c[\"E\"] / 2, c[\"T\"] - A, 0.0)).cut(_silindir(d / 2, c[\"T\"] + 2, -A - 1))\n1650\t    parca = \"%s-%s-%d\" % (tip, dis, kod)\n1651\t    return _bp(ad, _tasi(sh, _cerceve(nokta, eksen)), \"PEM %s\" % parca, \"PEM kendinden kenetli somun %s (%s)\" % (parca, PEM_SOMUN_TIP.get(tip, \"\")),\n1652\t               \"delik Ø%.2f · gövde Ø%.2f × %.2f\" % (c[\"delik\"], c[\"E\"], c[\"T\"]), {\"SP\": \"A286 pasive\", \"CLS\": \"303\", \"S\": \"çelik\"}.get(tip, tip),\n1653\t               birim=birim, meta=dict(dis=dis, pem_tip=tip, parca=parca, delik=c[\"delik\"], kenar_min=c[\"kenar\"], min_sac=ms, sap=A, T=c[\"T\"])), c, ms\n1654\t\n1655\t\n1656\tdef pem_saplama(tip, dis, boy, nokta, eksen, ad=\"pem_saplama\", birim=\"BAGLANTI\", sac_ad=None):\n1657\t    \"\"\"PEM gömme başlı saplama · nokta: baş tarafındaki sac yüzü (flush) · eksen: saplamanın çıktığı yön.\n1658\t    Baş sacın içinde (malzeme başın çevresine akar) → ic_ice izni sac_ad ile.\"\"\"\n1659\t    c = dict(PEM_SAPLAMA[dis])\n1660\t    dl, kn = STD.pem_delik(tip, dis)\n1661\t    if dl: c[\"delik\"] = float(dl)\n1662\t    if kn: c[\"kenar\"] = float(kn)\n1663\t    d = D_NOM[dis]\n1664\t    sh = _silindir(c[\"H\"] / 2, c[\"h\"], 0.0).fuse(_silindir(d / 2 - 0.03, boy, 0.0))\n1665\t    parca = \"%s-%s-%g\" % (tip, dis, boy)\n1666\t    p = _bp(ad, _tasi(sh, _cerceve(nokta, eksen)), \"PEM %s\" % parca, \"PEM gömme başlı saplama %s (%s)\" % (parca, PEM_SAPLAMA_TIP.get(tip, \"\")),\n1667\t            \"delik Ø%.2f · %s×%g\" % (c[\"delik\"], dis, boy), {\"FHP\": \"A286 pasive\", \"FHS\": \"300 paslanmaz\", \"FH4\": \"400 serisi\", \"FH\": \"çelik\"}.get(tip, tip),\n1668\t            birim=birim, meta=dict(dis=dis, pem_tip=tip, parca=parca, delik=c[\"delik\"], kenar_min=c[\"kenar\"], min_sac=c[\"min_sac\"], boy=boy))\n1669\t    if sac_ad: p[\"meta\"][\"ic_ice\"] = [sac_ad]\n1670\t    return p, c\n1671\t\n1672\t\n1673\tdef percin_somun(dis, kavrama, nokta, eksen, ad=\"percin_somun\", birim=\"BAGLANTI\", kapali=False):\n1674\t    \"\"\"perçin somun (rivnut) düz baş · nokta: baş tarafı sac yüzü · eksen: içeri (kör taraf) · kavrama = sac paketi kalınlığı\"\"\"\n1675\t    c = dict(PERCIN_SOMUN[dis]); s = STD.percin_somun(dis)\n1676\t    if s.get(\"delik\"): c[\"delik\"] = float(s[\"delik\"]); c[\"D\"] = float(s[\"delik\"]) - 0.05\n1677\t    if s.get(\"kavrama\"): c[\"kavrama\"] = tuple(s[\"kavrama\"])\n1678\t    d = D_NOM[dis]\n1679\t    sh = _silindir(c[\"Dk\"] / 2, c[\"hk\"], -c[\"hk\"]).fuse(_silindir(c[\"D\"] / 2, kavrama, 0.0))\n1680\t    sh = sh.fuse(_silindir(c[\"D\"] / 2 + 1.2, 2.0, kavrama)).fuse(_silindir(c[\"D\"] / 2, max(0.5, c[\"L\"] - kavrama - 3.5), kavrama + 2.0))\n1681\t    sh = sh.cut(_silindir(d / 2, c[\"L\"] + 5, -c[\"hk\"] - 1))\n1682\t    return _bp(ad, _tasi(sh, _cerceve(nokta, eksen)), \"perçin somun (üretici std., DIN yok)\", \"Perçin somun %s düz baş %s A2\" % (dis, \"kapalı uç\" if kapali else \"açık uç\"),\n1683\t               \"delik Ø%.1f · kavrama %.2f (%g–%g)\" % (c[\"delik\"], kavrama, c[\"kavrama\"][0], c[\"kavrama\"][1]), \"A2\", birim=birim,\n1684\t               meta=dict(dis=dis, delik=c[\"delik\"], kavrama=kavrama, aralik=list(c[\"kavrama\"]))), c\n1685\t\n1686\t\n1687\tdef kor_percin(cap, boy, nokta, eksen, ad=\"kor_percin\", birim=\"BAGLANTI\", kavrama=None):\n1688\t    c = KOR_PERCIN[cap]\n1689\t    sh = cq.Solid.makeCone(c[\"dk\"] / 2, c[\"dk\"] / 2 * 0.6, c[\"k\"], V(0, 0, 0), V(0, 0, -1)).fuse(_silindir(cap / 2 - 0.03, boy, 0.0))\n1690\t    if kavrama is not None: sh = sh.fuse(_silindir(cap / 2 * 1.35, 1.2, kavrama))\n1691\t    return _bp(ad, _tasi(sh, _cerceve(nokta, eksen)), \"ISO 15983\", \"Kör perçin Ø%g×%g bombe baş A2/A2\" % (cap, boy), \"delik Ø%.1f\" % c[\"delik\"], \"A2/A2\",\n1692\t               birim=birim, meta=dict(cap=cap, boy=boy, delik=c[\"delik\"]))\n1693\t\n1694\t\n1695\tdef kaynak_somunu(dis, nokta, eksen, ad=\"kaynak_somunu\", birim=\"BAGLANTI\"):\n1696\t    s, m = DIN929[dis]\n1697\t    sh = _altigen(s, m).cut(_silindir(D_NOM[dis] / 2, m + 2, -1))\n1698\t    return _bp(ad, _tasi(sh, _cerceve(nokta, eksen)), \"DIN 929\", \"Altıgen kaynak somunu %s\" % dis, \"s%g m%g\" % (s, m), \"A2 (1.4301)\", birim=birim, meta=dict(dis=dis))\n1699\t\n1700\t\n1701\tdef kor_burc(dis, nokta, eksen, D=None, H=None, derinlik=None, ad=\"ayak_burcu\", birim=\"AYAK\"):\n1702\t    \"\"\"kaynaklı kör (kapalı uçlu) ayak burcu · nokta: kaynak yüzü (sac alt yüzü) · eksen: sacdan uzağa (aşağı)\"\"\"\n1703\t    d = D_NOM[dis]; D = D or (30.0 if d >= 12 else 25.0); H = H or (30.0 if d >= 12 else 25.0); derinlik = derinlik or (H - 5.0)\n1704\t    sh = _silindir(D / 2, H).cut(_silindir(d / 2, derinlik + 1, H - derinlik))\n1705\t    return _bp(ad, _tasi(sh, _cerceve(nokta, eksen)), \"özel imalat (torna)\", \"Kaynaklı kör ayak burcu %s · Ø%g × %g · kapalı uç\" % (dis, D, H),\n1706\t               \"Ø%g × %g · diş derinliği %g\" % (D, H, derinlik), \"AISI 304\", birim=birim, uretim=True, mal=\"paslanmaz\", meta=dict(dis=dis, D=D, H=H, derinlik=derinlik))\n1707\t\n1708\t\n1709\tdef ayarli_ayak(dis, taban_noktasi, yukari, kot_burc_alt, ise=None, D_taban=60.0, ad=\"ayarli_ayak\", birim=\"AYAK\", kontra=True):\n1710\t    \"\"\"hijyenik ayarlı ayak (GN 20 sınıfı) · taban_noktasi: zemindeki ayak merkezi · kot_burc_alt: zeminden burç alt yüzüne · ise: burç içine diş boyu\"\"\"\n1711\t    d = D_NOM[dis]; ise = ise or 1.5 * d + 2.0\n1712\t    mil_ust = kot_burc_alt + ise\n1713\t    sh = cq.Solid.makeCone(D_taban / 2, D_taban / 2 - 4.0, 12.0, V(0, 0, 0), V(0, 0, 1))\n1714\t    sh = sh.fuse(_silindir(D_taban * 0.28, 10.0, 12.0)).fuse(_altigen(22.0 if d >= 12 else 17.0, 8.0, 22.0)).fuse(_silindir(d / 2 - 0.03, mil_ust - 30.0, 30.0))\n1715\t    parts = [_bp(ad, _tasi(sh, _cerceve(taban_noktasi, yukari)), \"GN 20 sınıfı (hijyenik)\", \"Ayarlı ayak %s · taban Ø%g · AISI 304 · dudak contalı\" % (dis, D_taban),\n1716\t                 \"yükseklik %.0f · ayar ±20\" % kot_burc_alt, \"AISI 304\", birim=birim, meta=dict(dis=dis, D=D_taban, statik_kN=16))]\n1717\t    if kontra:\n1718\t        s, m = ISO4032[dis]; ps = np.asarray(taban_noktasi, float) + _n(yukari) * (kot_burc_alt - m)\n1719\t        parts.append(somun(\"ISO4032\", dis, ps, yukari, ad=ad + \"_kontra\", birim=birim))\n1720\t    return parts\n1721\t\n1722\t\n1723\tdef gizli_mentese(cerceve, x_mentese, x_yan, z_kol, z_plaka, kol_gen=12.0, yuk=50.0, govde=(16.0, 12.0), plaka=(3.0, 70.0), plaka_delik=(), ad=\"gizli_mentese\", birim=\"KAPAK\"):\n1724\t    \"\"\"gizli 180° kaldır-çıkar menteşe (Southco R6 sınıfı, ölçüler TEMSİLİ) — cerceve: X kapak kenarından içe, Y, Z kapaktan gövdeye (sağ elli);\n1725\t    orijin kapak iç yüzü (arka) · kapak gövdesi Z 0 … −govde[1] (kapak cebinde) · kol Z 0 … z_kol · plaka yan iç yüzünde (X = x_yan) Z z_plaka aralığı ·\n1726\t    plaka_delik: [(Y, Z, Ø)] plakadaki bağlantı delikleri (X yönünde)\"\"\"\n1727\t    gw, gd = govde; tp, Lp = plaka\n1728\t    def kutu(x0, x1, y0, y1, z0, z1): return cq.Solid.makeBox(x1 - x0, y1 - y0, z1 - z0, V(x0, y0, z0))\n1729\t    sh = kutu(x_mentese - gw / 2, x_mentese + gw / 2, -yuk / 2, yuk / 2, -gd, 0.0)\n1730\t    sh = sh.fuse(kutu(x_mentese - kol_gen / 2, x_mentese + kol_gen / 2, -yuk / 2 + 5, yuk / 2 - 5, -0.5, z_kol))\n1731\t    sh = sh.fuse(kutu(x_yan, x_mentese + kol_gen / 2, -yuk / 2 + 5, yuk / 2 - 5, z_kol - 10.0, z_kol))\n1732\t    sh = sh.fuse(kutu(x_yan, x_yan + tp, -yuk / 2 - 10, yuk / 2 + 10, z_plaka[0], z_plaka[1]))\n1733\t    for yy, zz, cp in plaka_delik:\n1734\t        sh = sh.cut(cq.Solid.makeCylinder(cp / 2.0, tp + 2.0, V(x_yan - 1.0, yy, zz), V(1, 0, 0)))\n1735\t    return _bp(ad, _tasi(sh.clean(), cerceve), \"Southco R6 sınıfı\", \"Gizli 180° kaldır-çıkar menteşe AISI 304 pasive (ölçüler temsili, katalogdan)\",\n1736\t               \"gövde %g×%g×%g · plaka %g×%g\" % (gw, yuk, gd, tp, Lp), \"AISI 304\", birim=birim, meta=dict(kaldir_cikar=True, aci=180))\n1737\t\n1738\t\n1739\tdef piyano_mentese(cerceve, boy, kanat=20.0, kalinlik=1.0, d_mafsal=4.0, aci=180.0, delik_aralik=50.0, ad=\"piyano_mentese\", birim=\"KAPAK\"):\n1740\t    \"\"\"DIN 7954 piyano menteşe · cerceve: Z mafsal ekseni (boy), kanat 1 +X, kanat 2 X'ten aci° dönmüş\"\"\"\n1741\t    k1 = cq.Solid.makeBox(kanat, kalinlik, boy, V(0, -kalinlik / 2, 0))\n1742\t    k2 = k1.rotate(V(0, 0, 0), V(0, 0, 1), aci)\n1743\t    sh = k1.fuse(k2).fuse(_silindir(d_mafsal / 2, boy))\n1744\t    for z in np.arange(delik_aralik / 2, boy, delik_aralik):\n1745\t        for kk in (0.0, aci):\n1746\t            c = cq.Solid.makeCylinder(2.1, 4.0, V(kanat * 0.6, -2.0, z), V(0, 1, 0)).rotate(V(0, 0, 0), V(0, 0, 1), kk)\n1747\t            sh = sh.cut(c)\n1748\t    return _bp(ad, _tasi(sh, cerceve), \"DIN 7954\", \"Piyano menteşe AISI 304 %g×%g×%g\" % (2 * kanat, kalinlik, boy), \"kanat %g · mafsal Ø%g\" % (kanat, d_mafsal), \"AISI 304\",\n1749\t               birim=birim, meta=dict(boy=boy))\n1750\t\n1751\t\n1752\t# =====================================================================================================================================\n1753\t# 11 · BİRLEŞİM YARDIMCILARI\n1754\t# =====================================================================================================================================\n1755\tdef _yigin(A, B, nokta):\n1756\t    \"\"\"A ve B panellerinin eksen boyunca konumu: d (A → B), A dış yüzünden uzaklıklar (a1 = tA, b0, b1)\"\"\"\n1757\t    nA = A.normal()\n1758\t    if abs(abs(np.dot(nA, B.normal())) - 1.0) > 1e-6: raise ValueError(\"birleşim: paneller paralel değil (%s / %s)\" % (A.ad, B.ad))\n1759\t    ya = A.yerel(nokta); pA0 = A.dunya(ya[0], ya[1], 0.0); tA, tB = A.sac.t, B.sac.t\n1760\t    yb = B.yerel(nokta)\n1761\t    sb = sorted(float(np.dot(B.dunya(yb[0], yb[1], z) - pA0, nA)) for z in (0.0, tB))\n1762\t    if sb[0] >= tA - 1e-6: d, dis0 = nA, pA0\n1763\t    elif sb[1] <= 1e-6: d, dis0 = -nA, A.dunya(ya[0], ya[1], tA); sb = sorted(tA - s for s in sb)\n1764\t    else: raise ValueError(\"birleşim: %s ile %s iç içe\" % (A.ad, B.ad))\n1765\t    return d, dis0, tA, sb[0], sb[1]\n1766\t\n1767\t\n1768\tdef vidali_birlesim(A, B, nokta, tip=\"pem_somun\", dis=\"M5\", vida_std=\"ISO7380\", pul_std=None, somun_std=\"ISO10511\", pem_tip=None, boy=None, ad=\"baglanti\", birim=\"BAGLANTI\"):\n1769\t    \"\"\"iki paralel sac arası vidalı birleşim — delik + PEM/somun + vida AYNI EKSENDE otomatik.\n1770\t    A: baş tarafındaki panel (vida başı / saplama başı / perçin başı) · B: karşı panel.\n1771\t      pem_somun : A'da ISO 273 geçiş deliği, B'de PEM SP somun (gövde B'nin uzak yüzünde), vida A dışından\n1772\t      pem_saplama: A'da PEM FHP gömme saplama (baş A dış yüzünde flush), B'de geçiş deliği, B uzak yüzünde pul + somun\n1773\t      percin_somun: iki sacı birlikte kavrayan perçin somun (A dışından takılır)\n1774\t      somun     : iki geçiş deliği, vida + pul + somun · kor_percin: iki delik, kör perçin\"\"\"\n1775\t    d, dis0, tA, b0, b1 = _yigin(A, B, nokta)\n1776\t    P = lambda x: dis0 + d * x\n1777\t    ua = A.yerel(dis0); ub = B.yerel(P(b0 + 1e-9))\n1778\t    for pan, uu in ((A, ua), (B, ub)):\n1779\t        if not pan.icerir(uu[0], uu[1]): raise ValueError(\"birleşim noktası %s düz bölgesinde değil\" % pan.ad)\n1780\t    parcalar, delikler = [], []\n1781\t    def dl(pan, uu, cap, tp, **m):\n1782\t        pan.delik(uu[0], uu[1], cap, tip=tp, **m); delikler.append(dict(sac=pan.sac.ad, panel=pan.ad, cap=round(cap, 3), tip=tp, merkez=[round(c, 4) for c in pan.dunya(uu[0], uu[1], 0.0)]))\n1783\t    gecis = STD.delik_iso273(dis)\n1784\t    if tip == \"pem_somun\":\n1785\t        pt = pem_tip or \"SP\"\n1786\t        ps, c, ms = pem_somun(pt, dis, P(b1), d, B.sac.t, ad=ad + \"_pem\", birim=birim)\n1787\t        dl(A, ua, gecis, \"vida_deligi\", parca=\"ISO 273 orta\")\n1788\t        dl(B, ub, c[\"delik\"], \"pem_somun\", parca=ps[\"meta\"][\"parca\"], pem_tip=pt, kenar_min=c[\"kenar\"], min_sac=ms)\n1789\t        hp = DIN9021[dis][2] if pul_std else 0.0\n1790\t        gerek = b1 - ps[\"meta\"][\"sap\"] + ps[\"meta\"][\"T\"] + hp\n1791\t        L = boy or _boy_sec(gerek, [x for x in VIDA_BOY if x >= 1.2 * D_NOM[dis]])        # katalogda en kısa ≈ 1,2d\n1792\t        if pul_std: parcalar.append(pul(pul_std, dis, P(-hp), d, ad=ad + \"_pul\", birim=birim))\n1793\t        parcalar += [vida(vida_std, dis, L, P(-hp), d, ad=ad + \"_vida\", birim=birim), ps]\n1794\t    elif tip == \"pem_saplama\":\n1795\t        pt = pem_tip or \"FHP\"\n1796\t        dl(B, ub, gecis, \"vida_deligi\", parca=\"ISO 273 orta\")\n1797\t        pu = pul(pul_std or \"DIN9021\", dis, P(b1), d, ad=ad + \"_pul\", birim=birim)\n1798\t        so_s, so_m = (ISO10511 if somun_std == \"ISO10511\" else ISO4032)[dis]\n1799\t        gerek = b1 + pu[\"meta\"][\"h\"] + so_m + 1.5\n1800\t        L = boy or _boy_sec(gerek, SAPLAMA_BOY)\n1801\t        sp, c = pem_saplama(pt, dis, L, P(0.0), d, ad=ad + \"_saplama\", birim=birim, sac_ad=A.sac.ad)\n1802\t        dl(A, ua, c[\"delik\"], \"pem_saplama\", parca=sp[\"meta\"][\"parca\"], pem_tip=pt, kenar_min=c[\"kenar\"], min_sac=c[\"min_sac\"])\n1803\t        parcalar += [sp, pu, somun(somun_std, dis, P(b1 + pu[\"meta\"][\"h\"]), d, ad=ad + \"_somun\", birim=birim)]\n1804\t    elif tip == \"percin_somun\":\n1805\t        rs, c = percin_somun(dis, b1, P(0.0), d, ad=ad + \"_percin_somun\", birim=birim)\n1806\t        if not (c[\"kavrama\"][0] - 1e-9 <= b1 <= c[\"kavrama\"][1] + 1e-9): raise ValueError(\"perçin somun kavrama %.2f ∉ %s\" % (b1, c[\"kavrama\"]))\n1807\t        dl(A, ua, c[\"delik\"], \"percin_somun\", parca=\"perçin somun %s\" % dis); dl(B, ub, c[\"delik\"], \"percin_somun\", parca=\"perçin somun %s\" % dis)\n1808\t        parcalar.append(rs)\n1809\t    elif tip == \"somun\":\n1810\t        dl(A, ua, gecis, \"vida_deligi\"); dl(B, ub, gecis, \"vida_deligi\")\n1811\t        h1 = DIN125[dis][2]; so_s, so_m = (ISO10511 if somun_std == \"ISO10511\" else ISO4032)[dis]\n1812\t        L = boy or _boy_sec(b1 + 2 * h1 + so_m + 1.5, VIDA_BOY)\n1813\t        parcalar += [pul(\"DIN125\", dis, P(-h1), d, ad=ad + \"_pul1\", birim=birim), vida(vida_std, dis, L, P(-h1), d, ad=ad + \"_vida\", birim=birim),\n1814\t                     pul(\"DIN125\", dis, P(b1), d, ad=ad + \"_pul2\", birim=birim), somun(somun_std, dis, P(b1 + h1), d, ad=ad + \"_somun\", birim=birim)]\n1815\t    elif tip == \"kor_percin\":\n1816\t        cap = float(dis) if not isinstance(dis, str) else 4.0\n1817\t        c = KOR_PERCIN[cap]\n1818\t        dl(A, ua, c[\"delik\"], \"kor_percin\"); dl(B, ub, c[\"delik\"], \"kor_percin\")\n1819\t        L = boy or _boy_sec(b1 + 1.5 * cap, [6, 8, 10, 12, 14, 16, 18, 20])\n1820\t        parcalar.append(kor_percin(cap, L, P(0.0), d, ad=ad + \"_percin\", birim=birim, kavrama=b1))\n1821\t    else:\n1822\t        raise ValueError(tip)\n1823\t    # eş eksen doğrulaması: deliklerin merkezleri ve elemanların eksenleri aynı doğru üzerinde\n1824\t    ek = [np.asarray(x[\"merkez\"]) for x in delikler]\n1825\t    sap = max(float(np.linalg.norm((q - dis0) - np.dot(q - dis0, d) * d)) for q in ek)\n1826\t    return dict(ad=ad, tip=tip, dis=dis, eksen=[round(float(c), 6) for c in d], nokta=[round(float(c), 4) for c in dis0], aralik=round(b0 - tA, 4),\n1827\t                paket=round(b1, 4), parcalar=parcalar, delikler=delikler, es_eksen_sapma_mm=round(sap, 6), sac=[A.sac.ad, B.sac.ad])\n1828\t\n1829\t\n1830\tdef saplama_baglantisi(A, nokta, yon, paket, dis=\"M5\", pem_tip=\"FHP\", pul_std=\"DIN9021\", somun_std=\"ISO10511\", ad=\"saplama\", birim=\"BAGLANTI\"):\n1831\t    \"\"\"A sacına gömme başlı PEM saplama (baş A'nın 'yon'a ters yüzünde flush) · saplama 'yon' tarafındaki sac-dışı parçadan\n1832\t    (A'nın yon tarafı yüzünden itibaren 'paket' kalınlığı: araç / menteşe plakası / braket) geçer · uzak yüzde pul + somun · saplama boyu otomatik\"\"\"\n1833\t    d = _n(yon); nA = A.normal(); tA = A.sac.t\n1834\t    if abs(abs(np.dot(d, nA)) - 1.0) > 1e-6: raise ValueError(\"saplama: yön sac normaline paralel değil\")\n1835\t    ya = A.yerel(nokta); P0 = A.dunya(ya[0], ya[1], 0.0 if np.dot(d, nA) > 0 else tA)\n1836\t    if not A.icerir(ya[0], ya[1]): raise ValueError(\"saplama noktası %s düz bölgesinde değil\" % A.ad)\n1837\t    b1 = tA + paket\n1838\t    pu = pul(pul_std, dis, P0 + d * b1, d, ad=ad + \"_pul\", birim=birim)\n1839\t    so_m = (ISO10511 if somun_std == \"ISO10511\" else ISO4032)[dis][1]\n1840\t    L = _boy_sec(b1 + pu[\"meta\"][\"h\"] + so_m + 1.5, SAPLAMA_BOY)\n1841\t    sp, c = pem_saplama(pem_tip, dis, L, P0, d, ad=ad + \"_saplama\", birim=birim, sac_ad=A.sac.ad)\n1842\t    A.delik(ya[0], ya[1], c[\"delik\"], tip=\"pem_saplama\", parca=sp[\"meta\"][\"parca\"], pem_tip=pem_tip, kenar_min=c[\"kenar\"], min_sac=c[\"min_sac\"])\n1843\t    so = somun(somun_std, dis, P0 + d * (b1 + pu[\"meta\"][\"h\"]), d, ad=ad + \"_somun\", birim=birim)\n1844\t    return dict(ad=ad, tip=\"pem_saplama_paket\", dis=dis, paket=paket, eksen=[round(float(c_), 6) for c_ in d], nokta=[round(float(c_), 4) for c_ in P0],\n1845\t                parcalar=[sp, pu, so], delikler=[dict(sac=A.sac.ad, panel=A.ad, cap=c[\"delik\"], tip=\"pem_saplama\")], es_eksen_sapma_mm=0.0, sac=[A.sac.ad])\n1846\t\n1847\t\n1848\tdef dil_yuva(dil_paneli, kenar, w0, en, yuva_paneli, bosluk=0.1, cikinti=0.0):\n1849\t    \"\"\"geçme dil + yuva: dil_paneli kenarından düzlem içinde çıkan dil, yuva_paneline açılan yuvadan geçer (dil boyu ve yuva konumu otomatik)\"\"\"\n1850\t    kn = dil_paneli.kenar(kenar); t = dil_paneli.sac.t\n1851\t    ws = w0 + en / 2.0\n1852\t    p_orta = dil_paneli.dunya(*(kn[\"p0\"] + kn[\"e2\"] * ws), z=t / 2.0)\n1853\t    out3 = dil_paneli.M[:3, :3] @ np.r_[kn[\"out2\"], 0.0]\n1854\t    ny = yuva_paneli.normal()\n1855\t    if abs(np.dot(out3, ny)) < 0.5: raise ValueError(\"dil_yuva: dil yuva sacına dik değil\")\n1856\t    ss = []\n1857\t    for z in (0.0, yuva_paneli.sac.t):\n1858\t        q = yuva_paneli.dunya(0, 0, z); ss.append(float(np.dot(q - p_orta, ny) / np.dot(out3, ny)))\n1859\t    yak, uz = sorted(ss)\n1860\t    if yak < -1e-6: raise ValueError(\"dil_yuva: yuva sacı kenarın gerisinde\")\n1861\t    boy = uz + cikinti\n1862\t    dil_paneli.dil(kenar, w0, en, boy)\n1863\t    merkez = p_orta + out3 * (yak + uz) / 2.0\n1864\t    uv = yuva_paneli.yerel(merkez)\n1865\t    e3 = dil_paneli.M[:3, :3] @ np.r_[kn[\"e2\"], 0.0]\n1866\t    ey = yuva_paneli.M[:3, :3].T @ e3\n1867\t    aci = math.degrees(math.atan2(ey[1], ey[0]))\n1868\t    yuva_paneli.dikdortgen(uv[0], uv[1], en + 2 * bosluk, t + 2 * bosluk, aci, tip=\"yuva\", parca=\"dil-yuva\", dil=dil_paneli.ad)\n1869\t    return dict(dil=dil_paneli.ad, yuva=yuva_paneli.ad, en=en, boy=round(boy, 3), yuva_olcu=[round(en + 2 * bosluk, 3), round(t + 2 * bosluk, 3)],\n1870\t                merkez=[round(float(c), 3) for c in merkez])\n1871\t\n1872\t\n1873\t# =====================================================================================================================================\n1874\t# 12 · MONTAJ UYUMU + ÇIKTI\n1875\t# =====================================================================================================================================\n1876\tdef _sekil(p):\n1877\t    if p.get(\"sh\") is not None: return p[\"sh\"]\n1878\t    w = p[\"wp\"]; vs = w.vals()\n1879\t    return vs[0] if len(vs) == 1 else cq.Compound.makeCompound(vs)\n1880\t\n1881\t\n1882\tdef parca_kutusu_satiri(p, saydam=0):\n1883\t    \"\"\"parca_kutulari.json satırı: [ad, saydam, xmin, xmax, ymin, ymax, zmin, zmax]\"\"\"\n1884\t    b = _sekil(p).BoundingBox()\n1885\t    return [p[\"ad\"], saydam] + [round(v, 1) for v in (b.xmin, b.xmax, b.ymin, b.ymax, b.zmin, b.zmax)]\n1886\t\n1887\t\n1888\tdef cakisma_denetle(parcalar, esik=0.5):\n1889\t    \"\"\"parçalar arası kesişim hacmi > esik (mm³) · meta['ic_ice'] izinli çiftler (PEM gömme başı)\"\"\"\n1890\t    ss = [(p[\"ad\"], _sekil(p), p.get(\"meta\", {}).get(\"ic_ice\", [])) for p in parcalar]\n1891\t    bb = [s.BoundingBox() for _a, s, _i in ss]\n1892\t    out, izinli = [], []\n1893\t    for i in range(len(ss)):\n1894\t        for j in range(i + 1, len(ss)):\n1895\t            if not _bb_kesisir(bb[i], bb[j], -1e-4): continue\n1896\t            try:\n1897\t                v = ss[i][1].intersect(ss[j][1]).Volume()\n1898\t            except Exception:\n1899\t                v = -1.0\n1900\t            if v > esik or v < 0:\n1901\t                if ss[j][0] in ss[i][2] or ss[i][0] in ss[j][2]: izinli.append((ss[i][0], ss[j][0], round(v, 3)))\n1902\t                else: out.append((ss[i][0], ss[j][0], round(v, 3)))\n1903\t    return out, izinli\n1904\t\n1905\t\n1906\t_RENK = {\"sac\": ((0.78, 0.80, 0.83, 1.0), 0.85, 0.32), \"baglanti\": ((0.36, 0.40, 0.46, 1.0), 0.6, 0.4), \"kaynak\": ((0.80, 0.55, 0.25, 1.0), 0.4, 0.5),\n1907\t         \"ayak\": ((0.55, 0.58, 0.62, 1.0), 0.7, 0.35)}\n1908\t\n1909\t\n1910\tdef glb_yaz(yol, parcalar, tol=0.05, aci=0.25):\n1911\t    \"\"\"parça başına düğüm · metre · y yukarı · extras: parçanın 'sac' / 'meta' sözlüğü + bom\"\"\"\n1912\t    blob, views, accs, meshes, nodes, mats, mi = [], [], [], [], [], [], {}\n1913\t    off = [0]\n1914\t    def gomu(bt, hedef=None):\n1915\t        while off[0] % 4: blob.append(b\"\\x00\"); off[0] += 1\n1916\t        v = {\"buffer\": 0, \"byteOffset\": off[0], \"byteLength\": len(bt)}\n1917\t        if hedef: v[\"target\"] = hedef\n1918\t        views.append(v); blob.append(bt); off[0] += len(bt)\n1919\t        return len(views) - 1\n1920\t    for p in parcalar:\n1921\t        tur = p.get(\"tur\", \"sac\")\n1922\t        if tur not in mi:\n1923\t            r, m, rg = _RENK.get(tur, _RENK[\"sac\"])\n1924\t            mi[tur] = len(mats); mats.append({\"name\": tur, \"pbrMetallicRoughness\": {\"baseColorFactor\": list(r), \"metallicFactor\": m, \"roughnessFactor\": rg}, \"doubleSided\": True})\n1925\t        vs, tris = _sekil(p).tessellate(tol, aci)\n1926\t        P = np.array([[v.x, v.y, v.z] for v in vs], float) * 0.001; I = np.array(tris, np.uint32).reshape(-1, 3)\n1927\t        N = np.zeros_like(P)\n1928\t        fn = np.cross(P[I[:, 1]] - P[I[:, 0]], P[I[:, 2]] - P[I[:, 0]])\n1929\t        for k in range(3): np.add.at(N, I[:, k], fn)\n1930\t        N /= np.maximum(np.linalg.norm(N, axis=1, keepdims=True), 1e-12)\n1931\t        vp = gomu(P.astype(\"<f4\").tobytes(), 34962); vn = gomu(N.astype(\"<f4\").tobytes(), 34962); vi = gomu(I.astype(\"<u4\").tobytes(), 34963)\n1932\t        accs += [{\"bufferView\": vp, \"componentType\": 5126, \"count\": len(P), \"type\": \"VEC3\", \"min\": P.min(0).tolist(), \"max\": P.max(0).tolist()},\n1933\t                 {\"bufferView\": vn, \"componentType\": 5126, \"count\": len(N), \"type\": \"VEC3\"},\n1934\t                 {\"bufferView\": vi, \"componentType\": 5125, \"count\": int(I.size), \"type\": \"SCALAR\"}]\n1935\t        meshes.append({\"name\": p[\"ad\"], \"primitives\": [{\"attributes\": {\"POSITION\": len(accs) - 3, \"NORMAL\": len(accs) - 2}, \"indices\": len(accs) - 1, \"material\": mi[tur]}]})\n1936\t        ex = {\"bom\": list(p.get(\"bom\", ())), \"birim\": p.get(\"birim\"), \"tur\": tur}\n1937\t        if p.get(\"sac\"): ex[\"sac\"] = p[\"sac\"]\n1938\t        if p.get(\"meta\"): ex[\"meta\"] = p[\"meta\"]\n1939\t        nodes.append({\"mesh\": len(meshes) - 1, \"name\": p[\"ad\"], \"extras\": json.loads(json.dumps(ex, ensure_ascii=False, default=str))})\n1940\t    while off[0] % 4: blob.append(b\"\\x00\"); off[0] += 1\n1941\t    bb = b\"\".join(blob)\n1942\t    g = {\"asset\": {\"version\": \"2.0\", \"generator\": SURUM}, \"scene\": 0, \"scenes\": [{\"nodes\": list(range(len(nodes)))}], \"nodes\": nodes, \"meshes\": meshes,\n1943\t         \"materials\": mats, \"accessors\": accs, \"bufferViews\": views, \"buffers\": [{\"byteLength\": len(bb)}]}\n1944\t    js = json.dumps(g, separators=(\",\", \":\"), ensure_ascii=False).encode(\"utf-8\")\n1945\t    while len(js) % 4: js += b\" \"\n1946\t    with open(yol, \"wb\") as f:\n1947\t        f.write(struct.pack(\"<III\", 0x46546C67, 2, 12 + 8 + len(js) + 8 + len(bb)))\n1948\t        f.write(struct.pack(\"<II\", len(js), 0x4E4F534A)); f.write(js)\n1949\t        f.write(struct.pack(\"<II\", len(bb), 0x004E4942)); f.write(bb)\n1950\t    return dict(yol=yol, dugum=len(nodes), bayt=12 + 16 + len(js) + len(bb))\n1951\t\n1952\t\n1953\tdef bom_topla(parcalar):\n1954\t    \"\"\"aynı tanım + ölçü + standart satırlarını toplar\"\"\"\n1955\t    t = {}\n1956\t    for p in parcalar:\n1957\t        b = p.get(\"bom\")\n1958\t        if not b: continue\n1959\t        k = (b[0], b[2], b[3], b[4])\n1960\t        t[k] = t.get(k, 0) + b[1]\n1961\t    return [dict(tanim=k[0], olcu=k[1], standart=k[2], tedarik=k[3], adet=v) for k, v in sorted(t.items(), key=lambda kv: (kv[0][3], kv[0][0]))]\n1962\t"}]},"uuid":"2844a5c2-8efd-47a6-b78b-eb8844950ad9","timestamp":"2026-10-01T22:49:04.395Z","sourceToolAssistantUUID":"59570ff1-998f-4155-b4b1-0c990487876d","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
