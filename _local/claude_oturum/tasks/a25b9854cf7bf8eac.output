.5\": {\"t\": 1.5, \"V_kalip\": 12, \"R_ic_dogal_0_2V\": 2.4, \"R_ic_model\": 2.25, \"K\": 0.45, \"BA_90\": 4.595, \"BD_90\": 2.91, \"BD_90_bar\r\n{\"sac_gizli_secenek_A_PEM\": {\"somun\": {\"parca\": \"PEM SP-M5-1\", \"dis\": \"M5\", \"delik\": 6.35, \"delik_tol\": 0.08, \"min_sac\": 1.0, \"kenar_eksen_min\": 7.1, \"malzeme\": \"A286\", \"sac_sertlik_max\": \"HRB 90\"}, \"saplama\": {\"parca\": \"PEM FHP-M5-xx\", \"dis\": \"M5\", \"delik\": 5.0, \"delik_tol\": 0.08, \"sac_aralik\": [1.0, 2.4], \"kenar_eksen_min\": 7.2, \"malzeme\": \"A286\"}, \"yasak\": [\"PEM CLS (HRB 70 siniri, 304 sacta tutmaz)\", \"PEM FH4 (400 serisi)\"], \"cakma_zamani\": \"bukumden once, duz sacta\"}, \"sac_gizli_secenek_B_CD_saplama\": {\"standart\": \"ISO 13918 PT\", \"malzeme\": \"A2\", \"dis\": \"M5\", \"flans_cap\": 6.7, \"min_sac\": 0.5, \"flans_ic_yuz_eksen_min\": 12}, \"pem_diger\": {\"SP-M4-1\": {\"delik\": 5.41, \"min_sac\": 1.0, \"kenar_eksen_min\": 6.9}, \"SP-M6-1\": {\"delik\": 8.75, \"min_sac\": 1.4}, \"FHP-M4\": {\"delik\": 4.0, \"sac_aralik\": [1.0, 2.4]}}, \"percin_somun\": {\"M4\": {\"delik\": 6.0}, \"M5\": {\"delik\": 7.0, \"kavrama\": [0.5, 3.0]}, \"M6\": {\"delik\": 9.0, \"kavrama\": [0.5, 3.5]}, \"malzeme\": \"A2\", \"islak_bolge\": \"kapali uclu\"}, \"iskelet_baglanti\": \"M6 percin somun\", \"modul_modul\": {\"civata\": \"ISO 4762 M8 A2-70\", \"somun\": \"ISO 10511 M8 A2\", \"delik\": 9.0, \"dis_derz_max\": 0.5, \"derz_dolgu\": \"gida sinifi silikon / EPDM serit\"}, \"vida_tipleri\": {\"ISO 7380-1\": \"bombe imbus - yalniz arka/teknik/servis\", \"ISO 10642\": \"havsa imbus - yalniz >= 3 mm parca (M5 bas O10 x 2.8)\", \"ISO 4762\": \"silindir imbus - iskelet, modul M8\", \"ISO 10511\": \"fiberli somun\", \"DIN 1587\": \"kor somun - sicrama bolgesinde acik dis\", \"ISO 7093\": \"genis pul (ince sac)\", \"DIN 929\": \"kaynak somunu M12 - ayak burcu\"}, \"malzeme\": \"A2-70\", \"gorunur_vida_on_ust\": false, \"galling_onlem\": \"gida uyumlu kaydirici / anti-seize\", \"del