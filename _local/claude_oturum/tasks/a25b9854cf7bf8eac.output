1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
{"parentUuid":"b9194396-b0a2-425d-b7de-a394d7acc4d5","isSidechain":true,"promptId":"6d13b065-9608-42c4-83ca-508fc3c4db72","agentId":"a25b9854cf7bf8eac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WrGFPRp7772UNE7PoFfxBk","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"h3_sac_v1 — AUTOKITCH ÜRETİME YÖNELİK SAC METAL KÜTÜPHANESİ v1 (2 Eki 2026 · Claude · YEREL · yalnız kütüphane, montaja bağlı DEĞİL)\n3\t\n4\tNE YAPAR\n5\t  İstasyon gövdelerini (dış / iç panel, taban, tavan, kapak, iskelet sacı) GERÇEK ABKANT BÜKÜMLÜ SAC olarak kurar: her büküm iç yarıçapı R,\n6\t  dış yarıçapı R + t olan silindirik bölgedir; flanş boyları K faktörlü büküm payıyla açınımla birebir tutarlıdır. Lazer + abkant + TIG yapan\n7\t  atölye 3B'den açınım (JSON: dış kontur + delikler + büküm çizgileri, açı, yön, R, K, BA) alır.\n8\t\n9\tKOORDİNAT\n10\t  Dünya: mm · x hat boyunca · y yukarı · z koridora (ön). Her panelin yerel çerçevesi: (u, v) sac düzleminde, z sac kalınlığı yönünde (+n).\n11\t  Yerel z = 0 'alt yüz', z = t 'üst yüz'. Bükümle yüz değişmez → AÇINIMDA BÜTÜN PANELLERİN ÜST YÜZÜ Z = t TARAFINDADIR.\n12\t  Büküm yönü: yon = +1 → çocuk flanş ebeveynin +n (üst yüz) tarafına döner (açınımda 'yukari'), yon = −1 → −n ('asagi').\n13\t  Panel poligonu CCW verilir; i. kenar = poly[i] → poly[i+1]; kenarın dış normali kenar yönünün sağıdır. Büküm teğet çizgisi = panel kenarı.\n14\t  flans() ile doğan panelin poligonu (s, w): s büküm bitişinden flanş boyunca, w ebeveyn kenarı boyunca (kenar başından).\n15\t    Kenar adları: 0 = 'bas' yanı (w küçük), 1 = 'uc' (serbest uç — dönüş / kıvırma buraya), 2 = 'son' yanı, 3 = bükümlü kenar (kullanılamaz).\n16\t\n17\tSABİTLER (öncelik): sac_kararlar_v1.json  >  sac_standart_v1.json  >  varsayılan (304 · R = t · K 0,40 · min flanş 6t · relief t × (R+t) ...)\n18\t  Klasör: <scratchpad>/sac_standart (ya da AUTOKITCH_SAC_STANDART ortam değişkeni). STD nesnesi · standart_yukle() yeniden okur.\n19\t  K: standart büküm tablosundan (BD ölçümle doğrulanmış) · tabloda yoksa kararlar.K · yoksa 0,40.\n20\t\n21\tAPI ÖZETİ\n22\t  Sac(ad, rol='dis'|'ic'|'yuk'|'kapak_dis'|'kapak_ic'|'braket', t=None, R=None, K=None, birim, grup, bolge='gida_disi'|'gida')\n23\t    .taban(poligon, O, ex, ey, ad)                          → Panel (kök)\n24\t    .kose(flansA, flansB, tip='acik'|'bindirme', ustte=None, rahat='kare'|'yuvarlak'|None, kaynak=None, bosluk=None)\n25\t    .punta(diger_sac, noktalar, cap)                        → punta etiketi (meta)\n26\t    .kati() / .kati_temel()                                 → cq.Shape (formlu / formsuz)\n27\t    .acinim()                                               → dict (JSON) — dış kontur, iç konturlar, bükümler, formlar, delikler\n28\t    .dogrula()                                              → açınımdan yeniden büküm + kalınlık + kesit yarıçap denetimi\n29\t    .dfm(abkant=True)                                       → üretilebilirlik maddeleri (HATA / UYARI / GEÇTİ / BİLGİ)\n30\t    .parca() / .parcalar() / .meta()                        → montaj parça sözlüğü (ad, wp, sh, mal, birim, grup, kaynak, bom, sac)\n31\t  Panel\n32\t    .flans(kenar, boy, aci=90, yon=+1, R=None, olcu='dis'|'ic'|'duz', bas=0, son=0, uzat_bas=0, uzat_son=0, rahat='otomatik', ad=None)\n33\t    .kivir(kenar, boy=None, tip='kapali'|'acik', yon=+1, bas=0, son=0)        (hem: 180°, R = iç çap / 2)\n34\t    .ofset(kenar, yukseklik, boy, aci=90, yon=+1)                              (joggle: iki ters büküm)\n35\t    .delik(u, v, cap) · .oblong(u, v, boy, en, aci) · .dikdortgen(u, v, boy, en, aci, r) · .kesik(poligon)\n36\t    .lazer_yarik_dizisi(u0, v0, n_sira, n_sutun, aci=0)     (standart: 5 × 60, R2,5, köprü ≥ 5, sıra ≥ 10)\n37\t    .dil(kenar, w0, en, boy)                                 (geçme dili) · .panjur(...) · .kabartma(...)\n38\t    .dunya(u, v, z) · .yerel(p) · .normal() · .kenar(i) · .icerir(u, v)\n39\t  Birleşim:  vidali_birlesim(A, B, nokta, tip='pem_somun'|'pem_saplama'|'percin_somun'|'somun'|'kor_percin', dis='M5', ...)\n40\t             saplama_baglantisi(A, nokta, yon, paket, dis='M5')   (sac + sac-dışı parça: menteşe plakası, braket)\n41\t             dil_yuva(dil_paneli, kenar, w0, en, yuva_paneli, bosluk=0.1)\n42\t  Bağlantı elemanı (gerçek ölçülü, BOM satırlı): pem_somun · pem_saplama · percin_somun · vida (ISO 7380 / DIN 7991 / ISO 4762) ·\n43\t             somun (ISO 4032 / ISO 10511 / DIN 1587) · pul (DIN 125 / DIN 9021) · kor_percin (ISO 15983) · ayarli_ayak · kor_burc ·\n44\t             kaynak_somunu (DIN 929) · gizli_mentese · piyano_mentese · kaynak_dikisi · kaynak_halka\n45\t  Çıktı:     glb_yaz(yol, parcalar) · parca_kutusu_satiri(p) · cakisma_denetle(parcalar)\n46\t\n47\tSINIRLAR (v1): köşe kapama / köşe rahatlatma yalnız 90° dışbükey köşe + iki 90° aynı yönlü flanş · flanş yanları dik (konik flanş yok) ·\n48\t  büküm bölgesine taşan EĞRİ kesik 3B'de 0,1 mm basamakla yaklaşılır (açınım tam) · panjur / kabartma şekil (form) olarak modellenir,\n49\t  açınımda takım işareti (yeniden büküm ve kalınlık denetimi dışı) · abkant çarpışması düz bıçak + V kalıp + koç bloğuyla basit 3B denetim.\"\"\"\n50\timport math, os, re, sys, json, time, struct\n51\timport numpy as np\n52\timport cadquery as cq\n53\tfrom OCP.gp import gp_Pnt, gp_Pnt2d, gp_Dir, gp_Vec, gp_Lin, gp_Pln, gp_Trsf\n54\tfrom OCP.BRepBuilderAPI import BRepBuilderAPI_Transform\n55\tfrom OCP.BRepPrimAPI import BRepPrimAPI_MakePrism\n56\tfrom OCP.BRepClass import BRepClass_FaceClassifier\n57\tfrom OCP.TopAbs import TopAbs_IN, TopAbs_REVERSED\n58\tfrom OCP.IntCurvesFace import IntCurvesFace_ShapeIntersector\n59\tfrom OCP.BRepAlgoAPI import BRepAlgoAPI_Section\n60\tfrom OCP.BRepTools import BRepTools_WireExplorer\n61\tfrom OCP.BRepAdaptor import BRepAdaptor_Curve, BRepAdaptor_Surface\n62\tfrom OCP.BRepLProp import BRepLProp_SLProps\n63\tfrom OCP.TopExp import TopExp\n64\tfrom OCP.BRep import BRep_Tool\n65\t\n66\tV = cq.Vector\n67\tSURUM = \"h3_sac_v1\"\n68\tYOGUNLUK = 7.93e-6                      # kg/mm³ · AISI 304\n69\tEPS = 1e-7\n70\t\n71\t\n72\t# =====================================================================================================================================\n73\t# 1 · STANDART (kararlar > standart > varsayılan)\n74\t# =====================================================================================================================================\n75\t_BURADA = os.path.dirname(os.path.abspath(__file__))\n76\t_STD_KLASOR = os.environ.get(\"AUTOKITCH_SAC_STANDART\") or os.path.abspath(os.path.join(_BURADA, \"..\", \"..\", \"..\", \"..\", \"sac_standart\"))\n77\t\n78\t\n79\tdef _ifade(x, t):\n80\t    \"\"\"'6t' · 't' · 't/4' · 3.5 → sayı (t yerine konur)\"\"\"\n81\t    if x is None: return None\n82\t    if isinstance(x, (int, float)): return float(x)\n83\t    s = str(x).strip().replace(\",\", \".\").replace(\" \", \"\")\n84\t    if not re.fullmatch(r\"[0-9t\\.\\*/\\+\\-\\(\\)]+\", s): return None\n85\t    s = re.sub(r\"(\\d)t\", r\"\\1*t\", s)\n86\t    try:\n87\t        return float(eval(s, {\"__builtins__\": {}}, {\"t\": t}))\n88\t    except Exception:\n89\t        return None\n90\t\n91\t\n92\tclass Standart:\n93\t    \"\"\"sac_kararlar_v1.json > sac_standart_v1.json > varsayılan. Her okunan değer kaynağıyla .kullanilan'a yazılır.\"\"\"\n94\t    ROL = {\"dis\": ((\"kabuk_dis_t\",), (\"kalinlik\", \"ana_sac\"), 1.2), \"ic\": ((\"ic_panel_t\",), (\"kalinlik\", \"ana_sac\"), 1.0),\n95\t           \"yuk\": ((\"raf_tabla_t\",), (\"kalinlik\", \"yuk_saci\"), 1.5), \"kapak_dis\": ((\"kapak_dis_t\",), (\"kapak\", \"dis_tava_t\"), 1.2),\n96\t           \"kapak_ic\": ((\"kapak_ic_tava_t\",), (\"kapak\", \"ic_tava_t\"), 1.0), \"braket\": ((\"braket_t\",), (\"kalinlik\", \"braket\"), 3.0)}\n97\t    ROL_ES = {\"taban\": \"yuk\", \"raf\": \"yuk\", \"tabla\": \"yuk\", \"kabuk\": \"dis\", \"tava_ic\": \"kapak_ic\"}\n98\t\n99\t    def __init__(self, klasor=None):\n100\t        self.klasor = klasor or _STD_KLASOR\n101\t        self.std, self.kar, self.dosyalar, self.kullanilan = {}, {}, [], {}\n102\t        for ad, hedef in ((\"sac_standart_v1.json\", \"std\"), (\"sac_kararlar_v1.json\", \"kar\")):\n103\t            yol = os.path.join(self.klasor, ad)\n104\t            if os.path.exists(yol):\n105\t                with open(yol, encoding=\"utf-8\") as f:\n106\t                    setattr(self, hedef, json.load(f))\n107\t                self.dosyalar.append(yol)\n108\t\n109\t    def _yaz(self, ad, deger, kaynak):\n110\t        self.kullanilan[ad] = (deger, kaynak)\n111\t        return deger\n112\t\n113\t    @staticmethod\n114\t    def _g(d, *yol):\n115\t        for k in yol:\n116\t            if not isinstance(d, dict) or k not in d: return None\n117\t            d = d[k]\n118\t        return d\n119\t\n120\t    def _satir(self, t):\n121\t        tab = self.std.get(\"bukum\") or {}\n122\t        if not tab: return None, None\n123\t        k, v = min(tab.items(), key=lambda kv: abs(float(kv[0]) - t))\n124\t        return (v, \"standart.bukum[%s]\" % k) if abs(float(k) - t) < 0.011 else (None, None)\n125\t\n126\t    def t(self, rol):\n127\t        rol = self.ROL_ES.get(rol, rol)\n128\t        kk, sk, vv = self.ROL[rol]\n129\t        v = self._g(self.kar, *kk)\n130\t        if v is not None: return self._yaz(\"t_\" + rol, float(v), \"kararlar.\" + \".\".join(kk))\n131\t        v = self._g(self.std, *sk)\n132\t        if v is not None: return self._yaz(\"t_\" + rol, float(v), \"standart.\" + \".\".join(sk))\n133\t        return self._yaz(\"t_\" + rol, vv, \"varsayilan\")\n134\t\n135\t    def R(self, t):\n136\t        c = self._g(self.kar, \"ic_radyus_carpan\")\n137\t        if c is not None: return self._yaz(\"R(%g)\" % t, round(float(c) * t, 4), \"kararlar.ic_radyus_carpan\")\n138\t        s, k = self._satir(t)\n139\t        if s and s.get(\"R_ic_model\") is not None: return self._yaz(\"R(%g)\" % t, float(s[\"R_ic_model\"]), k)\n140\t        return self._yaz(\"R(%g)\" % t, 1.0 * t, \"varsayilan R = t\")\n141\t\n142\t    def K(self, t):\n143\t        s, k = self._satir(t)\n144\t        if s and s.get(\"K\") is not None: return self._yaz(\"K(%g)\" % t, float(s[\"K\"]), k + \" (BD tablosu)\")\n145\t        v = self._g(self.kar, \"K\")\n146\t        if v is not None: return self._yaz(\"K(%g)\" % t, float(v), \"kararlar.K\")\n147\t        return self._yaz(\"K(%g)\" % t, 0.40, \"varsayilan\")\n148\t\n149\t    def V(self, t):\n150\t        s, k = self._satir(t)\n151\t        if s and s.get(\"V_kalip\"): return float(s[\"V_kalip\"])\n152\t        return float(max(4, 2 * round(4 * t)))\n153\t\n154\t    def min_flans(self, t):\n155\t        \"\"\"(mutlak, tasarim) dış ölçü\"\"\"\n156\t        s, k = self._satir(t)\n157\t        if s and s.get(\"min_flans_mutlak\") is not None:\n158\t            return self._yaz(\"min_flans(%g)\" % t, (float(s[\"min_flans_mutlak\"]), float(s[\"min_flans_tasarim\"])), k)\n159\t        return self._yaz(\"min_flans(%g)\" % t, (4.0 * t, 6.0 * t), \"varsayilan 4t / 6t\")\n160\t\n161\t    def relief(self, t):\n162\t        \"\"\"(genişlik, derinlik) — derinlik büküm teğet çizgisinden ebeveyne doğru\"\"\"\n163\t        s, k = self._satir(t)\n164\t        if s and s.get(\"relief_genislik\") is not None:\n165\t            return self._yaz(\"relief(%g)\" % t, (float(s[\"relief_genislik\"]), float(s[\"relief_derinlik\"])), k)\n166\t        return self._yaz(\"relief(%g)\" % t, (t, self.R(t) + t), \"varsayilan t × (R + t)\")\n167\t\n168\t    def mesafe(self, ad, t):\n169\t        \"\"\"delik_flans · yarik_flans · panjur_flans (flanş İÇ yüzünden) · delik_kenar · delik_kopru · min_delik\"\"\"\n170\t        R = self.R(t)\n171\t        anahtar = {\"delik_flans\": \"delik_flans_ic_yuz\", \"yarik_flans\": \"uzun_yarik_flans_ic_yuz\", \"panjur_flans\": \"panjur_flans_ic_yuz\",\n172\t                   \"delik_kenar\": \"delik_sac_kenari\", \"delik_kopru\": \"delik_kopru\", \"min_delik\": \"min_delik_cap\"}[ad]\n173\t        s, k = self._satir(t)\n174\t        if s and s.get(anahtar) is not None: return self._yaz(\"%s(%g)\" % (ad, t), float(s[anahtar]), k)\n175\t        vv = {\"delik_flans\": 2 * t + R, \"yarik_flans\": 4 * t + R, \"panjur_flans\": 3 * t + 2 * R, \"delik_kenar\": 2 * t, \"delik_kopru\": 2 * t,\n176\t              \"min_delik\": t}[ad]\n177\t        return self._yaz(\"%s(%g)\" % (ad, t), vv, \"varsayilan\")\n178\t\n179\t    def kose_bosluk(self, kaynakli=True):\n180\t        if kaynakli:\n181\t            a = self._g(self.std, \"kose\", \"flans_ucu_araligi_kaynakli\")\n182\t            if a: return self._yaz(\"kose_bosluk_kaynakli\", round(sum(a) / len(a), 3), \"standart.kose.flans_ucu_araligi_kaynakli (orta)\")\n183\t            return self._yaz(\"kose_bosluk_kaynakli\", 0.2, \"varsayilan\")\n184\t        a = self._g(self.std, \"kose\", \"kaynaksiz_flans_bosluk_min\")\n185\t        return self._yaz(\"kose_bosluk_kaynaksiz\", float(a) if a is not None else 0.4, \"standart.kose\" if a is not None else \"varsayilan\")\n186\t\n187\t    def kose_deligi(self, t):\n188\t        a = self._g(self.std, \"kose\", \"gizli\")\n189\t        m = re.search(r\"O\\s*=\\s*([0-9.]*)t\", a or \"\")\n190\t        c = float(m.group(1) or 1.0) if m else 2.0\n191\t        return self._yaz(\"kose_deligi(%g)\" % t, c * t, \"standart.kose.gizli\" if m else \"varsayilan 2t\")\n192\t\n193\t    def hem(self, t, tip=\"kapali\"):\n194\t        \"\"\"(R_ic, min_donus)\"\"\"\n195\t        d = self._g(self.std, \"kenar\", tip + \"_hem\")\n196\t        if d:\n197\t            ic = _ifade(d.get(\"ic_cap\"), t); dn = _ifade(d.get(\"donus\"), t)\n198\t            return self._yaz(\"hem_%s(%g)\" % (tip, t), (ic / 2.0, dn), \"standart.kenar.%s_hem\" % tip)\n199\t        return self._yaz(\"hem_%s(%g)\" % (tip, t), (0.5 * t, (6.0 if tip == \"kapali\" else 4.0) * t), \"varsayilan\")\n200\t\n201\t    def derz(self):\n202\t        v = self._g(self.std, \"kapak\", \"derz\")\n203\t        return self._yaz(\"derz\", float(v) if v is not None else 2.0, \"standart.kapak.derz\" if v is not None else \"varsayilan\")\n204\t\n205\t    def montaj_boslugu(self):\n206\t        v = self._g(self.std, \"kapak\", \"ic_dis_bosluk\")\n207\t        return self._yaz(\"montaj_boslugu\", float(v) if v is not None else 0.5, \"standart.kapak.ic_dis_bosluk\" if v is not None else \"varsayilan\")\n208\t\n209\t    def max_acinim(self):\n210\t        v = self._g(self.std, \"malzeme\", \"max_acinim\")\n211\t        return self._yaz(\"max_acinim\", tuple(sorted(float(x) for x in v)) if v else (1500.0, 3000.0), \"standart.malzeme\" if v else \"varsayilan\")\n212\t\n213\t    def abkant_boy(self):\n214\t        v = self._g(self.std, \"malzeme\", \"abkant_max_boy\")\n215\t        return float(v) if v else 3100.0\n216\t\n217\t    def pem_yasak(self):\n218\t        v = self._g(self.std, \"baglanti\", \"sac_gizli_secenek_A_PEM\", \"yasak\")\n219\t        return v if v else [\"PEM CLS (HRB 70 sınırı, 304 sacta tutmaz)\"]\n220\t\n221\t    def pem_delik(self, tur, dis):\n222\t        \"\"\"standarttan PEM delik çapı (SP somun / FHP saplama) ya da None\"\"\"\n223\t        A = self._g(self.std, \"baglanti\", \"sac_gizli_secenek_A_PEM\") or {}\n224\t        D = self._g(self.std, \"baglanti\", \"pem_diger\") or {}\n225\t        if tur == \"SP\":\n226\t            if (A.get(\"somun\") or {}).get(\"dis\") == dis: return A[\"somun\"].get(\"delik\"), A[\"somun\"].get(\"kenar_eksen_min\")\n227\t            r = D.get(\"SP-%s-1\" % dis) or {}\n228\t            return r.get(\"delik\"), r.get(\"kenar_eksen_min\")\n229\t        if tur in (\"FHP\", \"FH4\", \"FHS\", \"FH\"):\n230\t            if (A.get(\"saplama\") or {}).get(\"dis\") == dis: return A[\"saplama\"].get(\"delik\"), A[\"saplama\"].get(\"kenar_eksen_min\")\n231\t            r = D.get(\"FHP-%s\" % dis) or {}\n232\t            return r.get(\"delik\"), r.get(\"kenar_eksen_min\")\n233\t        return None, None\n234\t\n235\t    def percin_somun(self, dis):\n236\t        v = self._g(self.std, \"baglanti\", \"percin_somun\", dis)\n237\t        return v or {}\n238\t\n239\t    def delik_iso273(self, dis, seri=\"orta\"):\n240\t        v = self._g(self.std, \"baglanti\", \"delik_iso273_\" + seri, dis)\n241\t        if v is not None: return float(v)\n242\t        return {\"M3\": 3.4, \"M4\": 4.5, \"M5\": 5.5, \"M6\": 6.6, \"M8\": 9.0, \"M10\": 11.0, \"M12\": 13.5}[dis]\n243\t\n244\t    def gida_R_min(self):\n245\t        v = self._g(self.std, \"kose\", \"urun_bolgesi_ic_R_min\")\n246\t        return float(v) if v is not None else 3.0\n247\t\n248\t    def lazer_yarik(self):\n249\t        v = self._g(self.std, \"havalandirma\", \"lazer_yarik\") or {}\n250\t        return dict(genislik=float(v.get(\"genislik\", 5)), boy=float(v.get(\"boy\", 60)), uc_R=float(v.get(\"uc_R\", 2.5)),\n251\t                    kopru=float(v.get(\"kopru_min\", 5)), sira=float(v.get(\"sira_araligi_min\", 10)), kenar=float(v.get(\"kenar_min\", 10)))\n252\t\n253\t    def panjur_hmax(self, t):\n254\t        v = self._g(self.std, \"havalandirma\", \"panjur_taret\", \"H_max\")\n255\t        return _ifade(v, t) if v is not None else 3 * t\n256\t\n257\t    def kapak(self):\n258\t        k = self._g(self.std, \"kapak\") or {}\n259\t        return dict(dis_donus=float(k.get(\"dis_tava_donus\", 20)), ic_donus=float(k.get(\"ic_tava_donus\", 15)),\n260\t                    ic_dis_bosluk=float(k.get(\"ic_dis_bosluk\", 0.5)), kulp_cep=k.get(\"kulp\", {}).get(\"cep_derinlik\", [25, 30]) if isinstance(k.get(\"kulp\"), dict) else [25, 30],\n261\t                    derz=self.derz())\n262\t\n263\t    def ozet(self):\n264\t        return dict(dosyalar=self.dosyalar, kullanilan={k: dict(deger=v[0], kaynak=v[1]) for k, v in sorted(self.kullanilan.items())})\n265\t\n266\t\n267\tSTD = Standart()\n268\t\n269\t\n270\tdef standart_yukle(klasor=None):\n271\t    \"\"\"sac_standart_v1.json + sac_kararlar_v1.json yeniden okunur (yeni Sac nesneleri yeni değerleri kullanır)\"\"\"\n272\t    global STD\n273\t    STD = Standart(klasor)\n274\t    return STD\n275\t\n276\t\n277\t# =====================================================================================================================================\n278\t# 2 · GEOMETRİ ARAÇLARI\n279\t# =====================================================================================================================================\n280\tdef _n(v):\n281\t    v = np.asarray(v, float); L = float(np.linalg.norm(v))\n282\t    if L < 1e-12: raise ValueError(\"sıfır vektör\")\n283\t    return v / L\n284\t\n285\t\n286\tdef _rot(k, a):\n287\t    k = _n(k); K = np.array([[0.0, -k[2], k[1]], [k[2], 0.0, -k[0]], [-k[1], k[0], 0.0]])\n288\t    return np.eye(3) + math.sin(a) * K + (1.0 - math.cos(a)) * (K @ K)\n289\t\n290\t\n291\tdef _M(Rm=None, o=(0.0, 0.0, 0.0)):\n292\t    M = np.eye(4)\n293\t    if Rm is not None: M[:3, :3] = Rm\n294\t    M[:3, 3] = np.asarray(o, float)\n295\t    return M\n296\t\n297\t\n298\tdef _M_eksen(A, k, a):\n299\t    \"\"\"A noktasından geçen k eksen doğrusu etrafında a (rad) dönüş\"\"\"\n300\t    Rm = _rot(k, a); A = np.asarray(A, float)\n301\t    return _M(Rm, A - Rm @ A)\n302\t\n303\t\n304\tdef _M_ot(v):\n305\t    return _M(None, v)\n306\t\n307\t\n308\tdef _cerceve(nokta, eksen, ref=None):\n309\t    \"\"\"z = eksen · x = ref'in eksene dik bileşeni\"\"\"\n310\t    z = _n(eksen)\n311\t    r = np.asarray(ref, float) if ref is not None else (np.array([1.0, 0, 0]) if abs(z[0]) < 0.9 else np.array([0, 1.0, 0]))\n312\t    x = _n(r - np.dot(r, z) * z); y = np.cross(z, x)\n313\t    return _M(np.column_stack([x, y, z]), nokta)\n314\t\n315\t\n316\tdef _tr(M):\n317\t    tr = gp_Trsf()\n318\t    tr.SetValues(*[float(M[i, j]) for i in range(3) for j in range(4)])\n319\t    return tr\n320\t\n321\t\n322\tdef _tasi(sh, M):\n323\t    if sh is None: return None\n324\t    if np.allclose(M, np.eye(4), atol=1e-12): return sh\n325\t    return cq.Shape.cast(BRepBuilderAPI_Transform(sh.wrapped, _tr(M), True).Shape())\n326\t\n327\t\n328\tdef _p(M, p):\n329\t    return (M @ np.r_[np.asarray(p, float), 1.0])[:3]\n330\t\n331\t\n332\tdef _H_M(H):\n333\t    \"\"\"2B rijit dönüşüm (3×3) → 4×4 (z korunur)\"\"\"\n334\t    M = np.eye(4); M[0, 0], M[0, 1], M[1, 0], M[1, 1] = H[0, 0], H[0, 1], H[1, 0], H[1, 1]; M[0, 3], M[1, 3] = H[0, 2], H[1, 2]\n335\t    return M\n336\t\n337\t\n338\tdef _Hp(H, p):\n339\t    return (H @ np.array([p[0], p[1], 1.0]))[:2]\n340\t\n341\t\n342\tdef _yuz_tasi(f, H):\n343\t    return _tasi(f, _H_M(H))\n344\t\n345\t\n346\tdef _alan2(pts):\n347\t    return 0.5 * sum(pts[i][0] * pts[(i + 1) % len(pts)][1] - pts[(i + 1) % len(pts)][0] * pts[i][1] for i in range(len(pts)))\n348\t\n349\t\n350\tdef _V2(x, y):\n351\t    return V(float(x), float(y), 0.0)\n352\t\n353\t\n354\tdef yuz_poligon(pts):\n355\t    if _alan2(pts) < 0: pts = list(reversed(pts))\n356\t    return cq.Face.makeFromWires(cq.Wire.makePolygon([_V2(*p) for p in pts], close=True))\n357\t\n358\t\n359\tdef yuz_daire(cx, cy, r):\n360\t    return cq.Face.makeFromWires(cq.Wire.makeCircle(float(r), _V2(cx, cy), V(0, 0, 1)))\n361\t\n362\t\n363\tdef yuz_dikd(x0, x1, y0, y1):\n364\t    return yuz_poligon([(x0, y0), (x1, y0), (x1, y1), (x0, y1)])\n365\t\n366\t\n367\tdef yuz_oblong(cx, cy, L, W, aci=0.0):\n368\t    \"\"\"L uç uca toplam boy, W genişlik (uçlar tam yarım daire)\"\"\"\n369\t    if L <= W + 1e-9: return yuz_daire(cx, cy, W / 2.0)\n370\t    r = W / 2.0; a = math.radians(aci); ux, uy = math.cos(a), math.sin(a); nx, ny = -uy, ux; h = L / 2.0 - r\n371\t    p = lambda s, q: _V2(cx + ux * s + nx * q, cy + uy * s + ny * q)\n372\t    e = [cq.Edge.makeLine(p(-h, -r), p(h, -r)), cq.Edge.makeThreePointArc(p(h, -r), p(h + r, 0), p(h, r)),\n373\t         cq.Edge.makeLine(p(h, r), p(-h, r)), cq.Edge.makeThreePointArc(p(-h, r), p(-h - r, 0), p(-h, -r))]\n374\t    return cq.Face.makeFromWires(cq.Wire.assembleEdges(e))\n375\t\n376\t\n377\tdef yuz_dikd_r(cx, cy, L, W, aci=0.0, r=0.0):\n378\t    \"\"\"merkezli, döndürülmüş, köşesi r yuvarlatılmış dikdörtgen\"\"\"\n379\t    a = math.radians(aci); ux, uy = math.cos(a), math.sin(a); nx, ny = -uy, ux\n380\t    p = lambda s, q: _V2(cx + ux * s + nx * q, cy + uy * s + ny * q)\n381\t    hx, hy = L / 2.0, W / 2.0\n382\t    r = min(max(r, 0.0), hx - 1e-6, hy - 1e-6)\n383\t    if r <= 1e-6:\n384\t        return cq.Face.makeFromWires(cq.Wire.makePolygon([p(-hx, -hy), p(hx, -hy), p(hx, hy), p(-hx, hy)], close=True))\n385\t    c = r * (1 - math.sqrt(0.5))\n386\t    e = [cq.Edge.makeLine(p(-hx + r, -hy), p(hx - r, -hy)), cq.Edge.makeThreePointArc(p(hx - r, -hy), p(hx - c, -hy + c), p(hx, -hy + r)),\n387\t         cq.Edge.makeLine(p(hx, -hy + r), p(hx, hy - r)), cq.Edge.makeThreePointArc(p(hx, hy - r), p(hx - c, hy - c), p(hx - r, hy)),\n388\t         cq.Edge.makeLine(p(hx - r, hy), p(-hx + r, hy)), cq.Edge.makeThreePointArc(p(-hx + r, hy), p(-hx + c, hy - c), p(-hx, hy - r)),\n389\t         cq.Edge.makeLine(p(-hx, hy - r), p(-hx, -hy + r)), cq.Edge.makeThreePointArc(p(-hx, -hy + r), p(-hx + c, -hy + c), p(-hx + r, -hy))]\n390\t    return cq.Face.makeFromWires(cq.Wire.assembleEdges(e))\n391\t\n392\t\n393\tdef _prizma(face, h):\n394\t    return cq.Shape.cast(BRepPrimAPI_MakePrism(face.wrapped, gp_Vec(0.0, 0.0, float(h))).Shape())\n395\t\n396\t\n397\tdef _bb_kesisir(a, b, pay=1e-6):\n398\t    return a.xmin <= b.xmax + pay and b.xmin <= a.xmax + pay and a.ymin <= b.ymax + pay and b.ymin <= a.ymax + pay and a.zmin <= b.zmax + pay and b.zmin <= a.zmax + pay\n399\t\n400\t\n401\tdef _birlestir(ss, temizle=True):\n402\t    ss = [s for s in ss if s is not None]\n403\t    if not ss: return None\n404\t    s = ss[0] if len(ss) == 1 else ss[0].fuse(*ss[1:])\n405\t    return s.clean() if temizle else s\n406\t\n407\t\n408\tdef _alan(sh):\n409\t    return 0.0 if sh is None else sum(f.Area() for f in sh.Faces())\n410\t\n411\t\n412\tdef _icinde(face, p, tol=1e-7):\n413\t    for f in (face.Faces() if face is not None else []):\n414\t        if BRepClass_FaceClassifier(f.wrapped, gp_Pnt(float(p[0]), float(p[1]), float(p[2]) if len(p) > 2 else 0.0), tol).State() == TopAbs_IN:\n415\t            return True\n416\t    return False\n417\t\n418\t\n419\tdef _ic_nokta(face):\n420\t    \"\"\"düzlemsel yüzün içinde bir nokta\"\"\"\n421\t    for f in face.Faces():\n422\t        c = f.Center()\n423\t        if _icinde(f, (c.x, c.y, c.z)): return (c.x, c.y, c.z)\n424\t        bb = f.BoundingBox()\n425\t        for i in range(1, 12):\n426\t            for j in range(1, 12):\n427\t                q = (bb.xmin + bb.xlen * i / 12.0, bb.ymin + bb.ylen * j / 12.0, c.z)\n428\t                if _icinde(f, q): return q\n429\t    return None\n430\t\n431\t\n432\tdef _sektor(A0, k, rho, e3, w0, w1, r0, r1, phi0, dphi):\n433\t    \"\"\"A0'dan geçen k ekseni etrafında, başlangıçta rho yönündeki r0–r1 / w0–w1 dikdörtgeninin phi0 → phi0 + dphi taranmasıyla\n434\t    oluşan halka dilimi (gerçek silindirik büküm bölgesi)\"\"\"\n435\t    A0, k, rho, e3 = (np.asarray(x, float) for x in (A0, k, rho, e3))\n436\t    r0 = max(r0, 1e-3)\n437\t    Q = lambda w, r: V(*(A0 + e3 * w + rho * r))\n438\t    tel = cq.Wire.makePolygon([Q(w0, r0), Q(w1, r0), Q(w1, r1), Q(w0, r1)], close=True)\n439\t    s = cq.Solid.revolve(tel, [], math.degrees(dphi), V(*A0), V(*(A0 + k)))\n440\t    if abs(phi0) > 1e-12: s = s.rotate(V(*A0), V(*(A0 + k)), math.degrees(phi0))\n441\t    return s\n442\t\n443\t\n444\tdef _dikd_ayir(yuz_sw, BA, dw=0.1):\n445\t    \"\"\"(s, w) düzlemindeki şerit parçasını eksene paralel dikdörtgenlere ayırır → [(s0, s1, w0, w1)].\n446\t    Dikdörtgen kenarlı parça TAM ayrılır; eğik / eğri kenar varsa w'de dw adımlı basamak (yaklaşık).\"\"\"\n447\t    out = []\n448\t    if yuz_sw is None: return out\n449\t    for f in yuz_sw.Faces():\n450\t        bb = f.BoundingBox(); A = f.Area()\n451\t        if A < 1e-9: continue\n452\t        if abs(A - bb.xlen * bb.ylen) <= 1e-7 * max(1.0, bb.xlen * bb.ylen):\n453\t            out.append((max(0.0, bb.xmin), min(BA, bb.xmax), bb.ymin, bb.ymax)); continue\n454\t        ws = {round(bb.ymin, 9), round(bb.ymax, 9)}\n455\t        for e in f.Edges():\n456\t            eb = e.BoundingBox()\n457\t            ws.update([round(eb.ymin, 9), round(eb.ymax, 9)])\n458\t            duz = e.geomType() == \"LINE\" and (eb.xlen < 1e-7 or eb.ylen < 1e-7)\n459\t            if not duz:\n460\t                n = max(1, int(math.ceil(eb.ylen / dw)))\n461\t                ws.update(round(eb.ymin + eb.ylen * i / n, 9) for i in range(n + 1))\n462\t        ws = sorted(ws)\n463\t        for w0, w1 in zip(ws[:-1], ws[1:]):\n464\t            if w1 - w0 < 1e-7: continue\n465\t            satir = f.intersect(yuz_dikd(-1.0, BA + 1.0, w0, w1))\n466\t            for g in satir.Faces():\n467\t                gb = g.BoundingBox()\n468\t                if g.Area() > 1e-10: out.append((max(0.0, gb.xmin), min(BA, gb.xmax), w0, w1))\n469\t    return out\n470\t\n471\t\n472\t# =====================================================================================================================================\n473\t# 3 · SAC PARÇA MODELİ\n474\t# =====================================================================================================================================\n475\tclass Kesik:\n476\t    \"\"\"panel yerel (u, v) koordinatında kesik; açınım anlamında: hedef None ise dokunduğu her bölgeyi keser\"\"\"\n477\t    def __init__(self, sahip, yuz, tip, meta=None, dfm=True, hedef=None):\n478\t        self.sahip, self.yuz, self.tip, self.meta, self.dfm, self.hedef = sahip, yuz, tip, dict(meta or {}), dfm, hedef\n479\t\n480\t\n481\tclass Bukum:\n482\t    def __init__(self, **k):\n483\t        self.__dict__.update(k)\n484\t\n485\t    def ozet(self):\n486\t        return dict(no=self.no, ad=self.cocuk.ad, ebeveyn=self.ebeveyn.ad, kenar=self.kenar, aci=round(self.aci, 4),\n487\t                    yon=\"yukari\" if self.yon > 0 else \"asagi\", R=round(self.R, 4), K=round(self.K, 4), BA=round(self.BA, 4),\n488\t                    boy=round(self.b - self.a, 3), duz_flans=round(self.Lf, 3), olcu=self.olcu, olcu_deger=self.boy, tip=self.tip)\n489\t\n490\t\n491\tclass Panel:\n492\t    def __init__(self, sac, no, ad, poly, M, D, ebeveyn=None, bukum=None):\n493\t        self.sac, self.no, self.ad = sac, no, ad\n494\t        self.poly = [(float(p[0]), float(p[1])) for p in poly]\n495\t        self.M, self.D = M, D\n496\t        self.ebeveyn, self.bukum = ebeveyn, bukum\n497\t        self.cocuklar, self.dil_kenar = {}, {}\n498\t        self.kesikler, self.ekler, self.formlar = [], [], []\n499\t\n500\t    def __repr__(self):"}]},"uuid":"946bbac5-ad06-4ad7-b7de-155227595735","timestamp":"2026-10-01T22:48:50.827Z","sourceToolAssistantUUID":"b9194396-b0a2-425d-b7de-a394d7acc4d5","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
