{"parentUuid":"4a741b19-731c-4ffa-951a-f92635581f74","isSidechain":true,"promptId":"6d13b065-9608-42c4-83ca-508fc3c4db72","agentId":"a25b9854cf7bf8eac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01STsEDYvt26VmaKEFLbCqVA","type":"tool_result","content":"1200\t            if zz and abs((max(zz) - min(zz)) - t) < tol:\n1201\t                r[\"kenar\"] += 1; continue\n1202\t        if A < 0.05 * t * t:                                         # eğri kesiğin basamak yüzü (0,1 mm adım) — yaklaşım artığı\n1203\t            r[\"basamak\"] = r.get(\"basamak\", 0) + 1; continue\n1204\t        r[\"hata\"].append(dict(yuz=i, tip=f.geomType(), alan=round(A, 3), isin=[round(d, 4) for d in ds], w=[round(w, 4) for w in ws_]))\n1205\t    if ol: r[\"olcum_min\"], r[\"olcum_max\"] = round(min(ol), 5), round(max(ol), 5)\n1206\t    r[\"gecti\"] = not r[\"hata\"]\n1207\t    return r\n1208\t\n1209\t\n1210\tdef _kutu_icinde(p, k):\n1211\t    return k[0] <= p[0] <= k[1] and k[2] <= p[1] <= k[3] and k[4] <= p[2] <= k[5]\n1212\t\n1213\t\n1214\tdef kesit_yaricaplari(sh, nokta, normal, eksen=None, tol=1e-3):\n1215\t    \"\"\"nokta'dan geçen, normal'e dik düzlemle kesit → daire yaylarının yarıçapları (eksen verilirse yalnız o merkezli yaylar)\"\"\"\n1216\t    sec = BRepAlgoAPI_Section(sh.wrapped, gp_Pln(gp_Pnt(*map(float, nokta)), gp_Dir(*map(float, _n(normal)))), False)\n1217\t    sec.Build()\n1218\t    out = []\n1219\t    for e in cq.Shape.cast(sec.Shape()).Edges():\n1220\t        if e.geomType() != \"CIRCLE\": continue\n1221\t        c = e.arcCenter()\n1222\t        if eksen is not None and np.linalg.norm(np.array([c.x, c.y, c.z]) - np.asarray(eksen)) > tol: continue\n1223\t        out.append(e.radius())\n1224\t    return out\n1225\t\n1226\t\n1227\tdef kesit_kenarlari(sh, nokta, normal, adim=24):\n1228\t    \"\"\"kesit çizimi için: [(tip, [noktalar])] — doğru ve yaylar ayrıklaştırılmış\"\"\"\n1229\t    sec = BRepAlgoAPI_Section(sh.wrapped, gp_Pln(gp_Pnt(*map(float, nokta)), gp_Dir(*map(float, _n(normal)))), False)\n1230\t    sec.Build(); out = []\n1231\t    for e in cq.Shape.cast(sec.Shape()).Edges():\n1232\t        c = BRepAdaptor_Curve(e.wrapped); u0, u1 = c.FirstParameter(), c.LastParameter()\n1233\t        n = 1 if e.geomType() == \"LINE\" else adim\n1234\t        out.append((e.geomType(), [tuple(np.array([c.Value(u0 + (u1 - u0) * i / n).X(), c.Value(u0 + (u1 - u0) * i / n).Y(), c.Value(u0 + (u1 - u0) * i / n).Z()])) for i in range(n + 1)]))\n1235\t    return out\n1236\t\n1237\t\n1238\t# =====================================================================================================================================\n1239\t# 7 · DFM (üretilebilirlik)\n1240\t# =====================================================================================================================================\n1241\tdef _madde(kural, durum, detay, **k):\n1242\t    return dict(kural=kural, durum=durum, detay=detay, **k)\n1243\t\n1244\t\n1245\tdef _ic_yuz_payi(B):\n1246\t    \"\"\"büküm teğet çizgisinden flanş iç yüzüne\"\"\"\n1247\t    return B.R * math.tan(min(B.th, math.pi / 2) / 2.0)\n1248\t\n1249\t\n1250\tdef dfm_denetle(sac, abkant=True):\n1251\t    t = sac.t; out = []\n1252\t    mut, tas = STD.min_flans(t)\n1253\t    # 1 · min flanş / hem dönüşü\n1254\t    for B in sac.bukumler:\n1255\t        poly = B.cocuk.poly; Lmin = min(p[0] for p in poly if p[0] > 1e-9) if any(p[0] > 1e-9 for p in poly) else B.Lf\n1256\t        if B.tip.startswith(\"kivirma\"):\n1257\t            R_, dmin = STD.hem(t, B.tip.split(\"_\")[1])\n1258\t            d = \"%s dönüş %.2f ≥ %.2f (%s)\" % (B.cocuk.ad, Lmin, dmin, B.tip)\n1259\t            out.append(_madde(\"min_flans\", \"GEÇTİ\" if Lmin >= dmin - 1e-6 else \"HATA\", d, bukum=B.no + 1))\n1260\t            if t > 1.5 and B.tip == \"kivirma_kapali\": out.append(_madde(\"hem_kalinlik\", \"HATA\", \"304 kapalı hem t ≤ 1,5 (standart)\", bukum=B.no + 1))\n1261\t            continue\n1262\t        dis = (Lmin + math.tan(min(B.th, math.radians(179)) / 2.0) * (t + B.R) if B.aci < 179 else Lmin) + getattr(B, \"uc_geri\", 0.0)\n1263\t        dur = \"GEÇTİ\" if dis >= tas - 1e-6 else (\"UYARI\" if dis >= mut - 1e-6 else \"HATA\")\n1264\t        if B.tip == \"ofset\" and dur != \"GEÇTİ\": dur = \"BİLGİ\"\n1265\t        out.append(_madde(\"min_flans\", dur, \"%s dış %.2f (düz %.2f) · mutlak %.1f · tasarım %.1f%s\" % (B.cocuk.ad, dis, Lmin, mut, tas,\n1266\t                                                                                                 \" · ofset kalıbıyla tek vuruş\" if B.tip == \"ofset\" else \"\"), bukum=B.no + 1))\n1267\t    # 2 · aynı parçada tek R\n1268\t    Rs = sorted({round(B.R, 4) for B in sac.bukumler if not B.tip.startswith(\"kivirma\")})\n1269\t    Rh = sorted({round(B.R, 4) for B in sac.bukumler if B.tip.startswith(\"kivirma\")})\n1270\t    if sac.bukumler:\n1271\t        out.append(_madde(\"tek_R\", \"GEÇTİ\" if len(Rs) <= 1 else \"HATA\", \"büküm R %s%s\" % (Rs, \" · kıvırma (ayrı takım) R %s\" % Rh if Rh else \"\")))\n1272\t    if sac.bolge == \"gida\":\n1273\t        rm = STD.gida_R_min()\n1274\t        out.append(_madde(\"gida_ic_R\", \"GEÇTİ\" if all(r >= rm - 1e-9 for r in Rs) else \"HATA\", \"gıda bölgesi iç R ≥ %.1f · bulunan %s\" % (rm, Rs)))\n1275\t        if any(k[\"kayit\"][\"tip\"] == \"bindirme\" for k in sac.kaynaklar): out.append(_madde(\"gida_bindirme\", \"HATA\", \"gıda bölgesinde bindirme yok (standart)\"))\n1276\t    # 3 · relief / köşe\n1277\t    pan, ser = sac._bolgeler()\n1278\t    for B in sac.bukumler:\n1279\t        P = B.ebeveyn; kn = P.kenar(B.kenar)\n1280\t        for uc, w, sg in ((\"bas\", B.a, -1), (\"son\", B.b, +1)):\n1281\t            kos = getattr(B, \"kose_bas\" if uc == \"bas\" else \"kose_son\", None)\n1282\t            q = kn[\"p0\"] + kn[\"e2\"] * (w + sg * 0.05) - kn[\"out2\"] * 0.05\n1283\t            ham = _icinde(P._ham_yuz(), (q[0], q[1], 0.0))          # kesiksiz panelde büküm ucunun yanında malzeme var mı\n1284\t            son_ = _icinde(pan[P.no], (q[0], q[1], 0.0))            # kesiklerden sonra hâlâ var mı\n1285\t            if kos is not None:\n1286\t                if kos[\"rahat\"] is None:\n1287\t                    out.append(_madde(\"kose_rahatlatma\", \"UYARI\", \"%s %s ucu: köşede rahatlatma yok (lazer köşe deliği Ø2t önerilir)\" % (B.cocuk.ad, uc), bukum=B.no + 1))\n1288\t                else:\n1289\t                    out.append(_madde(\"kose_rahatlatma\", \"GEÇTİ\", \"%s %s ucu: köşe %s rahatlatma\" % (B.cocuk.ad, uc, kos[\"rahat\"]), bukum=B.no + 1))\n1290\t                continue\n1291\t            if ham:\n1292\t                out.append(_madde(\"relief\", \"HATA\" if son_ else \"GEÇTİ\", \"%s %s ucu: kenar büküm ucunda devam ediyor · relief %s\" % (B.cocuk.ad, uc, \"YOK\" if son_ else \"VAR\"),\n1293\t                                  bukum=B.no + 1))\n1294\t    # 4 · delik ↔ büküm / kenar / köprü / çap / PEM\n1295\t    D = sac._duz_yuz()\n1296\t    dis_tel = [f.outerWire() for f in D.Faces()]\n1297\t    serit_duz = {B.no: _yuz_tasi(ser[B.no], B.ebeveyn.D @ B.Hs) for B in sac.bukumler if _alan(ser[B.no]) > 1e-9}\n1298\t    dfm_kes = [(P, k, _yuz_tasi(k.yuz, P.D)) for P in sac.paneller for k in P.kesikler if k.dfm]\n1299\t    md = STD.mesafe(\"min_delik\", t); dk = STD.mesafe(\"delik_kenar\", t); kp = STD.mesafe(\"delik_kopru\", t)\n1300\t    yasak = \" \".join(STD.pem_yasak())\n1301\t    for P, k, kf in dfm_kes:\n1302\t        ad = \"%s/%s\" % (P.ad, k.tip)\n1303\t        olc = k.meta.get(\"cap\") or min(k.meta.get(\"en\") or 1e9, k.meta.get(\"boy\") or 1e9)\n1304\t        if olc and olc < 1e8 and olc < md - 1e-9 and k.tip not in (\"yuva\",):\n1305\t            out.append(_madde(\"min_delik_cap\", \"HATA\", \"%s Ø/en %.2f < %.2f\" % (ad, olc, md)))\n1306\t        if k.tip in (\"pem_somun\", \"pem_saplama\"):\n1307\t            kural = \"pem_eksen_flans\"; ihtiyac = k.meta.get(\"kenar_min\", 7.0)\n1308\t        elif k.tip in (\"yarik\", \"havalandirma_yarigi\") or k.meta.get(\"sekil\") == \"oblong\":\n1309\t            kural = \"yarik_flans\"; ihtiyac = STD.mesafe(\"yarik_flans\", t)\n1310\t        else:\n1311\t            kural = \"delik_flans\"; ihtiyac = STD.mesafe(\"delik_flans\", t)\n1312\t        for B in sac.bukumler:\n1313\t            if B.no not in serit_duz: continue\n1314\t            d = kf.distance(serit_duz[B.no])\n1315\t            if k.tip in (\"pem_somun\", \"pem_saplama\"):\n1316\t                c = k.meta[\"merkez\"]; cd = _Hp(P.D, c); d = serit_duz[B.no].distance(cq.Vertex.makeVertex(cd[0], cd[1], 0.0))\n1317\t                gerek = ihtiyac + B.R\n1318\t                dd = d                         # eksen → teğet; standart: eksen → flanş iç yüzü ≥ kenar + R ⇔ eksen → teğet ≥ kenar\n1319\t                if dd + _ic_yuz_payi(B) < gerek - 1e-6:\n1320\t                    out.append(_madde(kural, \"HATA\", \"%s eksen → büküm %d iç yüzü %.2f < %.2f\" % (ad, B.no + 1, dd + _ic_yuz_payi(B), gerek)))\n1321\t            elif k.tip == \"yuva\":\n1322\t                continue\n1323\t            elif d + _ic_yuz_payi(B) < ihtiyac - 1e-6:\n1324\t                out.append(_madde(kural, \"HATA\", \"%s → büküm %d iç yüzü %.2f < %.2f\" % (ad, B.no + 1, d + _ic_yuz_payi(B), ihtiyac)))\n1325\t        dke = min(kf.distance(w) for w in dis_tel)\n1326\t        if k.tip in (\"pem_somun\", \"pem_saplama\"):\n1327\t            c = _Hp(P.D, k.meta[\"merkez\"]); dke = min(w.distance(cq.Vertex.makeVertex(c[0], c[1], 0.0)) for w in dis_tel)\n1328\t            if dke < k.meta.get(\"kenar_min\", 7.0) - 1e-6:\n1329\t                out.append(_madde(\"pem_kenar\", \"HATA\", \"%s eksen → sac kenarı %.2f < %.2f\" % (ad, dke, k.meta.get(\"kenar_min\", 7.0))))\n1330\t            pt = k.meta.get(\"pem_tip\", \"\")\n1331\t            if any(pt and pt in w_.split(\" \")[1:2] for w_ in STD.pem_yasak()) or (\"CLS\" in pt and \"CLS\" in yasak):\n1332\t                out.append(_madde(\"pem_malzeme\", \"HATA\", \"%s PEM %s 304 sacta yasak (%s)\" % (ad, pt, yasak)))\n1333\t            if t < k.meta.get(\"min_sac\", 0) - 1e-9:\n1334\t                out.append(_madde(\"pem_min_sac\", \"HATA\", \"%s sac %.2f < PEM min %.2f\" % (ad, t, k.meta[\"min_sac\"])))\n1335\t        elif dke < dk - 1e-6 and k.tip != \"yuva\":\n1336\t            out.append(_madde(\"delik_kenar\", \"HATA\", \"%s → sac kenarı %.2f < %.2f\" % (ad, dke, dk)))\n1337\t    for i in range(len(dfm_kes)):\n1338\t        for j in range(i + 1, len(dfm_kes)):\n1339\t            a, b = dfm_kes[i][2], dfm_kes[j][2]\n1340\t            if not _bb_kesisir(a.BoundingBox(), b.BoundingBox(), kp + 1.0): continue\n1341\t            d = a.distance(b)\n1342\t            if d < kp - 1e-6:\n1343\t                out.append(_madde(\"delik_kopru\", \"HATA\", \"%s ↔ %s köprü %.2f < %.2f\" % (dfm_kes[i][0].ad, dfm_kes[j][0].ad, d, kp)))\n1344\t    if not any(m[\"kural\"] in (\"delik_flans\", \"yarik_flans\", \"pem_eksen_flans\", \"delik_kenar\", \"pem_kenar\", \"delik_kopru\", \"min_delik_cap\", \"pem_malzeme\")\n1345\t               for m in out):\n1346\t        out.append(_madde(\"delikler\", \"GEÇTİ\", \"%d delik/kesik: büküm iç yüzü (delik %.1f · yarık %.1f · PEM kenar+R) · kenar %.1f · köprü %.1f · Ø ≥ %.1f\"\n1347\t                          % (len(dfm_kes), STD.mesafe(\"delik_flans\", t), STD.mesafe(\"yarik_flans\", t), dk, kp, md)))\n1348\t    # 5 · dil\n1349\t    for P in sac.paneller:\n1350\t        for e in P.ekler:\n1351\t            if e[\"tip\"] == \"dil\":\n1352\t                ok = e[\"en\"] >= 2 * t - 1e-9 and e[\"boy\"] <= 5 * e[\"en\"] + 1e-9\n1353\t                out.append(_madde(\"dil\", \"GEÇTİ\" if ok else \"UYARI\", \"%s dil %.1f × %.1f (en ≥ 2t, boy ≤ 5 en)\" % (P.ad, e[\"en\"], e[\"boy\"])))\n1354\t    # 6 · levha boyu + abkant boyu + tek parça\n1355\t    a = sac.acinim(); Lmax, Wmax = STD.max_acinim()[1], STD.max_acinim()[0]\n1356\t    L, W = a[\"levha\"][\"boy\"], a[\"levha\"][\"en\"]\n1357\t    out.append(_madde(\"levha\", \"GEÇTİ\" if (L <= Lmax + 1e-6 and W <= Wmax + 1e-6) else \"HATA\", \"açınım %.1f × %.1f ≤ %.0f × %.0f\" % (L, W, Lmax, Wmax)))\n1358\t    bmax = max([B.b - B.a for B in sac.bukumler] or [0.0])\n1359\t    if sac.bukumler:\n1360\t        out.append(_madde(\"abkant_boy\", \"GEÇTİ\" if bmax <= STD.abkant_boy() else \"HATA\", \"en uzun büküm %.1f ≤ %.0f\" % (bmax, STD.abkant_boy())))\n1361\t    out.append(_madde(\"tek_parca_duz\", \"GEÇTİ\" if a[\"parca_sayisi\"] == 1 else \"HATA\", \"açınım %d parça\" % a[\"parca_sayisi\"]))\n1362\t    K = sac.kati_temel()\n1363\t    bs = sac._bolge_katilari(); top = sum(s.Volume() for _e, s in bs); vk = K.Volume()\n1364\t    out.append(_madde(\"tek_parca_3b\", \"GEÇTİ\" if len(K.Solids()) == 1 else \"HATA\", \"3B %d katı\" % len(K.Solids())))\n1365\t    ort = top - vk\n1366\t    out.append(_madde(\"kendi_cakisma\", \"GEÇTİ\" if ort < 1e-3 * max(1.0, vk) * 1e-3 + 1e-3 else \"HATA\", \"bölgeler toplamı − birleşik hacim = %.4f mm³\" % ort))\n1367\t    # 7 · abkant sırası / çarpışma\n1368\t    if abkant and sac.bukumler:\n1369\t        ab = abkant_denetle(sac)\n1370\t        sor = ab[\"varsayilan_carpisma\"]\n1371\t        if not sor:\n1372\t            out.append(_madde(\"abkant\", \"GEÇTİ\", \"sıra %s · bıçak / kalıp / koç çarpması yok%s\" % (ab[\"sira\"], \" · \" + ab[\"not_\"] if ab[\"not_\"] else \"\"), sira=ab[\"sira\"]))\n1373\t        elif ab[\"oneri_sira\"] and not ab[\"oneri_carpisma\"]:\n1374\t            out.append(_madde(\"abkant\", \"UYARI\", \"tanım sırasında çarpışma %s → ÖNERİLEN SIRA %s temiz\" % (sor[:3], ab[\"oneri_sira\"]), sira=ab[\"oneri_sira\"]))\n1375\t        else:\n1376\t            ar = ab.get(\"arama\") or {}\n1377\t            out.append(_madde(\"abkant\", \"HATA\", \"düz bıçak + V kalıpla HİÇBİR sırada temiz değil (%s %d sıra denemesi%s) · en iyi sıra %s · çarpışma %s → kaz boynu bıçak + bölünmüş kalıp \"\n1378\t                              \"ya da profil ayrı parça\" % (\"tam arama\" if ar.get(\"tam\") else \"sınırda kesildi\", ar.get(\"deneme\", 0), \"\", ab[\"oneri_sira\"],\n1379\t                                                          [(c[\"bukum\"], c[\"evre\"], c[\"arac\"], c[\"bolge\"]) for c in (ab[\"oneri_carpisma\"] or sor)[:4]]),\n1380\t                              sira=ab[\"oneri_sira\"]))\n1381\t    return out\n1382\t\n1383\t\n1384\t# =====================================================================================================================================\n1385\t# 8 · ABKANT ÇARPIŞMA (basit 3B: düz bıçak + koç bloğu + V kalıp)\n1386\t# =====================================================================================================================================\n1387\tBICAK = dict(uc_aci=85.0, govde=26.0, yukseklik=100.0, koc_gen=80.0, koc_yuk=500.0, kalip_gen=None, kalip_yuk=80.0, kalip_aci=88.0, kalip_tasma=5.0)   # kalip_gen None → V + 18 (tek V kalıp) · kalip_tasma: kalıbın büküm boyundan taşması (0 = bölünmüş kalıp)\n1388\t\n1389\t\n1390\tdef _arac_kati(B, t, uc_aci, H, wa, wb):\n1391\t    \"\"\"B'nin ebeveyn yerelinde (düz durum) bıçak + koç ve kalıp katıları · wa–wb gerçek büküm aralığı (bölünmüş bıçak boyu)\"\"\"\n1392\t    R = B.R; d = (1 if B.yon > 0 else -1) * np.array([0, 0, 1.0]); q = B.o3; e = B.e3\n1393\t    wa, wb = wa + 0.2, wb - 0.2\n1394\t    def kati2(poly2, w0, w1):\n1395\t        pts = [V(*(B.A0 + q * a_ + d * b_ + e * w0)) for a_, b_ in poly2]\n1396\t        return cq.Solid.extrudeLinear(cq.Wire.makePolygon(pts, close=True), [], V(*(e * (w1 - w0))))\n1397\t    be = math.radians(uc_aci / 2.0); Rp = max(R - 0.05, 0.05)\n1398\t    T1, T0 = (Rp * math.cos(be), -Rp * math.sin(be)), (-Rp * math.cos(be), -Rp * math.sin(be))\n1399\t    lam = (BICAK[\"govde\"] / 2.0 - Rp * math.cos(be)) / math.sin(be); db = -Rp * math.sin(be) + lam * math.cos(be)\n1400\t    g = BICAK[\"govde\"] / 2.0; kg = BICAK[\"koc_gen\"] / 2.0\n1401\t    bicak = kati2([T0, T1, (g, db), (g, H), (kg, H), (kg, H + BICAK[\"koc_yuk\"]), (-kg, H + BICAK[\"koc_yuk\"]), (-kg, H), (-g, H), (-g, db)], wa, wb)\n1402\t    uc = cq.Solid.makeCylinder(Rp, wb - wa, V(*(B.A0 + e * wa)), V(*e))\n1403\t    bicak = bicak.fuse(uc)\n1404\t    Vk = STD.V(t); top = -(R + t) - 0.01; gd = (Vk / 2.0) / math.tan(math.radians(BICAK[\"kalip_aci\"] / 2.0))\n1405\t    kw, kh = (BICAK[\"kalip_gen\"] or (Vk + 18.0)) / 2.0, BICAK[\"kalip_yuk\"]\n1406\t    kalip = kati2([(-kw, top - kh), (kw, top - kh), (kw, top), (Vk / 2.0, top), (0.0, top - gd), (-Vk / 2.0, top), (-kw, top)], wa - BICAK[\"kalip_tasma\"], wb + BICAK[\"kalip_tasma\"])\n1407\t    return bicak, kalip\n1408\t\n1409\t\n1410\tdef abkant_denetle(sac, sira=None, esik=0.5):\n1411\t    \"\"\"büküm sırası çarpışma denetimi. Her büküm için: (1) düz durumda bıçak + kalıp, (2) bükük durumda (θ/2 dönmüş) bıçak.\n1412\t    Daha önce bükülmüş flanşlar parça üzerinde. Kıvırma (hem) ve ofset ayrı takımla → atlanır (sırada yine yer alır).\"\"\"\n1413\t    pk, sk = sac._yerel_katilar(); pan, ser = sac._bolgeler(); t = sac.t\n1414\t    dsk = {B.no: _H_M(B.Hs) for B in sac.bukumler}\n1415\t    duz_serit = {B.no: (_tasi(_prizma(ser[B.no], t), dsk[B.no]) if _alan(ser[B.no]) > 1e-9 else None) for B in sac.bukumler}\n1416\t    onbellek = {}\n1417\t\n1418\t    def durum_katilari(bukuk):\n1419\t        M = {0: np.eye(4)}\n1420\t        for B in sac.bukumler:\n1421\t            M[B.cocuk.no] = M[B.ebeveyn.no] @ (B.Lb if B.no in bukuk else B.Ld)\n1422\t        ss = [((\"P\", P.no), _tasi(pk[P.no], M[P.no])) for P in sac.paneller if pk[P.no] is not None]\n1423\t        for B in sac.bukumler:\n1424\t            if B.no in bukuk: ss += [((\"B\", B.no), _tasi(s, M[B.ebeveyn.no])) for s in sk[B.no]]\n1425\t            elif duz_serit[B.no] is not None: ss.append(((\"B\", B.no), _tasi(duz_serit[B.no], M[B.ebeveyn.no])))\n1426\t        return M, ss\n1427\t\n1428\t    def dene(k, yapilan):\n1429\t        anahtar = (k, frozenset(yapilan))\n1430\t        if anahtar in onbellek: return onbellek[anahtar]\n1431\t        B = sac.bukumler[k]; sorun = []\n1432\t        if B.tip.startswith(\"kivirma\") or B.tip == \"ofset\":\n1433\t            onbellek[anahtar] = sorun; return sorun\n1434\t        uc_aci = BICAK[\"uc_aci\"] if B.aci <= 95.0 else max(20.0, 180.0 - B.aci - 5.0)\n1435\t        fs = ser[B.no].Faces()\n1436\t        wa, wb = (min(f.BoundingBox().ymin for f in fs), max(f.BoundingBox().ymax for f in fs)) if fs else (B.a, B.b)\n1437\t        bicak, kalip = _arac_kati(B, t, uc_aci, BICAK[\"yukseklik\"], wa, wb)\n1438\t        for evre, bukuk in ((\"baslangic\", set(yapilan)), (\"bitis\", set(yapilan) | {k})):\n1439\t            M, ss = durum_katilari(bukuk)\n1440\t            Mp = M[B.ebeveyn.no]\n1441\t            araclar = [(\"bicak\", _tasi(bicak, Mp))] if evre == \"bitis\" else [(\"bicak\", _tasi(bicak, Mp)), (\"kalip\", _tasi(kalip, Mp))]\n1442\t            if evre == \"bitis\":\n1443\t                araclar = [(\"bicak\", _tasi(bicak.rotate(V(*B.A0), V(*(B.A0 + B.k)), B.aci / 2.0), Mp))]\n1444\t            for an, ar in araclar:\n1445\t                ab = ar.BoundingBox()\n1446\t                for et, s in ss:\n1447\t                    if not _bb_kesisir(ab, s.BoundingBox()): continue\n1448\t                    try:\n1449\t                        v = ar.intersect(s).Volume()\n1450\t                    except Exception:\n1451\t                        v = 0.0\n1452\t                    if v > esik:\n1453\t                        sorun.append(dict(bukum=k + 1, evre=evre, arac=an, bolge=\"%s%d\" % et, hacim=round(v, 2)))\n1454\t        onbellek[anahtar] = sorun\n1455\t        return sorun\n1456\t\n1457\t    n = len(sac.bukumler)\n1458\t    vars_ = [B.no for B in sorted(sac.bukumler, key=lambda B: (B.tip.startswith(\"kivirma\"), B.no))]\n1459\t    sira = list(sira) if sira else vars_\n1460\t    def sirala(s):\n1461\t        bulunan = []\n1462\t        for i, k in enumerate(s):\n1463\t            bulunan += dene(k, s[:i])\n1464\t        return bulunan\n1465\t    c0 = sirala(sira)\n1466\t    oneri, c1 = None, None\n1467\t    if c0:\n1468\t        # geri izlemeli arama (DFS): her adımda çarpışmasız bükümler denenir · üst sınır 600 deneme\n1469\t        sayac = [0]; bulunan = [None]; ziyaret = set()\n1470\t        def ara(yap, kalan):\n1471\t            if bulunan[0] is not None or sayac[0] > 600: return\n1472\t            if not kalan: bulunan[0] = list(yap); return\n1473\t            if frozenset(yap) in ziyaret: return\n1474\t            ziyaret.add(frozenset(yap))\n1475\t            for k in kalan:\n1476\t                sayac[0] += 1\n1477\t                if not dene(k, yap):\n1478\t                    ara(yap + [k], [x for x in kalan if x != k])\n1479\t                    if bulunan[0] is not None: return\n1480\t        ara([], list(vars_))\n1481\t        if bulunan[0] is not None:\n1482\t            oneri, c1 = bulunan[0], []\n1483\t        else:\n1484\t            yap, kalan, c1 = [], list(vars_), []\n1485\t            while kalan:\n1486\t                sec = next((k for k in kalan if not dene(k, yap)), None)\n1487\t                if sec is None:\n1488\t                    sec = kalan[0]; c1 += dene(sec, yap)\n1489\t                yap.append(sec); kalan.remove(sec)\n1490\t            oneri = yap\n1491\t    atl = [B.no + 1 for B in sac.bukumler if B.tip.startswith(\"kivirma\") or B.tip == \"ofset\"]\n1492\t    arama = dict(deneme=sayac[0], sinir=600, tam=sayac[0] <= 600, durum_sayisi=len(onbellek)) if c0 else None\n1493\t    return dict(sira=[k + 1 for k in sira], varsayilan_carpisma=c0, oneri_sira=[k + 1 for k in oneri] if oneri else None,\n1494\t                oneri_carpisma=c1, arama=arama, not_=(\"kıvırma/ofset %s ayrı takım (denetim dışı)\" % atl) if atl else \"\", bicak=dict(BICAK, V_kalip=STD.V(sac.t)))\n1495\t\n1496\t\n1497\t# =====================================================================================================================================\n1498\t# 9 · KAYNAK DİKİŞİ\n1499\t# =====================================================================================================================================\n1500\tdef kaynak_dikisi(p0, p1, u1, u2, a, ad=\"kaynak\", yontem=\"TIG 141\", dolgu=\"ER308LSi\", taraf=\"ic\", birim=\"SAC\", not_=\"\"):\n1501\t    \"\"\"köşe (iç bükey) dikişi: p0 → p1 doğrusu boyunca, iki yüz doğrultusunda a bacaklı üçgen kesitli katı\"\"\"\n1502\t    p0, p1, u1, u2 = (np.asarray(x, float) for x in (p0, p1, u1, u2))\n1503\t    tel = cq.Wire.makePolygon([V(*p0), V(*(p0 + _n(u1) * a)), V(*(p0 + _n(u2) * a))], close=True)\n1504\t    sh = cq.Solid.extrudeLinear(tel, [], V(*(p1 - p0)))\n1505\t    L = float(np.linalg.norm(p1 - p0))\n1506\t    return dict(ad=ad, wp=cq.Workplane(\"XY\").add(sh), sh=sh, mal=\"paslanmaz\", birim=birim, grup=\"SABIT\", kaynak=SURUM, tur=\"kaynak\",\n1507\t                bom=(\"Köşe kaynak dikişi · %s · dolgu %s · a %.1f\" % (yontem, dolgu, a), 1, \"%.0f mm\" % L, \"%s %s\" % (taraf, not_), \"ÜRETİM\"),\n1508\t                meta=dict(tur=\"kaynak\", tip=\"kose\", yontem=yontem, dolgu=dolgu, a=a, boy=round(L, 2), taraf=taraf, iso2553=\"a%g ◺ %g\" % (a, round(L))))\n1509\t\n1510\t\n1511\tdef kaynak_halka(merkez, eksen, r, a, ad=\"kaynak_halka\", yontem=\"TIG 141\", dolgu=\"ER308LSi\", birim=\"SAC\"):\n1512\t    \"\"\"silindir (r) ile düzlemin birleşim çevresine iç bükey halka dikiş — merkez düzlemde, eksen düzlemden uzağa\"\"\"\n1513\t    M = _cerceve(merkez, eksen)\n1514\t    tel = cq.Wire.makePolygon([V(r, 0, 0), V(r + a, 0, 0), V(r, 0, a)], close=True)\n1515\t    sh = _tasi(cq.Solid.revolve(tel, [], 360.0, V(0, 0, 0), V(0, 0, 1)), M)\n1516\t    return dict(ad=ad, wp=cq.Workplane(\"XY\").add(sh), sh=sh, mal=\"paslanmaz\", birim=birim, grup=\"SABIT\", kaynak=SURUM, tur=\"kaynak\",\n1517\t                bom=(\"Çevre kaynak dikişi · %s · dolgu %s · a %.1f\" % (yontem, dolgu, a), 1, \"Ø%.0f çevre %.0f mm\" % (2 * r, 2 * math.pi * r), \"\", \"ÜRETİM\"),\n1518\t                meta=dict(tur=\"kaynak\", tip=\"cevre\", yontem=yontem, dolgu=dolgu, a=a, boy=round(2 * math.pi * r, 1)))\n1519\t\n1520\t\n1521\tdef kaynak_parcalari(sac):\n1522\t    out = []\n1523\t    for i, k in enumerate(sac.kaynaklar):\n1524\t        if k[\"tip\"] != \"kose\": continue\n1525\t        Ba, Bb = k[\"Ba\"], k[\"Bb\"]; Ca, Cb = Ba.cocuk, Bb.cocuk; t = sac.t\n1526\t        zi = t if Ba.yon > 0 else 0.0\n1527\t        na, nb = Ca.M[:3, 2], Cb.M[:3, 2]\n1528\t        pa, pb = _p(Ca.M, (0, 0, zi)), _p(Cb.M, (0, 0, zi))\n1529\t        h = Ca.M[:3, 0]; oa = _p(Ca.M, (0, 0, 0))\n1530\t        A = np.array([na, nb, h]); b = np.array([na @ pa, nb @ pb, h @ oa])\n1531\t        P0 = np.linalg.solve(A, b)\n1532\t        L = min(Ba.Lf, Bb.Lf)\n1533\t        ua = Ca.M[:3, 1] * (1 if np.dot(_p(Ca.M, (0, (Ba.a + Ba.b) / 2.0, 0)) - P0, Ca.M[:3, 1]) > 0 else -1)\n1534\t        ub = Cb.M[:3, 1] * (1 if np.dot(_p(Cb.M, (0, (Bb.a + Bb.b) / 2.0, 0)) - P0, Cb.M[:3, 1]) > 0 else -1)\n1535\t        a = round(min(t, 3.0), 2)\n1536\t        out.append(kaynak_dikisi(P0, P0 + h * L, ua, ub, a, ad=\"%s_kose_kaynagi_%d\" % (sac.ad, i + 1), birim=sac.birim,\n1537\t                                 not_=\"(dış köşe TIG kapatılır + taşlanır; katı iç köşede temsil)\"))\n1538\t    return out\n1539\t\n1540\t\n1541\t# =====================================================================================================================================\n1542\t# 10 · BAĞLANTI ELEMANLARI (gerçek ölçülü · standart numaralı · BOM)\n1543\t# =====================================================================================================================================\n1544\tD_NOM = {\"M3\": 3.0, \"M4\": 4.0, \"M5\": 5.0, \"M6\": 6.0, \"M8\": 8.0, \"M10\": 10.0, \"M12\": 12.0}\n1545\tISO7380 = {\"M3\": (5.7, 1.65, 2.0), \"M4\": (7.6, 2.2, 2.5), \"M5\": (9.5, 2.75, 3.0), \"M6\": (10.5, 3.3, 4.0), \"M8\": (14.0, 4.4, 5.0), \"M10\": (17.5, 5.5, 6.0)}   # dk, k, s\n1546\tDIN7991 = {\"M3\": (6.0, 1.7, 2.0), \"M4\": (8.0, 2.3, 2.5), \"M5\": (10.0, 2.8, 3.0), \"M6\": (12.0, 3.3, 4.0), \"M8\": (16.0, 4.4, 5.0), \"M10\": (20.0, 5.5, 6.0)}\n1547\tISO4762 = {\"M3\": (5.5, 3.0, 2.5), \"M4\": (7.0, 4.0, 3.0), \"M5\": (8.5, 5.0, 4.0), \"M6\": (10.0, 6.0, 5.0), \"M8\": (13.0, 8.0, 6.0), \"M10\": (16.0, 10.0, 8.0), \"M12\": (18.0, 12.0, 10.0)}\n1548\tISO4032 = {\"M3\": (5.5, 2.4), \"M4\": (7.0, 3.2), \"M5\": (8.0, 4.7), \"M6\": (10.0, 5.2), \"M8\": (13.0, 6.8), \"M10\": (16.0, 8.4), \"M12\": (18.0, 10.8)}   # s, m\n1549\tISO10511 = {\"M4\": (7.0, 5.0), \"M5\": (8.0, 5.0), \"M6\": (10.0, 6.0), \"M8\": (13.0, 8.0), \"M10\": (16.0, 10.0), \"M12\": (18.0, 12.0)}\n1550\tDIN1587 = {\"M4\": (7.0, 8.0), \"M5\": (8.0, 10.0), \"M6\": (10.0, 12.0), \"M8\": (13.0, 15.0), \"M10\": (17.0, 18.0), \"M12\": (19.0, 22.0)}\n1551\tDIN125 = {\"M3\": (3.2, 7.0, 0.5), \"M4\": (4.3, 9.0, 0.8), \"M5\": (5.3, 10.0, 1.0), \"M6\": (6.4, 12.0, 1.6), \"M8\": (8.4, 16.0, 1.6), \"M10\": (10.5, 20.0, 2.0), \"M12\": (13.0, 24.0, 2.5)}\n1552\tDIN9021 = {\"M3\": (3.2, 9.0, 0.8), \"M4\": (4.3, 12.0, 1.0), \"M5\": (5.3, 15.0, 1.2), \"M6\": (6.4, 18.0, 1.6), \"M8\": (8.4, 24.0, 2.0), \"M10\": (10.5, 30.0, 2.5), \"M12\": (13.0, 37.0, 3.0)}\n1553\tDIN929 = {\"M6\": (10.0, 5.0), \"M8\": (14.0, 6.5), \"M10\": (17.0, 8.0), \"M12\": (19.0, 10.0)}\n1554\tVIDA_BOY = [4, 5, 6, 8, 10, 12, 14, 16, 20, 25, 30, 35, 40, 45, 50, 60]\n1555\tPEM_SOMUN = {   # S / CLS / SP aynı zarf (PEM bülteni, yaklaşık — sipariş öncesi teyit)\n1556\t    \"M3\": dict(delik=4.22, C=4.20, E=6.35, T=1.5, kenar=4.8, kod={0: (0.8, 0.77), 1: (1.0, 0.97), 2: (1.4, 1.38)}),\n1557\t    \"M4\": dict(delik=5.41, C=5.38, E=7.87, T=2.0, kenar=6.9, kod={0: (0.8, 0.77), 1: (1.0, 0.97), 2: (1.4, 1.38)}),\n1558\t    \"M5\": dict(delik=6.40, C=6.38, E=8.89, T=2.0, kenar=7.1, kod={0: (0.8, 0.77), 1: (1.0, 0.97), 2: (1.4, 1.38)}),\n1559\t    \"M6\": dict(delik=8.75, C=8.73, E=11.18, T=4.08, kenar=8.6, kod={1: (1.4, 1.38), 2: (2.3, 2.21)}),\n1560\t    \"M8\": dict(delik=10.5, C=10.47, E=12.7, T=5.47, kenar=9.7, kod={1: (1.4, 1.38), 2: (2.3, 2.21)})}\n1561\tPEM_SOMUN_TIP = {\"S\": \"karbon çelik (304'te kullanılmaz)\", \"CLS\": \"303 paslanmaz · sac ≤ HRB 70 → 304 sacta TUTMAZ\",\n1562\t                 \"SP\": \"A286 / sertleştirilmiş paslanmaz · sac ≤ HRB 90 (304 için)\"}\n1563\tPEM_SAPLAMA = {   # FH / FHS / FHP / FH4 (gömme başlı saplama, yaklaşık)\n1564\t    \"M3\": dict(delik=3.0, H=4.8, h=0.8, kenar=5.6, min_sac=1.0), \"M4\": dict(delik=4.0, H=5.8, h=0.9, kenar=7.0, min_sac=1.0),\n1565\t    \"M5\": dict(delik=5.0, H=6.9, h=1.0, kenar=7.2, min_sac=1.0), \"M6\": dict(delik=6.0, H=8.0, h=1.2, kenar=7.9, min_sac=1.3)}\n1566\tPEM_SAPLAMA_TIP = {\"FH\": \"karbon çelik\", \"FHS\": \"300 paslanmaz · sac ≤ HRB 70\", \"FHP\": \"A286 · sac ≤ HRB 92 (304 için, gıda servisi)\", \"FH4\": \"400 serisi (standartta yasak)\"}\n1567\tSAPLAMA_BOY = [6, 8, 10, 12, 15, 18, 20, 25, 30, 35]\n1568\tPERCIN_SOMUN = {\"M4\": dict(delik=6.0, D=5.95, Dk=9.0, hk=0.8, L=10.0, kavrama=(0.5, 3.0)), \"M5\": dict(delik=7.0, D=6.95, Dk=10.0, hk=1.0, L=12.0, kavrama=(0.5, 3.0)),\n1569\t                \"M6\": dict(delik=9.0, D=8.95, Dk=13.0, hk=1.5, L=15.0, kavrama=(0.5, 3.5)), \"M8\": dict(delik=11.0, D=10.95, Dk=15.0, hk=1.5, L=17.0, kavrama=(0.5, 3.5))}\n1570\tKOR_PERCIN = {3.2: dict(delik=3.3, dk=6.5, k=1.1), 4.0: dict(delik=4.1, dk=8.0, k=1.5), 4.8: dict(delik=4.9, dk=9.5, k=1.7)}   # ISO 15983 A2/A2\n1571\t\n1572\t\n1573\tdef _bp(ad, sh, std, tanim, olcu, malzeme=\"A2-70\", adet=1, birim=\"BAGLANTI\", meta=None, uretim=False, mal=\"katalog\"):\n1574\t    return dict(ad=ad, wp=cq.Workplane(\"XY\").add(sh), sh=sh, mal=mal, birim=birim, grup=\"SABIT\", kaynak=SURUM, tur=\"baglanti\",\n1575\t                bom=(tanim, adet, olcu, \"%s · %s\" % (std, malzeme), \"ÜRETİM\" if uretim else \"SATIN ALMA\"),\n1576\t                std=std, meta=dict(meta or {}, tur=\"baglanti\", std=std, malzeme=malzeme))\n1577\t\n1578\t\n1579\tdef _altigen(s, h, z0=0.0):\n1580\t    r = s / math.sqrt(3.0)\n1581\t    return cq.Solid.extrudeLinear(cq.Wire.makePolygon([V(r * math.cos(math.radians(30 + 60 * i)), r * math.sin(math.radians(30 + 60 * i)), z0) for i in range(6)], close=True),\n1582\t                                  [], V(0, 0, h))\n1583\t\n1584\t\n1585\tdef _silindir(r, h, z0=0.0):\n1586\t    return cq.Solid.makeCylinder(r, h, V(0, 0, z0), V(0, 0, 1))\n1587\t\n1588\t\n1589\tdef _halka(r_dis, r_ic, h, z0=0.0):\n1590\t    return _silindir(r_dis, h, z0).cut(_silindir(r_ic, h + 2, z0 - 1))\n1591\t\n1592\t\n1593\tdef _boy_sec(gerek, seri, pay=0.0):\n1594\t    for L in seri:\n1595\t        if L >= gerek + pay - 1e-9: return float(L)\n1596\t    return float(seri[-1])\n1597\t\n1598\t\n1599\tdef vida(std, dis, boy, nokta, eksen, ad=\"vida\", birim=\"BAGLANTI\", malzeme=\"A2-70\"):"}]},"uuid":"a371a1e6-a398-468e-834c-2f661543bba8","timestamp":"2026-10-01T22:49:00.902Z","sourceToolAssistantUUID":"4a741b19-731c-4ffa-951a-f92635581f74","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
