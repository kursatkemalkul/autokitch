{"parentUuid":"8f550c90-5629-4ca3-974c-29ba58603209","isSidechain":true,"promptId":"6d13b065-9608-42c4-83ca-508fc3c4db72","agentId":"a25b9854cf7bf8eac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013GTwpWzABDg8XwuFE9y1Pw","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"AUTOKITCH · K · KESME + SIVI YAĞ SPREYİ · K400 — ÜRETİM MODELİ v11 (30 Eyl 2026 · Claude)\n3\tKemal (30 Eyl, alt dolap ekran görüntüsü): \"bunu geriye en gidebileceği kadar it ki ben ön tarafa da bir şeyler koyabileyim\"\n4\tTEMEL: kesme_cad_v10 AYNEN (kesme · sprey · nozül · pano · teneke / tartı / pompa / hortum parçaları ve katalog değerleri) — yalnız ALT DOLAP YERLEŞİMİ değişir.\n5\t\n6\tv10 → v11 · TENEKE ARKADA · POMPA GRUBU RAFTA · ÖN BOŞ\n7\t · teneke + tartı + damlama tavası 452 mm GERİ: teneke z −769,5…−534,5 · tartı platformu −782…−522 · tava −784…−500\n8\t   (arka alt kayıt z −785'te — tava ona 1 mm; daha geri gidemez: kayıt tava ve tartı yüksekliğinde boydan boya)\n9\t · teneke ağzı ÖN-SAĞ köşede (x 285 · z −562): emme borusu + adaptör rafın ÖNÜNDE kalır → teneke öne çekilirken rafa / hortuma değmez\n10\t · pompa grubu (10 µm filtre · GJ-N21 · T · PM1704 · KBP) tenekenin ÜSTÜNE, arkada: 304 1,5 raf y 640 · z −785…−623 · 20 mm kıvrık kenar\n11\t   (rafın kendisi pompa grubunun damlama tavası) · 2 × L 30 × 30 × 3 köşebent yan saclara + arka köşe dikmelerine · PM1704 T'nin ÜSTÜNE dik\n12\t   (v10'daki gibi öne uzansaydı basınç hattının yolunu kapatırdı) · basınç hattı T'nin önünden taban rakoruna (x 380 · z −600) → nozüle (v10 yolu)\n13\t · ÖN BOŞLUK: z −500 … +27 (ön köşe dikmeleri) ≈ 527 mm derin × x 35…365 × y 156…862 (kapak içi) — eşya konabilir\n14\t · teneke değişimi: kapak açılır, öndeki eşya alınır, teneke emme borusuyla birlikte öne çekilir (emiş / dönüş hortumu CPC çabuk bağlantılı)\n15\tKOORDİNAT: v8/v9/v10 ile aynı — x 0…400 (hatta 4000 + x), y yerden, z 0 ön yüz … −830 arka.\"\"\"\n16\timport math\n17\timport cadquery as cq\n18\timport kesme_cad_v10 as K10\n19\tfrom kesme_cad_v10 import *                     # v10 (ve v9/v8) sabitleri, yardımcıları, PARCALAR, zaman ve denetim işlevleri\n20\t\n21\t# ---------------------------------------------------------------- v11 sabitleri ----------------------------------------------------------------\n22\tDZ_T = -452.0                                                                             # teneke + tartı + tava geri kaydırma (v10'a göre)\n23\tARKA_KAYIT_ON = -785.0                                                                    # arka alt kayıt (onyuz_kayit_140_-800) ön yüzü · y 126–156 boydan boya\n24\tRAF = dict(x=(4.5, 395.5), y=640.0, t=1.5, z=(-785.0, -623.0), kenar=20.0)               # pompa rafı 304 1,5 (üst yüz 641,5)\n25\tKB = dict(y=(610.0, 640.0), z=(-785.0, -620.0), t=3.0)                                    # L 30 × 30 × 3 köşebent (yan sac iç yüzü x 1,5 / 398,5)\n26\tDY_P, DZ_P = RAF[\"y\"] + RAF[\"t\"] - 127.0, -225.0                                          # pompa grubu ötelemesi (v10 plakası y 127, z −560…−400)\n27\tSENSOR_Y1 = 111.0                                                                          # PM1704 boyu (T üst yüzünden yukarı)\n28\t\n29\t\n30\tdef _t(v, dz):\n31\t    return tuple(v[:4]) + (v[4] + dz, v[5] + dz)\n32\t\n33\t\n34\tTNK = dict(x=(82.5, 317.5), z=(-317.5 + DZ_T, -82.5 + DZ_T), y0=199.0)                   # −769,5 … −534,5\n35\tTNK_AGIZ = (285.0, TNK[\"z\"][1] - 27.5)                                                    # ön-sağ köşe (v10: arka-sağ) → z −562\n36\tTARTI = dict(taban=_t(K10.TARTI[\"taban\"], DZ_T), hucre=_t(K10.TARTI[\"hucre\"], DZ_T), takoz_h=K10.TARTI[\"takoz_h\"], plat=_t(K10.TARTI[\"plat\"], DZ_T))\n37\tTAVA10 = (38.0, 362.0, 126.0, 146.0, ARKA_KAYIT_ON + 1.0, -500.0)                         # tartı + teneke altı (pompa grubu artık rafta)\n38\tPOMPA_Y, POMPA_Z = K10.POMPA_Y + DY_P, K10.POMPA_Z + DZ_P                                # 688,7 · −705\n39\t_pg = K10.PG\n40\tPG = dict(plaka=(_pg[\"plaka\"][0], _pg[\"plaka\"][1], _pg[\"plaka\"][2] + DY_P, _pg[\"plaka\"][3] + DY_P, _pg[\"plaka\"][4] + DZ_P, _pg[\"plaka\"][5] + DZ_P),\n41\t          filtre=(_pg[\"filtre\"][0], _pg[\"filtre\"][1], _pg[\"filtre\"][2] + DY_P, _pg[\"filtre\"][3] + DY_P),\n42\t          pompa=(_pg[\"pompa\"][0], _pg[\"pompa\"][1], _pg[\"pompa\"][2] + DY_P, _pg[\"pompa\"][3] + DY_P, _pg[\"pompa\"][4] + DZ_P, _pg[\"pompa\"][5] + DZ_P),\n43\t          t=(_pg[\"t\"][0], _pg[\"t\"][1], _pg[\"t\"][2] + DY_P, _pg[\"t\"][3] + DY_P, _pg[\"t\"][4] + DZ_P, _pg[\"t\"][5] + DZ_P),\n44\t          sensor=(_pg[\"sensor\"][0], _pg[\"sensor\"][1], _pg[\"t\"][4] + DZ_P - 1.0, _pg[\"t\"][4] + DZ_P),   # v10 yatay çağrısı için yer tutucu — modul()'de DİK yapılır\n45\t          bpr=(_pg[\"bpr\"][0], _pg[\"bpr\"][1], _pg[\"bpr\"][2] + DY_P, _pg[\"bpr\"][3] + DY_P))\n46\t_T_ON = PG[\"t\"][5]                                                                         # T'nin ön yüzü (−695) → basınç hattı buradan\n47\tY_UST_HAT = 830.0                                                                          # emiş hattının raf üstü geçişi (arka üst kayıt 862'nin altı)\n48\tY_DONUS = 820.0                                                                            # KBP üstünden ≥ R 50 + boru r 4 + 1 (ilk dirsek küresi KBP'ye girmesin)\n49\tH_BASINC = [(225.0, POMPA_Y, _T_ON), (225.0, POMPA_Y, -600.0), (380.0, POMPA_Y, -600.0), (380.0, Y_HORTUM, -600.0), (X_NZ, Y_HORTUM, -600.0), (X_NZ, Y_HORTUM, Z_NZ - 22.0)]\n50\tH_EMIS = [(LANS[\"port\"][0][0], None, TNK_AGIZ[1]), (LANS[\"port\"][0][0], Y_UST_HAT, TNK_AGIZ[1]), (PG[\"filtre\"][0], Y_UST_HAT, TNK_AGIZ[1]),\n51\t          (PG[\"filtre\"][0], Y_UST_HAT, POMPA_Z), (PG[\"filtre\"][0], PG[\"filtre\"][3], POMPA_Z)]\n52\tH_DONUS = [(PG[\"bpr\"][0], PG[\"bpr\"][3], POMPA_Z), (PG[\"bpr\"][0], Y_DONUS, POMPA_Z), (PG[\"bpr\"][0], Y_DONUS, TNK_AGIZ[1]), (LANS[\"port\"][1][0], None, TNK_AGIZ[1])]\n53\t_boy = K10._boy\n54\tV11_YENI, V11_DEGISEN = [], []\n55\t\n56\t# v10 işlevleri kendi modül değişkenlerini okur → v11 değerleri oraya da yazılır (tek kaynak bu dosya)\n57\tfor _ad in (\"TNK\", \"TNK_AGIZ\", \"TARTI\", \"TAVA10\", \"POMPA_Y\", \"POMPA_Z\", \"PG\", \"H_BASINC\", \"H_EMIS\", \"H_DONUS\"):\n58\t    setattr(K10, _ad, globals()[_ad])\n59\t\n60\t\n61\tdef ekle11(ad, wp, mal=\"sac\", grup=\"SABIT\", bom=None):\n62\t    ekle8(ad, wp, mal, grup, bom)\n63\t    V11_YENI.append(ad)\n64\t\n65\t\n66\tdef raf_v11():\n67\t    \"\"\"pompa rafı (kendi damlama tavası) + 2 köşebent\"\"\"\n68\t    x0, x1 = RAF[\"x\"]; z0, z1 = RAF[\"z\"]; y0 = RAF[\"y\"]; t = RAF[\"t\"]; k = RAF[\"kenar\"]\n69\t    raf = kut(x0, x1, y0, y0 + t, z0, z1)\n70\t    raf = raf.union(kut(x0, x1, y0 + t, y0 + t + k, z1 - t, z1))                          # ön kıvrım\n71\t    raf = raf.union(kut(x0, x0 + t, y0 + t, y0 + t + k, z0, z1 - t)).union(kut(x1 - t, x1, y0 + t, y0 + t + k, z0, z1 - t))   # yan kıvrımlar\n72\t    ekle11(\"yag_pompa_rafi\", raf, \"sac\", \"SABIT\",\n73\t           bom=(\"Pompa rafı AISI 304 1,5 (3 kenarı 20 kıvrık · köşeler kaynaklı = pompa grubunun damlama tavası)\", 1,\n74\t                \"%.0f × %.0f · üst yüz y %.1f · arka kenarı köşe dikmelerine dayalı · 2 köşebende 4 × M5\" % (x1 - x0, z1 - z0, y0 + t), \"v11 · üretim\", \"ÜRETİM\"))\n75\t    ya, yb = KB[\"y\"]; za, zb = KB[\"z\"]; kt = KB[\"t\"]\n76\t    for ad_, xs, xl in ((\"sol\", 1.5, (1.5 + kt, 31.5)), (\"sag\", 398.5 - kt, (368.5, 398.5 - kt))):\n77\t        kb = kut(xs, xs + kt, ya, yb, za, zb).union(kut(xl[0], xl[1], yb - kt, yb, za, zb))\n78\t        ekle11(\"yag_pompa_rafi_kosebendi_\" + ad_, kb, \"celik\", \"SABIT\",\n79\t               bom=(\"Köşebent L 30 × 30 × 3 AISI 304 (raf taşıyıcı)\", 2, \"boy %.0f · yan saca 3 × M5 perçin somun + arka köşe dikmesine 1 × M5\" % (zb - za), \"v11 · üretim\", \"ÜRETİM\")\n80\t               if ad_ == \"sol\" else None)\n81\t\n82\t\n83\tdef sensor_v11():\n84\t    \"\"\"PM1704 T'nin üstüne DİK (v10'da T'den öne 111 mm uzanıyordu → basınç hattının yolu)\"\"\"\n85\t    p = bul(\"yag_basinc_sensoru_PM1704\")\n86\t    sx, sr = PG[\"sensor\"][0], PG[\"sensor\"][1]\n87\t    y0 = PG[\"t\"][3]\n88\t    p[\"wp\"] = sily(sx, POMPA_Z, sr, y0, y0 + SENSOR_Y1)\n89\t    b = list(p[\"bom\"]); b[2] = b[2] + \" · v11: T'nin üstünde dik\"; p[\"bom\"] = tuple(b)\n90\t    V11_DEGISEN.append(p[\"ad\"])\n91\t\n92\t\n93\tdef bom_v11():\n94\t    for ad_, eski, yeni in ((\"yag_damlama_tavasi_10\", \"teneke + tartı + pompa grubu altı\", \"teneke + tartı altı · v11: arkada\"),\n95\t                            (\"yag_pompa_plakasi\", \"tavaya 4 × M5 (lastik)\", \"rafa 4 × M5 (lastik) · v11\")):\n96\t        p = bul(ad_); b = list(p[\"bom\"]); b[0] = b[0].replace(eski, yeni); b[2] = b[2].replace(eski, yeni); p[\"bom\"] = tuple(b)\n97\t        V11_DEGISEN.append(ad_)\n98\t    p = bul(\"yag_tenekesi_18L\"); b = list(p[\"bom\"]); b[2] = b[2] + \" · v11: dolabın ARKASINDA, ağız ön-sağda (öne çekilerek değişir)\"; p[\"bom\"] = tuple(b)\n99\t    V11_DEGISEN.append(p[\"ad\"])\n100\t\n101\t\n102\tdef modul():\n103\t    K10.modul()\n104\t    raf_v11(); sensor_v11(); bom_v11()\n105\t    for ad_ in (\"yag_damlama_tavasi_10\", \"yag_tarti_taban_plakasi\", \"yag_tarti_alt_takozu\", \"yag_tarti_yuk_hucresi_PW15AH\", \"yag_tarti_ust_takozu\", \"yag_tarti_platformu\",\n106\t                \"yag_tenekesi_18L\", \"yag_emme_lansi_1038304\", \"yag_agiz_adaptoru\", \"yag_pompa_plakasi\", \"yag_emis_filtresi\", \"yag_boru_filtre_pompa\",\n107\t                \"yag_pompasi_GJ-N21_EagleDrive\", \"yag_boru_pompa_T\", \"yag_T_parcasi\", \"yag_boru_T_regulator\", \"yag_geri_basinc_regulatoru_KBP\",\n108\t                \"yag_basinc_hortumu_TLM1008\", \"yag_emis_hortumu_TLM1008\", \"yag_donus_hortumu_TLM0806\"):\n109\t        if ad_ not in V11_DEGISEN:\n110\t            V11_DEGISEN.append(ad_)\n111\t    return PARCALAR\n112\t\n113\t\n114\tdef on_bosluk():\n115\t    \"\"\"ön boşluk: alt dolaptaki (y 126…862) BÜTÜN parçaların — gövde dikme / kayıt / tabanı hariç — en ön noktası → ön köşe dikmeleri (z 27) ·\n116\t    kapak içi x 35…365 · y 156…862 (alt ve üst ön kayıt arası). Parça alt dolap kutusuyla kesilip ölçülür (basınç hattı yukarıda öne gider).\"\"\"\n117\t    kutu = kut(35.0, 365.0, 156.0, 862.0, -830.0, 27.0).val()\n118\t    zmax, en = -830.0, None\n119\t    for p in PARCALAR:\n120\t        if p[\"ad\"].startswith((\"kose_dikmesi\", \"onyuz_\", \"taban_sac\", \"arka_sac\", \"sol_sac\", \"sag_sac\", \"ust_sac\", \"istasyon_tabani\", \"plint\", \"ayak_\")): continue\n121\t        sh = p[\"wp\"].val()\n122\t        b = sh.BoundingBox()\n123\t        if b.ymax <= 156.0 or b.ymin >= 862.0 or b.xmax <= 35.0 or b.xmin >= 365.0: continue\n124\t        k = sh.intersect(kutu)\n125\t        if k.Volume() < 1e-3: continue\n126\t        z = k.BoundingBox().zmax\n127\t        if z > zmax: zmax, en = z, p[\"ad\"]\n128\t    return dict(z_on=round(zmax, 1), en_ondeki=en, derinlik=round(27.0 - zmax, 1), x=(35.0, 365.0), y=(156.0, 862.0))\n129\t"}]},"uuid":"4c3d7c6c-15a8-425b-9e3c-5162120ed433","timestamp":"2026-10-01T22:49:21.494Z","sourceToolAssistantUUID":"8f550c90-5629-4ca3-974c-29ba58603209","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
