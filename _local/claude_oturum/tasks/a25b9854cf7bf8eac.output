\"itici_taban_360_-755\"), (346.0, -769.0, \"itici_taban_360_-755\"), (346.0, -631.0, \"itici_taban_360_-645\"), (346.0, -659.0, \"itici_taban_360_-645\")]   # 36 × 36 ayak tabanının dış köşeleri (20 × 20 eksen ayağının dışında)'),\n ('        yz = [(0, 1.0, 0)] if kk == \"alt\" else ([(0, -1.0, 0)] if kk == \"ust\" else [(0, 1.0, 0), (0, -1.0, 0)])',\n  '        yz = [(0, 1.0, 0)] if kk == \"alt\" else [(0, -1.0, 0)]                          # orta: üstü istasyon tabanının altında (alın dikişi, taşlanır) · üst: üst sac oturur'),\n ('        yz = [(0, 1.0, 0)] if kk == \"alt\" else [(0, 1.0, 0), (0, -1.0, 0)]',\n  '        yz = [(0, 1.0, 0)] if kk == \"alt\" else [(0, -1.0, 0)]'),\n ('            _eleman(S.vida(\"ISO7380\", \"M5\", 12, (35.0, yh + dy, 44.0), (-1.0, 0, 0), ad=\"onyuz_kapak_K_mentese_%d_vida_%s\" % (i, \"a\" if dy < 0 else \"b\"), birim=BIRIM))',\n  '            _eleman(S.vida(\"ISO7380\", \"M5\", 12, (35.0, yh + dy, 44.0), (-1.0, 0, 0), ad=\"onyuz_kapak_K_mentese_%d_sabit_vida_%s\" % (i, \"a\" if dy < 0 else \"b\"), birim=BIRIM))'),\n ('def kulak(ad, A, stud, u, v, v_cerceve, L_kaynak=25.0, gen=30.0):', 'def kulak(ad, A, stud, u, v, v_cerceve, L_kaynak=25.0, gen=25.0):'),\n]\nfor a, b in R:\n    assert s.count(a) == 1, (s.count(a), a[:90])\n    s = s.replace(a, b)\n# itici ayakları: PEM SP-M5 + arayüz M5\na = '''    # delik kaynakları (yarık dolgusu, yüzle aynı)'''\nb = '''    for x, z, hedef in PEM_M5_ITICI:\n        ps, c, ms = S.pem_somun(\"SP\", \"M5\", (x, Y_MEK, z), (0, -1.0, 0), it.t, ad=\"istasyon_tabani_pem_M5_%s_%d\" % (hedef, int(-z)), birim=BIRIM)\n        Q.delik(x, -z, c[\"delik\"], tip=\"pem_somun\", parca=ps[\"meta\"][\"parca\"], pem_tip=\"SP\", kenar_min=c[\"kenar\"], min_sac=ms)\n        _eleman(ps)\n        _arayuz(S.vida(\"ISO4762\", \"M5\", 16, (x, Y_MEK_UST + 8.0, z), (0, -1.0, 0), ad=\"arayuz_%s_M5_%d\" % (hedef, int(-z)), birim=BIRIM), \"K mekanizma: \" + hedef,\n                \"8 mm ayak tabanının dış köşesinde Ø5,5 delik ·