\n        w = csv.writer(f, delimiter=\";\")\n        w.writerow([\"bolum\", \"tanim\", \"adet\", \"olcu / acinim\", \"standart / islem\", \"tedarik / not\"])\n        for x in sac_grup:\n            w.writerow([\"SAC\", \"%s · AISI 304 2B t %g · %d büküm\" % (x[\"tanim\"], x[\"t\"], x[\"bukum\"]), x[\"adet\"], \"%g × %g\" % tuple(x[\"acinim\"]), \"lazer + abkant (R = 1,5t · K standart)\", \", \".join(x[\"parcalar\"][:6]) + (\" …\" if len(x[\"parcalar\"]) > 6 else \"\")])\n        for x in prof:\n            w.writerow([\"PROFİL\", \"Kare boru AISI 304 30 × 30 × 2 · \" + x[\"ad\"], 1, \"L %.1f\" % x[\"L\"], \"boru lazer · %d kesik\" % len(x[\"kesikler\"]), \"%.2f kg\" % x[\"kg\"]])\n        for b_ in bag_bom:\n            w.writerow([\"BAĞLANTI\", b_[\"tanim\"], b_[\"adet\"], b_[\"olcu\"], b_[\"standart\"], b_[\"tedarik\"]])\n        for k in R[\"bom\"][\"kaynak\"]:\n            w.writerow([\"KAYNAK\", \"Kaynak dikişi \" + k[\"tip\"], k[\"adet\"], \"toplam %g mm\" % k[\"toplam_boy_mm\"], \"TIG 141 · ER308LSi\", \"ÜRETİM\"])\n        for b_ in R[\"bom\"][\"arayuz\"]:\n            w.writerow([\"ARAYÜZ (karşı tarafta delik gerekir · montaja girmez)\", b_[\"tanim\"], b_[\"adet\"], b_[\"olcu\"], b_[\"standart\"], b_[\"tedarik\"]])\n    with open(os.path.join(BUR, \"K_sac_v1_montaj_sirasi.txt\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"K GÖVDESİ · ÜRETİM SACI v1 · ATÖLYE MONTAJ SIRASI (h3_k_sac_v1)\\\\n\\\\n\" + \"\\\\n\".join(R[\"montaj_sirasi\"]) + \"\\\\n\")'''\nassert s.count(a) == 1; s = s.replace(a, b)\nio.open(p, \"w\", encoding=\"utf-8\").write(s)\nprint(\"ok\")\nEOF\ntimeout 3000 python -u k_sac_denetim_v1.py > _log_denetim_3.txt 2>&1; echo EXIT $?; grep \"İZİNSİZ\\|SÜPÜRME\\|SAC:\\|PROFİL:\\|MONTAJ KURU\\|ÖZET\\|GLB\\|görünüm\\|BOM:\" _log_denetim_3.txt","description":"Update previews, add CSV BOM and assembly text, rerun","timeout":3100000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":nul