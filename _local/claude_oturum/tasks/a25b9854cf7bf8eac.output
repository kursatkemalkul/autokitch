{"parentUuid":"0a683eef-828c-42b3-89eb-a8b8da130d32","isSidechain":true,"agentId":"a25b9854cf7bf8eac","message":{"model":"claude-opus-5-5","id":"msg_011CfcLGFjfT2qCoupG6oc5s","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XKrexZgKHkneHjcJcvFNGu","name":"Read","input":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\b3\\arastirma\\_uretec\\h3\\h3_sac_v1.py","offset":500,"limit":700},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14038,"cache_read_input_tokens":121152,"output_tokens":205,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":14038},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":205,"cache_read_input_tokens":121152,"cache_creation_input_tokens":14038,"cache_creation":{"ephemeral_5m_input_tokens":14038,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01XKrexZgKHkneHjcJcvFNGu":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\b3\\arastirma\\_uretec\\h3\\h3_sac_v1.py","offset":500,"limit":700}},"apiBlockIndex":0,"requestId":"req_011CfcLGFM6UzsRiCqnxEdUg","attributionAgent":"general-purpose","type":"assistant","uuid":"56dba1f6-5bdc-4890-ac54-646a59d91eb8","timestamp":"2026-10-01T22:48:54.031Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
{"parentUuid":"56dba1f6-5bdc-4890-ac54-646a59d91eb8","isSidechain":true,"promptId":"6d13b065-9608-42c4-83ca-508fc3c4db72","agentId":"a25b9854cf7bf8eac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XKrexZgKHkneHjcJcvFNGu","type":"tool_result","content":"500\t    def __repr__(self):\n501\t        return \"<Panel %s/%s>\" % (self.sac.ad, self.ad)\n502\t\n503\t    # ---------------- geometri\n504\t    def kenar(self, i):\n505\t        n = len(self.poly); p0 = np.array(self.poly[i % n]); p1 = np.array(self.poly[(i + 1) % n])\n506\t        L = float(np.linalg.norm(p1 - p0)); e2 = (p1 - p0) / L; out2 = np.array([e2[1], -e2[0]])\n507\t        return dict(p0=p0, p1=p1, L=L, e2=e2, out2=out2)\n508\t\n509\t    def dunya(self, u, v, z=0.0):\n510\t        return _p(self.M, (u, v, z))\n511\t\n512\t    def yerel(self, p):\n513\t        return _p(np.linalg.inv(self.M), p)\n514\t\n515\t    def normal(self):\n516\t        return self.M[:3, 2].copy()\n517\t\n518\t    def icerir(self, u, v):\n519\t        x, y, ic = u, v, False; P = self.poly\n520\t        for i in range(len(P)):\n521\t            (x0, y0), (x1, y1) = P[i], P[(i + 1) % len(P)]\n522\t            if (y0 > y) != (y1 > y) and x < (x1 - x0) * (y - y0) / (y1 - y0) + x0: ic = not ic\n523\t        return ic\n524\t\n525\t    # ---------------- bükümler\n526\t    def flans(self, kenar, boy, aci=90.0, yon=+1, R=None, olcu=\"dis\", bas=0.0, son=0.0, uzat_bas=0.0, uzat_son=0.0, rahat=\"otomatik\", ad=None, K=None, tip=\"flans\"):\n527\t        return self.sac._bukum_ekle(self, kenar, boy, aci, yon, R, olcu, bas, son, uzat_bas, uzat_son, rahat, ad, K, tip)\n528\t\n529\t    def kivir(self, kenar, boy=None, tip=\"kapali\", yon=+1, bas=0.0, son=0.0, uzat_bas=0.0, uzat_son=0.0, rahat=\"otomatik\", ad=None):\n530\t        \"\"\"kenar kıvırma (hem) · 180° · iç yarıçap standarttan (iç çap = t) · boy = dönüşün düz boyu\"\"\"\n531\t        R, dmin = STD.hem(self.sac.t, tip)\n532\t        return self.flans(kenar, boy if boy is not None else dmin, 180.0, yon, R=R, olcu=\"duz\", bas=bas, son=son, uzat_bas=uzat_bas,\n533\t                          uzat_son=uzat_son, rahat=rahat, ad=ad or \"%s.kivirma%d\" % (self.ad, kenar), tip=\"kivirma_\" + tip)\n534\t\n535\t    def ofset(self, kenar, yukseklik, boy, aci=90.0, yon=+1, bas=0.0, son=0.0, ad=None):\n536\t        \"\"\"joggle: aci ile çık, yukseklik (alt yüzden alt yüze dik kaçıklık) kadar yüksel, ters aci ile dön, boy kadar devam et\"\"\"\n537\t        t, R, K = self.sac.t, self.sac.R, self.sac.K\n538\t        th = math.radians(aci)\n539\t        # 1. bükümün çocuğunun s = 0'daki alt yüz noktası ve 2. bükümün alt yüz kaçıklığı (sıfır ağ boyuyla) — ebeveyn yerelinde\n540\t        kn = self.kenar(kenar); p0 = np.r_[kn[\"p0\"], 0.0]; e3 = np.r_[kn[\"e2\"], 0.0]; o3 = np.r_[kn[\"out2\"], 0.0]; nz = np.array([0, 0, 1.0])\n541\t        A0, k = (p0 + nz * (t + R), -e3) if yon > 0 else (p0 - nz * R, e3)\n542\t        Rk = _rot(k, th); org = A0 + Rk @ (p0 - A0); ex = Rk @ o3; nn = Rk @ nz\n543\t        A1, k1 = (org - nn * R, e3) if yon > 0 else (org + nn * (t + R), -e3)      # 2. büküm ters yön (−yon)\n544\t        Rk1 = _rot(k1, th); org2 = A1 + Rk1 @ (org - A1)\n545\t        c0 = float(np.dot(org2 - p0, nz)) * (1 if yon > 0 else -1)\n546\t        web = (yukseklik - c0) / math.sin(th)\n547\t        if web < -1e-9: raise ValueError(\"ofset: yükseklik %.2f < en küçük %.2f (iki büküm bitişik)\" % (yukseklik, c0))\n548\t        web = max(web, 0.0)\n549\t        g = self.flans(kenar, web if web > 1e-6 else 1e-3, aci, yon, olcu=\"duz\", bas=bas, son=son, ad=(ad or \"%s.ofset%d\" % (self.ad, kenar)) + \"_ag\", tip=\"ofset\")\n550\t        return g.flans(1, boy, aci, -yon, olcu=\"duz\", ad=(ad or \"%s.ofset%d\" % (self.ad, kenar)), tip=\"ofset\")\n551\t\n552\t    # ---------------- kesikler (panel yerel u, v)\n553\t    def _kesik(self, yuz, tip, meta=None, dfm=True, hedef=None):\n554\t        k = Kesik(self, yuz, tip, meta, dfm, hedef); self.kesikler.append(k); self.sac._gecersiz(); return k\n555\t\n556\t    def delik(self, u, v, cap, tip=\"delik\", **meta):\n557\t        return self._kesik(yuz_daire(u, v, cap / 2.0), tip, dict(meta, sekil=\"daire\", merkez=[u, v], cap=cap))\n558\t\n559\t    def oblong(self, u, v, boy, en, aci=0.0, tip=\"yarik\", **meta):\n560\t        return self._kesik(yuz_oblong(u, v, boy, en, aci), tip, dict(meta, sekil=\"oblong\", merkez=[u, v], boy=boy, en=en, aci=aci))\n561\t\n562\t    def dikdortgen(self, u, v, boy, en, aci=0.0, r=0.0, tip=\"kesik\", dfm=True, **meta):\n563\t        \"\"\"dfm=False: kenara açılan bilinçli çentik (delik–büküm kuralı dışı)\"\"\"\n564\t        return self._kesik(yuz_dikd_r(u, v, boy, en, aci, r), tip, dict(meta, sekil=\"dikdortgen\", merkez=[u, v], boy=boy, en=en, aci=aci, r=r), dfm=dfm)\n565\t\n566\t    def kesik(self, pts, tip=\"kesik\", dfm=True, **meta):\n567\t        return self._kesik(yuz_poligon(pts), tip, dict(meta, sekil=\"poligon\"), dfm=dfm)\n568\t\n569\t    def lazer_yarik_dizisi(self, u0, v0, n_sira, n_sutun, aci=0.0, boy=None, en=None, kopru=None, sira=None):\n570\t        \"\"\"standart havalandırma yarığı: boy × en (uçlar tam R) · aynı sırada köprü, sıralar arası 'sira' (kenardan kenara) · (u0, v0) dizinin merkezi\"\"\"\n571\t        L = STD.lazer_yarik()\n572\t        boy, en, kopru, sira = boy or L[\"boy\"], en or L[\"genislik\"], kopru or L[\"kopru\"], sira or L[\"sira\"]\n573\t        a = math.radians(aci); ux, uy = math.cos(a), math.sin(a); nx, ny = -uy, ux\n574\t        out = []\n575\t        for i in range(n_sira):\n576\t            for j in range(n_sutun):\n577\t                s = (j - (n_sutun - 1) / 2.0) * (boy + kopru); q = (i - (n_sira - 1) / 2.0) * (en + sira)\n578\t                out.append(self.oblong(u0 + ux * s + nx * q, v0 + uy * s + ny * q, boy, en, aci, tip=\"havalandirma_yarigi\"))\n579\t        return out\n580\t\n581\t    def dil(self, kenar, w0, en, boy):\n582\t        \"\"\"geçme dili: kenarın w0 … w0 + en aralığından dışarı boy kadar (açınımda panel konturuna eklenir)\"\"\"\n583\t        if kenar in self.cocuklar: raise ValueError(\"dil: kenar %d bükümlü\" % kenar)\n584\t        kn = self.kenar(kenar); p = lambda w, s: tuple(kn[\"p0\"] + kn[\"e2\"] * w + kn[\"out2\"] * s)\n585\t        yz = yuz_poligon([p(w0, 0.0), p(w0 + en, 0.0), p(w0 + en, boy), p(w0, boy)])\n586\t        d = dict(tip=\"dil\", yuz=yz, kenar=kenar, w0=w0, en=en, boy=boy)\n587\t        self.ekler.append(d); self.dil_kenar.setdefault(kenar, []).append(d); self.sac._gecersiz()\n588\t        return d\n589\t\n590\t    # ---------------- şekiller (form) — 3B'de modellenir, açınımda takım işareti\n591\t    def panjur(self, u, v, boy, en, h=None, aci=0.0, yon=+1, agiz=-1):\n592\t        \"\"\"taret panjuru: boy (yarık boyu) × en (yükselen bölge), h ≤ 3t · agiz: açık tarafın en yönündeki işareti\"\"\"\n593\t        h = STD.panjur_hmax(self.sac.t) if h is None else h\n594\t        d = dict(tip=\"panjur\", u=u, v=v, boy=boy, en=en, h=h, aci=aci, yon=yon, agiz=agiz)\n595\t        self.formlar.append(d); self.sac._gecersiz(); return d\n596\t\n597\t    def kabartma(self, u, v, boy, en, h, r=0.0, egim=20.0, yon=+1):\n598\t        \"\"\"dikdörtgen kabartma (takviye / kabartı): taban boy × en, yükseklik h, yan eğim (dikeyden) egim°\"\"\"\n599\t        d = dict(tip=\"kabartma\", u=u, v=v, boy=boy, en=en, h=h, r=r, egim=egim, yon=yon)\n600\t        self.formlar.append(d); self.sac._gecersiz(); return d\n601\t\n602\t    # ---------------- iç\n603\t    def _ham_yuz(self):\n604\t        f = yuz_poligon(self.poly)\n605\t        if self.ekler: f = _birlestir([f] + [e[\"yuz\"] for e in self.ekler])\n606\t        return f\n607\t\n608\t\n609\tclass Sac:\n610\t    def __init__(self, ad, rol=\"dis\", t=None, R=None, K=None, malzeme=None, mal=\"paslanmaz\", birim=\"SAC\", grup=\"SABIT\", kaynak=None, bolge=\"gida_disi\", adet=1):\n611\t        self.ad, self.rol = ad, rol\n612\t        self.t = float(t) if t is not None else STD.t(rol)\n613\t        self.R = float(R) if R is not None else STD.R(self.t)\n614\t        self.K = float(K) if K is not None else STD.K(self.t)\n615\t        self.malzeme = malzeme or (STD._g(STD.kar, \"malzeme\") or \"AISI 304 (1.4301)\")\n616\t        self.mal, self.birim, self.grup, self.kaynak, self.bolge, self.adet = mal, birim, grup, kaynak or SURUM, bolge, adet\n617\t        self.paneller, self.bukumler, self.kaynaklar, self.puntalar, self.notlar = [], [], [], [], []\n618\t        self._c = {}\n619\t\n620\t    def __repr__(self):\n621\t        return \"<Sac %s t=%g R=%g K=%g · %d panel · %d büküm>\" % (self.ad, self.t, self.R, self.K, len(self.paneller), len(self.bukumler))\n622\t\n623\t    def _gecersiz(self):\n624\t        self._c.clear()\n625\t\n626\t    def panel(self, ad):\n627\t        for p in self.paneller:\n628\t            if p.ad == ad: return p\n629\t        raise KeyError(ad)\n630\t\n631\t    # ---------------- kuruluş\n632\t    def taban(self, poly, O=(0.0, 0.0, 0.0), ex=(1.0, 0.0, 0.0), ey=(0.0, 1.0, 0.0), ad=\"taban\"):\n633\t        if self.paneller: raise ValueError(\"taban yalnız bir kez\")\n634\t        if _alan2(poly) <= 0: raise ValueError(\"taban poligonu CCW olmalı (kenar numaraları buna göre)\")\n635\t        ex = _n(ex); ey = np.asarray(ey, float); ey = _n(ey - np.dot(ey, ex) * ex); n = np.cross(ex, ey)\n636\t        P = Panel(self, 0, ad, poly, _M(np.column_stack([ex, ey, n]), O), np.eye(3))\n637\t        self.paneller.append(P); self._gecersiz()\n638\t        return P\n639\t\n640\t    def _bukum_ekle(self, P, i, boy, aci, yon, R, olcu, bas, son, uz_a, uz_b, rahat, ad, K, tip):\n641\t        n = len(P.poly); i %= n\n642\t        if i in P.cocuklar or i in P.dil_kenar: raise ValueError(\"%s kenar %d dolu\" % (P.ad, i))\n643\t        if P.bukum is not None and i == 3: raise ValueError(\"%s: kenar 3 bükümlü kenar\" % P.ad)\n644\t        if not (0.0 < aci <= 180.0): raise ValueError(\"açı 0–180\")\n645\t        if R is None: R = self.R\n646\t        # dış/iç ölçülü bir flanşın UCUNA yeni büküm gelirse ebeveyn flanşın dış ölçüsü korunur: düz boyu yeni bükümün geri çekmesi kadar kısalır\n647\t        if P.bukum is not None and i == 1 and P.bukum.olcu in (\"dis\", \"ic\"):\n648\t            thn = math.radians(aci)\n649\t            geri = (R + self.t) if aci >= 179.999 else math.tan(thn / 2.0) * ((R + self.t) if P.bukum.olcu == \"dis\" else R)\n650\t            Bp = P.bukum\n651\t            if Bp.Lf - geri <= 1e-6: raise ValueError(\"%s: dış ölçü %.2f iki bükümü taşımıyor\" % (P.ad, Bp.boy))\n652\t            Bp.Lf -= geri; Bp.uc_geri = geri\n653\t            P.poly = [(min(p[0], Bp.Lf), p[1]) for p in P.poly]\n654\t        kn = P.kenar(i); L = kn[\"L\"]; a, b = float(bas), L - float(son)\n655\t        if not (-1e-9 <= a < b <= L + 1e-9): raise ValueError(\"flanş aralığı geçersiz %.2f–%.2f / %.2f\" % (a, b, L))\n656\t        t = self.t; R = float(R); K = self.K if K is None else float(K)\n657\t        th = math.radians(aci); BA = th * (R + K * t)\n658\t        if olcu == \"duz\": Lf = float(boy)\n659\t        elif olcu == \"dis\": Lf = float(boy) - math.tan(th / 2.0) * (R + t)\n660\t        elif olcu == \"ic\": Lf = float(boy) - math.tan(th / 2.0) * R\n661\t        else: raise ValueError(\"olcu: dis / ic / duz\")\n662\t        if aci >= 179.999 and olcu != \"duz\": raise ValueError(\"180° için olcu='duz'\")\n663\t        if Lf <= 1e-6: raise ValueError(\"%s: flanş boyu %.2f büküme yetmiyor (düz kısım %.3f)\" % (ad or P.ad, boy, Lf))\n664\t        p0 = np.r_[kn[\"p0\"], 0.0]; e3 = np.r_[kn[\"e2\"], 0.0]; o3 = np.r_[kn[\"out2\"], 0.0]; nz = np.array([0.0, 0.0, 1.0])\n665\t        if yon > 0: A0, k, rho = p0 + nz * (t + R), -e3, -nz\n666\t        else: A0, k, rho = p0 - nz * R, e3, nz\n667\t        Rk = _rot(k, th); org = A0 + Rk @ (p0 - A0)\n668\t        Lb = _M(np.column_stack([Rk @ o3, e3, Rk @ nz]), org)                                    # çocuk yereli → ebeveyn yereli (bükük)\n669\t        Ld = _M(np.column_stack([o3, e3, nz]), p0 + o3 * BA)                                     # çocuk yereli → ebeveyn yereli (düz)\n670\t        Hs = np.array([[o3[0], e3[0], p0[0]], [o3[1], e3[1], p0[1]], [0.0, 0.0, 1.0]])          # şerit (s, w) → ebeveyn 2B\n671\t        Hc = np.array([[o3[0], e3[0], p0[0] + BA * o3[0]], [o3[1], e3[1], p0[1] + BA * o3[1]], [0.0, 0.0, 1.0]])\n672\t        B = Bukum(no=len(self.bukumler), ebeveyn=P, kenar=i, a=a, b=b, aci=float(aci), th=th, yon=1 if yon > 0 else -1, R=R, K=K, BA=BA, Lf=Lf,\n673\t                  boy=float(boy), olcu=olcu, tip=tip, A0=A0, k=k, rho=rho, e3=e3, o3=o3, p0=p0, Lb=Lb, Ld=Ld, Hs=Hs, uz_a=float(uz_a), uz_b=float(uz_b))\n674\t        poly = [(0.0, a - uz_a), (Lf, a - uz_a), (Lf, b + uz_b), (0.0, b + uz_b)]\n675\t        C = Panel(self, len(self.paneller), ad or \"%s.k%d\" % (P.ad, i), poly, P.M @ Lb, P.D @ Hc, ebeveyn=P, bukum=B)\n676\t        B.cocuk = C\n677\t        P.cocuklar[i] = B; self.paneller.append(C); self.bukumler.append(B)\n678\t        if rahat == \"otomatik\": rahat = \"dikdortgen\"\n679\t        B.rahat = []\n680\t        if rahat in (\"dikdortgen\", \"yuvarlak\"):\n681\t            for uc, w in ((\"bas\", a), (\"son\", b)):\n682\t                if (uc == \"bas\" and a > 1e-6) or (uc == \"son\" and b < L - 1e-6):\n683\t                    self._rahatlatma(B, uc, w, rahat)\n684\t        self._gecersiz()\n685\t        return C\n686\t\n687\t    def _rahatlatma(self, B, uc, w, tip):\n688\t        P = B.ebeveyn; wr, d = STD.relief(self.t)\n689\t        kn = P.kenar(B.kenar); p = lambda ww, s: tuple(kn[\"p0\"] + kn[\"e2\"] * ww + kn[\"out2\"] * s)\n690\t        w0, w1 = (w - wr, w) if uc == \"bas\" else (w, w + wr)\n691\t        if tip == \"yuvarlak\":\n692\t            yz = _birlestir([yuz_poligon([p(w0, -d + wr / 2.0), p(w1, -d + wr / 2.0), p(w1, 0.5), p(w0, 0.5)]),\n693\t                             yuz_daire(*p((w0 + w1) / 2.0, -d + wr / 2.0), wr / 2.0)])\n694\t        else:\n695\t            yz = yuz_poligon([p(w0, -d), p(w1, -d), p(w1, 0.5), p(w0, 0.5)])\n696\t        P._kesik(yz, \"rahatlatma\", dict(bukum=B.no, uc=uc, genislik=wr, derinlik=d, sekil=tip), dfm=False, hedef={(\"P\", P.no)})\n697\t        B.rahat.append(dict(uc=uc, tip=tip, genislik=wr, derinlik=d))\n698\t\n699\t    def kose(self, f1, f2, tip=\"acik\", ustte=None, rahat=\"kare\", kaynak=None, bosluk=None, rahat_boyut=None):\n700\t        \"\"\"aynı panelin komşu iki kenarındaki 90° aynı yönlü flanşların köşesi.\n701\t        tip 'bindirme': ustte (f1/f2) diğerinin ucunu örter: e_üst = R + t − g, e_alt = R − g (g: kaynaklı köşe aralığı) · 'acik': uzatma yok.\n702\t        rahat 'kare': köşede c × c kesik (bükümler köşede c kısalır) · 'yuvarlak': köşe deliği Ø (standart 2t) · None.\n703\t        kaynak: köşe dikişi (bindirmede varsayılan True).\"\"\"\n704\t        B1, B2 = f1.bukum, f2.bukum; P = B1.ebeveyn\n705\t        if B2.ebeveyn is not P: raise ValueError(\"kose: iki flanş aynı panelde olmalı\")\n706\t        n = len(P.poly)\n707\t        if (B1.kenar + 1) % n == B2.kenar: Ba, Bb = B1, B2\n708\t        elif (B2.kenar + 1) % n == B1.kenar: Ba, Bb = B2, B1\n709\t        else: raise ValueError(\"kose: kenarlar komşu değil\")\n710\t        ka, kb = P.kenar(Ba.kenar), P.kenar(Bb.kenar)\n711\t        if abs(np.dot(ka[\"e2\"], kb[\"e2\"])) > 1e-6 or (ka[\"e2\"][0] * kb[\"e2\"][1] - ka[\"e2\"][1] * kb[\"e2\"][0]) <= 0:\n712\t            raise ValueError(\"kose: yalnız 90° dışbükey köşe\")\n713\t        if Ba.b < ka[\"L\"] - 1e-6 or Bb.a > 1e-6: raise ValueError(\"kose: flanşlar köşeye kadar uzanmalı (bas / son = 0)\")\n714\t        if abs(Ba.aci - 90) > 1e-6 or abs(Bb.aci - 90) > 1e-6 or Ba.yon != Bb.yon or abs(Ba.R - Bb.R) > 1e-9:\n715\t            raise ValueError(\"kose: iki flanş 90°, aynı yön, aynı R olmalı\")\n716\t        t, R = self.t, Ba.R\n717\t        if kaynak is None: kaynak = tip == \"bindirme\"\n718\t        g = bosluk if bosluk is not None else STD.kose_bosluk(kaynakli=bool(kaynak))\n719\t        if tip == \"bindirme\":\n720\t            for C in (Ba.cocuk, Bb.cocuk):\n721\t                if C.cocuklar: raise ValueError(\"kose: köşe kapamayı %s alt flanşlarından ÖNCE çağırın\" % C.ad)\n722\t            ust = (ustte or f1).bukum\n723\t            e_ust, e_alt = R + t - g, R - g\n724\t            for Bx, uc in ((Ba, \"son\"), (Bb, \"bas\")):\n725\t                e = e_ust if Bx is ust else e_alt\n726\t                if uc == \"son\": Bx.uz_b = e\n727\t                else: Bx.uz_a = e\n728\t                C = Bx.cocuk; Lf = Bx.Lf\n729\t                C.poly = [(0.0, Bx.a - Bx.uz_a), (Lf, Bx.a - Bx.uz_a), (Lf, Bx.b + Bx.uz_b), (0.0, Bx.b + Bx.uz_b)]\n730\t        elif tip != \"acik\":\n731\t            raise ValueError(\"kose tip: acik / bindirme\")\n732\t        Vtx = kb[\"p0\"]; d1, d2 = -ka[\"e2\"], kb[\"e2\"]\n733\t        q = lambda al, be: tuple(Vtx + d1 * al + d2 * be)\n734\t        hedef = {(\"P\", P.no), (\"B\", Ba.no), (\"B\", Bb.no)}\n735\t        if rahat == \"kare\":\n736\t            c = rahat_boyut if rahat_boyut is not None else max(t, STD.relief(t)[0])\n737\t            yz = yuz_poligon([q(-Bb.BA, -Ba.BA), q(c, -Ba.BA), q(c, c), q(-Bb.BA, c)])\n738\t            P._kesik(yz, \"kose_rahatlatma\", dict(sekil=\"kare\", boyut=c, bukumler=[Ba.no, Bb.no]), dfm=False, hedef=hedef)\n739\t        elif rahat == \"yuvarlak\":\n740\t            c = rahat_boyut if rahat_boyut is not None else STD.kose_deligi(t)\n741\t            P._kesik(yuz_daire(Vtx[0], Vtx[1], c / 2.0), \"kose_rahatlatma\", dict(sekil=\"yuvarlak\", cap=c, bukumler=[Ba.no, Bb.no]), dfm=False, hedef=hedef)\n742\t        elif rahat is not None:\n743\t            raise ValueError(\"rahat: kare / yuvarlak / None\")\n744\t        kayit = dict(tip=tip, bukumler=[Ba.no, Bb.no], bosluk=g if tip == \"bindirme\" else None, rahat=rahat, kaynak=bool(kaynak),\n745\t                     ustte=(ustte or f1).ad if tip == \"bindirme\" else None)\n746\t        Ba.kose_son = kayit; Bb.kose_bas = kayit\n747\t        if kaynak: self.kaynaklar.append(dict(tip=\"kose\", Ba=Ba, Bb=Bb, kayit=kayit))\n748\t        self._gecersiz()\n749\t        return kayit\n750\t\n751\t    def punta(self, diger, noktalar, cap=5.0, not_=\"\"):\n752\t        \"\"\"punta (direnç nokta kaynağı) etiketi — katı yok, meta\"\"\"\n753\t        k = dict(tip=\"punta\", parcalar=[self.ad, diger.ad if hasattr(diger, \"ad\") else str(diger)], cap=cap,\n754\t                 noktalar=[[round(float(c), 2) for c in p] for p in noktalar], adet=len(noktalar), not_=not_)\n755\t        self.puntalar.append(k)\n756\t        return k\n757\t\n758\t    # ---------------- bölgeler (A ve B ortak): son 2B yüzler\n759\t    def _bolgeler(self):\n760\t        if \"bolge\" in self._c: return self._c[\"bolge\"]\n761\t        kes = [k for P in self.paneller for k in P.kesikler]\n762\t        pan, ser = {}, {}\n763\t        for P in self.paneller:\n764\t            F = P._ham_yuz(); bb = F.BoundingBox(); Di = np.linalg.inv(P.D)\n765\t            for k in kes:\n766\t                if k.hedef is not None and (\"P\", P.no) not in k.hedef: continue\n767\t                cf = k.yuz if k.sahip is P else _yuz_tasi(k.yuz, Di @ k.sahip.D)\n768\t                if _bb_kesisir(cf.BoundingBox(), bb): F = F.cut(cf)\n769\t            pan[P.no] = F\n770\t        for B in self.bukumler:\n771\t            S = yuz_dikd(0.0, B.BA, B.a, B.b); bb = S.BoundingBox(); Si = np.linalg.inv(B.ebeveyn.D @ B.Hs)\n772\t            for k in kes:\n773\t                if k.hedef is not None and (\"B\", B.no) not in k.hedef: continue\n774\t                cf = _yuz_tasi(k.yuz, Si @ k.sahip.D)\n775\t                if _bb_kesisir(cf.BoundingBox(), bb): S = S.cut(cf)\n776\t            ser[B.no] = S\n777\t        self._c[\"bolge\"] = (pan, ser)\n778\t        return pan, ser\n779\t\n780\t    def _yerel_katilar(self):\n781\t        \"\"\"panel prizmaları (panel yerelinde) + büküm dilimleri (ebeveyn yerelinde)\"\"\"\n782\t        if \"yk\" in self._c: return self._c[\"yk\"]\n783\t        pan, ser = self._bolgeler(); t = self.t\n784\t        pk = {no: (_prizma(F, t) if _alan(F) > 1e-9 else None) for no, F in pan.items()}\n785\t        sk = {}\n786\t        for B in self.bukumler:\n787\t            sk[B.no] = [_sektor(B.A0, B.k, B.rho, B.e3, w0, w1, B.R, B.R + t, B.th * s0 / B.BA, B.th * (s1 - s0) / B.BA)\n788\t                        for s0, s1, w0, w1 in _dikd_ayir(ser[B.no], B.BA) if s1 - s0 > 1e-9]\n789\t        self._c[\"yk\"] = (pk, sk)\n790\t        return pk, sk\n791\t\n792\t    def _bolge_katilari(self):\n793\t        \"\"\"dünyada her bölgenin ayrı katısı: [(etiket, katı)]\"\"\"\n794\t        pk, sk = self._yerel_katilar(); out = []\n795\t        for P in self.paneller:\n796\t            if pk[P.no] is not None: out.append(((\"P\", P.no), _tasi(pk[P.no], P.M)))\n797\t        for B in self.bukumler:\n798\t            for s in sk[B.no]: out.append(((\"B\", B.no), _tasi(s, B.ebeveyn.M)))\n799\t        return out\n800\t\n801\t    def kati_temel(self):\n802\t        \"\"\"3B katı (şekil/form özellikleri hariç) — açınım doğrulaması bununla yapılır\"\"\"\n803\t        if \"temel\" not in self._c:\n804\t            self._c[\"temel\"] = _birlestir([s for _e, s in self._bolge_katilari()])\n805\t        return self._c[\"temel\"]\n806\t\n807\t    def kati(self):\n808\t        \"\"\"3B katı (panjur / kabartma dahil)\"\"\"\n809\t        if \"kati\" in self._c: return self._c[\"kati\"]\n810\t        sh = self.kati_temel()\n811\t        for P in self.paneller:\n812\t            for fm in P.formlar:\n813\t                ekle, cikar = _form_araclari(fm, self.t)\n814\t                if cikar is not None: sh = sh.cut(_tasi(cikar, P.M))\n815\t                if ekle is not None: sh = sh.fuse(_tasi(ekle, P.M))\n816\t                if fm[\"tip\"] == \"kabartma\" and fm.get(\"_ic\") is not None: pass\n817\t        sh = sh.clean()\n818\t        self._c[\"kati\"] = sh\n819\t        return sh\n820\t\n821\t    # ---------------- açınım (B)\n822\t    def _duz_yuz(self):\n823\t        if \"duz\" in self._c: return self._c[\"duz\"]\n824\t        pan, ser = self._bolgeler()\n825\t        yz = [_yuz_tasi(F, P.D) for P in self.paneller for F in [pan[P.no]] if _alan(F) > 1e-9]\n826\t        yz += [_yuz_tasi(ser[B.no], B.ebeveyn.D @ B.Hs) for B in self.bukumler if _alan(ser[B.no]) > 1e-9]\n827\t        F = _birlestir(yz)\n828\t        self._c[\"duz\"] = F\n829\t        return F\n830\t\n831\t    def acinim(self):\n832\t        \"\"\"AÇINIM (flat pattern) — JSON'a hazır sözlük. Koordinat: kök panelin yereli (Z = t üst yüz). DXF'e birebir aktarılabilir.\"\"\"\n833\t        if \"acinim\" in self._c: return self._c[\"acinim\"]\n834\t        F = self._duz_yuz(); yuzler = F.Faces()\n835\t        dis, ic = [], []\n836\t        for f in yuzler:\n837\t            dis.append(_tel_varliklari(f.outerWire(), f))\n838\t            for w in f.innerWires(): ic.append(_tel_varliklari(w, f))\n839\t        bk = []\n840\t        pan, ser = self._bolgeler()\n841\t        for B in self.bukumler:\n842\t            S = B.ebeveyn.D @ B.Hs\n843\t            T0 = [_Hp(S, (0.0, B.a)), _Hp(S, (0.0, B.b))]; T1 = [_Hp(S, (B.BA, B.a)), _Hp(S, (B.BA, B.b))]\n844\t            Cz = [_Hp(S, (B.BA / 2.0, B.a)), _Hp(S, (B.BA / 2.0, B.b))]\n845\t            ws = [g.BoundingBox() for g in ser[B.no].Faces()]\n846\t            gercek = [min(w.ymin for w in ws), max(w.ymax for w in ws)] if ws else [B.a, B.b]\n847\t            bk.append(dict(no=B.no + 1, ad=B.cocuk.ad, aci=round(B.aci, 4), yon=\"yukari\" if B.yon > 0 else \"asagi\", R=round(B.R, 4), K=round(B.K, 4),\n848\t                           BA=round(B.BA, 5), tip=B.tip, t=self.t, V_kalip=STD.V(self.t),\n849\t                           cizgi=[[round(c, 5) for c in p] for p in Cz], baslangic=[[round(c, 5) for c in p] for p in T0],\n850\t                           bitis=[[round(c, 5) for c in p] for p in T1], nominal_boy=round(B.b - B.a, 4),\n851\t                           gercek_aralik=[round(gercek[0], 4), round(gercek[1], 4)], gercek_boy=round(gercek[1] - gercek[0], 4)))\n852\t        pts = [p for kontur in dis for e in kontur for p in _varlik_noktalari(e)]\n853\t        L, W, aci = _min_dikdortgen(pts)\n854\t        alan = _alan(F)\n855\t        sabit = _ic_nokta(_yuz_tasi(pan[0], self.paneller[0].D)) if _alan(pan[0]) > 1e-9 else None\n856\t        kes = []\n857\t        for P in self.paneller:\n858\t            for k in P.kesikler:\n859\t                c = k.meta.get(\"merkez\")\n860\t                kes.append(dict(panel=P.ad, tip=k.tip, sekil=k.meta.get(\"sekil\"), merkez_duz=[round(x, 4) for x in _Hp(P.D, c)] if c else None,\n861\t                                **{kk: vv for kk, vv in k.meta.items() if kk in (\"cap\", \"boy\", \"en\", \"aci\", \"parca\", \"std\", \"uc\", \"genislik\", \"derinlik\", \"boyut\")}))\n862\t        fm = []\n863\t        for P in self.paneller:\n864\t            for f in P.formlar:\n865\t                c = _Hp(P.D, (f[\"u\"], f[\"v\"])); a = math.degrees(math.atan2(P.D[1, 0], P.D[0, 0])) + f.get(\"aci\", 0.0)\n866\t                fm.append(dict(panel=P.ad, tip=f[\"tip\"], merkez=[round(c[0], 4), round(c[1], 4)], aci=round(a, 4), boy=f[\"boy\"], en=f[\"en\"], h=f[\"h\"],\n867\t                               yon=\"yukari\" if f[\"yon\"] > 0 else \"asagi\", not_=\"taret/form takımı · lazer kesmez\" if f[\"tip\"] == \"panjur\" else \"kabartma kalıbı\"))\n868\t        a = dict(parca=self.ad, surum=SURUM, malzeme=self.malzeme, t=self.t, R=self.R, K=self.K, adet=self.adet,\n869\t                 birim=\"mm\", ust_yuz=\"Z = t yüzü = kök panelin +n yüzü (bütün panellerin yerel z = t yüzü)\",\n870\t                 dis_kontur=dis[0] if len(dis) == 1 else dis, ek_dis_konturlar=dis[1:] if len(dis) > 1 else [],\n871\t                 ic_konturlar=ic, bukumler=bk, formlar=fm, kesikler=kes, parca_sayisi=len(yuzler),\n872\t                 levha=dict(boy=round(float(max(L, W)), 3), en=round(float(min(L, W)), 3), aci=round(float(aci), 4), alan_mm2=round(alan, 2),\n873\t                            kutle_kg=round(alan * self.t * YOGUNLUK, 4)),\n874\t                 sabit_yuz=[round(sabit[0], 5), round(sabit[1], 5)] if sabit else None,\n875\t                 donusum_3b=[[round(float(x), 9) for x in r] for r in self.paneller[0].M])\n876\t        self._c[\"acinim\"] = a\n877\t        return a\n878\t\n879\t    # ---------------- doğrulama\n880\t    def dogrula(self, kesit=True):\n881\t        \"\"\"açınımdan yeniden bükülen katı ↔ 3B · kalınlık · kesit yarıçapları\"\"\"\n882\t        if \"dogrula\" in self._c: return self._c[\"dogrula\"]\n883\t        A = self.kati_temel(); vA = A.Volume(); acn = self.acinim()\n884\t        r = dict(parca=self.ad, V_3b=round(vA, 3), kati_sayisi=len(A.Solids()), gecerli=A.isValid())\n885\t        try:\n886\t            C, rap = acinimdan_kati(json.loads(json.dumps(acn)))\n887\t            vC = C.Volume(); r.update(V_acinimdan=round(vC, 3), hacim_farki_yuzde=round(100.0 * abs(vA - vC) / vA, 5), yeniden_bukum=rap)\n888\t            try:\n889\t                d = A.cut(C).Volume() + C.cut(A).Volume()\n890\t                r[\"simetrik_fark_yuzde\"] = round(100.0 * d / vA, 5)\n891\t            except Exception as e:\n892\t                r[\"simetrik_fark_yuzde\"] = None; r[\"simetrik_hata\"] = str(e)[:120]\n893\t            r[\"acinim_gecti\"] = r[\"hacim_farki_yuzde\"] < 0.5 and (r.get(\"simetrik_fark_yuzde\") is None or r[\"simetrik_fark_yuzde\"] < 0.5)\n894\t        except Exception as e:\n895\t            r.update(acinim_gecti=False, yeniden_bukum_hatasi=repr(e)[:300])\n896\t        Vd = acn[\"levha\"][\"alan_mm2\"] * self.t\n897\t        r[\"V_duz_alanxt\"] = round(Vd, 3); r[\"duz_3b_fark_yuzde\"] = round(100.0 * (Vd - vA) / vA, 5)\n898\t        bek = sum(B.th * self.t * self.t * (B.K - 0.5) * (B.b - B.a) for B in self.bukumler)     # nötr eksen (R + Kt) ↔ orta yüzey (R + t/2)\n899\t        r[\"duz_3b_beklenen_fark_yuzde\"] = round(100.0 * bek / vA, 5)\n900\t        r[\"kalinlik\"] = kalinlik_denetle(A, self.t)\n901\t        if kesit:\n902\t            ks = []\n903\t            for B in self.bukumler:\n904\t                pan, ser = self._bolgeler()\n905\t                fs = ser[B.no].Faces()\n906\t                if not fs: continue\n907\t                bb = max(fs, key=lambda f: f.Area()).BoundingBox(); wm = (bb.ymin + bb.ymax) / 2.0\n908\t                Pw = _p(B.ebeveyn.M, B.A0 + B.e3 * wm); kw = B.ebeveyn.M[:3, :3] @ B.e3\n909\t                yr = kesit_yaricaplari(A, Pw, kw, eksen=Pw, tol=1e-3)\n910\t                bek = sorted({round(B.R, 3), round(B.R + self.t, 3)}) if B.R > 1e-3 else [round(self.t, 3)]\n911\t                ks.append(dict(bukum=B.no + 1, bulunan=sorted(set(round(x, 3) for x in yr)), beklenen=bek,\n912\t                               gecti=all(any(abs(x - y) < 1e-3 for x in yr) for y in bek)))\n913\t            r[\"kesit\"] = ks; r[\"kesit_gecti\"] = all(k[\"gecti\"] for k in ks)\n914\t        self._c[\"dogrula\"] = r\n915\t        return r\n916\t\n917\t    # ---------------- DFM\n918\t    def dfm(self, abkant=True):\n919\t        if (\"dfm\", abkant) in self._c: return self._c[(\"dfm\", abkant)]\n920\t        out = dfm_denetle(self, abkant=abkant)\n921\t        self._c[(\"dfm\", abkant)] = out\n922\t        return out\n923\t\n924\t    # ---------------- montaj uyumu\n925\t    def meta(self, dfm_ozet=True):\n926\t        a = self.acinim()\n927\t        m = dict(tur=\"sac\", surum=SURUM, malzeme=self.malzeme, rol=self.rol, t=self.t, R=self.R, K=self.K, adet=self.adet,\n928\t                 bukum_sayisi=len(self.bukumler), bukumler=[B.ozet() for B in self.bukumler],\n929\t                 acinim=dict(boy=a[\"levha\"][\"boy\"], en=a[\"levha\"][\"en\"], alan_mm2=a[\"levha\"][\"alan_mm2\"], kutle_kg=a[\"levha\"][\"kutle_kg\"],\n930\t                             delik=len(a[\"ic_konturlar\"]), dosya=\"%s_acinim.json\" % self.ad),\n931\t                 kose=[dict(B.kose_son, bukum=B.no + 1) for B in self.bukumler if hasattr(B, \"kose_son\")],\n932\t                 punta=sum(p[\"adet\"] for p in self.puntalar), kaynak=len(self.kaynaklar))\n933\t        if dfm_ozet and (\"dfm\", True) in self._c:\n934\t            d = self._c[(\"dfm\", True)]\n935\t            m[\"dfm\"] = dict(hata=sum(1 for x in d if x[\"durum\"] == \"HATA\"), uyari=sum(1 for x in d if x[\"durum\"] == \"UYARI\"))\n936\t        return m\n937\t\n938\t    def parca(self):\n939\t        sh = self.kati(); bb = sh.BoundingBox(); a = self.acinim()\n940\t        return dict(ad=self.ad, wp=cq.Workplane(\"XY\").add(sh), sh=sh, mal=self.mal, birim=self.birim, grup=self.grup, kaynak=self.kaynak, tur=\"sac\",\n941\t                    bom=(\"Sac %s · AISI 304 t %g · %d büküm (R %g, K %g) · açınım %.0f × %.0f\" % (self.ad, self.t, len(self.bukumler), self.R, self.K,\n942\t                                                                                             a[\"levha\"][\"boy\"], a[\"levha\"][\"en\"]),\n943\t                         self.adet, \"%.1f × %.1f × %.1f\" % (bb.xlen, bb.ylen, bb.zlen),\n944\t                         \"lazer + abkant%s · %.2f kg\" % (\" + TIG\" if self.kaynaklar else \"\", a[\"levha\"][\"kutle_kg\"]), \"ÜRETİM\"),\n945\t                    sac=self.meta())\n946\t\n947\t    def parcalar(self):\n948\t        \"\"\"sac + kaynak dikişleri (ayrı katılar, sac ile yüz teması)\"\"\"\n949\t        return [self.parca()] + kaynak_parcalari(self)\n950\t\n951\t\n952\t# =====================================================================================================================================\n953\t# 4 · FORM (panjur / kabartma) araçları — panel yerelinde\n954\t# =====================================================================================================================================\n955\tdef _form_araclari(fm, t):\n956\t    \"\"\"(eklenecek, çıkarılacak) katı — panel yerelinde\"\"\"\n957\t    a = math.radians(fm.get(\"aci\", 0.0)); ux, uy = math.cos(a), math.sin(a); nx, ny = -uy, ux\n958\t    u0, v0, yon = fm[\"u\"], fm[\"v\"], fm[\"yon\"]\n959\t    if fm[\"tip\"] == \"panjur\":\n960\t        L, W, h, ag = fm[\"boy\"], fm[\"en\"], fm[\"h\"], fm.get(\"agiz\", -1)\n961\t        # yerel (s: boy yönü, q: en yönü, z): kapalı taraf q = −ag·W/2, açık taraf q = +ag·W/2\n962\t        def P(s, q, z):\n963\t            qq = q * ag\n964\t            return (u0 + ux * s + nx * qq, v0 + uy * s + ny * qq, z if yon > 0 else t - z)\n965\t        def kati(pts6):                       # alt 3 + üst 3 nokta (üçgen / dörtgen prizma) → convex hull benzeri: iki uç düzlemden loft\n966\t            return cq.Solid.makeLoft([cq.Wire.makePolygon([V(*p) for p in pts6[0]], close=True), cq.Wire.makePolygon([V(*p) for p in pts6[1]], close=True)], True)\n967\t        hw = W / 2.0; hl = L / 2.0\n968\t        kesik = kati([[P(-hl, -hw, -1), P(-hl, hw, -1), P(-hl, hw, t + 1), P(-hl, -hw, t + 1)],\n969\t                      [P(hl, -hw, -1), P(hl, hw, -1), P(hl, hw, t + 1), P(hl, -hw, t + 1)]])\n970\t        # başlık: kapalı kenardan (q = −hw, z 0) açık kenara (q = +hw, z h) eğimli levha (t kalın) + iki yan üçgen\n971\t        bas = kati([[P(-hl, -hw, 0), P(-hl, hw, h), P(-hl, hw, h + t), P(-hl, -hw, t)],\n972\t                    [P(hl, -hw, 0), P(hl, hw, h), P(hl, hw, h + t), P(hl, -hw, t)]])\n973\t        yan = [kati([[P(s0, -hw, t), P(s0, hw, t), P(s0, hw, h + t)], [P(s0 + ds, -hw, t), P(s0 + ds, hw, t), P(s0 + ds, hw, h + t)]])\n974\t               for s0, ds in ((-hl - t, t), (hl, t))]\n975\t        return _birlestir([bas] + yan), kesik\n976\t    if fm[\"tip\"] == \"kabartma\":\n977\t        L, W, h, r, eg = fm[\"boy\"], fm[\"en\"], fm[\"h\"], fm.get(\"r\", 0.0), math.radians(fm.get(\"egim\", 20.0))\n978\t        tan = math.tan(eg)\n979\t        def frustum(LL, WW, rr, z0, hh):\n980\t            f = yuz_dikd_r(0.0, 0.0, LL, WW, 0.0, rr)\n981\t            LL2, WW2 = LL - 2 * hh * tan, WW - 2 * hh * tan\n982\t            f2 = yuz_dikd_r(0.0, 0.0, LL2, WW2, 0.0, max(0.0, rr - hh * tan)).translate(V(0, 0, hh))\n983\t            s = cq.Solid.makeLoft([f.outerWire(), f2.outerWire()], True)\n984\t            return s.translate(V(0, 0, z0))\n985\t        dis_ = frustum(L, W, r, t, h)                                        # dış (üst yüzden h yükselen)\n986\t        ic_ = frustum(L - 2 * t, W - 2 * t, max(0.0, r - t), -1.0, h + 1.0)  # iç boşluk (alt yüzden)\n987\t        M = _M(np.array([[ux, nx, 0], [uy, ny, 0], [0, 0, 1.0]]), (u0, v0, 0.0))\n988\t        if yon < 0:\n989\t            M = M @ _M(np.diag([1.0, -1.0, -1.0]), (0, 0, t))\n990\t        return _tasi(dis_, M), _tasi(ic_, M)\n991\t    raise ValueError(fm[\"tip\"])\n992\t\n993\t\n994\t# =====================================================================================================================================\n995\t# 5 · AÇINIM DIŞA AKTARMA + AÇINIMDAN YENİDEN BÜKÜM (bağımsız yol: yalnız JSON verisiyle)\n996\t# =====================================================================================================================================\n997\tdef _r5(x):\n998\t    return round(float(x), 5)\n999\t\n1000\t\n1001\tdef _tel_varliklari(tel, yuz):\n1002\t    out = []\n1003\t    ex = BRepTools_WireExplorer(tel.wrapped, yuz.wrapped)\n1004\t    while ex.More():\n1005\t        E = ex.Current(); e = cq.Edge(E)\n1006\t        p0 = BRep_Tool.Pnt_s(TopExp.FirstVertex_s(E, True)); p1 = BRep_Tool.Pnt_s(TopExp.LastVertex_s(E, True))\n1007\t        a0, a1 = [_r5(p0.X()), _r5(p0.Y())], [_r5(p1.X()), _r5(p1.Y())]\n1008\t        g = e.geomType()\n1009\t        if g == \"LINE\":\n1010\t            out.append(dict(t=\"L\", p=[a0, a1]))\n1011\t        elif g == \"CIRCLE\":\n1012\t            c = BRepAdaptor_Curve(E); u0, u1 = c.FirstParameter(), c.LastParameter(); pm = c.Value((u0 + u1) / 2.0)\n1013\t            cc = c.Circle().Location(); r = c.Circle().Radius()\n1014\t            if abs(abs(u1 - u0) - 2 * math.pi) < 1e-6:\n1015\t                out.append(dict(t=\"C\", c=[_r5(cc.X()), _r5(cc.Y())], r=_r5(r)))\n1016\t            else:\n1017\t                out.append(dict(t=\"A\", p=[a0, [_r5(pm.X()), _r5(pm.Y())], a1], c=[_r5(cc.X()), _r5(cc.Y())], r=_r5(r)))\n1018\t        else:\n1019\t            c = BRepAdaptor_Curve(E); u0, u1 = c.FirstParameter(), c.LastParameter()\n1020\t            if E.Orientation() == TopAbs_REVERSED: u0, u1 = u1, u0\n1021\t            n = 24; q = [c.Value(u0 + (u1 - u0) * i / n) for i in range(n + 1)]\n1022\t            for i in range(n): out.append(dict(t=\"L\", p=[[_r5(q[i].X()), _r5(q[i].Y())], [_r5(q[i + 1].X()), _r5(q[i + 1].Y())]]))\n1023\t        ex.Next()\n1024\t    return out\n1025\t\n1026\t\n1027\tdef _varlik_noktalari(e):\n1028\t    if e[\"t\"] == \"L\": return [tuple(e[\"p\"][0]), tuple(e[\"p\"][1])]\n1029\t    if e[\"t\"] == \"A\": return [tuple(p) for p in e[\"p\"]] + [(e[\"c\"][0] + e[\"r\"] * math.cos(a), e[\"c\"][1] + e[\"r\"] * math.sin(a)) for a in np.linspace(0, 2 * math.pi, 33)\n1030\t                                                          if _yay_icinde(e, a)]\n1031\t    return [(e[\"c\"][0] + e[\"r\"] * math.cos(a), e[\"c\"][1] + e[\"r\"] * math.sin(a)) for a in np.linspace(0, 2 * math.pi, 33)]\n1032\t\n1033\t\n1034\tdef _yay_icinde(e, a):\n1035\t    c = e[\"c\"]; s, m, f = (math.atan2(p[1] - c[1], p[0] - c[0]) for p in e[\"p\"])\n1036\t    def ara(x, a0, a1): return (x - a0) % (2 * math.pi) <= (a1 - a0) % (2 * math.pi) + 1e-9\n1037\t    return ara(a, s, f) if ara(m, s, f) else ara(a, f, s)\n1038\t\n1039\t\n1040\tdef _min_dikdortgen(pts):\n1041\t    \"\"\"dışbükey zarf + döner kumpas → (L, W, açı°) en küçük alanlı dikdörtgen\"\"\"\n1042\t    P = sorted(set((round(x, 6), round(y, 6)) for x, y in pts))\n1043\t    if len(P) < 3:\n1044\t        return 0.0, 0.0, 0.0\n1045\t    def cr(o, a, b): return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])\n1046\t    lo, hi = [], []\n1047\t    for p in P:\n1048\t        while len(lo) >= 2 and cr(lo[-2], lo[-1], p) <= 0: lo.pop()\n1049\t        lo.append(p)\n1050\t    for p in reversed(P):\n1051\t        while len(hi) >= 2 and cr(hi[-2], hi[-1], p) <= 0: hi.pop()\n1052\t        hi.append(p)\n1053\t    H = np.array(lo[:-1] + hi[:-1]); en = (1e18, 0, 0, 0)\n1054\t    for i in range(len(H)):\n1055\t        d = H[(i + 1) % len(H)] - H[i]; L = np.linalg.norm(d)\n1056\t        if L < 1e-9: continue\n1057\t        u = d / L; w = np.array([-u[1], u[0]]); a = H @ u; b = H @ w\n1058\t        A = (a.max() - a.min()) * (b.max() - b.min())\n1059\t        if A < en[0]: en = (A, a.max() - a.min(), b.max() - b.min(), math.degrees(math.atan2(u[1], u[0])))\n1060\t    return en[1], en[2], en[3]\n1061\t\n1062\t\n1063\tdef _varliklardan_tel(ents):\n1064\t    es = []\n1065\t    for e in ents:\n1066\t        if e[\"t\"] == \"L\":\n1067\t            es.append(cq.Edge.makeLine(_V2(*e[\"p\"][0]), _V2(*e[\"p\"][1])))\n1068\t        elif e[\"t\"] == \"A\":\n1069\t            es.append(cq.Edge.makeThreePointArc(_V2(*e[\"p\"][0]), _V2(*e[\"p\"][1]), _V2(*e[\"p\"][2])))\n1070\t        elif e[\"t\"] == \"C\":\n1071\t            return cq.Wire.makeCircle(e[\"r\"], _V2(*e[\"c\"]), V(0, 0, 1))\n1072\t    return cq.Wire.assembleEdges(es)\n1073\t\n1074\t\n1075\tdef _varliklardan_yuz(dis, icler):\n1076\t    konturlar = dis if (dis and isinstance(dis[0], list)) else [dis]\n1077\t    F = _birlestir([cq.Face.makeFromWires(_varliklardan_tel(k)) for k in konturlar], temizle=False)\n1078\t    for k in icler:\n1079\t        F = F.cut(cq.Face.makeFromWires(_varliklardan_tel(k)))\n1080\t    return F\n1081\t\n1082\t\n1083\tdef acinimdan_kati(acn, dw=0.1):\n1084\t    \"\"\"BAĞIMSIZ YENİDEN BÜKÜM: yalnız açınım JSON'u (kontur + büküm çizgileri + açı/yön/R/BA + sabit yüz + kök dönüşümü) okunur.\n1085\t    Açınım büküm şeritlerinden bölünür, paneller bağlantı ağacıyla (BFS) katlanır. Dönüş (katı, rapor).\"\"\"\n1086\t    t = float(acn[\"t\"]); Z = np.array([0.0, 0.0, 1.0])\n1087\t    F = _varliklardan_yuz(acn[\"dis_kontur\"] if not acn.get(\"ek_dis_konturlar\") else [acn[\"dis_kontur\"]] + acn[\"ek_dis_konturlar\"], acn[\"ic_konturlar\"])\n1088\t    bk = []\n1089\t    for b in acn[\"bukumler\"]:\n1090\t        T0 = np.array(b[\"baslangic\"], float); T1 = np.array(b[\"bitis\"], float); BA = float(b[\"BA\"])\n1091\t        e = _n(T0[1] - T0[0]); m = (T1[0] - T0[0]) / BA\n1092\t        rect = yuz_poligon([tuple(T0[0]), tuple(T0[1]), tuple(T1[1]), tuple(T1[0])])\n1093\t        bk.append(dict(b=b, T0=T0, T1=T1, BA=BA, e=e, m=_n(m), rect=rect))\n1094\t    U = _birlestir([x[\"rect\"] for x in bk]) if bk else None\n1095\t    paneller = (F.cut(U) if U is not None else F).Faces()\n1096\t    paneller = [p for p in paneller if p.Area() > 1e-6]\n1097\t    def hangi(q):\n1098\t        for i, p in enumerate(paneller):\n1099\t            if _icinde(p, (q[0], q[1], 0.0), 1e-9): return i\n1100\t        return None\n1101\t    kenarlar = []\n1102\t    for j, x in enumerate(bk):\n1103\t        parc = [g for g in F.intersect(x[\"rect\"]).Faces() if g.Area() > 1e-9]\n1104\t        x[\"parca\"] = parc\n1105\t        if not parc: continue\n1106\t        g = max(parc, key=lambda f: f.Area()); c = g.Center(); cc = np.array([c.x, c.y])\n1107\t        wm = float(np.dot(cc - x[\"T0\"][0], x[\"e\"]))\n1108\t        eps = 1e-3\n1109\t        q0 = x[\"T0\"][0] + x[\"e\"] * wm - x[\"m\"] * eps; q1 = x[\"T1\"][0] + x[\"e\"] * wm + x[\"m\"] * eps\n1110\t        x[\"yan\"] = (hangi(q0), hangi(q1))\n1111\t        kenarlar.append(j)\n1112\t    s0 = acn.get(\"sabit_yuz\")\n1113\t    kok = hangi(s0) if s0 else 0\n1114\t    if kok is None: raise ValueError(\"sabit yüz bulunamadı\")\n1115\t    T = {kok: np.array(acn[\"donusum_3b\"], float)}\n1116\t    sira, sektorler, kullanilan = [kok], [], set()\n1117\t    while sira:\n1118\t        p = sira.pop(0)\n1119\t        for j in kenarlar:\n1120\t            if j in kullanilan: continue\n1121\t            x = bk[j]; a, b_ = x[\"yan\"]\n1122\t            if p not in (a, b_): continue\n1123\t            if a == p: sabit_cizgi, yon_v, cocuk = x[\"T0\"], x[\"m\"], b_\n1124\t            else: sabit_cizgi, yon_v, cocuk = x[\"T1\"], -x[\"m\"], a\n1125\t            if cocuk is None: raise ValueError(\"büküm %d: karşı panel yok\" % x[\"b\"][\"no\"])\n1126\t            kullanilan.add(j)\n1127\t            th = math.radians(x[\"b\"][\"aci\"]); R = float(x[\"b\"][\"R\"]); up = x[\"b\"][\"yon\"] == \"yukari\"; BA = x[\"BA\"]\n1128\t            A = np.r_[sabit_cizgi[0], 0.0] + Z * ((t + R) if up else -R)\n1129\t            d3 = np.r_[yon_v, 0.0]\n1130\t            k = np.cross(d3, Z) if up else np.cross(Z, d3)\n1131\t            rho = -Z if up else Z\n1132\t            Fm = _M_eksen(A, k, th) @ _M_ot(-BA * d3)\n1133\t            if cocuk in T:\n1134\t                continue\n1135\t            T[cocuk] = T[p] @ Fm\n1136\t            sira.append(cocuk)\n1137\t            # şerit dilimleri: (s, w') sağ elli (w' = Z × yön)\n1138\t            wv = np.array([-yon_v[1], yon_v[0]]); o2 = sabit_cizgi[0]\n1139\t            H = np.array([[yon_v[0], wv[0], o2[0]], [yon_v[1], wv[1], o2[1]], [0, 0, 1.0]])\n1140\t            Hi = np.linalg.inv(H)\n1141\t            for g in x[\"parca\"]:\n1142\t                for a0, a1, w0, w1 in _dikd_ayir(_yuz_tasi(g, Hi), BA, dw):\n1143\t                    if a1 - a0 < 1e-9: continue\n1144\t                    sk = _sektor(A, k, rho, np.r_[wv, 0.0], w0, w1, R, R + t, th * a0 / BA, th * (a1 - a0) / BA)\n1145\t                    sektorler.append(_tasi(sk, T[p]))\n1146\t    eksik = [i for i in range(len(paneller)) if i not in T]\n1147\t    if eksik: raise ValueError(\"katlanamayan panel: %s\" % eksik)\n1148\t    ss = [_tasi(_prizma(paneller[i], t), T[i]) for i in range(len(paneller))] + sektorler\n1149\t    return _birlestir(ss), dict(panel=len(paneller), bukum=len(kullanilan), sektor=len(sektorler), kok=kok)\n1150\t\n1151\t\n1152\t# =====================================================================================================================================\n1153\t# 6 · KALINLIK DOĞRULAYICI + KESİT\n1154\t# =====================================================================================================================================\n1155\tdef _yuz_ornekleri(f, n=3):\n1156\t    S = BRepAdaptor_Surface(f.wrapped, True)\n1157\t    u0, u1, v0, v1 = S.FirstUParameter(), S.LastUParameter(), S.FirstVParameter(), S.LastVParameter()\n1158\t    out = []\n1159\t    for fu, fv in ((0.5, 0.5), (0.31, 0.37), (0.69, 0.63), (0.23, 0.77), (0.77, 0.23), (0.5, 0.13), (0.13, 0.5), (0.87, 0.5), (0.5, 0.87)):\n1160\t        u, v = u0 + (u1 - u0) * fu, v0 + (v1 - v0) * fv\n1161\t        if BRepClass_FaceClassifier(f.wrapped, gp_Pnt2d(u, v), 1e-9).State() != TopAbs_IN: continue\n1162\t        pr = BRepLProp_SLProps(S, u, v, 1, 1e-9)\n1163\t        if not pr.IsNormalDefined(): continue\n1164\t        nn = pr.Normal(); nv = np.array([nn.X(), nn.Y(), nn.Z()])\n1165\t        if f.wrapped.Orientation() == TopAbs_REVERSED: nv = -nv\n1166\t        p = S.Value(u, v)\n1167\t        out.append((np.array([p.X(), p.Y(), p.Z()]), nv))\n1168\t        if len(out) >= n: break\n1169\t    return out\n1170\t\n1171\t\n1172\tdef kalinlik_denetle(sh, t, tol=None, haric=None):\n1173\t    \"\"\"Sac kalınlığı her yerde t mi? · her yüzde ≤ 3 örnek noktadan iç normal yönünde ışın: karşı yüze uzaklık = t ise 'ana yüz';\n1174\t    değilse yüz 'kenar şeridi' mi (genişliği t: alan / (çevre/2)) bakılır; ikisi de değilse HATA.\"\"\"\n1175\t    tol = tol if tol is not None else max(0.01, 0.01 * t)\n1176\t    it = IntCurvesFace_ShapeIntersector(); it.Load(sh.wrapped, 1e-7)\n1177\t    r = dict(t=t, yuz=0, ana=0, kenar=0, haric=0, hata=[], olcum_min=None, olcum_max=None)\n1178\t    ol = []\n1179\t    for i, f in enumerate(sh.Faces()):\n1180\t        r[\"yuz\"] += 1\n1181\t        ornek = _yuz_ornekleri(f)\n1182\t        if haric and ornek and all(any(_kutu_icinde(p, k) for k in haric) for p, _n_ in ornek):\n1183\t            r[\"haric\"] += 1; continue\n1184\t        ds = []\n1185\t        for p, nv in ornek:\n1186\t            q = p - nv * 1e-5\n1187\t            it.Perform(gp_Lin(gp_Pnt(*q), gp_Dir(*(-nv))), 1e-7, 1e5)\n1188\t            ws = sorted(it.WParameter(j) for j in range(1, it.NbPnt() + 1) if it.WParameter(j) > 1e-7)\n1189\t            ds.append(ws[0] + 1e-5 if ws else float(\"inf\"))\n1190\t        if ds and all(abs(d - t) < tol for d in ds):\n1191\t            r[\"ana\"] += 1; ol.extend(ds); continue\n1192\t        A = f.Area(); P = sum(e.Length() for e in f.Edges())\n1193\t        w1 = A / (P / 2.0) if P > 0 else 0; dsc = (P / 2.0) ** 2 - 4 * A\n1194\t        ws_ = [w1] + ([(P / 2.0 - math.sqrt(dsc)) / 2.0, (P / 2.0 + math.sqrt(dsc)) / 2.0] if dsc >= 0 else [])\n1195\t        if min(abs(w - t) for w in ws_) < 0.03 * t:                 # kesim kenarı şeridi (genişliği t; kısa şeritte büyük kök)\n1196\t            r[\"kenar\"] += 1; continue\n1197\t        if f.geomType() == \"CYLINDER\":                               # delik / yuvarlak kesik duvarı: eksen boyunca boyu t\n1198\t            ax = BRepAdaptor_Surface(f.wrapped, True).Cylinder().Axis().Direction(); ax = np.array([ax.X(), ax.Y(), ax.Z()])\n1199\t            zz = [float(np.dot(np.array(v.toTuple()), ax)) for v in f.Vertices()]"}]},"uuid":"232a03c2-11f9-498f-bf49-649ea6edeb70","timestamp":"2026-10-01T22:48:54.262Z","sourceToolAssistantUUID":"56dba1f6-5bdc-4890-ac54-646a59d91eb8","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
