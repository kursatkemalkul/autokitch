alline-crunching-moonbeam"}
{"parentUuid":"71f415fd-e281-4908-94d5-20ccd9f034cb","isSidechain":true,"promptId":"6d13b065-9608-42c4-83ca-508fc3c4db72","agentId":"a25b9854cf7bf8eac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0182doqBuPKThrswPFePXb28","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"ornek_dolap_v1 — h3_sac_v1 kütüphanesinin örneği: 600 × 830 × 1074 tipik alt dolap (2 Eki 2026 · Claude · YEREL · montaja bağlı DEĞİL)\n3\t\n4\tDeğerler: sac_kararlar_v1.json > sac_standart_v1.json (kabuk 1,5 · raf/taban 1,5 · kapak 1,5 dış + 1,0 iç tava · su kırıcı perde 1,2 ·\n5\tbraket 3,0 · iç R = 1,5t · K standart BD tablosundan · derz 3 · PEM SP-M5 somun / FHP-M5 saplama · gizli 180° kaldır-çıkar menteşe ·\n6\tgömme bükümlü kulp · havalandırma = lazer yarık + iç su kırıcı perde).\n7\tDünya: x hat boyunca 0–600 · y yukarı 0–1074 (zemin 0, gövde altı 150) · z koridora: ön 0, arka −830.\n8\tParçalar: üst tabla (öne 90° önlük + kapalı kıvırma, yanlar/arka aşağı, ön köşeler bindirme + TIG) · kendinden taşıyıcı yanlar (ön flanş + dönüş,\n9\tarka flanş, üst flanş) · taban tavası (4 flanş, köşeler kaynaklı) · sırt (3 flanş, lazer yarık) · su kırıcı perde · raf (dil-yuva ile sırta) ·\n10\tçift cidarlı kapak (dış tava + J kulp, iç tava, arada yalıtım boşluğu) · 2 gizli menteşe · 4 ayarlı ayak (3 mm plaka + kaynaklı kör burç).\n11\tÇıktılar (bu klasör): ornek_dolap_v1.glb · ornek_dolap_v1_rapor.json · ornek_dolap_v1_acinim/<parça>.json · ornek_dolap_v1_kesit_*.png\n12\tÇalıştır: python -u ornek_dolap_v1.py\"\"\"\n13\timport os, sys, time, json\n14\tBUR = os.path.dirname(os.path.abspath(__file__))\n15\tsys.path.insert(0, os.path.abspath(os.path.join(BUR, \"..\", \"b3\", \"arastirma\", \"_uretec\", \"h3\"))); sys.path.insert(0, BUR)\n16\timport numpy as np\n17\timport h3_sac_v1 as S\n18\t\n19\tT0 = time.time()\n20\tW, D, H = 600.0, 830.0, 1074.0\n21\tY_B = 150.0                                   # gövde altı (taban dış yüzü); ayaklar 0–150\n22\tDERZ = S.STD.derz(); GM = S.STD.montaj_boslugu(); KP = S.STD.kapak()\n23\tKAPAK_D = KP[\"dis_donus\"]                     # kapak derinliği = dış tava dönüşü (20)\n24\tZ_CER = -(KAPAK_D + DERZ)                     # gövde ön çerçevesi (yan ön flanş dış yüzü)\n25\tAPRON = 40.0\n26\tY_KAPAK_UST = H - APRON - DERZ\n27\tBIRIM = \"ORNEK_DOLAP\"\n28\tSACLAR, BIRLESIM, EK = [], [], []\n29\t\n30\t\n31\tdef sac(ad, rol, **k):\n32\t    s = S.Sac(ad, rol=rol, birim=BIRIM, **k); SACLAR.append(s); return s\n33\t\n34\t\n35\tdef g_(s):\n36\t    return s.R + s.t\n37\t\n38\t\n39\tdef log(m):\n40\t    print(\"[%5.1fs] %s\" % (time.time() - T0, m)); sys.stdout.flush()\n41\t\n42\t\n43\t# ------------------------------------------------------------------ 1 · ÜST TABLA (öne 90° önlük + kapalı kıvırma)\n44\tut = sac(\"ust_tabla\", \"dis\"); t1, g1 = ut.t, g_(ut)\n45\tP_ut = ut.taban([(g1, g1), (W - g1, g1), (W - g1, D - g1), (g1, D - g1)], O=(0, H - t1, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"tabla\")\n46\tut_on = P_ut.flans(0, APRON, yon=-1, ad=\"onluk\")\n47\tut_sag = P_ut.flans(1, 25, yon=-1, ad=\"sag_flans\")\n48\tut_arka = P_ut.flans(2, 25, yon=-1, ad=\"arka_flans\")\n49\tut_sol = P_ut.flans(3, 25, yon=-1, ad=\"sol_flans\")\n50\tut.kose(ut_on, ut_sag, \"bindirme\", ustte=ut_on)                 # görünür ön köşeler: bindirme + TIG + taşlama\n51\tut.kose(ut_sol, ut_on, \"bindirme\", ustte=ut_on)\n52\tut.kose(ut_sag, ut_arka, \"acik\")                                 # gizli arka köşeler: açık + kare relief\n53\tut.kose(ut_arka, ut_sol, \"acik\")\n54\tut_on.kivir(1, tip=\"kapali\", yon=-1, ad=\"onluk_kivirma\")       # önlük alt kenarı içe kapalı kıvırma (gıda dışı)\n55\t\n56\t\n57\t# ------------------------------------------------------------------ 2 · YANLAR (kendinden taşıyıcı)\n58\tdef yan(taraf):\n59\t    s = sac(\"yan_\" + taraf, \"dis\"); t, g = s.t, g_(s)\n60\t    xs = t1 + GM                                                  # dış yüz: üst tablanın yan flanşının içinde\n61\t    u0, u1 = Y_B, H - t1 - g\n62\t    if taraf == \"sol\":\n63\t        P = s.taban([(u0, -D + g), (u1, -D + g), (u1, Z_CER - g), (u0, Z_CER - g)], O=(xs, 0, 0), ex=(0, 1, 0), ey=(0, 0, 1), ad=\"yan\")\n64\t        k_arka, k_on, kisa_ad = 0, 2, \"son\"\n65\t    else:\n66\t        P = s.taban([(u0, -Z_CER + g), (u1, -Z_CER + g), (u1, D - g), (u0, D - g)], O=(W - xs, 0, 0), ex=(0, 1, 0), ey=(0, 0, -1), ad=\"yan\")\n67\t        k_arka, k_on, kisa_ad = 2, 0, \"bas\"\n68\t    kisa = u1 - (H - 25.0 - 2.0)                                  # arka flanş üst tablanın arka flanşının 2 mm altında biter → relief\n69\t    arka = P.flans(k_arka, 30, yon=+1, ad=\"arka_flans\", **{kisa_ad: kisa})\n70\t    ust = P.flans(1, 25, yon=+1, ad=\"ust_flans\")\n71\t    on = P.flans(k_on, 40, yon=+1, ad=\"on_flans\")\n72\t    s.kose(ust, on, \"acik\")\n73\t    donus = on.flans(1, 12, yon=+1, ad=\"on_donus\")\n74\t    return s, dict(yan=P, arka=arka, ust=ust, on=on, donus=donus, xs=xs, xi=xs + t)\n75\t\n76\t\n77\tys, YS = yan(\"sol\")\n78\tysg, YSG = yan(\"sag\")\n79\tt_yan = ys.t\n80\t\n81\t# ------------------------------------------------------------------ 3 · SIRT (yan arka flanşlarının önünde) + lazer yarık\n82\tsr = sac(\"sirt\", \"dis\"); ts, gs = sr.t, g_(sr)\n83\tZ_SIRT_ARKA = -D + t_yan; Z_SIRT_ON = Z_SIRT_ARKA + ts\n84\tx0s = YS[\"xs\"] + g_(ys) + GM; x1s = W - x0s                      # yan arka bükümünün dışında\n85\ty1s = H - t1 - t_yan - GM                                         # yan üst flanşının altında\n86\tP_sr = sr.taban([(x0s + gs, Y_B), (x1s - gs, Y_B), (x1s - gs, y1s - gs), (x0s + gs, y1s - gs)], O=(0, 0, Z_SIRT_ARKA), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"sirt\")\n87\tkisa_s = (Y_B + 40.0 + 2.0) - Y_B                                 # yan flanşlar taban arka flanşının üstünden başlar → relief\n88\tsr_sag = P_sr.flans(1, 20, yon=+1, bas=kisa_s, ad=\"sag_flans\")\n89\tsr_ust = P_sr.flans(2, 20, yon=+1, ad=\"ust_flans\")\n90\tsr_sol = P_sr.flans(3, 20, yon=+1, son=kisa_s, ad=\"sol_flans\")\n91\tsr.kose(sr_sag, sr_ust, \"acik\"); sr.kose(sr_ust, sr_sol, \"acik\")\n92\tyariklar = P_sr.lazer_yarik_dizisi(W / 2.0, 950.0, 3, 4, aci=0.0)\n93\t\n94\t# su kırıcı perde (yarıkların 12 mm önünde, üst flanşı sırta puntalı)\n95\tpd = sac(\"su_kirici_perde\", \"ic\"); tp_, gp_ = pd.t, g_(pd)\n96\tP_pd = pd.taban([(0, 0), (280, 0), (280, 70 - gp_), (0, 70 - gp_)], O=(160, 915, Z_SIRT_ON + 12.0), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"perde\")\n97\tpd_ust = P_pd.flans(2, 12.0 + tp_, yon=-1, ad=\"ust_flans\")\n98\tpd.punta(sr, [(x, 985.0 - tp_ / 2.0, Z_SIRT_ON) for x in (200.0, 300.0, 400.0)], not_=\"perde üst flanşı → sırt iç yüzü\")\n99\t\n100\t# ------------------------------------------------------------------ 4 · TABAN TAVASI (köşeler kaynaklı)\n101\ttb = sac(\"taban\", \"yuk\"); tt, gb = tb.t, g_(tb)\n102\tx0b, x1b = YS[\"xi\"] + GM, W - YS[\"xi\"] - GM\n103\tz_on_b = Z_CER - 12.0 - GM                                        # yan dönüş ucunun arkası\n104\tP_tb = tb.taban([(x0b + gb, -z_on_b + gb), (x1b - gb, -z_on_b + gb), (x1b - gb, -Z_SIRT_ON - gb), (x0b + gb, -Z_SIRT_ON - gb)],\n105\t                O=(0, Y_B, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"taban\")\n106\ttb_on = P_tb.flans(0, 40, yon=+1, ad=\"on_flans\"); tb_sag = P_tb.flans(1, 40, yon=+1, ad=\"sag_flans\")\n107\ttb_arka = P_tb.flans(2, 40, yon=+1, ad=\"arka_flans\"); tb_sol = P_tb.flans(3, 40, yon=+1, ad=\"sol_flans\")\n108\ttb.kose(tb_on, tb_sag, \"bindirme\", ustte=tb_on); tb.kose(tb_sag, tb_arka, \"bindirme\", ustte=tb_arka)\n109\ttb.kose(tb_arka, tb_sol, \"bindirme\", ustte=tb_arka); tb.kose(tb_sol, tb_on, \"bindirme\", ustte=tb_on)\n110\t\n111\t# ------------------------------------------------------------------ 5 · RAF (yanlara saplama, sırta dil-yuva)\n112\trf = sac(\"raf\", \"yuk\"); tr, gr = rf.t, g_(rf)\n113\tY_RAF = 600.0; z_raf_on = -100.0; z_raf_arka = Z_SIRT_ON + GM\n114\tP_rf = rf.taban([(x0b + gr, -z_raf_on + gr), (x1b - gr, -z_raf_on + gr), (x1b - gr, -z_raf_arka), (x0b + gr, -z_raf_arka)],\n115\t                O=(0, Y_RAF - tr, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"raf\")\n116\trf_on = P_rf.flans(0, 30, yon=-1, ad=\"on_flans\")\n117\trf_sag = P_rf.flans(1, 25, yon=-1, son=20.0, ad=\"sag_flans\")    # arkada sırt yan flanşlarına yer → relief\n118\trf_sol = P_rf.flans(3, 25, yon=-1, bas=20.0, ad=\"sol_flans\")\n119\trf.kose(rf_on, rf_sag, \"acik\"); rf.kose(rf_sol, rf_on, \"acik\")\n120\tv_c0, v_c1 = -(Z_SIRT_ARKA + 20.0) - GM, -z_raf_arka + 1.0       # sırt yan flanşı için arka köşe çentikleri\n121\tfor xa, xb in ((x0s - GM - 2.0, x0s + ts + GM), (x1s - ts - GM, x1s + GM + 2.0)):\n122\t    P_rf.dikdortgen((xa + xb) / 2.0, (v_c0 + v_c1) / 2.0, xb - xa, v_c1 - v_c0, tip=\"centik\", dfm=False)\n123\tu_arka = x1b - gr\n124\tDIL = [S.dil_yuva(P_rf, 2, u_arka - (xc + 10.0), 20.0, P_sr) for xc in (150.0, 450.0)]\n125\t\n126\t# ------------------------------------------------------------------ 6 · KAPAK (çift cidarlı: dış tava + gömme J kulp · iç tava)\n127\tkd = sac(\"kapak_dis_tava\", \"kapak_dis\"); tk, gk = kd.t, g_(kd)\n128\txk0, xk1 = YS[\"xs\"], W - YS[\"xs\"]; yk0, yk1 = Y_B, Y_KAPAK_UST\n129\tCEP = 30.0\n130\ty_e = yk1 - 2 * tk - kd.R - CEP                                   # ön yüzün üst kenarı (kulp cebinin altı)\n131\tP_kd = kd.taban([(xk0 + gk, yk0 + gk), (xk1 - gk, yk0 + gk), (xk1 - gk, y_e), (xk0 + gk, y_e)], O=(0, 0, -tk), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"on_yuz\")\n132\tkd_alt = P_kd.flans(0, KAPAK_D, yon=-1, ad=\"alt_flans\"); kd_sag = P_kd.flans(1, KAPAK_D, yon=-1, ad=\"sag_flans\")\n133\tkd_k1 = P_kd.flans(2, KAPAK_D, yon=-1, ad=\"kulp_taban\"); kd_sol = P_kd.flans(3, KAPAK_D, yon=-1, ad=\"sol_flans\")\n134\tkd.kose(kd_alt, kd_sag, \"bindirme\", ustte=kd_alt); kd.kose(kd_sag, kd_k1, \"bindirme\", ustte=kd_k1)\n135\tkd.kose(kd_k1, kd_sol, \"bindirme\", ustte=kd_k1); kd.kose(kd_sol, kd_alt, \"bindirme\", ustte=kd_alt)\n136\tkd_k2 = kd_k1.flans(1, yk1 - y_e - kd.R, yon=+1, ad=\"kulp_arka\")\n137\tkd_k3 = kd_k2.flans(1, KAPAK_D, yon=+1, ad=\"kulp_ust\")\n138\tkd_k4 = kd_k3.flans(1, 12.0, yon=+1, ad=\"kulp_dudak\")\n139\t\n140\tki = sac(\"kapak_ic_tava\", \"kapak_ic\"); ti, gi = ki.t, g_(ki)\n141\txi0, xi1 = xk0 + tk + KP[\"ic_dis_bosluk\"], xk1 - tk - KP[\"ic_dis_bosluk\"]\n142\tyi0, yi1 = yk0 + tk + KP[\"ic_dis_bosluk\"], y_e + kd.R - KP[\"ic_dis_bosluk\"]\n143\tP_ki = ki.taban([(xi0 + gi, yi0 + gi), (xi1 - gi, yi0 + gi), (xi1 - gi, yi1 - gi), (xi0 + gi, yi1 - gi)], O=(0, 0, -KAPAK_D), ex=(1, 0, 0), ey=(0, 1, 0), ad=\"ic_tava\")\n144\tki_f = [P_ki.flans(i, KP[\"ic_donus\"], yon=+1, ad=a) for i, a in enumerate((\"alt_flans\", \"sag_flans\", \"ust_flans\", \"sol_flans\"))]\n145\tfor i in range(4): ki.kose(ki_f[i], ki_f[(i + 1) % 4], \"acik\")\n146\tzp = -KAPAK_D + KP[\"ic_donus\"] / 2.0\n147\tki.punta(kd, [(x, yi0 - KP[\"ic_dis_bosluk\"] / 2.0, zp) for x in (150, 300, 450)] + [(x, yi1 + 0.0, zp) for x in (150, 300, 450)]\n148\t         + [(xi0 - KP[\"ic_dis_bosluk\"] / 2.0, y, zp) for y in (300, 575, 850)] + [(xi1 + KP[\"ic_dis_bosluk\"] / 2.0, y, zp) for y in (300, 575, 850)],\n149\t         not_=\"iç tava dönüşleri → dış tava dönüşleri (0,5 boşluk elektrotla kapanır)\")\n150\t\n151\t# gizli menteşeler (sol) — kapak cebi iç tavada, kol yan ön flanşındaki yarıktan geçer, plaka yan iç yüzünde 2 × FHP-M5\n152\tMENTESE = []\n153\tfor i, yh in enumerate((260.0, 900.0)):\n154\t    M = S._M(np.column_stack([[1, 0, 0], [0, -1, 0], [0, 0, -1]]), (xk0, yh, -KAPAK_D))\n155\t    xm = 20.0; x_yan = YS[\"xi\"] - xk0\n156\t    MENTESE.append(S.gizli_mentese(M, xm, x_yan, 20.0, (20.0, 90.0), plaka_delik=[(25.0, 70.0, 5.5), (-25.0, 70.0, 5.5)], ad=\"gizli_mentese_%d\" % (i + 1), birim=BIRIM))\n157\t    P_ki.dikdortgen(xk0 + xm, yh, 17.0, 51.0, tip=\"mentese_cebi\")\n158\t    on = YS[\"on\"]; q = on.yerel((xk0 + xm, yh, Z_CER - t_yan / 2.0))\n159\t    on.dikdortgen(q[0], q[1], 16.0, 44.0, r=2.0, tip=\"mentese_yarigi\")\n160\t    for dy in (25.0, -25.0):\n161\t        BIRLESIM.append(S.saplama_baglantisi(YS[\"yan\"], (YS[\"xs\"], yh - dy, -KAPAK_D - 70.0), (1, 0, 0), 3.0, ad=\"mentese%d_saplama_%+d\" % (i + 1, int(dy)), birim=BIRIM))\n162\t\n163\t# ------------------------------------------------------------------ 7 · AYAKLAR (3 mm plaka + kaynaklı kör burç + ayarlı ayak)\n164\tAYAK = []\n165\tfor i, (x, z) in enumerate(((50.0, -80.0), (550.0, -80.0), (50.0, -780.0), (550.0, -780.0))):\n166\t    pl = sac(\"ayak_plakasi_%d\" % (i + 1), \"braket\"); tpl = pl.t\n167\t    pl.taban([(x - 40, -z - 40), (x + 40, -z - 40), (x + 40, -z + 40), (x - 40, -z + 40)], O=(0, Y_B - tpl, 0), ex=(1, 0, 0), ey=(0, 0, -1), ad=\"plaka\")\n168\t    yb = Y_B - tpl\n169\t    bu = S.kor_burc(\"M12\", (x, yb, z), (0, -1, 0), ad=\"ayak_burcu_%d\" % (i + 1), birim=BIRIM)\n170\t    AYAK.append(bu)\n171\t    AYAK.append(S.kaynak_halka((x, yb, z), (0, -1, 0), bu[\"meta\"][\"D\"] / 2.0, 3.0, ad=\"burc_kaynagi_%d\" % (i + 1), birim=BIRIM))\n172\t    for j, (p0, p1, u1) in enumerate((((x - 40, Y_B, z - 40), (x - 40, Y_B, z + 40), (-1, 0, 0)), ((x + 40, Y_B, z - 40), (x + 40, Y_B, z + 40), (1, 0, 0)),\n173\t                                      ((x - 40, Y_B, z - 40), (x + 40, Y_B, z - 40), (0, 0, -1)), ((x - 40, Y_B, z + 40), (x + 40, Y_B, z + 40), (0, 0, 1)))):\n174\t        AYAK.append(S.kaynak_dikisi(p0, p1, u1, (0, -1, 0), tpl, ad=\"plaka_kaynagi_%d_%d\" % (i + 1, j + 1), birim=BIRIM, taraf=\"dis (köşe)\"))\n175\t    AYAK += S.ayarli_ayak(\"M12\", (x, 0.0, z), (0, 1, 0), yb - bu[\"meta\"][\"H\"], ad=\"ayarli_ayak_%d\" % (i + 1), birim=BIRIM)\n176\t\n177\t# ------------------------------------------------------------------ 8 · BİRLEŞİMLER\n178\tfor zz in (-100.0, -415.0, -730.0):                               # üst tabla yan flanşı (FHP flush dışta) → yan\n179\t    BIRLESIM.append(S.vidali_birlesim(ut_sol, YS[\"yan\"], (1.0, H - 14.0, zz), \"pem_saplama\", ad=\"ust_sol_%d\" % -zz, birim=BIRIM))\n180\t    BIRLESIM.append(S.vidali_birlesim(ut_sag, YSG[\"yan\"], (W - 1.0, H - 14.0, zz), \"pem_saplama\", ad=\"ust_sag_%d\" % -zz, birim=BIRIM))\n181\tfor zz in (-150.0, -430.0, -710.0):                               # yan (FHP flush dışta) → taban yan flanşı\n182\t    BIRLESIM.append(S.vidali_birlesim(YS[\"yan\"], tb_sol, (YS[\"xs\"], Y_B + 22.0, zz), \"pem_saplama\", ad=\"taban_sol_%d\" % -zz, birim=BIRIM))\n183\t    BIRLESIM.append(S.vidali_birlesim(YSG[\"yan\"], tb_sag, (W - YS[\"xs\"], Y_B + 22.0, zz), \"pem_saplama\", ad=\"taban_sag_%d\" % -zz, birim=BIRIM))\n184\tfor zz in (-250.0, -650.0):                                       # yan → raf yan flanşı\n185\t    BIRLESIM.append(S.vidali_birlesim(YS[\"yan\"], rf_sol, (YS[\"xs\"], Y_RAF - 15.0, zz), \"pem_saplama\", ad=\"raf_sol_%d\" % -zz, birim=BIRIM))\n186\t    BIRLESIM.append(S.vidali_birlesim(YSG[\"yan\"], rf_sag, (W - YS[\"xs\"], Y_RAF - 15.0, zz), \"pem_saplama\", ad=\"raf_sag_%d\" % -zz, birim=BIRIM))\n187\tfor yy in (300.0, 650.0, 950.0):                                  # yan arka flanşı (arkadan ISO 7380) → sırt (PEM SP somun)\n188\t    BIRLESIM.append(S.vidali_birlesim(YS[\"arka\"], P_sr, (20.0, yy, -D + 0.5), \"pem_somun\", ad=\"sirt_sol_%d\" % yy, birim=BIRIM))\n189\t    BIRLESIM.append(S.vidali_birlesim(YSG[\"arka\"], P_sr, (W - 20.0, yy, -D + 0.5), \"pem_somun\", ad=\"sirt_sag_%d\" % yy, birim=BIRIM))\n190\tfor xx in (200.0, 400.0):                                         # sırt + taban arka flanşı birlikte: perçin somun M5\n191\t    BIRLESIM.append(S.vidali_birlesim(P_sr, tb_arka, (xx, Y_B + 25.0, Z_SIRT_ARKA), \"percin_somun\", ad=\"sirt_taban_%d\" % xx, birim=BIRIM))\n192\tlog(\"kuruldu: %d sac · %d birleşim · %d menteşe · %d ayak/kaynak parçası\" % (len(SACLAR), len(BIRLESIM), len(MENTESE), len(AYAK)))\n193\t\n194\t# ------------------------------------------------------------------ 9 · DENETİM\n195\tRAPOR = dict(surum=\"ornek_dolap_v1 · \" + S.SURUM, olcu=[W, D, H], standart=S.STD.ozet(), parcalar={}, birlesimler=[], dil_yuva=DIL)\n196\tos.makedirs(os.path.join(BUR, \"ornek_dolap_v1_acinim\"), exist_ok=True)\n197\ttoplam_hata = 0\n198\tfor s in SACLAR:\n199\t    r = s.dogrula(); d = s.dfm(abkant=True); a = s.acinim()\n200\t    with open(os.path.join(BUR, \"ornek_dolap_v1_acinim\", s.ad + \".json\"), \"w\", encoding=\"utf-8\") as f:\n201\t        json.dump(a, f, ensure_ascii=False, indent=1)\n202\t    h = [m for m in d if m[\"durum\"] == \"HATA\"]; u = [m for m in d if m[\"durum\"] == \"UYARI\"]; toplam_hata += len(h)\n203\t    ab = [m for m in d if m[\"kural\"] == \"abkant\"]\n204\t    RAPOR[\"parcalar\"][s.ad] = dict(t=s.t, R=s.R, K=s.K, rol=s.rol, bukum=len(s.bukumler), levha=a[\"levha\"], delik=len(a[\"ic_konturlar\"]),\n205\t                                   dogrulama={k: v for k, v in r.items() if k not in (\"kalinlik\",)}, kalinlik={k: v for k, v in r[\"kalinlik\"].items()},\n206\t                                   dfm=d, punta=s.puntalar)\n207\t    log(\"%-16s t%.1f R%.2f K%.2f · %d büküm · açınım %.0f×%.0f · ΔV(açınımdan) %%%s sim %%%s · kalınlık %s (%d ana/%d kenar) · kesit %s · DFM %d HATA %d UYARI%s\"\n208\t        % (s.ad, s.t, s.R, s.K, len(s.bukumler), a[\"levha\"][\"boy\"], a[\"levha\"][\"en\"], r.get(\"hacim_farki_yuzde\"), r.get(\"simetrik_fark_yuzde\"),\n209\t           r[\"kalinlik\"][\"gecti\"], r[\"kalinlik\"][\"ana\"], r[\"kalinlik\"][\"kenar\"], r.get(\"kesit_gecti\"), len(h), len(u),\n210\t           (\" · abkant sıra %s\" % ab[0].get(\"sira\")) if ab else \"\"))\n211\t    for m in h + u: print(\"        %s %-16s %s\" % (m[\"durum\"], m[\"kural\"], m[\"detay\"][:230]))\n212\t\n213\tPARCALAR = [p for s in SACLAR for p in s.parcalar()] + MENTESE + AYAK + [x for b in BIRLESIM for x in b[\"parcalar\"]]\n214\tfor b in BIRLESIM:\n215\t    RAPOR[\"birlesimler\"].append({k: v for k, v in b.items() if k != \"parcalar\"} | dict(elemanlar=[x[\"ad\"] for x in b[\"parcalar\"]]))\n216\tlog(\"çakışma denetimi: %d parça\" % len(PARCALAR))\n217\tcak, izin = S.cakisma_denetle(PARCALAR)\n218\tRAPOR[\"cakisma\"] = dict(cakisan=cak, izinli=izin)\n219\tlog(\"çakışma %d · izinli (PEM gömme başı) %d%s\" % (len(cak), len(izin), (\" → \" + str(cak[:8])) if cak else \"\"))\n220\t\n221\t# kesitler: büküm yarıçapları kesitte görünüyor mu (y = 500 yatay, x = 300 düşey)\n222\timport _ciz\n223\tKES = {}\n224\tfor ad_, nokta, nrm, eks in ((\"yatay_y500\", (0, 500.0, 0), (0, 1, 0), (0, 2)), (\"duşey_x300\", (300.0, 0, 0), (1, 0, 0), (2, 1))):\n225\t    kk, yar = [], {}\n226\t    for s in SACLAR:\n227\t        sh = s.kati(); bb = sh.BoundingBox()\n228\t        if not (bb.ymin - 1 < nokta[1] < bb.ymax + 1 if nrm[1] else bb.xmin - 1 < nokta[0] < bb.xmax + 1): continue\n229\t        kn = S.kesit_kenarlari(sh, nokta, nrm); kk.append((s.ad, kn))\n230\t        rr = sorted(set(round(r_, 3) for r_ in S.kesit_yaricaplari(sh, nokta, nrm)))\n231\t        if rr: yar[s.ad] = rr\n232\t    KES[ad_] = yar\n233\t    if nrm[1]:\n234\t        _ciz.ciz_kesit(kk, os.path.join(BUR, \"ornek_dolap_v1_kesit_yatay.png\"), eksenler=(0, 2), baslik=\"y = 500 yatay kesit (kırmızı = büküm yayı)\")\n235\t        _ciz.ciz_kesit(kk, os.path.join(BUR, \"ornek_dolap_v1_kesit_yatay_on_sol.png\"), eksenler=(0, 2), baslik=\"y = 500 · ön sol köşe\", sinir=((-2, 50), (-50, 2)))\n236\t    else:\n237\t        _ciz.ciz_kesit(kk, os.path.join(BUR, \"ornek_dolap_v1_kesit_dusey.png\"), eksenler=(2, 1), baslik=\"x = 300 düşey kesit\")\n238\t        _ciz.ciz_kesit(kk, os.path.join(BUR, \"ornek_dolap_v1_kesit_dusey_on_ust.png\"), eksenler=(2, 1), baslik=\"x = 300 · ön üst (önlük + kıvırma + J kulp)\",\n239\t                       sinir=((-45, 3), (985, 1077)))\n240\tRAPOR[\"kesit_yaricaplari\"] = KES\n241\tlog(\"kesit yarıçapları: %s\" % json.dumps(KES, ensure_ascii=False))\n242\t\n243\t# BOM + GLB\n244\tBOM = S.bom_topla(PARCALAR); RAPOR[\"bom\"] = BOM\n245\tsay = lambda tur: sum(1 for p in PARCALAR if p.get(\"tur\") == tur)\n246\tRAPOR[\"ozet\"] = dict(sac=len(SACLAR), kaynak_dikisi=say(\"kaynak\"), baglanti_elemani=say(\"baglanti\"), toplam_parca=len(PARCALAR),\n247\t                     punta=sum(len(p[\"noktalar\"]) for s in SACLAR for p in s.puntalar), dfm_hata=toplam_hata, cakisma=len(cak))\n248\tg = S.glb_yaz(os.path.join(BUR, \"ornek_dolap_v1.glb\"), PARCALAR)\n249\twith open(os.path.join(BUR, \"ornek_dolap_v1_rapor.json\"), \"w\", encoding=\"utf-8\") as f:\n250\t    json.dump(RAPOR, f, ensure_ascii=False, indent=1, default=str)\n251\t_ciz.ciz(PARCALAR, os.path.join(BUR, \"ornek_dolap_v1_gorunum.png\"), elev=20, azim=-55, tol=0.8, baslik=\"ornek_dolap_v1\")\n252\tlog(\"GLB %s (%d düğüm, %.0f kB) · özet %s\" % (os.path.basename(g[\"yol\"]), g[\"dugum\"], g[\"bayt\"] / 1024.0, RAPOR[\"ozet\"]))\n253\tfor b in BOM: print(\"   BOM %3d × %-95s %-34s %s\" % (b[\"adet\"], b[\"tanim\"][:95], b[\"olcu\"][:34], b[\"standart\"]))\n254\tsys.stdout.flush(); os._exit(0)\n255\t"}]},"uuid":"0ff116a4-b93b-4b39-9c44-2611bf0c7758","timestamp":"2026-10-01T22:49:07.061Z","sourceToolAssistantUUID":"71f415fd-e281-4908-94d5-20ccd9f034cb","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
