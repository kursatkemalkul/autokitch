{"parentUuid":"86d7390b-6c7d-4005-a2be-f096512878bc","isSidechain":true,"agentId":"a25b9854cf7bf8eac","message":{"model":"claude-opus-5-5","id":"msg_011CfcLKLTzdJcynWzXG3zmE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01G2HYKJUSj9TX4Me3L2Mpik","name":"Read","input":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\b3\\arastirma\\_uretec\\h3\\h3_kapak_v1.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14032,"cache_read_input_tokens":236357,"output_tokens":394,"output_tokens_details":{"thinking_tokens":231},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":14032},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":394,"cache_read_input_tokens":236357,"cache_creation_input_tokens":14032,"cache_creation":{"ephemeral_5m_input_tokens":14032,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01G2HYKJUSj9TX4Me3L2Mpik":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\b3\\arastirma\\_uretec\\h3\\h3_kapak_v1.py"}},"apiBlockIndex":1,"requestId":"req_011CfcLKL5gaR7vKi21E8Lrp","attributionAgent":"general-purpose","type":"assistant","uuid":"29a08bab-9fd1-4c91-b2f7-d19603bc9fd8","timestamp":"2026-10-01T22:49:37.490Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
{"parentUuid":"29a08bab-9fd1-4c91-b2f7-d19603bc9fd8","isSidechain":true,"promptId":"6d13b065-9608-42c4-83ca-508fc3c4db72","agentId":"a25b9854cf7bf8eac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G2HYKJUSj9TX4Me3L2Mpik","type":"tool_result","content":"1\t# -*- coding: utf-8 -*-\n2\t\"\"\"HAT v3.7 · ÖN YÜZ KAPAK SADELEŞTİRMESİ (TASLAK · 1 Eki 2026 · Claude · YEREL) — Kemal çizimi (images/47.webp):\n3\t\"kapakları benim çizdiğim şekilde yeniden oluştur, daha temiz daha simple; çizgiler birbirini takip etsin; fazla bölmeye gerek yok\".\n4\t\n5\tMontaj (hat3_montaj_v7) her modülün PARCALAR listesini kurduktan SONRA, birime ayırmadan / _dis_birim'den ÖNCE bu modülü çağırır.\n6\tBütün şekiller DÜNYA koordinatında (x hat boyunca · y yukarı, zemin 0 · z koridora, ön düzlem +79). İstisnalar fonksiyonlarda yazılı (TU: x − X_BC).\n7\t\n8\tYENİ KAPAK DÜZENİ (yatay çizgiler: 788 her yerde · 1305 yalnız fırın üstü · 455 sağ alt; dikey çizgiler: istasyon sınırları + 1967,5 + 3250 + E_DERZ):\n9\t  A        tek kapak      736–1434,5 × 788–2197  (A alt panel + servis kapağı + U_A kapağı birleşti) · robot ağzı PENCERE 986–1186 × 960–1160\n10\t  TOPPING  2 kapak        1438–1966 / 1969–2497 × 788–2197 (mekanizma kanadı + K1/K2 soğuk kapak TEK KANAT; üst kısım PU sandviç, alt kısım tava)\n11\t  F üstü   2 düşer kapak  2500–3248 / 3252–4000 × 1308–2197 (F üstü kapak + U_F kapağı birleşti; menteşe/gazlı yay altta aynı yerde)\n12\t  K        tek kapak      4003–4398 × 788–2197  (K alt/orta/üst + U_KE sol birleşti)\n13\t  E        4 kapak        4402–E_DERZ0 / E_DERZ1–5230 × (126–785 | 788–2197) · robot ağzı sol üst kapakta PENCERE · robot çöpü klapesi sol alt kapakta\n14\t  B sağ    teknik sütun soğutma paneli 126–454 / depo kapağı 456–785 (K6 içecek çekmece derzi 454/456 ile TEK ÇİZGİ · çekmeceler DEĞİŞMEZ)\n15\t\"\"\"\n16\timport re\n17\timport cadquery as cq\n18\t\n19\tZ_ON, T, T_IC, KENAR, DERZ = 79.0, 1.5, 1.0, 20.0, 3.0\n20\tY_DUZ, Y_TAVAN_KAPAK = 788.0, 2197.0\n21\tB_UST = 785.0                                    # B çekmece önleri üstü (dolap) → 788 derzi\n22\t# ---- KARARLAR (Kemal'e sorulacaklar · varsayılan = önerilen) ----\n23\tKARAR = dict(\n24\t    E_DERZ=(4860.0, 4863.0),                      # E dikey derz: ağzın sağ kenarı 4840 + 20 çerçeve → ağız kapalı PENCERE (Kemal çizgisi ~4858–4870 ölçüldü)\n25\t    KE_1862_KALKAR=True,                          # K + E: U_KE kapağıyla birleşme (çizimdeki tepe X'i) · False → 1862 çizgisi kalır, U_KE ikiye bölünür (4861,5)\n26\t    F_KAPAK=\"duser\",                              # \"duser\" (alttan menteşeli, mevcut tip) · \"yan\" (dikey eksen) → TOPPING sağ ve K kapaklarıyla köşede çarpışır, önerilmez\n27\t    B_SAG_CIZGI=455.0,                            # teknik sütun derzi 447 → 455 (K6 çekmece derzi); çekmece yükseklikleri DEĞİŞMEZ\n28\t)\n29\tA_X, A_PEN = (736.0, 1434.5), (986.0, 1186.0, 960.0, 1160.0)\n30\tK_X = (4003.0, 4398.0)\n31\tE_X = (4402.0, 5230.0)\n32\tE_AGIZ = (4485.0, 4840.0, 886.0, 1062.0)        # kutu_cad_v14 AGIZ (85–440 yerel) dünya\n33\tE_KLAPE = (4464.0, 4594.0, 610.0, 740.0)        # h3_kutu_v1 KLAPE (dünya)\n34\t\n35\t\n36\tdef kutu(x0, x1, y0, y1, z0, z1):\n37\t    return cq.Solid.makeBox(x1 - x0, y1 - y0, z1 - z0, cq.Vector(x0, y0, z0))\n38\t\n39\t\n40\tdef _bir(*s):\n41\t    r = s[0]\n42\t    for q in s[1:]:\n43\t        r = r.fuse(q)\n44\t    return r.clean()\n45\t\n46\t\n47\tdef tava(x0, x1, y0, y1, kenar=KENAR, pencereler=(), acik_kenar=(), ic_sac=False):\n48\t    \"\"\"304 1,5 tava kapak: ön yüz (z 77,5–79) + 4 kenar dönüşü (derinlik kenar) · pencere = (x0, x1, y0, y1) kesik + 4 iç dönüş ·\n49\t    acik_kenar ⊂ {'alt','ust','sol','sag'} dönüşsüz (birleşme kenarı) · ic_sac = KUTU KESİT kapatma sacı 1,0 (E alt kanatları gibi)\"\"\"\n50\t    z1, z0 = Z_ON, Z_ON - kenar\n51\t    p = [kutu(x0, x1, y0, y1, z1 - T, z1)]\n52\t    if \"alt\" not in acik_kenar: p.append(kutu(x0, x1, y0, y0 + T, z0, z1 - T))\n53\t    if \"ust\" not in acik_kenar: p.append(kutu(x0, x1, y1 - T, y1, z0, z1 - T))\n54\t    if \"sol\" not in acik_kenar: p.append(kutu(x0, x0 + T, y0, y1, z0, z1 - T))\n55\t    if \"sag\" not in acik_kenar: p.append(kutu(x1 - T, x1, y0, y1, z0, z1 - T))\n56\t    if ic_sac: p.append(kutu(x0 + T, x1 - T, y0 + T, y1 - T, z0, z0 + T_IC))\n57\t    s = _bir(*p)\n58\t    for (a0, a1, b0, b1) in pencereler:\n59\t        s = s.cut(kutu(a0, a1, b0, b1, z0 - 1.0, z1 + 1.0))\n60\t        s = _bir(s, kutu(a0 - T, a0, b0, b1, z0, z1 - T), kutu(a1, a1 + T, b0, b1, z0, z1 - T),\n61\t                 kutu(a0 - T, a1 + T, b0 - T, b0, z0, z1 - T), kutu(a0 - T, a1 + T, b1, b1 + T, z0, z1 - T))\n62\t    return s\n63\t\n64\t\n65\tdef omega(x0, x1, y0, h=40.0):\n66\t    \"\"\"omega takviye 1,0 (mevcut omegalarla aynı zarf z 62–78 · yükseklik 40): taban kanatları + gövde\"\"\"\n67\t    return _bir(kutu(x0, x1, y0, y0 + 8.0, Z_ON - T - T_IC, Z_ON - T), kutu(x0, x1, y0 + h - 8.0, y0 + h, Z_ON - T - T_IC, Z_ON - T),\n68\t                kutu(x0, x1, y0 + 7.0, y0 + 8.0, 62.0, Z_ON - T), kutu(x0, x1, y0 + h - 8.0, y0 + h - 7.0, 62.0, Z_ON - T),\n69\t                kutu(x0, x1, y0 + 7.0, y0 + h - 7.0, 62.0, 63.0))\n70\t\n71\t\n72\t# ---------------------------------------------------------------- liste yardımcıları ----------------------------------------------------------------\n73\tdef sekil(p):\n74\t    w = p[\"wp\"] if \"wp\" in p else p[\"sh\"]\n75\t    return w.val() if hasattr(w, \"val\") else w\n76\t\n77\t\n78\tdef koy(p, s):\n79\t    if \"wp\" in p: p[\"wp\"] = cq.Workplane(obj=s)\n80\t    else: p[\"sh\"] = s\n81\t\n82\t\n83\tdef bul(L, ad):\n84\t    q = [p for p in L if p[\"ad\"] == ad]\n85\t    assert len(q) == 1, (\"v3.7 kapak: parça yok / çift\", ad, len(q))\n86\t    return q[0]\n87\t\n88\t\n89\tdef dus(L, adlar, rapor):\n90\t    adlar = set(adlar)\n91\t    var = set(p[\"ad\"] for p in L)\n92\t    eksik = adlar - var\n93\t    assert not eksik, (\"v3.7 kapak: düşecek parça yok\", sorted(eksik))\n94\t    L[:] = [p for p in L if p[\"ad\"] not in adlar]\n95\t    rapor.extend(sorted(adlar))\n96\t\n97\t\n98\tdef yeni(L, ornek, ad, s, rapor, **kw):\n99\t    assert all(p[\"ad\"] != ad for p in L), ad\n100\t    d = dict(ornek, ad=ad, **kw)\n101\t    d.pop(\"wp\", None); d.pop(\"sh\", None)\n102\t    d[\"wp\" if \"wp\" in ornek else \"sh\"] = cq.Workplane(obj=s) if \"wp\" in ornek else s\n103\t    L.append(d); rapor.append(ad)\n104\t    return d\n105\t\n106\t\n107\tdef tasi(p, dy=0.0, dx=0.0):\n108\t    koy(p, sekil(p).translate(cq.Vector(dx, dy, 0.0)))\n109\t\n110\t\n111\tdef bb_kontrol(p, beklenen, tol=1.0, ad=\"\"):\n112\t    b = sekil(p).BoundingBox(); g = (b.xmin, b.xmax, b.ymin, b.ymax)\n113\t    assert all(abs(u - v) <= tol for u, v in zip(g, beklenen)), (\"v3.7 kapak: koordinat sözleşmesi bozuk (dünya mı?)\", ad or p[\"ad\"], g, beklenen)\n114\t\n115\t\n116\t# ================================================================ BÖLGELER ================================================================\n117\tdef bolge_A(AK_L, rapor):\n118\t    \"\"\"A + U_A → tek kapak (grup SERVIS_KAPAGI: mevcut sol gizli menteşe ekseni x 742,5 · z 72 aynen)\"\"\"\n119\t    eski = bul(AK_L, \"onyuz_servis_kapagi\"); bb_kontrol(eski, (736.0, 1434.5, 1110.5, 1859.0), 1.5)\n120\t    s = tava(A_X[0], A_X[1], Y_DUZ, Y_TAVAN_KAPAK, pencereler=[A_PEN])\n121\t    k = yeni(AK_L, eski, \"onyuz_kapak_A\", s, rapor, grup=\"SERVIS_KAPAGI\",\n122\t             bom=(\"A ön kapağı 304 fırçalı 1,5 tava 20 · %.1f × %.0f · robot ağzı penceresi 200 × 200\" % (A_X[1] - A_X[0], Y_TAVAN_KAPAK - Y_DUZ), 1, \"üretim\",\n123\t                  \"v3.7 · alt panel + servis kapağı + U_A kapağı TEK KAPAK (Kemal çizimi) · 3 gizli menteşe sol · 3 bas-aç sağ\", \"ÜRETİM\"))\n124\t    for i, y0 in enumerate((850.0, 1340.0, 1600.0, 1990.0)):          # ağız 960–1160 ve menteşe/mandal hizaları dışında\n125\t        yeni(AK_L, eski, \"onyuz_kapak_A_omega_%d\" % i, omega(771.0, 1366.0, y0), rapor, grup=\"SERVIS_KAPAGI\")\n126\t    # menteşe: 1240 / 1700 yerinde + 3. menteşe 920 (sol dikme 894'ten başlar)\n127\t    for par in (\"sabit\", \"kanat\", \"pim\"):\n128\t        m0 = bul(AK_L, \"onyuz_servis_kapagi_mentese_0_%s\" % par)\n129\t        yeni(AK_L, m0, \"onyuz_servis_kapagi_mentese_2_%s\" % par, sekil(m0).translate(cq.Vector(0, -320.0, 0)), rapor)\n130\t    # bas-aç: 1460 yerinde + alt (sağ alt dikme 791–894) + üst (U_A sağ yan önünde, eski U_A bas-aç yeri)\n131\t    md = bul(AK_L, \"onyuz_servis_kapagi_basac_mandal\")\n132\t    yeni(AK_L, md, \"onyuz_servis_kapagi_basac_mandal_alt\", sekil(md).translate(cq.Vector(0, 840.0 - 1460.0, 0)), rapor)\n133\t    yeni(AK_L, md, \"onyuz_servis_kapagi_basac_mandal_ust\", sekil(md).translate(cq.Vector(0, 2120.0 - 1460.0, 0)), rapor)\n134\t    dus(AK_L, [\"onyuz_servis_kapagi\", \"onyuz_servis_kapagi_omega_0\", \"onyuz_servis_kapagi_omega_1\",\n135\t               \"onyuz_alt_panel\", \"onyuz_alt_panel_omega\"] + [\"onyuz_alt_panel_tutucu_%d\" % i for i in range(4)] +\n136\t        [\"onyuz_emniyet_hedefi_alt\", \"onyuz_emniyet_sensoru_alt\",               # tek kapak → tek kilit sensörü (1540 RSS 36 kalır)\n137\t         \"onyuz_cerceve_orta_kayit_sol\", \"onyuz_cerceve_orta_kayit_sag\"], rapor)    # yalnız 1107,5/1110,5 derzinin dayamasıydı (opak çizgi bırakırdı)\n138\t    return k\n139\t\n140\t\n141\tdef bolge_A_ust(UD_L, rapor):\n142\t    \"\"\"U_A kapağı + donanımı düşer (A kapağı tavana kadar) · U_A alt/üst kayıt YERİNDE (A ile tek kutu, v3.4)\"\"\"\n143\t    dus(UD_L, [\"onyuz_ust_a_kapak_tek\", \"onyuz_ust_a_kapak_tek_alt_kutusu\", \"onyuz_ust_a_mentese_sabit_tek_0\", \"onyuz_ust_a_mentese_hareketli_tek_0\",\n144\t               \"onyuz_ust_a_mentese_sabit_tek_1\", \"onyuz_ust_a_mentese_hareketli_tek_1\", \"onyuz_ust_a_bas_ac_tek_sol\", \"onyuz_ust_a_bas_ac_tek_sag\",\n145\t               \"onyuz_ust_a_kapak_tek_tipon_plakasi_sol\", \"onyuz_ust_a_kapak_tek_tipon_plakasi_sag\"], rapor)\n146\t\n147\t\n148\tdef bolge_F(FU_L, UD_L, rapor):\n149\t    \"\"\"F üstü + U_F → 2 düşer kapak 1308–2197 (alt menteşe + gazlı yay + burulma kutusu YERİNDE · bas-aç tepeye 2130–2150)\"\"\"\n150\t    for yon, YON in ((\"sol\", \"SOL\"), (\"sag\", \"SAG\")):\n151\t        f, u = bul(FU_L, \"onyuz_f_ust_kapak_\" + yon), bul(UD_L, \"onyuz_ust_f_kapak_\" + yon)\n152\t        bf, bu = sekil(f).BoundingBox(), sekil(u).BoundingBox()\n153\t        dolgu = kutu(bf.xmin, bf.xmax, bf.ymax - 1.0, bu.ymin + 1.0, Z_ON - T, Z_ON)                     # 1859–1862 derzi yüzde kapanır\n154\t        ic_kes = kutu(bf.xmin + T, bf.xmax - T, bf.ymax - T - 0.5, bu.ymin + T + 0.5, Z_ON - KENAR - 1.0, Z_ON - T)   # birleşme kenarlarının iç dönüşleri\n155\t        s = _bir(sekil(f), sekil(u), dolgu).cut(ic_kes)\n156\t        koy(f, s); f[\"bom\"] = ((\"Fırın üstü kapağı %s 304 1,5 tava 20 · %.0f × %.0f (v3.7: U_F kapağıyla tek kanat)\" % (yon, bf.xlen, bu.ymax - bf.ymin)), 1, \"üretim\",\n157\t                              \"v3.7 · alttan menteşeli düşer kapak · gazlı yay YENİDEN HESAP (kütle ≈ 2,4 × moment)\", \"ÜRETİM\")\n158\t        rapor.append(\"onyuz_f_ust_kapak_%s (+U_F birleşti)\" % yon)\n159\t        ku = bul(UD_L, \"onyuz_ust_f_kapak_%s_alt_kutusu\" % yon)                                      # U_F alt burulma kutusu → orta takviye (kanatla döner)\n160\t        yeni(FU_L, f, \"onyuz_f_ust_kapak_%s_orta_kutusu\" % yon, sekil(ku), rapor, grup=\"KAPAK_F_\" + YON)\n161\t        tp = bul(FU_L, \"onyuz_f_ust_kapak_%s_tipon_plakasi\" % yon); tasi(tp, dy=2130.0 - 1810.0)        # karşılık plakası tepeye\n162\t        ba = bul(FU_L, \"onyuz_f_ust_bas_ac_\" + yon); tasi(ba, dy=2130.0 - 1810.0)                       # bas-aç U_F yan sacının önüne (eski U_F bas-aç yeri)\n163\t    dus(UD_L, [\"onyuz_ust_f_kapak_sol\", \"onyuz_ust_f_kapak_sag\", \"onyuz_ust_f_kapak_sol_alt_kutusu\", \"onyuz_ust_f_kapak_sag_alt_kutusu\"] +\n164\t        [\"onyuz_ust_f_mentese_%s_%s_%d\" % (t, y, i) for t in (\"sabit\", \"hareketli\") for y in (\"sol\", \"sag\") for i in (0, 1)] +\n165\t        [\"onyuz_ust_f_bas_ac_sol_sol\", \"onyuz_ust_f_bas_ac_sag_sag\", \"onyuz_ust_f_kapak_sol_tipon_plakasi_sol\", \"onyuz_ust_f_kapak_sag_tipon_plakasi_sag\"], rapor)\n166\t\n167\t\n168\tdef bolge_KE_ust(UD_L, rapor):\n169\t    \"\"\"U_KE kapakları + donanımı düşer (K ve E kapakları tavana kadar) · alt/üst kayıt, raf, kirişler YERİNDE\"\"\"\n170\t    if not KARAR[\"KE_1862_KALKAR\"]:\n171\t        return\n172\t    dus(UD_L, [\"onyuz_ust_ke_kapak_sol\", \"onyuz_ust_ke_kapak_sag\", \"onyuz_ust_ke_kapak_sol_alt_kutusu\", \"onyuz_ust_ke_kapak_sag_alt_kutusu\"] +\n173\t        [\"onyuz_ust_ke_mentese_%s_%s_%d\" % (t, y, i) for t in (\"sabit\", \"hareketli\") for y in (\"sol\", \"sag\") for i in (0, 1)] +\n174\t        [\"onyuz_ust_ke_bas_ac_sol_sol\", \"onyuz_ust_ke_bas_ac_sag_sag\", \"onyuz_ust_ke_kapak_sol_tipon_plakasi_sol\", \"onyuz_ust_ke_kapak_sag_tipon_plakasi_sag\"], rapor)\n175\t\n176\t\n177\tdef bolge_K(KS_L, rapor):\n178\t    \"\"\"K: alt/orta/üst kapak → tek kapak 788–2197 · sol gizli menteşe (EMKA 1046 sınıfı, sanal pivot ön-sol köşe x 4003 · z 79) · v3'te K kapaklarında menteşe YOKTU\"\"\"\n179\t    eski = bul(KS_L, \"onyuz_kapak_orta\"); bb_kontrol(eski, (4003.0, 4398.0, 886.0, 1305.0), 1.5)\n180\t    y1 = Y_TAVAN_KAPAK if KARAR[\"KE_1862_KALKAR\"] else 1859.0\n181\t    yeni(KS_L, eski, \"onyuz_kapak_K\", tava(K_X[0], K_X[1], Y_DUZ, y1, ic_sac=False), rapor,\n182\t         bom=(\"K ön kapağı 304 1,5 tava 20 · 395 × %.0f\" % (y1 - Y_DUZ), 1, \"üretim\", \"v3.7 · tek kapak (Kemal çizimi) · 3 menteşe sol · 3 bas-aç sağ · 2 omega\", \"ÜRETİM\"))\n183\t    for i, y0 in enumerate((1250.0, 1700.0)):\n184\t        yeni(KS_L, eski, \"onyuz_kapak_K_omega_%d\" % i, omega(K_X[0] + 25.0, K_X[1] - 25.0, y0), rapor)\n185\t    for i, y0 in enumerate((900.0, 1360.0, 1750.0)):      # E gizli menteşesiyle aynı zarf 20 × 60 · z 49–78 (K köşe dikmesi z 27–57 ile 8 mm bindirir)\n186\t        yeni(KS_L, eski, \"onyuz_kapak_K_mentese_%d\" % i, kutu(4015.0, 4035.0, y0, y0 + 60.0, 49.0, 78.0), rapor)\n187\t    for i, y0 in enumerate((1000.0, 1700.0, 2138.0)):      # E bas-aç zarfı 20 × 30 · z 39–57 · sağ köşe dikmesi (4365–4395) önünde · üstteki U_KE üst kaydının altına değer\n188\t        yeni(KS_L, eski, \"onyuz_kapak_K_basac_%d\" % i, kutu(4375.0, 4395.0, y0, y0 + 30.0, 39.0, 57.0), rapor)\n189\t    dus(KS_L, [\"onyuz_kapak_alt\", \"onyuz_kapak_orta\", \"onyuz_kapak_ust\"], rapor)\n190\t\n191\t\n192\tdef bolge_E(KC_L, rapor):\n193\t    \"\"\"E: 2 × 2 kapak · yatay derz 785/788 (B çekmece üstüyle tek çizgi) · dikey derz KARAR E_DERZ (boydan boya) · ağız ve klape korunur\"\"\"\n194\t    d0, d1 = KARAR[\"E_DERZ\"]\n195\t    y1 = Y_TAVAN_KAPAK if KARAR[\"KE_1862_KALKAR\"] else 1859.0\n196\t    ls, lr = bul(KC_L, \"onyuz_alt_kanat_sol\"), bul(KC_L, \"onyuz_alt_kanat_sag\")\n197\t    bb_kontrol(ls, (4402.0, 4814.0, 126.0, 883.0), 1.5)\n198\t    # klape cebi (kapağın arkasındaki dönme cebi) eski kanattan AYNEN alınır; dış yüzdeki 130 × 130 açıklık yeniden kesilir\n199\t    cep = sekil(ls).intersect(kutu(E_KLAPE[0] - 25.0, E_KLAPE[1] + 25.0, E_KLAPE[2] - 25.0, E_KLAPE[3] + 25.0, -200.0, Z_ON - T))\n200\t    s_ls = _bir(tava(E_X[0], d0, 126.0, B_UST, ic_sac=True).cut(kutu(E_KLAPE[0], E_KLAPE[1], E_KLAPE[2], E_KLAPE[3], -200.0, Z_ON + 1.0)), cep)\n201\t    yeni(KC_L, ls, \"onyuz_kapak_E_alt_sol\", s_ls, rapor)\n202\t    yeni(KC_L, lr, \"onyuz_kapak_E_alt_sag\", tava(d1, E_X[1], 126.0, B_UST, ic_sac=True), rapor)\n203\t    us = bul(KC_L, \"onyuz_ust_kanat_sol\")\n204\t    yeni(KC_L, us, \"onyuz_kapak_E_ust_sol\", tava(E_X[0], d0, Y_DUZ, y1, pencereler=[E_AGIZ]), rapor)     # robot ağzı = pencere (sağ çerçeve 20)\n205\t    yeni(KC_L, us, \"onyuz_kapak_E_ust_sag\", tava(d1, E_X[1], Y_DUZ, y1), rapor)\n206\t    for i, (x0, x1, y0) in enumerate(((4425.0, d0 - 20.0, 1300.0), (4425.0, d0 - 20.0, 1700.0), (d1 + 20.0, 5205.0, 1300.0), (d1 + 20.0, 5205.0, 1700.0))):\n207\t        yeni(KC_L, us, \"onyuz_kapak_E_ust_omega_%d\" % i, omega(x0, x1, y0), rapor)\n208\t    # yeni orta yatay kayıt (785/788 derzinin dayaması) + orta dikme (dikey derzin dayaması; ağız sağ kenarından 6,5 mm sağda)\n209\t    ko = bul(KC_L, \"onyuz_kayit_orta\"); bko = sekil(ko).BoundingBox()\n210\t    yeni(KC_L, ko, \"onyuz_kayit_788\", sekil(ko).translate(cq.Vector(0, 773.0 - bko.ymin, 0)), rapor)\n211\t    xm = (d0 + d1) / 2.0\n212\t    yeni(KC_L, ko, \"onyuz_dikme_orta\", kutu(xm - 15.0, xm + 15.0, 129.0, 1860.0, bko.zmin, bko.zmax).cut(kutu(xm - 16.0, xm + 16.0, 773.0, 803.0, bko.zmin - 1, bko.zmax + 1)), rapor)\n213\t    # menteşeler: dış kenarlarda (sol x 4422 · sağ 5188) — alt 3 × (300/530/680) · üst 3 × (900/1360/1750)\n214\t    ml, mr = bul(KC_L, \"onyuz_mentese_0\"), bul(KC_L, \"onyuz_mentese_3\")\n215\t    for taraf, m in ((\"sol\", ml), (\"sag\", mr)):\n216\t        bm = sekil(m).BoundingBox()\n217\t        for i, y0 in enumerate((300.0, 530.0, 680.0, 900.0, 1360.0, 1750.0)):\n218\t            yeni(KC_L, m, \"onyuz_kapak_E_mentese_%s_%d\" % (taraf, i), sekil(m).translate(cq.Vector(0, y0 - bm.ymin, 0)), rapor)\n219\t    # bas-aç: orta dikmenin önünde, iki kanat kenarında · alt 1 çift (700) · üst 2 çift (1000 · 1700)\n220\t    b0 = bul(KC_L, \"onyuz_basac_0\"); bb0 = sekil(b0).BoundingBox()\n221\t    for i, y0 in enumerate((700.0, 1000.0, 1700.0)):\n222\t        for taraf, xa in ((\"sol\", d0 - 20.0), (\"sag\", d1)):\n223\t            yeni(KC_L, b0, \"onyuz_kapak_E_basac_%s_%d\" % (taraf, i), sekil(b0).translate(cq.Vector(xa - bb0.xmin, y0 - bb0.ymin, 0)), rapor)\n224\t    dus(KC_L, [\"onyuz_alt_kanat_sol\", \"onyuz_alt_kanat_sag\", \"onyuz_orta_sabit_panel\", \"onyuz_orta_servis_kapagi\", \"onyuz_ust_kanat_sol\", \"onyuz_ust_kanat_sag\",\n225\t               \"onyuz_kayit_orta\", \"onyuz_kayit_ust\"] + [\"onyuz_mentese_%d\" % i for i in range(12)] + [\"onyuz_basac_%d\" % i for i in range(5)], rapor)\n226\t    # NOT: klape levhası / menteşesi / yaprağı (ecop_*) ve oluk kanatla döner — grup/adları DEĞİŞMEZ, yeni kanadın arkasında aynı yerde\n227\t\n228\t\n229\tdef bolge_B_sag(SC_L, rapor):\n230\t    \"\"\"B teknik sütun önü (K'nın altı): soğutma paneli 126–446 → 126–454 · depo kapağı 448–785 → 456–785 (K6 derzi 454/456 ile tek çizgi)\"\"\"\n231\t    y = KARAR[\"B_SAG_CIZGI\"]; dy = (y + 1.0) - 448.0               # 456 − 448 = +8\n232\t    sp = bul(SC_L, \"tk_kapak_sogutma_dis_sac\"); bs = sekil(sp).BoundingBox(); bb_kontrol(sp, (4012.0, 4400.0, 126.0, 446.0), 1.5)\n233\t    s = sekil(sp).cut(kutu(bs.xmin - 1, bs.xmax + 1, bs.ymax - T - 0.2, bs.ymax + 1, bs.zmin - 1, Z_ON - T))      # eski üst dönüş\n234\t    s = _bir(s, kutu(bs.xmin, bs.xmax, bs.ymax - 1.0, y - 1.0, Z_ON - T, Z_ON), kutu(bs.xmin, bs.xmax, y - 1.0 - T, y - 1.0, bs.zmin, Z_ON - T))\n235\t    koy(sp, s); rapor.append(\"tk_kapak_sogutma_dis_sac 126–%.0f\" % (y - 1.0))\n236\t    dp = bul(SC_L, \"tk_kapak_depo_dis_sac_1.5\"); bd = sekil(dp).BoundingBox()\n237\t    s = sekil(dp).cut(kutu(bd.xmin - 1, bd.xmax + 1, bd.ymin - 1, y + 1.0 + T, bd.zmin - 1, bd.zmax + 1))\n238\t    s = _bir(s, kutu(bd.xmin, bd.xmax, y + 1.0, y + 1.0 + T, bd.zmin, Z_ON))                      # yeni alt dönüş + yüz\n239\t    koy(dp, s); rapor.append(\"tk_kapak_depo_dis_sac_1.5 %.0f–785\" % (y + 1.0))\n240\t    pu = bul(SC_L, \"tk_kapak_depo_pu\"); bp = sekil(pu).BoundingBox()\n241\t    koy(pu, sekil(pu).cut(kutu(bp.xmin - 1, bp.xmax + 1, bp.ymin - 1, y + 1.0 + T, bp.zmin - 1, bp.zmax + 1)))\n242\t    tasi(bul(SC_L, \"tk_kapak_depo_fitil\"), dy=dy); tasi(bul(SC_L, \"tk_kapak_depo_ic_sac_1.0\"), dy=dy)   # fitil 449–722 → 457–730 (depo ağzı 468–703 içinde kalır)\n243\t    rapor.append(\"depo fitil + iç sac +%.0f\" % dy)\n244\t\n245\t\n246\tdef bolge_TOPPING(TC_parca, TU_parca, X_BC, tc_ofset, rapor):\n247\t    \"\"\"TOPPING: mekanizma kanadı (TC, yarıklı) + K1/K2 dış sacı (TU) TEK KABUK · TC kabuğu düşer, birleşik kabuk TU parçasına yazılır.\n248\t    TC_parca / TU_parca: {'sol': p, 'sag': p} · tc_ofset(p) → TC yerelinden dünyaya Vector · TU sh = dünya − (X_BC, 0, 0)\"\"\"\n249\t    for yon in (\"sol\", \"sag\"):\n250\t        tc, tu = TC_parca[yon], TU_parca[yon]\n251\t        w_tc = sekil(tc).translate(tc_ofset(tc)); w_tu = sekil(tu).translate(cq.Vector(X_BC, 0, 0))\n252\t        b1, b2 = w_tc.BoundingBox(), w_tu.BoundingBox()\n253\t        assert abs(b1.xmin - b2.xmin) < 1.0 and abs(b1.xmax - b2.xmax) < 1.0 and b1.ymax < b2.ymin < b1.ymax + 4.0, (\"TOPPING kabuk hizası\", b1.__dict__, b2.__dict__)\n254\t        dolgu = kutu(b1.xmin, b1.xmax, b1.ymax - 1.0, b2.ymin + 1.0, Z_ON - T, Z_ON)\n255\t        ic_kes = kutu(b1.xmin + T, b1.xmax - T, b1.ymax - T - 0.5, b2.ymin + T + 0.5, 39.0 - 1.0, Z_ON - T)   # birleşme kenarı iç dönüşleri (40 + 20 derin)\n256\t        s = _bir(w_tc, w_tu, dolgu).cut(ic_kes).translate(cq.Vector(-X_BC, 0, 0))\n257\t        koy(tu, s); rapor.append(\"TU %s: mekanizma kanadı + dış sac TEK KABUK 788–%.0f\" % (tu[\"ad\"], b2.ymax))\n258\t\n259\t\n260\t# ================================================================ AÇILMA TARAMASI (v3.7 yeni denetim) ================================================================\n261\tdef supur(kapak, nokta, yon, isaret, engeller, acilar=range(10, 101, 10), esik=1.0):\n262\t    \"\"\"kapak (dünya katısı) nokta/yon ekseni etrafında isaret·açı döner (dışa = +z) · engeller [(ad, katı)] · dönüş: [(açı, ad, hacim mm³)]\"\"\"\n263\t    bul_ = []\n264\t    for a in acilar:\n265\t        k = kapak.rotate(cq.Vector(*nokta), cq.Vector(*nokta) + cq.Vector(*yon), isaret * a)\n266\t        kb = k.BoundingBox()\n267\t        for ad, e in engeller:\n268\t            eb = e.BoundingBox()\n269\t            if eb.xmin > kb.xmax or eb.xmax < kb.xmin or eb.ymin > kb.ymax or eb.ymax < kb.ymin or eb.zmin > kb.zmax or eb.zmax < kb.zmin:\n270\t                continue\n271\t            v = k.intersect(e).Volume()\n272\t            if v > esik: bul_.append((a, ad, round(v, 1)))\n273\t    return bul_\n274\t\n275\t\n276\tDONANIM = re.compile(r\"mentese|_pim$|basac|bas_ac|mandal|tipon|yay_pimi|gazli_yay|dayama\")   # taramada engel sayılmaz (kapağın kendi donanımı)\n277\t# kapak · eksen noktası · yön · işaret (dışa +z) — sol menteşe: y ekseni −1 · sağ: +1 · düşer kapak: x ekseni +1\n278\tSUPURME = [(\"onyuz_kapak_A\", (742.5, 0.0, 72.0), (0, 1, 0), -1), (\"onyuz_kapak_K\", (4003.0, 0.0, 79.0), (0, 1, 0), -1),\n279\t           (\"onyuz_kapak_E_alt_sol\", (4402.0, 0.0, 79.0), (0, 1, 0), -1), (\"onyuz_kapak_E_ust_sol\", (4402.0, 0.0, 79.0), (0, 1, 0), -1),\n280\t           (\"onyuz_kapak_E_alt_sag\", (5230.0, 0.0, 79.0), (0, 1, 0), 1), (\"onyuz_kapak_E_ust_sag\", (5230.0, 0.0, 79.0), (0, 1, 0), 1)]\n281\t#  TOPPING (sanal pivot ön dış köşe 1438 / 2497 · z 79) ve F düşer kapakları (FU.KAPAK_EKSEN) montajda eklenir\n282\t"}]},"uuid":"5ceb9492-481a-47f1-972c-1f31f7a8e9f3","timestamp":"2026-10-01T22:49:37.517Z","sourceToolAssistantUUID":"29a08bab-9fd1-4c91-b2f7-d19603bc9fd8","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
