{"parentUuid":"4c3b737d-f99b-4ce2-b775-92cfb1ebae05","isSidechain":true,"promptId":"1bc5b0ba-0645-46fb-806c-275b1bbc261d","agentId":"a93ea3e059d5c65dd","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WCN851716nef1Lnqk8sBXX","type":"tool_result","content":"# -*- coding: utf-8 -*-\r\n\"\"\"B çekmece sensör kabloları: arka duvarda kat başına kapaklı kanal + çekmece rayı ile yan duvar arasında yassı kapaklı kanal\"\"\"\r\nimport numpy as np\r\nfrom b4lib import KAY\r\nIST = \"B\"\r\ndef K(ad, e, lo, hi, **kw): return dict(ad=ad, e=e, lo=lo, hi=hi, ist=IST, **kw)\r\nKX = {806: 988.5, 1461: 1643.5, 2116: 2298.5, 2771: 2953.5, 3426: 3608.5}\r\nVAR_KANAL = []; KAN = []; YOL = {}\r\nfor ci, d in enumerate(KAY):\r\n    if d[\"ist\"] != \"B\" or not d[\"S\"] or d[\"prim\"] != \"ELK_DOLAP__kablo_sinyal\": continue\r\n    zs = [q for q in d[\"S\"] if abs(q[\"b\"][2] - q[\"a\"][2]) > 600]\r\n    if not zs: continue\r\n    q = zs[0]; c = round(float(q[\"a\"][0]), 1); yL = float(q[\"a\"][1])\r\n    cx = min(KX, key=lambda k: abs(k - c)); Kx = KX[cx]\r\n    y0 = round(yL - 11.6)\r\n    yb = [s for s in d[\"S\"] if abs(s[\"b\"][0] - s[\"a\"][0]) > 100]\r\n    if yb: y0 = min((float(s_[\"a\"][1]) for s_ in yb), key=lambda v: abs(v - (yL - 11.6)))\r\n    xc = c - 2.6\r\n    YOL[ci] = dict(yol=[[(Kx - 0.2, y0, -777), (xc, y0, -777), (xc, y0, -760), (xc, yL, -760), (xc, yL, -55), (xc, y0, -55), (c - 0.6, y0, -55)]])\r\n    KAN.append(K(\"Byan%d\" % ci, 2, (c - 7.6, yL - 11, -758), (c + 2.1, yL + 11, -62)))\r\n    KAN.append(K(\"Barka%d\" % ci, 0, (c + (64 if y0 > 680 else 10), y0 - 7, -790), (Kx, min(y0 + 19, 702.9), -760)))\r\nfor k in KAN:\n    if k[\"ad\"] == \"Barka130\": k[\"lo\"] = (k[\"lo\"][0], k[\"lo\"][1] + 3.5, k[\"lo\"][2])\n92:def kanal(eks, a0, a1, lo2, hi2, t=1.5, acik=(), uc=(True, True), delik=None):\n93-    \"\"\"eksen eks boyunca dikdortgen kanal: kesit [lo2,hi2] (diger iki eksen, artan sira), 4 cidar t (+ uc kapaklari).\n94-    delik: {'yuz': (eksen, +-1), [(a0,a1,b0,b1)] } -> cidarda ag. acik: atlanan cidarlar [(eksen, +-1)].\"\"\"\n95-    u, w = [i for i in range(3) if i != eks]\n96-    out = []\n97-    ea0 = a0 + (t if uc[0] else 0.0); ea1 = a1 - (t if uc[1] else 0.0)\n98-    for ax, sg in ((u, -1), (u, 1), (w, -1), (w, 1)):\n99-        if (ax, sg) in acik: continue\n100-        oth = w if ax == u else u\n101-        oi = 0 if oth == u else 1; ai = 0 if ax == u else 1\n102-        v0 = lo2[ai] if sg < 0 else hi2[ai] - t\n103-        v1 = v0 + t\n104-        # plaka ekseni ax; diger eksenler (eks, oth) artan sira · w-duvarlari u-duvarlarinin arasina (kose bindirmesi yok)\n105-        ql = sorted([eks, oth])\n106-        o0, o1 = lo2[oi], hi2[oi]\n107-        if ax == w:\n108-            if (u, -1) not in acik: o0 += t\n109-            if (u, 1) not in acik: o1 -= t\n110-        rng = {eks: (ea0, ea1), oth: (o0, o1)}\n111-        dl = (delik or {}).get((ax, sg), [])\n112-        # delik: (eks0, eks1, oth0, oth1) -> sira\n113-        dd = []\n114-        for d in dl:\n115-            r = {eks: (d[0], d[1]), oth: (d[2], d[3])}\n116-            dd.append((r[ql[0]][0], r[ql[0]][1], r[ql[1]][0], r[ql[1]][1]))\n117-        out.append(plaka(ax, v0, v1, rng[ql[0]][0], rng[ql[0]][1], rng[ql[1]][0], rng[ql[1]][1], dd))\n118-    for k, a in enumerate((a0, a1)):\n119-        if not uc[k]: continue\n120-        lo = np.zeros(3); hi = np.zeros(3)\n121-        lo[eks], hi[eks] = (a, a + t) if k == 0 else (a - t, a)\n122-        lo[u], hi[u] = lo2[0], hi2[0]; lo[w], hi[w] = lo2[1], hi2[1]\n123-        out.append(kutu_ucgen(lo, hi))\n124-    return np.concatenate(out)\n125-\n126-\n127-def silindir(p0, p1, r, n=20):\n128-    return silindir_ucgen(p0, p1, r, n)\n129-\n130-\n131-def tup(Q, r, n=16):\n132-    \"\"\"dik acili kablo: noktalar arasi silindir + kose kuresi (kapali parcalar)\"\"\"","is_error":false}]},"uuid":"cc6c6943-b59c-40d8-b64e-3817bd2fb9b0","timestamp":"2026-10-03T21:09:14.062Z","sourceToolAssistantUUID":