", \"QR_GOZLER\") or kod.startswith((\"CEK_\", \"F_DONER\")): return \"GIDA\"\n1669:    return kod.startswith((\"TOPPING_MODUL\", \"TOPPING_DONER\", \"CEK_\", \"F_TP10_\", \"F_DONER\", \"QR_GOZLER\", \"B_DEPO\", \"K_YAG\", \"K_BANT\", \"K_KESICI\", \"F_YUKLEME\", \"B_COP\", \"E_COP\", \"HAVA_KOMPRESOR\"))\n1678:    if kb in (\"DUKKAN\", \"ROBOT\", \"URUN\") or birim in (\"HAVA_KOMPRESOR\", \"B_SOGUTMA\"): return kb\n1813:                ton.setdefault((q[\"mal\"], \"SABIT\"), Mesh()).ekle(TC_AG(cq.Workplane(obj=q[\"sh\"].translate(cq.Vector(X_BC + KOMP_KAY[0], KOMP_KAY[1], KOMP_KAY[2]))), False))\n1974:    _ZON = (\"HAVA_KOMPRESOR\",)                                                # v48: fırın kutusu yok                              # zarf/bolge birimleri: icindekilerle kesismesi dogal\n2262:        if q[\"ad\"].startswith(\"kompresor_\"): _DG.append((\"HAVA:\" + q[\"ad\"], q[\"sh\"].translate(cq.Vector(X_BC + KOMP_KAY[0], KOMP_KAY[1], KOMP_KAY[2]))))\n2378:    import h3_ist_v1 as _TH2                                                   # v83: istasyon aralıkları dozaj hesabından (sucuk r_ic 30 → tabla 22,4 mm erken durur)\n2403:    _KOM += [(\"F_UST:\" + p[\"ad\"], FU.dunya(p)) for p in FU.PARCALAR]\n2664:    _HV_ATLA = (\"HAVA_KOMPRESOR\", \"F_DAVLUMBAZ\", \"F_UST_KABIN\", \"F_KOMP_AYAK\", \"F_UST_KAPAK\")   # v63: hat üst kabinin yan saclarındaki rakorlardan geçer                                           # hat bilerek davlumbaz bölmesinden geçer\n2715:    import h3_topping_v1 as _T2","is_error":false}]},"uuid":"9350211a-9c8c-487f-9aa3-171a0e2b40e8","timestamp":"2026-10-01T18:09:24.929Z","sourceToolAssistantUUID":"184a5a52-ff04-4e26-9421-0c714ca5b8a8","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
