{"parentUuid":"cc0a4de3-bcd1-42eb-abc2-ff57fc7a7617","isSidechain":true,"agentId":"ab1c8a4a09fa5a796","message":{"model":"claude-opus-5-5","id":"msg_011CfcEdNFxSRbdn6XuwMXeU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012a3jebD6eP5i2itL8odiy3","name":"Write","input":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\firin_ust_v37\\yama_ud.py","content":"# -*- coding: utf-8 -*-\n\"\"\"v3.7 · h3_ust_depo_v2.py: U_F baca yalıtımı + zorlamalı havalandırma (4 × 4414 FL) + ısı dengesi\"\"\"\nimport os\nS = os.path.dirname(os.path.abspath(__file__))\np = os.path.join(os.path.dirname(S), \"b3\", \"arastirma\", \"_uretec\", \"h3\", \"h3_ust_depo_v2.py\")\ns = open(p, encoding=\"utf-8\").read()\n\n\ndef R(a, b, n=1):\n    global s\n    assert s.count(a) == n, (a[:90], s.count(a)); s = s.replace(a, b)\n\n\n# ---- başlık notu ----\nR('''Çalıştır (öz denetim): python ob_calistir.py h2/h3_ust_depo_v1.py   (TOPPING sınır denetimini atlamak: --topping-yok)\n\"\"\"''', '''Çalıştır (öz denetim): python ob_calistir.py h2/h3_ust_depo_v1.py   (TOPPING sınır denetimini atlamak: --topping-yok)\nv3.7 (1 Eki 2026 · Claude · YEREL) — U_F ISISI (eksik taraması: U_F kapalı, havalandırma yok, yalıtımsız baca uzantısı içinden 336 mm geçiyor · ana pano U_F'de):\n  · BACA YALITIMI: ust_f_baca_kanali çevresine 25 mm taş yünü (ust_f_baca_yalitimi_tasyunu) + 0,5 mm 304 kılıf (ust_f_baca_yalitim_kilifi) · y 1863,5–2195,5\n    (taban sacı üstü → baca flanşı altı; flanş 30 geniş, kılıfı 4,5 taşar) · x 2924,5–3275,5 · z −745,5…−494,5.\n  · ZORLAMALI HAVALANDIRMA (birim U_F_HAVALANDIRMA · ön kapaklara DOKUNULMAZ, hepsi ARKA SACTA): 4 × ebm-papst 4414 FL (24 V DC · 119 × 119 × 25 — B dolabındaki\n    fanla aynı model) · EMİŞ 2 adet ALT-ARKA-SAĞ (x 3660 / 3860 · y 1930: panonun arkası — taze hava önce panoyu süpürür) · ATIŞ 2 adet ÜST-ARKA-SOL\n    (x 2640 / 2820 · y 2075: bacanın solu, üst hat kanalının altı) · her fanın önünde filtre kasası 125 × 125 × 10 + G3 keçe · arka sacta yarık ızgara (fan başına\n    9 × 100 × 6) · fanlar ana panodaki termostatla (STEGO KTS 011 sınıfı, 35 °C kapanır) 24 V'tan · kablo: panonun sol yanındaki fan_24V_M20 rakoru.\n  · ISI DENGESİ: isi_dengesi() (varsayımlar fonksiyonda AÇIK yazılı) · arkada bina duvarına ≥ 100 mm boşluk ŞART (emiş / atış arka sacta).'''\n  + '\\n\"\"\"')\n\n# ---- sabitler ----\nR('''# içecek yedeği (U_KE)''', '''# v3.7 · baca yalıtımı + U_F havalandırması\nBACA_YAL, BACA_KILIF = 25.0, 0.5                # taş yünü (ROCKWOOL ProRox / muadili sınıfı) · 304 kılıf\nBACA_YAL_Y = (Y_TABAN[1], Y_TAVAN[0] - BACA_FLANS_T)                # 1863,5 → 2195,5 (flanşın altı)\nFAN = dict(a=119.0, t=25.0, r_ic=57.0, r_gobek=27.0, delik=104.8)   # ebm-papst 4414 FL 119 × 119 × 25 (store_cad_v14 ile aynı) · gövde deliği / göbek VARSAYIM\nFILTRE = dict(a=125.0, t=10.0, ic=113.0, kece=8.0)                 # filtre kasası 304 1 mm + G3 keçe (VARSAYIM ölçü)\nUF_FAN = [(\"emis_0\", 3660.0, 1930.0, \"+z\"), (\"emis_1\", 3860.0, 1930.0, \"+z\"),     # (ad, x merkez, y merkez, üfleme yönü) · arka sacın iç yüzünde\n          (\"atis_0\", 2640.0, 2075.0, \"-z\"), (\"atis_1\", 2820.0, 2075.0, \"-z\")]\nUF_FAN_Z = (Z_ARKA_IC + FILTRE[\"t\"], Z_ARKA_IC + FILTRE[\"t\"] + FAN[\"t\"])          # fan −818,5…−793,5 · filtre −828,5…−818,5\n\n\ndef uf_fan_kablo_noktalari():\n    \"\"\"elektrik ajanı arayüzü: fan bağlantı ucu (fan gövdesinin iç yüzü, sağ-üst köşe) · dünya\"\"\"\n    return [(\"uf_fan_%s\" % ad, xc + FAN[\"a\"] / 2.0 - 8.0, yc + FAN[\"a\"] / 2.0 - 8.0, UF_FAN_Z[1]) for ad, xc, yc, yon in UF_FAN]\n\n\n# içecek yedeği (U_KE)''')\n\n# ---- birimler ----\nR('''    (\"U_F_BACA\", \"Fırın davlumbaz atış kanalı uzantısı 300 × 200 (304 1,5 · 1862 → 2200, serbest kesit 297 × 197) + bina egzozu bağlantı flanşı (3 mm, üst sacın altında, 8 × M6)\"),''',\n  '''    (\"U_F_BACA\", \"Fırın davlumbaz atış kanalı uzantısı 300 × 200 (304 1,5 · 1862 → 2200, serbest kesit 297 × 197) + bina egzozu bağlantı flanşı (3 mm, üst sacın altında, 8 × M6) · v3.7: 25 mm taş yünü + 0,5 mm 304 kılıf\"),\n    (\"U_F_HAVALANDIRMA\", \"v3.7 · U_F zorlamalı havalandırma: 4 × ebm-papst 4414 FL 24 V (2 emiş alt-arka-sağ, panonun arkası · 2 atış üst-arka-sol, bacanın solu) + filtre kasası / G3 keçe + arka sacta yarık ızgara · ana panodaki termostatla\"),''')\n\n# ---- baca(): yalıtım ----\nR('''    ekle(\"ust_f_baca_flansi\", f, \"paslanmaz\", B, kaynak=\"bina egzozu bağlantısı\",''', '''    # v3.7 · yalıtım: 25 mm taş yünü + 0,5 mm 304 kılıf (taban sacından flanşın altına)\n    ya, yb = BACA_YAL_Y; e, k_ = BACA_YAL, BACA_KILIF\n    ty = kut(x0 - e, x1 + e, ya, yb, z0 - e, z1 + e).cut(kut(x0, x1, ya - 1.0, yb + 1.0, z0, z1))\n    ekle(\"ust_f_baca_yalitimi_tasyunu\", ty, \"yalitim_gorunur\", B, kaynak=\"v3.7 · ROCKWOOL ProRox sınıfı taş yünü levha / şilte (λ ≈ 0,040 W/mK @ 50 °C · föyden teyit)\",\n         bom=(\"Baca yalıtımı taş yünü 25 mm (≥ 100 kg/m³, A1 yanmaz) · 4 yüz × %.0f\" % (yb - ya), 1, \"kesim + paslanmaz bağ teli\",\n              \"v3.7 · U_F'e ısı: yalıtımsız ≈ 90 W → yalıtımlı ≈ 18 W (T_gaz 90 °C VARSAYIM, isi_dengesi())\", \"SATIN ALMA\"))\n    kl = kut(x0 - e - k_, x1 + e + k_, ya, yb, z0 - e - k_, z1 + e + k_).cut(kut(x0 - e, x1 + e, ya - 1.0, yb + 1.0, z0 - e, z1 + e))\n    ekle(\"ust_f_baca_yalitim_kilifi\", kl, \"sac\", B, kaynak=\"v3.7\",\n         bom=(\"Baca yalıtım kılıfı 304 0,5 · 351 × 251 × %.0f (2 parça, perçinli bindirme)\" % (yb - ya), 1, \"lazer + abkant\", \"üst ucu flanşın altında (flanş 4,5 taşar) · alt ucu U_F tabanına oturur\", \"ÜRETİM\"))\n    ekle(\"ust_f_baca_flansi\", f, \"paslanmaz\", B, kaynak=\"bina egzozu bağlantısı\",''')\n\n# ---- havalandırma fonksiyonu + ısı dengesi ----\nR('''def icecek():''', '''def havalandirma():\n    \"\"\"v3.7 · U_F arka sacı: 4 × 4414 FL + filtre kasası + keçe · arka sacta yarık ızgara (ön kapaklara dokunulmaz)\"\"\"\n    B = \"U_F_HAVALANDIRMA\"\n    a, t, ri, rg = FAN[\"a\"], FAN[\"t\"], FAN[\"r_ic\"], FAN[\"r_gobek\"]\n    fa, ft, fi, fk = FILTRE[\"a\"], FILTRE[\"t\"], FILTRE[\"ic\"], FILTRE[\"kece\"]\n    z0, z1 = UF_FAN_Z\n    arka = [q for q in PARCALAR if q[\"ad\"] == \"ust_f_arka_sac\"][0]\n    w = dunya(arka)\n    for i, (ad, xc, yc, yon) in enumerate(UF_FAN):\n        g = cq.Solid.makeBox(a, a, t, V(xc - a / 2.0, yc - a / 2.0, z0)).cut(cq.Solid.makeCylinder(ri, t + 2.0, V(xc, yc, z0 - 1.0), V(0, 0, 1)))\n        g = g.fuse(cq.Solid.makeCylinder(rg, t - 2.0, V(xc, yc, z0 + 1.0), V(0, 0, 1)))\n        for k in range(4):                                                       # 4 kol (göbek → gövde köşesi)\n            ang = math.radians(45.0 + 90.0 * k)\n            g = g.fuse(cq.Solid.makeBox(ri - rg + 6.0, 4.0, 3.0, V(0, -2.0, 0)).rotate(V(0, 0, 0), V(0, 0, 1), math.degrees(ang))\n                       .translate(V(xc + (rg - 2.0) * math.cos(ang), yc + (rg - 2.0) * math.sin(ang), (z1 - 3.0) if yon == \"+z\" else z0)))\n        ekle(\"ust_f_fan_4414FL_%s\" % ad, cq.Workplane(obj=g.clean()), \"koyu\", B, kaynak=\"ebm-papst 4414 FL (119 × 119 × 25 · 24 V DC) — store_cad_v14 ile aynı model\",\n             bom=(\"Fan ebm-papst 4414 FL 24 V DC 119 × 119 × 25\", 4, \"katalog (ebm-papst.com) · debi / güç föyden (isi_dengesi)\",\n                  \"v3.7 · U_F: 2 emiş (alt-arka-sağ, panonun arkası) + 2 atış (üst-arka-sol, bacanın solu) · arka sacın iç yüzünde filtre kasasına 4 × M4\", \"SATIN ALMA\") if i == 0 else None)\n        fk_ = cq.Solid.makeBox(fa, fa, ft, V(xc - fa / 2.0, yc - fa / 2.0, Z_ARKA_IC)).cut(cq.Solid.makeBox(fi, fi, ft + 2.0, V(xc - fi / 2.0, yc - fi / 2.0, Z_ARKA_IC - 1.0)))\n        ekle(\"ust_f_fan_filtre_kasasi_%s\" % ad, cq.Workplane(obj=fk_), \"paslanmaz\", B,\n             bom=(\"Fan filtre kasası 304 1 mm · 125 × 125 × 10 (arka saca perçin, fan önüne)\", 4, \"lazer + abkant\", \"VARSAYIM ölçü\", \"ÜRETİM\") if i == 0 else None)\n        ekle(\"ust_f_fan_filtre_kecesi_%s\" % ad, cq.Workplane(obj=cq.Solid.makeBox(fi, fi, fk, V(xc - fi / 2.0, yc - fi / 2.0, Z_ARKA_IC + (ft - fk) / 2.0))), \"plastik\", B,\n             bom=(\"Filtre keçesi G3 (EN 779) 113 × 113 × 8 · yıkanabilir\", 4, \"sarf\", \"fan önünde · ayda bir temizlik\", \"SARF\") if i == 0 else None)\n        for j in range(9):                                                       # arka sacta yarık ızgara 9 × 100 × 6 (adım 12)\n            yy = yc - 48.0 + 12.0 * j\n            w = w.cut(cq.Solid.makeBox(100.0, 6.0, SAC + 2.0, V(xc - 50.0, yy - 3.0, Z_ARKA - 1.0)))\n    arka[\"wp\"] = cq.Workplane(obj=w.clean())\n    arka[\"bom\"] = arka[\"bom\"] and (arka[\"bom\"][0] + \" · v3.7: 4 × yarık ızgara (9 × 100 × 6) fan arkasında\",) + tuple(arka[\"bom\"][1:])\n\n\ndef isi_dengesi(T_oda=44.0, T_gaz=90.0, P_pano=20.0, A_pano=0.533, yalitim=True, V_fan=94.0, n_emis=2, verim_filtre=0.65, T_F=50.0, v_pano=1.0):\n    \"\"\"v3.7 · U_F + ana pano kararlı ısı dengesi (W · K) — VARSAYIMLAR (hepsi parametre):\n      T_gaz 90 °C : baca içi = davlumbazın emdiği F kabini havası + fırın tünel buharı karışımı (elektrikli fırın, yanma gazı YOK) — ÖLÇÜLMEDİ; 150 °C duyarlılık ayrıca\n      h_i 20 W/m²K (kanal içi cebri ~3 m/s) · h_o 9 (yalıtımsız sac: doğal 5 + ışınım 4) · kılıf h_o 5 (304 ε ≈ 0,15) · taş yünü λ 0,040 W/mK (50–60 °C ortalama)\n      U_F tabanı: F kabini havası T_F 50 °C VARSAYIM → iki sac arası U 1,33 W/m²K (alt yüz kararlı katman h 2, üst yüz h 4) · alan 1,33 m²\n      U_F duvarları → oda: U 4 W/m²K × 2,4 m² (üst + ön + arka) · fan: 4414 FL serbest debi V_fan m³/h × filtre / ızgara verimi 0,65 (VARSAYIM) × emiş fanı sayısı\n      pano dış yüzü: emiş jetinde v_pano m/s → h = 5,6 + 4,0·v (Jürges) + ışınım 1,5 · pano yanındaki hava = oda + ΔT_U / 2 (emiş tarafı)\"\"\"\n    rcp = 1.11 * 1007.0                                                        # J/m³K @ ~45 °C\n    T_U = T_oda + 2.0\n    for _ in range(30):\n        Pk = 2.0 * (0.300 + 0.200) * 0.3365\n        if yalitim:\n            Am = 2.0 * (0.325 + 0.225) * 0.332\n            U = 1.0 / (1.0 / 20.0 + BACA_YAL / 1000.0 / 0.040 + 1.0 / 5.0)\n            Q_baca = U * Am * (T_gaz - T_U)\n            T_yuzey = T_U + Q_baca / (5.0 * 2.0 * (0.351 + 0.251) * 0.332)\n        else:\n            U = 1.0 / (1.0 / 20.0 + 1.0 / 9.0); Q_baca = U * Pk * (T_gaz - T_U); T_yuzey = T_gaz - Q_baca / (20.0 * Pk)\n        Q_taban = 1.33 * 1.33 * (T_F - T_U)\n        Q_fan = 4 * 1.5\n        V = n_emis * V_fan * verim_filtre / 3600.0\n        dT = (Q_baca + P_pano + Q_taban + Q_fan) / (rcp * V + 4.0 * 2.4)\n        T_U = T_oda + dT\n    h_p = 5.6 + 4.0 * v_pano + 1.5\n    T_pano = T_oda + dT / 2.0 + P_pano / (h_p * A_pano)\n    return dict(T_oda=T_oda, T_gaz=T_gaz, yalitim=yalitim, Q_baca=round(Q_baca, 1), T_baca_yuzey=round(T_yuzey, 1), Q_taban=round(Q_taban, 1), P_pano=P_pano,\n                debi_m3h=round(V * 3600.0, 0), dT_UF=round(dT, 2), T_UF=round(T_U, 1), h_pano=round(h_p, 1), T_pano_ic=round(T_pano, 1))\n\n\ndef icecek():''')\n\nR('''    baca()\n    icecek()''', '''    baca()\n    havalandirma()\n    icecek()''')\nopen(p, \"w\", encoding=\"utf-8\").write(s)\nprint(\"ud yama tamam\")\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5533,"cache_read_input_tokens":410046,"cache_creation":{"ephemeral_5m_input_tokens":5533,"ephemeral_1h_input_tokens":0},"output_tokens":57,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_012a3jebD6eP5i2itL8odiy3":{"file_path":"C:\\Users\\Kemal\\AppData\\Local\\Temp\\claude\\C--Users-Kemal-Desktop-Kemal-WEBS-TE\\f3ef876a-f062-4b29-bb81-775cc8a1a6d8\\scratchpad\\firin_ust_v37\\yama_ud.py","content":"# -*- coding: utf-8 -*-\n\"\"\"v3.7 · h3_ust_depo_v2.py: U_F baca yalıtımı + zorlamalı havalandırma (4 × 4414 FL) + ısı dengesi\"\"\"\nimport os\nS = os.path.dirname(os.path.abspath(__file__))\np = os.path.join(os.path.dirname(S), \"b3\", \"arastirma\", \"_uretec\", \"h3\", \"h3_ust_depo_v2.py\")\ns = open(p, encoding=\"utf-8\").read()\n\n\ndef R(a, b, n=1):\n    global s\n    assert s.count(a) == n, (a[:90], s.count(a)); s = s.replace(a, b)\n\n\n# ---- başlık notu ----\nR('''Çalıştır (öz denetim): python ob_calistir.py h2/h3_ust_depo_v1.py   (TOPPING sınır denetimini atlamak: --topping-yok)\n\"\"\"''', '''Çalıştır (öz denetim): python ob_calistir.py h2/h3_ust_depo_v1.py   (TOPPING sınır denetimini atlamak: --topping-yok)\nv3.7 (1 Eki 2026 · Claude · YEREL) — U_F ISISI (eksik taraması: U_F kapalı, havalandırma yok, yalıtımsız baca uzantısı içinden 336 mm geçiyor · ana pano U_F'de):\n  · BACA YALITIMI: ust_f_baca_kanali çevresine 25 mm taş yünü (ust_f_baca_yalitimi_tasyunu) + 0,5 mm 304 kılıf (ust_f_baca_yalitim_kilifi) · y 1863,5–2195,5\n    (taban sacı üstü → baca flanşı altı; flanş 30 geniş, kılıfı 4,5 taşar) · x 2924,5–3275,5 · z −745,5…−494,5.\n  · ZORLAMALI HAVALANDIRMA (birim U_F_HAVALANDIRMA · ön kapaklara DOKUNULMAZ, hepsi ARKA SACTA): 4 × ebm-papst 4414 FL (24 V DC · 119 × 119 × 25 — B dolabındaki\n    fanla aynı model) · EMİŞ 2 adet ALT-ARKA-SAĞ (x 3660 / 3860 · y 1930: panonun arkası — taze hava önce panoyu süpürür) · ATIŞ 2 adet ÜST-ARKA-SOL\n    (x 2640 / 2820 · y 2075: bacanın solu, üst hat kanalının altı) · her fanın önünde filtre kasası 125 × 125 × 10 + G3 keçe · arka sacta yarık ızgara (fan başına\n    9 × 100 × 6) · fanlar ana panodaki termostatla (STEGO KTS 011 sınıfı, 35 °C kapanır) 24 V'tan · kablo: panonun sol yanındaki fan_24V_M20 rakoru.\n  · ISI DENGESİ: isi_dengesi() (varsayımlar fonksiyonda AÇIK yazılı) · arkada bina duvarına ≥ 100 mm boşluk ŞART (emiş / atış arka sacta).'''\n  + '\\n\"\"\"')\n\n# ---- sabitler ----\nR('''# içecek yedeği (U_KE)''', '''# v3.7 · baca yalıtımı + U_F havalandırması\nBACA_YAL, BACA_KILIF = 25.0, 0.5                # taş yünü (ROCKWOOL ProRox / muadili sınıfı) · 304 kılıf\nBACA_YAL_Y = (Y_TABAN[1], Y_TAVAN[0] - BACA_FLANS_T)                # 1863,5 → 2195,5 (flanşın altı)\nFAN = dict(a=119.0, t=25.0, r_ic=57.0, r_gobek=27.0, delik=104.8)   # ebm-papst 4414 FL 119 × 119 × 25 (store_cad_v14 ile aynı) · gövde deliği / göbek VARSAYIM\nFILTRE = dict(a=125.0, t=10.0, ic=113.0, kece=8.0)                 # filtre kasası 304 1 mm + G3 keçe (VARSAYIM ölçü)\nUF_FAN = [(\"emis_0\", 3660.0, 1930.0, \"+z\"), (\"emis_1\", 3860.0, 1930.0, \"+z\"),     # (ad, x merkez, y merkez, üfleme yönü) · arka sacın iç yüzünde\n          (\"atis_0\", 2640.0, 2075.0, \"-z\"), (\"atis_1\", 2820.0, 2075.0, \"-z\")]\nUF_FAN_Z = (Z_ARKA_IC + FILTRE[\"t\"], Z_ARKA_IC + FILTRE[\"t\"] + FAN[\"t\"])          # fan −818,5…−793,5 · filtre −828,5…−818,5\n\n\ndef uf_fan_kablo_noktalari():\n    \"\"\"elektrik ajanı arayüzü: fan bağlantı ucu (fan gövdesinin iç yüzü, sağ-üst köşe) · dünya\"\"\"\n    return [(\"uf_fan_%s\" % ad, xc + FAN[\"a\"] / 2.0 - 8.0, yc + FAN[\"a\"] / 2.0 - 8.0, UF_FAN_Z[1]) for ad, xc, yc, yon in UF_FAN]\n\n\n# içecek yedeği (U_KE)''')\n\n# ---- birimler ----\nR('''    (\"U_F_BACA\", \"Fırın davlumbaz atış kanalı uzantısı 300 × 200 (304 1,5 · 1862 → 2200, serbest kesit 297 × 197) + bina egzozu bağlantı flanşı (3 mm, üst sacın altında, 8 × M6)\"),''',\n  '''    (\"U_F_BACA\", \"Fırın davlumbaz atış kanalı uzantısı 300 × 200 (304 1,5 · 1862 → 2200, serbest kesit 297 × 197) + bina egzozu bağlantı flanşı (3 mm, üst sacın altında, 8 × M6) · v3.7: 25 mm taş yünü + 0,5 mm 304 kılıf\"),\n    (\"U_F_HAVALANDIRMA\", \"v3.7 · U_F zorlamalı havalandırma: 4 × ebm-papst 4414 FL 24 V (2 emiş alt-arka-sağ, panonun arkası · 2 atış üst-arka-sol, bacanın solu) + filtre kasası / G3 keçe + arka sacta yarık ızgara · ana panodaki termostatla\"),''')\n\n# ---- baca(): yalıtım ----\nR('''    ekle(\"ust_f_baca_flansi\", f, \"paslanmaz\", B, kaynak=\"bina egzozu bağlantısı\",''', '''    # v3.7 · yalıtım: 25 mm taş yünü + 0,5 mm 304 kılıf (taban sacından flanşın altına)\n    ya, yb = BACA_YAL_Y; e, k_ = BACA_YAL, BACA_KILIF\n    ty = kut(x0 - e, x1 + e, ya, yb, z0 - e, z1 + e).cut(kut(x0, x1, ya - 1.0, yb + 1.0, z0, z1))\n    ekle(\"ust_f_baca_yalitimi_tasyunu\", ty, \"yalitim_gorunur\", B, kaynak=\"v3.7 · ROCKWOOL ProRox sınıfı taş yünü levha / şilte (λ ≈ 0,040 W/mK @ 50 °C · föyden teyit)\",\n         bom=(\"Baca yalıtımı taş yünü 25 mm (≥ 100 kg/m³, A1 yanmaz) · 4 yüz × %.0f\" % (yb - ya), 1, \"kesim + paslanmaz bağ teli\",\n              \"v3.7 · U_F'e ısı: yalıtımsız ≈ 90 W → yalıtımlı ≈ 18 W (T_gaz 90 °C VARSAYIM, isi_dengesi())\", \"SATIN ALMA\"))\n    kl = kut(x0 - e - k_, x1 + e + k_, ya, yb, z0 - e - k_, z1 + e + k_).cut(kut(x0 - e, x1 + e, ya - 1.0, yb + 1.0, z0 - e, z1 + e))\n    ekle(\"ust_f_baca_yalitim_kilifi\", kl, \"sac\", B, kaynak=\"v3.7\",\n         bom=(\"Baca yalıtım kılıfı 304 0,5 · 351 × 251 × %.0f (2 parça, perçinli bindirme)\" % (yb - ya), 1, \"lazer + abkant\", \"üst ucu flanşın altında (flanş 4,5 taşar) · alt ucu U_F tabanına oturur\", \"ÜRETİM\"))\n    ekle(\"ust_f_baca_flansi\", f, \"paslanmaz\", B, kaynak=\"bina egzozu bağlantısı\",''')\n\n# ---- havalandırma fonksiyonu + ısı dengesi ----\nR('''def icecek():''', '''def havalandirma():\n    \"\"\"v3.7 · U_F arka sacı: 4 × 4414 FL + filtre kasası + keçe · arka sacta yarık ızgara (ön kapaklara dokunulmaz)\"\"\"\n    B = \"U_F_HAVALANDIRMA\"\n    a, t, ri, rg = FAN[\"a\"], FAN[\"t\"], FAN[\"r_ic\"], FAN[\"r_gobek\"]\n    fa, ft, fi, fk = FILTRE[\"a\"], FILTRE[\"t\"], FILTRE[\"ic\"], FILTRE[\"kece\"]\n    z0, z1 = UF_FAN_Z\n    arka = [q for q in PARCALAR if q[\"ad\"] == \"ust_f_arka_sac\"][0]\n    w = dunya(arka)\n    for i, (ad, xc, yc, yon) in enumerate(UF_FAN):\n        g = cq.Solid.makeBox(a, a, t, V(xc - a / 2.0, yc - a / 2.0, z0)).cut(cq.Solid.makeCylinder(ri, t + 2.0, V(xc, yc, z0 - 1.0), V(0, 0, 1)))\n        g = g.fuse(cq.Solid.makeCylinder(rg, t - 2.0, V(xc, yc, z0 + 1.0), V(0, 0, 1)))\n        for k in range(4):                                                       # 4 kol (göbek → gövde köşesi)\n            ang = math.radians(45.0 + 90.0 * k)\n            g = g.fuse(cq.Solid.makeBox(ri - rg + 6.0, 4.0, 3.0, V(0, -2.0, 0)).rotate(V(0, 0, 0), V(0, 0, 1), math.degrees(ang))\n                       .translate(V(xc + (rg - 2.0) * math.cos(ang), yc + (rg - 2.0) * math.sin(ang), (z1 - 3.0) if yon == \"+z\" else z0)))\n        ekle(\"ust_f_fan_4414FL_%s\" % ad, cq.Workplane(obj=g.clean()), \"koyu\", B, kaynak=\"ebm-papst 4414 FL (119 × 119 × 25 · 24 V DC) — store_cad_v14 ile aynı model\",\n             bom=(\"Fan ebm-papst 4414 FL 24 V DC 119 × 119 × 25\", 4, \"katalog (ebm-papst.com) · debi / güç föyden (isi_dengesi)\",\n                  \"v3.7 · U_F: 2 emiş (alt-arka-sağ, panonun arkası) + 2 atış (üst-arka-sol, bacanın solu) · arka sacın iç yüzünde filtre kasasına 4 × M4\", \"SATIN ALMA\") if i == 0 else None)\n        fk_ = cq.Solid.makeBox(fa, fa, ft, V(xc - fa / 2.0, yc - fa / 2.0, Z_ARKA_IC)).cut(cq.Solid.makeBox(fi, fi, ft + 2.0, V(xc - fi / 2.0, yc - fi / 2.0, Z_ARKA_IC - 1.0)))\n        ekle(\"ust_f_fan_filtre_kasasi_%s\" % ad, cq.Workplane(obj=fk_), \"paslanmaz\", B,\n             bom=(\"Fan filtre kasası 304 1 mm · 125 × 125 × 10 (arka saca perçin, fan önüne)\", 4, \"lazer + abkant\", \"VARSAYIM ölçü\", \"ÜRETİM\") if i == 0 else None)\n        ekle(\"ust_f_fan_filtre_kecesi_%s\" % ad, cq.Workplane(obj=cq.Solid.makeBox(fi, fi, fk, V(xc - fi / 2.0, yc - fi / 2.0, Z_ARKA_IC + (ft - fk) / 2.0))), \"plastik\", B,\n             bom=(\"Filtre keçesi G3 (EN 779) 113 × 113 × 8 · yıkanabilir\", 4, \"sarf\", \"fan önünde · ayda bir temizlik\", \"SARF\") if i == 0 else None)\n        for j in range(9):                                                       # arka sacta yarık ızgara 9 × 100 × 6 (adım 12)\n            yy = yc - 48.0 + 12.0 * j\n            w = w.cut(cq.Solid.makeBox(100.0, 6.0, SAC + 2.0, V(xc - 50.0, yy - 3.0, Z_ARKA - 1.0)))\n    arka[\"wp\"] = cq.Workplane(obj=w.clean())\n    arka[\"bom\"] = arka[\"bom\"] and (arka[\"bom\"][0] + \" · v3.7: 4 × yarık ızgara (9 × 100 × 6) fan arkasında\",) + tuple(arka[\"bom\"][1:])\n\n\ndef isi_dengesi(T_oda=44.0, T_gaz=90.0, P_pano=20.0, A_pano=0.533, yalitim=True, V_fan=94.0, n_emis=2, verim_filtre=0.65, T_F=50.0, v_pano=1.0):\n    \"\"\"v3.7 · U_F + ana pano kararlı ısı dengesi (W · K) — VARSAYIMLAR (hepsi parametre):\n      T_gaz 90 °C : baca içi = davlumbazın emdiği F kabini havası + fırın tünel buharı karışımı (elektrikli fırın, yanma gazı YOK) — ÖLÇÜLMEDİ; 150 °C duyarlılık ayrıca\n      h_i 20 W/m²K (kanal içi cebri ~3 m/s) · h_o 9 (yalıtımsız sac: doğal 5 + ışınım 4) · kılıf h_o 5 (304 ε ≈ 0,15) · taş yünü λ 0,040 W/mK (50–60 °C ortalama)\n      U_F tabanı: F kabini havası T_F 50 °C VARSAYIM → iki sac arası U 1,33 W/m²K (alt yüz kararlı katman h 2, üst yüz h 4) · alan 1,33 m²\n      U_F duvarları → oda: U 4 W/m²K × 2,4 m² (üst + ön + arka) · fan: 4414 FL serbest debi V_fan m³/h × filtre / ızgara verimi 0,65 (VARSAYIM) × emiş fanı sayısı\n      pano dış yüzü: emiş jetinde v_pano m/s → h = 5,6 + 4,0·v (Jürges) + ışınım 1,5 · pano yanındaki hava = oda + ΔT_U / 2 (emiş tarafı)\"\"\"\n    rcp = 1.11 * 1007.0                                                        # J/m³K @ ~45 °C\n    T_U = T_oda + 2.0\n    for _ in range(30):\n        Pk = 2.0 * (0.300 + 0.200) * 0.3365\n        if yalitim:\n            Am = 2.0 * (0.325 + 0.225) * 0.332\n            U = 1.0 / (1.0 / 20.0 + BACA_YAL / 1000.0 / 0.040 + 1.0 / 5.0)\n            Q_baca = U * Am * (T_gaz - T_U)\n            T_yuzey = T_U + Q_baca / (5.0 * 2.0 * (0.351 + 0.251) * 0.332)\n        else:\n            U = 1.0 / (1.0 / 20.0 + 1.0 / 9.0); Q_baca = U * Pk * (T_gaz - T_U); T_yuzey = T_gaz - Q_baca / (20.0 * Pk)\n        Q_taban = 1.33 * 1.33 * (T_F - T_U)\n        Q_fan = 4 * 1.5\n        V = n_emis * V_fan * verim_filtre / 3600.0\n        dT = (Q_baca + P_pano + Q_taban + Q_fan) / (rcp * V + 4.0 * 2.4)\n        T_U = T_oda + dT\n    h_p = 5.6 + 4.0 * v_pano + 1.5\n    T_pano = T_oda + dT / 2.0 + P_pano / (h_p * A_pano)\n    return dict(T_oda=T_oda, T_gaz=T_gaz, yalitim=yalitim, Q_baca=round(Q_baca, 1), T_baca_yuzey=round(T_yuzey, 1), Q_taban=round(Q_taban, 1), P_pano=P_pano,\n                debi_m3h=round(V * 3600.0, 0), dT_UF=round(dT, 2), T_UF=round(T_U, 1), h_pano=round(h_p, 1), T_pano_ic=round(T_pano, 1))\n\n\ndef icecek():''')\n\nR('''    baca()\n    icecek()''', '''    baca()\n    havalandirma()\n    icecek()''')\nopen(p, \"w\", encoding=\"utf-8\").write(s)\nprint(\"ud yama tamam\")\n"}},"apiBlockIndex":1,"requestId":"req_011CfcEdMreNWAAZNEK1xvVn","attributionAgent":"general-purpose","type":"assistant","uuid":"8cfae563-a886-4403-9872-77a968e93800","timestamp":"2026-10-01T21:35:53.701Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":"xhigh","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
