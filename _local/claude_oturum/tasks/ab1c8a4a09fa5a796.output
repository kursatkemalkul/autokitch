= []\nwhile it.More(): ch.append(cq.Shape.cast(it.Value())); it.Next()\nassert len(ch) == len(idx)\nKALDIR = FU.KOMP_KALDIR\nM, KOMP = [], []\nfor (b, a, m, g, v), s in zip(idx, ch):\n    if b == \"F_KOMP_AYAK\" or (b == \"F_UST_RAF\" and a == \"ust_raf\"): continue\n    if b == \"HAVA_KOMPRESOR\":\n        KOMP.append((\"HAVA|\" + a, s.translate(V(0, KALDIR, 0)), \"SABIT\")); continue\n    M.append((\"%s|%s\" % (b, a), s, g))\nN = [(\"FU|\" + p[\"ad\"], FU.dunya(p), p[\"grup\"]) for p in FU.PARCALAR if p[\"birim\"] == \"F_KOMP_AYAK\"]\nN += [(\"FT|ust_raf\", FT.dunya(p), \"SABIT\") for p in FT.PARCALAR if p[\"ad\"] == \"ust_raf\"]\nP = [(\"AP|\" + p[\"ad\"], AP.dunya(p), p[\"grup\"]) for p in AP.PARCALAR]\nprint(\"komşu %d · yeni %d · kompresör %d · pano %d\" % (len(M), len(N), len(KOMP), len(P)))\n\n\ndef hacim(a, b):\n    ba, bb = a.BoundingBox(), b.BoundingBox()\n    if ba.xmax < bb.xmin - 0.01 or bb.xmax < ba.xmin - 0.01 or ba.ymax < bb.ymin - 0.01 or bb.ymax < ba.ymin - 0.01 or ba.zmax < bb.zmin - 0.01 or bb.zmax < ba.zmin - 0.01:\n        return 0.0\n    op = BRepAlgoAPI_Common(a.wrapped, b.wrapped); op.Build()\n    if not op.IsDone(): return -1.0\n    gp = GProp_GProps(); BRepGProp.VolumeProperties_s(op.Shape(), gp)\n    return gp.Mass()\n\n\nIZIN = (\"din_rayi\",)        # cihaz tırnağı ↔ ray: katalog_step_v1 'bindirme normal' (gerçek ray içi boş şapka profil)\nsonuc = []\n\n\ndef kontrol(baslik, A, B, ayni=False, esik=0.5):\n    n = 0\n    for i, (a, sa, ga) in enumerate(A):\n        for j, (b, sb, gb) in enumerate(B):\n            if ayni and j <= i: continue\n            v = hacim(sa, sb)\n            if v > esik or v < 0:\n                izin = any(k in a for k in IZIN) or any(k in b for k in IZIN)\n                sonuc.append(dict(t=baslik, a=a, b=b, v=round(v, 2), izin=izin)); n += 1\n    print(\"%-46s %3d kesişim\" % (baslik, n)); sys.stdout.flush()\n\n\nkontrol(\"yeni (raf + ayaklar) ↔ döküm komşuları\", N, M)\nkontrol(\"yeni ↔ kompresör (+%.0f)\" % KALDIR, N, KOMP)\nkontrol(\"yeni ↔ yeni\", N, N, ayni=True)\nkontrol(\"kompresör (+20) ↔ döküm komşuları\", KOMP, M)\nkontrol(\"pano ↔ döküm komşuları\", P, M)\nkontrol(\"pano ↔ kompresör\", P, KOMP)\nkontrol(\"pano ↔ pano\", P, P, ayni=True)\n# kapak süpürmesi (U_F sağ kapağı açık varsayılır → KAPAK_U_F_SAG grubu hariç)\nax = AP.KAPAK_EKSEN[\"KAPAK_ANA_PANO\"]; p0 = V(*ax[0]); d = V(*ax[1])\nKG = [(a, s) for a, s, g in P if g == \"KAPAK_ANA_PANO\"]\nSAB = [(a, s, g) for a, s, g in P if g != \"KAPAK_ANA_PANO\"] + [(a, s, g) for a, s, g in M if not g.startswith(\"KAPAK_U_F\")]\nsup = []\nfor aci in range(5, 100, 5):\n    for a, s in KG:\n        r = s.rotate(p0, p0 + d, float(aci))\n        for b, sb, g in SAB:\n            if \"mentese\" in a and b == \"AP|ana_pano_govde\": continue\n            v = hacim(r, sb)\n            if v > 0.5: sup.append(dict(aci=aci, a=a, b=b, v=round(v, 1)))\nprint(\"kapak süpürmesi 5°–95°: %d kesişim\" % len(sup))\n# kotlar\nbb = lambda s: s.BoundingBox()\nraf = [s for a, s, g in N if a == \"FT|ust_raf\"][0]\nkot = dict(raf_y=(bb(raf).ymin, bb(raf).ymax), raf_hacim=raf.Volume(),\n           ayak_y=[(round(bb(s).ymin, 2), round(bb(s).ymax, 2)) for a, s, g in N if \"ayak\" in a],\n           komp=[(a, round(bb(s).ymin, 1), round(bb(s).ymax, 1)) for a, s, g in KOMP],\n           pano=[round(v, 1) for v in (lambda q: (q.xmin, q.xmax, q.ymin, q.ymax, q.zmin, q.zmax))(cq.Compound.makeCompound([s for a, s, g in P]).BoundingBox())])\nprint(json.dumps(kot, ensure_ascii=False))\nprint(json.dumps(AP.pano_olcu_hesabi(), ensure_ascii=False))\njson.dump(dict(sonuc=sonuc, supurme=sup, kot=kot), io.open(os.path.join(S, \"denetim_v36.json\"), \"w\", encoding=\"utf-8\"), ensure_ascii=False, indent=1)\nfor r in sonuc: print((\"İZİNLİ \" if r[\"izin\"] else \"ÇAKIŞMA \") + \"%(t)s · %(a)s ↔ %(b)s · %(v)s mm³\" % r)\nfor r in sup[:40]: print(\"SÜPÜRME %(aci)d° · %(a)s ↔ %(b)s · %(v)s mm³\" % r)\nAP.sozlesme(os.path.join(os.path.dirname(S), \"ana_pano_soz