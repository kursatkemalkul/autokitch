\"f_ust_rakor_\")))\n624:    _dv = BB[\"f_davlumbaz_kutusu\"]\n625:    kontrol(\"DAVLUMBAZ KUTUSU x %.1f–%.1f · y %.0f–%.0f · z %.1f…%.1f: hava hattının (y 1804–1814) altında, pizza (−424) / kompresör (−420 gerçek) arkasında\"\n706:    print(\"   BİLGİ · HAVALANDIRMA: kapak yarıkları alt %.0f + üst %.0f mm² (serbest) · davlumbaz emiş yarıkları %.0f mm² · arka panjur 2 × %.0f mm² · doğal çekiş (h 0,41 m, ΔT 15 K) \"\n707:          \"≈ %.0f m³/h → ≈ %.0f W taşır: fırın üst yüzü + kompresör için YETMEZ → davlumbaz fanı bölmeden emer (cebri, AÇIK: fan seçimi)\"","is_error":false}]},"uuid":"34e855e9-6e85-492f-bde0-0c390da48840","timestamp":"2026-10-01T21:33:05.413Z","sourceToolAssistantUUID":"b30878c6-9ef4-4894-bb3c-43782b4484f4","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
