{"parentUuid":"f3f9429e-39f1-4436-b3cd-8d4d03072f74","isSidechain":true,"promptId":"50d61844-03e1-47e6-9599-4d79a818d07e","agentId":"ad654ba1b8630e5fb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AVhxho9SztEGws3bxPwWrm","type":"tool_result","content":"421\t    for a, s in bul.items():\n422\t        if a.endswith(\"mil_gecis_kovani\") or a.startswith(\"kovan_\"):\n423\t            b = s.BoundingBox()\n424\t            delik.append(silz((b.xmin + b.xmax) / 2.0, (b.ymin + b.ymax) / 2.0, max(b.xlen, b.ylen) / 2.0, -631.0, -569.0))\n425\t    for d in delik:\n426\t        arka_dis = arka_dis.cut(d); pu = pu.cut(d); ic = ic.cut(d)\n427\t    # yan duvar PU (57,5 · TC yan sacının içinde) + raf askısı GFRP burçları (alt kat 1128,25 · üst kat 1550,5)\n428\t    BURC = {\"alt\": (1128.25, (-520.0, -360.0, -200.0, -40.0), (-567.0, 20.0)), \"ust\": (1550.5, (-520.0, -360.0, -200.0, -90.0), (-567.0, RAF_ON_Z - 3.0))}\n429\t    for yn, (xa, xb) in ((\"sol\", (X0, IX[0] - 1.0)), (\"sag\", (IX[1] + 1.0, X1))):\n430\t        w = kut(xa, xb, KY[0] + 1.5, IY[1] + 1.0, -571.0, ZF)\n431\t        for kat, (by, bzs, _z) in BURC.items():\n432\t            for bz in bzs:\n433\t                w = w.cut(silx(by, bz, 8.0, xa - 1.0, xb + 1.0))\n434\t        ek(\"kabin_%s_duvar_PU\" % yn, w, \"pu\", \"v2 · yan duvar PU 57,5 (40 kg/m³) · iç sacla TC yan sacı arasında · 1110,5–2141 · 8 × GFRP burç yuvası Ø16\")\n435\t    # kaset penceresi: iki POM kanalın dışında kalan boşluk PU ile dolar (v2: dönüş ALT katta, üfleme ÜST katta → aradan kısa devre olmamalı)\n436\t    kn_ = [bul[a].BoundingBox() for a in (\"arka_hava_kanali_ust\", \"arka_hava_kanali_alt\")]\n437\t    dol = kut(KAS_YUZ[0], KAS_YUZ[1], KAS_YUZ[2], KAS_YUZ[3], -628.5, -570.0)\n438\t    for b in kn_:\n439\t        dol = dol.cut(kut(b.xmin, b.xmax, b.ymin, b.ymax, -631.0, -569.0))\n440\t    ek(\"kaset_penceresi_dolgusu\", dol, \"pu\", \"v2 · kaset penceresinde kanalların dışı PU 57,5 · kanallar arası 20 mm bant (üst raf hizası) kapalı: üfleme (üst kat) ile dönüş (alt kat) arasında kısa devre yok\")\n441\t    ek(\"yalitim_blogu\", pu, \"pu\", \"v2 · PU 57,5 TEK KÖPÜK: arka duvar + tavan · 4 UNO + 4 kaset kovanı + 2 hortum geçiş bloğu + kaset yüzü (%.0f × %.0f) kesiği\"\n442\t       % (KAS_YUZ[1] - KAS_YUZ[0], KAS_YUZ[3] - KAS_YUZ[2]))\n443\t    ek(\"soguk_arka_dis_sac\", arka_dis, \"paslanmaz\", \"v2 · arka duvarın dış kabuğu AISI 304 1,5 · 1289,5 × 1089,5 · kovan / blok delikleri + kaset yüzü kesiği\")\n444\t    ek(\"soguk_ic_kaplama\", ic, \"paslanmaz\", \"v2 · iç kaplama AISI 304 1,0: yanlar + tavan + arka tek parça (köşeler R) · iç 1172,5 × 988 × 593\")\n445\t    # ---- (b) ALT KAT TABANI: alt dış sac 1,5 + PU 38,5 + taşıyıcı raf 3 (bükümlü) + köşebentler + burçlar ----\n446\t    alt_sac = kut(X0, X1, KY[0], KY[0] + 1.5, -628.5, ZF)\n447\t    alt_pu = kut(IX[0] + 3.0, IX[1] - 3.0, KY[0] + 1.5, 1149.0, -567.0, 20.0)\n448\t    raf = kut(IX[0], IX[1], 1149.0, 1152.0, -570.0, ZF)\n449\t    buk = [kut(IX[0], IX[1], KY[0] + 1.5, 1149.0, 20.0, ZF), kut(IX[0], IX[1], KY[0] + 1.5, 1149.0, -570.0, -567.0)]\n450\t    for k_ in (\"KIYMA\", \"KUSBASI\"):                                                              # UNO dirsekleri Ø36 ↔ konta ↔ raf deliği Ø42\n451\t        raf = raf.cut(sily(ISTASYON[k_], TU0.ZT, 21.0, 1148.0, 1153.0))\n452\t    for k_, x_ in X_YAYICI.items():                                                              # ürün hortumu Ø42 ↔ konta ↔ raf deliği Ø48\n453\t        raf = raf.cut(sily(x_, TU0.ZT, YAY_BORU_R + 3.0, 1148.0, 1153.0))\n454\t        ek(\"raf_gecis_contasi_%s\" % k_, sily(x_, TU0.ZT, YAY_BORU_R + 3.0, 1149.0, 1152.0).cut(sily(x_, TU0.ZT, YAY_BORU_R, 1148.0, 1153.0)), \"conta\",\n455\t           \"v2 · silikon grommet Ø48 / Ø42 · %s ürün hortumu alt kat tabanından yayıcıya iner\" % k_)\n456\t    for _ad, _mod, _x0, _x1 in TU0.KASET:                                                        # kaset tüpü: delik Ø60 + öne açık U-yarık (yarık dili doldurur) · v1 ile aynı\n457\t        xc = (_x0 + _x1) / 2.0 + TU0.DX_DUNYA + DX_ALT; r_ = TU0.KAS_R[_mod][0]; kz = TU0.KAS_Z\n458\t        raf = raf.cut(sily(xc, kz, r_, 1148.0, 1153.0)).cut(kut(xc - r_, xc + r_, 1148.0, 1153.0, kz, ZF + 1.0))\n459\t        buk[0] = buk[0].cut(kut(xc - r_, xc + r_, 1143.0, 1150.0, 19.0, ZF + 1.0))\n460\t        alt_pu = alt_pu.cut(kut(xc - r_, xc + r_, 1143.0, 1150.0, kz - r_ - 3.0, 21.0))\n461\t    KL = {}\n462\t    for yn, xa, sg in ((\"sol\", IX[0], 1.0), (\"sag\", IX[1], -1.0)):\n463\t        a_, b_ = sorted((xa, xa + sg * 40.0)); c_, d_ = sorted((xa, xa + sg * 3.0))\n464\t        KL[yn] = kut(a_, b_, 1146.0, 1149.0, -567.0, 20.0).fuse(kut(c_, d_, KY[0] + 1.5, 1149.0, -567.0, 20.0))\n465\t        alt_pu = alt_pu.cut(KL[yn])\n466\t    # taban geçişleri: konta yuvaları (raf) · iniş boruları / huniler / UNO dirsekleri / hortumlar (PU + alt sac)\n467\t    for a, s in bul.items():\n468\t        b = s.BoundingBox()\n469\t        if not (b.ymin < 1152.0 - 0.1 and b.ymax > 1109.0 + 0.1 and b.xmin < IX[1] and b.xmax > IX[0] and b.zmax > -570.0 and b.zmin < ZF): continue\n470\t        if a.startswith((\"raf_gecis_contasi_\", \"raf_kaset_contasi_\")) or \"yarik_dili\" in a or a.endswith(\"__cikis_tupu\"): continue   # raf delikleri yukarıda (v1 kurgusu)\n471\t        dil = s.intersect(kut(b.xmin - 1.0, b.xmax + 1.0, KY[0] - 1.0, 1149.0, b.zmin - 1.0, b.zmax + 1.0))\n472\t        if dil.Volume() < 1e-3: continue\n473\t        d = dil.BoundingBox()                                                                    # yalnız alt PU + alt sacın içinden geçen kısım (+1 pay)\n474\t        kk = kut(d.xmin - 1.0, d.xmax + 1.0, KY[0] - 1.0, 1149.5, d.zmin - 1.0, d.zmax + 1.0)\n475\t        alt_pu = alt_pu.cut(kk); alt_sac = alt_sac.cut(kk)\n476\t    for k, x_ in X_YAYICI.items():                                                               # ürün hortumları tabanı dikine geçer (konta rafta)\n477\t        c = sily(x_, TU0.ZT, YAY_BORU_R + 0.5, KY[0] - 1.0, 1149.5)\n478\t        alt_pu = alt_pu.cut(c); alt_sac = alt_sac.cut(c)\n479\t    ek(\"alt_yalitim_saci\", alt_sac, \"paslanmaz\", \"v2 · soğuk kutunun alt dış sacı AISI 304 1,5 · 1289,5 × 651,5 · kontaların altında geçiş delikleri\")\n480\t    ek(\"alt_yalitim_PU\", alt_pu, \"pu\", \"v2 · alt kat tabanı PU 38,5\")\n481\t    ek(\"tasiyici_raf_3mm\", raf, \"paslanmaz\", \"v2 · ALT KAT TABANI 304 3 mm · 1172,5 × 593 · kıyma / kuşbaşı UNO + kaşar / sucuk kaseti bunun üstünde · geçişlerde konta\")\n482\t    ek(\"raf_on_bukumu\", buk[0], \"paslanmaz\", \"v2 · rafın ön bükümü 38,5 (rafla tek parça)\")\n483\t    ek(\"raf_arka_bukumu\", buk[1], \"paslanmaz\", \"v2 · rafın arka bükümü 38,5 (rafla tek parça)\")\n484\t    for yn in (\"sol\", \"sag\"):\n485\t        ek(\"raf_kosebendi_%s\" % yn, KL[yn], \"paslanmaz\", \"v2 · L 40 × 40 × 3 AISI 304 · alt kat rafı yatay koluna oturur · 4 × M8 GFRP burçtan TC yan sacına\")\n486\t    # ---- (c) ÜST KAT RAFI 1572–1575 (304 3, ön + arka 38,5 büküm) + köşebentler: açıklık 1172,5 · yük ≈150 kg (harç UNO + dolu hazne ≈80 · sos ≈35 · GN ≈35) ----\n487\t    #      kesit (3 × 520 + 2 × 38,5 büküm): I ≈ 1,18e5 mm⁴, W ≈ 3130 mm³ → σ ≈ 69 MPa (304 akma 205 → emniyet 3) · sehim ≈ 1,4 mm [H]\n488\t    RZ0, RZ1 = IZ[0], RAF_ON_Z\n489\t    ust = kut(IX[0], IX[1], RAF2[0], RAF2[1], RZ0, RZ1)\n490\t    ubuk = [kut(IX[0], IX[1], RAF2[0] - 38.5, RAF2[0], RZ1 - 3.0, RZ1),\n491\t            kut(IX[0], IX[1], RAF2[0] - 38.5, RAF2[0], RZ0, RZ0 + 3.0).cut(kut(KAS_YUZ[0] + 28.0, KAS_YUZ[1] - 88.0, RAF2[0] - 40.0, RAF2[0] + 1.0, RZ0 - 1.0, RZ0 + 4.0))]\n492\t    UK = {}\n493\t    for yn, xa, sg in ((\"sol\", IX[0], 1.0), (\"sag\", IX[1], -1.0)):\n494\t        a_, b_ = sorted((xa, xa + sg * 40.0)); c_, d_ = sorted((xa, xa + sg * 3.0))\n495\t        UK[yn] = kut(a_, b_, RAF2[0] - 3.0, RAF2[0], RZ0 + 3.0, RZ1 - 3.0).fuse(kut(c_, d_, RAF2[0] - 40.0, RAF2[0] - 3.0, RZ0 + 3.0, RZ1 - 3.0))\n496\t    UH = {}                                                                                      # hortumların üst raftan geçtiği nokta (dik segment rafı keser)\n497\t    for k, pts in HORTUM.items():\n498\t        for a, b in zip(pts[:-1], pts[1:]):\n499\t            if min(a[1], b[1]) < RAF2[0] and max(a[1], b[1]) > RAF2[1]:\n500\t                t = (RAF2[1] - a[1]) / (b[1] - a[1]) if abs(b[1] - a[1]) > 1e-9 else 0.0\n501\t                UH[k] = (a[0] + t * (b[0] - a[0]), a[2] + t * (b[2] - a[2]))\n502\t    for k, (hx, hz) in UH.items():\n503\t        ust = ust.cut(sily(hx, hz, HORTUM_R + 1.0, RAF2[0] - 1.0, RAF2[1] + 1.0))\n504\t        ek(\"ust_raf_gecis_contasi_%s\" % k, sily(hx, hz, HORTUM_R + 1.0, RAF2[0], RAF2[1]).cut(sily(hx, hz, HORTUM_R, RAF2[0] - 1.0, RAF2[1] + 1.0)), \"conta\",\n505\t           \"v2 · üst raftan hortum geçiş kontası silikon Ø44/Ø42 · hortum sökülünce tapa takılır\")\n506\t    ek(\"ust_raf_3mm\", ust, \"paslanmaz\", \"v2 · ÜST KAT RAFI AISI 304 3 · 1172,5 × 520 · sos + harç UNO + kaşar / sucuk GN yedeği · ön kenarı −50 (flipper + hava inişi) · \"\n507\t       \"açıklık 1172,5 · ≈150 kg → σ ≈ 69 MPa · sehim ≈ 1,4 mm [H]\")\n508\t    ek(\"ust_raf_on_bukumu\", ubuk[0], \"paslanmaz\", \"v2 · üst rafın ön bükümü 38,5 (rafla tek parça)\")\n509\t    ek(\"ust_raf_arka_bukumu\", ubuk[1], \"paslanmaz\", \"v2 · üst rafın arka bükümü 38,5 · kaset dönüş kanalının önünde çentikli (hava alt kattan kasete)\")\n510\t    for yn in (\"sol\", \"sag\"):\n511\t        ek(\"ust_raf_kosebendi_%s\" % yn, UK[yn], \"paslanmaz\", \"v2 · L 40 × 40 × 3 AISI 304 · üst raf yatay koluna oturur · 4 × M8 GFRP burçtan TC yan sacına · uç başına ≈0,75 kN\")\n512\t    for kat, (by, bzs, _z) in BURC.items():\n513\t        for yn, (xa, xb) in ((\"sol\", (X0, IX[0] - 1.0)), (\"sag\", (IX[1] + 1.0, X1))):\n514\t            bc = None\n515\t            for bz in bzs:\n516\t                b_ = silx(by, bz, 8.0, xa, xb).cut(silx(by, bz, 4.5, xa - 1.0, xb + 1.0))\n517\t                bc = b_ if bc is None else bc.fuse(b_)\n518\t            ek(\"%sraf_askisi_burclari_%s\" % (\"\" if kat == \"alt\" else \"ust_\", yn), bc, \"pom\",\n519\t               \"v2 · 4 × ısı köprüsü kesici burç GFRP Ø16/Ø9 × 57,5 · raf köşebendini TC yan sacına bağlayan M8 A2 cıvata içinden geçer\")\n520\t    # ---- (d) ÖN YÜZ: 430 çerçeve sacı + soğuk kapaklar K1 / K2 (eşit 642,5) + flipper — v1 kurgusu (topping_uno_cad_v19 5b) yeni ölçüde ----\n521\t    xu, yu = TU0.xu, TU0.yu\n522\t    DERZ = ((XT[0] + SAC + XT[1] - 3.0 - 3.0) / 2.0, (XT[0] + SAC + XT[1] - 3.0 + 3.0) / 2.0)          # v3 · eşit kapaklar (1965,75 | 1968,75)\n523\t    cer_d = [(X0, KY[0]), (X1, KY[0]), (X1, KY[1]), (X0, KY[1])]\n524\t    ag = [(IX[0], IY[0]), (IX[1], IY[0]), (IX[1], IY[1]), (IX[0], IY[1])]\n525\t    cer = cq.Workplane(\"XY\", origin=(0, 0, TU0.Z_CER[0])).polyline(cer_d).close().extrude(1.0)\n526\t    cer = cer.cut(cq.Workplane(\"XY\", origin=(0, 0, TU0.Z_CER[0] - 1.0)).polyline(ag).close().extrude(3.0))\n527\t    for _ad, _mod, _x0, _x1 in TU0.KASET:\n528\t        xc = (_x0 + _x1) / 2.0 + TU0.DX_DUNYA + DX_ALT; r = TU0.KAS_R[_mod][0] + 1.0\n529\t        cer = cer.cut(TU0.kut(xc - r, xc + r, 1143.0, IY[0] + 1.0, TU0.Z_CER[0] - 1.0, TU0.Z_CER[1] + 1.0))\n530\t    ek(\"onyuz_soguk_cerceve_saci\", cer, \"sac\", \"v2 · 430 ferritik 1,0 (manyetik fitil tutar) · 1289,5 × 1089,5 · kaset tüpü çentikleri 62 × 10 · çevresinde ısıtıcı kablo (VARSAYIM 10 W/m)\")\n531\t    SK = {\"K1\": dict(x=(X0, DERZ[0]), fitil=(IX[0], DERZ[0] - 18.5), mentese=\"sol\"),\n532\t          \"K2\": dict(x=(DERZ[1], XT[1] - 3.0), fitil=(DERZ[1] + 16.0, IX[1]), mentese=\"sag\")}\n533\t    KY_K = (1110.5, H_UST - 3.0)                                                                 # 1110,5 … 2197\n534\t    for kn, k in SK.items():\n535\t        x0, x1 = xu(k[\"x\"][0]), xu(k[\"x\"][1]); y0, y1 = yu(KY_K[0]), yu(KY_K[1]); z0, z1 = TU0.Z_SKAPAK\n536\t        ac = (xu(k[\"fitil\"][0]), xu(k[\"fitil\"][1]), yu(1136.0), yu(IY[1]))\n537\t        ds = TU0.kut(x0, x1, y0, y1, z0, z1).cut(TU0.kut(x0 + 1.5, x1 - 1.5, y0 + 1.5, y1 - 1.5, z0 - 1.0, z1 - 1.5))\n538\t        pu_ = TU0.kut(x0 + 1.5, x1 - 1.5, y0 + 1.5, y1 - 1.5, z0 + 1.0, z1 - 1.5)\n539\t        ic_ = TU0.kut(x0 + 1.5, x1 - 1.5, y0 + 1.5, y1 - 1.5, z0, z0 + 1.0)\n540\t        kn_ = TU0.cevre_supur(*ac, TU0.KANAL_PROF)\n541\t        pu_, ic_ = pu_.cut(kn_), ic_.cut(kn_)\n542\t        pl = TU0.kut(x0 + 1.0, x1 - 1.0, y0 + 1.0, y1 - 1.0, z0, z0 + 1.5).cut(kn_)\n543\t        pp = sorted(pl.solids().vals(), key=lambda s_: -s_.BoundingBox().xlen * s_.BoundingBox().ylen)\n544\t        assert len(pp) == 2, \"%s: kanal dış halkası %d parça\" % (kn, len(pp))\n545\t        halka = cq.Workplane(obj=pp[0]); ds = ds.union(halka); pu_ = pu_.cut(halka)\n546\t        ip = sorted(ic_.solids().vals(), key=lambda s_: s_.BoundingBox().xlen * s_.BoundingBox().ylen)\n547\t        assert len(ip) == 2, \"%s: iç sac %d parça\" % (kn, len(ip))\n548\t        ic_ = cq.Workplane(obj=ip[0])\n549\t        w_, h_ = k[\"x\"][1] - k[\"x\"][0], KY_K[1] - KY_K[0]\n550\t        kg = (w_ * h_ * 1.5 + 2 * (w_ + h_) * 38.5 * 1.5 + (w_ - 3) * (h_ - 3) * 1.0) * 7.93e-6 + (w_ - 3) * (h_ - 3) * 37.5 * 40e-9\n551\t        T = lambda s: _sh(s).translate(V(TU0.DX_DUNYA, TU0.DY_DUNYA, 0.0))\n552\t        ek(\"onyuz_%s_dis_sac\" % kn, T(ds), \"sac\", \"v2 · soğuk kapak %s %.1f × %.1f × 40 · AISI 304 fırçalı 1,5 dört kenardan bükülü · ≈%.1f kg · gizli menteşe %s · iki katı birden örter\"\n553\t           % (kn, w_, h_, kg, k[\"mentese\"]))\n554\t        ek(\"onyuz_%s_pu\" % kn, T(pu_), \"pu\", \"PU 37,5 (40 kg/m³) · fitil kanalı\")\n555\t        ek(\"onyuz_%s_ic_sac\" % kn, T(ic_), \"paslanmaz\", \"AISI 304 1,0 · kanalın içindeki panel\")\n556\t        ek(\"onyuz_%s_fitil\" % kn, T(TU0.cevre_supur(*ac, TU0.FITIL_PROF)), \"conta\",\n557\t           \"geçmeli manyetik fitil 21 × 18,5 · çevre %.0f mm\" % (2 * (ac[1] - ac[0] + ac[3] - ac[2] + 4 * TU0.FITIL_G)))\n558\t    # menteşeler (sanal pivot ön dış köşe) · v2: 2 menteşe (alt 1162 · üst 2070)\n559\t    for ad_, xa, xb, y0_, tx in ((\"K1_mentese_0\", X0 + 30.0, X0 + 42.5, 1162.0, (X0, X0 + 30.0)), (\"K1_mentese_1\", X0 + 30.0, X0 + 42.5, 2070.0, (X0, X0 + 30.0)),\n560\t                                 (\"K2_mentese_0\", 2456.0, 2468.5, 1162.0, (2468.5, X1)), (\"K2_mentese_1\", 2456.0, 2468.5, 2070.0, (2468.5, X1))):\n561\t        ek(\"onyuz_\" + ad_, kut(xa, xb, y0_, y0_ + 70.0, TU0.Z_CER[1], TU0.Z_SKAPAK[0]), \"paslanmaz\", \"çok kollu gizli menteşe KOLU (Sugatsune HES3D sınıfı — VARSAYIM)\")\n562\t        ek(\"onyuz_mentese_tabani_\" + ad_, kut(tx[0], tx[1], y0_, y0_ + 70.0, TU0.Z_CER[1], TU0.Z_SKAPAK[0] - 1.5), \"paslanmaz\", \"menteşe TABANI AISI 304 30 × 13,5 × 70 · TC yan sacına 2 × M6\")\n563\t    DXF = DERZ[0] + 1.5 - 1599.25                                                                # flipper v1 → v2 (derz ortası 1599,25 → 1853)\n564\t    for ad_, xa, xb in ((\"basac_K1\", 1559.25 + DXF, 1589.25 + DXF), (\"basac_K2\", 1609.25 + DXF, 1639.25 + DXF)):\n565\t        ek(\"onyuz_\" + ad_, kut(xa, xb, H_UST - 40.0, H_UST - 10.0, TU0.Z_CER[1], TU0.Z_SKAPAK[0]), \"plastik\", \"bas-aç mandal (push-to-open, gizli) · Southco E4 sınıfı — VARSAYIM\")\n566\t    # flipper: katlanma ekseni derzin 27 solunda (v1 ile aynı bağıl) · kam oluğu v2 kapak genişliğiyle YENİDEN hesaplanır\n567\t    fl = dict(FLIP_EKSEN=TU0.FLIP_EKSEN, K1_PIVOT=TU0.K1_PIVOT, KILAVUZ=TU0.KILAVUZ, FLIP=TU0.FLIP, FLIP_PIM=TU0.FLIP_PIM)\n568\t    try:\n569\t        TU0.FLIP_EKSEN = (xu(1572.25 + DXF), 20.0)\n570\t        TU0.K1_PIVOT = (xu(X0), Z_ON)\n571\t        TU0.KILAVUZ = (xu(1519.25 + DXF), xu(1626.25 + DXF), TU0.SOGUK_TABAN, TU0.SOGUK_TABAN + 15.0, -40.0, TU0.Z_CER[1])\n572\t        TU0.FLIP = (xu(1572.25 + DXF), xu(1626.25 + DXF), TU0.KILAVUZ[3] + 0.5, yu(IY[1]) - 0.5)\n573\t        TU0.FLIP_PIM = (xu(1620.25 + DXF), -10.0, 4.0, TU0.KILAVUZ[3] - 9.5)\n574\t        yol = TU0._pim_yolu()\n575\t        T = lambda s: _sh(s).translate(V(TU0.DX_DUNYA, TU0.DY_DUNYA, 0.0))\n576\t        ol = [TU0.sily(x_, z_, TU0.FLIP_PIM[2], TU0.FLIP_PIM[3] - 0.5, TU0.KILAVUZ[3] + 1.0).val() for x_, z_, _a in yol]\n577\t        while len(ol) > 1:\n578\t            ol = [ol[i].fuse(ol[i + 1]) if i + 1 < len(ol) else ol[i] for i in range(0, len(ol), 2)]\n579\t        ek(\"onyuz_kilavuz_flipper\", T(TU0.kut(*TU0.KILAVUZ).cut(ol[0])), \"pom\", \"flipper KILAVUZ BLOĞU POM-C 107 × 15 × 64 · kam oluğu v2 kapak genişliğiyle (%d nokta, α 0–%.2f°)\" % (len(yol), yol[-1][2]))\n580\t        fp = TU0.sily(TU0.FLIP_EKSEN[0], TU0.FLIP_EKSEN[1], 3.0, TU0.FLIP[2] - 1.0, TU0.FLIP[3] + 1.0)\n581\t        F = TU0.FLIP\n582\t        ek(\"onyuz_flipper_govde\", T(TU0.kut(F[0], F[1], F[2], F[3], -16.0, TU0.Z_CER[1] - 1.5).cut(fp)), \"plastik\",\n583\t           \"katlanır orta dikme 54 × %.0f × 38,5 · ABS + PU + ısıtıcı kablo · iki katı boydan boya örter\" % (F[3] - F[2]))\n584\t        ek(\"onyuz_flipper_on_sac\", T(TU0.kut(F[0], F[1], F[2], F[3], TU0.Z_CER[1] - 1.5, TU0.Z_CER[1]).cut(fp)), \"sac\", \"430 ferritik 1,5 · manyetik fitil tutar\")\n585\t        ek(\"onyuz_flipper_pimi\", T(TU0.sily(TU0.FLIP_PIM[0], TU0.FLIP_PIM[1], TU0.FLIP_PIM[2], TU0.FLIP_PIM[3], F[2])), \"celik\", \"kam pimi Ø8 × 10 AISI 316\")\n586\t        for i_, y0_ in enumerate((yu(1192.0), yu(1652.0), yu(2092.0))):                          # v2: 3 menteşe (flipper 972 boy)\n587\t            ek(\"onyuz_K1_flipper_mentese_%d\" % i_, T(TU0.kut(xu(1560.25 + DXF), TU0.FLIP_EKSEN[0], y0_, y0_ + 20.0, TU0.FLIP_EKSEN[1] + 1.0, TU0.Z_SKAPAK[0])\n588\t                                                       .union(TU0.sily(TU0.FLIP_EKSEN[0], TU0.FLIP_EKSEN[1], 3.0, y0_ - 5.0, y0_ + 25.0))), \"paslanmaz\",\n589\t               \"flipper menteşesi (K1 ile döner) + burulma yayı\")\n590\t        FLIP_V2 = dict(eksen_x=TU0.FLIP_EKSEN[0] + TU0.DX_DUNYA, pim_yolu=len(yol))\n591\t    finally:\n592\t        for k_, v_ in fl.items(): setattr(TU0, k_, v_)\n593\t    # ---- (e0) v3 · YAYICI UZATMA BORUSU (üçgen dağıtıcı ↔ valf · alt kat tabanını kontayla geçer) ----\n594\t    for k, x_ in X_YAYICI.items():\n595\t        y0_, y1_ = 1074.0 + DY_YAY[\"alt\"], 1072.0 + DY_YAY[\"ust\"]\n596\t        ek(\"%s_spreader_uzatma_borusu\" % k, sily(x_, TU0.ZT, YAY_BORU_R, y0_, y1_).cut(sily(x_, TU0.ZT, YAY_BORU_R - 1.5, y0_ - 1.0, y1_ + 1.0)), \"paslanmaz\",\n597\t           \"v3 · Ø30 × 1,5 AISI 316L · üçgen dağıtıcının üstü (%.0f) → kesme valfinin dik borusu (%.0f) · TC ile sökülür · yayıcı ağzı %.0f (pide koridoru %.0f üstü)\" % (y0_, y1_, 1013.0 + DY_YAY[\"alt\"], HS.Y_KORIDOR))\n598\t    # ---- (e) ÜRÜN HORTUMLARI (Ø32 iç · soğuk kutunun içinde) ----\n599\t    for k, pts in HORTUM.items():\n600\t        uz = sum(math.dist(a, b) for a, b in zip(pts[:-1], pts[1:]))\n601\t        ek(\"%s_urun_hortumu_D32\" % k, boru(pts, HORTUM_R), \"hortum_gida\",\n602\t           \"v2 · Ø32 / Ø42 gıda hortumu, çelik spiral takviyeli (esneme → doz hassasiyeti) [V] · %s UNO çıkışı (TC) → üst raf → alt kat → taban kontası → yayıcı girişi · \"\n603\t           \"boy ≈ %.0f mm · ölü hacim ≈ %.2f L (soğukta kalır) · temizlikte TC kelepçelerden sökülür\" % (k, uz, math.pi / 4 * 32.0 ** 2 * uz / 1e6))\n604\t    # ---- (f) KAŞAR / SUCUK 2 GÜNLÜK SOĞUK YEDEĞİ (kural 5.4 · v1'de dolabın K4 deposu) — üst katın sağında, GN 1/1 üstünde GN 1/2 ----\n605\t    def gn(ad, x0, x1, y0, h, z0, z1, mal_urun, doluluk, not_):\n606\t        g = kut(x0, x1, y0, y0 + h, z0, z1).cut(kut(x0 + 0.8, x1 - 0.8, y0 + 0.8, y0 + h + 1.0, z0 + 0.8, z1 - 0.8))\n607\t        g = g.fuse(kut(x0 - 6.0, x1 + 6.0, y0 + h - 1.0, y0 + h, z0 - 6.0, z1 + 6.0).cut(kut(x0 + 0.8, x1 - 0.8, y0 + h - 2.0, y0 + h + 1.0, z0 + 0.8, z1 - 0.8)))\n608\t        ek(ad + \"_kap\", g, \"gn\", not_)\n609\t        ek(ad + \"_kapak\", kut(x0 - 6.0, x1 + 6.0, y0 + h, y0 + h + 1.2, z0 - 6.0, z1 + 6.0), \"gn\", \"GN düz kapak 0,8 · AISI 304\")\n610\t        ek(ad + \"_urun\", kut(x0 + 1.0, x1 - 1.0, y0 + 0.8, y0 + 0.8 + (h - 12.0) * doluluk, z0 + 1.0, z1 - 1.0), mal_urun, \"yedek ürün (gösterim)\")\n611\t    if False:                                                                                    # v3 · kaşar / sucuk GN yedeği TOPPING'den ÇIKTI (dolabın teknik sütunu)\n612\t      GX = (1990.0, 2315.0); GZ1 = (-511.0, 19.0)\n613\t      y_ = RAF2[1]\n614\t      gn(\"gn_kasar_yedek_1_1_200\", GX[0], GX[1], y_, 200.0, GZ1[0] + 6.0, GZ1[1] - 6.0, \"kasar_urun\", HS.KASAR_2GUN_L / HS.GN_KASAR[\"L\"],\n615\t       \"v2 · %s AISI 304 · kaşar rendesi 2 günlük yedek %.1f L (4 günün 2. yarısı · kural 5.4) · kaset boşalınca personel doldurur\" % (HS.GN_KASAR[\"ad\"], HS.KASAR_2GUN_L))\n616\t      gn(\"gn_sucuk_yedek_1_2_150\", GX[0], GX[1], y_ + 200.0 + 1.2, 150.0, GZ1[1] - 6.0 - 265.0, GZ1[1] - 6.0, \"sucuk_urun\", HS.SUCUK_2GUN_L / HS.GN_SUCUK[\"L\"],\n617\t       \"v2 · %s AISI 304 · küp sucuk 2 günlük yedek %.1f L · kaşar GN'sinin kapağı üstünde (istiflenebilir düz kapak)\" % (HS.GN_SUCUK[\"ad\"], HS.SUCUK_2GUN_L))\n618\t    # ---- (g) HORTUM GEÇİŞ BLOKLARI (pnömatik hortumlar kuru bölmeden soğuk kutuya) + UNO silindir konsolları ----\n619\t    for k, (gx0, gx1, gy0, gy1) in GB.items():\n620\t        ek(\"gecis_blogu_%s\" % k, kut(gx0, gx1, gy0, gy1, -630.0, -570.0), \"pom\",\n621\t           \"v2 · hortumların soğuk hücreye geçtiği keçeli POM blok (%s kat: %s)\" % (k, \"kıyma + kuşbaşı UNO valf / piston\" if k == \"alt\" else \"sos + harç UNO valf / piston + yayıcı kesme valfleri\"))\n622\t    for a, s in bul.items():\n623\t        if not a.endswith(\"__pnomatik_on_ayak\"): continue\n624\t        b = s.BoundingBox(); u_ = a.split(\"__\")[0]\n625\t        ek(\"%s_silindir_konsolu\" % u_, kut(b.xmin - 1.0, b.xmax + 1.0, b.ymin - 3.0, b.ymin, -692.0, -630.0).fuse(kut(b.xmin - 1.0, b.xmax + 1.0, b.ymin - 43.0, b.ymin, -633.0, -630.0)),\n626\t           \"paslanmaz\", \"v2 · UNO pnömatik silindirinin ön ayağı buna oturur · L 3 mm AISI 304 · soğuk kutunun arka dış sacına 2 × M6 (v1'de ayak boştaydı)\")\n627\t    # ---- (h) HAVA HATLARI (kuru bölme) ----\n628\t    ek(\"hava_hatti_sartlandirici_ada\", boru(ADA_V2, 5.0), \"hava_ana\", \"v2 · Ø10 PU · FRL sol portu → kaset motorlarının ALTINDAN (1125) → valf adasının sağ ucu\")\n629\t    for j_, (yA, zA, xd, yP, renk) in enumerate(((1472.0, -700.0, 420.0 + DXL, 1460.0, \"hortum_mavi\"), (1460.0, -712.0, 428.0 + DXL, 1292.0, \"hortum_siyah\"))):\n630\t        yv = yA - 182.0                                                                           # v3 · valf adası 182 aşağıda (kasetin altı) · sürücülerin solundan (x 1447) çıkar\n631\t        ek(\"hava_hatti_acici_D6_%d\" % (j_ + 1), boru([(1690.0, yv, zA), (1447.0, yv, zA), (1447.0, yA, zA), (xd, yA, zA), (xd, yP, zA), (xd, yP, -540.0), (372.5 + DXL, yP, -540.0)], 3.0), renk,\n632\t           \"Ø6 PU · valf adası → TC sol yan sacı rakoru → açıcı Z silindiri (%s port)\" % (\"arka\" if j_ == 0 else \"ön\"))\n633\t    return L, dict(KAS_YUZ=KAS_YUZ, GB=GB, UH=UH, FLIP=FLIP_V2)\n634\t\n635\t\n636\tdef hava_yolu():\n637\t    \"\"\"v1 denetimi (topping_cad_v32 · dunya_denetimi 8) v2 ölçüsüyle: 240 m³/h (KLF6.6CND 32 °C'de atılan ısı, hava 10 K) · yarık etkin alanı yalnız kaide\n638\t    penceresinin önündekiler · arka pencere filtreli (açık oran 0,6 [V]) · sınırlar v1: hız ≤ 3,5 m/s · emiş / atış yarıkları arası ≥ 250\"\"\"\n639\t    import h3_kaide_v1 as KD2\n640\t    Q = (TC0.KLF66[32] + 279.0 * 1.1) / (1.2 * 1006.0 * 10.0)\n641\t    et = lambda xs, pen: sum(max(0.0, min(x_ + 60.0, b_) - max(x_, a_)) for x_ in xs for a_, b_ in pen) * 6.0 * len(TC0.IZGARA_Y) * 1e-6\n642\t    pw = lambda pen: sum(b_ - a_ for a_, b_ in pen) * (KD2.C_PENCERE_Y[1] - KD2.C_PENCERE_Y[0]) * 1e-6\n643\t    on_e = et(IZGARA[\"emis\"], KD2.C_PENCERE_X[\"emis\"]); arka_e = 0.6 * pw(KD2.C_ARKA_PENCERE_X); at = et(IZGARA[\"atis\"], KD2.C_PENCERE_X[\"atis\"])\n644\t    arka_e += 0.6 * (ARKA_EMIS[1] - ARKA_EMIS[0]) * (ARKA_EMIS[3] - ARKA_EMIS[2]) * 1e-6                   # v3 · teknik bölmenin arka emiş penceresi (filtreli)\n645\t    ara = IZGARA[\"atis\"][0] - (IZGARA[\"emis\"][-1] + 60.0)\n646\t    d = dict(Q_m3h=Q * 3600.0, emis_on=on_e, emis_arka=arka_e, v_emis=Q / (on_e + arka_e), v_emis_yalniz_on=Q / on_e, atis=at, v_atis=Q / at, ara=ara,\n647\t             sol_ayirma=IZGARA[\"emis\"][-1] + 60.0 <= T_AYIRMA, sag_ayirma=IZGARA[\"atis\"][0] >= T_AYIRMA)\n648\t    d[\"gecti\"] = d[\"v_emis\"] <= 3.5 and d[\"v_atis\"] <= 3.5 and ara >= 250.0 and d[\"sol_ayirma\"] and d[\"sag_ayirma\"]\n649\t    return d\n650\t\n651\t\n652\tT_AYIRMA = TC0.AYIRMA_X\n653\t\n654\t\n655\t# ================================================================ KUR (önbellekli)\n656\t_KUR = {}\n657\t\n658\t\n659\tdef kur():\n660\t    if _KUR: return _KUR[\"TC\"], _KUR[\"TU\"]\n661\t    TCs, TUs = _siniflandir()\n662\t    assert not RAPOR[\"tu\"].get(\"SINIFSIZ\"), RAPOR[\"tu\"][\"SINIFSIZ\"]\n663\t    TCn = yeni_tc()\n664\t    TUn, BILGI = yeni_tu(TUs)\n665\t    _KUR.update(TC=TCs + TCn, TU=TUs + TUn, BILGI=BILGI)\n666\t    adlar = [p[\"ad\"] for p in _KUR[\"TC\"]]; assert len(adlar) == len(set(adlar)), [a for a in adlar if adlar.count(a) > 1][:5]\n667\t    adlar = [p[\"ad\"] for p in _KUR[\"TU\"]]; assert len(adlar) == len(set(adlar)), [a for a in adlar if adlar.count(a) > 1][:5]\n668\t    return _KUR[\"TC\"], _KUR[\"TU\"]\n669\t\n670\t\n671\tdef eski_tc():\n672\t    \"\"\"montajın ÇİZMEDİĞİ ama ölçü okuduğu TC parçaları (TC0.eski: eski aktarma bandı 'bant' vb. · v1 soğuk hücresi · _bom) — aynı dilim kuralıyla, önbellekli ·\n673\t    montaj bunları v1_kalir / AKTARMA_TP10 / KAPAK süzgeçleriyle zaten düşürür (görünmez, denetime girmez)\"\"\"\n674\t    if \"ESKI\" in _KUR: return _KUR[\"ESKI\"]\n675\t    L = []\n676\t    for p in TC0.PARCALAR:\n677\t        if not TC0.eski(p[\"ad\"]): continue\n678\t        d_ = TC0.V1_TASI.get(p[\"ad\"], (0.0, 0.0, 0.0))\n679\t        sh = dilimle(_sh(p[\"wp\"]).translate(V(DXW + d_[0], DYW + d_[1], d_[2])))\n680\t        if sh is None: continue\n681\t        L.append(dict(ad=p[\"ad\"], sh=sh, mal=p[\"mal\"], bom=p.get(\"bom\"), tur=\"eski\"))\n682\t    _KUR[\"ESKI\"] = L\n683\t    return L\n684\t\n685\t\n686\tdef grup_pivotlari():\n687\t    \"\"\"TU grup pivotları (TU dünyası = dünya − (700, −168)) · taşınan grupların pivotları parçalarıyla aynı ötelenir\"\"\"\n688\t    g = {}\n689\t    for k, v in TU0.GRUP.items():\n690\t        d = GRUP_KAYMA.get(k, (0.0, 0.0, 0.0))\n691\t        g[k] = (v[0] + d[0], v[1] + d[1], v[2] + d[2])\n692\t    return g\n693\t\n694\t\n695\tif __name__ == \"__main__\":\n696\t    import time\n697\t    t0 = time.time()\n698\t    TC, TU = kur()\n699\t    print(\"TC v2 %d parça · TU v2 %d parça · %.0f sn\" % (len(TC), len(TU), time.time() - t0))\n700\t    print(\"TC:\", RAPOR[\"tc\"]); print(\"TU:\", {k: (v if k != \"SINIFSIZ\" else len(v)) for k, v in RAPOR[\"tu\"].items()})\n701\t    print(\"grup kaymaları:\", GRUP_KAYMA)\n702\t    print(\"bilgi:\", _KUR[\"BILGI\"])\n703\t    sys.stdout.flush(); os._exit(0)\n704\t"}]},"uuid":"203e74ef-94a0-4e7c-a90b-e255ccc74606","timestamp":"2026-10-01T12:50:07.481Z","sourceToolAssistantUUID":"f3f9429e-39f1-4436-b3cd-8d4d03072f74","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\Kemal\\Desktop\\Kemal\\WEBSİTE","sessionId":"f3ef876a-f062-4b29-bb81-775cc8a1a6d8","version":"2.1.284","gitBranch":"HEAD","slug":"crystalline-crunching-moonbeam"}
